---
import Layout from '../../../layouts/Layout.astro';
import {loadEdition,PIN,escape,historyHTML,displayEnglish} from '../../../lib/qualified-sichos-271280.mjs';
const edition=await loadEdition();
const plain='/reader-plain/reviewed/sichos-271-280/';
---
<Layout noindex={true} title={edition.title} description={edition.notice}>
<section class="qualified-sichos-271280" data-qualified-sichos-271280 data-projection-sha={PIN} data-print-safe="false" data-mode="both" data-witness="he">
<script is:inline>
(function(){
 const scope=document.querySelector('[data-qualified-sichos-271280]');
 const authenticated=()=>typeof window.QualifiedSichos271280IntegrityReady==='function'&&window.QualifiedSichos271280IntegrityReady();
 const notify=()=>scope.querySelector('[data-integrity-status]').textContent='Exports blocked: the complete reading text and source notes could not be verified.';
 const admitPrint=()=>{scope.dataset.printSafe='false';try{const gate=Object.getOwnPropertyDescriptor(window,'QualifiedSichos271280PrintGate');if(!gate||gate.writable!==false||gate.configurable!==false||typeof gate.value!=='function'||gate.value()!==true){scope.dataset.printSafe='false';notify();}}catch(_){scope.dataset.printSafe='false';notify();}};
 window.addEventListener('beforeprint',admitPrint);
 matchMedia('print').addEventListener('change',e=>{if(e.matches)admitPrint();else scope.dataset.printSafe='false';});
 window.addEventListener('afterprint',()=>{scope.dataset.printSafe='false';});
 document.addEventListener('click',e=>{const b=e.target.closest('button');if(b&&b.matches('#btn-share,#btn-add-sefer,#btn-print,.seg-copy-btn,.seg-add-sefer-btn,.ajew-segment-action-btn,.selection-popup .sel-btn,#highlight-context-menu .hl-action[data-action="share"],#highlight-context-menu .hl-action[data-action="save"],.notes-panel-btn,[data-q-action]')&&!authenticated()){e.preventDefault();e.stopImmediatePropagation();notify();}},true);
 document.addEventListener('copy',e=>{const s=getSelection();if(authenticated()||!s||s.isCollapsed)return;let intersects=false;try{for(let i=0;i<s.rangeCount;i++)if(s.getRangeAt(i).intersectsNode(scope))intersects=true;intersects=intersects||scope.contains(s.anchorNode)||scope.contains(s.focusNode);}catch(_){intersects=true;}if(intersects){e.preventDefault();e.stopImmediatePropagation();notify();}},true);
})();
</script>
<p class="qualified-print-warning" role="alert">Print withheld: the complete reading text and readable source notes could not be verified. Return to the reading page and try again.</p>
<nav aria-label="Reader navigation"><a href="/reader/">Reader</a> › <a href="/reader/reviewed/">Reviewed editions</a></nav>
<h1>{edition.title}</h1><p>{edition.notice}</p>
<p>This edition preserves all forty-one supplied paragraphs of teachings 271–280. All forty-one have current English translations. The two supplied Hebrew texts remain separate and unchanged. Source notes stay visible in every language view. Copy, Save and Share include complete selected paragraphs, both Hebrew texts, English, all source notes and labelled history, regardless of the language displayed.</p>
<div data-global-notes aria-label="Source notes for all teachings">{edition.globalQualifications.map((q,i)=><p data-global-qualification={q.id} data-ordinal={String(i)} set:html={escape(q.text)} />)}</div>
<p data-integrity-status role="status" aria-live="polite">Checking the reading text and source notes; exports are not yet available.</p>
<div class="qualified-toolbar" aria-label="Reading and export controls">
<button type="button" data-q-mode="hebrew" aria-pressed="false">Hebrew</button><button type="button" data-q-mode="english" aria-pressed="false">English</button><button type="button" data-q-mode="both" aria-pressed="true">Bilingual</button>
<button type="button" data-q-witness="he" aria-pressed="true">Supplied Hebrew</button><button type="button" data-q-witness="he_nikud" aria-pressed="false">Supplied pointed Hebrew</button>
<button type="button" data-q-action="copy">Copy forty-one paragraphs with source notes</button><button type="button" data-q-action="save">Save to My Sefer</button><button type="button" data-q-action="share">Share forty-one paragraphs with source notes</button><button type="button" id="btn-print">Print with source notes</button>
<label>Find in these paragraphs <input data-reader-query type="search" /></label><span data-search-status role="status"></span>
</div>
<div class="qualified-selection-actions selection-popup" aria-label="Selected text actions"><button type="button" class="sel-btn" data-action="copy" disabled>Copy selected paragraphs with source notes</button><button type="button" class="sel-btn" data-action="mysefer" disabled>Save selected paragraphs</button><button type="button" class="sel-btn" data-action="share" disabled>Share selected paragraphs</button><p data-qualified-selection-status role="status">Select visible source text. Exports include complete selected paragraphs, both Hebrew texts and all source notes.</p></div>
<div class="archive qualified-annotation-tools"><button type="button" data-q-capture>Highlight, note, prayer or share selection</button><div data-capture-host></div><h2>My local annotations</h2><p>Annotations here are kept separately. Earlier saved highlights and notes are unchanged. Local annotations identify one exact source occurrence; sharing includes complete selected paragraphs and all source notes.</p><div data-local-annotations></div></div>
<nav aria-label="Teachings">{edition.groups.map(g=><a href={'#group-'+g.id}>{g.title}</a>)}</nav>
{edition.groups.map(g=><section class="qualified-group" data-group={g.id} id={'group-'+g.id}>
<h2>{g.title}</h2><p><a href={g.canonical_url}>Read the complete teaching in the earlier edition</a></p>
{edition.units.filter(u=>u.group===g.id).map(u=><article class="qualified-unit" data-unit={u.owner} data-index={u.owner} data-source-index={String(u.source_index)} data-position={String(u.array_position)} id={u.anchor}>
<h3>Teaching {u.section}, paragraph {u.source_index}</h3>
<div class="qualified-pair"><div class="qualified-he" lang="he" dir="rtl"><p class="witness-label primary" lang="en" dir="ltr">Supplied Hebrew</p><p data-source-field="he" data-null="false" set:html={escape(u.he)} /><p class="witness-label secondary" lang="en" dir="ltr">Supplied pointed Hebrew</p><p data-source-field="he_nikud" data-null="false" set:html={escape(u.he_nikud)} /></div><div class="qualified-en" lang="en" dir="ltr"><p class="witness-label">English</p><p data-source-field="en" data-null={String(u.en===null)} set:html={escape(displayEnglish(u))} /></div></div>
<div class="required-qualifications" aria-label="Source notes">{u.qualifications.map((q,i)=><p data-qualification={q.id} data-owner={u.owner} data-ordinal={String(i)} set:html={escape(q.text)} />)}</div>
<div class="qualified-unit-actions"><button type="button" data-q-action="copy">Copy paragraph with source notes</button><button type="button" data-q-action="save">Save paragraph</button><button type="button" data-q-action="share">Share paragraph with source notes</button></div>
<Fragment set:html={historyHTML(u)} />
</article>)}
</section>)}
<p>Earlier English is available under each paragraph as historical wording, not a second current translation. The source notes explain the independent Hebrew readings and the limits of comparison texts.</p>
<section class="archive"><h2>Text downloads and earlier editions</h2><p>The downloads include all forty-one paragraphs of teachings 271–280 with current English translations. Historical archives are comparison only, not replacement English or independent textual authority.</p><p><a href={plain}>HTML</a> · <a href={plain+'index.txt'}>TXT</a> · <a href={plain+'index.md'}>Markdown</a> · <a href={plain+'index.json'}>JSON</a></p>
<details><summary>Earlier complete teaching files and selected text</summary><p>Earlier files remain unchanged for historical comparison. They do not replace the current translation or resolve the source limitations described above.</p><ul>{edition.assets.map(a=><li><a href={a.url}>{a.name==='selected-41.json'?'Forty-one paragraphs with source notes':a.name.includes('comparison')?'Full '+(a.name.includes('html')?'HTML':'DOCX')+' comparison witness text':'Earlier teaching '+a.name.match(/\d+/)?.[0]}</a></li>)}</ul></details></section>
</section>
<script is:inline type="module" src="/qualified-sichos-271280-reader.js?v=26c7ee64479a01c567fab1a537e15250a0b02b8a66d5577cae893506d73a8891"></script>
<style is:global>
.qualified-sichos-271280 { max-width:1100px; margin:auto; padding:1rem; background:#fff; color:#111; font:18px/1.65 system-ui; }
.qualified-sichos-271280 h1 { font-size:1.6rem; }.qualified-sichos-271280 nav,.qualified-sichos-271280 .qualified-toolbar { display:flex; flex-wrap:wrap; gap:.6rem; margin:1rem 0; }.qualified-sichos-271280 button { padding:.65rem; min-height:44px; cursor:pointer; }.qualified-sichos-271280 button[aria-pressed=true] { border:2px solid #294e6a; background:#eaf3fa; }.qualified-sichos-271280 .qualified-toolbar label { display:block; max-width:100%; }.qualified-sichos-271280 input { max-width:100%; }
.qualified-sichos-271280 .qualified-unit { margin:2rem 0; padding:1rem; border:1px solid #bbb; scroll-margin-top:5rem; }.qualified-sichos-271280 .qualified-pair { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; }.qualified-sichos-271280 [data-source-field],.qualified-sichos-271280 :is([data-qualification],[data-global-qualification]),.qualified-sichos-271280 [data-history-field],.qualified-sichos-271280 pre { white-space:pre-wrap; overflow-wrap:anywhere; }.qualified-sichos-271280 pre { max-width:100%; font:inherit; }.qualified-sichos-271280 .required-qualifications { border-top:1px solid #777; padding-top:1rem; }.qualified-sichos-271280 .witness-label { font-size:.85rem; }.qualified-sichos-271280 .qualified-print-warning { display:none; }
.qualified-sichos-271280 .qualified-selection-actions { position:static; background:#fff; border:1px solid #888; padding:.6rem; display:block; font-size:.85rem; }.qualified-sichos-271280 .qualified-selection-actions p { margin:.5rem 0; }
@media screen { .qualified-sichos-271280[data-mode=hebrew] .qualified-en,.qualified-sichos-271280[data-mode=english] .qualified-he { display:none; }.qualified-sichos-271280[data-mode=hebrew] .qualified-pair,.qualified-sichos-271280[data-mode=english] .qualified-pair { grid-template-columns:minmax(0,1fr); }.qualified-sichos-271280[data-witness=he] [data-source-field=he_nikud],.qualified-sichos-271280[data-witness=he] .witness-label.secondary,.qualified-sichos-271280[data-witness=he_nikud] [data-source-field=he],.qualified-sichos-271280[data-witness=he_nikud] .witness-label.primary { display:none; } }
@media screen and (max-width:700px) { .qualified-sichos-271280 .qualified-pair { grid-template-columns:minmax(0,1fr); }.qualified-sichos-271280 .qualified-unit { padding:.6rem; }.qualified-sichos-271280 { padding:.6rem; } }
@media print { .qualified-sichos-271280 [data-source-field],.qualified-sichos-271280 :is([data-qualification],[data-global-qualification]),.qualified-sichos-271280 [data-history-field] { white-space:break-spaces!important; } body,.qualified-sichos-271280 { background:white!important; color:black!important; }.qualified-sichos-271280 nav,.qualified-sichos-271280 .qualified-toolbar,.qualified-sichos-271280 .qualified-selection-actions,.qualified-sichos-271280 .qualified-unit-actions,.qualified-sichos-271280 .archive,.qualified-sichos-271280 [data-integrity-status] { display:none!important; }.qualified-sichos-271280 .qualified-pair { display:block!important; }.qualified-sichos-271280 [data-source-field] { display:block!important; }.qualified-sichos-271280 :is([data-qualification],[data-global-qualification]) { display:block!important; color:rgb(0,0,0)!important; -webkit-text-fill-color:rgb(0,0,0)!important; font-size:16px!important; text-indent:0; letter-spacing:normal; word-spacing:0; }.qualified-sichos-271280 .qualified-history { display:block!important; }.qualified-sichos-271280 .qualified-history summary { display:none!important; }.qualified-sichos-271280 [data-history-field] { display:block!important; color:rgb(0,0,0)!important; -webkit-text-fill-color:rgb(0,0,0)!important; font-size:16px!important; text-indent:0; letter-spacing:normal; word-spacing:0; }.qualified-sichos-271280 .qualified-unit { break-inside:auto; }.qualified-sichos-271280:not([data-print-safe=true]) > * { display:none!important; }.qualified-sichos-271280:not([data-print-safe=true]) > .qualified-print-warning { display:block!important; } body > :not(main):not(script):not(style) { display:none!important; } }
</style>
</Layout>
