---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Chok LiYisroel - Daily Study"
  description="The daily Chok LiYisroel: Torah with nikud, taamim and Onkelos, Navi, Kesuvim, Mishna, Gemara, Zohar, halacha and mussar - each day's full spread."
>
  <div class="ck-wrap" dir="rtl">
    <header class="ck-header">
      <h1>חק לישראל <span class="ck-sub">Chok LiYisroel · daily</span></h1>
      <p class="ck-date" id="ck-date" dir="ltr"></p>
      <p class="ck-week" id="ck-week"></p>
    </header>

    <div class="ck-controls" dir="ltr">
      <div class="ck-row ck-days" id="ck-days"></div>
      <div class="ck-row">
        <label>Week <select id="ck-parsha"></select></label>
        <label>Display
          <select id="ck-mode">
            <option value="full">Nikud + Taamim</option>
            <option value="nikud">Nikud only</option>
            <option value="taamim">Taamim only</option>
            <option value="letters">Letters only</option>
          </select>
        </label>
        <label class="ck-chk"><input type="checkbox" id="ck-medooyuk" checked /> Medooyuk</label>
        <label class="ck-chk"><input type="checkbox" id="ck-targum" /> Targum</label>
        <label class="ck-size">Size <input type="range" id="ck-size" min="16" max="44" value="26" /></label>
        <span class="ck-themes">
          <button class="ck-btn ck-theme" data-t="day">Day</button>
          <button class="ck-btn ck-theme" data-t="sepia">Sepia</button>
          <button class="ck-btn ck-theme" data-t="night">Night</button>
        </span>
      </div>
      <div class="ck-legend" id="ck-legend" dir="rtl" hidden>
        <span><span class="m-demo"><span class="m-na">שְׁבָא</span></span> = שוא נא</span>
        <span><span class="m-demo"><span class="m-nach">שְׁבָא</span></span> = שוא נח</span>
        <span><span class="m-demo"><span class="m-qb">שְׁבָא</span></span> = טעון בירור</span>
      </div>
    </div>

    <main id="ck-content" class="ck-content" dir="rtl" lang="he"></main>

    <footer class="ck-foot" dir="ltr">
      <p>Sheva/qamats rulings are v0 output — not an accuracy claim.</p>
    </footer>
  </div>
</Layout>

<script src="/chok.js?v=1" defer></script>

<style is:global>
  .ck-wrap { max-width: 1100px; margin: 0 auto; padding: 1rem; }
  .ck-header h1 { font-size: 1.7rem; margin: 0; }
  .ck-sub { font-size: 1rem; color: var(--muted, #888); font-weight: normal; }
  .ck-date, .ck-week { color: var(--muted, #888); margin: .15rem 0; font-size: .95rem; }
  .ck-controls { border: 1px solid var(--border, #ddd); border-radius: 10px; padding: .6rem .8rem; margin-bottom: 1rem; background: var(--panel, #fafafa); }
  .ck-row { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; margin: .3rem 0; }
  .ck-row label { display: flex; gap: .35rem; align-items: center; font-size: .88rem; }
  .ck-row select { padding: .25rem .35rem; border-radius: 6px; border: 1px solid var(--border, #ccc); background: var(--panel2, #fff); color: inherit; max-width: 200px; }
  .ck-btn { padding: .25rem .6rem; border-radius: 6px; border: 1px solid var(--border, #ccc); background: var(--panel2, #fff); color: inherit; cursor: pointer; }
  .ck-days button { min-width: 5.2rem; }
  .ck-days button.ck-day-on { outline: 2px solid #1a9e8c; outline-offset: 1px; }
  .ck-content { font-size: var(--ck-size, 26px); line-height: 2.1; }
  .ck-section { margin-bottom: 2rem; }
  .ck-sec-head { font-size: 1.15rem; font-weight: bold; border-bottom: 1px solid var(--border, #ddd); padding-bottom: .3rem; margin-bottom: .7rem; }
  .ck-sec-head .ck-ref { font-size: .75em; font-weight: normal; color: var(--muted, #888); }
  .ck-verse { margin-bottom: .8rem; }
  .ck-verse .tk-vnum { color: var(--muted, #999); font-size: .55em; margin-left: .35rem; }
  .ck-targum-line { font-size: .72em; line-height: 1.9; color: var(--muted-2, #667); background: var(--panel, rgba(127,127,127,.07)); border-radius: 8px; padding: .15rem .6rem; margin: .15rem 0; }
  .ck-mikra-repeat { display: none; }
  .ck-card { border: 1px solid var(--border, #ddd); border-radius: 10px; padding: .7rem .9rem; margin-bottom: .8rem; background: var(--panel, #fafafa); }
  .ck-card .ck-card-title { font-weight: bold; }
  .ck-card .ck-card-ref { color: var(--muted, #888); font-size: .9em; }
  .ck-soon { color: var(--muted, #999); font-size: .85em; }
  .m-na { text-decoration: underline; text-decoration-color: #1a9e8c; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .m-nach { text-decoration: underline; text-decoration-color: #d07a2a; text-decoration-thickness: 2px; text-decoration-style: double; text-underline-offset: 5px; }
  .m-qb { outline: 1px dotted rgba(200,60,60,.55); outline-offset: 2px; border-radius: 4px; }
  .m-demo { display: inline-block; }
  .ck-foot { margin-top: 2rem; font-size: .78rem; color: var(--muted, #999); }
  .ck-loading { color: var(--muted, #999); }
  .ck-error { color: #b33; }
</style>
