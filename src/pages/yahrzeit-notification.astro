---
// Yahrzeit Notification Component for Splash Page
import Layout from '../layouts/Layout.astro';
import TzaddikNotification from '../components/TzaddikNotification.astro';

// Get today's and tomorrow's dates
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);

// Load filtered tzaddikim database (according to Simcha's rules)
import tzaddikimData from '../../public/data/tzaddikim-database-filtered.json';

// Function to get Hebrew date using Hebcal API
async function getHebrewDate(gregorianDate) {
  const year = gregorianDate.getFullYear();
  const month = gregorianDate.getMonth() + 1; // JavaScript months are 0-indexed
  const day = gregorianDate.getDate();
  
  try {
    const response = await fetch(`https://www.hebcal.com/converter?cfg=json&gy=${year}&gm=${month}&gd=${day}&g2h=1`);
    if (!response.ok) throw new Error('Failed to fetch Hebrew date');
    const data = await response.json();
    return {
      year: data.hy,
      month: data.hm,
      day: data.hd,
      hebrew: data.hebrew
    };
  } catch (error) {
    console.error('Error fetching Hebrew date:', error);
    // Fallback: approximate calculation (not accurate for leap years)
    const hebrewMonths = ['TISHREI', 'CHESHVAN', 'KISLEV', 'TEVET', 'SHEVAT', 'ADAR', 'NISAN', 'IYAR', 'SIVAN', 'TAMMUZ', 'AV', 'ELUL'];
    const monthIndex = (gregorianDate.getMonth() + 6) % 12; // Rough approximation: Nisan ~ March
    return {
      year: 5786, // Default year
      month: hebrewMonths[monthIndex],
      day: gregorianDate.getDate(),
      hebrew: 'Approximate date'
    };
  }
}

// Function to get tzaddikim for a specific Hebrew date
function getTzaddikimForHebrewDate(hebrewDate) {
  const { month, day } = hebrewDate;
  
  return tzaddikimData.all_tzaddikim.filter(tzaddik => {
    if (!tzaddik.yahrzeit_month || !tzaddik.yahrzeit_day) return false;
    
    // Handle Adar/Adar II in non-leap years
    const tzaddikMonth = tzaddik.yahrzeit_month.toUpperCase();
    const targetMonth = month.toUpperCase();
    
    // Check if months match (including Adar/Adar II handling)
    if (tzaddikMonth === targetMonth) {
      return tzaddik.yahrzeit_day === day.toString();
    }
    
    // In non-leap years, Adar II yahrzeits are observed in Adar
    if (tzaddikMonth === 'ADAR II' && targetMonth === 'ADAR') {
      return tzaddik.yahrzeit_day === day.toString();
    }
    
    return false;
  }).slice(0, 10); // Limit to 10 for display
}

// Get Hebrew dates
const todayHebrew = await getHebrewDate(today);
const tomorrowHebrew = await getHebrewDate(tomorrow);

// Get tzaddikim for today and tomorrow
const todayTzaddikim = getTzaddikimForHebrewDate(todayHebrew);
const tomorrowTzaddikim = getTzaddikimForHebrewDate(tomorrowHebrew);

// Also get yesterday's tzaddikim for "day before" display
const yesterday = new Date(today);
yesterday.setDate(yesterday.getDate() - 1);
const yesterdayHebrew = await getHebrewDate(yesterday);
const yesterdayTzaddikim = getTzaddikimForHebrewDate(yesterdayHebrew);
---

<Layout title="Daily Yahrzeit Notifications">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Daily Yahrzeit Notifications</h1>
        <p class="text-lg text-gray-600">
          Remembering the tzaddikim on their yahrzeit. Click any name to learn more about their life and teachings.
        </p>
        <div class="mt-4 text-sm text-gray-500">
          <p>Updated daily • Reliable sources only • Breslov focus included</p>
        </div>
      </div>

      <!-- Yesterday's Yahrzeits (Day Before) -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-8 border-2 border-amber-200">
        <div class="flex items-center mb-6">
          <div class="w-3 h-8 bg-amber-600 rounded-full mr-3"></div>
          <h2 class="text-2xl font-semibold text-gray-800">Yesterday's Yahrzeits</h2>
          <span class="ml-4 px-3 py-1 bg-amber-100 text-amber-800 text-sm font-medium rounded-full">
            {yesterday.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
          </span>
          <span class="ml-2 px-2 py-1 bg-red-100 text-red-800 text-xs font-medium rounded-full">
            Day Before
          </span>
        </div>

        {yesterdayTzaddikim.length > 0 ? (
          <div class="space-y-4">
            {yesterdayTzaddikim.map(tzaddik => (
              <TzaddikNotification 
                tzaddik={tzaddik} 
                isToday={false}
                isYesterday={true}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-8">
            <p class="text-gray-500">No recorded yahrzeits for yesterday.</p>
          </div>
        )}
      </div>

      <!-- Today's Yahrzeits -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-8 border-2 border-blue-200">
        <div class="flex items-center mb-6">
          <div class="w-3 h-8 bg-blue-600 rounded-full mr-3"></div>
          <h2 class="text-2xl font-semibold text-gray-800">Today's Yahrzeits</h2>
          <span class="ml-4 px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">
            {today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
          </span>
          <span class="ml-2 px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full">
            Day Of
          </span>
        </div>

        <div class="mb-4 p-3 bg-blue-50 rounded-lg">
          <p class="text-sm text-blue-700">
            <strong>Hebrew Date:</strong> {todayHebrew.hebrew} ({todayHebrew.day} {todayHebrew.month} {todayHebrew.year})
          </p>
        </div>

        {todayTzaddikim.length > 0 ? (
          <div class="space-y-4">
            {todayTzaddikim.map(tzaddik => (
              <TzaddikNotification 
                tzaddik={tzaddik} 
                isToday={true}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-8">
            <p class="text-gray-500">No recorded yahrzeits for today.</p>
          </div>
        )}
      </div>

      <!-- Tomorrow's Yahrzeits -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
        <div class="flex items-center mb-6">
          <div class="w-3 h-8 bg-purple-600 rounded-full mr-3"></div>
          <h2 class="text-2xl font-semibold text-gray-800">Tomorrow's Yahrzeits</h2>
          <span class="ml-4 px-3 py-1 bg-purple-100 text-purple-800 text-sm font-medium rounded-full">
            {tomorrow.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
          </span>
        </div>

        {tomorrowTzaddikim.length > 0 ? (
          <div class="space-y-4">
            {tomorrowTzaddikim.map(tzaddik => (
              <TzaddikNotification 
                tzaddik={tzaddik} 
                isToday={false}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-8">
            <p class="text-gray-500">No recorded yahrzeits for tomorrow.</p>
          </div>
        )}
      </div>

      <!-- Information Section -->
      <div class="bg-gray-50 rounded-xl p-6">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">About This Feature</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-medium text-gray-700 mb-2">📚 Reliable Sources</h4>
            <p class="text-gray-600 text-sm">
              All information comes from verified sources including Likutey Moharan, Sichot HaRan, 
              Chabad.org, Sefaria.org, and academic publications.
            </p>
          </div>
          <div>
            <h4 class="font-medium text-gray-700 mb-2">🕯️ Yahrzeit Significance</h4>
            <p class="text-gray-600 text-sm">
              The yahrzeit (anniversary of passing) is an opportunity to remember the tzaddik's 
              teachings and draw inspiration from their life.
            </p>
          </div>
          <div>
            <h4 class="font-medium text-gray-700 mb-2">🔍 Complete Database</h4>
            <p class="text-gray-600 text-sm">
              Over 150 tzaddikim from Adam through contemporary leaders, with special focus on 
              the complete Breslov dynasty.
            </p>
          </div>
          <div>
            <h4 class="font-medium text-gray-700 mb-2">📱 Mobile Friendly</h4>
            <p class="text-gray-600 text-sm">
              View on any device. Notifications are optimized for both desktop and mobile viewing.
            </p>
          </div>
        </div>
      </div>

      <!-- Browse All Link -->
      <div class="text-center mt-8">
        <a 
          href="/tzaddikim" 
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
        >
          Browse All Tzaddikim
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <style>
    .tzaddik-card {
      transition: all 0.2s ease;
    }
    .tzaddik-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
  </style>
</Layout>