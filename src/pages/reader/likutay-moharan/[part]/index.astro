---
import Layout from '../../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/likutay-moharan/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part || '1');

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), `public/reader/likutay-moharan/part-${partNum}/index.json`);
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading Likutay Moharan index:', e);
}

const introSections = indexData?.introSections || [];
const torahs = indexData?.torahs || [];
const totalSections = torahs.length;

function hrefFor(item) {
  return item.url || `/reader/likutay-moharan/${partNum}/${item.slug || item.number}`;
}
function itemKey(item) {
  return String(item.slug || item.displayNumber || item.number || item.title || item.hebrewTitle || '').replace(/[^a-zA-Z0-9_-]+/g, '-');
}
function labelFor(item) {
  const type = item.type || item.slug || '';
  const nice = {
    haskamos: 'Approbations',
    intro: partNum === 1 ? 'Shir Na’im' : 'Opening',
    'intro-shimon': 'R’ Shimon',
    hakdama: 'Hakdama',
    'intro-lm': 'Introduction',
    'intro-manuscripts': 'Manuscripts Intro',
    'intro-volume-2': 'Part 2 Intro',
    omission: 'Hashmatah'
  };
  if (nice[type]) return nice[type];
  const dn = item.displayNumber;
  if (typeof dn === 'string' && /^(preface|intro|manuscript)-/.test(dn)) return (item.title || dn).replace(/^Short\s+/, '');
  return dn || item.number || '';
}
function torahTitle(item) {
  const n = item.displayNumber || item.number;
  const title = item.title && item.title !== `Torah ${item.number}` ? item.title : `Torah ${n}`;
  return title;
}
function rangeItems(start, end) {
  return torahs.filter(t => Number(t.number) >= start && Number(t.number) <= end);
}
const part1Groups = [
  { id: 'opening', title: 'Opening poetic preface and Torahs 1–15', hebrew: 'פתיחה ותורות א–טו', prefaces: introSections.filter(x => x.slug === 'preface-section-1'), items: rangeItems(1,15) },
  { id: 'hamishtuai', title: 'Torahs 16–18 — Hamishtu-ai', hebrew: 'תורות טז–יח', prefaces: introSections.filter(x => x.slug === 'preface-section-2'), items: rangeItems(16,18) },
  { id: 'safra', title: 'Torahs 19–22 — Safra DiTzniusa', hebrew: 'תורות יט–כב', prefaces: introSections.filter(x => x.slug === 'preface-section-3'), items: rangeItems(19,22) },
  { id: 'suvay', title: 'Torahs 23–31 — Suvay Divay Atuna', hebrew: 'תורות כג–לא', prefaces: introSections.filter(x => x.slug === 'preface-section-4'), items: rangeItems(23,31) },
  { id: 'main', title: 'Torahs 32–286 — Main Likutay Moharan', hebrew: 'תורות לב–רפו', prefaces: introSections.filter(x => x.slug === 'preface-section-5'), items: rangeItems(32,286) },
];
const part2Extra = [
  ...introSections,
  { slug: 'intro', displayNumber: 'intro', title: 'Opening of Part 2', hebrewTitle: 'פתיחה לחלק ב', url: '/reader/likutay-moharan/2/intro' },
  { slug: 'omission', displayNumber: 'omission', title: 'Omission / Hashmatah', hebrewTitle: 'השמטה', url: '/reader/likutay-moharan/2/omission' },
  ...Array.from({ length: 6 }, (_, i) => ({ slug: `manuscript-${i + 1}`, displayNumber: `ms-${i + 1}`, title: `Handwritten Manuscript ${i + 1}`, hebrewTitle: `כתב יד ${i + 1}`, url: `/reader/likutay-moharan/2/manuscript-${i + 1}` }))
].filter((item, i, arr) => item && item.url && arr.findIndex(x => x.url === item.url) === i);
const part2Opening = part2Extra.filter(item => !String(item.slug || '').startsWith('manuscript-'));
const part2Manuscripts = part2Extra.filter(item => String(item.slug || '').startsWith('manuscript-'));
const overviewLinks = partNum === 1 ? [
  { href: '#intro', text: 'Introductions & approbations', he: 'הקדמות והסכמות' },
  { href: '#opening', text: 'Torahs 1–15', he: 'תורות א–טו' },
  { href: '#hamishtuai', text: 'Torahs 16–18', he: 'תורות טז–יח' },
  { href: '#safra', text: 'Torahs 19–22', he: 'תורות יט–כב' },
  { href: '#suvay', text: 'Torahs 23–31', he: 'תורות כג–לא' },
  { href: '#main', text: 'Torahs 32–286', he: 'תורות לב–רפו' },
] : [
  { href: '#intro', text: 'Part 2 introductions', he: 'מבואות לחלק ב' },
  { href: '#torahs', text: 'Tinyana Torahs 1–125', he: 'תנינא א–קכה' },
  { href: '#manuscripts', text: 'Manuscripts', he: 'כתבי יד' },
];
const superReaderTorahs = Array.from({ length: 20 }, (_, index) => {
  const number = index + 1;
  return {
    number,
    hebrew: ['א','ב','ג','ד','ה','ו','ז','ח','ט','י','יא','יב','יג','יד','טו','טז','יז','יח'][index],
    href: `/reader/super/likutay-moharan/1/${number}`,
  };
});
---

<Layout title={`${indexData?.title || 'Likutay Moharan'} — Complete Directory`} description={`Complete directory for Likutay Moharan part ${partNum}, including introductions, approbations, prefaces, sections, and teachings.`}>
  <main class="lm-dir">
    <section class="lm-hero">
      <div class="lm-keter">כתר</div>
      <p class="lm-eyebrow">Complete Likutay Moharan Directory · הספר השלם בשתי שפות</p>
      <h1>Likutay Moharan</h1>
      <h2 lang="he" dir="rtl">ליקוטי מוהר״ן</h2>
      <p class="lm-subtitle">Part {partNum} · {totalSections} teachings · every teaching and special section presented in English and Hebrew.</p>
      <p class="lm-subtitle lm-subtitle-he" lang="he" dir="rtl">חלק {partNum === 1 ? 'א' : 'ב'} · {totalSections} תורות · כל תורה וכל מדור מיוחד מוצגים באנגלית ובעברית.</p>
      <div class="lm-actions">
        <a href="/reader">← All Books · כל הספרים</a>
        <a href={partNum === 1 ? '/reader/likutay-moharan/2' : '/reader/likutay-moharan/1'}>{partNum === 1 ? 'Open Part 2 · פתח חלק ב' : 'Open Part 1 · פתח חלק א'}</a>
      </div>
    </section>

    {partNum === 1 && (
      <section class="lm-super-spotlight" aria-labelledby="lm-super-title">
        <div>
          <span class="lm-super-new">NEW</span>
          <h3 id="lm-super-title">Full Super Readers · קורא־על מלא</h3>
          <p>Aligned Hebrew–English, phrase study, layered commentaries, notes, and Pe’er HaLikutim facsimiles.</p>
        </div>
        <nav aria-label="Available Likutay Moharan Super Readers">
          {superReaderTorahs.map((torah) => (
            <a href={torah.href}>
              <span>Torah {torah.number}</span>
              <span lang="he" dir="rtl">תורה {torah.hebrew}</span>
            </a>
          ))}
        </nav>
      </section>
    )}

    <nav class="lm-overview" aria-label="Likutay Moharan directory sections">
      {overviewLinks.map(link => <a href={link.href}><span>{link.text}</span><span lang="he" dir="rtl">{link.he}</span></a>)}
    </nav>

    {partNum === 1 ? (
      <>
        <section id="intro" class="lm-panel lm-intro-panel">
          <header>
            <span class="lm-section-mark">א</span>
            <div>
              <h3>Introductions, Approbations, and Prefaces</h3>
              <p lang="he" dir="rtl">הסכמות · שיר נעים · הקדמה · מבואות · פתיחות</p>
            </div>
          </header>
          <div class="lm-card-grid lm-feature-grid">
            {introSections.filter(x => x.type !== 'preface').map(item => (
              <a class="lm-card lm-feature-card" href={hrefFor(item)}>
                <span class="lm-num">{labelFor(item)}</span>
                <strong>{item.title}</strong>
                <em lang="he" dir="rtl">{item.hebrewTitle}</em>
                <small>{item.paragraphs || 0} paragraphs</small>
              </a>
            ))}
          </div>
        </section>

        {part1Groups.map(group => (
          <section id={group.id} class="lm-panel">
            <header>
              <span class="lm-section-mark">✦</span>
              <div>
                <h3>{group.title}</h3>
                <p lang="he" dir="rtl">{group.hebrew}</p>
              </div>
            </header>
            {group.prefaces.length > 0 && (
              <div class="lm-preface-row">
                {group.prefaces.map(item => (
                  <a class="lm-preface" href={hrefFor(item)}>
                    <span>Poetic Preface</span>
                    <strong>{item.title}</strong>
                    <em lang="he" dir="rtl">{item.hebrewTitle}</em>
                  </a>
                ))}
              </div>
            )}
            <div class="lm-card-grid">
              {group.items.map(item => (
                <a class="lm-card" href={hrefFor(item)}>
                  <span class="lm-num">{labelFor(item)}</span>
                  <strong>{torahTitle(item)}</strong>
                  <em lang="he" dir="rtl">{item.hebrewTitle}</em>
                  {item.themes?.length > 0 && <small>{item.themes.slice(0, 4).join(' · ')}</small>}
                  {Number(item.number) <= 20 && <span class="lm-super-available">NEW · Full Super Reader available</span>}
                </a>
              ))}
            </div>
          </section>
        ))}
      </>
    ) : (
      <>
        <section id="intro" class="lm-panel lm-intro-panel">
          <header>
            <span class="lm-section-mark">ב</span>
            <div>
              <h3>Part 2 Introductions and Special Sections</h3>
              <p lang="he" dir="rtl">מבוא · השמטה · כתבי יד</p>
            </div>
          </header>
          <div class="lm-card-grid lm-feature-grid">
            {part2Opening.map(item => (
              <a class="lm-card lm-feature-card" href={hrefFor(item)}>
                <span class="lm-num">{labelFor(item)}</span>
                <strong>{item.title}</strong>
                <em lang="he" dir="rtl">{item.hebrewTitle}</em>
              </a>
            ))}
          </div>
          <div id="manuscripts" class="lm-subsection-heading">
            <span class="lm-section-mark">✦</span>
            <div><h4>Handwritten Manuscripts</h4><p lang="he" dir="rtl">כתבי יד</p></div>
          </div>
          <div class="lm-card-grid lm-feature-grid">
            {part2Manuscripts.map(item => (
              <a class="lm-card lm-feature-card" href={hrefFor(item)}>
                <span class="lm-num">{labelFor(item)}</span>
                <strong>{item.title}</strong>
                <em lang="he" dir="rtl">{item.hebrewTitle}</em>
              </a>
            ))}
          </div>
        </section>
        <section id="torahs" class="lm-panel">
          <header>
            <span class="lm-section-mark">✦</span>
            <div>
              <h3>Likutay Moharan Tinyana — Torahs 1–125</h3>
              <p lang="he" dir="rtl">ליקוטי מוהר״ן תנינא</p>
            </div>
          </header>
          <div class="lm-card-grid">
            {torahs.map(item => (
              <a class="lm-card" href={hrefFor(item)}>
                <span class="lm-num">{labelFor(item)}</span>
                <strong>{torahTitle(item)}</strong>
                <em lang="he" dir="rtl">{item.hebrewTitle}</em>
                {item.themes?.length > 0 && <small>{item.themes.slice(0, 4).join(' · ')}</small>}
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </main>
</Layout>

<style>
  .lm-dir { max-width: 1220px; margin: 0 auto; padding: 28px 16px 86px; color: #182b43; }
  .lm-hero { position: relative; overflow: hidden; text-align: center; padding: clamp(34px, 6vw, 78px) 18px; border-radius: 32px; border: 1px solid rgba(183,132,44,.45); background: radial-gradient(circle at 15% 15%, rgba(255,237,176,.8), transparent 26%), radial-gradient(circle at 86% 8%, rgba(60,95,145,.22), transparent 28%), linear-gradient(135deg, #fffaf0 0%, #f6ecd8 52%, #ead2a9 100%); box-shadow: 0 24px 80px rgba(20,52,93,.16); }
  .lm-keter { margin: 0 auto 8px; width: 58px; height: 58px; display: grid; place-items: center; border-radius: 50%; background: #173b67; color: #ffe9b3; font-family: 'Frank Ruhl Libre', serif; font-weight: 900; box-shadow: 0 12px 32px rgba(20,52,93,.2); }
  .lm-eyebrow { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .22em; font-size: .72rem; color: #8b662f; font-weight: 900; }
  .lm-hero h1 { margin: 0; font-family: Cinzel, Georgia, serif; color: #12365e; font-size: clamp(2.35rem, 7vw, 5.4rem); line-height: .95; }
  .lm-hero h2 { margin: 9px 0 0; font-family: 'Frank Ruhl Libre', serif; color: #76531b; font-size: clamp(1.9rem, 5vw, 3.9rem); }
  .lm-subtitle { max-width: 780px; margin: 16px auto 0; color: #516173; line-height: 1.6; font-size: 1.02rem; }
  .lm-subtitle-he { margin-top: 2px; font-family:'Frank Ruhl Libre',serif; font-size:1.08rem; }
  .lm-actions { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top: 22px; }
  .lm-actions a, .lm-overview a { text-decoration:none; font-weight:800; border-radius: 999px; padding: 10px 15px; border: 1px solid #d6bd86; color:#12365e; background:#fff8e8; }
  .lm-super-spotlight { margin:20px 0 0; padding:20px 24px; border-radius:22px; background:linear-gradient(135deg,#173b67,#2c5f94); color:#fff; box-shadow:0 14px 34px rgba(20,52,93,.18); }
  .lm-super-spotlight h3,.lm-super-spotlight p { margin:0; }
  .lm-super-spotlight h3 { margin-top:5px; font-size:clamp(1.25rem,2.7vw,1.75rem); }
  .lm-super-spotlight p { margin-top:5px; opacity:.82; line-height:1.45; }
  .lm-super-new { display:inline-flex; padding:4px 8px; border-radius:999px; background:#ffe08a; color:#173b67; font-size:.66rem; font-weight:950; letter-spacing:.12em; }
  .lm-super-spotlight nav { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:8px; margin-top:16px; }
  .lm-super-spotlight a { min-width:0; padding:9px 8px; display:flex; flex-direction:column; gap:1px; border-radius:13px; background:#fff8e8; color:#173b67; text-decoration:none; font-weight:900; text-align:center; }
  .lm-super-spotlight a span[lang="he"] { color:#76531b; font-family:'Frank Ruhl Libre',serif; font-size:1rem; }
  .lm-overview { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin: 20px 0 24px; }
  .lm-overview a { display:flex; flex-direction:column; align-items:center; gap:2px; background: #173b67; color: #ffe9b3; border-color: #173b67; }
  .lm-overview a span[lang="he"] { font-family:'Frank Ruhl Libre',serif; font-size:1.02rem; color:#fff5d7; }
  .lm-panel { margin-top: 24px; padding: clamp(16px, 3vw, 28px); border-radius: 26px; border: 1px solid rgba(204,178,128,.6); background: linear-gradient(145deg,#fffdf8,#f8efe0); box-shadow: 0 12px 38px rgba(20,52,93,.08); }
  .lm-panel header { display:flex; gap:14px; align-items:center; margin-bottom: 18px; }
  .lm-section-mark { width: 48px; height: 48px; display:grid; place-items:center; border-radius:16px; background: linear-gradient(135deg,#173b67,#2c5f94); color:#ffe9b3; font-family:'Frank Ruhl Libre',serif; font-weight:900; }
  .lm-panel h3 { margin:0; color:#15375e; font-size: clamp(1.35rem, 3vw, 2rem); }
  .lm-panel header p { margin:3px 0 0; color:#795923; font-family:'Frank Ruhl Libre',serif; font-size:1.2rem; }
  .lm-subsection-heading { scroll-margin-top:90px; display:flex; gap:12px; align-items:center; margin:26px 0 14px; padding-top:20px; border-top:1px solid rgba(204,178,128,.58); }
  .lm-subsection-heading h4 { margin:0; color:#15375e; font-size:clamp(1.2rem,2.5vw,1.7rem); }
  .lm-subsection-heading p { margin:2px 0 0; color:#795923; font-family:'Frank Ruhl Libre',serif; font-size:1.15rem; }
  .lm-card-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .lm-feature-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .lm-card { display:flex; flex-direction:column; gap:5px; min-height:110px; padding:15px; border-radius:18px; border:1px solid rgba(204,178,128,.58); background:#fffaf0; text-decoration:none; box-shadow:0 8px 24px rgba(20,52,93,.06); transition: transform .16s ease, box-shadow .16s ease; }
  .lm-card:hover, .lm-preface:hover { transform: translateY(-2px); box-shadow:0 18px 40px rgba(20,52,93,.14); }
  .lm-num { align-self:flex-start; min-width: 36px; height: 32px; padding:0 8px; display:inline-flex; align-items:center; justify-content:center; border-radius:12px; background:#173b67; color:#ffe9b3; font-weight:900; font-size:.78rem; }
  .lm-card strong { color:#15375e; line-height:1.25; }
  .lm-card em { color:#75541e; font-style:normal; font-family:'Frank Ruhl Libre',serif; font-size:1.1rem; line-height:1.2; }
  .lm-card small { color:#89744e; font-size:.76rem; line-height:1.35; }
  .lm-super-available { align-self:flex-start; margin-top:auto; padding:5px 8px; border-radius:999px; background:#173b67; color:#ffe9b3; font-size:.66rem; font-weight:900; letter-spacing:.02em; }
  .lm-preface-row { margin-bottom: 16px; display:grid; gap:12px; }
  .lm-preface { display:flex; flex-direction:column; gap:4px; padding:16px 18px; border-radius:18px; border:1px solid rgba(183,132,44,.45); background: linear-gradient(135deg,#173b67,#2c5f94); color:#fff; text-decoration:none; box-shadow:0 10px 28px rgba(20,52,93,.13); transition: transform .16s ease, box-shadow .16s ease; }
  .lm-preface span { color:#ffe9b3; font-size:.78rem; font-weight:900; text-transform:uppercase; letter-spacing:.12em; }
  .lm-preface strong { color:#fff; }
  .lm-preface em { color:#ffe9b3; font-style:normal; font-family:'Frank Ruhl Libre',serif; font-size:1.15rem; }
  :global(body.dark-mode) .lm-dir { color:#dce6f3; }
  :global(body.dark-mode) .lm-hero, :global(body.dark-mode) .lm-panel { background: linear-gradient(135deg,#171b2c,#25283d); border-color:#4a3d2a; box-shadow:0 22px 70px rgba(0,0,0,.35); }
  :global(body.dark-mode) .lm-hero h1, :global(body.dark-mode) .lm-panel h3, :global(body.dark-mode) .lm-card strong { color:#dce8ff; }
  :global(body.dark-mode) .lm-hero h2, :global(body.dark-mode) .lm-panel header p, :global(body.dark-mode) .lm-card em { color:#e4c077; }
  :global(body.dark-mode) .lm-subtitle, :global(body.dark-mode) .lm-card small { color:#aeb9c8; }
  :global(body.dark-mode) .lm-card { background:#1b2032; border-color:#3d4058; }
  @media (max-width: 640px) {
    .lm-dir { padding:18px 10px 64px; }
    .lm-hero { border-radius:22px; }
    .lm-super-spotlight { padding:18px 14px; }
    .lm-super-spotlight nav { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .lm-card-grid { grid-template-columns:1fr; }
    .lm-panel { border-radius:20px; }
    .lm-panel header { align-items:flex-start; }
  }
</style>
