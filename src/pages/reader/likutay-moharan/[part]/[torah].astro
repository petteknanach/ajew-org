---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/reader.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  // Generate paths for all torahs in both parts
  const paths = [];
  // Part 1 intro pages
  paths.push({ params: { part: '1', torah: 'haskamos' } });
  paths.push({ params: { part: '1', torah: 'intro' } });
  paths.push({ params: { part: '1', torah: 'intro-shimon' } });
  // Part 1: 286 torahs (1-286, all present including 272)
  for (let torah = 1; torah <= 286; torah++) {
    paths.push({ params: { part: '1', torah: String(torah) } });
  }
  // Part 2 intro pages
  paths.push({ params: { part: '2', torah: 'intro' } });
  paths.push({ params: { part: '2', torah: 'omission' } });
  // Part 2 (Tinyana): 125 torahs (1-125, all present including 51)
  for (let torah = 1; torah <= 125; torah++) {
    paths.push({ params: { part: '2', torah: String(torah) } });
  }
  // Part 2 manuscripts (Ksav Yad)
  for (let i = 1; i <= 6; i++) {
    paths.push({ params: { part: '2', torah: `manuscript-${i}` } });
  }
  return paths;
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahNum = parseInt(torah);
const isIntroPage = isNaN(torahNum);

// Load the torah data
let torahData = null;
let error = null;

try {
  const fileName = isIntroPage ? `${torah}.json` : `torah-${torahNum}.json`;
  const filePath = path.join(process.cwd(), `public/reader/likutay-moharan/part-${partNum}/${fileName}`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = `Torah ${torah} not found`;
}

if (!torahData && !error) {
  error = 'Content not available';
}

// SEO structured data
const structuredData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${torahData.title} - Likutay Moharan ${partNum}:${torahData.displayNumber || torahNum}`,
  "alternativeHeadline": torahData.hebrewTitle || '',
  "author": { "@type": "Person", "name": "Rabbi Nachman of Breslov" },
  "publisher": { "@type": "Organization", "name": "ajew.org" },
  "inLanguage": ["he", "en"],
  "genre": "Religious text",
  "isPartOf": {
    "@type": "Book",
    "name": "Likutay Moharan",
    "author": { "@type": "Person", "name": "Rabbi Nachman of Breslov" }
  },
  "keywords": torahData.themes?.join(', ') || 'Torah, Breslov, Rabbi Nachman',
  "url": `https://ajew.org/reader/likutay-moharan/${partNum}/${torahNum}`,
  "mainEntityOfPage": `https://ajew.org/reader/likutay-moharan/${partNum}/${torahNum}`
}) : '';
const breadcrumbData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Library", "item": "https://ajew.org/reader" },
    { "@type": "ListItem", "position": 2, "name": "Likutay Moharan", "item": `https://ajew.org/reader#likutay-moharan` },
    { "@type": "ListItem", "position": 3, "name": torahData.hebrewTitle || torahData.title }
  ]
}) : '';

const pageTitle = torahData
  ? `${torahData.hebrewTitle || torahData.title} - Likutay Moharan`
  : 'Torah Not Found';
const pageDesc = torahData
  ? (() => {
    const snippet = (torahData.segments?.find(s => s.en)?.en || '').replace(/<[^>]+>/g, '').slice(0, 120);
    return `Read ${torahData.title} from Likutay Moharan online free. ${snippet ? snippet + '...' : 'Hebrew text with English translation on ajew.org.'}`;
  })()
  : '';
---

<Layout title={pageTitle} description={pageDesc}>
  {torahData && structuredData && (
    <script type="application/ld+json" set:html={structuredData} slot="head" />
  )}
  {torahData && breadcrumbData && (
    <script type="application/ld+json" set:html={breadcrumbData} slot="head" />
  )}
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div
      class="reader-container"
      data-torah-id={torahData.id}
      data-torah-title={`${torahData.title} - Likutay Moharan ${partNum}:${torahNum}`}
    >
      <!-- Progress Bar -->
      <div class="reader-progress"></div>

      <!-- Breadcrumb -->
      <div class="reader-breadcrumb">
        <a href="/reader">Reader</a>
        <span>&rsaquo;</span>
        <a href="/reader">Likutay Moharan</a>
        <span>&rsaquo;</span>
        <a href="/reader">Part {partNum}</a>
        <span>&rsaquo;</span>
        Torah {torahNum}
      </div>

      <!-- Kol HaTzadik Audio Player -->
      <div class="kol-hatzadik-player" id="kol-hatzadik-player" style="display:none;">
        <div style="background: var(--reader-bg-secondary, #f8f5f0); border: 1px solid var(--reader-border, #ddd); border-radius: 8px; padding: 12px 16px; margin: 0 auto 12px auto; max-width: 700px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span style="font-size: 1.2em;">&#x1F3A7;</span>
            <strong style="font-family: 'Open Sans', sans-serif; font-size: 0.95em; color: var(--reader-text, #333);">Listen to Kol HaTzadik Reading</strong>
          </div>
          <audio id="kol-hatzadik-audio" controls preload="none" style="width: 100%; border-radius: 4px;">
            Your browser does not support audio playback.
          </audio>
          <div id="kol-hatzadik-note" style="font-size: 0.8em; color: var(--reader-text-secondary, #888); margin-top: 4px; font-family: 'Open Sans', sans-serif;"></div>
        </div>
      </div>
      <script is:inline>
      (function() {
        var R2_BASE = 'https://pub-81b61511a43c43218e37bc24c20a7a22.r2.dev/kol-hatzadik/';

        // LM Part 1: [fileNumber, startTorah, endTorah]
        // torah=0 means hakdama/intro, negative for special pages
        var LM1_MAP = [
          [1, -2, 0],    // hakdama + shir yedidos + intro
          [2, 1, 1],
          [3, 2, 2],
          [4, 3, 3],
          [5, 4, 4],
          [6, 5, 5],
          [7, 6, 6],
          [8, 7, 7],
          [9, 8, 8],
          [10, 9, 9],
          [11, 10, 10],
          [12, 11, 11],
          [13, 12, 12],
          [14, 13, 13],
          [15, 14, 14],
          [16, 15, 15],
          [17, 16, 16],
          [18, 17, 17],
          [19, 18, 18],
          [20, 19, 19],
          [21, 20, 20],
          [22, 21, 21],
          [23, 22, 22],
          [24, 23, 23],
          [25, 24, 24],
          [27, 25, 27],
          [28, 28, 28],
          [29, 29, 29],
          [30, 30, 30],
          [31, 31, 31],
          [32, 32, 33],
          [33, 34, 34],
          [34, 35, 35],
          [35, 36, 36],
          [36, 37, 37],
          [37, 38, 38],
          [38, 39, 43],
          [39, 44, 44],
          [40, 45, 46],
          [41, 47, 47],
          [42, 48, 48],
          [43, 49, 49],
          [44, 50, 50],
          [45, 51, 51],
          [46, 52, 52],
          [47, 53, 53],
          [48, 54, 54],
          [49, 55, 56],
          [50, 57, 57],
          [51, 58, 59],
          [52, 60, 60],
          [53, 61, 61],
          [54, 62, 62],
          [55, 63, 63],
          [56, 64, 64],
          [57, 65, 65],
          [58, 66, 66],
          [59, 67, 67],
          [60, 68, 72],
          [61, 73, 80],
          [62, 81, 100],
          [63, 101, 130],
          [64, 131, 170],
          [65, 171, 200],
          [66, 201, 230],
          [67, 231, 250],
          [68, 251, 260],
          [69, 261, 270],
          [70, 271, 280],
          [71, 281, 286]
        ];

        // LM Part 2: [fileNumber, startTorah, endTorah]
        var LM2_MAP = [
          [1, -1, 0],    // hakdama/intro
          [2, 1, 1],
          [3, 2, 3],
          [4, 4, 4],
          [5, 5, 7],
          [6, 8, 8],
          [7, 9, 12],
          [8, 13, 19],
          [9, 20, 32],
          [10, 33, 44],
          [11, 45, 56],
          [12, 57, 68],
          [13, 69, 78],
          [14, 79, 86],
          [15, 87, 92],
          [16, 93, 101],
          [17, 102, 112],
          [18, 113, 125]
        ];

        var pathParts = window.location.pathname.split('/');
        var partIdx = pathParts.indexOf('likutay-moharan');
        if (partIdx === -1) return;
        var partNum = parseInt(pathParts[partIdx + 1]);
        var torahSlug = pathParts[partIdx + 2];
        var torahNum = parseInt(torahSlug);
        if (isNaN(torahNum)) {
          // Handle intro/special pages
          if (torahSlug === 'intro' || torahSlug === 'haskamos' || torahSlug === 'intro-shimon') {
            torahNum = torahSlug === 'haskamos' ? -2 : (torahSlug === 'intro-shimon' ? -1 : 0);
          } else {
            return; // no audio for manuscripts etc.
          }
        }

        var map = partNum === 1 ? LM1_MAP : (partNum === 2 ? LM2_MAP : null);
        if (!map) return;

        var fileNum = null;
        var coversMultiple = false;
        for (var i = 0; i < map.length; i++) {
          if (torahNum >= map[i][1] && torahNum <= map[i][2]) {
            fileNum = map[i][0];
            coversMultiple = (map[i][2] - map[i][1]) > 0;
            break;
          }
        }
        if (fileNum === null) return;

        var pad = partNum === 1 ? 3 : 2;
        var fileStr = String(fileNum);
        while (fileStr.length < pad) fileStr = '0' + fileStr;
        var fileName = 'kol-hatzadik-lm' + partNum + '-' + fileStr + '.mp3';
        var audioUrl = R2_BASE + fileName;

        var player = document.getElementById('kol-hatzadik-player');
        var audio = document.getElementById('kol-hatzadik-audio');
        var note = document.getElementById('kol-hatzadik-note');

        audio.src = audioUrl;
        player.style.display = 'block';

        if (coversMultiple) {
          var start = map.filter(function(m) { return m[0] === fileNum; })[0];
          if (start) {
            var rangeStart = start[1] < 1 ? 'Intro' : start[1];
            note.textContent = 'This recording covers Torahs ' + rangeStart + '\u2013' + start[2];
          }
        }
      })();
      </script>

      <!-- Toolbar -->
      <div class="reader-toolbar">
        <div class="reader-toolbar-group">
          <button class="reader-btn" data-mode="hebrew">Hebrew</button>
          <button class="reader-btn" data-mode="english">English</button>
          <button class="reader-btn" data-mode="both">Both</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn" id="btn-nikud">Nikud</button>
        </div>
        <div class="reader-toolbar-group">
          <span style="font-size:0.7em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
          <input type="range" id="font-size-slider" class="font-size-slider" min="12" max="32" value="18" />
          <span style="font-size:0.9em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" data-theme-btn="day" title="Day mode">Day</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="sepia" title="Sepia mode">Sepia</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="night" title="Night mode">Night</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" id="btn-listen">Listen</button>
          <button class="reader-btn reader-btn-icon" id="btn-search" title="Search (Ctrl+F)">Search</button>
          <button class="reader-btn reader-btn-icon" id="btn-bookmark" title="Bookmark (S)">Bookmark</button>
          <button class="reader-btn reader-btn-icon" id="btn-notes">Notes</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen" title="Fullscreen (F)">Fullscreen</button>
        </div>
      </div>

      <!-- In-text Search Bar -->
      <div class="reader-search-bar">
        <input type="text" placeholder="Search in this teaching..." dir="auto" />
        <span class="search-info"></span>
        <button class="reader-btn search-close">Close</button>
      </div>

      <!-- TOC Toggle Button -->
      <button class="reader-toc-toggle" title="Table of Contents (T)">&#9776;</button>

      <!-- Floating TOC Sidebar -->
      <div class="reader-toc">
        <button class="reader-toc-close">&times;</button>
        <h3>Paragraphs</h3>
        <ul class="reader-toc-list">
          {torahData.segments.map((seg, i) => (
            <li>
              <a href={`#seg-${seg.index}`} data-index={String(seg.index)}>
                Paragraph {seg.index}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Header -->
      <div class="reader-header">
        {torahData.hebrewTitle && (
          <div class="hebrew-title">{torahData.hebrewTitle}</div>
        )}
        <h1>{torahData.title}</h1>
        {torahData.keyVerse && (
          <div class="key-verse">{torahData.keyVerse}</div>
        )}
        {torahData.keyVerseTranslation && (
          <div class="key-verse-translation">{torahData.keyVerseTranslation}</div>
        )}
        {torahData.themes && torahData.themes.length > 0 && (
          <div class="themes">
            {torahData.themes.map(theme => (
              <span class="theme-tag">{theme}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Top Navigation -->
      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous Torah</a>
        ) : (
          <span class="disabled">&larr; Previous Torah</span>
        )}
        <a href="/reader">All Torahs</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next Torah &rarr;</a>
        ) : (
          <span class="disabled">Next Torah &rarr;</span>
        )}
      </div>

      <!-- Content -->
      <div class="reader-content mode-hebrew">
        <div class="reader-content-original">
{torahData.segments.map((seg) => (
          <div class="reader-segment-pair" id={`seg-${seg.index}`}>
            <div class="reader-segment segment-he" data-index={String(seg.index)}>
              <span class="segment-number">{seg.index}</span>
              <p data-nikud={seg.he_nikud || seg.he}>{seg.he}</p>
            </div>
            <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
              <span class="segment-number">{seg.index}</span>
              <p>{seg.en || 'Translation not yet available'}</p>
            </div>
          </div>
        ))}
        </div>
        {torahData.aligned_segments && (
          <div class="reader-content-aligned" style="display:none;">
            {torahData.aligned_segments.map((seg) => (
              <div class={`reader-segment-pair ${seg.type === 'note' ? 'segment-note' : ''}`} id={`aligned-${seg.index}`}>
                <div class="reader-segment segment-he" data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.he || '\u00A0'}</p>
                </div>
                <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.en || '\u00A0'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Bottom Navigation -->
      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous Torah</a>
        ) : (
          <span class="disabled">&larr; Previous Torah</span>
        )}
        <a href="/reader">All Torahs</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next Torah &rarr;</a>
        ) : (
          <span class="disabled">Next Torah &rarr;</span>
        )}
      </div>

      <!-- Keyboard Shortcuts Overlay -->
      <div class="reader-shortcuts-overlay">
        <div class="reader-shortcuts-panel">
          <h2>Keyboard Shortcuts</h2>
          <div class="shortcut-row"><span>Hebrew mode</span><span class="shortcut-key">H</span></div>
          <div class="shortcut-row"><span>English mode</span><span class="shortcut-key">E</span></div>
          <div class="shortcut-row"><span>Both columns</span><span class="shortcut-key">B</span></div>
          <div class="shortcut-row"><span>Toggle nikud</span><span class="shortcut-key">N</span></div>
          <div class="shortcut-row"><span>Fullscreen</span><span class="shortcut-key">F</span></div>
          <div class="shortcut-row"><span>Table of contents</span><span class="shortcut-key">T</span></div>
          <div class="shortcut-row"><span>Search in text</span><span class="shortcut-key">Ctrl+F</span></div>
          <div class="shortcut-row"><span>Save bookmark</span><span class="shortcut-key">S</span></div>
          <div class="shortcut-row"><span>Listen / Pause</span><span class="shortcut-key">L</span></div>
          <div class="shortcut-row"><span>Print</span><span class="shortcut-key">P</span></div>
          <div class="shortcut-row"><span>Next segment</span><span class="shortcut-key">J / ↓</span></div>
          <div class="shortcut-row"><span>Prev segment</span><span class="shortcut-key">K / ↑</span></div>
          <div class="shortcut-row"><span>Toggle favorite</span><span class="shortcut-key">G</span></div>
          <div class="shortcut-row"><span>Increase font</span><span class="shortcut-key">+</span></div>
          <div class="shortcut-row"><span>Decrease font</span><span class="shortcut-key">-</span></div>
          <div class="shortcut-row"><span>Previous torah</span><span class="shortcut-key">&larr;</span></div>
          <div class="shortcut-row"><span>Next torah</span><span class="shortcut-key">&rarr;</span></div>
          <div class="shortcut-row"><span>Show shortcuts</span><span class="shortcut-key">?</span></div>
          <div class="shortcut-row"><span>Close / Exit</span><span class="shortcut-key">Esc</span></div>
          <br />
          <button class="reader-btn" onclick="this.closest('.reader-shortcuts-overlay').classList.remove('open')">Close</button>
        </div>
      </div>

      <!-- Reader Script -->
      <script src="/reader-script.js?v=3" is:inline></script>
      <script src="/reader-notes.js" is:inline></script>
    </div>
  )}
</Layout>
