       img.includes('liberty') && img.includes('crown') || img.includes('statue') && img.includes('liberty') ||
       img.includes('india') || img.includes('dough') || img.includes('eggs') ||
       img.includes('yellow egg') || img.includes('blue letter') || img.includes('white letter') ||
