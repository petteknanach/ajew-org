}).join('');

const quickJump = vol1Quick.map(n => `<a href="#torah${n}" style="padding: 0.25rem 0.5rem; background: white; border-radius: 4px; font-size: 0.75rem; color: #666; text-decoration: none;">${n}</a>`).join('');

document.getElementById('quick-jump').innerHTML = quickJump;
document.getElementById('vol1-grid').innerHTML = vol1Links;
document.getElementById('vol2-grid').innerHTML = vol2Links;
