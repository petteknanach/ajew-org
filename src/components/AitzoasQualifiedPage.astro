---
import Layout from '../layouts/Layout.astro';
import Comments from './Comments.astro';
import {historyHTML,noteHTML} from '../lib/qualified-aitzoas362.mjs';
import {PIN,displayPlan} from '../../public/qualified-aitzoas362-core.mjs';
import {assertProjection,topicStructure,ownerNavigation} from '../../public/qualified-aitzoas-topics.mjs';
const {edition,view,index}=Astro.props;
assertProjection(edition,view,Astro.url.pathname,view.key);
const structure=topicStructure(edition),rows=view.rows;
const title=`${view.hebrewTitle} — ${view.title} — ${index.bookTitle}`;
const description=view.notice;
const url='https://ajew.org'+view.url;
const jsonLd={'@context':'https://schema.org','@type':'Article',headline:title,alternativeHeadline:view.hebrewTitle,author:{'@type':'Person',name:index.author},publisher:{'@type':'Organization',name:'ajew.org'},inLanguage:['he','en'],description,isPartOf:{'@type':'Book',name:index.bookTitle},url};
const crumbs=[{name:'Library',url:'https://ajew.org/reader'},{name:index.bookTitle,url:'https://ajew.org/reader/aitzoas-yeshuroas/1/'},{name:view.title,url}];
---
<Layout title={title} description={description} jsonLd={jsonLd} breadcrumbs={crumbs}>
 <div data-aitzoas362-yahrzeit-host aria-label="Dates"></div>
 <section class="aitzoas362" data-aitzoas362 data-section={view.section??undefined} data-view={view.key} data-edition-sha={PIN} data-ready="false" data-print-safe="false" data-mode="both" data-theme="day">
  <aside data-pending role="status">Loading reading tools…</aside>
  <noscript>You can read the full text and open Text notes below. Enable JavaScript to copy, save, share or print.</noscript>
  <p data-print-warning>This page could not be printed safely. Return to the book and try again.</p>
  <h1 data-print-heading>{view.title}</h1>
  <header><p data-view-hebrew lang="he" dir="rtl">{view.hebrewTitle}</p><p data-view-context>{view.notice}</p></header>

  <nav aria-label="Reading navigation">
   {view.previous&&<a href={view.previous.url}>← {view.previous.title}</a>}
   <a href="/reader/aitzoas-yeshuroas/1/">Contents</a><a href="/reader">All Books</a>
   {view.next&&<a href={view.next.url}>{view.next.title} →</a>}
  </nav>
  <section class="q-controls" aria-label="Reading tools">
   <div>{[['hebrew','Hebrew'],['english','English'],['both','Both']].map(([mode,label])=><button type="button" data-mode-button={mode} disabled aria-pressed={mode==='both'?'true':'false'}>{label}</button>)}

   </div>
   <details><summary>Reading settings</summary>
    <label>Text size <input data-font type="range" min="16" max="24" value="18" disabled /></label>
    <div>{[['day','Day'],['sepia','Sepia'],['night','Night']].map(([theme,label])=><button type="button" data-theme-button={theme} disabled>{label}</button>)}<button type="button" data-fullscreen disabled>Fullscreen</button><button type="button" data-bookmark disabled>Bookmark</button></div>
   </details>
   <label>Search this page <input data-query type="search" disabled /></label><output data-search-status aria-live="polite"></output>
   <div>{[['copy','Copy page'],['share','Share page'],['save','Save page to My Sefer']].map(([action,label])=><button type="button" data-action={action} disabled>{label}</button>)}<button type="button" data-print disabled>Print</button></div>
   <details><summary>Selected text</summary>
    <p>Select a passage in Hebrew or English. Copy, Share and Save include its complete paragraph and text notes.</p>
    <div><button type="button" data-selection-action="copy" disabled>Copy paragraph</button><button type="button" data-selection-action="share" disabled>Share paragraph</button><button type="button" data-selection-action="save" disabled>Save paragraph</button><button type="button" data-capture disabled>Highlight or add a note</button></div>
   </details>
   <details><summary>Keyboard shortcuts</summary><p>H / E / B: Hebrew / English / Both. P: print. J / K: next / previous paragraph.</p></details>
   <details><summary>On this page</summary><ol>{rows.map(r=><li><a href={`#seg-${r.stableIndex}`}>{ownerNavigation(edition,r.stableIndex).label}</a></li>)}</ol></details>
  </section>
  <p data-status role="status" aria-live="polite"></p>
  <section data-source-root aria-label="Book text">
   {rows.map(r=> (
    <article data-unit={r.owner} data-index={r.stableIndex} id={`seg-${r.stableIndex}`}>
     <h2>{ownerNavigation(edition,r.stableIndex).label}</h2>
     <section data-he-wrap><h3>Hebrew</h3><p data-source-field="he" lang="he" dir="rtl">{r.he}</p></section>
     <section data-en-wrap><h3>English</h3>{r.en===null?<p data-unavailable>{r.origin.notice} No historical fallback is used.</p>:<p data-source-field="en" lang="en">{displayPlan(r).en}</p>}</section>
     <details data-text-notes><summary>Text notes</summary>
      <section data-notes-root aria-label="Text notes" set:html={noteHTML(r)} />
      <section data-origin-wrap><h3>About this translation</h3><p data-origin>{r.origin.notice}</p></section>
      <Fragment set:html={historyHTML(r)} />
     </details>
     <div class="q-unit-controls">{[['copy','Copy paragraph'],['share','Share paragraph'],['save','Save paragraph']].map(([action,label])=><button type="button" data-action={action} disabled>{label}</button>)}</div>
    </article>
   ))}
  </section>
  <section class="q-annotations"><h2>Your notes</h2><div data-capture-host></div><div data-annotations></div></section>
  <details><summary>All topics</summary>
   <nav aria-label="All topics">{structure.topics.map(t=><a href={t.url} aria-current={view.key==='topic-'+t.slug?'page':undefined}>{t.hebrewTitle} — {t.title}</a>)}</nav>
   <nav aria-label="Introduction and closing">{structure.apparatus.slice(0,2).map(a=><a href={a.url}>{a.hebrewTitle} — {a.title}</a>)}</nav>
  </details>
 </section>
 <Comments teachingId={view.kind==='source'?`aitzoas-yeshuroas-1-${view.section}`:`aitzoas-yeshuroas-${view.key}`} teachingTitle={`aitzoas-yeshuroas — ${view.title}`} />
 <!-- This route intentionally does not load generic Reader/V2/notes/TTS source callbacks. -->
 <script is:inline>
  // Runs even if the module fetch/import fails. No shared callbacks/prototypes changed.
  (function(){const c=document.querySelector('[data-aitzoas362]');if(!c)return;
   const blocks=e=>{try{const s=getSelection();if(!s||s.isCollapsed)return false;if(c.contains(s.anchorNode)||c.contains(s.focusNode))return true;for(let i=0;i<s.rangeCount;i++)if(s.getRangeAt(i).intersectsNode(c))return true;}catch{return true;}return false;};
   for(const type of ['copy','cut','dragstart'])document.addEventListener(type,e=>{if(c.dataset.ready!=='true'&&blocks(e)){e.preventDefault();e.stopImmediatePropagation();if(e.clipboardData)e.clipboardData.setData('text/plain','');}},true);
  })();
 </script>
 <script type="module" src="/reader-aitzoas-qualifications.js?v=b87ea2615f1e8acc1863c0f9de43a5ce684d8e6c482f99c679a26969f85c5043" is:inline></script>
</Layout>
<style is:global>
 body:has([data-aitzoas362]) .ai-reader-access{display:none!important}
 .aitzoas362{max-width:76rem;margin:auto;padding:1rem;color:#171717;background:#fff;font:18px/1.7 system-ui;--q-font:18px}
 .aitzoas362 [data-source-field]{font-size:var(--q-font);white-space:pre-wrap;overflow-wrap:anywhere}
 .aitzoas362 [data-notes-root] p,.aitzoas362 [data-history-field],.aitzoas362 [data-origin]{white-space:pre-wrap;overflow-wrap:anywhere}
 .aitzoas362 [data-source-field="he"]{font-family:serif;font-size:calc(var(--q-font) + 2px)}
 .aitzoas362 [data-unit]{border-top:1px solid #888;padding:1rem 0;scroll-margin-top:5rem}
 .aitzoas362 button,.aitzoas362 input,.aitzoas362 nav a{margin:.25rem;padding:.45rem}
 .aitzoas362 nav{display:flex;flex-wrap:wrap;gap:.4rem}.aitzoas362 [data-notes-root]{border-inline-start:3px solid #94733c;padding-inline-start:1rem}
 .aitzoas362 [data-pending],.aitzoas362 [data-print-warning]{border:2px solid #8a310b;padding:1rem}
 .aitzoas362[data-ready="true"] [data-pending]{display:none}.aitzoas362 [data-print-warning]{display:none}
 .aitzoas362[data-mode="hebrew"] [data-en-wrap],.aitzoas362[data-mode="english"] [data-he-wrap]{display:none}
 .aitzoas362[data-theme="sepia"]{color:#2b2118;background:#faf1df}.aitzoas362[data-theme="night"]{color:#eee;background:#181818}
 .aitzoas362 pre{white-space:pre-wrap;overflow-wrap:anywhere}.aitzoas362 [data-capture-host]{position:relative}
 .aitzoas362 summary{cursor:pointer;padding:.5rem 0}.aitzoas362 [data-text-notes]{margin:.75rem 0}.aitzoas362 :is(button,input,a,summary):focus-visible{outline:2px solid currentColor;outline-offset:3px}.aitzoas362 [data-status]:empty{display:none}
 @media print{
  /* Authenticate the genuine Layout ancestors too; sourceInk remains strict. */
  html:has([data-aitzoas362]),body:has([data-aitzoas362]),body:has([data-aitzoas362]) #main-content:has([data-aitzoas362]){color:#000!important;-webkit-text-fill-color:#000!important}
  body>*{display:none!important}body:has([data-aitzoas362])>*:has([data-aitzoas362]){display:block!important}
  body *:not([data-aitzoas362]):not([data-aitzoas362] *):not(:has([data-aitzoas362])){display:none!important}
  [data-aitzoas362]{display:block!important;background:#fff!important;color:#000!important;max-width:none!important;margin:0!important;padding:0!important}
  [data-aitzoas362]>*,[data-aitzoas362] [data-source-root]{display:none!important}
  [data-aitzoas362] [data-print-warning]{display:block!important;color:#000!important;background:#fff!important}
  [data-aitzoas362][data-print-safe="true"]>[data-source-root],[data-aitzoas362][data-print-safe="true"]>[data-print-heading]{display:block!important}
  [data-aitzoas362][data-print-checking="true"]>[data-source-root],[data-aitzoas362][data-print-checking="true"]>[data-print-heading]{display:block!important}
  [data-aitzoas362][data-print-safe="true"]>[data-print-warning]{display:none!important}
  [data-aitzoas362]:is([data-print-safe="true"],[data-print-checking="true"]) :is([data-source-root] *,[data-print-heading]){display:block!important;position:static!important;overflow:visible!important;max-height:none!important;height:auto!important;opacity:1!important;visibility:visible!important;color:#000!important;-webkit-text-fill-color:#000!important;background:#fff!important;transform:none!important;clip:auto!important;clip-path:none!important;filter:none!important;mask-image:none!important;text-shadow:none!important;box-shadow:none!important;font-size:16px!important;letter-spacing:normal!important;word-spacing:0!important;text-indent:0!important;white-space:pre-wrap!important}
  [data-aitzoas362]:is([data-print-safe="true"],[data-print-checking="true"]) .q-unit-controls,[data-aitzoas362]:is([data-print-safe="true"],[data-print-checking="true"]) .q-unit-controls *{display:none!important}
  [data-aitzoas362]:is([data-print-safe="true"],[data-print-checking="true"]) summary{display:none!important}
  [data-aitzoas362] mark{background:#fff!important;color:#000!important}
 }
</style>
