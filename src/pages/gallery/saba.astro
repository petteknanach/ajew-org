      )&rbrace;
      &lbrace;portraits.length > 0 && (
        <div id="portraits" class="category-section">
          <h2><span class="icon">📸</span> Portraits <span class="hebrew">(דיוקנות)</span></h2>
          <div class="gallery-grid">
            &lbrace;portraits.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;withFriends.length > 0 && (
        <div id="withfriends" class="category-section">
          <h2><span class="icon">👥</span> With Friends <span class="hebrew">(עם חברים)</span></h2>
          <div class="gallery-grid">
            &lbrace;withFriends.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;withrebbe.length > 0 && (
        <div id="withrebbe" class="category-section">
          <h2><span class="icon">✡️</span> With Rebbe Nachman <span class="hebrew">(עם רבינו)</span></h2>
          <div class="gallery-grid">
            &lbrace;withrebbe.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;clothing.length > 0 && (
        <div id="clothing" class="category-section">
          <h2><span class="icon">👔</span> Clothing & Items <span class="hebrew">(ביגוד וחפצים)</span></h2>
          <div class="gallery-grid">
            &lbrace;clothing.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
