---
import Layout from '../../layouts/Layout.astro';

// Load both catalogs
import fs from 'node:fs';
import path from 'node:path';

let catalog1 = null;
let catalog2 = null;
let catalogSH = null;
try {
  const f1 = path.join(process.cwd(), 'public/reader/likutay-moharan/part-1/index.json');
  catalog1 = JSON.parse(fs.readFileSync(f1, 'utf8'));
} catch (e) { /* */ }
try {
  const f2 = path.join(process.cwd(), 'public/reader/likutay-moharan/part-2/index.json');
  catalog2 = JSON.parse(fs.readFileSync(f2, 'utf8'));
} catch (e) { /* */ }
try {
  const fSH = path.join(process.cwd(), 'public/reader/sefer-hamidos/index.json');
  catalogSH = JSON.parse(fs.readFileSync(fSH, 'utf8'));
} catch (e) { /* */ }
---

<Layout title="Likutay Moharan - Torah Reader" description="Read Likutay Moharan online - all 411 Torahs of Rabbi Nachman of Breslov in Hebrew. Part 1 (286 Torahs) and Part 2 Tinyana (125 Torahs).">
  <style>
    .lm-index {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-family: 'Open Sans', sans-serif;
      color: #222;
    }

    /* Header */
    .lm-header {
      text-align: center;
      margin-bottom: 40px;
      padding-bottom: 24px;
      border-bottom: 3px solid #1a365d;
    }
    .lm-header .hebrew-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 2.8em;
      color: #1a365d;
      direction: rtl;
      margin: 0 0 4px;
      font-weight: 700;
    }
    .lm-header h1 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.8em;
      color: #1a365d;
      margin: 0 0 8px;
    }
    .lm-header .subtitle {
      color: #666;
      font-size: 0.95em;
      margin: 0;
    }
    .lm-header .author {
      color: #888;
      font-size: 0.85em;
      margin: 8px 0 0;
      font-style: italic;
    }
    .lm-features {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .lm-features span {
      background: #f0ebe0;
      padding: 4px 12px;
      border-radius: 14px;
      font-size: 0.75em;
      color: #555;
    }

    /* Volume sections */
    .volume-section {
      margin-bottom: 40px;
    }
    .volume-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.4em;
      color: #1a365d;
      margin: 0 0 4px;
      font-weight: 700;
    }
    .volume-hebrew {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.3em;
      color: #333;
      direction: rtl;
      margin: 0 0 8px;
    }
    .volume-count {
      color: #888;
      font-size: 0.85em;
      margin: 0 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e0d6c2;
    }

    /* Torah links - clean simple list */
    .torah-list {
      columns: 3;
      column-gap: 24px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .torah-list li {
      break-inside: avoid;
      margin-bottom: 4px;
    }
    .torah-list a {
      display: inline-block;
      color: #1a365d;
      text-decoration: none;
      font-size: 0.92em;
      padding: 3px 6px;
      border-radius: 3px;
      transition: background 0.12s;
    }
    .torah-list a:hover {
      background: #e8e2d6;
      text-decoration: underline;
    }
    .torah-list .torah-num {
      font-weight: 600;
      min-width: 2.5em;
      display: inline-block;
    }

    /* Section dividers within a volume */
    .section-divider {
      margin: 16px 0;
      padding: 8px 12px;
      background: #f8f5ef;
      border-left: 3px solid #c4a265;
      font-size: 0.85em;
      color: #6b5a42;
      font-style: italic;
      column-span: all;
    }

    /* Coming soon */
    .coming-soon-section {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 2px solid #e0d6c2;
    }
    .coming-soon-section h2 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.2em;
      color: #888;
      margin: 0 0 16px;
    }
    .coming-soon-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
    }
    .coming-soon-item {
      text-align: center;
      padding: 20px;
      color: #999;
      font-style: italic;
      border: 1px dashed #ddd;
      border-radius: 8px;
      font-size: 0.9em;
    }

    @media (max-width: 768px) {
      .torah-list { columns: 2; }
      .lm-header .hebrew-title { font-size: 2.2em; }
      .lm-header h1 { font-size: 1.4em; }
    }
    @media (max-width: 480px) {
      .torah-list { columns: 1; }
    }
  </style>

  <div class="lm-index">
    <div class="lm-header">
      <div class="hebrew-title">&#1500;&#1497;&#1511;&#1493;&#1496;&#1497; &#1502;&#1493;&#1492;&#1512;"&#1503;</div>
      <h1>Likutay Moharan</h1>
      <p class="subtitle">The collected teachings of Rabbainu Na Nach Nachma Nachman MeUman</p>
      <p class="author">Compiled by Rabbi Noson of Breslov</p>
      <div class="lm-features">
        <span>Hebrew / English / Both</span>
        <span>Day / Sepia / Night</span>
        <span>Bookmarks</span>
        <span>Search</span>
        <span>Fullscreen</span>
      </div>
    </div>

    <!-- Volume 1 (Kama) -->
    <div class="volume-section">
      <h2 class="volume-title">Volume 1 (Kama)</h2>
      <div class="volume-hebrew">&#1502;&#1492;&#1491;&#1493;&#1512;&#1488; &#1511;&#1502;&#1488;</div>
      {catalog1 && <p class="volume-count">{catalog1.totalTorahs} Torahs</p>}
      {catalog1 ? (
        <ul class="torah-list">
          {catalog1.torahs.map(t => (
            <li>
              <a href={t.url}>
                <span class="torah-num">[Torah {t.displayNumber || t.number}]</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>Loading...</p>
      )}
    </div>

    <!-- Volume 2 (Tinyana) -->
    <div class="volume-section">
      <h2 class="volume-title">Volume 2 (Tinyana)</h2>
      <div class="volume-hebrew">&#1502;&#1492;&#1491;&#1493;&#1512;&#1488; &#1489;&#1514;&#1512;&#1488; (&#1514;&#1504;&#1497;&#1504;&#1488;)</div>
      {catalog2 && <p class="volume-count">{catalog2.totalTorahs} Torahs</p>}
      {catalog2 ? (
        <ul class="torah-list">
          {catalog2.torahs.map(t => (
            <li>
              <a href={t.url}>
                <span class="torah-num">[Torah {t.displayNumber || t.number}]</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>Loading...</p>
      )}
    </div>

    <!-- Sefer Hamidos -->
    <div class="volume-section">
      <h2 class="volume-title">Sefer Hamidos (The Book of Traits)</h2>
      <div class="volume-hebrew">&#1505;&#1508;&#1512; &#1492;&#1502;&#1497;&#1491;&#1493;&#1514;</div>
      {catalogSH && <p class="volume-count">{catalogSH.totalTorahs} Topics (A-Z by Hebrew)</p>}
      {catalogSH ? (
        <ul class="torah-list">
          {catalogSH.torahs.map(t => (
            <li>
              <a href={t.url}>
                <span class="torah-num">{t.hebrewTitle || t.title}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>Loading...</p>
      )}
    </div>

    <!-- Coming Soon -->
    <div class="coming-soon-section">
      <h2>More Books Coming Soon</h2>
      <div class="coming-soon-grid">
        <div class="coming-soon-item">Likutay Halachos</div>
        <div class="coming-soon-item">Likutay Tefilos</div>
        <div class="coming-soon-item">Sipurey Maasiyos</div>
        <div class="coming-soon-item">Sichos HaRan</div>
        <div class="coming-soon-item">Shivchay HaRan</div>
        <div class="coming-soon-item">Sichos HaRan</div>
      </div>
    </div>
  </div>
</Layout>
