---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() { return [{ params: { part: '1' } }]; }
const { part } = Astro.params;
const partNum = parseInt(part || '1');
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/aitzoas-hamivooaroas/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) { console.error('Error loading Aitzoas HaMivooaroas index:', e); }
const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || 'Aitzoas HaMivooaroas'} — Directory`} description={`Directory for ${indexData?.title || 'Aitzoas HaMivooaroas'}, with aligned Hebrew and English.`}>
  <ReaderDirectory
    title={indexData?.title || 'Aitzoas HaMivooaroas'}
    hebrewTitle={indexData?.hebrewTitle || 'עצות המבוארות'}
    subtitle={indexData?.author || 'Rabbi Shimshon Barsky'}
    countLabel={`${totalSections} chapters`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/aitzoas-hamivooaroas/${partNum}/`}
  />
</Layout>
