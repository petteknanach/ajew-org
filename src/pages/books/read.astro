  &rbrace;

  .loading &lbrace;
    text-align: center;
    padding: 4rem 2rem;
  &rbrace;

  .spinner &lbrace;
    width: 40px;
    height: 40px;
    border: 4px solid #e2e8f0;
    border-top-color: #1a365d;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1rem;
  &rbrace;

  @keyframes spin &lbrace;
