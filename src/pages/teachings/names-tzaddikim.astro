---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

let allTzaddikim = [];
try {
  const raw = fs.readFileSync(path.join(process.cwd(), 'public/data/tzaddikim-database-complete.json'), 'utf8');
  const data = JSON.parse(raw);
  allTzaddikim = data.all_tzaddikim || [];
} catch (e) {}

const monthOrder = ['Tishrei','Cheshvan','Kislev','Tevet','Sh\'vat','Adar','Adar II','Nisan','Iyyar','Sivan','Tamuz','Av','Elul'];

// Group by month
const byMonth = {};
for (const tz of allTzaddikim) {
  const m = tz.yahrzeit_month || 'Unknown';
  if (!byMonth[m]) byMonth[m] = [];
  byMonth[m].push(tz);
}

// Sort each month by day
for (const m of Object.keys(byMonth)) {
  byMonth[m].sort((a, b) => parseInt(a.yahrzeit_day) - parseInt(b.yahrzeit_day));
}

const orderedMonths = monthOrder.filter(m => byMonth[m]?.length > 0);
// Add any months not in order
for (const m of Object.keys(byMonth)) {
  if (!orderedMonths.includes(m)) orderedMonths.push(m);
}

const hebrewMonths = {
  'Tishrei': 'תשרי', 'Cheshvan': 'חשון', 'Kislev': 'כסלו', 'Tevet': 'טבת',
  "Sh'vat": 'שבט', 'Adar': 'אדר', 'Adar II': 'אדר ב', 'Nisan': 'ניסן',
  'Iyyar': 'אייר', 'Sivan': 'סיון', 'Tamuz': 'תמוז', 'Av': 'אב', 'Elul': 'אלול'
};

const catColors = {
  'biblical': '#276749',
  'talmudic': '#744210',
  'breslov': '#1a365d',
  'chassidic': '#553c9a',
  'rishonim': '#9b2c2c',
  'lithuanian': '#2c5282',
  'chabad': '#4a5568',
  'sephardic': '#b7791f',
  'other': '#718096'
};
---

<Layout title="Yahrzeit List - All Tzaddikim" description="Complete list of tzaddikim yahrzeits by Hebrew month. Review and approve entries for the yahrzeit box.">
  <style>
    .tz-page { max-width: 900px; margin: 0 auto; padding: 24px 16px 80px; font-family: 'Open Sans', sans-serif; }
    .tz-header { text-align: center; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 3px solid #1a365d; }
    .tz-header h1 { font-family: 'Frank Ruhl Libre', serif; font-size: 2em; color: #1a365d; margin: 0 0 8px; }
    .tz-header .subtitle { color: #666; font-size: 0.9em; }
    .tz-stats { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
    .tz-stats span { background: #f0ebe0; padding: 4px 12px; border-radius: 14px; font-size: 0.75em; color: #555; }

    .month-nav { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 24px; position: sticky; top: 0; background: #fffdf7; padding: 12px 0; z-index: 10; border-bottom: 1px solid #e0d6c2; }
    .month-nav a { padding: 4px 10px; border-radius: 6px; background: #f0ebe0; color: #1a365d; text-decoration: none; font-size: 0.8em; font-weight: 600; }
    .month-nav a:hover { background: #1a365d; color: white; }

    .month-section { margin-bottom: 32px; }
    .month-header { font-family: 'Frank Ruhl Libre', serif; font-size: 1.4em; color: #1a365d; margin: 0 0 4px; padding-top: 16px; }
    .month-hebrew { font-family: 'Frank Ruhl Libre', serif; font-size: 1.1em; color: #555; direction: rtl; margin: 0 0 4px; }
    .month-count { font-size: 0.8em; color: #888; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid #e0d6c2; }

    .tz-table { width: 100%; border-collapse: collapse; font-size: 0.85em; }
    .tz-table th { text-align: left; padding: 6px 8px; background: #f0ebe0; color: #1a365d; font-weight: 600; border-bottom: 2px solid #c4a265; }
    .tz-table td { padding: 6px 8px; border-bottom: 1px solid #e8e2d6; vertical-align: top; }
    .tz-table tr:hover { background: #faf7f0; }
    .tz-day { font-weight: 700; color: #1a365d; min-width: 30px; }
    .tz-name { color: #2d3748; }
    .tz-heb { font-family: 'Frank Ruhl Libre', serif; direction: rtl; color: #333; }
    .tz-year { color: #4a5568; font-size: 0.85em; white-space: nowrap; }
    .tz-notes { color: #718096; font-size: 0.9em; }
    .tz-cat { display: inline-block; padding: 1px 6px; border-radius: 4px; font-size: 0.75em; color: white; }
    .tz-source { font-size: 0.75em; color: #a0aec0; }

    @media (max-width: 600px) {
      .tz-table { font-size: 0.78em; }
      .tz-table th:nth-child(5), .tz-table td:nth-child(5) { display: none; }
      .tz-table th:nth-child(6), .tz-table td:nth-child(6) { display: none; }
    }
  </style>

  <div class="tz-page">
    <div class="tz-header">
      <h1>Yahrzeit List - All Tzaddikim</h1>
      <p class="subtitle">Complete database for review - {allTzaddikim.length} entries</p>
      <div class="tz-stats">
        <span>biblical: {allTzaddikim.filter(t => t.category === 'biblical').length}</span>
        <span>talmudic: {allTzaddikim.filter(t => t.category === 'talmudic').length}</span>
        <span>breslov: {allTzaddikim.filter(t => t.category === 'breslov').length}</span>
        <span>chassidic: {allTzaddikim.filter(t => t.category === 'chassidic').length}</span>
        <span>lithuanian: {allTzaddikim.filter(t => t.category === 'lithuanian').length}</span>
        <span>other: {allTzaddikim.filter(t => !['biblical','talmudic','breslov','chassidic','lithuanian'].includes(t.category)).length}</span>
      </div>
    </div>

    <nav class="month-nav">
      {orderedMonths.map(m => (
        <a href={`#${m.replace(/'/g, '')}`}>{m}</a>
      ))}
    </nav>

    {orderedMonths.map(m => (
      <div class="month-section" id={m.replace(/'/g, '')}>
        <h2 class="month-header">{m}</h2>
        <div class="month-hebrew">{hebrewMonths[m] || m}</div>
        <p class="month-count">{byMonth[m].length} entries</p>
        <table class="tz-table">
          <thead>
            <tr>
              <th>Day</th>
              <th>Name</th>
              <th>Hebrew</th>
              <th>Year</th>
              <th>Notes</th>
              <th>Category</th>
            </tr>
          </thead>
          <tbody>
            {byMonth[m].map(tz => (
              <tr>
                <td class="tz-day">{tz.yahrzeit_day}</td>
                <td class="tz-name">{tz.name}</td>
                <td class="tz-heb">{tz.hebrew_name && /[\u0590-\u05FF]/.test(tz.hebrew_name) ? tz.hebrew_name : ''}</td>
                <td class="tz-year">{tz.year_passed || ''}</td>
                <td class="tz-notes">{tz.notes || ''}</td>
                <td><span class="tz-cat" style={`background:${catColors[tz.category] || '#718096'}`}>{tz.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </div>
</Layout>
