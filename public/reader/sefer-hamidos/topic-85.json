  "id": "topic-85",
  "title": "פרישות",
  "hebrewTitle": "פְּרִישׁוּת",
  "part": 1,
  "segments": [
    {
      "index": 1,
      "he": "חלק שני",
      "en": "Part Two",
      "id": "sh-פרישות-p2"
    },
    {
      "index": 2,
      "he": "א.\n\nאָדָם הַמִּתְנַהֵג בִּפְרִישׁוּת וְאַחַר־כָּךְ חוֹזֵר מִפְּרִישׁוּתוֹ, עַל־יְדֵי זֶה הוּא נוֹפֵל לְתַאֲוָה נוֹסֶפֶת מִמַּה שֶּׁהָיָה לוֹ קֹדֶם פְּרִישׁוּתוֹ.",
      "en": "",
      "id": "sh-פרישות-א"
    },
    {
      "index": 3,
      "he": "ב.\n\nהַפְּרִישׁוּת מֵבִיא שׂ ֹ בַע.",
      "en": "",
      "id": "sh-פרישות-ב"
    },
    {
      "index": 4,
      "he": "ג.\n\nפְּרִישׁוּת מִתַּשְׁמִישׁ חָשׁוּב כְּמוֹ תַּעֲנִית.",
      "en": "",
      "id": "sh-פרישות-ג"
    },
    {
      "index": 5,
      "he": "ד.\n\nחוֹלַאַת שֶׁל רְקִיקַת דָּם בָּא, עַל־יְדֵי שֶׁמְּבַטֵּל עוֹנָה שֶׁל לֵיל טְבִילָה.",
      "en": "",
      "id": "sh-פרישות-ד"
    }
  ],
