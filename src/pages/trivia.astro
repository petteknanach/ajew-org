      ]
    };

    // ==================== GAME STATE ====================
    let lang = 'en'; // 'en' or 'he'

    let state = {
      currentLevel: 1,
      selectedTopics: ['all'],
      isCompetitive: false,
      playerName: '',
      playerEmail: '',
      score: 0,
      currentQ: 0,
      streak: 0,
      bestStreak: 0,
      correct: 0,
      wrong: 0,
      totalTime: 0,
      questionTimes: [],
      timer: null,
      timeLeft: 30,
      maxTime: 30,
      questionSet: [],
      answers: [],
      timerRunning: false
    };

    const QUESTIONS_PER_GAME = 10;
    const TIME_PER_LEVEL = { 1: 30, 2: 25, 3: 20, 4: 15 };
    const POINTS_BASE = { 1: 100, 2: 150, 3: 200, 4: 300 };
    const STREAK_BONUS = 50;
    const LEADERBOARD_KEY = 'ajew_trivia_leaderboard';

    // ==================== DOM REFS ====================
    const $ = (s) => document.querySelector(s);
    const $$ = (s) => document.querySelectorAll(s);

    const menuScreen = $('#menuScreen');
    const gameScreen = $('#gameScreen');
    const resultsScreen = $('#resultsScreen');
    const registerModal = $('#registerModal');

    // ==================== SCREEN MANAGEMENT ====================
    function showScreen(screen) {
      $$('.screen').forEach(s => { s.classList.remove('active'); s.classList.add('hidden'); });
      screen.classList.remove('hidden');
      screen.classList.add('active');
    }

    // ==================== LEVEL SELECTION ====================
    $$('.level-card').forEach(card => {
      card.addEventListener('click', () => {
        $$('.level-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        state.currentLevel = parseInt(card.dataset.level);
      });
    });

    // Default select level 1
    document.querySelector('.level-card[data-level="1"]').classList.add('selected');

    // ==================== TOPIC SELECTION ====================
    $$('.topic-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const topic = chip.dataset.topic;
        if (topic === 'all') {
          // Deselect all others, select "all"
          $$('.topic-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          state.selectedTopics = ['all'];
        } else {
          // Toggle this topic, deselect "all"
          document.querySelector('.topic-chip[data-topic="all"]').classList.remove('active');
          chip.classList.toggle('active');
          state.selectedTopics = [...$$('.topic-chip.active')].map(c => c.dataset.topic).filter(t => t !== 'all');
          // If nothing selected, revert to all
          if (state.selectedTopics.length === 0) {
            document.querySelector('.topic-chip[data-topic="all"]').classList.add('active');
            state.selectedTopics = ['all'];
          }
        }
      });
    });

    // ==================== LANGUAGE TOGGLE ====================
    $('#langToggle').addEventListener('click', () => {
      lang = lang === 'en' ? 'he' : 'en';
      document.querySelector('.lang-en').classList.toggle('active', lang === 'en');
      document.querySelector('.lang-he').classList.toggle('active', lang === 'he');
      // Update all data-en/data-he elements on menu screen
      document.querySelectorAll('[data-en][data-he]').forEach(el => {
        el.textContent = el.getAttribute('data-' + lang);
      });
      // Set page direction for Hebrew
      document.querySelector('.trivia-page').style.direction = lang === 'he' ? 'rtl' : 'ltr';
    });

    // ==================== PLAY BUTTONS ====================
    $('#playForFun').addEventListener('click', () => {
      state.isCompetitive = false;
      startGame();
    });

    $('#playCompetitive').addEventListener('click', () => {
      state.isCompetitive = true;
      // Check if already registered
      const saved = localStorage.getItem('ajew_trivia_player');
      if (saved) {
        const player = JSON.parse(saved);
        state.playerName = player.name;
        state.playerEmail = player.email;
        startGame();
      } else {
        registerModal.classList.remove('hidden');
      }
    });

    $('#closeRegister').addEventListener('click', () => {
      registerModal.classList.add('hidden');
    });

    $('#registerForm').addEventListener('submit', (e) => {
      e.preventDefault();
      state.playerName = $('#playerName').value.trim();
      state.playerEmail = $('#playerEmail').value.trim();
      localStorage.setItem('ajew_trivia_player', JSON.stringify({
        name: state.playerName,
        email: state.playerEmail
      }));
      registerModal.classList.add('hidden');
      startGame();
    });

    // ==================== GAME LOGIC ====================
    function shuffleArray(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function startGame() {
      state.score = 0;
      state.currentQ = 0;
      state.streak = 0;
      state.bestStreak = 0;
      state.correct = 0;
      state.wrong = 0;
      state.totalTime = 0;
      state.questionTimes = [];
      state.answers = [];
      state.maxTime = TIME_PER_LEVEL[state.currentLevel];
      // Filter by selected topics
      let pool = questions[state.currentLevel];
      if (!state.selectedTopics.includes('all')) {
        pool = pool.filter(q => q.topics && q.topics.some(t => state.selectedTopics.includes(t)));
      }
      // If filtered pool is too small, pull from all levels with matching topics
      if (pool.length < QUESTIONS_PER_GAME && !state.selectedTopics.includes('all')) {
        const allLevels = [1,2,3,4].flatMap(l => questions[l]);
        pool = allLevels.filter(q => q.topics && q.topics.some(t => state.selectedTopics.includes(t)));
      }
      state.questionSet = shuffleArray(pool).slice(0, QUESTIONS_PER_GAME);

      $('#totalQuestions').textContent = QUESTIONS_PER_GAME;
      $('#scoreDisplay').textContent = '0';
      showScreen(gameScreen);
      showQuestion();
    }

    function showQuestion() {
      if (state.currentQ >= state.questionSet.length) {
        endGame();
        return;
      }

      const q = state.questionSet[state.currentQ];
      const isHe = lang === 'he';
      const qText = isHe && q.qHe ? q.qHe : q.q;
      const aTexts = isHe && q.aHe ? q.aHe : q.a;

      // Update language-dependent labels
      document.querySelectorAll('[data-en][data-he]').forEach(el => {
        el.textContent = el.getAttribute('data-' + lang);
      });

      $('#questionNum').textContent = state.currentQ + 1;
      $('#questionCategory').textContent = q.cat;
      $('#questionText').textContent = qText;
      if (isHe) { $('#questionText').style.direction = 'rtl'; } else { $('#questionText').style.direction = 'ltr'; }
      $('#streakText').textContent = state.streak > 0 ? `🔥 Streak: ${state.streak}` : '';
      $('#streakBar').className = 'streak-bar' + (state.streak >= 3 ? ' on-fire' : '');

      const feedback = $('#feedback');
      feedback.classList.add('hidden');

      // Shuffle answers but track correct
      const indices = [0, 1, 2, 3];
      const shuffled = shuffleArray(indices);
      const correctIdx = shuffled.indexOf(q.correct);

      const grid = $('#answersGrid');
      grid.innerHTML = '';
      const labels = isHe ? ['א','ב','ג','ד'] : ['A','B','C','D'];
      shuffled.forEach((origIdx, btnIdx) => {
        const btn = document.createElement('button');
        btn.className = 'answer-btn';
        if (isHe) btn.style.direction = 'rtl';
        const label = document.createElement('span');
        label.className = 'answer-label';
        label.textContent = labels[btnIdx];
        const text = document.createElement('span');
        text.className = 'answer-text';
        text.textContent = aTexts[origIdx];
        btn.appendChild(label);
        btn.appendChild(text);
        btn.dataset.idx = btnIdx;
        btn.dataset.correct = btnIdx === correctIdx ? 'true' : 'false';
        btn.addEventListener('click', () => handleAnswer(btn, btnIdx === correctIdx, q));
        grid.appendChild(btn);
      });

      startTimer();
    }

    function startTimer() {
      state.timeLeft = state.maxTime;
      state.timerRunning = true;
      updateTimerDisplay();

      if (state.timer) clearInterval(state.timer);
      state.timer = setInterval(() => {
        state.timeLeft -= 0.1;
        if (state.timeLeft <= 0) {
          state.timeLeft = 0;
          state.timerRunning = false;
          clearInterval(state.timer);
          handleTimeout();
        }
        updateTimerDisplay();
      }, 100);
    }

    function updateTimerDisplay() {
      const pct = state.timeLeft / state.maxTime;
      const circle = $('#timerCircle');
      const circumference = 2 * Math.PI * 45;
      circle.style.strokeDasharray = circumference;
      circle.style.strokeDashoffset = circumference * (1 - pct);

      // Color changes
      const ring = $('#timerRing');
      if (pct > 0.5) ring.className = 'timer-ring';
      else if (pct > 0.25) ring.className = 'timer-ring warning';
      else ring.className = 'timer-ring danger';

      $('#timerText').textContent = Math.ceil(state.timeLeft);
    }

    function handleAnswer(btn, isCorrect, q) {
      if (!state.timerRunning) return;
      state.timerRunning = false;
      clearInterval(state.timer);

      const timeTaken = state.maxTime - state.timeLeft;
      state.questionTimes.push(timeTaken);

      // Highlight answers
      $$('.answer-btn').forEach(b => {
        b.disabled = true;
        if (b.dataset.correct === 'true') b.classList.add('correct');
        if (b === btn && !isCorrect) b.classList.add('wrong');
      });

      if (isCorrect) {
        state.correct++;
        state.streak++;
        if (state.streak > state.bestStreak) state.bestStreak = state.streak;
        // Points: base + time bonus + streak bonus
        const timeBonus = Math.round((state.timeLeft / state.maxTime) * POINTS_BASE[state.currentLevel]);
        const streakBonus = state.streak >= 3 ? STREAK_BONUS * (state.streak - 2) : 0;
        const points = POINTS_BASE[state.currentLevel] + timeBonus + streakBonus;
        state.score += points;
        showFeedback(true, `+${points} points!${streakBonus > 0 ? ' (🔥 streak bonus!)' : ''}`, q.source);
      } else {
        state.wrong++;
        state.streak = 0;
        const correctText = (lang === 'he' && q.aHe) ? q.aHe[q.correct] : q.a[q.correct];
        showFeedback(false, lang === 'he' ? `התשובה הנכונה: ${correctText}` : `The correct answer was: ${correctText}`, q.source);
      }

      state.answers.push({ q: q.q, qHe: q.qHe, correct: isCorrect, userAnswer: btn.textContent, correctAnswer: q.a[q.correct], correctAnswerHe: q.aHe ? q.aHe[q.correct] : '', source: q.source });
      $('#scoreDisplay').textContent = state.score;

      setTimeout(() => {
        state.currentQ++;
        showQuestion();
      }, 2200);
    }

    function handleTimeout() {
      const q = state.questionSet[state.currentQ];
      state.wrong++;
      state.streak = 0;
      state.questionTimes.push(state.maxTime);

      $$('.answer-btn').forEach(b => {
        b.disabled = true;
        if (b.dataset.correct === 'true') b.classList.add('correct');
      });

      const correctText = (lang === 'he' && q.aHe) ? q.aHe[q.correct] : q.a[q.correct];
      showFeedback(false, lang === 'he' ? `⏰ נגמר הזמן! התשובה: ${correctText}` : `⏰ Time's up! The answer was: ${correctText}`, q.source);
      state.answers.push({ q: q.q, qHe: q.qHe, correct: false, userAnswer: lang === 'he' ? '(נגמר הזמן)' : '(timed out)', correctAnswer: q.a[q.correct], correctAnswerHe: q.aHe ? q.aHe[q.correct] : '', source: q.source });

      setTimeout(() => {
        state.currentQ++;
        showQuestion();
      }, 2200);
    }

    function showFeedback(isCorrect, text, source) {
      const feedback = $('#feedback');
      feedback.classList.remove('hidden');
      feedback.className = 'question-feedback ' + (isCorrect ? 'fb-correct' : 'fb-wrong');
      $('#feedbackIcon').textContent = isCorrect ? '✓' : '✗';
      $('#feedbackText').textContent = text;
      $('#feedbackSource').textContent = source ? `📖 ${source}` : '';
    }

    // ==================== END GAME ====================
    function endGame() {
      clearInterval(state.timer);
      showScreen(resultsScreen);
      // Update language-dependent elements on results screen
      document.querySelectorAll('[data-en][data-he]').forEach(el => {
        el.textContent = el.getAttribute('data-' + lang);
      });

      const pct = state.correct / QUESTIONS_PER_GAME;
      let title;
      const isHe = lang === 'he';
      if (pct === 1) title = isHe ? "🏆 !ציון מושלם 🏆" : "🏆 PERFECT SCORE! 🏆";
      else if (pct >= 0.8) title = isHe ? "🌟 !מצוין" : "🌟 Excellent!";
      else if (pct >= 0.6) title = isHe ? "👍 !כל הכבוד" : "👍 Good Job!";
      else if (pct >= 0.4) title = isHe ? "📖 !המשך ללמוד" : "📖 Keep Learning!";
      else title = isHe ? "💪 !אל תוותר" : "💪 Don't Give Up!";

      $('#resultsTitle').textContent = title;
      $('#finalScore').textContent = state.score;
      $('#correctCount').textContent = state.correct;
      $('#wrongCount').textContent = state.wrong;
      $('#bestStreak').textContent = state.bestStreak;
      const avgTime = state.questionTimes.length ? (state.questionTimes.reduce((a,b) => a + b, 0) / state.questionTimes.length).toFixed(1) : 0;
      $('#avgTime').textContent = avgTime + 's';

      // Save score
      if (state.isCompetitive && state.playerName) {
        saveScore();
      }

      // Show rank
      const rank = getRank();
      const rankEl = $('#resultsRank');
      if (rank) {
        rankEl.innerHTML = `<p>🏆 You ranked <strong>#${rank}</strong> on the leaderboard!</p>`;
      } else {
        rankEl.innerHTML = state.isCompetitive ? '' : '<p>Play in competitive mode to appear on the leaderboard!</p>';
      }

      // Build review
      const reviewList = $('#reviewList');
      reviewList.innerHTML = '';
      state.answers.forEach((a, i) => {
        const div = document.createElement('div');
        div.className = 'review-item ' + (a.correct ? 'review-correct' : 'review-wrong');
        const isHe = lang === 'he';
        const reviewQ = isHe && a.qHe ? a.qHe : a.q;
        const reviewCorrect = isHe && a.correctAnswerHe ? a.correctAnswerHe : a.correctAnswer;
        div.innerHTML = `
          <div class="review-q" ${isHe ? 'dir="rtl"' : ''}><strong>${i+1}.</strong> ${reviewQ}</div>
          <div class="review-a">${a.correct ? '✓' : '✗'} ${isHe ? 'תשובתך:' : 'Your answer:'} ${a.userAnswer}</div>
          ${!a.correct ? `<div class="review-correct-a">${isHe ? 'נכון:' : 'Correct:'} ${reviewCorrect}</div>` : ''}
          <div class="review-source">📖 ${a.source}</div>
        `;
        reviewList.appendChild(div);
      });
    }

    // ==================== LEADERBOARD ====================
    function getLeaderboard() {
      try {
        return JSON.parse(localStorage.getItem(LEADERBOARD_KEY) || '[]');
      } catch { return []; }
    }

    function saveScore() {
      const lb = getLeaderboard();
      lb.push({
        name: state.playerName,
        score: state.score,
        level: state.currentLevel,
        correct: state.correct,
        total: QUESTIONS_PER_GAME,
        streak: state.bestStreak,
        date: new Date().toISOString()
      });
      lb.sort((a, b) => b.score - a.score);
      // Keep top 100
      localStorage.setItem(LEADERBOARD_KEY, JSON.stringify(lb.slice(0, 100)));
    }

    function getRank() {
      if (!state.isCompetitive) return null;
      const lb = getLeaderboard();
      const idx = lb.findIndex(e => e.score === state.score && e.name === state.playerName && e.date);
      return idx >= 0 ? idx + 1 : null;
    }

    function renderLeaderboard(filterLevel) {
      const lb = getLeaderboard();
      const filtered = filterLevel === 'all' ? lb : lb.filter(e => e.level == filterLevel);
      const list = $('#leaderboardList');

      if (filtered.length === 0) {
        list.innerHTML = '<p class="empty-lb">No scores yet — be the first!</p>';
        return;
      }

      const levelIcons = { 1: '🌱', 2: '📖', 3: '🧠', 4: '👑' };
      list.innerHTML = filtered.slice(0, 10).map((e, i) => `
        <div class="lb-entry ${i < 3 ? 'lb-top' + (i+1) : ''}">
          <span class="lb-rank">${i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i+1)}</span>
          <span class="lb-name">${e.name}</span>
          <span class="lb-level">${levelIcons[e.level] || ''}</span>
          <span class="lb-score">${e.score}</span>
        </div>
      `).join('');
    }

    // Leaderboard tabs
    $$('.lb-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        $$('.lb-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        renderLeaderboard(tab.dataset.lbLevel);
      });
    });

    // Initial leaderboard render
    renderLeaderboard('all');

    // ==================== RESULTS ACTIONS ====================
    $('#playAgain').addEventListener('click', startGame);
    $('#backToMenu').addEventListener('click', () => showScreen(menuScreen));
    $('#shareScore').addEventListener('click', () => {
      const text = `🔥 I scored ${state.score} on Torah Trivia (Level ${state.currentLevel})! ${state.correct}/${QUESTIONS_PER_GAME} correct with a ${state.bestStreak} streak! Try it: ${window.location.href}`;
      if (navigator.share) {
        navigator.share({ title: 'Torah Trivia Score', text });
      } else {
        navigator.clipboard.writeText(text).then(() => {
          alert('Score copied to clipboard!');
        });
      }
    });

  })();
  </script>

