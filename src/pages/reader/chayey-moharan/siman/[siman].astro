---
import Layout from '../../../../layouts/Layout.astro';
import TeachingVideo from '../../../../components/TeachingVideo.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const paths = [];
  const simanDir = path.join(process.cwd(), 'public/reader/chayey-moharan/simanim');
  
  if (fs.existsSync(simanDir)) {
    const files = fs.readdirSync(simanDir).filter(f => f.startsWith('siman-') && f.endsWith('.json'));
    for (const f of files) {
      const num = parseInt(f.replace('siman-', '').replace('.json', ''));
      if (!isNaN(num)) {
        paths.push({ params: { siman: String(num) } });
      }
    }
  }
  
  return paths;
}

const { siman } = Astro.params;
const simanNum = parseInt(siman);

let simanData = null;
let error = null;

try {
  const filePath = path.join(process.cwd(), `public/reader/chayey-moharan/simanim/siman-${simanNum}.json`);
  if (fs.existsSync(filePath)) {
    simanData = JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } else {
    error = `Siman ${simanNum} not found`;
  }
} catch (e) {
  error = 'Error loading content';
}

const bookName = 'Chayey Moharan';
const bookHebrew = 'חיי מוהר"ן';

const pageTitle = simanData
  ? `Siman ${simanNum} — ${simanData.section || 'Chayey Moharan'}`
  : 'Siman Not Found';
const pageDesc = simanData
  ? `${simanData.section || 'Chayey Moharan'} — Siman ${simanNum}. ${simanData.hebrewTitle || ''}`
  : '';
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="siman-container">
    {error ? (
      <div class="siman-error">
        <h1>Siman {simanNum} Not Found</h1>
        <p>{error}</p>
        <a href="/reader/chayey-moharan" class="back-link">← Back to Chayay Moharan Directory</a>
      </div>
    ) : (
      <>
        <!-- Navigation -->
        <nav class="siman-nav">
          <a href="/reader/chayey-moharan" class="nav-back">← Directory</a>
          <div class="nav-siman">
            <span class="nav-label">Siman</span>
            <span class="nav-number">{simanNum}</span>
          </div>
          <div class="nav-arrows">
            {simanNum > 60 && (
              <a href={`/reader/chayey-moharan/siman/${simanNum - 1}`} class="nav-arrow">◂ Previous</a>
            )}
            {simanNum < 615 && (
              <a href={`/reader/chayey-moharan/siman/${simanNum + 1}`} class="nav-arrow">Next ▸</a>
            )}
          </div>
        </nav>

        <!-- Section context -->
        {simanData.section && (
          <div class="section-context">
            <span class="section-he">{simanData.sectionHe}</span>
            <span class="section-en">{simanData.section}</span>
          </div>
        )}

        <!-- Content -->
        <div class="siman-content">
          {simanData.segments?.map((seg: any) => (
            <div class="siman-segment">
              {seg.he && (
                <div class="segment-he">
                  <p>{seg.he}</p>
                </div>
              )}
              {seg.en && (
                <div class="segment-en">
                  <p>{seg.en}</p>
                </div>
              )}
              {!seg.he && !seg.en && (
                <p class="segment-empty">Content not yet available for this siman.</p>
              )}
            </div>
          ))}

          {(!simanData.segments || simanData.segments.length === 0) && (
            <p class="segment-empty">Content not yet available for this siman.</p>
          )}
        </div>

        {simanNum === 100 && (
          <TeachingVideo
            title="The King and His Two Sons"
            hebrewTitle="מלך ושני בנים"
            src="/videos/chayey-moharan-100-king-and-two-sons-english-subtitles.mp4"
            poster="/images/videos/chayey-moharan-100-king-and-two-sons-poster.jpg"
            description="Rabbi Nachman's parable of the wise son whose hidden counsel is the source of the king's treasures, presented in Hebrew with burned-in English subtitles."
            citation="The Life of Our Leader Rabbi Nachman, New Stories §100 (חיי מוהר״ן, סיפורים חדשים, ק׳)"
            sourceName="רבי נחמן מברסלב"
            sourceHandle="@rabbi_nachman30"
            sourceUrl="https://www.instagram.com/reel/DYMt1d9NM7v/?igsh=NG84ZWxuYnpyMGE0"
          />
        )}

        {simanNum === 198 && (
          <TeachingVideo
            title="The Robber and the Robbed Man"
            hebrewTitle="הגזלן והנגזל"
            src="/videos/chayey-moharan-198-robber-and-robbed-man-english-subtitles.mp4"
            poster="/images/videos/chayey-moharan-198-robber-and-robbed-man-poster.jpg"
            description="Rabbi Nachman's parable of the robbed man who waits until the robber has exhausted his gunpowder, then overpowers him. Direct Hebrew excerpt with burned-in English subtitles."
            citation="The Life of Our Leader Rabbi Nachman §198 (חיי מוהר״ן קצ״ח)"
            sourceName="רבי נחמן מברסלב"
            sourceHandle="@rabbi_nachman30"
            sourceUrl="https://www.instagram.com/reel/DXaLAiPjYMh/?igsh=MWNpZmc0NXFwYnJpYg=="
          />
        )}

        {simanNum === 260 && (
          <TeachingVideo
            title="Hungarian Wine"
            hebrewTitle="יין הונגרי"
            src="/videos/chayey-moharan-260-hungarian-wine-english-subtitles.mp4"
            poster="/images/videos/chayey-moharan-260-hungarian-wine-poster.jpg"
            description="Rabbi Nachman's parable of those who have tasted the true fine wine and therefore cannot be deceived by an imitation, presented as a direct Hebrew reading with burned-in English subtitles."
            citation="The Life of Our Leader Rabbi Nachman §260 (חיי מוהר״ן ר״ס)"
            sourceName="רבי נחמן מברסלב"
            sourceHandle="@rabbi_nachman30"
            sourceUrl="https://www.instagram.com/reel/DX65IxcMZ0i/?igsh=czhicnZ5bXNyMWd1"
          />
        )}

        {simanNum === 447 && (
          <TeachingVideo
            title="The Great Wealthy Man"
            hebrewTitle="הגביר הגדול"
            src="/videos/chayey-moharan-447-great-wealthy-man-english-subtitles.mp4"
            poster="/images/videos/chayey-moharan-447-great-wealthy-man-poster.jpg"
            description="Rabbi Nachman's parable about speaking with others concerning fear of Heaven, presented in Hebrew with burned-in English subtitles."
            citation="The Life of Our Leader Rabbi Nachman §447 (Chayey Moharan; חיי מוהר״ן תמ״ז)"
            sourceName="רבי נחמן מברסלב"
            sourceHandle="@rabbi_nachman30"
            sourceUrl="https://www.instagram.com/reel/DbByx3ItxlJ/?igsh=ZXBwbjU4dm8zdnk4"
          />
        )}

        {simanNum === 603 && (
          <TeachingVideo
            title="The Bird"
            hebrewTitle="הציפור"
            src="/videos/chayey-moharan-603-the-bird-english-subtitles.mp4"
            poster="/images/videos/chayey-moharan-603-the-bird-poster.jpg"
            description="Rabbi Nachman's parable of the bird whose young recognize its call and return to their true source, illustrating his work of gathering and leading souls in the world. Direct Hebrew reading with burned-in English subtitles."
            citation="The Life of Our Leader Rabbi Nachman §603 (חיי מוהר״ן תר״ג)"
            sourceName="רבי נחמן מברסלב"
            sourceHandle="@rabbi_nachman30"
            sourceUrl="https://www.instagram.com/reel/DXxBwHCt8M6/?igsh=Z2cxbWtqMXFvMjN2"
          />
        )}

        <!-- Bottom nav -->
        <nav class="siman-nav bottom">
          <a href="/reader/chayey-moharan" class="nav-back">← Directory</a>
          <div class="nav-arrows">
            {simanNum > 60 && (
              <a href={`/reader/chayey-moharan/siman/${simanNum - 1}`} class="nav-arrow">◂ Previous</a>
            )}
            {simanNum < 615 && (
              <a href={`/reader/chayey-moharan/siman/${simanNum + 1}`} class="nav-arrow">Next ▸</a>
            )}
          </div>
        </nav>
      </>
    )}
  </div>
</Layout>

<style>
  .siman-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 20px 80px;
  }

  .siman-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #f8f5f0;
    border-radius: 8px;
    margin-bottom: 20px;
    border: 1px solid #e0d5b8;
    flex-wrap: wrap;
    gap: 8px;
  }

  .siman-nav.bottom {
    margin-top: 32px;
  }

  .nav-back {
    color: #1e3a5f;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95em;
  }

  .nav-back:hover {
    color: #8B6914;
  }

  .nav-siman {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nav-label {
    font-size: 0.7em;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .nav-number {
    font-size: 1.4em;
    font-weight: bold;
    color: #8B6914;
  }

  .nav-arrows {
    display: flex;
    gap: 12px;
  }

  .nav-arrow {
    color: #5a3e00;
    text-decoration: none;
    font-size: 0.9em;
    padding: 4px 12px;
    background: #f0ead6;
    border-radius: 4px;
    transition: all 0.15s;
  }

  .nav-arrow:hover {
    background: #c8a84b;
    color: #fff;
  }

  .section-context {
    text-align: right;
    padding: 10px 16px;
    margin-bottom: 20px;
    background: #fafaf0;
    border-right: 4px solid #c8a84b;
    border-radius: 4px;
  }

  .section-he {
    display: block;
    font-size: 1.1em;
    color: #333;
    font-family: 'Frank Ruhl Libre', serif;
    direction: rtl;
  }

  .section-en {
    display: block;
    font-size: 0.85em;
    color: #777;
    font-style: italic;
    direction: ltr;
    text-align: left;
  }

  .siman-content {
    background: #fff;
    border-radius: 8px;
    padding: 24px;
    border: 1px solid #e0d5b8;
  }

  .siman-segment {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px dashed #e0d5b8;
  }

  .siman-segment:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .segment-he {
    direction: rtl;
    text-align: right;
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.1em;
    line-height: 1.9;
    color: #222;
    margin-bottom: 12px;
  }

  .segment-he p {
    margin: 0 0 12px;
  }

  .segment-en {
    direction: ltr;
    text-align: left;
    font-family: Georgia, serif;
    font-size: 1.05em;
    line-height: 1.8;
    color: #333;
    padding: 12px 16px;
    background: #fafaf7;
    border-left: 3px solid #c8a84b;
    border-radius: 4px;
  }

  .segment-en p {
    margin: 0 0 10px;
  }

  .segment-empty {
    color: #999;
    font-style: italic;
    text-align: center;
    padding: 40px 20px;
  }

  .siman-error {
    text-align: center;
    padding: 60px 20px;
  }

  .siman-error h1 {
    color: #8B6914;
    font-size: 1.5em;
  }

  .back-link {
    display: inline-block;
    margin-top: 16px;
    color: #1e3a5f;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .siman-container { padding: 12px 10px 60px; }
    .siman-nav { flex-direction: column; align-items: flex-start; }
    .segment-he { font-size: 1em; }
    .segment-en { font-size: 0.95em; }
  }
</style>
