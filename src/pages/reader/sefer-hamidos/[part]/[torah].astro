---
import Layout from '../../../../layouts/Layout.astro';
import Comments from '../../../../components/Comments.astro';
import CommentarySidebar from '../../../../components/CommentarySidebar.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const paths = [];
  const indexPath = path.join(process.cwd(), 'public/reader/sefer-hamidos/index.json');
  const indexData = JSON.parse(fs.readFileSync(indexPath, 'utf8'));
  const total = indexData.totalTorahs || indexData.torahs?.length || 0;
  for (let torah = 1; torah <= total; torah++) {
    paths.push({ params: { part: '1', torah: String(torah) } });
  }
  return paths;
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahNum = parseInt(torah);

let torahData = null;
let error = null;

try {
  const filePath = path.join(process.cwd(), `public/reader/sefer-hamidos/topic-${torahNum}.json`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = `Topic ${torahNum} not found`;
}

if (!torahData && !error) error = 'Content not available';

const pageTitle = torahData
  ? `${torahData.hebrewTitle || torahData.title} - Sefer Hamidos`
  : 'Topic Not Found';
const topicTotal = torahData?.segments?.length || 0;

const pageDesc = torahData
  ? (() => {
    const snippet = (torahData.segments?.find(s => s.en)?.en || '').replace(/<[^>]+>/g, '').slice(0, 120);
    return `Read ${torahData.title} from Sefer Hamidos online free. ${snippet ? snippet + '...' : 'Hebrew text with English translation on ajew.org.'}`;
  })()
  : '';

const structuredData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${torahData.title} - Sefer Hamidos`,
  "alternativeHeadline": torahData.hebrewTitle || '',
  "author": { "@type": "Person", "name": "Rabbi Nachman of Breslov" },
  "publisher": { "@type": "Organization", "name": "ajew.org" },
  "inLanguage": ["he", "en"],
  "isPartOf": { "@type": "Book", "name": "Sefer Hamidos" },
  "url": `https://ajew.org/reader/sefer-hamidos/${partNum}/${torahNum}`
}) : '';

// LN commentary entry — focused per-topic excerpt from Likutay Nanach when available.
const lnSection = torahNum === 1 ? 'volume-4/sefer-hamidos-truth-focused' : `volume-4/chapter-251-topic-${torahNum}`;
const lnUrl = `/reader/likutay-nanach/${lnSection}.json`;
const commentaryEntry = torahData ? {
  related_commentaries: [
    {
      book: "likutay-nanach",
      section: lnSection,
      label: "Likutay Nanach",
      sectionTitle: torahNum === 1 ? "ספר המדות — אמת" : "ספר המדות",
      url: lnUrl,
      readerUrl: torahNum === 1 ? '/reader/likutay-nanach/volume-4/33#seg-475' : lnUrl
    }
  ]
} : null;
const breadcrumbData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Library", "item": "https://ajew.org/reader" },
    { "@type": "ListItem", "position": 2, "name": "Sefer Hamidos", "item": `https://ajew.org/reader/sefer-hamidos/1/` },
    { "@type": "ListItem", "position": 3, "name": torahData.hebrewTitle || torahData.title }
  ]
}) : '';

function shSlugTitle(title = '') {
  return String(title).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
const mediaCollectionOverrides = {
  18: 'sefer-hamidos-theft',
  20: 'sefer-hamidos-travel',
};
const mediaCollection = torahNum === 1
  ? 'sefer-hamidos-truth'
  : mediaCollectionOverrides[torahNum] || `sefer-hamidos-${shSlugTitle(torahData?.title || '')}`;
let mediaBySegment = new Map();
try {
  const mediaPath = path.join(process.cwd(), `public/images/${mediaCollection}/manifest.json`);
  const mediaManifest = JSON.parse(fs.readFileSync(mediaPath, 'utf8'));
  mediaBySegment = new Map((mediaManifest.entries || []).map((entry) => [Number(entry.segment), entry]));
} catch (_e) {
  mediaBySegment = new Map();
}
const segmentByIndex = new Map((torahData?.segments || []).map((segment) => [Number(segment.index), segment]));
const mediaOverviewItems = Array.from(mediaBySegment.entries()).flatMap(([segmentIndex, entry]) =>
  (entry.images || []).map((img) => ({ segmentIndex, segment: segmentByIndex.get(segmentIndex), img }))
);
function mediaSlug(img) {
  return path.basename(img.path || img.archive_filename || '').replace(/\.[^.]+$/, '');
}
function mediaShareUrl(img) {
  const slug = mediaSlug(img);
  const base = Astro.site || 'https://ajew.org';
  return new URL(`/share/${mediaCollection}/${slug}/?v=${slug}`, base).toString();
}
function mediaDirectUrl(img) {
  const base = Astro.site || 'https://ajew.org';
  return new URL(img.path, base).toString();
}
function mediaShareTitle(seg, img) {
  return `Sefer Hamidos ${torahData?.title || 'Media'} ${seg.index} ${img.language} image ${img.variant}`;
}
---

<Layout title={pageTitle} description={pageDesc}>
  {torahData && structuredData && (
    <script type="application/ld+json" set:html={structuredData} slot="head" />
  )}
  {torahData && breadcrumbData && (
    <script type="application/ld+json" set:html={breadcrumbData} slot="head" />
  )}
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div
      class="reader-container"
      data-torah-id={torahData.id}
      data-torah-title={`${torahData.title} - Sefer Hamidos`}
    >
      <div class="reader-progress"></div>

      <div class="reader-breadcrumb">
        <a href="/reader">Reader</a>
        <span>&rsaquo;</span>
        <a href="/reader/sefer-hamidos/1/">Sefer Hamidos</a>
        <span>&rsaquo;</span>
        {torahData.hebrewTitle || torahData.title}
      </div>

      


      

<!-- Unified Audio Player -->
<div id="audio-controls" style="margin:0 auto 12px auto; max-width:700px; font-family:'Open Sans',sans-serif;">
  <div style="display:flex; gap:0; border-radius:8px; overflow:hidden; border:1px solid var(--reader-border,#ddd);">
    <button id="audio-btn-he" onclick="toggleAudio('he')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333);">
      🎧 Hebrew
    </button>
    <button id="audio-btn-en" onclick="toggleAudio('en')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333); border-left:1px solid var(--reader-border,#ddd);">
      🔊 English
    </button>
  </div>
  
  <!-- Hidden data element for book/part/torah -->
  <div id="en-tts-player" data-book="sefer-hamidos" data-part={partNum} data-torah={torahNum} style="display:none;"></div>
  
  <div id="audio-panel-he" style="display:none; background:var(--reader-bg-secondary,#f8f5f0); 
    border:1px solid var(--reader-border,#ddd); border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <audio id="kol-hatzadik-audio" controls preload="none" style="width:100%; border-radius:4px;"></audio>
    <div id="kol-hatzadik-note" style="font-size:0.8em; color:var(--reader-text-secondary,#888); margin-top:4px;"></div>
  </div>
  
  <div id="audio-panel-en" style="display:none; background:#1a3a1a; 
    border:1px solid #2d5a2d; border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
      <span style="font-size:1em;">🔊</span>
      <strong style="color:#7fff7f; font-size:0.85em;">English Audio</strong>
      <div style="margin-left:auto; display:flex; gap:4px;">
        <button id="en-btn-ryan" onclick="enSetVoice('ryan')" 
          style="background:#7fff7f20; border:2px solid #7fff7f; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇬🇧</button>
        <button id="en-btn-guy" onclick="enSetVoice('guy')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇺🇸</button>
        <button id="en-btn-connor" onclick="enSetVoice('connor')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇮🇪</button>
      </div>
    </div>
    <button id="en-btn-play" onclick="enTogglePlay()" 
      style="background:#2d8a2d; color:#fff; border:none; border-radius:4px; padding:6px 16px; 
      cursor:pointer; font-size:0.9em; font-weight:bold; width:100%;">▶ Play English</button>
    <div id="en-progress" style="margin-top:4px; height:3px; background:#2d5a2d; border-radius:2px; 
      overflow:hidden; display:none;">
      <div id="en-progress-bar" style="height:100%; width:0%; background:#7fff7f;"></div>
    </div>
  </div>
</div>
<script src="/unified-audio.js" defer></script>

      <div class="reader-toolbar">
        <div class="reader-toolbar-group">
          <button class="reader-btn" data-mode="hebrew">Hebrew</button>
          <button class="reader-btn" data-mode="english">English</button>
          <button class="reader-btn" data-mode="both">Both</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn" id="btn-nikud">Nikud</button>
        </div>
        <div class="reader-toolbar-group">
          <span style="font-size:0.7em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
          <input type="range" id="font-size-slider" class="font-size-slider" min="12" max="32" value="18" />
          <span style="font-size:0.9em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" data-theme-btn="day">Day</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="sepia">Sepia</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="night">Night</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" id="btn-align" title="Sentence-by-sentence aligned view">Align</button>
          <button class="reader-btn reader-btn-icon" id="btn-listen">Listen</button>
          <button class="reader-btn reader-btn-icon" id="btn-search">Search</button>
          <button class="reader-btn reader-btn-icon" id="btn-bookmark">Bookmark</button>
          <button class="reader-btn reader-btn-icon" id="btn-notes">Notes</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen">Fullscreen</button>
          <button class="reader-btn reader-btn-icon" id="btn-immse" title="Hide controls for distraction-free study" onclick="event.preventDefault();event.stopImmediatePropagation();document.body.classList.toggle('reader-immersive');document.querySelector('.reader-container')?.classList.toggle('immerse-mode',document.body.classList.contains('reader-immersive'));this.textContent=document.body.classList.contains('reader-immersive')?'Show controls':'Focus';this.classList.toggle('active',document.body.classList.contains('reader-immersive'))">Focus</button>
          <button class="reader-btn reader-btn-icon" id="btn-hide-media" title="Hide pictures, songs, videos, and media controls">Hide media</button>
          <button class="reader-btn reader-btn-icon" id="btn-media-gallery" title="Browse every picture for this topic in one gallery">All pictures</button>
          <button class="reader-btn reader-btn-icon" id="btn-teachings-only" title="Show only the teachings, without reader additions" onclick="event.preventDefault();event.stopImmediatePropagation();var only=!document.body.classList.contains('reader-teachings-only');document.body.classList.toggle('reader-teachings-only',only);document.querySelector('.reader-container')?.classList.toggle('immerse-mode',only);this.textContent=only?'Full reader':'Teachings only';this.classList.toggle('active',only);">Teachings only</button>
        </div>
      </div>
      <button class="reader-focus-exit" type="button" id="reader-focus-exit" title="Show reader controls again" onclick="event.preventDefault();event.stopImmediatePropagation();document.body.classList.remove('reader-immersive');document.querySelector('.reader-container')?.classList.remove('immerse-mode');var b=document.getElementById('btn-immse');if(b){b.textContent='Focus';b.classList.remove('active');}document.body.classList.remove('reader-teachings-only');var tb=document.getElementById('btn-teachings-only');if(tb){tb.textContent='Teachings only';tb.classList.remove('active');}">Show controls</button>

      <div class="reader-search-bar">
        <input type="text" placeholder="Search in this topic..." dir="auto" />
        <span class="search-info"></span>
        <button class="reader-btn search-close">Close</button>
      </div>

      <button class="reader-toc-toggle" title="Table of Contents">&#9776;</button>
      <div class="reader-toc">
        <button class="reader-toc-close">&times;</button>
        <h3>Teachings</h3>
        <ul class="reader-toc-list">
          {torahData.segments.map((seg, i) => (
            <li><a href={`#seg-${seg.index}`} data-index={String(seg.index)}>Teaching {seg.displayLabel || seg.sourceNumber || seg.index}</a></li>
          ))}
        </ul>
      </div>

      <div class="reader-header">
        {torahData.hebrewTitle && <div class="hebrew-title">{torahData.hebrewTitle}</div>}
        <h1>{torahData.title}</h1>
        <p style="color: var(--reader-text-secondary); font-size: 0.9em; font-family: 'Open Sans', sans-serif;">
          Sefer Hamidos - The Book of Traits · {topicTotal} individual teachings
        </p>
        {mediaBySegment.size > 0 && (
          <div class="reader-media-note sh-picture-browse-prompt">
            <button type="button" class="sh-browse-all-media">📷 Browse all {mediaOverviewItems.length} pictures</button>
            <span>See the complete visual collection together, or open pictures teaching by teaching below.</span>
          </div>
        )}
      </div>

      {mediaOverviewItems.length > 0 && (
        <section id="sh-all-pictures-overview" class="sh-all-pictures-overview" hidden aria-labelledby="sh-all-pictures-title">
          <div class="sh-overview-heading">
            <div>
              <p class="sh-overview-kicker">Sefer HaMidos · {torahData.title}</p>
              <h2 id="sh-all-pictures-title">All pictures</h2>
              <p>{mediaOverviewItems.length} pictures from {mediaBySegment.size} teachings. Select any picture to view, share, or download it.</p>
            </div>
            <button type="button" class="sh-overview-close">Close</button>
          </div>
          <div class="sh-overview-filters" aria-label="Filter pictures by language">
            <button type="button" class="active" data-gallery-language="all">All</button>
            <button type="button" data-gallery-language="english">English</button>
            <button type="button" data-gallery-language="hebrew">Hebrew</button>
          </div>
          <div class="sh-overview-grid">
            {mediaOverviewItems.map(({ segmentIndex, segment, img }) => (
              <article class="sh-overview-card" data-gallery-card-language={img.language || ''}>
                <button type="button" class="sh-overview-open" data-media-src={mediaDirectUrl(img)} aria-label={`Open teaching ${segmentIndex} ${img.language} picture`}>
                  <img src={img.path} alt={`Sefer Hamidos ${torahData.title} teaching ${segmentIndex} ${img.language} picture`} loading="lazy" />
                </button>
                <div class="sh-overview-card-meta">
                  <a href={`#seg-${segmentIndex}`}>Teaching {segment?.displayLabel || segment?.sourceNumber || segmentIndex}</a>
                  <span>{img.language} · {img.variant}</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous Topic</a>
        ) : <span class="disabled">&larr; Previous Topic</span>}
        <a href="/reader/sefer-hamidos/1/">Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next Topic &rarr;</a>
        ) : <span class="disabled">Next Topic &rarr;</span>}
      </div>

      <div class="reader-content mode-hebrew">
        <div class="reader-content-original">
{torahData.segments.map((seg) => (
          <div class="reader-segment-pair" id={`seg-${seg.index}`} data-share-id={seg.id || ''}>
            <div class="reader-segment segment-he" data-index={String(seg.index)}>
              <span class="segment-number">{seg.displayLabel || seg.sourceNumber || seg.index}</span>
              <p data-nikud={seg.he_nikud || seg.he}>{seg.he}</p>
            </div>
            <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
              <span class="segment-number">{seg.displayLabel || seg.sourceNumber || seg.index}</span>
              <p>{seg.en || 'Translation not yet available'}</p>
            </div>
            {mediaBySegment.has(Number(seg.index)) && (
              <details class="reader-media-dropdown sefer-hamidos-media" data-segment={String(seg.index)}>
                <summary>📷 Pictures / videos for this teaching</summary>
                <div class="sh-media-body">
                  <div class="sh-media-strip" aria-label={`Scrollable Sefer Hamidos Truth teaching ${seg.index} pictures`}>
                    {mediaBySegment.get(Number(seg.index)).images.map((img) => (
                      <figure id={`media-${mediaSlug(img)}`} class={`sh-media-card sh-media-lang-${img.language === 'hebrew' ? 'he' : 'en'}`} data-media-url={mediaDirectUrl(img)} data-share-url={mediaShareUrl(img)} data-share-text={img.language === 'hebrew' ? (seg.he_nikud || seg.he || '') : (seg.en || seg.he || '')}>
                        <a href={img.path} target="_blank" rel="noopener">
                          <img src={img.path} alt={`Sefer Hamidos Truth ${seg.index} ${img.language} image ${img.variant}`} loading="lazy" />
                        </a>
                        <figcaption>
                          <span>{img.language} · {img.variant}</span>
                          <div class="sh-media-share-row">
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-title={mediaShareTitle(seg, img)} data-share-url={mediaShareUrl(img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>Share picture</button>
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-app="X" title="Copy the picture and open X; paste it with Ctrl+V" data-share-title={mediaShareTitle(seg, img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>X</button>
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-app="Telegram" title="Copy the picture and open Telegram; paste it with Ctrl+V" data-share-title={mediaShareTitle(seg, img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>Telegram</button>
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-app="WhatsApp" title="Copy the picture and open WhatsApp; paste it with Ctrl+V" data-share-title={mediaShareTitle(seg, img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>WhatsApp</button>
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-app="Facebook" title="Copy the picture and open Facebook; paste it with Ctrl+V" data-share-title={mediaShareTitle(seg, img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>Facebook</button>
                            <button type="button" class="sh-media-share sh-media-share-file" data-share-app="Instagram" title="Copy the picture and open Instagram; upload or paste it there" data-share-title={mediaShareTitle(seg, img)} data-media-url={mediaDirectUrl(img)} data-teaching={img.language === 'hebrew' ? seg.he : seg.en}>Instagram</button>
                            <button type="button" class="sh-media-share sh-media-copy-image" data-media-url={mediaDirectUrl(img)}>Copy image</button>
                            <a class="sh-media-share" href={img.path} download>Download</a>
                          </div>
                        </figcaption>
                        {img.video_path && (
                          <div class="sh-media-video-row">
                            <video data-video-src={img.video_path} controls preload="none" playsinline title={`Sefer Hamidos Truth ${seg.index} ${img.language} animation`}></video>
                            <button type="button" class="sh-media-load-video" data-video-src={img.video_path}>Load video</button>
                            <a class="sh-media-video" href={img.video_path} target="_blank" rel="noopener">Open video</a>
                          </div>
                        )}
                      </figure>
                    ))}
                  </div>
                  <div class="sh-media-actions">
                    <button type="button" class="sh-media-share sh-browse-all-media">Browse all pictures</button>
                  </div>
                </div>
              </details>
            )}
          </div>
        ))}
        </div>
        {torahData.aligned_segments && (
          <div class="reader-content-aligned" style="display:none;">
            {torahData.aligned_segments.map((seg) => (
              <div class={`reader-segment-pair ${seg.type === 'note' ? 'segment-note' : ''}`} id={`aligned-${seg.index}`}>
                <div class="reader-segment segment-he" data-index={String(seg.index)}>
                  <span class="segment-number">{seg.displayLabel || seg.sourceNumber || seg.index}</span>
                  <p>{seg.he || '\u00A0'}</p>
                </div>
                <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
                  <span class="segment-number">{seg.displayLabel || seg.sourceNumber || seg.index}</span>
                  <p>{seg.en || '\u00A0'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous Topic</a>
        ) : <span class="disabled">&larr; Previous Topic</span>}
        <a href="/reader/sefer-hamidos/1/">Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next Topic &rarr;</a>
        ) : <span class="disabled">Next Topic &rarr;</span>}
      </div>

      <div class="reader-shortcuts-overlay">
        <div class="reader-shortcuts-panel">
          <h2>Keyboard Shortcuts</h2>
          <div class="shortcut-row"><span>Hebrew mode</span><span class="shortcut-key">H</span></div>
          <div class="shortcut-row"><span>English mode</span><span class="shortcut-key">E</span></div>
          <div class="shortcut-row"><span>Both columns</span><span class="shortcut-key">B</span></div>
          <div class="shortcut-row"><span>Toggle nikud</span><span class="shortcut-key">N</span></div>
          <div class="shortcut-row"><span>Fullscreen</span><span class="shortcut-key">F</span></div>
          <div class="shortcut-row"><span>Search in text</span><span class="shortcut-key">Ctrl+F</span></div>
          <div class="shortcut-row"><span>Save bookmark</span><span class="shortcut-key">S</span></div>
          <div class="shortcut-row"><span>Listen / Pause</span><span class="shortcut-key">L</span></div>
          <div class="shortcut-row"><span>Print</span><span class="shortcut-key">P</span></div>
