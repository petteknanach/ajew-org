</div><!-- /ts-grid -->

<!-- ---- Central Insight ---- -->
<div class="ts-insight">
  <div class="ts-insight-label">Central Principle of This Halachah</div>
  <div class="ts-insight-text">
    The <em>distancing</em> is the ultimate <em>closeness</em>.<br>
    Every crookedness of heart, every dispute that troubles you,<br>
    is itself the <em>rebuke of life</em> — your doorway back to Hashem.
  </div>
</div>

