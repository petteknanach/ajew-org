  <script is:inline>
  // Library filter - search/filter books by name
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('libraryFilter');
    if (!input) return;

    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      if (!q) {
        // Show all
        document.querySelectorAll('.category-section, .volume-section, #likutay-moharan').forEach(el => {
          el.style.display = '';
        });
        return;
      }

      const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0591-\u05C7\u0300-\u036f]/g, '');
      const nq = norm(q);

      // Filter volume sections by book title, Hebrew title, description, and visible section names.
      document.querySelectorAll('.volume-section').forEach(section => {
        const haystack = norm(section.textContent || '');
        const match = haystack.includes(nq);
        section.style.display = match ? '' : 'none';
        const dropdown = section.querySelector('.book-dropdown');
        if (match && dropdown) dropdown.open = true;
      });

      // Show/hide categories based on whether they have visible books
      document.querySelectorAll('.category-section').forEach(cat => {
        const visibleBooks = cat.querySelectorAll('.volume-section:not([style*="display: none"])');
        if (visibleBooks.length > 0) {
          cat.style.display = '';
          cat.open = true; // Expand matching categories
        } else {
          cat.style.display = 'none';
        }
      });

      // Also check LM section and its section labels
      const lmSection = document.getElementById('likutay-moharan');
      if (lmSection) {
        const lmMatch = norm(lmSection.textContent || '').includes(nq) || 'lm'.includes(nq);
        lmSection.style.display = lmMatch ? '' : 'none';
        if (lmMatch) lmSection.open = true;
      }

      const url = new URL(window.location.href);
      url.searchParams.set('filter', q);
      window.history.replaceState({}, '', url);
    });

    // Restore view preference and URL filter
    const savedView = localStorage.getItem('ajew-library-view');
    if (savedView === 'compact') setView('compact');
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter');
    if (filter) { input.value = filter; input.dispatchEvent(new Event('input')); }
    if (window.location.hash) {
      const hashId = decodeURIComponent(window.location.hash.slice(1));
      const target = hashId ? document.getElementById(hashId) : null;
      if (target) { target.closest('.category-section')?.setAttribute('open', ''); target.closest('.book-dropdown')?.setAttribute('open', ''); }
    }
  });

  function setView(mode) {
    const container = document.querySelector('.lm-index');
    const fullBtn = document.getElementById('viewFull');
    const compactBtn = document.getElementById('viewCompact');
    if (mode === 'compact') {
      container.classList.add('compact-mode');
      fullBtn.classList.remove('active');
      compactBtn.classList.add('active');
    } else {
      container.classList.remove('compact-mode');
      fullBtn.classList.add('active');
      compactBtn.classList.remove('active');
    }
    localStorage.setItem('ajew-library-view', mode);
  }

  function expandAllCategories() {
    document.querySelectorAll('.category-section').forEach(cat => { cat.open = true; });
    document.querySelectorAll('.book-dropdown').forEach(book => { book.open = true; });
  }

  function copyLibraryLink() {
    const input = document.getElementById('libraryFilter');
    const url = new URL(window.location.href);
    const q = input?.value?.trim();
    if (q) url.searchParams.set('filter', q); else url.searchParams.delete('filter');
    navigator.clipboard.writeText(url.toString()).then(() => {
      const btn = document.getElementById('copyLibraryLink');
      if (!btn) return;
      const old = btn.textContent;
      btn.textContent = '✓ Copied';
      setTimeout(() => btn.textContent = old, 1800);
    });
  }
  </script>

