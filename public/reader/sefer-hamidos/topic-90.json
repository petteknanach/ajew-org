{
  "id": "sh-90",
  "title": "קנאה",
  "hebrewTitle": "קִנְאָה",
  "part": 1,
  "segments": [
    {
      "index": 1,
      "he": "א.\n\nכְּשֶׁיִּתְבַּטֵּל הַקִּנְאָה, אֲזַי יִהְיֶה קִבּוּץ גָּלֻיּוֹת.",
      "en": "",
      "id": "sh-קנאה-א"
    },
    {
      "index": 2,
      "he": "ב.\n\nעַל־יְדֵי קִנְאָה בָּא שְׂרֵפָה.",
      "en": "",
      "id": "sh-קנאה-ב"
    },
    {
      "index": 3,
      "he": "ג.\n\nעַל־יְדֵי קִנְאָה בָּא שְׁפִיכוּת־דָּמִים.",
      "en": "",
      "id": "sh-קנאה-ג"
    },
    {
      "index": 4,
      "he": "ד.\n\nעַל־יְדֵי קִנְאָה בְּמָמוֹן חֲבֵרוֹ  נַעֲשָׂה  שׁוֹטֶה.",
      "en": "",
      "id": "sh-קנאה-ד"
    },
    {
      "index": 5,
      "he": "ה.\n\nעַל־יְדֵי בִּיאָתְךָ לַצַּדִּיק יִתְבַּטֵּל מִמְּךָ הַקִּנְאָה.",
      "en": "",
      "id": "sh-קנאה-ה"
    },
    {
      "index": 6,
      "he": "ו.\n\nעַל־יְדֵי קִנְאָה עַצְמוֹתָיו מַרְקִיבִין.",
      "en": "",
      "id": "sh-קנאה-ו"
    },
    {
      "index": 7,
      "he": "ז.\n\nהַשּׁוּם מוֹצִיא קִנְאָה.",
      "en": "",
      "id": "sh-קנאה-ז"
    },
    {
      "index": 8,
      "he": "ח.\n\nדְּפָרַע קִנְאָה מַחֲרִיב בֵּיתוֹ.",
      "en": "",
      "id": "sh-קנאה-ח"
    },
    {
      "index": 9,
      "he": "ט.\n\nעַל־יְדֵי קִנְאָה בָּא תְּשִׁישׁוּת כֹּחַ.",
      "en": "",
      "id": "sh-קנאה-ט"
    }
  ],
