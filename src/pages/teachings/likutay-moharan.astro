<script>
// Generate Volume 1 links - exactly matching naanaach blog structure
const vol1Sections = [
  { title: "Introduction", items: [
    { text: "Introduction", url: "/teachings/likutay-moharan-intro" },
    { text: "Rabbi Nachman's Poem", url: "/teachings/likutay-moharan-poem" },
