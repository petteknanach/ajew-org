  .topic-all { background: rgba(212,160,23,0.15); border-color: rgba(212,160,23,0.3); color: var(--gold-light); }

  .continue-section { background: var(--parchment); border-bottom: 1px solid #e0d6c2; padding: 1.5rem; }
