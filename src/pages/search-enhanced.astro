---
import Layout from '../layouts/Layout.astro';
import EnhancedSearch from '../components/EnhancedSearch.astro';
---

<Layout 
  title="Advanced Search | ajew.org" 
  description="Torat Emet-style advanced search with book selection, Hebrew options, proximity search, and maps integration."
>
  <div class="search-page">
    <header class="page-header">
      <h1>חיפוש מתקדם</h1>
      <p class="subtitle">Torat Emet-Style Advanced Search</p>
      <div class="feature-badges">
        <span class="badge">✅ Book Selection</span>
        <span class="badge">✅ Hebrew Options</span>
        <span class="badge">✅ Proximity Search</span>
        <span class="badge">✅ Boolean Operators</span>
        <span class="badge">✅ Maps Integration</span>
      </div>
    </header>

    <div class="container">
      <!-- Main Enhanced Search Component -->
      <div class="search-section">
        <h2>📚 Search All Breslov Texts</h2>
        <EnhancedSearch 
          compact={false}
          showFilters={true}
          autoFocus={true}
          showAdvancedOptions={true}
        />
      </div>

      <!-- Maps Search Section -->
      <div class="maps-section">
        <h2>🗺️ Maps Search (Torat Emet)</h2>
        <p class="section-description">Use the powerful Torat Emet search engine for advanced text analysis and mapping:</p>
        
        <div class="maps-container">
          <div class="maps-frame">
            <iframe 
              src="https://www.toratemetfreeware.com/online/find.php" 
              width="100%" 
              height="700" 
              frameborder="0"
              title="Torat Emet Advanced Search"
              loading="lazy"
              sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox"
            ></iframe>
          </div>
          
          <div class="maps-info">
            <h3>Torat Emet Features:</h3>
            <ul>
              <li>✅ Advanced text search with wildcards</li>
              <li>✅ Boolean operators (AND, OR, NOT)</li>
              <li>✅ Proximity search (words within distance)</li>
              <li>✅ Hebrew vowel pattern matching</li>
              <li>✅ Root word searching</li>
              <li>✅ Multiple text collections</li>
              <li>✅ Context display with highlighting</li>
            </ul>
            <p><strong>Tip:</strong> Use both search systems for comprehensive research.</p>
          </div>
        </div>
      </div>

      <!-- Search Features Comparison -->
      <div class="features-section">
        <h2>⚡ Search Features Comparison</h2>
        <div class="features-grid">
          <div class="feature-card">
            <h3>Internal Search</h3>
            <ul>
              <li>✅ Fast client-side search</li>
              <li>✅ Book selection checklist</li>
              <li>✅ Search type options</li>
              <li>✅ Hebrew missing letters</li>
              <li>✅ Word count minimum</li>
              <li>✅ Basic proximity</li>
              <li>✅ English/Hebrew toggle</li>
            </ul>
          </div>
          
          <div class="feature-card">
            <h3>Torat Emet (Maps)</h3>
            <ul>
              <li>✅ Advanced wildcard search</li>
              <li>✅ Full boolean operators</li>
              <li>✅ Exact proximity control</li>
              <li>✅ Root word analysis</li>
              <li>✅ Vowel pattern matching</li>
              <li>✅ Multiple collections</li>
              <li>✅ Advanced context display</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="quick-links">
        <h2>🔗 Quick Access</h2>
        <div class="links-grid">
          <a href="/books/likutay-nanach" class="link-card">
            <span class="link-icon">🌟</span>
            <span class="link-text">Likutay Nanach</span>
          </a>
          <a href="/books" class="link-card">
            <span class="link-icon">📚</span>
            <span class="link-text">All Books</span>
          </a>
          <a href="/teachings" class="link-card">
            <span class="link-icon">📖</span>
            <span class="link-text">Teachings</span>
          </a>
          <a href="https://www.toratemetfreeware.com/online/find.php" class="link-card" target="_blank">
            <span class="link-icon">🗺️</span>
            <span class="link-text">Torat Emet Direct</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .search-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2rem 1rem;
  }

  .page-header {
    text-align: center;
    color: white;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-hebrew);
  }

  .subtitle {
    font-size: 1.5rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .feature-badges {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .badge {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .search-section, .maps-section, .features-section, .quick-links {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  h2 {
    color: #2c3e50;
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  h3 {
    color: #34495e;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .section-description {
    color: #7f8c8d;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .maps-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }

  .maps-frame {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .maps-info {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .maps-info ul {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .maps-info li {
    margin-bottom: 0.5rem;
    color: #495057;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .feature-card {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .feature-card ul {
    padding-left: 1.5rem;
    margin: 0;
  }

  .feature-card li {
    margin-bottom: 0.5rem;
    color: #495057;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #3498db;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    padding: 1.5rem;
    transition: transform 0.3s, background 0.3s;
    text-align: center;
  }

  .link-card:hover {
    transform: translateY(-3px);
    background: #2980b9;
  }

  .link-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .link-text {
    font-size: 1.1rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }
    
    .maps-container {
      grid-template-columns: 1fr;
    }
    
    .features-grid {
      grid-template-columns: 1fr;
    }
    
    .links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>