  <text x="350" y="25" text-anchor="middle" font-size="15" font-weight="bold" fill="#1a3c5e">The Infinite Spiral of Na'aseh v'Nishma (NK 4)</text>

  <!-- The spiral: Na'aseh / Nishma cycle -->
  <!-- Level 1 -->
