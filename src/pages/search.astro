---
import Layout from '../layouts/Layout.astro';

// Meta refresh for redirection
---

<Layout title="Search" description="Search all Breslov books and teachings">
  <div class="redirect-message">
    <h1>Redirecting to Enhanced Search...</h1>
    <p>If you are not redirected automatically, <a id="enhancedSearchLink" href="/search-enhanced/">click here</a>.</p>
  </div>

  <script is:inline>
    // Preserve the visitor's query and any language/filter parameters. Dropping
    // `?q=` here made every old /search/ link silently become an empty search.
    const target = `/search-enhanced/${window.location.search}${window.location.hash}`;
    const fallbackLink = document.getElementById('enhancedSearchLink');
    if (fallbackLink) fallbackLink.setAttribute('href', target);
    window.location.replace(target);
  </script>
</Layout>

<style>
  .redirect-message {
    text-align: center;
    padding: 4rem;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .redirect-message h1 {
    color: #1a365d;
    margin-bottom: 1rem;
  }
  
  .redirect-message a {
    color: #c53030;
    text-decoration: underline;
  }
</style>
