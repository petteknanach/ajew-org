      <h2>Letter 8</h2>
    </header>
    <nav class="chapter-nav">
  <a href="/books/blossoms-of-the-spring/letter07" class="nav-btn prev">← Previous</a>
  <a href="/books/blossoms-of-the-spring" class="nav-btn main">Main</a>
