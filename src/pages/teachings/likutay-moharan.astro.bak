---
const pageTitle = "Likutay Moharan - Complete Index";
const pageDescription = "Likutay Moharan - The complete Torah teachings of Rabbi Nachman of Breslov";
---

<style>
  .page-header {
    background: #1a365d;
    color: white;
    padding: 2rem;
    text-align: center;
  }
  .page-header h1 {
    font-family: var(--font-hebrew);
    font-size: 1.8rem;
    margin: 0;
  }
  .container { max-width: 1000px; margin: 0 auto; padding: 2rem; }
  .section { margin-bottom: 2rem; }
  .section h2 {
    font-family: var(--font-hebrew);
    color: #1a365d;
    font-size: 1.3rem;
    border-bottom: 2px solid #ed8936;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .section h3 {
    color: #744210;
    font-size: 1.1rem;
    margin: 1rem 0 0.5rem;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.5rem;
  }
  .link-grid a {
    display: block;
    padding: 0.5rem;
    background: #f7f5f0;
    color: #1a365d;
    text-decoration: none;
    border-radius: 4px;
    text-align: center;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .link-grid a:hover {
    background: #ed8936;
    color: white;
  }
  .link-grid.wide {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  }
  .nav-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .nav-links a {
    color: #1a365d;
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #f7f5f0;
    border-radius: 4px;
  }
  .nav-links a:hover {
    background: #1a365d;
    color: white;
  }
</style>

<section class="page-header">
  <h1>📖 Likutay Moharan - Complete Index</h1>
</section>

<main class="container">
  <!-- Quick Navigation -->
  <section class="section">
    <h2>Quick Jump</h2>
    <div class="link-grid">
      <a href="#front-matter">Front Matter</a>
      <a href="#vol1-1-48">Vol 1:1-48</a>
      <a href="#vol1-49-286">Vol 1:49-286</a>
      <a href="#vol2">Vol 2:1-125</a>
    </div>
  </section>

  <!-- Front Matter -->
  <section class="section" id="front-matter">
    <h2>Front Matter</h2>
    <h3>Introduction & Poetry</h3>
