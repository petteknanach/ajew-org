---
import Layout from '../../../../layouts/Layout.astro';
import Comments from '../../../../components/Comments.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const paths = [];
  const bookDir = path.join(process.cwd(), 'public/reader/alim-litrufa');
  
  for (let part = 1; part <= 6; part++) {
    const partDir = path.join(bookDir, `part-${part}`);
    if (fs.existsSync(partDir)) {
      const files = fs.readdirSync(partDir).filter(f => f.startsWith('letter-') && f.endsWith('.json'));
      for (const f of files) {
        const num = parseInt(f.replace('letter-', '').replace('.json', ''));
        if (!isNaN(num)) {
          paths.push({ params: { part: String(part), torah: String(num) } });
        }
      }
    }
  }
  
  return paths;
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahNum = parseInt(torah);

let torahData = null;
let error = null;

try {
  const filePath = path.join(process.cwd(), `public/reader/alim-litrufa/part-${partNum}/letter-${torahNum}.json`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = `Section ${torahNum} not found`;
}

if (!torahData && !error) error = 'Content not available';

const bookName = 'Alim LiTrufa';
const bookHebrew = 'עלים לתרופה';

const pageTitle = torahData
  ? `${torahData.hebrewTitle || torahData.title} - Alim LiTrufa`
  : 'Not Found';
const pageDesc = torahData
  ? (() => {
    const snippet = (torahData.segments?.find(s => s.en)?.en || '').replace(/<[^>]+>/g, '').slice(0, 120);
    return `Read ${torahData.title} from Alim LiTrufa online free. ${snippet ? snippet + '...' : 'Hebrew text with English translation on ajew.org.'}`;
  })()
  : '';

const structuredData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${torahData.title} - Alim LiTrufa`,
  "alternativeHeadline": torahData.hebrewTitle || '',
  "author": { "@type": "Person", "name": "Rabbi Nosson of Breslov" },
  "publisher": { "@type": "Organization", "name": "ajew.org" },
  "inLanguage": ["he", "en"],
  "isPartOf": { "@type": "Book", "name": "Alim LiTrufa" },
  "url": `https://ajew.org/reader/alim-litrufa/${partNum}/${torahNum}`
}) : '';
const breadcrumbData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Library", "item": "https://ajew.org/reader" },
    { "@type": "ListItem", "position": 2, "name": "Alim LiTrufa", "item": `https://ajew.org/reader/alim-litrufa/${partNum}/` },
    { "@type": "ListItem", "position": 3, "name": torahData.hebrewTitle || torahData.title }
  ]
}) : '';
---

<Layout title={pageTitle} description={pageDesc}>
  {torahData && structuredData && (
    <script type="application/ld+json" set:html={structuredData} slot="head" />
  )}
  {torahData && breadcrumbData && (
    <script type="application/ld+json" set:html={breadcrumbData} slot="head" />
  )}
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div
      class="reader-container"
      data-torah-id={torahData.id}
      data-torah-title={`${torahData.title} - Alim LiTrufa`}
    >
      <div class="reader-progress"></div>

      <div class="reader-breadcrumb">
        <a href="/reader">Reader</a>
        <span>&rsaquo;</span>
        <a href={`/reader/alim-litrufa/${partNum}/`}>{bookName}</a>
        <span>&rsaquo;</span>
        {torahData.hebrewTitle || torahData.title}
      </div>


      <!-- View in Original Parchment Format -->
      {torahData?.displayNumber && (
        <div style="text-align:center; margin:12px 0 8px;">
          <a href={`/reader/alim-litrufa/html/ullim_letroofah_letter_${String(torahData.displayNumber).padStart(2, '0')}.html`}
             target="_blank" rel="noopener"
             style="display:inline-block; padding:8px 20px; background:#f5efe0; color:#5a3e00; 
                    border:1px solid #c8a84b; border-radius:6px; text-decoration:none; 
                    font-size:0.9em; font-weight:600; transition:all 0.15s;">
            📜 View in Original Parchment Format
          </a>
        </div>
      )}


<!-- Unified Audio Player -->
<div id="audio-controls" style="margin:0 auto 12px auto; max-width:700px; font-family:'Open Sans',sans-serif;">
  <div style="display:flex; gap:0; border-radius:8px; overflow:hidden; border:1px solid var(--reader-border,#ddd);">
    <button id="audio-btn-he" onclick="toggleAudio('he')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333);">
      🎧 Hebrew
    </button>
    <button id="audio-btn-en" onclick="toggleAudio('en')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333); border-left:1px solid var(--reader-border,#ddd);">
      🔊 English
    </button>
  </div>
  
  <!-- Hidden data element for book/part/torah -->
  <div id="en-tts-player" data-book="alim-litrufa" data-part={partNum} data-torah={torahNum} style="display:none;"></div>
  
  <div id="audio-panel-he" style="display:none; background:var(--reader-bg-secondary,#f8f5f0); 
    border:1px solid var(--reader-border,#ddd); border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <audio id="kol-hatzadik-audio" controls preload="none" style="width:100%; border-radius:4px;"></audio>
    <div id="kol-hatzadik-note" style="font-size:0.8em; color:var(--reader-text-secondary,#888); margin-top:4px;"></div>
  </div>
  
  <div id="audio-panel-en" style="display:none; background:#1a3a1a; 
    border:1px solid var(--reader-border,#ddd); border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <audio id="tts-audio" controls preload="none" style="width:100%; border-radius:4px;"></audio>
    <div style="display:flex; gap:12px; margin-top:8px; flex-wrap:wrap;">
      <select id="tts-voice-select" style="padding:4px 8px; border-radius:4px; font-size:0.8em; background:#2a4a2a; color:#ddd; border:1px solid #4a7a4a;">
        <option value="">Loading voices...</option>
      </select>
      <button onclick="toggleTTS()" style="padding:4px 12px; background:#2a6a2a; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:0.8em;">▶ Play</button>
    </div>
  </div>
</div>

      <div class="reader-toolbar">
        <div class="reader-toolbar-left">
          <div class="reader-mode-group">
            <button class="reader-mode-btn active" data-mode="both">Both</button>
            <button class="reader-mode-btn" data-mode="he">עברית</button>
            <button class="reader-mode-btn" data-mode="en">English</button>
          </div>
        </div>
        <div class="reader-toolbar-right">
          <button class="reader-btn reader-btn-icon" id="btn-theme" title="Toggle theme">🌓</button>
          <button class="reader-btn reader-btn-icon" id="btn-font-size" title="Font size">🔤</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen" title="Fullscreen">⛶</button>
        </div>
      </div>

      <div class="reader-content">
        {torahData.segments?.map((seg) => (
          <div class="reader-segment-pair">
            <div class="reader-segment segment-he">
              <p>{seg.he || '\u00A0'}</p>
            </div>
            <div class="reader-segment segment-en">
              <p>{seg.en || (seg.he ? 'Translation not yet available' : '\u00A0')}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="reader-navigation">
        <div class="reader-nav-buttons">
          {torahNum > 1 ? (
            <a href={`/reader/alim-litrufa/${partNum}/${torahNum - 1}`} class="reader-nav-btn">← Previous</a>
          ) : (
            <span class="reader-nav-btn disabled">← Previous</span>
          )}
          <a href={`/reader/alim-litrufa/${partNum}/`} class="reader-nav-btn">Book Index</a>
          <a href={`/reader/alim-litrufa/${partNum}/${torahNum + 1}`} class="reader-nav-btn">Next →</a>
        </div>
      </div>

      <Comments book="alim-litrufa" part={partNum} torah={torahNum} />
    </div>
  )}
</Layout>

<script>
  // Reader toolbar functionality
  document.addEventListener('DOMContentLoaded', () => {
    const modeBtns = document.querySelectorAll('.reader-mode-btn');
    const heSegs = document.querySelectorAll('.segment-he');
    const enSegs = document.querySelectorAll('.segment-en');
    
    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const mode = btn.dataset.mode;
        
        if (mode === 'both') {
          heSegs.forEach(s => s.style.display = '');
          enSegs.forEach(s => s.style.display = '');
        } else if (mode === 'he') {
          heSegs.forEach(s => s.style.display = '');
          enSegs.forEach(s => s.style.display = 'none');
        } else {
          heSegs.forEach(s => s.style.display = 'none');
          enSegs.forEach(s => s.style.display = '');
        }
      });
    });
    
    // Theme toggle
    const themeBtn = document.getElementById('btn-theme');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const themes = ['day', 'sepia', 'night'];
        const current = document.documentElement.getAttribute('data-theme') || 'day';
        const idx = themes.indexOf(current);
        const next = themes[(idx + 1) % 3];
        
        if (next === 'day') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', next);
        }
      });
    }
  });
</script>
