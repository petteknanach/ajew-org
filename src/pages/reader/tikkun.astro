---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Tikun Korim - Tanach with Medooyuk"
  description="Torah scroll study with fixed columns, a separate continuous reading view, nikud and taamim, vowel-only medooyuk markings, and Shnayim Mikra v'Echad Targum."
>
  <link rel="stylesheet" href="/tikkun.css?v=1" />
  <div id="tk-app" class="tk-wrap" data-tk-theme="day" dir="rtl">
    <header class="tk-header">
      <h1>תיקון קורים <span class="tk-sub">Tikun Korim · medooyuk</span></h1>
      <p class="tk-tagline">כתב התורה בטורים קבועים · קריאה בניקוד וטעמים · סימני המדויק על הניקוד בלבד</p>
    </header>
    <div class="tk-controls" dir="ltr">
      <div class="tk-row">
        <label>Book <select id="tk-book"></select></label>
        <label>Parsha <select id="tk-parsha"><option value="">—</option></select></label>
        <label>Chapter <select id="tk-chapter"></select></label>
        <span class="tk-nav">
          <button id="tk-prev" class="tk-btn" title="Previous chapter" aria-label="Previous chapter">◀</button>
          <button id="tk-next" class="tk-btn" title="Next chapter" aria-label="Next chapter">▶</button>
        </span>
      </div>
      <div class="tk-row">
        <label>View
          <select id="tk-view">
            <option value="sefer">Torah scroll — fixed columns</option>
            <option value="study">Continuous study — adaptive</option>
            <option value="verses">Reading — numbered verses</option>
          </select>
        </label>
        <label>Reading marks
          <select id="tk-mode">
            <option value="full">Nikud + taamim</option>
            <option value="nikud">Nikud only</option>
            <option value="taamim">Taamim only</option>
            <option value="letters">Unpointed reading — not scroll</option>
          </select>
        </label>
        <label class="tk-chk"><input type="checkbox" id="tk-medooyuk" checked /> Medooyuk layer</label>
        <label class="tk-chk"><input type="checkbox" id="tk-shnayim" /> Shnayim Mikra v'Echad Targum</label>
        <label>Targum <select id="tk-targum"><option value="">—</option></select></label>
        <label>Layout
          <select id="tk-layout">
            <option value="stacked">Stacked — written above reading</option>
            <option value="side">Side by side — per-verse study</option>
            <option value="tap">Tap 3× per verse</option>
          </select>
        </label>
        <label class="tk-size">Size <input type="range" id="tk-size" min="16" max="44" value="26" /></label>
        <span class="tk-themes">
          <button class="tk-btn tk-theme" data-t="day">Day</button>
          <button class="tk-btn tk-theme" data-t="sepia">Sepia</button>
          <button class="tk-btn tk-theme" data-t="night">Night</button>
        </span>
      </div>
      <div class="tk-legend" id="tk-legend" dir="rtl">
        <span class="m-demo"><span data-tk-demo="na"></span> = שוא נא (נשמע)</span>
        <span class="m-demo"><span data-tk-demo="qk"></span> = קומוץ קטן</span>
        <span class="m-demo"><span data-tk-demo="qb"></span> = קמץ טעון בירור</span>
        <span class="m-demo"><span data-tk-demo="meteg"></span> = מטג (געיה)</span>
        <span class="m-demo-note">הסימון על הניקוד עצמו — האותיות רגילות; שוא נח וקמץ גדול אינם מסומנים</span>
      </div>
    </div>
    <div id="tk-column-controls" class="tk-row" dir="ltr">
      <button id="tk-column-prev" class="tk-btn">Previous column</button>
      <label>Column <select id="tk-column" aria-label="Fixed Torah column"></select></label>
      <button id="tk-column-next" class="tk-btn">Next column</button>
    </div>
    <!-- Not a nested main: Layout's global main sizing applies to the OUTER main. -->
    <div id="tk-content" class="tk-content" dir="rtl" lang="he" role="region" aria-label="Tikun text"></div>
    <footer class="tk-foot" dir="ltr">
      <p>Study views retain the reading edition and its rulings. Fixed columns use a separate written-text layout; spelling and paragraph traditions can differ. This study aid is not a certified scribal master.</p>
    </footer>
  </div>
</Layout>
<script is:inline src="/tikkun-renderer.js?v=1" defer></script>
<script is:inline src="/tikkun.js?v=10" defer></script>
