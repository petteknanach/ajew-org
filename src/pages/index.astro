  <div class="section-inner">
    <div class="app-inner">
      <span class="app-icon">📱</span>
      <div class="app-body">
        <h3>Install the ajew ananach App</h3>
        <p>Offline capable · Bilingual HE/EN · Free forever</p>
      </div>
      <a href="https://github.com/petteknanach/ajew-ananach/releases" target="_blank" rel="noopener" class="app-btn">Install →</a>
