---
import Layout from '../layouts/Layout.astro';
import { amazonBooks, amazonBookUrl, readerBookUrl } from '../lib/amazon-books.mjs';
---
<Layout title="Our Books on Amazon" description="Browse our editions of Breslov books on Amazon, and read the available works online for free.">
  <section class="print-books">
    <h1>Our books on Amazon</h1>
    <p>Browse our editions of these holy books on Amazon. You can also continue reading online for free.</p>
    <ul>
      {amazonBooks.map(book => (
        <li id={book.id}>
          {book.id === 'likutay-halachos-1' && <span id="likutay-halachos"></span>}
          {book.id === 'likutay-nanach-1' && <span id="likutay-nanach"></span>}
          <h2>{book.title}</h2>
          <div class="book-links">
            <a href={amazonBookUrl(book)} target="_blank" rel="noopener noreferrer">{book.edition} on Amazon</a>
            {book.kindleAsin && <a href={`https://www.amazon.com/dp/${book.kindleAsin}`} target="_blank" rel="noopener noreferrer">Kindle on Amazon</a>}
            {readerBookUrl(book) && <a href={readerBookUrl(book)}>Read online</a>}
          </div>
        </li>
      ))}
    </ul>
    <p><a href="/reader/">Back to the free library</a></p>
  </section>
</Layout>
<style>
  .print-books { max-width: 850px; margin: 0 auto; padding: 32px 20px 64px; color: var(--ds-text-primary, #263449); }
  h1 { font-size: 2rem; margin: 0 0 16px; }
  p { line-height: 1.7; }
  ul { list-style: none; padding: 0; margin: 24px 0; }
  li { border-block-start: 1px solid var(--ds-border, #aab4c1); padding: 20px 0; }
  h2 { font-size: 1.125rem; margin: 0 0 8px; line-height: 1.5; }
  .book-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  :global(body.dark-mode) .print-books { color: #d0d0e0; }
</style>
