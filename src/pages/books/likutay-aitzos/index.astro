  .book-nav { display: flex; justify-content: space-between; gap: 1rem; }
  .back-link, .start-reading { padding: 0.75rem 1.5rem; background: #1a365d; color: white; text-decoration: none; border-radius: 8px; font-weight: 500; transition: all 0.2s; }
  .start-reading { background: #059669; }
  .back-link:hover, .start-reading:hover { transform: translateY(-2px); opacity: 0.9; }
  @media (max-width: 640px) { .book-header h1 { font-size: 1.8rem; } .chapter-list li { padding-left: 2rem; } .chapter-list li::before { width: 1.5rem; height: 1.5rem; font-size: 0.75rem; } }
</style>
