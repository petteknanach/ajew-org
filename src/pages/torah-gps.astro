    'sleep': ['sleep', 'insomnia', 'dream', 'dreams', 'night', 'rest', 'tired', 'exhausted', 'nightmares'],
    'eating': ['eating', 'food', 'diet', 'fasting', 'kosher', 'appetite', 'overeating', 'meal', 'hunger'],
    'forgiveness': ['forgiveness', 'forgive', 'forgiving', 'mercy', 'compassion', 'pardon', 'letting go', 'grudge', 'resentment'],
    'eretz_yisrael': ['israel', 'eretz yisrael', 'holy land', 'jerusalem', 'aliyah', 'zion', 'temple'],
    'loneliness': ['lonely', 'loneliness', 'alone', 'isolated', 'friendless', 'abandoned', 'disconnected', 'no friends'],
    'pride': ['pride', 'ego', 'arrogance', 'arrogant', 'haughty', 'conceited', 'vain', 'boasting', 'showing off'],
    'redemption': ['redemption', 'mashiach', 'moshiach', 'messiah', 'geulah', 'salvation', 'exile', 'freedom'],
    'nature': ['nature', 'creation', 'trees', 'garden', 'outdoors', 'animals', 'stars', 'sky', 'beauty'],
    'judgment': ['judgment', 'justice', 'strict', 'decree', 'harsh', 'punishment', 'court', 'din'],
    'simplicity': ['simple', 'simplicity', 'sincere', 'sincerity', 'wholehearted', 'naive', 'innocent', 'unpretentious'],
    'confession': ['confession', 'confess', 'viduy', 'admit', 'acknowledge'],
    'jealousy': ['jealous', 'jealousy', 'envy', 'envious', 'comparing', 'competition', 'resentment', 'grudge'],
    'patience': ['patience', 'patient', 'waiting', 'impatient', 'endurance', 'tolerance', 'slow'],
    'kindness': ['kindness', 'kind', 'chesed', 'compassion', 'caring', 'gentle', 'goodness', 'benevolent', 'empathy'],
    'beginning': ['beginning', 'start', 'starting', 'new', 'fresh start', 'restart', 'first step', 'motivated', 'inspiration', 'getting started'],
    'mind': ['thoughts', 'thinking', 'mind', 'mental', 'confusion', 'confused', 'clarity', 'focus', 'concentration', 'overthinking', 'intrusive thoughts', 'racing thoughts'],
    'world_to_come': ['world to come', 'afterlife', 'heaven', 'eternal', 'olam haba', 'paradise', 'reward', 'punishment'],
    'community': ['community', 'friends', 'friendship', 'together', 'unity', 'connection', 'fellowship', 'belonging', 'companionship'],
    'character': ['character', 'traits', 'middot', 'personality', 'habits', 'self-improvement', 'growth', 'virtue', 'behavior', 'mussar'],
    'doubt': ['doubt', 'doubts', 'confused', 'questioning', 'uncertain', 'skeptical', 'lost', 'heresy', 'questioning faith'],
    'gratitude_to_god': ['closeness to god', 'close to god', 'connection to god', 'spiritual', 'dvekut', 'cleaving', 'divine', 'presence of god', 'feeling god', 'relationship with god'],
    'travel': ['travel', 'uman', 'pilgrimage', 'journey', 'visiting tzaddik', 'rosh hashana uman']
  };

  // ─── Load Data ───
  async function loadData() {
    try {
      const resp = await fetch('/torah-gps-index.json');
      if (!resp.ok) throw new Error('Index not found');
      gpsData = await resp.json();
      renderTopicButtons();
    } catch (e) {
      console.error('Failed to load Torah GPS index:', e);
      topicGrid.innerHTML = '<p style="color:#c00;text-align:center;">Index not yet built. Run: <code>node scripts/build-torah-gps-index.cjs</code></p>';
    }
  }

  // ─── Render Topic Buttons ───
  function renderTopicButtons() {
    if (!gpsData || !gpsData.topicMeta) return;
    // Sort by result count descending, then filter to those with results
    const sorted = [...gpsData.topicMeta]
      .filter(t => t.resultCount > 0)
      .sort((a, b) => b.resultCount - a.resultCount);

    topicGrid.innerHTML = sorted.map(t =>
      `<button class="topic-btn" data-topic="${t.id}" title="${t.resultCount} teachings found">
        ${t.label} <span class="he">${t.hebrewLabel}</span>
      </button>`
    ).join('');

    // Add click handlers
    topicGrid.querySelectorAll('.topic-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const topicId = btn.dataset.topic;
        selectTopic(topicId);
      });
    });
  }

  // ─── Select Topic ───
  function selectTopic(topicId) {
    if (!gpsData) return;
    currentTopic = topicId;

    // Update button states
    topicGrid.querySelectorAll('.topic-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.topic === topicId);
    });

    // Update input to show the topic name
    const meta = gpsData.topicMeta.find(t => t.id === topicId);
    if (meta) {
      input.value = meta.label;
    }

    showResults(topicId);
  }

  // ─── Show Results ───
  function showResults(topicId) {
    const results = gpsData.topics[topicId];
    const meta = gpsData.topicMeta.find(t => t.id === topicId);
    if (!results || !results.length) {
      resultsSection.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    emptyState.style.display = 'none';
    resultsSection.style.display = 'block';
    resultsTitle.textContent = `${meta ? meta.label : topicId} ${meta ? '/ ' + meta.hebrewLabel : ''}`;
    resultsCount.textContent = `${results.length} teaching${results.length !== 1 ? 's' : ''} found`;

    resultsGrid.innerHTML = results.map((r, i) => {
      const ref = buildRef(r);
      return `<article class="result-card" style="animation: fadeIn 0.3s ease ${i * 0.05}s both;">
        <div class="card-header">
          <span class="card-book">${escHtml(r.bookTitle)}</span>
          <span class="card-ref">${escHtml(ref)}</span>
        </div>
        ${r.he ? `<div class="card-he">${escHtml(r.he)}</div>` : ''}
        <div class="card-en">${escHtml(r.en)}</div>
        <a class="card-link" href="${escHtml(r.url)}">Read More &rarr;</a>
      </article>`;
    }).join('');

    // Scroll to results
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function buildRef(r) {
    const parts = [];
    if (r.part) parts.push(`Part ${r.part}`);
    if (r.torah) parts.push(`#${r.torah}`);
    if (r.segment) parts.push(`Seg. ${r.segment}`);
    return parts.join(', ');
  }

  function escHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ─── Search / Fuzzy Match ───
  function searchTopics(query) {
    if (!gpsData) return;
    const q = query.toLowerCase().trim();
    if (!q) {
      clearAllResults();
      return;
    }

    // Score each topic against the query
    const scores = [];
    for (const [topicId, synonyms] of Object.entries(SYNONYMS)) {
      let score = 0;
      for (const syn of synonyms) {
        if (q === syn) { score += 10; continue; }
        if (q.includes(syn)) { score += 5; continue; }
        if (syn.includes(q)) { score += 3; continue; }
        // Partial match (first 3+ chars)
        if (q.length >= 3 && syn.startsWith(q)) { score += 4; continue; }
        if (syn.length >= 3 && q.startsWith(syn)) { score += 2; continue; }
      }
      if (score > 0) {
        scores.push({ topicId, score });
      }
    }

    // Also check topic labels and Hebrew labels directly
    if (gpsData.topicMeta) {
      for (const meta of gpsData.topicMeta) {
        if (meta.label.toLowerCase().includes(q) || q.includes(meta.label.toLowerCase())) {
          const existing = scores.find(s => s.topicId === meta.id);
          if (existing) existing.score += 8;
          else scores.push({ topicId: meta.id, score: 8 });
        }
      }
    }

    if (scores.length === 0) {
      resultsSection.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    // Pick the best matching topic
    scores.sort((a, b) => b.score - a.score);
    const bestTopic = scores[0].topicId;

    // If we have multiple good matches close in score, combine results
    if (scores.length > 1 && scores[1].score >= scores[0].score * 0.6) {
      showCombinedResults(q, scores.slice(0, 3));
    } else {
      selectTopic(bestTopic);
    }
  }

  function showCombinedResults(query, topScores) {
    // Combine results from multiple matching topics
    let combined = [];
    const seenUrls = new Set();

    for (const { topicId } of topScores) {
      const results = gpsData.topics[topicId] || [];
      for (const r of results) {
        const key = r.url + '#' + r.segment;
        if (!seenUrls.has(key)) {
          seenUrls.add(key);
          combined.push(r);
        }
      }
    }

    // Limit to 20 results
    combined = combined.slice(0, 20);

    if (!combined.length) {
      resultsSection.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    // Update UI
    topicGrid.querySelectorAll('.topic-btn').forEach(btn => {
      btn.classList.toggle('active', topScores.some(s => s.topicId === btn.dataset.topic));
    });

    emptyState.style.display = 'none';
    resultsSection.style.display = 'block';
    resultsTitle.textContent = `Results for "${query}"`;
    resultsCount.textContent = `${combined.length} teaching${combined.length !== 1 ? 's' : ''} found`;

    resultsGrid.innerHTML = combined.map((r, i) => {
      const ref = buildRef(r);
      return `<article class="result-card" style="animation: fadeIn 0.3s ease ${i * 0.05}s both;">
        <div class="card-header">
          <span class="card-book">${escHtml(r.bookTitle)}</span>
          <span class="card-ref">${escHtml(ref)}</span>
        </div>
        ${r.he ? `<div class="card-he">${escHtml(r.he)}</div>` : ''}
        <div class="card-en">${escHtml(r.en)}</div>
        <a class="card-link" href="${escHtml(r.url)}">Read More &rarr;</a>
      </article>`;
    }).join('');

    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function clearAllResults() {
    currentTopic = null;
    resultsSection.style.display = 'none';
    emptyState.style.display = 'none';
    topicGrid.querySelectorAll('.topic-btn').forEach(btn => btn.classList.remove('active'));
    input.value = '';
  }

  // ─── Event Handlers ───
  searchBtn.addEventListener('click', () => searchTopics(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      searchTopics(input.value);
    }
  });
  clearBtn.addEventListener('click', clearAllResults);

  // Debounced live search
  let debounceTimer;
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (input.value.trim().length >= 3) {
        searchTopics(input.value);
      }
    }, 400);
  });

  // ─── Fade In Animation ───
  const style = document.createElement('style');
  style.textContent = `@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }`;
  document.head.appendChild(style);

  // ─── URL Parameters ───
  const urlParams = new URLSearchParams(window.location.search);
  const topicParam = urlParams.get('topic');
  const queryParam = urlParams.get('q');

  loadData().then(() => {
    if (topicParam && gpsData && gpsData.topics[topicParam]) {
      selectTopic(topicParam);
    } else if (queryParam) {
      input.value = queryParam;
      searchTopics(queryParam);
    }
  });
})();
</script>
</Layout>
