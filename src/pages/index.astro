---
/**
 * Homepage — ajew.org Phase 1 Renovation
 * ========================================
 * Mission: "Where the Rebbe's teachings come alive — calmly, clearly, and personally."
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="The Breslov Digital Sanctuary — Rebbe Nachman's Teachings in Hebrew & English"
  description="Read 226+ sacred texts from Rebbe Nachman of Breslov — Likutay Moharan, Zohar, Talmud, Tanach, Rambam — free, bilingual, and beautifully calm."
>

<!-- ═══ HERO SECTION ═══ -->
<section class="renovation-hero">
  <div class="hero-inner">
    <div class="hero-nanach">
      <p class="nanach-he" lang="he" dir="rtl">נ נח נחמ נחמן מאומן</p>
      <p class="nanach-en">Na Nach Nachma Nachman MeUman</p>
    </div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-hebrew" lang="he" dir="rtl">רבי נחמן מברסלב</span>
        <span class="hero-english">Rebbe Nachman of Breslov</span>
      </h1>
      <div id="daily-quote" class="daily-quote">
        <div class="quote-hebrew" id="quote-he"></div>
        <div class="quote-english" id="quote-en"></div>
        <div class="quote-source" id="quote-src"></div>
      </div>
      <div class="hero-search">
        <form action="/search-enhanced" method="get" class="search-form">
          <input type="text" name="q" placeholder="Search Torah… / חפש תורה…" dir="auto" autocomplete="off" aria-label="Search" />
          <button type="submit" class="search-btn" aria-label="Search">🔍</button>
        </form>
      </div>
    </div>
  </div>
  <div class="hero-actions">
    <a href="/reader" class="btn-hero btn-hero-primary">
      <span class="btn-icon">📖</span>
      <span><span class="btn-label">Read Torah</span><span class="btn-sub">קריאה בתורה</span></span>
    </a>
    <a href="/reader#likutay-moharan" class="btn-hero btn-hero-secondary">
      <span class="btn-icon">✡️</span>
      <span><span class="btn-label">Likutay Moharan</span><span class="btn-sub">ליקוטי מוהר"ן</span></span>
    </a>
    <a href="/reader/sipurey-maasiyos" class="btn-hero btn-hero-accent">
      <span class="btn-icon">📚</span>
      <span><span class="btn-label">Stories of the Rebbe</span><span class="btn-sub">סיפורי מעשיות</span></span>
    </a>
  </div>
  <div class="hero-topics">
    <span class="topic-label">Browse by topic:</span>
    <a href="/topics?q=emunah" class="topic-pill">Emunah</a>
    <a href="/topics?q=hisbodedus" class="topic-pill">Hisbodedus</a>
    <a href="/topics?q=simcha" class="topic-pill">Simcha</a>
    <a href="/topics?q=teshuvah" class="topic-pill">Teshuvah</a>
    <a href="/topics?q=tefillah" class="topic-pill">Tefillah</a>
    <a href="/topics?q=shalom" class="topic-pill">Shalom</a>
    <a href="/healing-words" class="topic-pill">Healing</a>
    <a href="/topics" class="topic-pill topic-all">All Topics →</a>
  </div>
</section>

<!-- ═══ CONTINUE READING ═══ -->
<section id="continue-reading-section" class="continue-section" style="display:none;">
  <div class="section-inner">
    <h2 class="section-heading"><span class="heading-icon">📖</span> Continue Reading</h2>
    <a id="continue-card" href="#" class="continue-card">
      <div class="continue-info">
        <span id="continue-title" class="continue-title"></span>
        <span id="continue-book" class="continue-book"></span>
        <div class="continue-progress-bar"><div id="continue-progress-fill" class="continue-progress-fill" style="width:0%"></div></div>
        <span id="continue-ago" class="continue-ago"></span>
      </div>
      <span class="continue-arrow">→</span>
    </a>
  </div>
</section>

<!-- ═══ WELCOME ═══ -->
<section class="welcome-section">
  <div class="section-inner">
    <h2 class="section-heading"><span class="heading-icon">🌱</span> Welcome to the Breslov Digital Sanctuary</h2>
    <p class="welcome-text">A free library of sacred Jewish texts in Hebrew and English — featuring the teachings of Rebbe Nachman of Breslov (1772–1810), Na Nach classics, and over 200 books including Talmud, Zohar, Tanach, and Rambam. No account needed. Just read.</p>
    <div class="start-cards">
      <a href="/reader/likutay-moharan/part-1/torah-1" class="start-card start-card-gold">
        <span class="start-card-icon">🕯️</span>
        <span class="start-card-label">The First Teaching</span>
        <span class="start-card-name" lang="he" dir="rtl">ליקוטי מוהר"ן א:א</span>
        <span class="start-card-desc">The foundation of Rebbe Nachman's wisdom. A beautiful place to begin.</span>
      </a>
      <a href="/reader/sipurey-maasiyos" class="start-card start-card-navy">
        <span class="start-card-icon">📖</span>
        <span class="start-card-label">Stories of the Rebbe</span>
        <span class="start-card-name" lang="he" dir="rtl">סיפורי מעשיות</span>
        <span class="start-card-desc">13 mystical tales — engaging, deep, and accessible to all.</span>
      </a>
      <a href="/help-me" class="start-card start-card-green">
        <span class="start-card-icon">💚</span>
        <span class="start-card-label">Going Through Something?</span>
        <span class="start-card-name" lang="he" dir="rtl">עזרו לי</span>
        <span class="start-card-desc">Find Torah guidance for whatever you're facing right now.</span>
      </a>
      <a href="/reader" class="start-card start-card-teal">
        <span class="start-card-icon">📚</span>
        <span class="start-card-label">Explore the Full Library</span>
        <span class="start-card-name" lang="he" dir="rtl">כל ספרי ברסלב</span>
        <span class="start-card-desc">226+ sacred texts — Talmud, Zohar, Tanach, Rambam, and more.</span>
      </a>
    </div>
  </div>
</section>

<!-- ═══ FEATURED ═══ -->
<section class="featured-section">
  <div class="section-inner">
    <h2 class="section-heading"><span class="heading-icon">🔥</span> The Breslov Torah Treasury</h2>
    <p class="featured-subheading">Over 25,000 pages of sacred texts — free, bilingual, and always calm.</p>
    <div class="featured-grid">
      <div class="featured-card"><div class="card-icon">✡️</div><h3>Likutay Moharan</h3><p class="card-hebrew" lang="he" dir="rtl">ליקוטי מוהר"ן</p><p class="card-desc">411 teachings — the foundation of Breslov hashkafa. Full Hebrew with English translation.</p><a href="/reader#likutay-moharan" class="card-link">Read →</a></div>
      <div class="featured-card"><div class="card-icon">📜</div><h3>Zohar HaKadosh</h3><p class="card-hebrew" lang="he" dir="rtl">זהר הקדוש</p><p class="card-desc">All 8 volumes — 1,930 pages of Kabbalistic wisdom.</p><a href="/reader#zohar-hakdama" class="card-link">Read →</a></div>
      <div class="featured-card"><div class="card-icon">📚</div><h3>Talmud Bavli</h3><p class="card-hebrew" lang="he" dir="rtl">תלמוד בבלי</p><p class="card-desc">39 tractates — 5,400 dapim, available to read online.</p><a href="/reader#talmud-bavli-brachot" class="card-link">Read →</a></div>
      <div class="featured-card"><div class="card-icon">🌟</div><h3>Full Tanach</h3><p class="card-hebrew" lang="he" dir="rtl">תנ״ך מלא</p><p class="card-desc">All 39 books — Torah, Nevi'im, Ketuvim with nikud.</p><a href="/reader#tanach-bereishit" class="card-link">Read →</a></div>
      <div class="featured-card"><div class="card-icon">⚖️</div><h3>Rambam</h3><p class="card-hebrew" lang="he" dir="rtl">רמב"ם — משנה תורה</p><p class="card-desc">14 books — 1,008 chapters, 15,000+ halachot.</p><a href="/reader#rambam-mada" class="card-link">Read →</a></div>
      <div class="featured-card"><div class="card-icon">🕎</div><h3>Breslov Classics</h3><p class="card-hebrew" lang="he" dir="rtl">קלאסיקת ברסלב</p><p class="card-desc">Likutay Halachos, Likutay Tefilos, Sichos HaRan, and 40+ more.</p><a href="/reader" class="card-link">Browse All →</a></div>
    </div>
  </div>
</section>

<!-- ═══ TOOLS ═══ -->
<section class="tools-section">
  <div class="section-inner">
    <h2 class="section-heading"><span class="heading-icon">🛠️</span> Tools & Special Features</h2>
    <div class="tools-grid">
      <a href="/daily-study" class="tool-card"><span class="tool-icon">📅</span><span><span class="tool-label">Daily Study</span><span class="tool-he" lang="he" dir="rtl">לימוד יומי</span></span></a>
      <a href="/torah-gps" class="tool-card"><span class="tool-icon">🧭</span><span><span class="tool-label">Torah GPS</span><span class="tool-he" lang="he" dir="rtl">תורה GPS</span></span></a>
      <a href="/torah-lens" class="tool-card"><span class="tool-icon">🔭</span><span><span class="tool-label">Torah Lens</span><span class="tool-he" lang="he" dir="rtl">עדשת תורה</span></span></a>
      <a href="/healing-words" class="tool-card tool-card-green"><span class="tool-icon">🩹</span><span><span class="tool-label">Healing Words</span><span class="tool-he" lang="he" dir="rtl">דברי מרפא</span></span></a>
      <a href="/gematria" class="tool-card"><span class="tool-icon">🔢</span><span><span class="tool-label">Gematria</span><span class="tool-he" lang="he" dir="rtl">גימטריה</span></span></a>
      <a href="/parsha" class="tool-card"><span class="tool-icon">📜</span><span><span class="tool-label">Parsha</span><span class="tool-he" lang="he" dir="rtl">פרשת שבוע</span></span></a>
    </div>
  </div>
</section>

<!-- ═══ APP BANNER ═══ -->
<section class="app-banner">
  <div class="section-inner">
    <div class="app-banner-inner">
      <span class="app-icon">📱</span>
      <div class="app-info"><h3>Install the ajew ananach App</h3><p>Offline capable • Bilingual HE/EN • Free</p></div>
      <a href="https://github.com/petteknanach/ajew-ananach/releases" target="_blank" rel="noopener" class="app-install-btn">Install →</a>
    </div>
  </div>
</section>

<!-- ═══ BOTTOM QUOTE ═══ -->
<section class="bottom-quote">
  <div class="section-inner">
    <blockquote>
      <p class="bq-hebrew" lang="he" dir="rtl">אם אתה מאמין שיכולין לקלקל, תאמין שיכולין לתקן</p>
      <p class="bq-english">"If you believe you can damage, believe you can fix."</p>
      <cite>— Rebbe Nachman of Breslov</cite>
    </blockquote>
  </div>
</section>

<!-- ═══ SPREAD ═══ -->
<section class="spread-section">
  <div class="section-inner">
    <h2 class="section-heading">Spread the Light</h2>
    <p class="spread-desc">The Breslov Torah Treasury is free for everyone. Help others discover these teachings.</p>
    <div class="spread-buttons">
      <a href="https://twitter.com/intent/tweet?text=Free%20Breslov%20Torah%20library%20%E2%80%94%20226%2B%20books%2C%2025%2C000%2B%20pages%20in%20Hebrew%20%26%20English.&url=https%3A%2F%2Fajew.org&hashtags=Torah,Breslov,NaNach" target="_blank" rel="noopener" class="spread-btn">Share on X</a>
      <button type="button" class="spread-btn" id="copyLinkBtn">Copy Link</button>
      <a href="/rss.xml" class="spread-btn">RSS Feed</a>
    </div>
  </div>
</section>

</Layout>

<script is:inline>
(function() {
  var quotes = [
    { he: 'כל העולם כולו גשר צר מאוד, והעיקר לא לפחד כלל', en: 'The whole world is a very narrow bridge, and the main thing is not to fear at all', src: 'LM II:48' },
    { he: 'אם אתה מאמין שיכולין לקלקל, תאמין שיכולין לתקן', en: 'If you believe you can damage, believe you can fix', src: 'LM II:112' },
    { he: 'מצוה גדולה להיות בשמחה תמיד', en: 'It is a great mitzvah to always be happy', src: 'LM II:24' },
    { he: 'אין שום יאוש בעולם כלל', en: 'There is no despair in the world at all', src: 'LM II:78' },
    { he: 'התבודדות הוא מעלה עליונה ויתירה על הכל', en: 'Hitbodedut is the highest virtue of all', src: 'LM II:25' },
    { he: 'עיקר החיות מהשמחה', en: 'The essence of life is from joy', src: 'LM II:24' },
    { he: 'כשאדם יודע שכל הקורותיו הם לטובתו, זאת הבחינה מעין עולם הבא', en: 'When a person knows all that happens is for his good, this is like the World to Come', src: 'LM I:4' },
    { he: 'תפילה בלא כוונה כגוף בלא נשמה', en: 'Prayer without intent is like a body without a soul', src: 'LM I:2' },
    { he: 'צריך לחפש ולבקש למצוא בעצמו איזה מעט טוב', en: 'One must search to find in oneself some small good', src: 'LM I:282' },
    { he: 'נ נח נחמ נחמן מאומן', en: 'Na Nach Nachma Nachman MeUman', src: 'The Petek' },
  ];
  var day = Math.floor(Date.now() / 86400000) % quotes.length;
  var q = quotes[day];
  var heEl = document.getElementById('quote-he');
  var enEl = document.getElementById('quote-en');
  var srcEl = document.getElementById('quote-src');
  if (heEl) heEl.textContent = q.he;
  if (enEl) enEl.textContent = '"' + q.en + '"';
  if (srcEl) srcEl.textContent = '— ' + q.src;
  try {
    var hist = JSON.parse(localStorage.getItem('ajew-reading-history') || '[]');
    if (hist.length > 0) {
      var last = hist[0];
      if (last.url && last.url.startsWith('/reader/')) {
        var sec = document.getElementById('continue-reading-section');
        if (sec) {
          sec.style.display = 'block';
          document.getElementById('continue-card').href = last.url;
          document.getElementById('continue-title').textContent = last.title || 'Unknown';
          document.getElementById('continue-book').textContent = last.book || '';
          if (last.progress > 0) document.getElementById('continue-progress-fill').style.width = Math.min(last.progress, 100) + '%';
          if (last.timestamp) {
            var diff = Date.now() - parseInt(last.timestamp);
            var hrs = Math.floor(diff / 3600000);
            document.getElementById('continue-ago').textContent = hrs < 1 ? 'Just now' : hrs < 24 ? hrs + 'h ago' : Math.floor(hrs / 24) + 'd ago';
          }
        }
      }
    }
  } catch(e) {}
  var copyBtn = document.getElementById('copyLinkBtn');
  if (copyBtn) copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText('https://ajew.org').then(function() { copyBtn.textContent = 'Copied!'; setTimeout(function() { copyBtn.textContent = 'Copy Link'; }, 2000); }).catch(function() {});
  });
})();
</script>

<style>
  :root { --hero-bg: linear-gradient(135deg, #0f2744 0%, #1a365d 40%, #2a5a8e 100%); --gold: #d4a017; --gold-light: #f0cc5c; --navy: #1a365d; --parchment: #faf7f2; }

  .renovation-hero {
    background: var(--hero-bg); color: white; padding: 2rem 1.5rem 3rem; text-align: center;
  }
  .hero-inner { max-width: 800px; margin: 0 auto; }
  .hero-nanach { margin-bottom: 1.5rem; }
  .nanach-he { font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif); font-size: 1.5rem; color: var(--gold-light); direction: rtl; margin: 0; }
  .nanach-en { font-size: 0.8rem; color: rgba(255,255,255,0.6); margin: 4px 0 0; letter-spacing: 0.15em; text-transform: uppercase; }
  .hero-title { margin: 0 0 1.5rem; }
  .hero-hebrew { font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif); font-size: 2.8rem; font-weight: 700; color: var(--gold-light); direction: rtl; display: block; margin-bottom: 4px; }
  .hero-english { font-family: Georgia, serif; font-size: 1.6rem; font-weight: 400; color: rgba(255,255,255,0.9); display: block; }

  .daily-quote { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.25rem 1.5rem; margin: 0 auto 1.5rem; max-width: 680px; }
  .quote-hebrew { font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif); font-size: 1.15rem; color: var(--gold-light); direction: rtl; text-align: right; margin-bottom: 6px; }
  .quote-english { font-family: Georgia, serif; font-size: 0.95rem; color: rgba(255,255,255,0.85); font-style: italic; margin-bottom: 4px; }
  .quote-source { font-size: 0.75rem; color: rgba(255,255,255,0.5); }

  .hero-search { max-width: 520px; margin: 0 auto; }
  .search-form { display: flex; border-radius: 50px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
  .search-form input { flex: 1; padding: 0.9rem 1.25rem; font-size: 1rem; border: none; outline: none; background: rgba(255,255,255,0.95); color: var(--navy); direction: auto; }
  .search-form input::placeholder { color: #999; }
  .search-btn { padding: 0.9rem 1.25rem; background: var(--gold); border: none; cursor: pointer; font-size: 1.1rem; transition: background 0.2s; }
  .search-btn:hover { background: var(--gold-light); }

  .hero-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 2rem auto 0; }
  .btn-hero { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: transform 0.15s; }
  .btn-hero:hover { transform: translateY(-2px); }
  .btn-hero-primary { background: var(--gold); color: var(--navy); }
  .btn-hero-secondary { background: rgba(255,255,255,0.12); color: white; border: 1px solid rgba(255,255,255,0.2); }
  .btn-hero-accent { background: rgba(212,160,23,0.2); color: var(--gold-light); border: 1px solid rgba(212,160,23,0.3); }
  .btn-icon { font-size: 1.2rem; }
  .btn-label { display: block; line-height: 1.2; }
  .btn-sub { display: block; font-size: 0.75rem; font-weight: 400; opacity: 0.7; font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif); }

  .hero-topics { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 1.5rem auto 0; align-items: center; }
  .topic-label { font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-right: 4px; }
  .topic-pill { display: inline-block; padding: 4px 14px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 50px; color: rgba(255,255,255,0.8); font-size: 0.8rem; text-decoration: none; transition: background 0.2s; }
