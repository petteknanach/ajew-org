    },
    {
      "index": 2,
      "he": "א.\n\nזְקֵנִים מַעֲמִידִים אֶת יִשְׂרָאֵל וַעֲצָתָם טוֹבָה לָנוּ.",
      "en": "",
      "id": "sh-זקנים-א"
    },
    {
      "index": 3,
      "he": "ב.\n\nלְפִי הַזְּקֵנִים שֶׁבַּדּוֹר כֵּן הַפַּרְנָסָה.",
      "en": "",
      "id": "sh-זקנים-ב"
    },
    {
      "index": 4,
      "he": "ג.\n\nאִם הַזְּקֵנִים אֵינָם חֲכָמִים סִימָן לַדָּבָר – שֶׁעִקַּר חֲשִׁיבוּתָם הוּא אֵצֶל נָשִׁים  הַיְלָדוֹת.",
      "en": "",
      "id": "sh-זקנים-ג"
    }
  ],
