          ],
          "utf8SHA256": "8626ee39ec94e67be4974635ce48e349d9f93dcaca7752574c68b242ca9b07e3"
        }
      ],
      "sha256": "8626ee39ec94e67be4974635ce48e349d9f93dcaca7752574c68b242ca9b07e3",
      "body": "ואין מרבין עליו - דברים לאיים עליו שיפרוש:"
    },
    {
      "ref": "Rashi on Yevamot 47b:2:1",
      "pointer": "/text/93/1/0",
      "included": [
        {
          "cp": [
            0,
