import Layout from '../../layouts/Layout.astro';
import '../../styles/reader-index.css';

// Load master catalog and all book indexes
import fs from 'node:fs';
import path from 'node:path';

function loadJSON(filePath) {
  try {
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), filePath), 'utf8'));
  } catch (e) { return null; }
}

const masterCatalog = loadJSON('public/reader/catalog.json') || { books: [] };
const bookDescriptions = loadJSON('src/data/book-descriptions.json') || {};

// Load index for each book's parts
function loadBookIndexes(book) {
  const indexes = [];
  for (const part of book.parts) {
    const idx = loadJSON(part.indexUrl.replace(/^\//, 'public/'));
    if (idx) indexes.push({ ...part, index: idx });
  }
  return indexes;
}

// Group books by category
const categories = [
  { title: '1. Rabbi Nachman of Breslov / רבי נחמן מברסלב', ids: ['likutay-moharan', 'kitzur-likutay-moharan', 'sefer-hamidos', 'sipurey-maasiyos', 'sipurey-maasiyos-english', 'sichos-haran', 'shivchay-haran', 'praises-of-rabbi-nachman', 'chayey-moharan', 'chayey-moharan-hosafos', 'toldos-adam'] },
  { title: '2. Rabbi Nosson of Breslov / רבי נתן מברסלב', ids: ['likutay-halachos', 'likutay-tefilos', 'likutay-eitzos', 'alim-litrufa', 'yemei-moharnat', 'shemos-hatzadikim', 'yemei-hatlaos', 'meshivas-nefesh'] },
  { title: '3. Saba — Rabbi Yisroel Dov Odesser / סבא רבי ישראל דב אודסר זצ"ל', ids: ['ebay-hanachal', 'yisroel-saba', 'fires-of-israel', 'sichos-chayay-saba', 'saba-tape-transcripts', 'likutay-nanach', 'pettek-nanach-commentary', 'misc-אגרת-הפורים'] },
  { title: "4. R' Shimshon Barsky / ר' שמשון בארסקי", ids: ['shimshon-גבורות-שמשון', 'shimshon-עצות-המבוארות', 'gevuros-shimshon', 'aitzoas-hamivooaroas', 'aitzoas-yeshuroas'] },
  { title: '5. Rabbi Nachman of Tcherin / רבי נחמן מטשערין', ids: ['parparos-lechochma', 'rimzei-hamaasiyos', 'zimras-haaretz', 'yikra-dshabbata', 'yereach-haeitanim', 'nachas-hashulchan', 'likutay-eitzos-basra', 'otzar-hayirah'] },
  { title: "6. Rabbi Avraham bar Nachman / רבי אברהם בר' נחמן", ids: ['biur-halikutim', 'chochma-utvuna', 'kokhvei-or'] },
  { title: '7. Rabbi Shmuel Horowitz / רבי שמואל הורוויץ', ids: ['michtevay-shmuel'] },
  { title: '8. Rabbi Nosson bar Yehuda / רבי נתן בר יהודה', ids: ['nosson-by-מכתבי-ר--נתן-ב--ר-יה', 'nosson-by-קונטרס-הצירופים-עם-ה', 'nosson-by-קונטרס-הצרופים'] },
