---
import Layout from '../../../../layouts/Layout.astro';
import Comments from '../../../../components/Comments.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const paths = [];
  const pncDir = path.join(process.cwd(), 'public/reader/pettek-nanach-commentary');

  if (fs.existsSync(pncDir)) {
    // Scan all torah-N.json files (Part 1)
    const torahFiles = fs.readdirSync(pncDir).filter(f => /^torah-\d+\.json$/.test(f));
    for (const f of torahFiles) {
      const num = parseInt(f.match(/torah-(\d+)\.json/)[1]);
      paths.push({ params: { part: '1', torah: String(num) } });
    }

    // Scan all tinyana-N.json files (Part 2)
    const tinyanaFiles = fs.readdirSync(pncDir).filter(f => /^tinyana-\d+\.json$/.test(f));
    for (const f of tinyanaFiles) {
      const num = parseInt(f.match(/tinyana-(\d+)\.json/)[1]);
      paths.push({ params: { part: '2', torah: String(num) } });
    }

    // Scan intro/front matter files (any .json that isn't torah-N, tinyana-N, or index)
    const introFiles = fs.readdirSync(pncDir).filter(f =>
      f.endsWith('.json') &&
      f !== 'index.json' &&
      !/^torah-\d+\.json$/.test(f) &&
      !/^tinyana-\d+\.json$/.test(f)
    );
    for (const f of introFiles) {
      const slug = f.replace('.json', '');
      paths.push({ params: { part: '1', torah: slug } });
    }
  }

  return paths;
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahNum = parseInt(torah);
const isIntroPage = isNaN(torahNum);

let torahData = null;
let error = null;

try {
  let fileName;
  if (isIntroPage) {
    // Intro/front matter files are loaded by slug name
    fileName = `${torah}.json`;
  } else if (partNum === 2) {
    fileName = `tinyana-${torahNum}.json`;
  } else {
    fileName = `torah-${torahNum}.json`;
  }
  const filePath = path.join(process.cwd(), `public/reader/pettek-nanach-commentary/${fileName}`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = isIntroPage ? `Page "${torah}" not found` : `Torah ${torahNum} not found`;
}

if (!torahData && !error) error = 'Content not available';

if (torahData) {
  if (!isIntroPage) {
    // Dynamic: scan actual files for the max torah number in this part
    const pncDir = path.join(process.cwd(), 'public/reader/pettek-nanach-commentary');
    const prefix = partNum === 2 ? 'tinyana' : 'torah';
    const regex = new RegExp(`^${prefix}-(\\d+)\\.json$`);
    const partFiles = fs.existsSync(pncDir) ? fs.readdirSync(pncDir).filter(f => regex.test(f)) : [];
    const partNums = partFiles.map(f => parseInt(f.match(regex)[1]));
    const maxTorah = partNums.length > 0 ? Math.max(...partNums) : 999;
    if (!torahData.navigation) {
      torahData.navigation = {
        prevUrl: torahNum > 1 ? `/reader/pettek-nanach-commentary/${partNum}/${torahNum - 1}` : null,
        nextUrl: torahNum < maxTorah ? `/reader/pettek-nanach-commentary/${partNum}/${torahNum + 1}` : null,
      };
    }
  } else {
    // For intro pages, set up navigation to first torah
    if (!torahData.navigation) {
      torahData.navigation = {
        prevUrl: null,
        nextUrl: `/reader/pettek-nanach-commentary/1/1`,
      };
    }
  }
  torahData.segments.forEach((seg, i) => {
    if (!seg.index) seg.index = i + 1;
  });
}

const bookName = 'Pettek Nanach Commentary';
const bookHebrew = 'פירוש פתק נ נח';
const itemName = isIntroPage ? 'Section' : 'Torah';

const pageTitle = torahData
  ? `${torahData.hebrewTitle || torahData.title} - Pettek Nanach Commentary`
  : (isIntroPage ? 'Section Not Found' : 'Torah Not Found');
const pageDesc = torahData
  ? `Read ${torahData.title} from Pettek Nanach Running Commentary on Likutey Moharan`
  : '';

const structuredData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${torahData.title} - Pettek Nanach Commentary`,
  "alternativeHeadline": torahData.hebrewTitle || '',
  "author": { "@type": "Person", "name": "Pettek Nanach" },
  "publisher": { "@type": "Organization", "name": "ajew.org" },
  "inLanguage": ["he", "en"],
  "isPartOf": { "@type": "Book", "name": "Pettek Nanach Running Commentary on Likutey Moharan" },
  "url": `https://ajew.org/reader/pettek-nanach-commentary/${partNum}/${torah}`
}) : '';
---

<Layout title={pageTitle} description={pageDesc}>
  {torahData && structuredData && (
    <script type="application/ld+json" set:html={structuredData} slot="head" />
  )}
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div
      class="reader-container"
      data-torah-id={torahData.id}
      data-torah-title={`${torahData.title} - Petek Nanach Commentary`}
    >
      <div class="reader-progress"></div>

      <div class="reader-breadcrumb">
        <a href="/reader">Reader</a>
        <span>&rsaquo;</span>
        <a href="/reader">Petek Nanach Commentary</a>
        <span>&rsaquo;</span>
        {torahData.hebrewTitle || torahData.title}
      </div>

      <div class="reader-toolbar">
        <div class="reader-toolbar-group">
          <button class="reader-btn" data-mode="hebrew">Hebrew</button>
          <button class="reader-btn" data-mode="english">English</button>
          <button class="reader-btn" data-mode="both">Both</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn" id="btn-nikud">Nikud</button>
        </div>
        <div class="reader-toolbar-group">
          <span style="font-size:0.7em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
          <input type="range" id="font-size-slider" class="font-size-slider" min="12" max="32" value="18" />
          <span style="font-size:0.9em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" data-theme-btn="day">Day</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="sepia">Sepia</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="night">Night</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" id="btn-listen" onclick="toggleSpeaking()">Listen</button>
          <button class="reader-btn reader-btn-icon" id="btn-search">Search</button>
          <button class="reader-btn reader-btn-icon" id="btn-bookmark">Bookmark</button>
          <button class="reader-btn reader-btn-icon" id="btn-align" title="Sentence-by-sentence aligned view">Align</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen">Fullscreen</button>
        </div>
      </div>

      <div class="reader-search-bar">
        <input type="text" placeholder={"Search in this section..."} dir="auto" />
        <span class="search-info"></span>
        <button class="reader-btn search-close">Close</button>
      </div>

      <button class="reader-toc-toggle" title="Table of Contents">&#9776;</button>
      <div class="reader-toc">
        <button class="reader-toc-close">&times;</button>
        <h3>Sections</h3>
        <ul class="reader-toc-list">
          {torahData.segments.map((seg, i) => (
            <li><a href={`#seg-${seg.index}`} data-index={String(seg.index)}>{seg.index}</a></li>
          ))}
        </ul>
      </div>

      <div class="reader-header">
        {torahData.hebrewTitle && <div class="hebrew-title">{torahData.hebrewTitle}</div>}
        <h1>{torahData.title}</h1>
        <p style="color: var(--reader-text-secondary); font-size: 0.9em; font-family: 'Open Sans', sans-serif;">
          Petek Nanach Running Commentary on Likutey Moharan
        </p>
      </div>

      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous</a>
        ) : <span class="disabled">&larr; Previous</span>}
        <a href={`/reader/pettek-nanach-commentary/${partNum}`}>Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next &rarr;</a>
        ) : <span class="disabled">Next &rarr;</span>}
      </div>

      <div class="reader-content mode-hebrew">
        <div class="reader-content-original">
{torahData.segments.map((seg, i) => {
            const idx = seg.index || (i + 1);
            
            let heText = '';
            let enText = '';
            
            if (seg.he) {
              // Format 1: Flat seg.he / seg.en
              heText = seg.he;
              enText = seg.en || '';
            } else if (seg.beginner || seg.intermediate) {
              // PNC layered format - could be strings or objects
              const b = seg.beginner;
              const inter = seg.intermediate;
              const s = seg.scholarly || {};
              
              if (typeof b === 'string') {
                // Torah 1-286 format: beginner=EN string, intermediate=HE string
                enText = b;
                heText = typeof inter === 'string' ? inter : '';
              } else if (b && typeof b === 'object') {
                // Tinyana format: beginner.en, intermediate.en, scholarly.he
                enText = b.en || inter?.en || '';
                heText = s.he || inter?.he || '';
              }
            }
            
            return (
          <div class="reader-segment-pair" id={`seg-${idx}`}>
            <div class="reader-segment segment-he" data-index={String(idx)}>
              <span class="segment-number">{idx}</span>
              <p data-nikud={heText}>{heText}</p>
            </div>
            <div class={`reader-segment segment-en ${!enText ? 'empty-translation' : ''}`} data-index={String(idx)}>
              <span class="segment-number">{idx}</span>
              <p>{enText || 'Translation not yet available'}</p>
            </div>
          </div>
            );
        })}
        </div>
        {torahData.aligned_segments && (
          <div class="reader-content-aligned" style="display:none;">
            {torahData.aligned_segments.map((seg) => (
              <div class={`reader-segment-pair ${seg.type === 'note' ? 'segment-note' : ''}`} id={`aligned-${seg.index}`}>
                <div class="reader-segment segment-he" data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.he || '\u00A0'}</p>
                </div>
                <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.en || '\u00A0'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous</a>
        ) : <span class="disabled">&larr; Previous</span>}
        <a href={`/reader/pettek-nanach-commentary/${partNum}`}>Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next &rarr;</a>
        ) : <span class="disabled">Next &rarr;</span>}
      </div>

      <div class="reader-shortcuts-overlay">
        <div class="reader-shortcuts-panel">
          <h2>Keyboard Shortcuts</h2>
          <div class="shortcut-row"><span>Hebrew mode</span><span class="shortcut-key">H</span></div>
          <div class="shortcut-row"><span>English mode</span><span class="shortcut-key">E</span></div>
          <div class="shortcut-row"><span>Both columns</span><span class="shortcut-key">B</span></div>
          <div class="shortcut-row"><span>Toggle nikud</span><span class="shortcut-key">N</span></div>
          <div class="shortcut-row"><span>Fullscreen</span><span class="shortcut-key">F</span></div>
          <div class="shortcut-row"><span>Search in text</span><span class="shortcut-key">Ctrl+F</span></div>
          <div class="shortcut-row"><span>Save bookmark</span><span class="shortcut-key">S</span></div>
          <div class="shortcut-row"><span>Previous/Next</span><span class="shortcut-key">&larr; &rarr;</span></div>
          <div class="shortcut-row"><span>Show shortcuts</span><span class="shortcut-key">?</span></div>
          <br />
          <button class="reader-btn" onclick="this.closest('.reader-shortcuts-overlay').classList.remove('open')">Close</button>
        </div>
      </div>
      {torahData && (
        <Comments teachingId={`pettek-nanach-${part}-${torah}`} teachingTitle={`pettek-nanach ${part}:${torah}${torahData?.title ? ' — ' + torahData.title : ''}`} />
      )}

      <script src="/reader-script.js" defer></script>
      <script src="/reader-v2.js" defer></script>
      <script src="/pwa-register.js" defer></script>
      <script src="/tts-fix.js" defer></script>
    </div>
  )}
</Layout>
