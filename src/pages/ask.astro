---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ask - Find Answers in the Teachings" description="Ask any question about life, faith, prayer, or Torah and discover what Rebbe Nachman's teachings say about it.">
  <section class="ask-page">
    <div class="container">
      <div class="page-header">
        <h1 class="hebrew-title">שאל</h1>
        <h1>Ask the Teachings</h1>
        <p class="subtitle">Type your question and discover what the holy books say</p>
      </div>

      <div class="ask-form">
        <input type="text" id="askInput" placeholder="How do I find joy? / איך למצוא שמחה?" dir="auto" autocomplete="off" />
        <button id="askBtn">Ask</button>
      </div>

      <div class="suggestions">
        <span class="sug-label">Try asking:</span>
        <button class="sug-btn" data-q="How do I overcome sadness?">How to overcome sadness?</button>
        <button class="sug-btn" data-q="What is hitbodedut?">What is hitbodedut?</button>
        <button class="sug-btn" data-q="איך להתחזק באמונה">How to strengthen faith?</button>
        <button class="sug-btn" data-q="Why is joy so important?">Why is joy important?</button>
        <button class="sug-btn" data-q="How to do teshuva?">How to do teshuva?</button>
        <button class="sug-btn" data-q="What does the tzaddik do?">What does the tzaddik do?</button>
      </div>

      <div class="ask-tip">
        <p>💡 <strong>Tip:</strong> Your question is searched across 226+ books and 30,000+ pages of Torah.</p>
      </div>
    </div>
  </section>

  <script is:inline>
  // Map common English questions to Hebrew search terms
  const QUESTION_MAP = [
    { patterns: ['joy', 'happy', 'happiness', 'sad', 'sadness', 'depression', 'depressed'], terms: ['שמחה', 'עצבות'] },
    { patterns: ['faith', 'believe', 'belief', 'emuna', 'doubt'], terms: ['אמונה'] },
    { patterns: ['pray', 'prayer', 'daven', 'tefila', 'tefillah'], terms: ['תפילה'] },
    { patterns: ['hitbodedut', 'meditation', 'seclude', 'seclusion', 'alone'], terms: ['התבודדות'] },
    { patterns: ['teshuva', 'repent', 'repentance', 'return'], terms: ['תשובה'] },
    { patterns: ['tzaddik', 'righteous', 'rebbe', 'leader'], terms: ['צדיק'] },
    { patterns: ['heal', 'healing', 'sick', 'illness', 'health'], terms: ['רפואה'] },
    { patterns: ['money', 'livelihood', 'parnasa', 'income', 'work', 'job'], terms: ['פרנסה'] },
    { patterns: ['peace', 'shalom', 'argue', 'conflict', 'anger'], terms: ['שלום'] },
    { patterns: ['humble', 'humility', 'pride', 'arrogant', 'ego'], terms: ['ענווה', 'גאווה'] },
    { patterns: ['torah', 'study', 'learn', 'wisdom'], terms: ['תורה', 'חכמה'] },
    { patterns: ['love', 'ahava', 'compassion'], terms: ['אהבה'] },
    { patterns: ['fear', 'awe', 'yirah', 'afraid', 'anxiety', 'worry'], terms: ['יראה', 'בטחון'] },
    { patterns: ['soul', 'neshama', 'spiritual'], terms: ['נשמה'] },
    { patterns: ['charity', 'tzedaka', 'give', 'donate'], terms: ['צדקה'] },
    { patterns: ['mashiach', 'messiah', 'redemption', 'geula'], terms: ['משיח', 'גאולה'] },
    { patterns: ['shabbat', 'sabbath', 'shabbos'], terms: ['שבת'] },
    { patterns: ['children', 'child', 'kids', 'education', 'chinuch'], terms: ['בנים', 'חינוך'] },
    { patterns: ['marriage', 'spouse', 'wife', 'husband', 'shalom bayit'], terms: ['שלום בית', 'זיווג'] },
    { patterns: ['song', 'music', 'niggun', 'sing'], terms: ['שירה', 'ניגון'] },
    { patterns: ['desire', 'temptation', 'yetzer', 'test', 'nisayon'], terms: ['תאוה', 'נסיון'] },
    { patterns: ['forgive', 'forgiveness', 'sliha'], terms: ['סליחה', 'מחילה'] },
    { patterns: ['trust', 'bitachon', 'worry', 'anxious'], terms: ['בטחון'] },
    { patterns: ['truth', 'emet', 'honest'], terms: ['אמת'] },
    { patterns: ['speech', 'speak', 'lashon hara', 'gossip', 'words'], terms: ['דיבור', 'שמירת הלשון'] },
  ];

  function extractSearchTerms(question) {
    const lower = question.toLowerCase();
    const terms = new Set();

    // If already Hebrew, use directly
    if (/[֐-׿]/.test(question)) {
      return question;
    }

    // Match English patterns to Hebrew terms
    for (const mapping of QUESTION_MAP) {
      for (const pattern of mapping.patterns) {
        if (lower.includes(pattern)) {
          mapping.terms.forEach(t => terms.add(t));
        }
      }
    }

    if (terms.size > 0) return [...terms].join(' ');
    // Fallback: use original question
    return question;
  }

  function askQuestion() {
    const input = document.getElementById('askInput');
    const question = input.value.trim();
    if (!question) return;

    const searchTerms = extractSearchTerms(question);
    window.location.href = '/search-enhanced?q=' + encodeURIComponent(searchTerms);
  }

  // Wire up the button
  document.getElementById('askBtn').addEventListener('click', askQuestion);

  // Enter key
  document.getElementById('askInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') askQuestion();
  });

  // Suggestion buttons
  document.querySelectorAll('.sug-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('askInput').value = btn.dataset.q;
      askQuestion();
    });
  });
  </script>
</Layout>

<style>
  .ask-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .page-header { text-align: center; margin-bottom: 2rem; }
  .hebrew-title {
    font-family: var(--ds-font-hebrew, 'Frank Ruhl Libre', serif);
    font-size: 3rem;
    color: var(--ds-navy-700, #1a365d);
    direction: rtl;
    margin: 0;
  }
  .page-header h1 {
    font-family: Georgia, serif;
    color: var(--ds-navy-700, #1a365d);
    font-size: 1.5rem;
    margin: 0.5rem 0;
  }
  .subtitle { color: var(--ds-text-muted, #888); }

  .ask-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .ask-form input {
    flex: 1;
    padding: 0.9rem 1.25rem;
    font-size: 1.05rem;
    border: 2px solid var(--ds-border, #e0d6c2);
    border-radius: 12px;
    background: var(--ds-white, #fff);
    color: var(--ds-text-primary, #1a1a1a);
    font-family: var(--ds-font-body, sans-serif);
  }
  .ask-form input:focus {
    outline: none;
    border-color: var(--ds-navy-500, #3a7abd);
    box-shadow: 0 0 0 3px var(--ds-navy-100, #e0eef7);
  }
  .ask-form button {
    padding: 0.9rem 1.75rem;
    background: var(--ds-navy-700, #1a365d);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .ask-form button:hover { background: var(--ds-navy-600, #2a5a8e); }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .sug-label { color: var(--ds-text-muted, #888); font-size: 0.85rem; }
  .sug-btn {
    background: var(--ds-surface-raised, #f5f0e6);
    border: 1px solid var(--ds-border, #e0d6c2);
    color: var(--ds-navy-700, #1a365d);
    padding: 0.3rem 0.75rem;
    border-radius: 16px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  .sug-btn:hover { background: var(--ds-border, #e0d6c2); }

  .ask-tip {
    background: var(--ds-surface, #faf7f2);
    border: 1px solid var(--ds-border, #e0d6c2);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-top: 1rem;
  }
  .ask-tip p { margin: 0; color: var(--ds-text-secondary, #555); }

  @media (max-width: 600px) {
    .ask-form { flex-direction: column; }
    .hebrew-title { font-size: 2.2rem; }
  }
</style>
