---
<Layout title="{title} - {bookTitle}" description="Blossoms of the Spring - Letter 36 - The holy letters of Rabbi Yisroel Odesser">
  <div class="book-page">
    <header class="book-header">
      <h1>{bookTitle}</h1>
      <h2>Letter 36</h2>
    </header>
    <nav class="chapter-nav">
