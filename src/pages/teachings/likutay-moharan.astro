---
const pageTitle = "Likutay Moharan";
const pageDescription = "Likutay Moharan - The Torah Teachings of Rabbi Nachman of Breslov";

// Generate Torah links for Vol 1 (49-286)
const vol1Links = [];
for (let i = 49; i <= 286; i++) {
  vol1Links.push({ num: i, url: `/teachings/likutay-moharan-vol1-torah${i}` });
}

// Generate Torah links for Vol 2 (3-125)
const vol2Links = [];
for (let i = 3; i <= 125; i++) {
  vol2Links.push({ num: i, url: `/teachings/likutay-moharan-volume-2-torah-${i}` });
}
---

<style>
  .page-header {
    background: #1a365d;
    color: white;
    padding: 2rem;
    text-align: center;
  }
  .page-header h1 {
    font-family: var(--font-hebrew);
    font-size: 1.8rem;
    margin: 0;
  }
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  .section { margin-bottom: 2.5rem; }
  .section h2 {
    font-family: var(--font-hebrew);
    color: #1a365d;
    font-size: 1.3rem;
    border-bottom: 2px solid #ed8936;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .quick-nav a {
    padding: 0.4rem 0.8rem;
    background: #f7f5f0;
    color: #1a365d;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
  }
  .quick-nav a:hover {
    background: #ed8936;
    color: white;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 0.4rem;
  }
  .link-grid a, .link-grid span {
    display: block;
    padding: 0.4rem 0.6rem;
    background: #f7f5f0;
    color: #1a365d;
    text-decoration: none;
    border-radius: 4px;
    text-align: center;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .link-grid a:hover {
    background: #ed8936;
    color: white;
  }
  .link-grid span {
    background: #dbeafe;
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }
  .nav-links a {
    color: #1a365d;
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #f7f5f0;
    border-radius: 4px;
  }
  .nav-links a:hover {
    background: #1a365d;
    color: white;
  }
  .missing {
    background: #fee2e2 !important;
    color: #991b1b;
  }
</style>

