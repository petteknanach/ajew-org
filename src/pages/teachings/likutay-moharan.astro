  { title: "Torahs 23-31 on Suvay Divay Atuna - The Debate With the Elders of House of Atuna", items: [] },
  { title: "Torahs 32 to the End", items: [] }
];

let vol1HTML = '';

vol1Sections.forEach((section) => {
  vol1HTML += `<div style="margin-bottom: 1.5rem;">
    <h3 style="color: #1a365d; font-size: 1.1rem; margin: 0 0 0.75rem 0; padding-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0;">${section.title}</h3>`;
  
  if (section.items && section.items.length > 0) {
    vol1HTML += `<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">`;
    section.items.forEach(item => {
      vol1HTML += `<a href="${item.url}" style="padding: 0.5rem 1rem; background: #ecfdf5; color: #059669; border-radius: 6px; text-decoration: none; font-size: 0.85rem;">${item.text}</a>`;
    });
    vol1HTML += `</div>`;
  }
  
  // Generate Torah links for this section
  let start = 1, end = 15;
  if (section.title.includes("16-18")) { start = 16; end = 18; }
  else if (section.title.includes("19-22")) { start = 19; end = 22; }
  else if (section.title.includes("23-31")) { start = 23; end = 31; }
  else if (section.title.includes("32")) { start = 32; end = 286; }
  else if (section.title === "Introduction") { start = 0; end = 0; } // Skip numeric links
  
  if (start > 0) {
    vol1HTML += `<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(65px, 1fr)); gap: 0.4rem;">`;
    for (let i = start; i <= end; i++) {
      vol1HTML += `<a href="/teachings/likutay-moharan-volume-1-torah-${i}" style="display: block; padding: 0.5rem; text-align: center; background: #f7fafc; border-radius: 6px; color: #1a365d; text-decoration: none; font-weight: 500; font-size: 0.85rem; transition: all 0.2s;">${i}</a>`;
    }
    vol1HTML += `</div>`;
  }
  
  vol1HTML += `</div>`;
});

// Generate Volume 2 links - internal pages first
let vol2InternalHTML = '<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(65px, 1fr)); gap: 0.4rem;">';
for (let i = 1; i <= 125; i++) {
