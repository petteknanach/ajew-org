---
import Layout from '../../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const pncDir = path.join(process.cwd(), 'public/reader/pettek-nanach-commentary');
  const parts = new Set(['1']); // Always include part 1

  if (fs.existsSync(pncDir)) {
    const tinyanaFiles = fs.readdirSync(pncDir).filter(f => /^tinyana-\d+\.json$/.test(f));
    if (tinyanaFiles.length > 0) parts.add('2');
  }

  return Array.from(parts).map(p => ({ params: { part: p } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);
const pncDir = path.join(process.cwd(), 'public/reader/pettek-nanach-commentary');

// Read all available files dynamically
const partTorahs = [];
const filePrefix = partNum === 2 ? 'tinyana' : 'torah';
const regex = new RegExp(`^${filePrefix}-(\\d+)\\.json$`);

if (fs.existsSync(pncDir)) {
  const files = fs.readdirSync(pncDir).filter(f => regex.test(f));
  for (const f of files) {
    const num = parseInt(f.match(regex)[1]);
    try {
      const data = JSON.parse(fs.readFileSync(path.join(pncDir, f), 'utf8'));
      partTorahs.push({
        number: num,
        title: data.title || `Torah ${num}`,
        hebrewTitle: data.hebrewTitle || '',
        url: `/reader/pettek-nanach-commentary/${partNum}/${num}`,
      });
    } catch (e) {}
  }
}

// Also load intro/front matter sections (non-numbered JSON files)
const introSections = [];
if (fs.existsSync(pncDir) && partNum === 1) {
  const allFiles = fs.readdirSync(pncDir);
  const introFiles = allFiles.filter(f =>
    f.endsWith('.json') &&
    f !== 'index.json' &&
    !/^torah-\d+\.json$/.test(f) &&
    !/^tinyana-\d+\.json$/.test(f)
  );
  for (const f of introFiles) {
    const slug = f.replace('.json', '');
    try {
      const data = JSON.parse(fs.readFileSync(path.join(pncDir, f), 'utf8'));
      introSections.push({
        slug,
        title: data.title || slug,
        hebrewTitle: data.hebrewTitle || '',
        url: `/reader/pettek-nanach-commentary/1/${slug}`,
      });
    } catch (e) {}
  }
}

// Sort by number
partTorahs.sort((a, b) => a.number - b.number);

const count = partTorahs.length;
const maxNum = partTorahs.length > 0 ? Math.max(...partTorahs.map(t => t.number)) : 0;
const minNum = partTorahs.length > 0 ? Math.min(...partTorahs.map(t => t.number)) : 1;

const partTitle = partNum === 2
  ? `Part 2 (Tinyana 1-${maxNum})`
  : `Part 1 (Torahs ${minNum}-${maxNum})`;
const partHebrew = partNum === 2
  ? `חלק ב (תנינא א-${maxNum})`
  : `חלק א (תורות א-${maxNum})`;

// Check which parts exist for the nav
const allLocalFiles = fs.existsSync(pncDir) ? fs.readdirSync(pncDir) : [];
const hasPart2 = allLocalFiles.some(f => /^tinyana-\d+\.json$/.test(f));
const part1Max = allLocalFiles.filter(f => /^torah-\d+\.json$/.test(f)).map(f => parseInt(f.match(/^torah-(\d+)\.json/)[1])).reduce((a, b) => Math.max(a, b), 0);
const part2Max = allLocalFiles.filter(f => /^tinyana-\d+\.json$/.test(f)).map(f => parseInt(f.match(/^tinyana-(\d+)\.json/)[1])).reduce((a, b) => Math.max(a, b), 0);
---

<Layout title={`Petek Nanach Commentary — ${partTitle}`}>
  <div style="max-width: 900px; margin: 0 auto; padding: 40px 20px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 style="font-family: 'Cinzel', serif; font-size: 2em; color: #1e3a5f;">Petek Nanach Commentary</h1>
      <p style="font-family: 'Noto Serif Hebrew', serif; font-size: 1.2em; color: #6b5a42; direction: rtl;">פירוש פתק נ נח</p>
      <p style="color: #888; margin-top: 8px;">{partTitle} — {partHebrew}</p>
    </div>

    <div style="text-align: center; margin-bottom: 32px;">
      <a href="/reader/pettek-nanach-commentary/1" style="display: inline-block; padding: 10px 24px; margin: 4px; border-radius: 6px; text-decoration: none; font-weight: 600; {partNum === 1 ? 'background: #1e3a5f; color: #fff;' : 'background: #f0ebe0; color: #1e3a5f;'}">Part 1: Torahs 1-{part1Max || '...'}</a>
      {hasPart2 && (
        <a href="/reader/pettek-nanach-commentary/2" style="display: inline-block; padding: 10px 24px; margin: 4px; border-radius: 6px; text-decoration: none; font-weight: 600; {partNum === 2 ? 'background: #1e3a5f; color: #fff;' : 'background: #f0ebe0; color: #1e3a5f;'}">Part 2: Tinyana 1-{part2Max || '...'}</a>
      )}
    </div>

    {introSections.length > 0 && (
      <div style="margin-bottom: 24px;">
        <h2 style="font-family: 'Cinzel', serif; font-size: 1.3em; color: #1e3a5f; margin-bottom: 12px; border-bottom: 2px solid #a07830; padding-bottom: 8px;">
          Front Matter / הקדמות
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 8px;">
          {introSections.map(s => (
            <a href={s.url} style="display: block; padding: 12px 14px; background: #fdf8ec; border-radius: 6px; text-decoration: none; border-right: 3px solid #d4a017;">
              <span style="color: #1e3a5f; font-weight: 600; font-size: 0.9em;">{s.hebrewTitle || s.title}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {partTorahs.length > 0 && (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;">
        {partTorahs.map(t => (
          <a href={t.url} style="display: block; padding: 10px 14px; background: #f8f5f0; border-radius: 6px; text-decoration: none; border-right: 3px solid #a07830;">
            <span style="color: #1e3a5f; font-weight: 600; font-size: 0.9em;">{t.hebrewTitle || t.title}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
