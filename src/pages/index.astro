      </a>
      <a href="/gematria" class="tool">
        <span class="tool-icon">🔢</span>
        <div><span class="tool-label">Gematria</span><span class="tool-he" lang="he" dir="rtl">גימטריה</span></div>
      </a>
      <a href="/parsha" class="tool">
        <span class="tool-icon">📜</span>
        <div><span class="tool-label">Parsha</span><span class="tool-he" lang="he" dir="rtl">פרשת שבוע</span></div>
