            hideMedia.classList.toggle('active', hidden);
            return;
          }
          var exit = event.target && event.target.closest && event.target.closest('#reader-focus-exit');
          if (exit) {
            event.preventDefault();
            setFocusMode(false);
          }
        });
        })();
