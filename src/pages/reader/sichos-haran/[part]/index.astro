---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() { return [{ params: { part: '1' } }]; }
const { part } = Astro.params;
const partNum = parseInt(part || '1');
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/sichos-haran/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) { console.error('Error loading sichos-haran index:', e); }
const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || 'Sichos Haran'} — Directory`} description={`Directory for ${indexData?.title || 'Sichos Haran'}.`}>
  <aside data-reviewed-sichos-entry style="max-width:72rem;margin:1rem auto;padding:1rem;border:1px solid currentColor;border-radius:8px">
    <p>Qualified bilingual alignment is available for Sichos 92 and 209. These are bounded editorial repairs, not a complete-book approval; the older edition remains unchanged.</p>
    <a href="/reader/reviewed/wrapup-18-19-92-209/#group-sichos92">Read qualified Sicha 92</a> · <a href="/reader/reviewed/wrapup-18-19-92-209/#group-sichos209">Read qualified Sicha 209</a>
  </aside>
  <aside data-sichos-five-entry style="max-width:72rem;margin:1rem auto;padding:1rem;border:1px solid currentColor;border-radius:8px">
    <p>Corrected English is available for five paragraphs from teachings 224, 225, 229 and 230, with the supplied Hebrew and source notes. The other paragraphs and the earlier edition are unchanged.</p>
    <a href="/reader/reviewed/sichos-224-225-229-230/">Read the five corrected paragraphs</a>
  </aside>
  <aside data-sichos-221230-entry style="max-width:72rem;margin:1rem auto;padding:1rem;border:1px solid currentColor;border-radius:8px">
    <p>A separate bilingual edition contains 38 reviewed paragraphs from teachings 221–230, with complete source notes. Paragraph 3 of teaching 221 is not included. The earlier edition remains unchanged.</p>
    <a href="/reader/reviewed/sichos-221-230/">Read the reviewed paragraphs from teachings 221–230</a>
  </aside>
  <aside data-sichos-231240-entry style="max-width:72rem;margin:1rem auto;padding:1rem;border:1px solid currentColor;border-radius:8px">
    <p>A separate bilingual edition contains all 52 paragraphs from teachings 231–240, with source notes and clearly labelled earlier English and comparison history. The earlier edition remains unchanged.</p>
    <a href="/reader/reviewed/sichos-231-240/">Read the reviewed paragraphs from teachings 231–240</a>
  </aside>
  <ReaderDirectory
    title={indexData?.title || 'Sichos Haran'}
    hebrewTitle={indexData?.hebrewTitle || ''}
    subtitle={indexData?.author || ''}
    countLabel={`${totalSections} entries`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/sichos-haran/${partNum}/`}
  />
</Layout>
