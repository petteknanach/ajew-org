  .nav-btn:hover &lbrace; background: rgba(255,255,255,0.2); &rbrace;
  @media (max-width: 768px) &lbrace;
    .nav-buttons &lbrace; flex-direction: column; &rbrace;
    .gallery-grid &lbrace; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); &rbrace;
    .index-links &lbrace; gap: 0.5rem; &rbrace;
    .index-link &lbrace; padding: 0.5rem 0.75rem; font-size: 0.8rem; &rbrace;
  &rbrace;
