---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/siach-sarfei-kodesh/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/siach-sarfei-kodesh/part-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) { console.error(e); }

const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || "Siach Sarfei Kodesh"} — Part ${partNum} Index`} description={`Beautiful directory for Siach Sarfei Kodesh, part ${partNum}.`}>
  <ReaderDirectory
    title="Siach Sarfei Kodesh"
    hebrewTitle="שיח שרפי קודש"
    subtitle={`Collected Breslov conversations and holy memories · Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/siach-sarfei-kodesh/${partNum}/`}
  />
</Layout>
