    font-family: var(--font-hebrew);
  &rbrace;

  .book-content :global(p) &lbrace;
    font-size: 1.1rem;
    line-height: 1.8;
    margin: 0 0 1rem 0;
    text-align: justify;
    color: #2d3748;
  &rbrace;

  .book-content :global(br) &lbrace;
    display: block;
    content: "";
    margin: 0.5rem 0;
  &rbrace;

  .book-content :global(div) &lbrace;
    padding: 15px;
    margin: 30px;
    border: 2px solid #ccc;
    background-color: #fafafa;
  &rbrace;

  .book-content :global(b), 
