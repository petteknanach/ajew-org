---
import Layout from '../../../../layouts/Layout.astro';
import {loadEdition} from '../../../../lib/qualified-aitzoas362.mjs';
import {topicStructure} from '../../../../../public/qualified-aitzoas-topics.mjs';
import fs from 'node:fs';
import path from 'node:path';
export function getStaticPaths(){return [{params:{part:'1'}}];}
const edition=await loadEdition(),structure=topicStructure(edition);
const index=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/reader/aitzoas-yeshuroas/index.json'),'utf8'));
---
<Layout title={`${index.bookTitle} — Contents`} description="Read the complete book in Hebrew and English, arranged by its original topics.">
 <div class="aitzoas-directory">
  <h1>{index.bookHebrew} — {index.bookTitle}</h1><p>{index.author}</p>
  <a href={structure.apparatus[0].url}>פתיחה — Introduction</a>
  <h2>Contents</h2>
  <ol class="topic-directory">{structure.topics.map(t=><li><a class="topic-link" href={t.url}><span lang="he" dir="rtl">{t.hebrewTitle}</span> — {t.title}</a> <small>{t.teachingCount} teachings</small></li>)}</ol>
  <p><a href={structure.apparatus[1].url}>סיום — Closing</a></p>
  <a href="/reader">All Books</a>
 </div>
</Layout>
<style>.aitzoas-directory{max-width:62rem;margin:auto;padding:1.5rem;line-height:1.8}.topic-directory{columns:2;column-width:22rem;column-gap:3rem}.topic-directory li{break-inside:avoid;margin-bottom:.75rem}.aitzoas-directory .topic-link{display:block;max-width:100%;white-space:normal;overflow-wrap:anywhere;font-weight:600}small{display:block}a:focus-visible{outline:2px solid currentColor;outline-offset:3px}</style>
