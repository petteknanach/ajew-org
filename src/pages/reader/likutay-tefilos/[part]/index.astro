---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return [
    { params: { part: '1' } },
    { params: { part: '2' } },
  ];
}

const { part } = Astro.params;
const partNum = parseInt(part);

// Load index data
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), `public/reader/likutay-tefilos/part-${partNum}/index.json`);
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const partTitle = partNum === 1 ? 'Chelek Rishon (Part 1)' : 'Chelek Sheni (Part 2)';
const partHebrew = partNum === 1 ? 'חלק ראשון' : 'חלק שני';
const totalPrayers = indexData?.torahs?.length || 0;

// Load TOC topics for this part
let tocTopics = [];
try {
  const tocPath = path.join(process.cwd(), 'public/reader/likutay-tefilos/toc-topics.json');
  const tocData = JSON.parse(fs.readFileSync(tocPath, 'utf8'));
  tocTopics = tocData.topics.filter(t => 
    (partNum === 1 && t.part1_prayers.length > 0) || 
    (partNum === 2 && t.part2_prayers.length > 0)
  );
} catch (e) {}
---
<Layout title={`Likutay Tefilos — ${partTitle} Index`} description={`Complete index of Likutay Tefilos ${partTitle}. ${totalPrayers} prayers with Hebrew text and English translation.`}>
  <ReaderDirectory
    title="Likutay Tefilos"
    hebrewTitle="ליקוטי תפילות"
    subtitle={`Rabbi Nosson’s prayers from Rebbe Nachman’s teachings · ${partTitle}`}
    countLabel={`${totalPrayers} prayers`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/likutay-tefilos/${partNum}/`}
    itemKind="prayers"
  />
  <div style="max-width:1180px; margin:-58px auto 70px; padding:0 18px;">
    <div style="text-align:center; margin-bottom:26px;">
      <a href="/reader/likutay-tefilos/special" style="display:inline-block; padding:12px 20px; background:linear-gradient(135deg,#173b67,#27598f); color:#ffe9b3; border-radius:999px; text-decoration:none; font-weight:900; box-shadow:0 14px 32px rgba(23,59,103,.20);">✨ Special Prayers for Every Need & Occasion →</a>
    </div>
    {tocTopics.length > 0 && (
      <section class="tefila-topics">
        <h2>Browse by Topic</h2>
        <div class="topic-grid">
          {tocTopics.map(topic => {
            const prayers = partNum === 1 ? topic.part1_prayers : topic.part2_prayers;
            if (prayers.length === 0) return null;
            const firstPrayer = prayers[0];
            return (
              <a href={`/reader/likutay-tefilos/${partNum}/${firstPrayer}`}>
                <strong dir="rtl" lang="he">{topic.topic}</strong>
                {topic.english && <span>{topic.english}</span>}
                <small>Prayers: {prayers.slice(0, 8).join(', ')}{prayers.length > 8 ? '…' : ''}</small>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .tefila-topics { padding:24px; border-radius:26px; border:1px solid rgba(196,162,101,.35); background:linear-gradient(145deg,#fffdf8,#f4ead6); box-shadow:0 18px 50px rgba(26,54,93,.10); }
  .tefila-topics h2 { margin:0 0 18px; color:#14345d; font-family:'Cinzel', Georgia, serif; }
  .topic-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px; }
  .topic-grid a { display:block; padding:15px 16px; border-radius:17px; background:rgba(255,255,255,.72); border:1px solid rgba(196,162,101,.32); text-decoration:none; box-shadow:0 6px 18px rgba(26,54,93,.06); }
  .topic-grid strong { display:block; color:#725426; font-family:'Frank Ruhl Libre', serif; font-size:1.15rem; }
  .topic-grid span { display:block; color:#15375e; font-weight:800; margin-top:3px; }
  .topic-grid small { display:block; color:#907b58; margin-top:7px; }
</style>
