  &rbrace;

  body &lbrace;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  &rbrace;

  main &lbrace;
    flex: 1;
  &rbrace;

  .navbar &lbrace;
    background: var(--color-primary);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
  &rbrace;

  .nav-container &lbrace;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  &rbrace;

  .logo &lbrace;
    text-decoration: none;
  &rbrace;

  .logo-text &lbrace;
    font-family: var(--font-hebrew);
