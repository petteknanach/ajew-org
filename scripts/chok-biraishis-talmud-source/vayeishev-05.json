        }
      ],
      "sha256": "d80e79f27699021d019fabe39aaab6a1d5bb6db251088837b1337070cfacca2d",
      "body": "גמ' יכול יחלוץ - מצוה מוטלת עליו:"
    },
    {
      "ref": "Rashi on Zevachim 86a:2:1",
      "pointer": "/text/170/1/0",
      "included": [
        {
          "cp": [
            0,
            38
          ],
          "utf8SHA256": "2a6d4b002022587ffa3afa0b1d7ffa6fd56ad0cf2802d24e674ded6a4b976806"
        }
      ],
      "sha256": "2a6d4b002022587ffa3afa0b1d7ffa6fd56ad0cf2802d24e674ded6a4b976806",
      "body": "מאן שמעת ליה כו' - ומתני' אליביה אתיא:"
    },
    {
      "ref": "Rashi on Zevachim 86a:5:1",
      "pointer": "/text/170/4/0",
      "included": [
        {
          "cp": [
            0,
            39
          ],
          "utf8SHA256": "3658c9a6052637cb7cb5b029ac21bb5174a4863812bd70be9ccd6c8c23388646"
        }
      ],
      "sha256": "3658c9a6052637cb7cb5b029ac21bb5174a4863812bd70be9ccd6c8c23388646",
      "body": "כלפי מטה - דרך ירידה ומתרחקי מן המערכה:"
    },
    {
      "ref": "Rashi on Zevachim 86a:5:2",
      "pointer": "/text/170/4/1",
      "included": [
        {
          "cp": [
            0,
            64
          ],
          "utf8SHA256": "cb824a42dfe452b5dcd07ade16736478657523c87a70f42950b4b906e4d5299f"
        }
      ],
      "sha256": "cb824a42dfe452b5dcd07ade16736478657523c87a70f42950b4b906e4d5299f",
      "body": "כלפי מעלה - לצד המערכה אין זו פרישות אלא קריבה אצל העיכול של אש:"
    },
    {
      "ref": "Rashi on Zevachim 86a:5:3",
      "pointer": "/text/170/4/2",
      "included": [
        {
          "cp": [
            0,
            100
          ],
          "utf8SHA256": "38dfede9ab0c8b74e00a3c9ed977a3a26518a86f08a3b9040add2b95778cc7c0"
        }
      ],
      "sha256": "38dfede9ab0c8b74e00a3c9ed977a3a26518a86f08a3b9040add2b95778cc7c0",
      "body": "ואפי' פירשו - נראה בעיני שחסר מן הגירסא ולמאי דגרס ה\"פ ואפי' פירשו בתמיה והא מחוברין יעלו הוא דקאמר:"
    },
    {
      "ref": "Rashi on Zevachim 86a:6:1",
      "pointer": "/text/170/5/0",
      "included": [
        {
          "cp": [
            0,
            152
          ],
          "utf8SHA256": "1b18831f73adaaefb5034f9e0181c9c8a49a78ca0f06d22ee5af76f600f1e493"
        }
      ],
      "sha256": "1b18831f73adaaefb5034f9e0181c9c8a49a78ca0f06d22ee5af76f600f1e493",
      "body": "לא שנו - דקאמר פירשו ירדו ומיהו איתנהו בכלל קדשים אלא שפירשו לאחר זריקה דכיון דבשעת זריקה מחוברים הוו קובעתן זריקה למזבח וכי פירשו הוו להו קדשים פסולין:"
    },
    {
      "ref": "Rashi on Zevachim 86a:6:2",
      "pointer": "/text/170/5/1",
      "included": [
        {
          "cp": [
            0,
            81
          ],
          "utf8SHA256": "eae66a2f6802e1c49ede760586fd055ca8fbac3850a779bdf09bc0a708987e2e"
        }
      ],
      "sha256": "eae66a2f6802e1c49ede760586fd055ca8fbac3850a779bdf09bc0a708987e2e",
      "body": "אבל פירשו לפני זריקה - דבשעת זריקה לאו בני מזבח היו אתאי זריקה ושריתינהו להדיוט: "
    },
    {
      "ref": "Rashi on Zevachim 86a:6:3",
      "pointer": "/text/170/5/2",
      "included": [
        {
          "cp": [
            0,
            117
          ],
          "utf8SHA256": "593ac79e7af24065a2cfcd000230d3a6fa8f4d0bf7b20fcc08bbd0d68a1b454c"
        }
      ],
      "sha256": "593ac79e7af24065a2cfcd000230d3a6fa8f4d0bf7b20fcc08bbd0d68a1b454c",
      "body": "למיעבד קתא דסכיני - כי היכי דשריא בשר לגבי מזבח דלהכי קאי קשריא נמי עצמות למאי דקיימי והיינו הנאת כהנים כרבי ישמעאל: "
    },
    {
      "ref": "Rashi on Zevachim 86a:7:1",
      "pointer": "/text/170/6/0",
      "included": [
        {
          "cp": [
            0,
            112
          ],
          "utf8SHA256": "69eb6bc155b69f03947075a6f73bc4d8c4d97ac763059770a6ac4f0f266047ac"
        }
      ],
      "sha256": "69eb6bc155b69f03947075a6f73bc4d8c4d97ac763059770a6ac4f0f266047ac",
      "body": "לו יהיה בעולה - עור העולה אשר הקריב לכהן לו יהיה ונאמר לו יהיה באשם כחטאת כאשם תורה אחת להם הכהן [וגו'] לו יהיה:"
    },
    {
      "ref": "Rashi on Zevachim 86a:7:3",
      "pointer": "/text/170/6/2",
      "included": [
        {
          "cp": [
            0,
            72
          ],
          "utf8SHA256": "7669f6c800374a2a90195c20cdb99f4de4da8d91c814c79d1e6df8794fbec7d4"
        }
      ],
      "sha256": "7669f6c800374a2a90195c20cdb99f4de4da8d91c814c79d1e6df8794fbec7d4",
      "body": "לו יהיה - יתירא הוא דמצי למיכתב עור העולה אשר הקריב לכהן לו יהיה למה לי:"
    },
    {
      "ref": "Rashi on Zevachim 86a:7:2",
      "pointer": "/text/170/6/1",
      "included": [
        {
          "cp": [
            0,
            141
          ],
          "utf8SHA256": "e2d1cd7ab35d32181dafb6faf6c2f235a24f56d72160f0b95f21906fae491ec4"
        }
      ],
      "sha256": "e2d1cd7ab35d32181dafb6faf6c2f235a24f56d72160f0b95f21906fae491ec4",
      "body": "מה אשם עצמותיו מותרין - שהרי אף בשרו מותר ואי משום נותר דבשריפה לא שייך נותר אלא במידי דבר אכילה כדכתיב (ויקרא ז׳:י״ז) והנותר מבשר הזבח וגו':"
    }
  ],
