        }
      ],
      "sha256": "aad715dafd62b896e8e4e70fa90aed13c68c678e01d5d81df148d0eebf107153",
      "body": "וכתמים דרבנן - אפי' מכאן ולהבא:"
    },
    {
      "ref": "Rashi on Niddah 15a:14:1",
      "pointer": "/text/28/13/0",
      "included": [
        {
