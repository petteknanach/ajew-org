    --font-body: 'Open Sans', sans-serif;
  &rbrace;

  * &lbrace;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  &rbrace;

  html &lbrace;
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
