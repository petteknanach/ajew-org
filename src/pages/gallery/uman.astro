import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const imageDir = './public/images/tomb-uman/';

function getAllImages() &lbrace;
  try &lbrace;
    const files = fs.readdirSync(imageDir);
    return files.filter(file => 
      /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(file) &&
      !file.startsWith('.'))
    .sort();
  &rbrace; catch (e) &lbrace; return []; &rbrace;
&rbrace;

const allImages = getAllImages();

function formatFilename(filename) &lbrace;
  let formatted = decodeURIComponent(filename);
  formatted = formatted.replace(/\.(jpg|jpeg|png|gif|webp|svg)$/i, '');
  formatted = formatted.replace(/[-_]/g, ' ');
  formatted = formatted.replace(/\b\w/g, l => l.toUpperCase());
  return formatted;
&rbrace;

const tzion = allImages.filter(img => img.includes('tzion') || img.includes('Tzion'));
const tomb = allImages.filter(img => img.includes('tomb') || img.includes('temple'));
const davening = allImages.filter(img => img.includes('davening') || img.includes('kittels'));
const masses = allImages.filter(img => 
  img.includes('masses') || img.includes('people') || img.includes('crowd'));
const buildings = allImages.filter(img =>
  img.includes('gate') || img.includes('gateway') || img.includes('house') ||
  img.includes('heichal') || img.includes('hut'));
const views = allImages.filter(img =>
  img.includes('high') || img.includes('wide') || img.includes('top') ||
  img.includes('bottom') || img.includes('blue') || img.includes('rocks'));

const categorized = new Set([...tzion, ...tomb, ...davening, ...masses, ...buildings, ...views]);
const other = allImages.filter(img => !categorized.has(img));
-

<Layout title="Tomb in Uman Gallery" description="Photos of the Holy Tomb of Rabbi Nachman in Uman">
  <section class="page-header">
    <h1>The Holy Tomb in Uman</h1>
    <p>The Sacred Tzion of Rabbi Nachman of Breslov</p>
    <p class="hebrew">ציון רבינו נחמן באומן</p>
    <p class="stats">&lbrace;allImages.length&rbrace; photos</p>
    <a href="/gallery" class="back-link">← Back to Gallery</a>
  </section>

  <section class="intro">
    <div class="container">
      <div class="info-box">
        <h2>Rosh Hashanah in Uman</h2>
        <p>Every year, tens of thousands of Jews from around the world gather at the Holy Tomb of Rabbi Nachman in Uman for Rosh Hashanah.</p>
        <p class="hebrew">אלפי יהודים מכל העולם מתאספים בציון הקדוש באומן לראש השנה</p>
      </div>
      <div class="quick-index">
        <h3>Quick Index</h3>
        <div class="index-links">
          &lbrace;tzion.length > 0 && <a href="#tzion" class="index-link"><span class="icon">🪦</span><span class="name">The Tzion</span><span class="count">&lbrace;tzion.length&rbrace;</span></a>&rbrace;
          &lbrace;tomb.length > 0 && <a href="#tomb" class="index-link"><span class="icon">🏛️</span><span class="name">Tomb & Temple</span><span class="count">&lbrace;tomb.length&rbrace;</span></a>&rbrace;
          &lbrace;davening.length > 0 && <a href="#davening" class="index-link"><span class="icon">🙏</span><span class="name">Davening</span><span class="count">&lbrace;davening.length&rbrace;</span></a>&rbrace;
          &lbrace;masses.length > 0 && <a href="#masses" class="index-link"><span class="icon">👥</span><span class="name">Masses & Crowds</span><span class="count">&lbrace;masses.length&rbrace;</span></a>&rbrace;
          &lbrace;buildings.length > 0 && <a href="#buildings" class="index-link"><span class="icon">🏛️</span><span class="name">Buildings & Gates</span><span class="count">&lbrace;buildings.length&rbrace;</span></a>&rbrace;
          &lbrace;views.length > 0 && <a href="#views" class="index-link"><span class="icon">📸</span><span class="name">Views</span><span class="count">&lbrace;views.length&rbrace;</span></a>&rbrace;
          &lbrace;other.length > 0 && <a href="#other" class="index-link"><span class="icon">📷</span><span class="name">Other</span><span class="count">&lbrace;other.length&rbrace;</span></a>&rbrace;
        </div>
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="container">
      &lbrace;tzion.length > 0 && (
        <div id="tzion" class="category-section">
          <h2><span class="icon">🪦</span> The Holy Tzion <span class="hebrew">(הציון הקדוש)</span></h2>
          <div class="gallery-grid">
            &lbrace;tzion.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;tomb.length > 0 && (
        <div id="tomb" class="category-section">
          <h2><span class="icon">🏛️</span> Tomb & Temple <span class="hebrew">(קבר והיכל)</span></h2>
          <div class="gallery-grid">
            &lbrace;tomb.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;davening.length > 0 && (
        <div id="davening" class="category-section">
          <h2><span class="icon">🙏</span> Davening & Prayers <span class="hebrew">(דאוונינג ותפילות)</span></h2>
          <div class="gallery-grid">
            &lbrace;davening.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;masses.length > 0 && (
        <div id="masses" class="category-section">
          <h2><span class="icon">👥</span> Masses & Crowds <span class="hebrew">(המונים וקהל)</span></h2>
          <div class="gallery-grid">
            &lbrace;masses.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;buildings.length > 0 && (
        <div id="buildings" class="category-section">
          <h2><span class="icon">🏛️</span> Buildings & Gates <span class="hebrew">(מבנים ושערים)</span></h2>
          <div class="gallery-grid">
            &lbrace;buildings.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;views.length > 0 && (
        <div id="views" class="category-section">
          <h2><span class="icon">📸</span> Views & Perspectives <span class="hebrew">(נופים ומבטים)</span></h2>
          <div class="gallery-grid">
            &lbrace;views.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;other.length > 0 && (
        <div id="other" class="category-section">
          <h2><span class="icon">📷</span> Other Photos <span class="hebrew">(תמונות אחרות)</span></h2>
          <div class="gallery-grid">
            &lbrace;other.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/tomb-uman/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
    </div>
  </section>

  <section class="navigation">
    <div class="container">
      <div class="nav-buttons">
        <a href="/gallery/rabbainu" class="nav-btn">← Rabbi Nachman</a>
        <a href="/gallery/nanach" class="nav-btn">Na Nach Life →</a>
      </div>
    </div>
  </section>
</Layout>

