</style>

<script is:inline>
  const searchInput = document.getElementById('library-search');
  const authorSections = document.querySelectorAll('.author-section');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-search');

  // Search
  searchInput.addEventListener('input', function() {
    const q = this.value.trim().toLowerCase();
    let anyVisible = false;

    authorSections.forEach(function(section) {
      let sectionHasVisible = false;
      const bookGroups = section.querySelectorAll('.book-group');

      bookGroups.forEach(function(group) {
        const cards = group.querySelectorAll('.file-card');
        let groupHasVisible = false;

        cards.forEach(function(card) {
          const name = card.dataset.name || '';
          const match = !q || name.includes(q);
          card.classList.toggle('hidden', !match);
          if (match) groupHasVisible = true;
        });

        group.classList.toggle('hidden', !groupHasVisible);
        if (groupHasVisible) sectionHasVisible = true;
      });

      section.classList.toggle('hidden', !sectionHasVisible);
      if (sectionHasVisible) anyVisible = true;
    });

    noResults.style.display = anyVisible ? 'none' : 'block';
  });

  // Clear search
  clearBtn.addEventListener('click', function() {
    searchInput.value = '';
    searchInput.dispatchEvent(new Event('input'));
    searchInput.focus();
  });

  // Smooth scroll for nav chips
  document.querySelectorAll('.author-chip').forEach(function(chip) {
    chip.addEventListener('click', function(e) {
      e.preventDefault();
      var target = document.querySelector(chip.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Highlight active nav chip on scroll
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var id = entry.target.id;
        document.querySelectorAll('.author-chip').forEach(function(chip) {
          chip.classList.toggle('active', chip.getAttribute('href') === '#' + id);
        });
      }
    });
  }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

  authorSections.forEach(function(section) {
    observer.observe(section);
  });
</script>
</Layout>
