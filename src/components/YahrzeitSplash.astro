// Yahrzeit Splash Component - To be embedded on ajew.org homepage
import { useState, useEffect } from 'react';

// Client-side React component for dynamic updates
const YahrzeitDisplay = () => {
  const [todayTzaddikim, setTodayTzaddikim] = useState([]);
  const [tomorrowTzaddikim, setTomorrowTzaddikim] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    fetchYahrzeits();
    
    // Refresh every hour to catch date changes
    const interval = setInterval(fetchYahrzeits, 3600000);
    return () => clearInterval(interval);
  }, []);

  const fetchYahrzeits = async () => {
    try {
      setLoading(true);
      
      // Fetch from API endpoint
      const response = await fetch('/api/yahrzeit/notifications');
      if (!response.ok) {
        throw new Error('Failed to fetch yahrzeits');
      }
      
      const data = await response.json();
      setTodayTzaddikim(data.today || []);
      setTomorrowTzaddikim(data.tomorrow || []);
      setError(null);
    } catch (err) {
      console.error('Error fetching yahrzeits:', err);
      setError('Unable to load yahrzeit notifications');
      // Fallback to static data
      fetchStaticData();
    } finally {
      setLoading(false);
    }
  };

  const fetchStaticData = async () => {
    try {
      const response = await fetch('/data/tzaddikim-database.json');
      const data = await response.json();
      
      // Simple fallback: show first 3 tzaddikim
      setTodayTzaddikim(data.all_tzaddikim.slice(0, 3));
      setTomorrowTzaddikim(data.all_tzaddikim.slice(3, 6));
    } catch (err) {
      console.error('Error fetching static data:', err);
    }
  };

  const formatDate = (date) => {
    return new Date(date).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric'
    });
  };

  if (loading) {
    return (
      <div className="bg-white rounded-xl shadow-lg p-6">
        <div className="animate-pulse">
          <div className="h-6 bg-gray-200 rounded w-1/4 mb-4"></div>
          <div className="space-y-3">
            <div className="h-16 bg-gray-200 rounded"></div>
            <div className="h-16 bg-gray-200 rounded"></div>
          </div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-white rounded-xl shadow-lg p-6">
        <div className="text-center py-4">
          <p className="text-gray-500">{error}</p>
          <button 
            onClick={fetchYahrzeits}
            className="mt-2 px-4 py-2 text-sm bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition-colors"
          >
            Retry
          </button>
        </div>
      </div>
    );
  }

  const hasToday = todayTzaddikim.length > 0;
  const hasTomorrow = tomorrowTzaddikim.length > 0;

  if (!hasToday && !hasTomorrow) {
    return (
      <div className="bg-white rounded-xl shadow-lg p-6">
        <div className="text-center py-4">
          <p className="text-gray-500">No yahrzeits recorded for today or tomorrow.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="bg-white rounded-xl shadow-lg overflow-hidden">
      {/* Header */}
      <div className="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4">
        <div className="flex items-center justify-between">
          <div>
            <h2 className="text-xl font-bold text-white">Daily Yahrzeit Notifications</h2>
            <p className="text-blue-100 text-sm mt-1">
              Remembering the tzaddikim on their yahrzeit
            </p>
          </div>
          <div className="text-right">
            <div className="text-white text-sm">
              {formatDate(new Date())}
            </div>
            <a 
              href="/yahrzeit-notification" 
              className="text-blue-100 hover:text-white text-sm font-medium transition-colors"
            >
              View all →
            </a>
          </div>
        </div>
      </div>

      {/* Content */}
      <div className="p-6">
        {/* Today's Yahrzeits */}
        {hasToday && (
          <div className="mb-6">
            <div className="flex items-center mb-3">
              <div className="w-2 h-6 bg-blue-500 rounded-full mr-2"></div>
              <h3 className="font-semibold text-gray-800">Today's Yahrzeits</h3>
              <span className="ml-2 px-2 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded">
                Today
              </span>
            </div>
            
            <div className="space-y-3">
              {todayTzaddikim.slice(0, 3).map((tzaddik, index) => (
                <div key={index} className="flex items-center justify-between p-3 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors">
                  <div>
                    <a 
                      href={`/tzaddikim/${tzaddik.id}`}
                      className="font-medium text-gray-900 hover:text-blue-600 transition-colors"
                    >
                      {tzaddik.name}
                    </a>
                    {tzaddik.hebrew_name && (
                      <div className="text-sm text-gray-600 mt-1" dir="rtl">
                        {tzaddik.hebrew_name}
                      </div>
                    )}
                  </div>
                  <div className="text-right">
                    <div className="text-sm font-medium text-gray-700">
                      {tzaddik.yahrzeit_hebrew}
                    </div>
                    {tzaddik.year_passed && (
                      <div className="text-xs text-gray-500">
                        {tzaddik.year_passed}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Tomorrow's Yahrzeits */}
        {hasTomorrow && (
          <div>
            <div className="flex items-center mb-3">
              <div className="w-2 h-6 bg-purple-500 rounded-full mr-2"></div>
              <h3 className="font-semibold text-gray-800">Tomorrow's Yahrzeits</h3>
              <span className="ml-2 px-2 py-1 bg-purple-50 text-purple-700 text-xs font-medium rounded">
                Tomorrow
              </span>
            </div>
            
            <div className="space-y-3">
              {tomorrowTzaddikim.slice(0, 2).map((tzaddik, index) => (
                <div key={index} className="flex items-center justify-between p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors">
                  <div>
                    <a 
                      href={`/tzaddikim/${tzaddik.id}`}
                      className="font-medium text-gray-900 hover:text-purple-600 transition-colors"
                    >
                      {tzaddik.name}
                    </a>
                    {tzaddik.hebrew_name && (
                      <div className="text-sm text-gray-600 mt-1" dir="rtl">
                        {tzaddik.hebrew_name}
                      </div>
                    )}
                  </div>
                  <div className="text-right">
                    <div className="text-sm font-medium text-gray-700">
                      {tzaddik.yahrzeit_hebrew}
                    </div>
                    {tzaddik.year_passed && (
                      <div className="text-xs text-gray-500">
                        {tzaddik.year_passed}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Footer */}
        <div className="mt-6 pt-4 border-t border-gray-200">
          <div className="flex items-center justify-between text-sm text-gray-600">
            <div>
              <span className="font-medium">{todayTzaddikim.length + tomorrowTzaddikim.length}</span> tzaddikim remembered
            </div>
            <a 
              href="/tzaddikim"
              className="text-blue-600 hover:text-blue-800 font-medium transition-colors"
            >
              Browse complete database →
            </a>
          </div>
        </div>
      </div>
    </div>
  );
};
---

<!-- Server-side wrapper with client-side hydration -->
<div id="yahrzeit-splash">
  <YahrzeitDisplay client:load />
</div>

<style>
  #yahrzeit-splash {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  
  /* Smooth transitions */
  #yahrzeit-splash * {
    transition: background-color 0.2s ease, color 0.2s ease;
  }
</style>