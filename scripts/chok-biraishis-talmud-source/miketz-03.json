          ],
          "utf8SHA256": "268f2da7426fe9daf6fec7126ec9ee7962e071219eb04aca30ba648b54bcb374"
        }
      ],
      "sha256": "268f2da7426fe9daf6fec7126ec9ee7962e071219eb04aca30ba648b54bcb374",
      "body": "אחד גר ואחד עבד משוחרר - לקמן מפרש למאי הלכתא אקשינהו:"
    },
    {
      "ref": "Rashi on Yevamot 47b:4:2",
      "pointer": "/text/93/3/1",
      "included": [
        {
          "cp": [
            0,
