  .back-link &lbrace; display: inline-flex; align-items: center; gap: 0.5rem; color: white; text-decoration: none; padding: 0.75rem 1.5rem; background: rgba(255,255,255,0.1); border-radius: 8px; &rbrace;
  .back-link:hover &lbrace; background: rgba(255,255,255,0.2); &rbrace;
</style>

