---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const data = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public/library-catalog-categorized.json'), 'utf8'));
const { categories, totalFiles, totalSizeMB } = data;

// Author groupings with metadata
const authorGroups = [
  {
    id: 'rebbe-nachman',
    nameHe: 'רבינו נחמן מברסלב',
    nameEn: 'Rebbe Nachman of Breslov',
    accent: '#d4a853',
    categoryIds: ['likutay-moharan', 'sefer-hamidos', 'sipurey-maasiyos'],
  },
  {
    id: 'rabbi-nosson',
    nameHe: 'רבי נתן מברסלב',
    nameEn: 'Rabbi Nosson of Breslov',
    accent: '#6b8cae',
    categoryIds: ['likutay-halachos', 'likutay-tefilos', 'likutay-eitzos', 'chayey-moharan', 'shivchay-sichos', 'yemei-moharnat', 'alim-litrufa', 'otzar-hayirah'],
  },
  {
    id: 'rabbi-alter',
    nameHe: 'רבי אלתר מטפליק',
    nameEn: 'Rabbi Alter of Teplik',
    accent: '#8b7355',
    categoryIds: ['hashtatfchus-meshivas'],
  },
  {
    id: 'tcheryn',
    nameHe: 'הרב מטשערין ומפרשים',
    nameEn: 'Tcheryn & Commentaries',
    accent: '#7a6b8a',
    categoryIds: ['parparos-commentary'],
  },
  {
    id: 'rabbi-avraham',
    nameHe: 'רבי אברהם ב"ר נחמן',
    nameEn: 'Rabbi Avraham ben Nachman',
    accent: '#5a8a6b',
    categoryIds: ['kokhvei-or'],
  },
  {
    id: 'levi-yitzchak',
    nameHe: "ר' לוי יצחק בנדר",
    nameEn: "R' Levi Yitzchak Bender",
    accent: '#8a5a5a',
    categoryIds: ['siach-sarfei-kodesh'],
  },
  {
    id: 'petek-nanach',
    nameHe: 'הפתק הקדוש ונ נח',
    nameEn: 'The Holy Petek & Na Nach',
    accent: '#c47a32',
    categoryIds: ['ebay-hanachal'],
  },
  {
    id: 'tikkunim',
    nameHe: 'תיקונים ותפילות',
    nameEn: 'Tikkunim & Prayers',
    accent: '#4a7a8a',
    categoryIds: ['tikkun-tefila'],
  },
  {
    id: 'letters',
    nameHe: 'מכתבים וכתבי יד',
    nameEn: 'Letters & Manuscripts',
    accent: '#6b6b4a',
    categoryIds: ['letters-manuscripts'],
  },
  {
    id: 'history',
    nameHe: 'תולדות והיסטוריה',
    nameEn: 'Biography & History',
    accent: '#5a6b8a',
    categoryIds: ['biography-history'],
  },
  {
    id: 'pamphlets-other',
    nameHe: 'קונטרסים וספרים שונים',
    nameEn: 'Pamphlets & Other Books',
    accent: '#7a7a6a',
    categoryIds: ['pamphlets', 'miscellaneous'],
  },
];

// Reader cross-links: category ID -> reader URL
const readerLinks: Record<string, string> = {
  'likutay-moharan': '/reader/likutay-moharan/part-1/1',
  'sefer-hamidos': '/reader/sefer-hamidos/part-1/1',
  'sipurey-maasiyos': '/reader/sipurey-maasiyos/part-1/1',
  'likutay-halachos': '/reader/likutay-halachos/vol-1/1',
  'likutay-tefilos': '/reader/likutay-tefilos/part-1/1',
  'likutay-eitzos': '/reader/likutay-eitzos/part-1/1',
  'chayey-moharan': '/reader/chayey-moharan/part-1/1',
  'shivchay-sichos': '/reader/shivchay-haran/part-1/1',
  'yemei-moharnat': '/reader/yemei-moharnat/part-1/1',
  'alim-litrufa': '/reader/alim-litrufa/part-1/1',
  'hashtatfchus-meshivas': '/reader/hashtatfchus-hanefesh/part-1/1',
  'parparos-commentary': '/reader/parparos-lechochma/part-1/1',
  'kokhvei-or': '/reader/kokhvei-or/part-1/1',
  'siach-sarfei-kodesh': '/reader/siach-sarfei-kodesh/vol-1/1',
};

// Build category lookup
const catMap = new Map(categories.map((c: any) => [c.id, c]));

// Resolve groups with their categories
const resolvedGroups = authorGroups.map(group => {
  const cats = group.categoryIds
    .map(id => catMap.get(id))
    .filter(Boolean);
  const fileCount = cats.reduce((sum: number, c: any) => sum + c.fileCount, 0);
  const sizeMB = cats.reduce((sum: number, c: any) => sum + c.totalSizeMB, 0);
  return { ...group, cats, fileCount, sizeMB };
});
---

<Layout title="ספריית ברסלב - Breslov PDF Library | ajew.org" description="Download Breslov holy books - PDFs and documents of Likutay Moharan, Likutay Tefilos, Sipurey Maasiyos, and more.">
<div class="library-page">
  <!-- Hero -->
  <header class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-ornament">&#x2737;</div>
      <h1>ספריית ברסלב</h1>
      <p class="subtitle">Breslov Digital Library</p>
      <div class="stats-row">
        <div class="stat">
          <span class="stat-num">{totalFiles}</span>
          <span class="stat-label">ספרים</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">{resolvedGroups.length}</span>
          <span class="stat-label">מחברים</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">{(totalSizeMB / 1024).toFixed(1)}</span>
          <span class="stat-label">GB</span>
        </div>
      </div>
      <div class="search-wrap">
        <input type="text" id="library-search" placeholder="חפש ספר... / Search books..." autocomplete="off" />
        <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </div>
    </div>
  </header>

  <!-- Sticky Author Nav -->
  <nav class="author-nav" id="author-nav">
    <div class="author-nav-inner">
      {resolvedGroups.map(group => (
        <a href={`#${group.id}`} class="author-chip" style={`--chip-accent: ${group.accent}`}>
          <span class="chip-label">{group.nameHe}</span>
          <span class="chip-count">{group.fileCount}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Main content -->
  <main class="main-content">
    {resolvedGroups.map(group => (
      <section class="author-section" id={group.id} data-author={group.id} style={`--section-accent: ${group.accent}`}>
        <div class="author-header">
          <div class="author-header-text">
            <h2 class="author-name-he">{group.nameHe}</h2>
            <p class="author-name-en">{group.nameEn}</p>
          </div>
          <div class="author-meta">
            <span class="author-file-count">{group.fileCount} קבצים</span>
            <span class="author-size">{group.sizeMB > 1000 ? (group.sizeMB / 1024).toFixed(1) + ' GB' : group.sizeMB + ' MB'}</span>
          </div>
        </div>

        {group.cats.map((cat: any) => (
          <div class="book-group" data-category={cat.id}>
            <div class="book-group-header">
              <h3 class="book-group-title">
                <span class="book-group-icon">{cat.icon}</span>
                {cat.name}
                <span class="book-group-en">{cat.nameEn}</span>
              </h3>
              {readerLinks[cat.id] && (
                <a href={readerLinks[cat.id]} class="reader-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reader-badge-icon">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                  </svg>
                  <span>קרא אונליין</span>
                </a>
              )}
            </div>
            <div class="file-grid">
              {cat.files.map((file: any) => {
                const cleanName = file.name
                  .replace(/\.(pdf|doc|docx|txt)$/i, '')
                  .replace(/_/g, ' ')
                  .replace(/\s+/g, ' ')
                  .replace(/ ajew$| ajew -.*$/, '')
                  .replace(/\(\d+\)$/, '')
                  .replace(/@\S+/g, '')
                  .trim();
                const ext = file.ext;
                const extClass = ext === 'PDF' ? 'badge-pdf' : ext === 'DOCX' || ext === 'DOC' ? 'badge-doc' : 'badge-txt';
                return (
                  <a href={file.url} class="file-card" target="_blank" rel="noopener" data-name={cleanName.toLowerCase() + ' ' + file.name.toLowerCase()}>
                    <div class="file-card-top">
                      <div class="file-icon-wrap">
                        <svg class="file-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                        </svg>
                        <span class={`file-ext-badge ${extClass}`}>{ext}</span>
                      </div>
                      <span class="file-size">{file.sizeMB < 1 ? '<1' : file.sizeMB} MB</span>
                    </div>
                    <div class="file-name">{cleanName}</div>
                    <div class="file-download">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="download-icon">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    ))}
  </main>

  <!-- Footer links -->
  <footer class="library-footer">
    <a href="/reader" class="footer-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="footer-link-icon">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
      </svg>
      קראו בקורא המקוון / Read Online
    </a>
    <a href="/" class="footer-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="footer-link-icon">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      דף הבית / Home
    </a>
  </footer>

  <!-- No results -->
  <div class="no-results" id="no-results" style="display:none;">
    <div class="no-results-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="64" height="64">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </div>
    <p class="no-results-he">לא נמצאו תוצאות</p>
    <p class="no-results-en">No results found. Try a different search term.</p>
    <button id="clear-search" class="clear-search-btn">נקה חיפוש / Clear Search</button>
  </div>
</div>

<style>
  /* ===== Base ===== */
  .library-page {
    min-height: 100vh;
    background: #f8f6f1;
    direction: rtl;
    font-family: 'Frank Ruhl Libre', 'David', serif;
    color: #2d2a24;
  }

  /* ===== Hero ===== */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 64px 24px 48px;
    text-align: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #0f1b33 0%, #1a2d52 40%, #243b60 70%, #1a2844 100%);
    z-index: 0;
  }
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(196,162,101,0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 30%, rgba(107,140,174,0.06) 0%, transparent 50%);
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c4a265' fill-opacity='0.025'%3E%3Cpath d='M40 0l6.18 17.82L64.18 11.82 51.82 28.18 64 40l-17.82 6.18 6 17.64L40 51.82l-12.18 12-6-17.64L4 40l12.18-11.82L4.18 11.82l17.64 6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }
  .hero-ornament {
    font-size: 1.8em;
    color: rgba(196,162,101,0.5);
    margin-bottom: 8px;
    letter-spacing: 12px;
  }
  .hero h1 {
    font-size: 3.2em;
    color: #f0e6d0;
    margin: 0 0 6px;
    font-weight: 700;
    text-shadow: 0 2px 16px rgba(0,0,0,0.3);
    letter-spacing: 3px;
  }
  .subtitle {
    color: #c4a265;
    font-size: 1.1em;
    margin: 0 0 32px;
    font-family: 'Open Sans', sans-serif;
    direction: ltr;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-weight: 300;
  }

  /* Stats */
  .stats-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    margin-bottom: 36px;
  }
  .stat { display: flex; flex-direction: column; align-items: center; }
  .stat-num {
    font-size: 2.2em;
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.82em;
    color: #8a9bb8;
    margin-top: 4px;
    letter-spacing: 1px;
  }
  .stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, rgba(196,162,101,0.3), transparent);
  }

  /* Search */
  .search-wrap {
    position: relative;
    max-width: 500px;
    margin: 0 auto;
  }
  #library-search {
    width: 100%;
    padding: 15px 22px 15px 48px;
    border: 1.5px solid rgba(196,162,101,0.3);
    border-radius: 50px;
    background: rgba(255,255,255,0.07);
    backdrop-filter: blur(12px);
    font-size: 1.05em;
    color: #fff;
    font-family: 'Frank Ruhl Libre', serif;
    outline: none;
    transition: all 0.35s ease;
    direction: rtl;
    box-sizing: border-box;
  }
  #library-search::placeholder { color: rgba(255,255,255,0.4); }
  #library-search:focus {
    border-color: #c4a265;
    background: rgba(255,255,255,0.12);
    box-shadow: 0 0 0 4px rgba(196,162,101,0.1), 0 4px 24px rgba(0,0,0,0.2);
  }
  .search-svg {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: rgba(255,255,255,0.4);
    pointer-events: none;
    transition: color 0.3s;
  }
  #library-search:focus ~ .search-svg { color: #c4a265; }

  /* ===== Author Nav ===== */
  .author-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248,246,241,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(196,162,101,0.15);
    padding: 10px 16px;
    box-shadow: 0 1px 8px rgba(0,0,0,0.04);
  }
  .author-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }
  .author-nav-inner::-webkit-scrollbar { display: none; }

  .author-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid #e8e2d4;
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.82em;
    color: #3d3a34;
    transition: all 0.25s ease;
    flex-shrink: 0;
    font-weight: 600;
  }
  .author-chip:hover {
    background: var(--chip-accent);
    color: #fff;
    border-color: var(--chip-accent);
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(0,0,0,0.1);
  }
  .author-chip.active {
    background: var(--chip-accent);
    color: #fff;
    border-color: var(--chip-accent);
  }
  .chip-count {
    background: rgba(0,0,0,0.06);
    color: #6b6560;
    font-size: 0.85em;
    padding: 1px 7px;
    border-radius: 10px;
    font-weight: 700;
    transition: all 0.25s;
  }
  .author-chip:hover .chip-count,
  .author-chip.active .chip-count {
    background: rgba(255,255,255,0.25);
    color: #fff;
  }

  /* ===== Main ===== */
  .main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 36px 24px 60px;
  }

  /* ===== Author Section ===== */
  .author-section {
    margin-bottom: 56px;
    scroll-margin-top: 70px;
  }
  .author-section.hidden { display: none; }

  .author-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 3px solid var(--section-accent);
    position: relative;
  }
  .author-header::before {
    content: '';
    position: absolute;
    bottom: -3px;
    right: 0;
    width: 60px;
    height: 3px;
    background: var(--section-accent);
    filter: brightness(1.3);
  }
  .author-name-he {
    font-size: 2em;
    color: #1a2844;
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
  }
  .author-name-en {
    font-size: 0.9em;
    color: var(--section-accent);
    margin: 4px 0 0;
    font-family: 'Open Sans', sans-serif;
    direction: ltr;
    text-align: right;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .author-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    flex-shrink: 0;
    direction: ltr;
    text-align: left;
  }
  .author-file-count {
    font-size: 0.85em;
    color: #5a5650;
    font-weight: 600;
  }
  .author-size {
    font-size: 0.78em;
    color: #8a857e;
    font-family: 'Open Sans', monospace;
  }

  /* ===== Book Group (category within author) ===== */
  .book-group {
    margin-bottom: 28px;
    padding-right: 16px;
    border-right: 3px solid rgba(0,0,0,0.04);
    transition: border-color 0.3s;
  }
  .book-group:hover {
    border-right-color: var(--section-accent);
  }
  .book-group.hidden { display: none; }

  .book-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .book-group-title {
    font-size: 1.3em;
    color: #2d2a24;
    margin: 0;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .book-group-icon {
    font-size: 1.1em;
  }
  .book-group-en {
    font-size: 0.65em;
    color: #8a857e;
    font-family: 'Open Sans', sans-serif;
    direction: ltr;
    font-weight: 400;
    letter-spacing: 0.3px;
  }

  /* Reader badge */
  .reader-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 16px;
    background: linear-gradient(135deg, #1a2844, #243b60);
    color: #f0e6d0;
    font-size: 0.78em;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .reader-badge:hover {
    background: linear-gradient(135deg, #243b60, #2d4a7a);
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(26,40,68,0.3);
    color: #fff;
  }
  .reader-badge-icon {
    width: 14px;
    height: 14px;
  }

  /* ===== File Grid ===== */
  .file-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }

  .file-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #fff;
    border: 1px solid #ece8de;
    border-radius: 10px;
    padding: 14px 16px;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .file-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 3px;
    height: 100%;
    background: var(--section-accent);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .file-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
    border-color: var(--section-accent);
  }
  .file-card:hover::before { opacity: 1; }
  .file-card.hidden { display: none; }

  .file-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .file-icon-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .file-icon-svg {
    width: 22px;
    height: 22px;
    color: #bbb5a8;
