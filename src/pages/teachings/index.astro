---
// Redirect to the unified reader/library
return Astro.redirect('/reader', 301);
---

<Layout title="Teachings - Breslov Library" description="Explore the complete teachings of Rabbi Nachman of Breslov - Likutay Moharan, Stories, Sichos HaRan, Sefer Hamidos, and more. Over 7,900 texts online.">
<div class="teachings-page">
  <header class="page-header">
    <div class="header-hebrew">תורות ברסלב</div>
    <h1>Breslov Teachings</h1>
    <p class="subtitle">The complete library of Rabbi Nachman and his students</p>
    <p class="stats">7,920 texts across 47 books</p>
    <a href="/reader" class="open-library-btn">Open Full Library</a>
  </header>

  <!-- Rabbi Nachman's Core Works -->
  <section class="category-section">
    <h2>Rabbi Nachman of Breslov / <span class="heb">רבי נחמן מברסלב</span></h2>
    <div class="books-grid">
      <a href="/reader" class="book-card primary">
        <div class="book-hebrew">ליקוטי מוהר"ן</div>
        <h3>Likutay Moharan</h3>
        <p>The primary collection of Torah teachings</p>
        <span class="count">408 Torahs (2 Parts)</span>
      </a>
      <a href="/reader/kitzur-likutay-moharan/1/1" class="book-card primary">
        <div class="book-hebrew">קיצור ליקוטי מוהר"ן</div>
        <h3>Kitzur Likutay Moharan</h3>
        <p>Shortened Likutay Moharan</p>
        <span class="count">385 Torahs</span>
      </a>
      <a href="/reader/sipurey-maasiyos/1/1" class="book-card accent-green">
        <div class="book-hebrew">סיפורי מעשיות</div>
        <h3>Sipurey Maasiyos</h3>
        <p>The famous stories containing deep mystical secrets</p>
        <span class="count">9 Stories</span>
      </a>
      <a href="/reader/sefer-hamidos/1/1" class="book-card accent-gold">
        <div class="book-hebrew">ספר המידות</div>
        <h3>Sefer Hamidos</h3>
        <p>The Book of Traits - practical wisdom A to Z</p>
        <span class="count">108 Topics</span>
      </a>
    </div>
  </section>

  <!-- Rabbi Nosson's Works -->
  <section class="category-section">
    <h2>Rabbi Nosson of Breslov / <span class="heb">רבי נתן מברסלב</span></h2>
    <div class="books-grid">
      <a href="/reader/sichos-haran/1/1" class="book-card">
        <div class="book-hebrew">שיחות הר"ן</div>
        <h3>Sichos HaRan</h3>
        <p>Rabbi Nachman's conversations and discourses</p>
        <span class="count">309 Conversations</span>
      </a>
      <a href="/reader/likutay-halachos/1/1" class="book-card">
        <div class="book-hebrew">ליקוטי הלכות</div>
        <h3>Likutay Halachos</h3>
        <p>Halachic teachings illuminated by Breslov wisdom</p>
        <span class="count">593 Halachos (8 Volumes)</span>
      </a>
      <a href="/reader/likutay-tefilos/2/1" class="book-card">
        <div class="book-hebrew">ליקוטי תפילות</div>
        <h3>Likutay Tefilos</h3>
        <p>Prayers composed from Likutay Moharan</p>
        <span class="count">211 Prayers</span>
      </a>
      <a href="/reader/likutay-eitzos/1/1" class="book-card">
        <div class="book-hebrew">ליקוטי עצות</div>
        <h3>Likutay Aitzos</h3>
        <p>Practical advice arranged by topic</p>
        <span class="count">65 Topics</span>
      </a>
      <a href="/reader/shivchay-haran/1/1" class="book-card">
        <div class="book-hebrew">שבחי הר"ן</div>
        <h3>Shivchay HaRan</h3>
        <p>Praises and stories of Rabbi Nachman</p>
        <span class="count">63 Sections</span>
      </a>
      <a href="/reader/chayey-moharan/1/1" class="book-card">
        <div class="book-hebrew">חיי מוהר"ן</div>
        <h3>Chayey Moharan</h3>
        <p>Life and times of Rabbi Nachman</p>
        <span class="count">12 Chapters</span>
      </a>
      <a href="/reader/alim-litrufa/2/1" class="book-card">
        <div class="book-hebrew">עלים לתרופה</div>
        <h3>Alim LiTrufa</h3>
        <p>Letters of Rabbi Nosson - leaves for healing</p>
        <span class="count">513 Letters</span>
      </a>
      <a href="/reader/yemei-moharnat/1/1" class="book-card">
        <div class="book-hebrew">ימי מוהרנ"ת</div>
        <h3>Yemei Moharnat</h3>
        <p>Days of Rabbi Nosson's life</p>
        <span class="count">303 Sections</span>
      </a>
    </div>
  </section>

  <!-- More Breslov Masters -->
  <section class="category-section">
    <h2>More Breslov Masters / <span class="heb">עוד מגדולי ברסלב</span></h2>
    <div class="books-grid">
      <a href="/reader/hashtatfchus-hanefesh/1/1" class="book-card accent-purple">
        <div class="book-hebrew">השתפכות הנפש</div>
        <h3>Hashtatfchus HaNefesh</h3>
        <p>Outpouring of the Soul - R' Alter Tepliker</p>
        <span class="count">130 Sections</span>
      </a>
      <a href="/reader/meshivas-nefesh/1/1" class="book-card accent-purple">
        <div class="book-hebrew">משיבת נפש</div>
        <h3>Meshivas Nefesh</h3>
        <p>Restoring the Soul - R' Alter Tepliker</p>
        <span class="count">183 Sections</span>
      </a>
      <a href="/reader/parparos-lechochma/1/1" class="book-card">
        <div class="book-hebrew">פרפראות לחכמה</div>
        <h3>Parparos LeChochma</h3>
        <p>Gems of Wisdom - Rabbi of Tcheryn</p>
        <span class="count">135 Sections</span>
      </a>
      <a href="/reader/siach-sarfei-kodesh/1/1" class="book-card accent-gold">
        <div class="book-hebrew">שיח שרפי קודש</div>
        <h3>Siach Sarfei Kodesh</h3>
        <p>Holy Conversations - Levi Yitzchak Bender</p>
        <span class="count">3,427 Sections (6 Volumes)</span>
      </a>
    </div>
  </section>

  <!-- English Content & Special Pages -->
  <section class="category-section">
    <h2>English Teachings & Guides</h2>
    <div class="books-grid">
      <a href="/books/fires-of-israel" class="book-card accent-red">
        <h3>The Fires of Israel</h3>
        <p>Memoirs of Saba Yisroel (English)</p>
        <span class="count">37 Chapters</span>
      </a>
      <a href="/books/blossoms-of-the-spring" class="book-card accent-green">
        <h3>Blossoms of the Spring</h3>
        <p>Alim LiTrufa - Letters (English)</p>
        <span class="count">Letters collection</span>
      </a>
      <a href="/teachings/tikkun-haklali" class="book-card accent-gold">
        <h3>Tikkun HaKlali</h3>
        <p>The 10 Psalms - General Remedy</p>
      </a>
      <a href="/teachings/hisbodidus-intro" class="book-card">
        <h3>Hitbodedut Guide</h3>
        <p>Personal prayer and meditation</p>
      </a>
      <a href="/teachings/outpouring-of-soul" class="book-card">
        <h3>Outpouring of the Soul</h3>
        <p>Hitbodedut teachings (English)</p>
      </a>
      <a href="/teachings/life-of-rabbi-nachman" class="book-card">
        <h3>Life of Rabbi Nachman</h3>
        <p>Biography and stories (English)</p>
      </a>
    </div>
  </section>

  <!-- Full Library Button -->
  <div class="bottom-cta">
    <a href="/reader" class="open-library-btn large">Browse All 47 Books in the Full Library</a>
    <a href="/search-enhanced" class="search-link">Or search across all 7,920 texts</a>
  </div>

  <div class="quote-block">
    <p class="quote-hebrew">"אם אתה מאמין שיכולין לקלקל, תאמין שיכולין לתקן"</p>
    <p class="quote-english">"If you believe you can damage, believe you can fix."</p>
    <p class="quote-author">- Rebbe Nachman of Breslov</p>
  </div>
</div>

<style>
  .teachings-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 80px;
    font-family: 'Open Sans', sans-serif;
    color: #222;
  }

  .page-header {
    text-align: center;
    padding: 48px 20px 36px;
    margin-bottom: 32px;
    border-bottom: 3px solid #1a365d;
  }
  .page-header .header-hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 2.8em;
    color: #1a365d;
    direction: rtl;
    margin: 0 0 4px;
    font-weight: 700;
  }
  .page-header h1 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.8em;
    color: #1a365d;
    margin: 0 0 8px;
  }
  .page-header .subtitle {
    color: #666;
    font-size: 1em;
    margin: 0 0 4px;
  }
  .page-header .stats {
    color: #999;
    font-size: 0.85em;
    margin: 0 0 20px;
  }

  .open-library-btn {
    display: inline-block;
    background: #1a365d;
    color: #e8d5a3;
    padding: 12px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1em;
    transition: all 0.2s;
  }
  .open-library-btn:hover {
    background: #0f2440;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(26,54,93,0.3);
  }
  .open-library-btn.large {
    font-size: 1.1em;
    padding: 16px 40px;
  }

  .category-section {
    margin-bottom: 40px;
  }
  .category-section h2 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.4em;
    color: #1a365d;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e0d6c2;
    font-weight: 700;
  }
  .category-section h2 .heb {
    font-weight: 400;
    color: #555;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .book-card {
    display: block;
    border: 1px solid #e0d6c2;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: #222;
    background: #faf8f4;
    transition: all 0.2s;
  }
  .book-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    border-color: #c4a265;
  }
  .book-card .book-hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.3em;
    color: #1a365d;
    direction: rtl;
    margin-bottom: 4px;
    font-weight: 700;
  }
  .book-card h3 {
    font-size: 1em;
    color: #1a365d;
    margin: 0 0 6px;
    font-weight: 700;
  }
  .book-card p {
    font-size: 0.82em;
    color: #666;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .book-card .count {
    font-size: 0.75em;
    color: #999;
    font-weight: 600;
  }

  .book-card.primary {
    background: linear-gradient(135deg, #1a365d 0%, #2d4a8a 100%);
    color: white;
    border-color: #1a365d;
  }
  .book-card.primary .book-hebrew { color: #e8d5a3; }
  .book-card.primary h3 { color: white; }
  .book-card.primary p { color: rgba(255,255,255,0.8); }
  .book-card.primary .count { color: rgba(255,255,255,0.6); }
  .book-card.primary:hover { border-color: #c4a265; }

  .book-card.accent-green { border-left: 4px solid #059669; }
  .book-card.accent-gold { border-left: 4px solid #c4a265; }
  .book-card.accent-purple { border-left: 4px solid #7c3aed; }
  .book-card.accent-red { border-left: 4px solid #dc2626; }

  .bottom-cta {
    text-align: center;
    margin: 48px 0 32px;
    padding: 32px;
    background: #f8f5ef;
    border-radius: 16px;
  }
  .search-link {
    display: block;
    margin-top: 12px;
    color: #1a365d;
    font-size: 0.9em;
  }

  .quote-block {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    margin-top: 32px;
  }
  .quote-hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.4em;
    color: #744210;
    margin: 0 0 8px;
    direction: rtl;
  }
  .quote-english {
    color: #666;
    font-style: italic;
    margin: 0 0 8px;
  }
  .quote-author {
    color: #999;
    font-size: 0.9em;
    margin: 0;
  }

  @media (max-width: 768px) {
    .books-grid { grid-template-columns: 1fr; }
    .page-header .header-hebrew { font-size: 2.2em; }
    .page-header h1 { font-size: 1.4em; }
  }
</style>
</Layout>
