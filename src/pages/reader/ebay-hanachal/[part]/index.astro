---
import Layout from '../../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/ebay-hanachal/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/ebay-hanachal/part-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
---

<Layout title=`אבי הנחל — Part ${partNum} Index`>
  <div style="max-width: 900px; margin: 0 auto; padding: 40px 20px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 style="font-family: 'Cinzel', serif; color: #1e3a5f; margin-bottom: 8px;">אבי הנחל</h1>
      <p style="color: #888; font-size: 0.9em;">Part {partNum} &middot; {totalSections} sections</p>
    </div>

    {indexData && (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;">
        {indexData.torahs.map(t => (
          <a href={`/reader/ebay-hanachal/${partNum}/${t.number}`} style="display: block; padding: 10px 14px; background: #f8f5f0; border-radius: 6px; text-decoration: none; border-right: 3px solid #a07830;">
            <span style="color: #1e3a5f; font-weight: 600; font-size: 0.9em;">
              {t.hebrewTitle || t.title || `Section ${t.number}`}
            </span>
          </a>
        ))}
      </div>
    )}

    <div style="margin-top: 40px; text-align: center;">
      <a href="/reader" style="color: #1e3a5f; text-decoration: none; font-weight: 600;">&larr; All Books</a>
    </div>
  </div>
</Layout>
