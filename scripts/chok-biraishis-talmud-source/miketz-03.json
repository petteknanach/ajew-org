        }
      ],
      "sha256": "e13bc09cf690b52183fa2947fcc28e9574d341a6058346a55fe32d31ec44aa4f",
      "body": "ציצין - חתיכות בשר שלא נפרעת המילה כהלכתה:"
    },
    {
      "ref": "Rashi on Yevamot 47b:2:2",
      "pointer": "/text/93/1/1",
      "included": [
        {
          "cp": [
            0,
