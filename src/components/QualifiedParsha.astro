---
import fs from 'node:fs';
import path from 'node:path';
// A separate edition: never borrow the older reviewed or legacy OCR bodies.
const { slug, dataset = null } = Astro.props;
let selection = dataset;
let coverage = null;
if (!selection) {
  const root = path.join(process.cwd(), 'public/data/breslov-parsha/qualified-110-171');
  const index = JSON.parse(fs.readFileSync(path.join(root, 'index.json'), 'utf8'));
  const master = JSON.parse(fs.readFileSync(path.join(root, 'master.json'), 'utf8'));
  coverage = index.parshas[slug];
  if (!coverage) throw new Error(`No qualified source selection for ${slug}`);
  const ids = [...coverage.mainIds, ...coverage.apparatusIds];
  const byId = new Map(master.units.map(unit => [unit.id, unit]));
  const units = ids.map(id => {
    const unit = byId.get(id);
    if (!unit || unit.parsha !== slug) throw new Error(`Missing qualified source owner ${id}`);
    return unit;
  });
  selection = { ...master, units };
}
// Chapter exports keep null-owned weekly apparatus separate from verse mains.
const units = [...(selection.units || []), ...(selection.apparatus || [])];
const mains = units.filter(unit => unit.kind === 'main');
const apparatus = units.filter(unit => unit.kind === 'apparatus');
const globals = selection.globalQualifications || [];
const readerPath = slug && ({'vayeira': '1/4', 'chayei-sarah': '1/5', 'toldot': '1/6', 'vayeitzei': '1/7'})[slug];
const aliasLabel = note => (note.aliases || []).map(alias => alias.id || alias.origin || '').join(' · ');
const afterPair = (unit, pair) => (unit.qualifications || []).filter(note => note.placement === 'after_pair' && note.pair_id === pair.id);
// Unknown/missing pair locators remain visible after the owner, not silently lost.
const afterOwner = unit => (unit.qualifications || []).filter(note => note.placement !== 'after_pair' || !unit.pairs.some(pair => pair.id === note.pair_id));
---
<section class="qualified-parsha" dir="ltr" data-qualified-parsha data-language="both" data-revision={selection.revision}>
  <h2>ברסלב על הפרשה · Qualified source selections</h2>
  {coverage && <h3><span lang="he" dir="rtl">{coverage.titleHe}</span> · {coverage.titleEn}</h3>}
  <p class="qp-notice" role="status">{selection.scopeNotice}</p>
  {coverage?.notice && <p class="qp-notice">{coverage.notice}</p>}
  <p class="qp-notice">Selected supplied source only; not complete parsha or chapter coverage. Source qualifications remain visible in every reading language. Independent apparatus is not assigned to a main teaching.</p>
  <nav class="qp-resources" aria-label="Qualified source resources">
    {slug && <a href={`/parsha/${slug}`}>Independent parsha page</a>}
    {readerPath && <a href={`/reader/chumash-lh/${readerPath}`}>Chumash Reader</a>}
    <a href="/reader/chok/">Daily Chok LiYisroel</a>
    <a href="/parsha/">All parshas</a>
  </nav>
  <div class="qp-languages" aria-label="Qualified source reading language">
    <button type="button" data-qualified-lang="he" aria-pressed="false">עברית</button>
    <button type="button" data-qualified-lang="en" aria-pressed="false">English</button>
    <button type="button" data-qualified-lang="both" aria-pressed="true">Both</button>
  </div>
  {[{kind: 'main', title: 'Main teachings · ליקוטים', items: mains}, {kind: 'apparatus', title: 'Independent printed apparatus · ציונים עצמאיים', items: apparatus}].map(group => group.items.length > 0 &&
    <section class="qp-group" data-qualified-group={group.kind}>
      <h3>{group.title}</h3>
      {group.kind === 'apparatus' && <p class="qp-notice">Standalone source bodies; main ownership remains unassigned.</p>}
      {group.kind === 'apparatus' && selection.apparatusScopeNotice && <p class="qp-notice">{selection.apparatusScopeNotice}</p>}
      {group.items.map(unit => <article class="qp-unit" data-source-id={unit.id} data-owner-main-id={unit.owner_main_id == null ? 'null' : unit.owner_main_id}>
        <p class="qp-locator">{unit.id}{unit.verseRef ? ` · ${unit.verseRef.book} ${unit.verseRef.chapter}:${unit.verseRef.verse}` : ''}</p>
        {unit.pairs.map(pair => <div class="qp-pair" data-pair-id={pair.id}>
          <p class="qp-he" data-qualified-text="he" lang="he" dir="rtl">{pair.he}</p>
          <p class="qp-en" data-qualified-text="en" lang="en" dir="ltr">{pair.en}</p>
          {afterPair(unit, pair).map(note => <aside class="qp-qualification" data-note-id={note.id} data-note-placement={note.placement} lang="en" dir="ltr">
            <p>{note.text}</p><small>{note.id}{aliasLabel(note) && ` · Aliases: ${aliasLabel(note)}`}</small>
          </aside>)}
        </div>)}
        {afterOwner(unit).map(note => <aside class="qp-qualification" data-note-id={note.id} data-note-placement={note.placement} lang="en" dir="ltr">
          <p>{note.text}</p><small>{note.id}{aliasLabel(note) && ` · Aliases: ${aliasLabel(note)}`}</small>
        </aside>)}
      </article>)}
    </section>
  )}
  {globals.length > 0 && <section class="qp-global-qualifications" aria-label="Global source qualifications">
    <h3>Global source qualifications</h3>
    {globals.map(note => <aside class="qp-qualification" data-note-id={note.id} data-note-placement={note.placement} lang="en" dir="ltr">
      <p>{note.text}</p><small>{note.id}{aliasLabel(note) && ` · Aliases: ${aliasLabel(note)}`}</small>
    </aside>)}
  </section>}
</section>
<style>
.qualified-parsha{margin:24px auto;padding:22px;max-width:960px;background:var(--reader-bg-secondary,#f8f5ef);color:var(--reader-text,#202838);border:1px solid var(--reader-border,#c7c0b0);border-radius:14px;overflow-wrap:anywhere}.qp-notice{line-height:1.65;font-size:.95rem;white-space:pre-wrap}.qp-resources,.qp-languages{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0}.qp-languages button{min-height:44px;padding:8px 18px;border:1px solid #777;border-radius:8px;background:transparent;color:inherit;cursor:pointer}.qp-languages button[aria-pressed=true]{background:#1a365d;color:white}.qp-unit{border-top:1px solid #a9a18d;padding:20px 0}.qp-locator{font-size:.85rem}.qp-he,.qp-en{white-space:pre-wrap;line-height:1.85;margin:12px 0}.qp-he{font-family:'Noto Serif Hebrew','Frank Ruhl Libre',serif;font-size:1.25rem;text-align:right}.qp-en{text-align:left}.qp-qualification{margin:12px 0;padding:12px;border-inline-start:3px solid #a15c18;background:var(--reader-bg,#fffaf0);font-size:.95rem;line-height:1.65}.qp-qualification p{white-space:pre-wrap;margin:0 0 6px}.qp-qualification small{overflow-wrap:anywhere}.qp-group{margin:24px 0}.qp-pair [hidden]{display:none!important}@media(max-width:500px){.qualified-parsha{padding:14px;margin:16px 0}.qp-he{font-size:1.15rem}}
</style>
<script>
// Delegation also covers chapter-sidebar clones of the server-rendered template.
document.addEventListener('click', event => {
  const button = (event.target as Element)?.closest<HTMLButtonElement>('[data-qualified-lang]');
  const root = button?.closest<HTMLElement>('[data-qualified-parsha]');
  if (!button || !root) return;
  const language = button.dataset.qualifiedLang;
  if (!['he', 'en', 'both'].includes(language || '')) return;
  root.dataset.language = language;
  for (const text of root.querySelectorAll<HTMLElement>('[data-qualified-text]')) text.hidden = language !== 'both' && text.dataset.qualifiedText !== language;
  for (const other of root.querySelectorAll<HTMLButtonElement>('[data-qualified-lang]')) other.setAttribute('aria-pressed', String(other === button));
});
</script>
