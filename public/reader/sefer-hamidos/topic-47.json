  "hebrewTitle": "יִחוּס",
  "part": 1,
  "segments": [
    {
      "index": 1,
      "he": "א.\n\nחֵלֶק שֵׁנִי",
      "en": "",
      "id": "sh-יחוס-א"
    },
    {
      "index": 2,
      "he": "ב.\n\nאֵין כֹּחַ הַקְּלָלָה חָל עַל מְיֻחָס.",
      "en": "",
      "id": "sh-יחוס-ב"
    },
    {
      "index": 3,
      "he": "ג.\n\nאֲפִלּוּ אִשָּׁה צַדֶּקֶת כְּשֶׁהִיא אֵינָהּ מְיֻחֶסֶת, עַל־יְדֵי זֶה מוֹלֶדֶת בָּנִים שֶׁאֵינָם  מְהֻגָּנִים.",
      "en": "",
      "id": "sh-יחוס-ג"
    },
    {
      "index": 4,
      "he": "ד.\n\nקָשֶׁה לִפְנֵי הַקָּדוֹשׁ־בָּרוּךְ־הוּא לְהַעֲבִיר וּלְבַטֵּל גְּדוֹלֵי הַיִּחוּס.",
      "en": "",
      "id": "sh-יחוס-ד"
    }
  ],
