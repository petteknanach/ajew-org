        }
      ],
      "sha256": "0bff754dfe7a8ffbf08f2ccca78a2aa54cf38d6d568e954d228edab85a55df64",
      "body": "ומודיעים אותו - לקמן מפרש טעמא דכולה מתני':"
    },
    {
      "ref": "Rashi on Yevamot 47b:1:1",
      "pointer": "/text/93/0/0",
      "included": [
        {
          "cp": [
            0,
