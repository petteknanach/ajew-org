---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ספרי ברסלב" description="All Breslov books in Hebrew">
  <div class="books-page">
    <header class="page-header">
      <h1>ספרי ברסלב בלשון הקודש</h1>
      <p class="subtitle">All Breslov Books in Hebrew</p>
    </header>

    <div class="search-section">
      <div class="search-box">
        <input 
          type="text" 
          id="bookSearch" 
          placeholder="חפש ספר... Search for a book..."
          dir="rtl"
        />
        <span class="search-icon">🔍</span>
      </div>
    </div>

    <div class="categories-grid" id="categoriesGrid"></div>

    <div class="search-results" id="searchResults" style="display: none;">
      <h3>תוצאות חיפוש / Search Results</h3>
      <ul class="results-list" id="resultsList"></ul>
      <button class="back-btn" id="backToCategories">חזור לרשימה / Back to List</button>
    </div>
  </div>
</Layout>

<script>
  // Book data - loaded client-side from the folder structure
  const booksData = [
    &lbrace;
      name: "ספרי רבי נחמן",
      originalName: "1_ספרי רבי נחמן",
      books: [
        &lbrace; name: "01_ליקוטי מוהר''ן", filename: "01_ליקוטי מוהר''ן.txt" &rbrace;,
        &lbrace; name: "02_ ליקוטי מוהר''ן מנוקד", filename: "02_ ליקוטי מוהר''ן מנוקד.txt" &rbrace;,
        &lbrace; name: "02_קיצור ליקוטי מוהרן השלם", filename: "02_קיצור ליקוטי מוהרן השלם.txt" &rbrace;,
        &lbrace; name: "03_ספר המידות", filename: "03_ספר המידות.txt" &rbrace;,
        &lbrace; name: "04_ספורי מעשיות", filename: "04_ספורי מעשיות.txt" &rbrace;,
        &lbrace; name: "05_ספורי מעשיות מנוקד", filename: "05_ספורי מעשיות מנוקד.txt" &rbrace;,
        &lbrace; name: "06_שיחות הר''ן", filename: "06_שיחות הר''ן.txt" &rbrace;,
        &lbrace; name: "06א_שיחות הר''ן מנוקד", filename: "06א_שיחות הר''ן מנוקד.txt" &rbrace;,
        &lbrace; name: "07_חיי מוהר''ן", filename: "07_חיי מוהר''ן.txt" &rbrace;,
        &lbrace; name: "08_חיי מוהרן מנוקד", filename: "08_חיי מוהרן מנוקד.txt" &rbrace;,
        &lbrace; name: "09_שבחי הר''ן", filename: "09_שבחי הר''ן.txt" &rbrace;,
        &lbrace; name: "09א_שבחי הר''ן מנוקד", filename: "09א_שבחי הר''ן מנוקד.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי רבי נתן",
      originalName: "2_ספרי רבי נתן",
      books: [
        &lbrace; name: "ליקוטי הלכות", filename: "ליקוטי הלכות.txt" &rbrace;,
        &lbrace; name: "שיחות הר''ן ליקוטי דפוס", filename: "שיחות הר''ן ליקוטי דפוס.txt" &rbrace;,
        &lbrace; name: "שיחות הר''ן ליקוטי ישן", filename: "שיחות הר''ן ליקוטי ישן.txt" &rbrace;,
        &lbrace; name: "שיחות הר''ן מכתב יד", filename: "שיחות הר''ן מכתב יד.txt" &rbrace;,
        &lbrace; name: "שבחי הר''ן", filename: "שבחי הר''ן.txt" &rbrace;,
        &lbrace; name: "חיי מוהר''ן", filename: "חיי מוהר''ן.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי הרב מטשערין",
      originalName: "3_ספרי הרב מטשערין",
      books: [
        &lbrace; name: "דרשות מטשערין", filename: "דרשות מטשערין.txt" &rbrace;,
        &lbrace; name: "דרשות מטשערין ב", filename: "דרשות מטשערין ב.txt" &rbrace;,
        &lbrace; name: "מכתבים מטשערין", filename: "מכתבים מטשערין.txt" &rbrace;,
        &lbrace; name: "מכתבים מטשערין ב", filename: "מכתבים מטשערין ב.txt" &rbrace;,
        &lbrace; name: "שיחות מטשערין", filename: "שיחות מטשערין.txt" &rbrace;,
        &lbrace; name: "שיחות מטשערין ב", filename: "שיחות מטשערין ב.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי רבי נתן בר יהודה",
      originalName: "3_ספרי רבי נתן בר יהודה",
      books: [
        &lbrace; name: "דרשות רבי נתן", filename: "דרשות רבי נתן.txt" &rbrace;,
        &lbrace; name: "שיחות רבי נתן", filename: "שיחות רבי נתן.txt" &rbrace;,
        &lbrace; name: "תולדות רבי נתן", filename: "תולדות רבי נתן.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי רבי אלתר טפליקער",
      originalName: "4_ספרי רבי אלתר טפליקער",
      books: [
        &lbrace; name: "שיחות מהר''א טפליקער", filename: "שיחות מהר''א טפליקער.txt" &rbrace;,
        &lbrace; name: "תולדות מהר''א טפליקער", filename: "תולדות מהר''א טפליקער.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי רבי אברהם בר' נחמן",
      originalName: "5_ספרי רבי אברהם בר' נחמן",
      books: [
        &lbrace; name: "שיחות הר''אבר''ן", filename: "שיחות הר''אבר''ן.txt" &rbrace;,
        &lbrace; name: "שיחות הר''אבר''ן ב", filename: "שיחות הר''אבר''ן ב.txt" &rbrace;,
        &lbrace; name: "תולדות הר''אבר''ן", filename: "תולדות הר''אבר''ן.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרי רבי שמשון בארסקי",
      originalName: "6_ספרי רבי שמשון בארסקי",
      books: [
        &lbrace; name: "שיחות רבי שמשון", filename: "שיחות רבי שמשון.txt" &rbrace;,
        &lbrace; name: "תולדות רבי שמשון", filename: "תולדות רבי שמשון.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרים של תלמידים ועוד",
      originalName: "6_ספרים של תלמידים ועוד",
      books: [
        &lbrace; name: "אגרות קודש ברסלב", filename: "אגרות קודש ברסלב.txt" &rbrace;,
        &lbrace; name: "דרשות אחרונות", filename: "דרשות אחרונות.txt" &rbrace;,
        &lbrace; name: "דרשות ליום ההילולא", filename: "דרשות ליום ההילולא.txt" &rbrace;,
        &lbrace; name: "הגדה של פסח", filename: "הגדה של פסח.txt" &rbrace;,
        &lbrace; name: "ילקוט ישראל", filename: "ילקוט ישראל.txt" &rbrace;,
        &lbrace; name: "ליקוטים מכתבים", filename: "ליקוטים מכתבים.txt" &rbrace;,
        &lbrace; name: "מאמרי מרא דאבוה", filename: "מאמרי מרא דאבוה.txt" &rbrace;,
        &lbrace; name: "מכתב לתלמידים", filename: "מכתב לתלמידים.txt" &rbrace;,
        &lbrace; name: "על ספר הזוהר", filename: "על ספר הזוהר.txt" &rbrace;,
        &lbrace; name: "פיואל הלולא", filename: "פיואל הלולא.txt" &rbrace;,
        &lbrace; name: "שיחות ליום טוב", filename: "שיחות ליום טוב.txt" &rbrace;,
        &lbrace; name: "תיקונים", filename: "תיקונים.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "סיפורים",
      originalName: "91_סיפורים",
      books: [
        &lbrace; name: "סיפורי מעשיות עברית", filename: "סיפורי מעשיות עברית.txt" &rbrace;,
        &lbrace; name: "סיפורים נוספים", filename: "סיפורים נוספים.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ספרים מתורגמים",
      originalName: "92_ספרים מתורגמים",
      books: [
        &lbrace; name: "ליקוטי מוהר''ן אנגלית", filename: "ליקוטי מוהר''ן אנגלית.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ליקוטי מוהר''ן - עברית",
      originalName: "lm-hebrew",
      isHtml: true,
      htmlReader: "/books/read?volume=",
      books: [
        &lbrace; name: "ליקוטי מוהר''ן חלק א (1-100)", volume: "1", range: "1-100" &rbrace;,
        &lbrace; name: "ליקוטי מוהר''ן חלק א (101-200)", volume: "1", range: "101-200" &rbrace;,
        &lbrace; name: "ליקוטי מוהר''ן חלק א (201-286)", volume: "1", range: "201-286" &rbrace;,
        &lbrace; name: "ליקוטי מוהר''ן חלק ב (1-125)", volume: "2", range: "1-125" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "ביבליוגרפית ברסלב",
      originalName: "ביבליוגרפית ברסלב",
      books: [
        &lbrace; name: "אוצר הספרים", filename: "אוצר הספרים.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב א", filename: "ביבליוגרפיה ברסלב א.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ב", filename: "ביבליוגרפיה ברסלב ב.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ג", filename: "ביבליוגרפיה ברסלב ג.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ד", filename: "ביבליוגרפיה ברסלב ד.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ה", filename: "ביבליוגרפיה ברסלב ה.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ו", filename: "ביבליוגרפיה ברסלב ו.txt" &rbrace;,
        &lbrace; name: "ביבליוגרפיה ברסלב ז", filename: "ביבליוגרפיה ברסלב ז.txt" &rbrace;,
        &lbrace; name: "ספרי ברסלב מאז 2000", filename: "ספרי ברסלב מאז 2000.txt" &rbrace;
      ]
    &rbrace;,
    &lbrace;
      name: "לוי יצחק בנדר",
      originalName: "לוי יצחק בנדר",
      books: [
        &lbrace; name: "אוצר הדיבורים", filename: "אוצר הדיבורים.txt" &rbrace;,
        &lbrace; name: "דרשות לוי יצחק", filename: "דרשות לוי יצחק.txt" &rbrace;,
        &lbrace; name: "דרשות לוי יצחק ב", filename: "דרשות לוי יצחק ב.txt" &rbrace;,
        &lbrace; name: "דרשות לוי יצחק ג", filename: "דרשות לוי יצחק ג.txt" &rbrace;,
        &lbrace; name: "שיחות לוי יצחק", filename: "שיחות לוי יצחק.txt" &rbrace;,
        &lbrace; name: "שיחות לוי יצחק ב", filename: "שיחות לוי יצחק ב.txt" &rbrace;,
        &lbrace; name: "תולדות לוי יצחק", filename: "תולדות לוי יצחק.txt" &rbrace;
      ]
    &rbrace;
  ];

  // Flat list for search
  const allBooks = booksData.flatMap(cat => 
    cat.books.map(book => (&lbrace;
      ...book,
      category: cat.name,
      categoryKey: cat.originalName,
      isHtml: cat.isHtml || false,
      htmlReader: cat.htmlReader || ''
    &rbrace;))
  );

  // Render categories
  const categoriesGrid = document.getElementById('categoriesGrid');
  
  booksData.forEach((category, idx) => &lbrace;
    const card = document.createElement('div');
    card.className = 'category-card';
    card.style.setProperty('--delay', `$&lbrace;idx * 0.05&rbrace;s`);
    card.dataset.category = category.name;
    
    card.innerHTML = `
      <div class="category-header">
        <h2>$&lbrace;category.name&rbrace;</h2>
        <span class="book-count">$&lbrace;category.books.length&rbrace; ספרים</span>
      </div>
      <ul class="book-list">
        $&lbrace;category.books.map((book, bookIdx) => &lbrace;
          const link = category.isHtml 
            ? `$&lbrace;category.htmlReader&rbrace;$&lbrace;book.volume&rbrace;&torah=1`
            : `/books/read?category=$&lbrace;encodeURIComponent(category.originalName)&rbrace;&book=$&lbrace;encodeURIComponent(book.filename)&rbrace;`;
          return `
          <li class="book-item" style="--delay: $&lbrace;bookIdx * 0.02&rbrace;s">
            <a href="$&lbrace;link&rbrace;">
              <span class="book-icon">$&lbrace;category.isHtml ? '📚' : '📖'&rbrace;</span>
              <span class="book-name">$&lbrace;book.name&rbrace;</span>
            </a>
          </li>
        `&rbrace;).join('')&rbrace;
      </ul>
    `;
    
    categoriesGrid.appendChild(card);
  &rbrace;);

  // Search functionality
  const searchInput = document.getElementById('bookSearch');
  const searchResults = document.getElementById('searchResults');
  const resultsList = document.getElementById('resultsList');
  const backBtn = document.getElementById('backToCategories');

  searchInput.addEventListener('input', (e) => &lbrace;
    const query = e.target.value.trim().toLowerCase();
    
    if (query.length < 2) &lbrace;
      searchResults.style.display = 'none';
      categoriesGrid.style.display = 'grid';
      return;
    &rbrace;

    const results = allBooks.filter(book => 
      book.name.toLowerCase().includes(query) || 
      book.category.toLowerCase().includes(query)
    );

    if (results.length === 0) &lbrace;
      resultsList.innerHTML = '<li class="no-results">לא נמצאו תוצאות / No results found</li>';
    &rbrace; else &lbrace;
      resultsList.innerHTML = results.map(book => &lbrace;
        const link = book.isHtml 
          ? `$&lbrace;book.htmlReader&rbrace;$&lbrace;book.volume&rbrace;&torah=1`
          : `/books/read?category=$&lbrace;encodeURIComponent(book.categoryKey)&rbrace;&book=$&lbrace;encodeURIComponent(book.filename)&rbrace;`;
        return `
        <li>
          <a href="$&lbrace;link&rbrace;">
            <span class="result-category">$&lbrace;book.category&rbrace;</span>
            <span class="result-name">$&lbrace;book.name&rbrace;</span>
          </a>
        </li>
      `&rbrace;).join('');
    &rbrace;

    categoriesGrid.style.display = 'none';
    searchResults.style.display = 'block';
  &rbrace;);

  backBtn.addEventListener('click', () => &lbrace;
    searchResults.style.display = 'none';
    categoriesGrid.style.display = 'grid';
    searchInput.value = '';
  &rbrace;);
</script>

<style>
  .books-page &lbrace;
    min-height: 100vh;
    background: linear-gradient(180deg, #1a365d 0%, #2d4a6f 100%);
    padding: 2rem;
  &rbrace;

  .page-header &lbrace;
    text-align: center;
    margin-bottom: 2rem;
  &rbrace;

  .page-header h1 &lbrace;
    font-family: var(--font-hebrew);
    font-size: 2.5rem;
    color: white;
    margin-bottom: 0.5rem;
  &rbrace;

  .subtitle &lbrace;
    color: rgba(255,255,255,0.7);
    font-size: 1.1rem;
  &rbrace;

  .search-section &lbrace;
    max-width: 600px;
    margin: 0 auto 2rem;
  &rbrace;

  .search-box &lbrace;
    position: relative;
    display: flex;
    align-items: center;
  &rbrace;

  .search-box input &lbrace;
    width: 100%;
    padding: 1rem 1.5rem 1rem 3rem;
    font-size: 1.1rem;
    border: none;
    border-radius: 50px;
    background: white;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  &rbrace;

  .search-box input:focus &lbrace;
    outline: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  &rbrace;

  .search-icon &lbrace;
    position: absolute;
    left: 1.2rem;
    font-size: 1.2rem;
  &rbrace;

  .categories-grid &lbrace;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  &rbrace;

  .category-card &lbrace;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
  &rbrace;

  @keyframes fadeInUp &lbrace;
    from &lbrace;
      opacity: 0;
      transform: translateY(20px);
    &rbrace;
    to &lbrace;
      opacity: 1;
      transform: translateY(0);
    &rbrace;
  &rbrace;

  .category-header &lbrace;
    background: linear-gradient(135deg, #1a365d, #2d4a6f);
    color: white;
    padding: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  &rbrace;

  .category-header h2 &lbrace;
    font-family: var(--font-hebrew);
    font-size: 1.3rem;
    margin: 0;
  &rbrace;

  .book-count &lbrace;
    font-size: 0.85rem;
    background: rgba(255,255,255,0.2);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
  &rbrace;

  .book-list &lbrace;
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 300px;
    overflow-y: auto;
  &rbrace;

  .book-item &lbrace;
    border-bottom: 1px solid #eee;
    animation: fadeIn 0.3s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
  &rbrace;

  @keyframes fadeIn &lbrace;
    from &lbrace; opacity: 0; &rbrace;
    to &lbrace; opacity: 1; &rbrace;
  &rbrace;

  .book-item:last-child &lbrace;
    border-bottom: none;
  &rbrace;

  .book-item a &lbrace;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    text-decoration: none;
    color: #333;
    transition: all 0.2s;
  &rbrace;

  .book-item a:hover &lbrace;
    background: #f7f5f0;
    color: #c53030;
  &rbrace;

  .book-icon &lbrace;
    font-size: 1.2rem;
  &rbrace;

  .book-name &lbrace;
    font-family: var(--font-hebrew);
    font-size: 1rem;
  &rbrace;

  /* Search Results */
  .search-results &lbrace;
    max-width: 800px;
    margin: 0 auto;
  &rbrace;

  .search-results h3 &lbrace;
    color: white;
    text-align: center;
    margin-bottom: 1.5rem;
  &rbrace;

  .results-list &lbrace;
    list-style: none;
    padding: 0;
    margin: 0;
    background: white;
    border-radius: 12px;
    overflow: hidden;
  &rbrace;

  .results-list li &lbrace;
    border-bottom: 1px solid #eee;
  &rbrace;

  .results-list li a &lbrace;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem;
    text-decoration: none;
    transition: background 0.2s;
  &rbrace;

  .results-list li a:hover &lbrace;
    background: #f7f5f0;
  &rbrace;

  .result-category &lbrace;
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 0.3rem;
  &rbrace;

  .result-name &lbrace;
    font-family: var(--font-hebrew);
    font-size: 1.1rem;
    color: #1a365d;
  &rbrace;

  .no-results &lbrace;
    padding: 2rem;
    text-align: center;
    color: #666;
  &rbrace;

  .back-btn &lbrace;
    display: block;
    width: 100%;
    max-width: 300px;
    margin: 1.5rem auto 0;
    padding: 1rem;
    background: white;
    color: #1a365d;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  &rbrace;

  .back-btn:hover &lbrace;
    background: #f7f5f0;
    transform: translateY(-2px);
  &rbrace;

  @media (max-width: 768px) &lbrace;
    .books-page &lbrace;
      padding: 1rem;
    &rbrace;

    .page-header h1 &lbrace;
      font-size: 1.8rem;
    &rbrace;

    .categories-grid &lbrace;
      grid-template-columns: 1fr;
    &rbrace;
  &rbrace;
</style>
