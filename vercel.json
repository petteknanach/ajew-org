{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "headers": [
    {
      "source": "/books/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=windows-1255"
        }
      ]
    }
  ]
}
