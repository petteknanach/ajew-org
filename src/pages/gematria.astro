---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Advanced Gematria Explorer — 12 Methods, Connections & Bridges"
  description="Advanced Hebrew and English gematria calculator with 12 traditional ciphers, letter breakdowns, resonances, word bridges, shareable URLs, and Ajew Torah search."
>
  <main class="gematria-page" id="main-content">
    <header class="hero">
      <p class="eyebrow">אותיות • מספרים • קשרים</p>
      <h1>גימטריה <span>Gematria Explorer</span></h1>
      <p>Calculate twelve ciphers, uncover equal-value resonances, and bridge two words.</p>
    </header>

    <section class="workbench" aria-label="Gematria calculator">
      <div class="mode-tabs" role="tablist" aria-label="Tool mode">
        <button class="mode-tab active" data-mode="explore" role="tab" aria-selected="true">Explore one phrase</button>
        <button class="mode-tab" data-mode="bridge" role="tab" aria-selected="false">Bridge two phrases</button>
      </div>

      <div id="explorePanel" class="panel active">
        <label for="phraseInput">Hebrew or English phrase — or a gematria number</label>
        <div class="input-row">
          <textarea id="phraseInput" rows="2" dir="auto" placeholder="הכנס מילה או ביטוי…" spellcheck="false"></textarea>
          <button id="clearBtn" class="icon-btn" aria-label="Clear">×</button>
        </div>
        <div class="input-meta">
          <span id="languageBadge">Ready</span>
          <span id="letterCount">0 letters</span>
          <button id="shareBtn" class="text-btn">Copy share link</button>
        </div>
      </div>

      <div id="bridgePanel" class="panel" hidden>
        <div class="bridge-inputs">
          <div>
            <label for="bridgeA">First phrase</label>
            <textarea id="bridgeA" rows="2" dir="auto" placeholder="אמת" spellcheck="false"></textarea>
          </div>
          <div class="bridge-mark" aria-hidden="true">↔</div>
          <div>
            <label for="bridgeB">Second phrase</label>
            <textarea id="bridgeB" rows="2" dir="auto" placeholder="…" spellcheck="false"></textarea>
          </div>
        </div>
        <button id="bridgeBtn" class="primary-btn">Find bridge</button>
      </div>

      <section id="results" class="results" aria-live="polite" hidden>
        <section id="numberLookup" class="number-lookup" hidden>
          <div class="number-hero">
            <span>Likutay Nanach • לוח גמטריאות</span>
            <strong id="lookupNumber"></strong>
            <h2>Gematria results for this number</h2>
          </div>
          <div id="numberMatches" class="number-matches"></div>
          <a class="source-link" href="/reader/likutay-nanach/1/24">Source: Likutay Nanach, Volume 1 — Gematria Table</a>
        </section>

        <div id="calculationPrimary" class="primary-result">
          <div>
            <span class="result-kicker">Standard • מספר הכרחי</span>
            <strong id="primaryValue">0</strong>
          </div>
          <div id="normalizedPhrase" class="normalized" dir="auto"></div>
        </div>

        <div id="calculationMethods">
          <div class="section-heading">
            <div><span>12 calculations</span><h2>Numerical values</h2></div>
            <button id="copyValuesBtn" class="text-btn">Copy values</button>
          </div>
          <div id="methodsGrid" class="methods-grid"></div>
        </div>

        <div id="calculationDetails" class="two-column">
          <section class="card">
            <div class="section-heading compact"><div><span>Every letter</span><h2>Breakdown</h2></div></div>
            <div id="lettersGrid" class="letters-grid"></div>
          </section>
          <section class="card">
            <div class="section-heading compact"><div><span>Equal value</span><h2>Resonances</h2></div></div>
            <label class="method-filter">Compare using <select id="matchMethod"></select></label>
            <div id="resonances" class="resonances"></div>
          </section>
        </div>

        <div id="calculationActions" class="action-row">
          <a id="searchAjew" class="primary-btn link-btn" href="/search-enhanced/">Search this phrase across Ajew Torah</a>
          <button id="useAsBridge" class="secondary-btn">Bridge this phrase</button>
        </div>
      </section>

      <section id="bridgeResults" class="results" aria-live="polite" hidden>
        <div class="section-heading"><div><span>Connection engine</span><h2>Bridge analysis</h2></div></div>
        <div id="bridgeSummary" class="bridge-summary"></div>
        <div id="sharedMethods" class="shared-methods"></div>
        <div id="bridgeSuggestions" class="bridge-suggestions"></div>
      </section>
    </section>

    <section class="guide">
      <details>
        <summary>What do the twelve methods mean?</summary>
        <div id="methodGuide" class="guide-grid"></div>
      </details>
      <div class="quick-terms" aria-label="Example words">
        <span>Try:</span>
        {['491','108','נ נח נחמ נחמן מאומן','נחמן','אמת','אהבה','משיח','תורה','תפילה','שמחה'].map(word => (
          <button class="quick-term" data-word={word}>{word}</button>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  import LN_GEMATRIA from '../data/likutay-nanach-gematria.json';

  type Cipher = {
    id: string;
    name: string;
    he: string;
    description: string;
    calculate: (text: string, language: 'he'|'en') => number;
  };

  const HEBREW = 'אבגדהוזחטיכלמנסעפצקרשת';
  const ENGLISH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const FINAL_TO_REGULAR: Record<string,string> = {'ך':'כ','ם':'מ','ן':'נ','ף':'פ','ץ':'צ'};
  const STANDARD_VALUES: Record<string,number> = {
    'א':1,'ב':2,'ג':3,'ד':4,'ה':5,'ו':6,'ז':7,'ח':8,'ט':9,'י':10,
    'כ':20,'ל':30,'מ':40,'נ':50,'ס':60,'ע':70,'פ':80,'צ':90,
    'ק':100,'ר':200,'ש':300,'ת':400,'ך':20,'ם':40,'ן':50,'ף':80,'ץ':90
  };
  const GADOL_VALUES = {...STANDARD_VALUES,'ך':500,'ם':600,'ן':700,'ף':800,'ץ':900};
  const KIDMI: Record<string,number> = {};
  let kidmiRunning = 0;
  for (const letter of HEBREW) { kidmiRunning += STANDARD_VALUES[letter]; KIDMI[letter] = kidmiRunning; }

  const stripMarks = (text:string) => text.normalize('NFKD').replace(/[\u0591-\u05C7\u0300-\u036f]/g,'');
  const languageOf = (text:string): 'he'|'en' => /[\u05D0-\u05EA]/.test(text) ? 'he' : 'en';
  const letters = (text:string, language:'he'|'en') => {
    const clean = stripMarks(text);
    if (language === 'he') return [...clean].map(c => FINAL_TO_REGULAR[c] || c).filter(c => HEBREW.includes(c));
    return [...clean.toUpperCase()].filter(c => ENGLISH.includes(c));
  };
  const wordsCount = (text:string) => text.trim() ? text.trim().split(/\s+/).length : 0;
  const baseValue = (c:string, language:'he'|'en') => language === 'he' ? (STANDARD_VALUES[c] || 0) : ENGLISH.indexOf(c) + 1;
  const sum = (arr:number[]) => arr.reduce((a,b) => a+b, 0);
  const digitalRoot = (n:number) => n === 0 ? 0 : ((n - 1) % 9) + 1;
  const shiftedValue = (c:string, alphabet:string, amount:number, language:'he'|'en') => {
    const i = alphabet.indexOf(c);
    if (i < 0) return 0;
    const shifted = alphabet[(i + amount) % alphabet.length];
    return baseValue(shifted, language);
  };

  const CIPHERS: Cipher[] = [
    {id:'standard', name:'Standard', he:'הכרחי', description:'Traditional values: א=1 through ת=400.', calculate:(t,l)=>sum(letters(t,l).map(c=>baseValue(c,l)))},
    {id:'ordinal', name:'Ordinal', he:'סידורי', description:'Each letter’s alphabet position, 1–22 (or A–Z, 1–26).', calculate:(t,l)=>sum(letters(t,l).map(c=>(l==='he'?HEBREW:ENGLISH).indexOf(c)+1))},
    {id:'reduced', name:'Reduced', he:'קטן', description:'Each letter value reduced to one digit.', calculate:(t,l)=>sum(letters(t,l).map(c=>digitalRoot(baseValue(c,l))))},
    {id:'gadol', name:'Great / Finals', he:'גדול', description:'Final Hebrew letters receive 500–900.', calculate:(t,l)=>l==='he'?sum([...stripMarks(t)].map(c=>GADOL_VALUES[c]||0)):sum(letters(t,l).map(c=>baseValue(c,l)))},
    {id:'atbash', name:'Atbash', he:'אתב״ש', description:'Mirror substitution: א↔ת, ב↔ש.', calculate:(t,l)=>sum(letters(t,l).map(c=>shiftedValue(c,l==='he'?HEBREW:ENGLISH,(l==='he'?HEBREW:ENGLISH).length-1-2*(l==='he'?HEBREW:ENGLISH).indexOf(c),l)))},
    {id:'albam', name:'Albam', he:'אלב״ם', description:'Exchange the two halves of the alphabet.', calculate:(t,l)=>sum(letters(t,l).map(c=>shiftedValue(c,l==='he'?HEBREW:ENGLISH,(l==='he'?11:13),l)))},
    {id:'avgad', name:'Avgad', he:'אבג״ד', description:'Shift every letter forward by one.', calculate:(t,l)=>sum(letters(t,l).map(c=>shiftedValue(c,l==='he'?HEBREW:ENGLISH,1,l)))},
    {id:'kidmi', name:'Cumulative', he:'קדמי', description:'Each Hebrew letter equals the sum of all values through that letter.', calculate:(t,l)=>l==='he'?sum(letters(t,l).map(c=>KIDMI[c]||0)):sum(letters(t,l).map(c=>{const n=baseValue(c,l);return n*(n+1)/2}))},
    {id:'perati', name:'Squares', he:'פרטי', description:'Sum of each individual letter value squared.', calculate:(t,l)=>sum(letters(t,l).map(c=>baseValue(c,l)**2))},
    {id:'triangular', name:'Triangular', he:'משולש', description:'Triangular value n(n+1)/2 for each letter.', calculate:(t,l)=>sum(letters(t,l).map(c=>{const n=baseValue(c,l);return n*(n+1)/2}))},
    {id:'kolel', name:'With Kolel', he:'כולל', description:'Standard value plus one for the phrase as a whole.', calculate:(t,l)=>CIPHERS[0].calculate(t,l)+(letters(t,l).length?1:0)},
    {id:'wordKolel', name:'Word Kolel', he:'כולל תיבות', description:'Standard value plus the number of words.', calculate:(t,l)=>CIPHERS[0].calculate(t,l)+wordsCount(t)},
  ];

  const TERMS = [
    ['אחד','One'],['אהבה','Love'],['אמת','Truth'],['תורה','Torah'],['שלום','Peace'],['ישראל','Israel'],
    ['משיח','Messiah'],['נחש','Snake'],['שמחה','Joy'],['נשמה','Soul'],['תפילה','Prayer'],['צדיק','Tzaddik'],
    ['חיים','Life'],['חכמה','Wisdom'],['בינה','Understanding'],['דעת','Knowledge'],['כתר','Crown'],['מלכות','Kingship'],
    ['תשובה','Return'],['אמונה','Faith'],['בטחון','Trust'],['גאולה','Redemption'],['קדושה','Holiness'],['ענווה','Humility'],
    ['רחמים','Mercy'],['דין','Judgment'],['חסד','Kindness'],['גבורה','Strength'],['תפארת','Beauty'],['נצח','Victory'],
    ['הוד','Splendor'],['יסוד','Foundation'],['שכינה','Divine Presence'],['אור','Light'],['חושך','Darkness'],['רפואה','Healing'],
    ['פרנסה','Livelihood'],['ברכה','Blessing'],['נחמן','Nachman'],['ברסלב','Breslov'],['אדם','Adam'],['חוה','Eve'],
    ['שרה','Sarah'],['רבקה','Rebecca'],['רחל','Rachel'],['לאה','Leah'],['משה','Moses'],['אהרן','Aaron'],
    ['דוד','David'],['שלמה','Solomon'],['אליהו','Elijah'],['ירושלים','Jerusalem'],['ציון','Zion'],['שבת','Shabbat'],
    ['תיקון','Rectification'],['עולם','World'],['נתן','Natan'],['צדקה','Charity'],['התבודדות','Hitbodedut'],['סבא','Saba'],
    ['רבי נחמן','Rabbi Nachman'],['נ נח נחמ נחמן מאומן','Na Nach Nachma Nachman MeUman'],['ראש השנה','Rosh Hashanah'],
    ['ארץ ישראל','Land of Israel'],['יראת שמים','Fear of Heaven'],['עבודת השם','Serving Hashem'],['שמירת הברית','Guarding the Covenant']
  ].map(([he,en])=>({he,en}));

  const $ = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
  const phraseInput = $<HTMLTextAreaElement>('phraseInput');
  const results = $('results');
  const bridgeResults = $('bridgeResults');
  let currentMode = 'explore';

  function valueFor(methodId:string, text:string) {
    const method = CIPHERS.find(m=>m.id===methodId) || CIPHERS[0];
    return method.calculate(text, languageOf(text));
  }

  function renderMethods(text:string) {
    const lang = languageOf(text);
    $('methodsGrid').innerHTML = CIPHERS.map((method,i)=>`
      <button class="method-card ${i===0?'featured':''}" data-method="${method.id}" title="${method.description}">
        <span>${method.he}</span><small>${method.name}</small><strong>${method.calculate(text,lang).toLocaleString()}</strong>
      </button>`).join('');
  }

  function renderLetters(text:string) {
    const lang = languageOf(text);
    let running = 0;
    $('lettersGrid').innerHTML = letters(text,lang).map(c=>{
      const value=baseValue(c,lang); running+=value;
      return `<div class="letter-chip"><strong>${c}</strong><span>${value}</span><small>Σ ${running}</small></div>`;
    }).join('') || '<p class="empty">Enter a phrase to see each letter.</p>';
  }

  function renderResonances(text:string, methodId = ($<HTMLSelectElement>('matchMethod').value || 'standard')) {
    const val = valueFor(methodId,text);
    const clean = stripMarks(text).replace(/\s+/g,' ').trim();
    const exact = TERMS.filter(t=>t.he!==clean && valueFor(methodId,t.he)===val);
    const near = TERMS.filter(t=>t.he!==clean).map(t=>({...t,diff:Math.abs(valueFor(methodId,t.he)-val),value:valueFor(methodId,t.he)})).sort((a,b)=>a.diff-b.diff).slice(0,6);
    const items = exact.length ? exact.map(t=>`<button class="resonance exact" data-word="${t.he}"><b dir="rtl">${t.he}</b><span>${t.en}</span><em>= ${val.toLocaleString()}</em></button>`) : near.map(t=>`<button class="resonance" data-word="${t.he}"><b dir="rtl">${t.he}</b><span>${t.en}</span><em>${t.value.toLocaleString()} • Δ${t.diff}</em></button>`);
    $('resonances').innerHTML = (exact.length ? `<p class="match-note">${exact.length} exact connection${exact.length===1?'':'s'} in this method</p>` : '<p class="match-note">No exact match in the curated lexicon; nearest values:</p>') + items.join('');
    document.querySelectorAll<HTMLButtonElement>('.resonance').forEach(b=>b.onclick=()=>{phraseInput.value=b.dataset.word||'';updateExplore();});
  }

  function renderNumberLookup(number:number) {
    const matches = LN_GEMATRIA.filter(entry=>entry.number===number);
    $('lookupNumber').textContent=number.toLocaleString();
    $('numberMatches').innerHTML=matches.length
      ? matches.map(entry=>`<article class="number-match"><b dir="rtl">${entry.text}</b><small>Volume 1 • Gematria Table • entry ${entry.segment}</small></article>`).join('')
      : '<p class="number-none">This number is not in the Likutay Nanach Volume 1 gematria table.</p>';
    $('numberLookup').hidden=false;
    ['calculationPrimary','calculationMethods','calculationDetails','calculationActions'].forEach(id=>$(id).hidden=true);
    $('languageBadge').textContent=matches.length?'Likutay Nanach match':'Number lookup';
    $('letterCount').textContent=matches.length?`${matches.length} result${matches.length===1?'':'s'}`:'No listed result';
  }

  function updateExplore(push=false) {
    const text = phraseInput.value.trim();
    if (!text) { results.hidden=true; $('languageBadge').textContent='Ready'; $('letterCount').textContent='0 letters'; return; }
    const numeric=/^\d+$/.test(text);
    results.hidden=false;
    if(numeric){
      renderNumberLookup(Number(text));
      if(push){const u=new URL(location.href);u.searchParams.set('q',text);history.replaceState({},'',u);}
      return;
    }
    $('numberLookup').hidden=true;
    ['calculationPrimary','calculationMethods','calculationDetails','calculationActions'].forEach(id=>$(id).hidden=false);
    const lang=languageOf(text); const chars=letters(text,lang);
    $('languageBadge').textContent=lang==='he'?'Hebrew detected':'English detected';
    $('letterCount').textContent=`${chars.length} letter${chars.length===1?'':'s'} • ${wordsCount(text)} word${wordsCount(text)===1?'':'s'}`;
    $('primaryValue').textContent=CIPHERS[0].calculate(text,lang).toLocaleString();
    $('normalizedPhrase').textContent=stripMarks(text);
    renderMethods(text); renderLetters(text); renderResonances(text);
    $<HTMLAnchorElement>('searchAjew').href=`/search-enhanced/?q=${encodeURIComponent(text)}`;
    if(push){const u=new URL(location.href);u.searchParams.set('q',text);history.replaceState({},'',u);}
  }

  function renderBridge() {
    const a=$<HTMLTextAreaElement>('bridgeA').value.trim();
    const b=$<HTMLTextAreaElement>('bridgeB').value.trim();
    if(!a||!b){bridgeResults.hidden=true;return;}
    bridgeResults.hidden=false;
    const av=valueFor('standard',a), bv=valueFor('standard',b), delta=Math.abs(av-bv);
    $('bridgeSummary').innerHTML=`<div><span dir="auto">${a}</span><strong>${av.toLocaleString()}</strong></div><div class="delta"><small>difference</small><b>${delta.toLocaleString()}</b></div><div><span dir="auto">${b}</span><strong>${bv.toLocaleString()}</strong></div>`;
    const shared=CIPHERS.filter(m=>m.calculate(a,languageOf(a))===m.calculate(b,languageOf(b)));
    $('sharedMethods').innerHTML=shared.length?`<h3>Direct equality</h3><p>${shared.map(m=>`<span class="pill">${m.name}: ${m.calculate(a,languageOf(a)).toLocaleString()}</span>`).join('')}</p>`:'<h3>No direct equality across the twelve methods</h3>';
    const exact=TERMS.filter(t=>valueFor('standard',t.he)===delta);
    const pairs:Array<{a:any,b:any}>=[];
    for(let i=0;i<TERMS.length&&pairs.length<8;i++)for(let j=i;j<TERMS.length&&pairs.length<8;j++)if(valueFor('standard',TERMS[i].he)+valueFor('standard',TERMS[j].he)===delta)pairs.push({a:TERMS[i],b:TERMS[j]});
    let html='<h3>Bridge candidates</h3>';
    if(exact.length) html+=exact.map(t=>`<div class="bridge-card"><b dir="rtl">${t.he}</b><span>${t.en}</span><em>${delta}</em><p>${av>bv?'First':'Second'} phrase − <strong>${t.he}</strong> = ${Math.min(av,bv)}</p></div>`).join('');
    if(pairs.length) html+=pairs.map(p=>`<div class="bridge-card pair"><b dir="rtl">${p.a.he} + ${p.b.he}</b><span>${p.a.en} + ${p.b.en}</span><em>${delta}</em></div>`).join('');
    if(!exact.length&&!pairs.length){const nearest=TERMS.map(t=>({...t,v:valueFor('standard',t.he),d:Math.abs(valueFor('standard',t.he)-delta)})).sort((x,y)=>x.d-y.d).slice(0,8);html+='<p class="match-note">No exact bridge in the curated lexicon. Nearest bridge values:</p>'+nearest.map(t=>`<div class="bridge-card"><b dir="rtl">${t.he}</b><span>${t.en}</span><em>${t.v} • Δ${t.d}</em></div>`).join('');}
    $('bridgeSuggestions').innerHTML=html;
  }

  const methodSelect=$<HTMLSelectElement>('matchMethod');
  methodSelect.innerHTML=CIPHERS.map(m=>`<option value="${m.id}">${m.name} • ${m.he}</option>`).join('');
  $('methodGuide').innerHTML=CIPHERS.map(m=>`<article><b>${m.he}</b><h3>${m.name}</h3><p>${m.description}</p></article>`).join('');

  phraseInput.addEventListener('input',()=>updateExplore(true));
  $('clearBtn').onclick=()=>{phraseInput.value='';updateExplore(true);phraseInput.focus();};
  methodSelect.onchange=()=>renderResonances(phraseInput.value);
  $('bridgeBtn').onclick=renderBridge;
  $('useAsBridge').onclick=()=>{setMode('bridge');$<HTMLTextAreaElement>('bridgeA').value=phraseInput.value;$<HTMLTextAreaElement>('bridgeB').focus();};
  $('shareBtn').onclick=async()=>{updateExplore(true);await navigator.clipboard.writeText(location.href);$('shareBtn').textContent='Copied';setTimeout(()=>$('shareBtn').textContent='Copy share link',1400);};
  $('copyValuesBtn').onclick=async()=>{const text=CIPHERS.map(m=>`${m.name}: ${m.calculate(phraseInput.value,languageOf(phraseInput.value))}`).join('\n');await navigator.clipboard.writeText(`${phraseInput.value}\n${text}`);$('copyValuesBtn').textContent='Copied';setTimeout(()=>$('copyValuesBtn').textContent='Copy values',1400);};
  document.querySelectorAll<HTMLButtonElement>('.quick-term').forEach(b=>b.onclick=()=>{setMode('explore');phraseInput.value=b.dataset.word||'';updateExplore(true);scrollTo({top:0,behavior:'smooth'});});
  document.querySelectorAll<HTMLButtonElement>('.mode-tab').forEach(b=>b.onclick=()=>setMode(b.dataset.mode||'explore'));
  function setMode(mode:string){currentMode=mode;document.querySelectorAll('.mode-tab').forEach(t=>{const active=(t as HTMLElement).dataset.mode===mode;t.classList.toggle('active',active);t.setAttribute('aria-selected',String(active));});$('explorePanel').hidden=mode!=='explore';$('bridgePanel').hidden=mode!=='bridge';results.hidden=mode!=='explore'||!phraseInput.value.trim();if(mode!=='bridge')bridgeResults.hidden=true;}

  const initial=new URL(location.href).searchParams.get('q');
  if(initial){phraseInput.value=initial;updateExplore();}
</script>

<style>
  :global(body){background:#f5efe3}
  .gematria-page{min-height:100vh;background:radial-gradient(circle at 20% 0%,rgba(191,146,66,.22),transparent 34%),linear-gradient(180deg,#11243a 0,#18344d 390px,#f5efe3 390px);padding:42px 18px 80px;color:#172739}
  .hero{max-width:1040px;margin:0 auto 26px;text-align:center;color:#fff}
  .eyebrow{letter-spacing:.18em;color:#e5c27b;font-size:.78rem;font-weight:800;text-transform:uppercase;margin:0 0 8px}
  .hero h1{font-family:var(--font-hebrew);font-size:clamp(2.45rem,6vw,4.8rem);line-height:1;margin:0}.hero h1 span{display:block;font-family:Georgia,serif;font-size:.34em;letter-spacing:.08em;margin-top:12px;color:#f4dfac}.hero>p:last-child{max-width:620px;margin:15px auto 0;color:#d9e3ec}
  .workbench{max-width:1040px;margin:auto;background:#fffdf8;border:1px solid #decda8;border-radius:22px;box-shadow:0 20px 55px rgba(4,18,30,.28);padding:clamp(18px,4vw,36px)}
  .mode-tabs{display:flex;gap:8px;padding:5px;background:#ece6d9;border-radius:12px;width:max-content;max-width:100%;margin-bottom:25px}.mode-tab{border:0;background:transparent;padding:10px 16px;border-radius:9px;font-weight:750;color:#55606d;cursor:pointer}.mode-tab.active{background:#18344d;color:white;box-shadow:0 3px 10px #18344d33}
