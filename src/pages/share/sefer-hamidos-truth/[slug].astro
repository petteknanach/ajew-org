---
import Layout from '../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const manifestPath = path.join(process.cwd(), 'public/images/sefer-hamidos-truth/manifest.json');
  const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
  const paths = [];
  for (const entry of manifest.entries || []) {
    for (const img of entry.images || []) {
      const slug = path.basename(img.path || img.archive_filename || '').replace(/\.[^.]+$/, '');
      if (!slug) continue;
      paths.push({ params: { slug }, props: { entry, img, slug } });
    }
  }
  return paths;
}

const { entry, img, slug } = Astro.props;
const absImage = new URL(img.path, Astro.site).toString();
const readerUrl = new URL(`/reader/sefer-hamidos/1/1#seg-${entry.segment}`, Astro.site).toString();
const title = `Sefer Hamidos Truth ${entry.segment} ${img.language} picture`;
const desc = img.language === 'hebrew' ? entry.he : entry.en;
---

<Layout title={title} description={desc} image={img.path} type="article">
  <main style="max-width: 980px; margin: 0 auto; padding: 2rem 1rem; text-align: center;">
    <p><a href={readerUrl}>← Back to the teaching</a></p>
    <h1>{title}</h1>
    <p style="color:#666;">Share page for X / Telegram previews. Direct image: <a href={absImage}>{absImage}</a></p>
    <img src={img.path} alt={title} style="max-width:100%;height:auto;border-radius:18px;box-shadow:0 16px 44px rgba(0,0,0,.18);" />
    <p style="margin-top:1rem;">
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.toString())}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener">Share to X</a>
      · <a href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.toString())}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener">Share to Telegram</a>
      · <a href={img.path} download>Download image</a>
    </p>
  </main>
</Layout>
