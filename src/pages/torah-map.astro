---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Torah Map - Pathways Through the Teachings" description="Explore how spiritual concepts flow through Rabbi Nachman's teachings. Trace multi-step pathways and see where each idea leads.">
<div class="map-page">
  <header class="map-header">
    <div class="header-hebrew">מפת התורה</div>
    <h1>Torah Map</h1>
    <p class="subtitle">Trace how concepts lead to each other through the holy teachings</p>
    <p class="nanach">Na Nach Nachma Nachman MeUman</p>
  </header>

  <div id="loading" class="loading">Loading concept graph...</div>

  <div id="mapContent" style="display:none;">

    <!-- Pathway Builder -->
    <section class="pathway-builder" id="pathwayBuilder">
      <h2 class="section-title">Build a Pathway / בנה מסלול</h2>
      <p class="section-desc">Click any concept to start, then follow the arrows to trace a path through the teachings</p>
      <div class="pathway-display" id="pathwayDisplay">
        <div class="pathway-empty">Select a concept below to begin</div>
      </div>
      <div class="pathway-actions" id="pathwayActions" style="display:none;">
        <button class="action-btn" onclick="clearPathway()">Clear Path</button>
        <button class="action-btn action-btn-alt" onclick="undoPathway()">Undo</button>
      </div>
      <div class="pathway-next" id="pathwayNext" style="display:none;">
        <h4>Continue to... / המשך ל...</h4>
        <div class="pathway-options" id="pathwayOptions"></div>
      </div>
    </section>

    <!-- Visual Network Graph -->
    <section class="graph-section" id="graphSection">
      <h2 class="section-title">Visual Map / מפה חזותית</h2>
      <p class="section-desc">Click any concept to explore. Lines show how ideas connect through the teachings.</p>
      <div class="graph-container" id="graphContainer">
        <canvas id="graphCanvas" width="860" height="600"></canvas>
      </div>
    </section>

    <!-- Top Pathways (pre-computed) -->
    <section class="top-pathways" id="topPathways">
      <h2 class="section-title">Key Pathways / מסלולים מרכזיים</h2>
      <p class="section-desc">The strongest multi-step progressions found across all teachings</p>
      <div class="pathways-grid" id="pathwaysGrid"></div>
    </section>

    <!-- Concept Cloud -->
    <section class="concept-cloud" id="conceptCloud">
      <h2 class="section-title">All Concepts / כל המושגים</h2>
    </section>

    <!-- Selected Concept View -->
    <section class="concept-view" id="conceptView" style="display:none;">
      <div class="concept-header" id="conceptHeader"></div>

      <!-- Flow Diagram -->
      <div class="flow-diagram">
        <div class="flow-section">
          <h3 class="flow-title">What Leads Here / מה מוביל לכאן</h3>
          <div class="flow-row" id="leadsHere"></div>
        </div>

        <div class="selected-concept-center" id="centerConcept"></div>

        <div class="flow-section">
          <h3 class="flow-title">Where This Leads / לאן זה מוביל</h3>
          <div class="flow-row" id="leadsTo"></div>
        </div>
      </div>

      <!-- Multi-step pathways from this concept -->
      <div class="concept-pathways" id="conceptPathways"></div>

      <!-- Related Teachings -->
      <div class="teachings-section">
        <h3>Key Teachings / תורות מרכזיות</h3>
        <div class="teachings-grid" id="teachingsList"></div>
      </div>

      <!-- Co-occurring concepts -->
      <div class="related-section">
        <h3>Often Found Together / נמצאים יחד</h3>
        <div class="related-chips" id="relatedConcepts"></div>
      </div>
    </section>
  </div>
</div>

<script is:inline>
  let graphData = null;
  let flowLookup = {};  // from -> [{to, netFlow}]
  let reverseLookup = {}; // to -> [{from, netFlow}]
  let coLookup = {};    // concept -> [{to, weight}] from co-occurrence
  let currentPathway = []; // Array of concept IDs

  let progressionData = null;

  async function loadGraph() {
    try {
      const [res, progRes] = await Promise.all([
        fetch('/data/concept-graph.json'),
        fetch('/data/concept-progression.json').catch(() => null)
      ]);
      graphData = await res.json();
      if (progRes && progRes.ok) {
        progressionData = await progRes.json();
      }
      buildLookups();
      document.getElementById('loading').style.display = 'none';
      document.getElementById('mapContent').style.display = 'block';
      // Render after layout is visible so canvas gets correct dimensions
      renderGraph();
      renderTopPathways();
      renderCloud();
    } catch (e) {
      document.getElementById('loading').textContent = 'Error loading concept graph';
    }
  }

  function buildLookups() {
    flowLookup = {};
    reverseLookup = {};
    coLookup = {};

    // Support both old format (flowEdges/coEdges) and new format (concepts with connections)
    if (graphData.flowEdges) {
      // Old format
      for (const e of graphData.flowEdges) {
        if (!flowLookup[e.from]) flowLookup[e.from] = [];
        flowLookup[e.from].push({ to: e.to, netFlow: e.netFlow });
        if (!reverseLookup[e.to]) reverseLookup[e.to] = [];
        reverseLookup[e.to].push({ from: e.from, netFlow: e.netFlow });
      }
      for (const e of graphData.coEdges) {
        if (!coLookup[e.source]) coLookup[e.source] = [];
        coLookup[e.source].push({ to: e.target, weight: e.weight });
        if (!coLookup[e.target]) coLookup[e.target] = [];
        coLookup[e.target].push({ to: e.source, weight: e.weight });
      }
    } else if (graphData.concepts) {
      // New format: concepts array with embedded connections
      // Convert to nodes array for compatibility
      graphData.nodes = graphData.concepts.sort((a, b) => b.count - a.count);
      // Build co-occurrence lookup from connections and treat as flow edges too
      for (const concept of graphData.concepts) {
        if (!concept.connections) continue;
        coLookup[concept.id] = [];
        flowLookup[concept.id] = [];
        for (const conn of concept.connections) {
          coLookup[concept.id].push({ to: conn.to, weight: conn.weight });
          flowLookup[concept.id].push({ to: conn.to, netFlow: conn.weight });
          // Build reverse lookup
          if (!reverseLookup[conn.to]) reverseLookup[conn.to] = [];
          reverseLookup[conn.to].push({ from: concept.id, netFlow: conn.weight });
        }
      }
    }

    // If we have directed progression data, use it for flow/reverse lookups
    if (progressionData && progressionData.concepts) {
      flowLookup = {};
      reverseLookup = {};
      for (const c of progressionData.concepts) {
        flowLookup[c.id] = (c.leadsTo || []).map(e => ({ to: e.to, netFlow: e.weight }));
        reverseLookup[c.id] = (c.comesFrom || []).map(e => ({ from: e.from, netFlow: e.weight }));
      }
    }

    // Sort by strength
    for (const k in flowLookup) flowLookup[k].sort((a, b) => b.netFlow - a.netFlow);
    for (const k in reverseLookup) reverseLookup[k].sort((a, b) => b.netFlow - a.netFlow);
    for (const k in coLookup) coLookup[k].sort((a, b) => b.weight - a.weight);
  }

  // Get connections for a concept: flow edges first, reverse flows, then co-occurrence
  function getConnections(conceptId, exclude) {
    const seen = new Set();
    const results = [];

    // 1. Outgoing flow edges (strongest signal)
    for (const e of (flowLookup[conceptId] || [])) {
      if (exclude.includes(e.to) || seen.has(e.to)) continue;
      seen.add(e.to);
      results.push({ to: e.to, strength: e.netFlow, type: 'flow' });
    }

    // 2. Reverse flow edges (concepts that flow to this one - weaker signal)
    for (const e of (reverseLookup[conceptId] || [])) {
      if (exclude.includes(e.from) || seen.has(e.from)) continue;
      seen.add(e.from);
      results.push({ to: e.from, strength: Math.round(e.netFlow * 0.7), type: 'reverse' });
    }

    // 3. Co-occurrence edges (fallback)
    for (const e of (coLookup[conceptId] || [])) {
      if (exclude.includes(e.to) || seen.has(e.to)) continue;
      seen.add(e.to);
      results.push({ to: e.to, strength: e.weight, type: 'co' });
    }

    // Sort by strength and limit
    results.sort((a, b) => b.strength - a.strength);
    return results.slice(0, 12);
  }

  // ── Pathway computation ──

  function findPathways(startConcept, maxDepth = 4, maxPaths = 8) {
    const paths = [];
    const queue = [[startConcept]];

    while (queue.length > 0 && paths.length < maxPaths * 3) {
      const path = queue.shift();
      if (path.length > maxDepth) continue;

      const last = path[path.length - 1];
      // Use flow edges first, then co-occurrence for richer paths
      const nexts = getConnections(last, path).slice(0, 6);

      for (const next of nexts) {
        const newPath = [...path, next.to];
        if (newPath.length >= 3) {
          // Score = sum of strength values along the path
          let score = 0;
          for (let i = 0; i < newPath.length - 1; i++) {
            const conns = getConnections(newPath[i], []);
            const edge = conns.find(e => e.to === newPath[i + 1]);
            if (edge) score += edge.strength;
          }
          paths.push({ path: newPath, score });
        }
        if (newPath.length < maxDepth) {
          queue.push(newPath);
        }
      }
    }

    // Deduplicate: remove paths that are subsets of longer paths
    paths.sort((a, b) => b.score - a.score);
    const unique = [];
    for (const p of paths) {
      const key = p.path.join('→');
      const isDuplicate = unique.some(u => u.path.join('→').includes(key) || key.includes(u.path.join('→')));
      if (!isDuplicate) unique.push(p);
      if (unique.length >= maxPaths) break;
    }
    return unique;
  }

  function findTopGlobalPathways(count = 12) {
    // Find the strongest multi-step chains across all concepts
    const allPaths = [];
    const topConcepts = graphData.nodes.slice(0, 20); // Start from top 20 concepts

    for (const node of topConcepts) {
      const paths = findPathways(node.id, 5, 4);
      allPaths.push(...paths);
    }

    allPaths.sort((a, b) => {
      // Prefer longer paths with high average score
      const avgA = a.score / (a.path.length - 1);
      const avgB = b.score / (b.path.length - 1);
      // Bonus for length
      return (avgB + b.path.length * 10) - (avgA + a.path.length * 10);
    });

    // Deduplicate
    const seen = new Set();
    const unique = [];
    for (const p of allPaths) {
      const key = p.path.join('→');
      // Check if this path is a sub-path of an already selected one
      if (seen.has(key)) continue;
      const isSubset = [...seen].some(s => s.includes(key));
      if (isSubset) continue;
      seen.add(key);
      unique.push(p);
      if (unique.length >= count) break;
    }
    return unique;
  }

  // ── Pathway Builder UI ──

  function startPathway(conceptId) {
    currentPathway = [conceptId];
    renderPathway();
  }

  function extendPathway(conceptId) {
    if (currentPathway.includes(conceptId)) return;
    currentPathway.push(conceptId);
    renderPathway();
  }

  function undoPathway() {
    if (currentPathway.length > 1) {
      currentPathway.pop();
      renderPathway();
    } else {
      clearPathway();
    }
  }

  function clearPathway() {
    currentPathway = [];
    document.getElementById('pathwayDisplay').innerHTML = '<div class="pathway-empty">Select a concept below to begin</div>';
    document.getElementById('pathwayActions').style.display = 'none';
    document.getElementById('pathwayNext').style.display = 'none';
  }

  function renderPathway() {
    const display = document.getElementById('pathwayDisplay');
    const actions = document.getElementById('pathwayActions');
    const nextSection = document.getElementById('pathwayNext');
    const options = document.getElementById('pathwayOptions');

    // Render the path chain
    let html = '<div class="pathway-chain">';
    for (let i = 0; i < currentPathway.length; i++) {
      const cid = currentPathway[i];
      const node = graphData.nodes.find(n => n.id === cid);
      if (!node) continue;

      if (i > 0) {
        const conn = getConnections(currentPathway[i - 1], []).find(e => e.to === cid);
        const strength = conn ? conn.strength : 0;
        html += `<div class="pathway-arrow" title="Connection strength: ${strength}">
          <span class="arrow-line"></span>
          <span class="arrow-strength">${strength}</span>
        </div>`;
      }

      html += `<button class="pathway-node ${i === currentPathway.length - 1 ? 'pathway-node-active' : ''}"
        onclick="selectConcept('${cid}')">
        <span class="pn-he">${node.id}</span>
        <span class="pn-en">${node.en}</span>
      </button>`;
    }
    html += '</div>';

    // Show total path score
    if (currentPathway.length >= 2) {
      let totalFlow = 0;
      for (let i = 0; i < currentPathway.length - 1; i++) {
        const conn = getConnections(currentPathway[i], []).find(e => e.to === currentPathway[i + 1]);
        if (conn) totalFlow += conn.strength;
      }
      html += `<div class="pathway-score">Path strength: ${totalFlow} across ${currentPathway.length} concepts</div>`;
    }

    display.innerHTML = html;
    actions.style.display = 'flex';

    // Show next options
    const last = currentPathway[currentPathway.length - 1];
    const nexts = getConnections(last, currentPathway);

    if (nexts.length > 0) {
      nextSection.style.display = 'block';
      const maxStrength = nexts[0].strength;
      options.innerHTML = nexts.map(e => {
        const node = graphData.nodes.find(n => n.id === e.to);
        if (!node) return '';
        const barWidth = Math.min(100, (e.strength / maxStrength) * 100);
        const typeLabel = e.type === 'co' ? ' (related)' : e.type === 'reverse' ? ' (leads here)' : '';
        const barClass = e.type === 'co' ? 'no-bar no-bar-co' : e.type === 'reverse' ? 'no-bar no-bar-reverse' : 'no-bar';
        return `<button class="next-option" onclick="extendPathway('${e.to}')">
          <div class="no-info">
            <span class="no-he">${e.to}</span>
            <span class="no-en">${node.en}${typeLabel}</span>
          </div>
          <div class="no-bar-bg"><div class="${barClass}" style="width:${barWidth}%"></div></div>
          <span class="no-flow">${e.strength}</span>
        </button>`;
      }).join('');
    } else {
      nextSection.style.display = 'none';
    }
  }

  // ── Render sections ──

  // ── Visual Network Graph (Canvas) ──

  let graphNodes = []; // {id, x, y, r, en, cat, docs}
  let graphEdges = []; // {from, to, strength}
  let hoveredNode = null;
  let selectedGraphNode = null;
  let isDragging = false;
  let dragNode = null;
  let canvasW = 860, canvasH = 600;

  function renderGraph() {
    const canvas = document.getElementById('graphCanvas');
    const container = document.getElementById('graphContainer');
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;

    // Responsive canvas sizing
    canvasW = Math.min(860, container.clientWidth - 4);
    canvasH = Math.min(600, Math.max(400, canvasW * 0.7));
    canvas.width = canvasW * dpr;
    canvas.height = canvasH * dpr;
    canvas.style.width = canvasW + 'px';
    canvas.style.height = canvasH + 'px';
    ctx.scale(dpr, dpr);

    // Build graph nodes - top 30 concepts
    const topNodes = graphData.nodes.slice(0, 30);
    const maxDocs = topNodes[0]?.docs || 1;

    // Position using concentric circles by importance
    graphNodes = topNodes.map((n, i) => {
      // Tier: top 5 center, next 10 middle ring, rest outer
      let ring, angleOffset;
      if (i < 5) { ring = 0.18; angleOffset = i * (Math.PI * 2 / 5); }
      else if (i < 15) { ring = 0.38; angleOffset = (i - 5) * (Math.PI * 2 / 10) + 0.3; }
      else { ring = 0.55; angleOffset = (i - 15) * (Math.PI * 2 / 15) + 0.15; }

      const r = 14 + (n.docs / maxDocs) * 22;
      return {
        id: n.id,
        en: n.en,
        cat: n.cat,
        docs: n.docs,
        x: canvasW / 2 + Math.cos(angleOffset) * (canvasW * ring),
        y: canvasH / 2 + Math.sin(angleOffset) * (canvasH * ring),
        r,
        vx: 0, vy: 0
      };
    });

    // Build edges - top flow edges between visible nodes
    const nodeIds = new Set(graphNodes.map(n => n.id));
    graphEdges = graphData.flowEdges
      .filter(e => nodeIds.has(e.from) && nodeIds.has(e.to))
      .slice(0, 80)
      .map(e => ({ from: e.from, to: e.to, strength: e.netFlow }));

    // Force-directed simulation
    for (let iter = 0; iter < 150; iter++) {
      const cooling = 1 - iter / 200; // Cool down over time

      // Repulsion between all nodes
      for (let i = 0; i < graphNodes.length; i++) {
        for (let j = i + 1; j < graphNodes.length; j++) {
          const a = graphNodes[i], b = graphNodes[j];
          let dx = a.x - b.x, dy = a.y - b.y;
          let dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const minDist = a.r + b.r + 30;
          // Always repel somewhat, strongly when overlapping
          const force = dist < minDist
            ? (minDist - dist) * 0.5
            : -0.5; // slight repulsion even when far
          if (force > 0 || dist < 200) {
            const f = Math.max(force, 800 / (dist * dist)) * cooling;
            const fx = (dx / dist) * f, fy = (dy / dist) * f;
            a.vx += fx; a.vy += fy;
            b.vx -= fx; b.vy -= fy;
          }
        }
      }

      // Attraction along edges
      for (const edge of graphEdges) {
        const a = graphNodes.find(n => n.id === edge.from);
        const b = graphNodes.find(n => n.id === edge.to);
        if (!a || !b) continue;
        let dx = b.x - a.x, dy = b.y - a.y;
        let dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const idealDist = 80 + (a.r + b.r);
        const force = (dist - idealDist) * 0.008 * cooling;
        const fx = (dx / dist) * force, fy = (dy / dist) * force;
        a.vx += fx; a.vy += fy;
        b.vx -= fx; b.vy -= fy;
      }

      // Center gravity
      for (const n of graphNodes) {
        n.vx += (canvasW / 2 - n.x) * 0.003 * cooling;
        n.vy += (canvasH / 2 - n.y) * 0.003 * cooling;
      }

      // Apply velocity with damping
      for (const n of graphNodes) {
        n.x += n.vx * 0.4;
        n.y += n.vy * 0.4;
        n.vx *= 0.75;
        n.vy *= 0.75;
        // Keep in bounds with padding
        n.x = Math.max(n.r + 10, Math.min(canvasW - n.r - 10, n.x));
        n.y = Math.max(n.r + 10, Math.min(canvasH - n.r - 10, n.y));
      }
    }

    drawGraph(ctx);

    // Interaction
    canvas.onmousemove = (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left, my = e.clientY - rect.top;
      if (isDragging && dragNode) {
        dragNode.x = Math.max(dragNode.r, Math.min(canvasW - dragNode.r, mx));
        dragNode.y = Math.max(dragNode.r, Math.min(canvasH - dragNode.r, my));
        drawGraph(ctx);
        return;
      }
      const prev = hoveredNode;
      hoveredNode = graphNodes.find(n => {
        const dx = n.x - mx, dy = n.y - my;
        return Math.sqrt(dx * dx + dy * dy) <= n.r + 4;
      }) || null;
      if (hoveredNode !== prev) {
        canvas.style.cursor = hoveredNode ? 'pointer' : 'default';
        drawGraph(ctx);
      }
    };

    canvas.onmousedown = (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left, my = e.clientY - rect.top;
      const node = graphNodes.find(n => {
        const dx = n.x - mx, dy = n.y - my;
        return Math.sqrt(dx * dx + dy * dy) <= n.r + 4;
      });
      if (node) {
        isDragging = true;
        dragNode = node;
      }
    };

    canvas.onmouseup = (e) => {
      if (isDragging && dragNode) {
        const rect = canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left, my = e.clientY - rect.top;
        const dx = dragNode.x - mx, dy = dragNode.y - my;
        // If barely moved, treat as click
        if (Math.sqrt(dx * dx + dy * dy) < 5) {
          selectedGraphNode = dragNode;
          startPathway(dragNode.id);
          selectConcept(dragNode.id);
          drawGraph(ctx);
        }
      }
      isDragging = false;
      dragNode = null;
    };

    canvas.onclick = (e) => {
      if (isDragging) return;
      const rect = canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left, my = e.clientY - rect.top;
      const node = graphNodes.find(n => {
        const dx = n.x - mx, dy = n.y - my;
        return Math.sqrt(dx * dx + dy * dy) <= n.r + 4;
      });
      if (node) {
        selectedGraphNode = node;
        startPathway(node.id);
        selectConcept(node.id);
        drawGraph(ctx);
      }
    };

    // Touch support
    canvas.ontouchstart = (e) => {
      e.preventDefault();
      const touch = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      const mx = touch.clientX - rect.left, my = touch.clientY - rect.top;
      const node = graphNodes.find(n => {
        const dx = n.x - mx, dy = n.y - my;
        return Math.sqrt(dx * dx + dy * dy) <= n.r + 8;
      });
      if (node) {
        selectedGraphNode = node;
        startPathway(node.id);
        selectConcept(node.id);
        drawGraph(ctx);
      }
    };
  }

  const catColors = {
    core: '#1a365d', middos: '#9b2c2c', process: '#276749',
    torah: '#744210', life: '#553c9a', nanach: '#c4a265',
    place: '#2b6cb0', time: '#b7791f'
  };

  function drawGraph(ctx) {
    ctx.clearRect(0, 0, canvasW, canvasH);

    // Draw edges
    const maxStr = graphEdges[0]?.strength || 1;
    for (const edge of graphEdges) {
      const from = graphNodes.find(n => n.id === edge.from);
      const to = graphNodes.find(n => n.id === edge.to);
      if (!from || !to) continue;

      const isHighlighted = (hoveredNode && (hoveredNode.id === edge.from || hoveredNode.id === edge.to)) ||
        (selectedGraphNode && (selectedGraphNode.id === edge.from || selectedGraphNode.id === edge.to));

      const alpha = isHighlighted ? 0.6 : 0.08 + (edge.strength / maxStr) * 0.15;
      const width = isHighlighted ? 2.5 : 0.5 + (edge.strength / maxStr) * 1.5;

      ctx.beginPath();
      ctx.moveTo(from.x, from.y);
      ctx.lineTo(to.x, to.y);
      ctx.strokeStyle = isHighlighted ? '#c4a265' : `rgba(26, 54, 93, ${alpha})`;
      ctx.lineWidth = width;
      ctx.stroke();

      // Arrow head
      if (isHighlighted || edge.strength > maxStr * 0.3) {
        const dx = to.x - from.x, dy = to.y - from.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist > 0) {
          const ux = dx / dist, uy = dy / dist;
          const ax = to.x - ux * (to.r + 4), ay = to.y - uy * (to.r + 4);
          const arrowSize = isHighlighted ? 8 : 5;
          ctx.beginPath();
          ctx.moveTo(ax, ay);
          ctx.lineTo(ax - ux * arrowSize - uy * arrowSize * 0.4, ay - uy * arrowSize + ux * arrowSize * 0.4);
          ctx.lineTo(ax - ux * arrowSize + uy * arrowSize * 0.4, ay - uy * arrowSize - ux * arrowSize * 0.4);
          ctx.closePath();
          ctx.fillStyle = isHighlighted ? '#c4a265' : `rgba(26, 54, 93, ${alpha + 0.1})`;
          ctx.fill();
        }
      }
    }

    // Draw nodes
    for (const node of graphNodes) {
      const isHovered = hoveredNode === node;
      const isSelected = selectedGraphNode && selectedGraphNode.id === node.id;
      const isConnected = hoveredNode && graphEdges.some(e =>
        (e.from === hoveredNode.id && e.to === node.id) || (e.to === hoveredNode.id && e.from === node.id));

      const color = catColors[node.cat] || '#1a365d';
      const r = isHovered ? node.r + 3 : node.r;

      // Glow for selected/hovered
      if (isSelected || isHovered) {
        ctx.beginPath();
        ctx.arc(node.x, node.y, r + 6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(196, 162, 101, 0.3)';
        ctx.fill();
      }

      // Node circle
      ctx.beginPath();
      ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
      const dimmed = hoveredNode && !isHovered && !isConnected;
      ctx.fillStyle = dimmed ? '#ddd' : isSelected ? '#c4a265' : color;
      ctx.fill();

      if (isSelected) {
        ctx.strokeStyle = '#1a365d';
        ctx.lineWidth = 3;
        ctx.stroke();
      }

      // Label
      const fontSize = Math.max(9, Math.min(14, node.r * 0.65));
      ctx.font = `bold ${fontSize}px 'Frank Ruhl Libre', serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = dimmed ? '#999' : 'white';
      ctx.fillText(node.id, node.x, node.y - 1);

      // English label below for larger nodes
      if (node.r > 22 || isHovered) {
        ctx.font = `${Math.max(7, fontSize * 0.55)}px 'Open Sans', sans-serif`;
        ctx.fillStyle = dimmed ? '#bbb' : 'rgba(255,255,255,0.8)';
        ctx.fillText(node.en, node.x, node.y + fontSize * 0.55);
      }
    }

    // Tooltip for hovered node
    if (hoveredNode) {
      const n = hoveredNode;
      const tipW = 160, tipH = 36;
      const tipX = Math.min(canvasW - tipW - 5, Math.max(5, n.x - tipW / 2));
      const tipY = n.y - n.r - tipH - 10;

      ctx.fillStyle = 'rgba(26, 54, 93, 0.92)';
      ctx.beginPath();
      ctx.roundRect(tipX, tipY, tipW, tipH, 6);
      ctx.fill();

      ctx.font = "bold 11px 'Open Sans', sans-serif";
      ctx.fillStyle = '#e8d5a3';
      ctx.textAlign = 'center';
      ctx.fillText(`${n.en} - ${n.id}`, tipX + tipW / 2, tipY + 14);
      ctx.font = "10px 'Open Sans', sans-serif";
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.fillText(`${n.docs} teachings`, tipX + tipW / 2, tipY + 27);
    }
  }

  function renderTopPathways() {
    const grid = document.getElementById('pathwaysGrid');

    // Use progression pathways if available, otherwise computed ones
    let topPaths;
    if (progressionData && progressionData.pathways && progressionData.pathways.length > 0) {
      topPaths = progressionData.pathways.slice(0, 12).map(p => ({
        path: p.path,
        score: p.strength * (p.path.length - 1)
      }));
    } else {
      topPaths = findTopGlobalPathways(12);
    }

    // Get concept lookup from progression or graph data
    const conceptLookup = {};
    if (progressionData && progressionData.concepts) {
      progressionData.concepts.forEach(c => { conceptLookup[c.id] = c; });
    }
    if (graphData.nodes) {
      graphData.nodes.forEach(n => { if (!conceptLookup[n.id]) conceptLookup[n.id] = n; });
    }

    grid.innerHTML = topPaths.map((p, idx) => {
      const nodes = p.path.map(id => {
        const c = conceptLookup[id];
        return c ? { id, he: c.he || id, en: c.en || '' } : { id, he: id, en: '' };
      });

      const chainHtml = nodes.map((n, i) => {
        let html = `<span class="tp-concept" onclick="startPathway('${n.id}');selectConcept('${n.id}')">${n.he}</span>`;
        if (i < nodes.length - 1) html += '<span class="tp-arrow">→</span>';
        return html;
      }).join('');

      const enChain = nodes.map(n => n.en).join(' → ');
      const avgFlow = Math.round(p.score / (p.path.length - 1));

      return `<div class="pathway-card" onclick="loadPathway(${JSON.stringify(p.path)})">
        <div class="pc-chain" dir="rtl">${chainHtml}</div>
        <div class="pc-english">${enChain}</div>
        <div class="pc-meta">${p.path.length} steps &middot; strength: ${avgFlow}</div>
      </div>`;
    }).join('');
  }

  function loadPathway(pathArray) {
    currentPathway = pathArray;
    renderPathway();
    document.getElementById('pathwayBuilder').scrollIntoView({ behavior: 'smooth' });
  }

  function renderCloud() {
    const cloud = document.getElementById('conceptCloud');
    const maxOcc = graphData.nodes[0]?.count || 1;

    const cats = { core: 'Core / יסודות', middos: 'Character / מדות', process: 'Process / תהליכים',
      torah: 'Torah / תורה', life: 'Life / חיים', nanach: 'Na Nach', place: 'Places', time: 'Times' };

    const grouped = {};
    for (const node of graphData.nodes) {
      if (!grouped[node.cat]) grouped[node.cat] = [];
      grouped[node.cat].push(node);
    }

    let html = '';
    for (const [cat, label] of Object.entries(cats)) {
      const nodes = grouped[cat];
      if (!nodes || nodes.length === 0) continue;

      html += `<div class="cat-group"><h4 class="cat-label">${label}</h4><div class="cat-chips">`;
      for (const node of nodes) {
        const size = 0.7 + (node.count / maxOcc) * 1.0;
        const totalDocs = graphData.meta?.totalDocuments || graphData.totalDocuments || 22044;
        const opacity = 0.5 + (node.count / totalDocs) * 2;
        html += `<button class="concept-chip" onclick="startPathway('${node.id}');selectConcept('${node.id}')"
          style="font-size:${size}em; opacity:${Math.min(1, opacity)};"
          title="${node.en}: ${node.count} occurrences in ${node.count} texts">
          <span class="chip-he">${node.id}</span>
          <span class="chip-en">${node.en}</span>
          <span class="chip-count">${node.count}</span>
        </button>`;
      }
      html += '</div></div>';
    }

    cloud.innerHTML += html;
  }

  function selectConcept(conceptId) {
    const node = graphData.nodes.find(n => n.id === conceptId);
    if (!node) return;

    // Header
    document.getElementById('conceptHeader').innerHTML = `
      <button class="back-to-cloud" onclick="document.getElementById('conceptView').style.display='none';document.getElementById('conceptCloud').scrollIntoView({behavior:'smooth'});">&larr; Back to all concepts</button>
      <div class="ch-hebrew">${node.id}</div>
      <div class="ch-english">${node.en}</div>
      <div class="ch-stats">${node.count.toLocaleString()} texts contain this concept</div>
      <button class="start-path-btn" onclick="startPathway('${node.id}')">Start pathway from here</button>
    `;

    // Flow: What leads here
    const leadsHere = graphData.flowEdges
      .filter(e => e.to === conceptId)
      .sort((a, b) => b.netFlow - a.netFlow)
      .slice(0, 8);

    document.getElementById('leadsHere').innerHTML = leadsHere.map(e => {
      const srcNode = graphData.nodes.find(n => n.id === e.from);
      if (!srcNode) return '';
      return `<button class="flow-chip flow-incoming" onclick="selectConcept('${e.from}')">
        <span class="flow-he">${e.from}</span>
        <span class="flow-en">${srcNode.en}</span>
        <span class="flow-strength">${e.netFlow}</span>
      </button>`;
    }).join('') || '<div class="flow-empty">No incoming flows</div>';

    // Center
    document.getElementById('centerConcept').innerHTML = `
      <div class="center-bubble">
        <div class="center-he">${node.id}</div>
        <div class="center-en">${node.en}</div>
      </div>
    `;

    // Flow: Where this leads
    const leadsTo = graphData.flowEdges
      .filter(e => e.from === conceptId)
      .sort((a, b) => b.netFlow - a.netFlow)
      .slice(0, 8);

    document.getElementById('leadsTo').innerHTML = leadsTo.map(e => {
      const tgtNode = graphData.nodes.find(n => n.id === e.to);
      if (!tgtNode) return '';
      return `<button class="flow-chip flow-outgoing" onclick="selectConcept('${e.to}')">
        <span class="flow-he">${e.to}</span>
        <span class="flow-en">${tgtNode.en}</span>
        <span class="flow-strength">${e.netFlow}</span>
      </button>`;
    }).join('') || '<div class="flow-empty">No outgoing flows</div>';

    // Multi-step pathways from this concept
    const pathways = findPathways(conceptId, 5, 6);
    const pathwaysEl = document.getElementById('conceptPathways');
    if (pathways.length > 0) {
      pathwaysEl.innerHTML = `
        <h3>Pathways from ${node.en} / מסלולים מ${node.id}</h3>
        <div class="mini-pathways">
          ${pathways.map(p => {
            const chainNodes = p.path.map(id => {
              const n = graphData.nodes.find(x => x.id === id);
              return n ? n.id : id;
            });
            const enChain = p.path.map(id => {
              const n = graphData.nodes.find(x => x.id === id);
              return n ? n.en : id;
            }).join(' → ');
            return `<button class="mini-path" onclick="loadPathway(${JSON.stringify(p.path)})">
              <div class="mp-chain" dir="rtl">${chainNodes.join(' → ')}</div>
              <div class="mp-en">${enChain}</div>
            </button>`;
          }).join('')}
        </div>
      `;
    } else {
      pathwaysEl.innerHTML = '';
    }

    // Teachings
    const teachings = graphData.teachings[conceptId] || [];
    document.getElementById('teachingsList').innerHTML = teachings.map(t => `
      <a class="teaching-card" href="${t.url}">
        <div class="tc-book">${t.book} / ${t.bookEn}</div>
        <div class="tc-title">${t.title}</div>
        <div class="tc-snippet" dir="rtl">${t.snippet}</div>
        <div class="tc-meta">${t.count} mentions${t.hasEnglish ? ' &middot; English available' : ''}</div>
      </a>
    `).join('');

    // Co-occurring concepts
    const coRelated = graphData.coEdges
      .filter(e => e.source === conceptId || e.target === conceptId)
      .sort((a, b) => b.weight - a.weight)
      .slice(0, 12)
      .map(e => {
        const other = e.source === conceptId ? e.target : e.source;
        const otherNode = graphData.nodes.find(n => n.id === other);
        return otherNode ? { ...otherNode, weight: e.weight } : null;
      })
      .filter(Boolean);

    document.getElementById('relatedConcepts').innerHTML = coRelated.map(r => `
      <button class="related-chip" onclick="selectConcept('${r.id}')">
        ${r.id} (${r.en}) <span class="rc-weight">${r.weight}</span>
      </button>
    `).join('');

    document.getElementById('conceptView').style.display = 'block';
    document.getElementById('conceptView').scrollIntoView({ behavior: 'smooth' });
  }

  loadGraph();
</script>

