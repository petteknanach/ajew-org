---
const pageTitle = "Donate - Support A Jew";
const pageDescription = "Support ajew.org and spread Rabbi Nachman's light";
---

<style>
  .page-header {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: white;
    padding: 5rem 2rem;
    text-align: center;
  }
  .page-header h1 { font-family: var(--font-hebrew); font-size: 2.5rem; margin-bottom: 0.5rem; }
  .container { max-width: 800px; margin: 0 auto; padding: 0 2rem; }
  .content { padding: 4rem 0; }
  .donate-card {
    background: white;
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    text-align: center;
    margin-bottom: 2rem;
  }
  .donate-btn {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: white;
    border: none;
    padding: 1.25rem 3rem;
    font-size: 1.3rem;
    font-weight: 600;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-block;
    margin: 1rem 0;
  }
  .donate-btn:hover { transform: scale(1.05); box-shadow: 0 8px 25px rgba(0,0,0,0.2); }
  .info-section { background: #f7f5f0; padding: 3rem; border-radius: 16px; margin-top: 2rem; }
  .info-section h2 { color: #059669; margin-bottom: 1rem; }
  .info-section p { color: #555; line-height: 1.8; }
  .nav-links { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; }
  .nav-link { color: white; text-decoration: none; padding: 0.5rem 1rem; background: rgba(255,255,255,0.2); border-radius: 8px; }
  .nav-link:hover { background: rgba(255,255,255,0.3); }
</style>

<section class="page-header">
  <h1>💖 Support A Jew</h1>
  <p>Your generosity spreads Rabbi Nachman's light to Jews worldwide</p>
  <div class="nav-links">
    <a href="/teachings" class="nav-link">📖 Browse Teachings</a>
    <a href="/subscribe" class="nav-link">🗝️ Membership</a>
  </div>
</section>

<main class="container">
  <section class="content">
    <div class="donate-card">
      <h2 style="color: #1a365d; margin-bottom: 1rem;">🙏 Make a Donation</h2>
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 2rem;">
        Every donation, no matter the size, helps keep ajew.org running and brings more Jews closer to Rabbi Nachman's wisdom.
      </p>
      <button onclick="donate()" class="donate-btn">🙏 Donate Now</button>
      <p style="color: #888; font-size: 0.9rem; margin-top: 1rem;">
        Secure payment via Stripe • Any amount you choose
      </p>
    </div>

    <div class="info-section">
      <h2>🌟 Why Your Donation Matters</h2>
      <p>
        <strong>A Jew is precious.</strong> Rabbi Nachman taught that every soul is a world unto itself. 
        By supporting ajew.org, you're helping bring Torah, joy, and hitbodedut (personal prayer) to Jews 
        around the world — especially those who are isolated, seeking, or looking for meaning.
      </p>
      <p style="margin-top: 1rem;">
        <strong>What your donation supports:</strong><br>
        • Server costs and site maintenance<br>
        • New translations and content<br>
        • Community programs and events<br>
        • Spreading Na Nach Nachma Nachman MeUman
      </p>
      <p style="margin-top: 1rem; color: #059669; font-weight: 600;">
        תְּשֻׁבָה תְּעוּדָה בְּכָל הַדְּבָרִים
        <br>— Return and testimony in all matters
      </p>
    </div>

    <div class="donate-card" style="margin-top: 2rem; background: #f0fdf4;">
      <h2 style="color: #059669; margin-bottom: 1rem;">🗝️ Annual Membership</h2>
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 1.5rem;">
        Get full access to the community chat and commenting for just <strong>$1/year</strong>
      </p>
      <a href="https://buy.stripe.com/00w5kD89Ld3Y9F1fsUfUQ03" class="donate-btn" style="background: #1a365d;" target="_blank">🗝️ Join for $1/year</a>
    </div>
  </section>
</main>

<script>
function donate() {
  // Direct Stripe checkout link - opens in same window for smoother experience
  window.location.href = 'https://buy.stripe.com/3cI3cvey95Bw9F13KcfUQ02';
}
</script>

---
import Layout from '../layouts/Layout.astro';
