---
import Layout from '../../../../layouts/Layout.astro';
import Comments from '../../../../components/Comments.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const paths = [];
  for (let torah = 1; torah <= 24; torah++) {
    paths.push({ params: { part: "1", torah: String(torah) } });
  }
  for (let torah = 1; torah <= 11; torah++) {
    paths.push({ params: { part: "2", torah: String(torah) } });
  }
  for (let torah = 1; torah <= 18; torah++) {
    paths.push({ params: { part: "3", torah: String(torah) } });
  }
  for (let torah = 1; torah <= 40; torah++) {
    paths.push({ params: { part: "4", torah: String(torah) } });
  }
  for (let torah = 1; torah <= 8; torah++) {
    paths.push({ params: { part: "5", torah: String(torah) } });
  }
  return paths;
}

const { part, torah } = Astro.params;
const semanticH1 = ["1/1","1/2","1/3","1/4","1/5","1/6","1/7","1/8","1/9","1/10","1/11","1/12","1/14","1/15","1/17","1/18","1/19","1/20","1/21","1/22","1/23","2/1","2/3","2/4","2/5","2/6","2/7","2/8","2/9","2/10","2/11","3/1","3/2","3/3","3/4","3/5","3/6","3/7","3/8","3/9","3/10","3/11","3/12","3/13","3/14","3/15","3/16","3/17","3/18","4/1","4/2","4/3","4/4","4/5","4/6","4/7","4/8","4/9","4/10","4/11","4/12","4/13","4/14","4/15","4/16","4/17","4/18","4/19","4/20","4/21","4/22","4/23","4/24","4/25","4/26","4/27","4/28","4/29","4/30","4/31","4/32","4/33","4/35","4/36","4/37","4/38","4/39","4/40","5/4","5/5","5/6","5/7","5/8","1/13","1/16","1/24","2/2","4/34","5/1","5/2","5/3"].includes(`${part}/${torah}`);
const partNum = parseInt(part);
const torahNum = parseInt(torah);

let torahData = null;
let error = null;

try {
  const filePath = path.join(process.cwd(), `public/reader/likutay-nanach/volume-${part}/chapter-${torahNum}.json`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = `Chapter ${torahNum} not found`;
}

if (!torahData && !error) error = 'Content not available';

const volumeNames: Record<string, string> = {
  '1': '\u05E0 - Na - Al HaTorah',
  '2': '\u05E0\u05D7 - NaCh - Neviim uKetuvim',
  '3': '\u05E0\u05D7\u05DE - NaChMa - Torah Shebal Peh',
  '4': '\u05E0\u05D7\u05DE\u05DF - NaChMaN',
  '5': '\u05DE\u05D0\u05D5\u05DE\u05DF - MayUman',
};
const volName = volumeNames[part] || 'Volume ' + part;

const pageTitle = torahData
  ? `${torahData.title} - ${volName} - Likutay Nanach`
  : 'Chapter Not Found';
---
<Layout title={pageTitle} lang="he" hreflangs={['he']}>
  <main id="reader-container" data-book="likutay-nanach" data-part={part} data-torah={torah}>
    {error ? (
      <div class="error-message">
        <h2>{error}</h2>
        <p><a href={`/reader/likutay-nanach/${partNum}`}>Book Index</a>
        <a href="/reader">&larr; Back to Library</a></p>
      </div>
    ) : (
      <div id="reader-content">
        <div class="reader-header">
          <div class="book-title">{'\u05DC\u05D9\u05E7\u05D5\u05D8\u05D9 \u05E0 \u05E0\u05D7 \u05E0\u05D7\u05DE \u05E0\u05D7\u05DE\u05DF'}</div>
          <div class="torah-title">{volName}</div>
          {semanticH1 ? <h1 class="torah-number" style="font: inherit; margin: 0; color: inherit;">{torahData.title}</h1> : <div class="torah-number">{torahData.title}</div>}
        </div>
        <div id="segments-container">
          {torahData.segments.map(seg => (
            <div class="segment" id={`seg-${seg.index}`} data-index={seg.index}>
              {(seg.he_nikud || seg.he) && <div class="he" dir="rtl">{seg.he_nikud || seg.he}</div>}
              {seg.en && <div class="en">{seg.en}</div>}
            </div>
          ))}
        </div>
      </div>
    )}
  </main>
  <script defer src="/reader-script.js?v=parsha-author-20261018-r1"></script>

      {torahData && (
        <Comments teachingId={`likutay-nanach-${part}-${torah}`} teachingTitle={`likutay-nanach ${part}:${torah}${torahData?.title ? ' — ' + torahData.title : ''}`} />
      )}
</Layout>
