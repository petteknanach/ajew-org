  <text x="350" y="280" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a3c5e">After Tefillah (ֲ§18ג€“19)</text>

  <!-- N'filas Apayim -->
  <rect x="60" y="295" width="270" height="90" rx="6" fill="#fff" stroke="#6b1d1d" stroke-width="1.5"/>
  <text x="195" y="317" text-anchor="middle" font-size="12" fill="#6b1d1d" font-weight="bold">ֲ§18: N'FILAS APAYIM</text>
  <text x="195" y="337" text-anchor="middle" font-size="11" fill="#555">Viduy ֲ· Bushah before Hashem</text>
  <text x="195" y="355" text-anchor="middle" font-size="10.5" fill="#555">N'kudah illuminates lower worlds</text>
