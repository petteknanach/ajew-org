---
// Compact Yahrzeit Display for Top Left Corner
// Dynamically shows today's and tomorrow's yahrzeits based on Hebrew date
// Only appears when there are actual yahrzeits to display
---

<div class="compact-yahrzeit collapsed" id="compactYahrzeit" style="display: none;">
  <!-- Toggle button for mobile - shows icon when collapsed -->
  <button class="toggle-btn mobile-only" onclick="toggleYahrzeit()" aria-label="Toggle yahrzeit box">
    <span class="collapsed-icon">🕯️</span>
    <span class="expanded-icon">×</span>
  </button>
  
  <!-- Loading state -->
  <div id="yahrzeitLoading" class="yahrzeit-loading">
    <span class="loading-icon">🕯️</span>
  </div>
  
  <!-- Today's Yahrzeits -->
  <div id="todaySection" class="yahrzeit-section today-section" style="display: none;">
    <div class="section-header">
      <span class="yahrzeit-icon">🕯️</span>
      <h4 class="section-title">Today: <span id="todayHebrew"></span></h4>
    </div>
    <div id="todayList" class="tzaddikim-list"></div>
  </div>
  
  <!-- Tomorrow's Yahrzeits -->
  <div id="tomorrowSection" class="yahrzeit-section tomorrow-section" style="display: none;">
    <div class="section-header">
      <span class="yahrzeit-icon">📅</span>
      <h4 class="section-title">Tomorrow: <span id="tomorrowHebrew"></span></h4>
    </div>
    <div id="tomorrowList" class="tzaddikim-list"></div>
  </div>
  
  <!-- Upcoming Important Dates -->
  <div id="upcomingSection" class="yahrzeit-section upcoming-section" style="display: none;">
    <div class="section-header">
      <span class="yahrzeit-icon">⭐</span>
      <h4 class="section-title">Upcoming: <span id="upcomingLabel"></span></h4>
    </div>
    <div id="upcomingList" class="tzaddikim-list"></div>
  </div>
</div>

<script>
  // Hebrew month names mapping (matching Hebcal API output)
  const hebrewMonths = {
    1: 'Nisan', 2: 'Iyyar', 3: 'Sivan', 4: 'Tamuz',
    5: 'Av', 6: 'Elul', 7: 'Tishrei', 8: 'Cheshvan',
    9: 'Kislev', 10: 'Tevet', 11: "Sh'vat", 12: 'Adar',
    13: 'Adar II'
  };

  // Important dates to always show (upcoming)
  const importantDates = [
    { month: 'Nisan', day: 1, type: 'birth', name: 'Birth of Rabbainu Na Nach Nachma Nachman', hebrew_name: 'הולדת רבינו נ נח נחמ נחמן', description: 'Rosh Chodesh Nisan' },
    { month: 'Nisan', day: 15, type: 'special', name: 'Pesach', hebrew_name: 'פסח', description: 'First night of Passover' },
    { month: 'Iyyar', day: 18, type: 'special', name: 'Lag BaOmer', hebrew_name: 'ל"ג בעומר', description: 'Hilula of Rabbi Shimon bar Yochai' },
    { month: 'Sivan', day: 6, type: 'special', name: 'Shavuos', hebrew_name: 'שבועות', description: 'Giving of the Torah' },
    { month: 'Tishrei', day: 1, type: 'special', name: 'Rosh Hashana', hebrew_name: 'ראש השנה', description: 'Be with Rabbainu in Uman!' },
    { month: 'Tishrei', day: 10, type: 'special', name: 'Yom Kippur', hebrew_name: 'יום כיפור', description: 'Day of Atonement' },
    { month: 'Tishrei', day: 15, type: 'special', name: 'Sukkos', hebrew_name: 'סוכות', description: 'Festival of Tabernacles' },
    { month: 'Kislev', day: 25, type: 'special', name: 'Chanukah', hebrew_name: 'חנוכה', description: 'Festival of Lights' },
    { month: 'Adar', day: 14, type: 'special', name: 'Purim', hebrew_name: 'פורים', description: 'Na Nach Nachma Nachman!' },
    // Purim Katan of Tiberias - 5 days commemorating the miracle of R' Chaim Abulafia (~1743)
    { month: 'Kislev', day: 4, type: 'special', name: 'Purim Tiberias', hebrew_name: 'פורים טבריה', description: "Miracle of Tiberias - R' Chaim Abulafia" },
    { month: 'Sivan', day: 13, type: 'special', name: 'Purim Tiberias', hebrew_name: 'פורים טבריה', description: "Miracle of Tiberias - R' Chaim Abulafia" },
    { month: 'Tamuz', day: 14, type: 'special', name: 'Purim Tiberias', hebrew_name: 'פורים טבריה', description: "Miracle of Tiberias - R' Chaim Abulafia" },
    { month: 'Tamuz', day: 15, type: 'special', name: 'Purim Tiberias', hebrew_name: 'פורים טבריה', description: "Miracle of Tiberias - R' Chaim Abulafia" },
    { month: 'Elul', day: 7, type: 'special', name: 'Purim Tiberias', hebrew_name: 'פורים טבריה', description: "Miracle of Tiberias - R' Chaim Abulafia" },
    // 23 Sivan - Second Letters of Mordechai and Esther (Esther 8:9)
    { month: 'Sivan', day: 23, type: 'special', name: 'Second Letters of Mordechai & Esther', hebrew_name: 'כתב השנית - מרדכי ואסתר', description: 'Jews permitted to defend themselves (Esther 8:9)' },
  ];

  let tzaddikimDatabase = [];

  // Fetch Hebrew date from Hebcal API
  async function getHebrewDate(date = new Date()) {
    const dateStr = date.toISOString().split('T')[0];
    const response = await fetch(`https://www.hebcal.com/converter?cfg=json&date=${dateStr}&g2h=1`);
    const data = await response.json();
    return {
      hebrew: data.hebrew,
      month: data.hm,
      day: data.hd,
      year: data.hy,
      monthIndex: data.monthIndex
    };
  }

  // Load tzaddikim database
  async function loadDatabase() {
    try {
      const response = await fetch('/data/tzaddikim-database-complete.json');
      const data = await response.json();
      tzaddikimDatabase = data.all_tzaddikim || [];
    } catch (e) {
      console.error('Failed to load tzaddikim database:', e);
    }
  }

  // Find yahrzeits for a specific Hebrew date
  // In a leap year: "Adar" entries show in both Adar I and Adar II (covers both halachic opinions)
  // "Adar II" entries show only in Adar II
  function findYahrzeits(month, day) {
    return tzaddikimDatabase.filter(tz => {
      const tzMonth = tz.yahrzeit_month;
      const tzDay = parseInt(tz.yahrzeit_day);
      if (tzDay !== day) return false;
      // Exact match
      if (tzMonth === month) return true;
      // In Adar II: also show "Adar" entries (covers the opinion that yahrzeits are in Adar II)
      if (month === 'Adar II' && tzMonth === 'Adar') return true;
      return false;
    });
  }

  // Find important dates for a specific Hebrew date
  function findImportantDates(month, day) {
    return importantDates.filter(d => d.month === month && d.day === day);
  }

  // Month order for calculating upcoming dates across month boundaries
  const monthOrder = ['Nisan', 'Iyyar', 'Sivan', 'Tamuz', 'Av', 'Elul',
    'Tishrei', 'Cheshvan', 'Kislev', 'Tevet', "Sh'vat", 'Adar', 'Adar II'];
  const daysInMonth = { 'Nisan': 30, 'Iyyar': 29, 'Sivan': 30, 'Tamuz': 29,
    'Av': 30, 'Elul': 29, 'Tishrei': 30, 'Cheshvan': 29, 'Kislev': 30,
    'Tevet': 29, "Sh'vat": 30, 'Adar': 29, 'Adar II': 29 };

  // Check if an important date is coming up within 7 days (handles cross-month)
  function findUpcomingImportantDates(todayMonth, todayDay) {
    const upcoming = [];
    const todayMonthIdx = monthOrder.indexOf(todayMonth);
    if (todayMonthIdx < 0) return upcoming;

    for (const date of importantDates) {
      const dateMonthIdx = monthOrder.indexOf(date.month);
      if (dateMonthIdx < 0) continue;

      let daysUntil;
      if (date.month === todayMonth) {
        daysUntil = date.day - todayDay;
      } else if (dateMonthIdx === todayMonthIdx + 1 || (todayMonthIdx === monthOrder.length - 1 && dateMonthIdx === 0)) {
        // Next month
        const daysLeftThisMonth = (daysInMonth[todayMonth] || 30) - todayDay;
        daysUntil = daysLeftThisMonth + date.day;
      } else {
        continue; // Too far away
      }

      if (daysUntil > 0 && daysUntil <= 7) {
        upcoming.push({
          ...date,
          daysUntil,
          dateLabel: `${date.day} ${date.month} (in ${daysUntil} days)`
        });
      }
    }
    return upcoming.sort((a, b) => a.daysUntil - b.daysUntil);
  }

  // Render a tzaddik entry
  function renderTzaddikLink(tzaddik, isImportant = false) {
    const div = document.createElement('div');
    div.className = `tzaddik-link${isImportant ? ' upcoming-event' : ''}`;
    
    let html = `<span class="tzaddik-name">${tzaddik.name}</span>`;
    if (tzaddik.hebrew_name) {
      html += `<span class="tzaddik-hebrew" dir="rtl">${tzaddik.hebrew_name}</span>`;
    }
    if (tzaddik.description) {
      html += `<span class="event-description">${tzaddik.description}</span>`;
    }
    if (tzaddik.type === 'birth') {
      html += `<span class="event-type birth-badge">Birthday</span>`;
    } else if (tzaddik.type === 'special') {
      html += `<span class="event-type special-badge">Holiday</span>`;
    }
    
    div.innerHTML = html;
    return div;
  }

  // Main initialization
  async function initYahrzeit() {
    try {
      await loadDatabase();
      
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      
      const todayHeb = await getHebrewDate(today);
      const tomorrowHeb = await getHebrewDate(tomorrow);
      
      // Find yahrzeits for today and tomorrow
      const todayYahrzeits = findYahrzeits(todayHeb.month, todayHeb.day);
      const tomorrowYahrzeits = findYahrzeits(tomorrowHeb.month, tomorrowHeb.day);
      const todayImportant = findImportantDates(todayHeb.month, todayHeb.day);
      const tomorrowImportant = findImportantDates(tomorrowHeb.month, tomorrowHeb.day);
      const upcomingImportant = findUpcomingImportantDates(todayHeb.month, todayHeb.day);
      
      // Determine what to show
      const hasToday = todayYahrzeits.length > 0 || todayImportant.length > 0;
      const hasTomorrow = tomorrowYahrzeits.length > 0 || tomorrowImportant.length > 0;
      const hasUpcoming = upcomingImportant.length > 0;
      
      // Hide loading
      document.getElementById('yahrzeitLoading').style.display = 'none';
      
      // If nothing to show, hide the box entirely
      if (!hasToday && !hasTomorrow && !hasUpcoming) {
        document.getElementById('compactYahrzeit').style.display = 'none';
        return;
      }
      
      // Show the box (remove collapsed for desktop, mobile stays collapsed until tapped)
      const box = document.getElementById('compactYahrzeit');
      box.style.display = 'block';
      if (window.innerWidth > 768) {
        box.classList.remove('collapsed');
      }
      
      // Populate today's section
      if (hasToday) {
        document.getElementById('todayHebrew').textContent = todayHeb.hebrew;
        const todayList = document.getElementById('todayList');
        todayList.innerHTML = '';
        
        for (const tz of todayYahrzeits) {
          todayList.appendChild(renderTzaddikLink(tz));
        }
        for (const evt of todayImportant) {
          todayList.appendChild(renderTzaddikLink(evt, true));
        }
        
        document.getElementById('todaySection').style.display = 'block';
      }
      
      // Populate tomorrow's section
      if (hasTomorrow) {
        document.getElementById('tomorrowHebrew').textContent = tomorrowHeb.hebrew;
        const tomorrowList = document.getElementById('tomorrowList');
        tomorrowList.innerHTML = '';
        
        for (const tz of tomorrowYahrzeits) {
          tomorrowList.appendChild(renderTzaddikLink(tz));
        }
        for (const evt of tomorrowImportant) {
          tomorrowList.appendChild(renderTzaddikLink(evt, true));
        }
        
        document.getElementById('tomorrowSection').style.display = 'block';
      }
      
      // Populate upcoming section
      if (hasUpcoming) {
        const first = upcomingImportant[0];
        document.getElementById('upcomingLabel').textContent = first.dateLabel;
        const upcomingList = document.getElementById('upcomingList');
        upcomingList.innerHTML = '';
        
        for (const evt of upcomingImportant) {
          upcomingList.appendChild(renderTzaddikLink(evt, true));
        }
        
        document.getElementById('upcomingSection').style.display = 'block';
      }
      
    } catch (e) {
      console.error('Yahrzeit initialization error:', e);
      // Hide on error to avoid showing stale data
      document.getElementById('compactYahrzeit').style.display = 'none';
    }
  }

  // Mobile toggle
  function toggleYahrzeit() {
    const box = document.getElementById('compactYahrzeit');
    box.classList.toggle('collapsed');
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYahrzeit);
  } else {
    initYahrzeit();
  }
</script>

<style>
  .compact-yahrzeit {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 8px;
    padding: 0.5rem;
    max-width: 240px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    z-index: 20;
    font-size: 0.9em;
  }

  /* On small mobile, shrink and move to bottom-left to avoid covering title */
  @media (max-width: 480px) {
    .compact-yahrzeit {
      top: auto;
      bottom: 0.5rem;
      left: 0.5rem;
    }

    .compact-yahrzeit.collapsed {
      max-width: 44px;
      max-height: 44px;
      padding: 0.5rem;
      border-radius: 50%;
      opacity: 0.8;
    }
  }
  
  .yahrzeit-loading {
    text-align: center;
    padding: 0.5rem;
  }
  
  .loading-icon {
    animation: pulse 1.5s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  
  .yahrzeit-section {
    margin-bottom: 0.5rem;
  }
  
  .yahrzeit-section:last-child {
    margin-bottom: 0;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
    padding-bottom: 0.125rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .yahrzeit-icon {
    font-size: 0.875rem;
  }
  
  .section-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #92400e;
    margin: 0;
  }
  
  .tzaddikim-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .tzaddik-link {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.375rem;
    background: #fff;
    border-radius: 4px;
    border-left: 2px solid #f59e0b;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .tzaddik-link:hover {
    background: #fef3c7;
    transform: translateX(2px);
  }
  
  .tzaddik-name {
    font-size: 0.75rem;
    font-weight: 500;
    color: #1f2937;
  }
  
  .tzaddik-hebrew {
    font-size: 0.7rem;
    color: #4b5563;
    margin-top: 0.125rem;
  }
  
  .upcoming-event {
    border-left-color: #10b981;
  }
  
  .upcoming-event:hover {
    background: #f0fdf4;
  }
  
  .event-description {
    font-size: 0.65rem;
    color: #059669;
    font-style: italic;
    margin-top: 0.125rem;
  }
  
  .event-type {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.125rem;
  }
  
  .birth-badge {
    color: #10b981;
    background: #f0fdf4;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    display: inline-block;
    align-self: flex-start;
  }

  .special-badge {
    color: #7c3aed;
    background: #f5f3ff;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    display: inline-block;
    align-self: flex-start;
  }
  
  .toggle-btn {
    display: none;
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
  }
  
  .mobile-only {
    display: none;
  }
  
  @media (max-width: 768px) {
    .compact-yahrzeit {
      transition: all 0.3s ease;
      overflow: hidden;
    }

    .compact-yahrzeit.collapsed {
      max-width: 60px;
      max-height: 60px;
      padding: 0.75rem;
    }

    .compact-yahrzeit:not(.collapsed) {
      max-width: 220px;
      max-height: 500px;
    }

    .compact-yahrzeit.collapsed .yahrzeit-section,
    .compact-yahrzeit.collapsed .view-all,
    .compact-yahrzeit.collapsed .yahrzeit-loading {
      display: none !important;
    }
    
    .toggle-btn {
      display: flex;
    }
    
    .collapsed .collapsed-icon {
      display: inline;
    }
    
    .collapsed .expanded-icon {
      display: none;
    }
    
    .compact-yahrzeit:not(.collapsed) .collapsed-icon {
      display: none;
    }
    
    .compact-yahrzeit:not(.collapsed) .expanded-icon {
      display: inline;
    }
    
    .mobile-only {
      display: flex;
    }
  }
</style>
