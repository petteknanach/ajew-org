---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const catalogPath = path.join(process.cwd(), 'public/data/trivia/questions.json');
const catalog = JSON.parse(fs.readFileSync(catalogPath, 'utf8'));
const categoryCounts = Object.fromEntries(Object.keys(catalog.categories).map((key) => [key, catalog.questions.filter((q) => q.category === key).length]));
const pageTitle = 'Na Nach Trivia Fire — Breslov Torah Game';
const pageDesc = `${catalog.count.toLocaleString()} source-linked questions on Rabbi Nachman’s teachings, Breslov history, approved personages, Na Nach and Saba Yisroel. Multiple levels, fresh rounds and a competitive leaderboard.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <main class="trivia-page" id="triviaApp" data-catalog-count={catalog.count}>
    <section class="game-hero" aria-labelledby="trivia-title">
      <div class="hero-rays" aria-hidden="true"></div>
      <div class="hero-copy">
        <div class="hero-kicker">🔥 THE DELUXE BRESLOV TORAH CHALLENGE 🔥</div>
        <h1 id="trivia-title"><span>Na Nach</span> Trivia Fire</h1>
        <p class="hero-hebrew" lang="he" dir="rtl">נ נח נחמ נחמן מאומן</p>
        <p class="hero-sub">Teachings first. History, holy personages, Na Nach, Saba, books and avodah. Every answer opens the source.</p>
        <div class="hero-stats" aria-label="Game highlights">
          <span><strong>{catalog.count.toLocaleString()}</strong> questions</span>
          <span><strong>6</strong> categories</span>
          <span><strong>3</strong> levels</span>
          <span><strong>∞</strong> fresh rounds</span>
        </div>
      </div>
      <div class="crew-stage" aria-label="Illustration of male Na Nach chassidim celebrating beside a Na Nach van">
        <svg class="crew-art" viewBox="0 0 720 430" role="img" aria-labelledby="crew-title crew-desc">
          <title id="crew-title">Na Nach trivia crew</title>
          <desc id="crew-desc">Three bearded male Na Nach chassidim with peyos, tzitzis and Na Nach beanies dance beside a colorful Na Nach van.</desc>
          <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#80e7ff"/><stop offset="1" stop-color="#fff2a8"/></linearGradient>
            <linearGradient id="van" x1="0" x2="1"><stop stop-color="#17b7c7"/><stop offset=".5" stop-color="#ffe13f"/><stop offset="1" stop-color="#ff5e67"/></linearGradient>
            <filter id="shadow"><feDropShadow dx="0" dy="10" stdDeviation="8" flood-opacity=".25"/></filter>
          </defs>
          <path fill="url(#sky)" d="M0 0h720v430H0z"/>
          <path fill="#e9c98b" d="M0 280l94-76 80 49 97-98 102 96 95-65 92 64 70-45 90 67v158H0z" opacity=".55"/>
          <g filter="url(#shadow)" transform="translate(180 226)">
            <path fill="url(#van)" stroke="#15213c" stroke-width="8" d="M8 48q0-42 42-42h292q35 0 54 30l43 69v94H8z"/>
            <path fill="#dffbff" stroke="#15213c" stroke-width="7" d="M301 25h50q19 0 31 20l28 46H301zM62 25h99v66H62zm118 0h101v66H180z"/>
            <circle cx="96" cy="199" r="38" fill="#17223a"/><circle cx="96" cy="199" r="18" fill="#faf1c8"/>
            <circle cx="353" cy="199" r="38" fill="#17223a"/><circle cx="353" cy="199" r="18" fill="#faf1c8"/>
            <text x="211" y="130" text-anchor="middle" font-size="31" font-weight="900" fill="#12213d" direction="rtl">נ נח נחמ נחמן מאומן</text>
            <path d="M25 154q35-31 67 0t69 0 70 0 70 0 70 0" fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" opacity=".8"/>
          </g>
          <g class="dancer dancer-a" transform="translate(78 120) rotate(-8)">
            <circle cx="56" cy="50" r="30" fill="#e6aa72" stroke="#18223b" stroke-width="6"/>
            <path d="M27 35q29-33 61 0l-6-24q-27-19-52 0z" fill="#19a5bd" stroke="#18223b" stroke-width="5"/>
            <text x="57" y="22" text-anchor="middle" font-size="13" font-weight="900" fill="#fff">נ נח</text>
            <path d="M42 66q14 27 29 0v27H42z" fill="#58331f"/>
            <path d="M28 47q-15 14-10 38M86 47q15 14 8 38" fill="none" stroke="#55301f" stroke-width="5" stroke-linecap="round"/>
            <path d="M22 91h69l16 112H6z" fill="#fff" stroke="#18223b" stroke-width="6"/>
            <path d="M28 101L2 153m84-52 50-60" fill="none" stroke="#e6aa72" stroke-width="15" stroke-linecap="round"/>
            <path d="M18 204l-22 79m91-79 31 73" fill="none" stroke="#18223b" stroke-width="22" stroke-linecap="round"/>
            <path d="M18 191l-12 45M82 191l12 45" fill="none" stroke="#fff" stroke-width="5"/><path d="M8 183l-16 34m88-34 18 34" stroke="#1da8c0" stroke-width="4"/>
          </g>
          <g class="dancer dancer-b" transform="translate(488 92) rotate(8)">
            <circle cx="56" cy="50" r="30" fill="#c98456" stroke="#18223b" stroke-width="6"/>
            <path d="M27 35q29-33 61 0l-6-24q-27-19-52 0z" fill="#ff5260" stroke="#18223b" stroke-width="5"/>
            <text x="57" y="22" text-anchor="middle" font-size="13" font-weight="900" fill="#fff">נ נחמ</text>
            <path d="M39 64q17 37 34 0v35H39z" fill="#4b2a1e"/>
            <path d="M27 46q-17 18-11 43M87 46q17 18 9 43" fill="none" stroke="#4b2a1e" stroke-width="5" stroke-linecap="round"/>
            <path d="M20 94h74l15 111H4z" fill="#ffefad" stroke="#18223b" stroke-width="6"/>
            <path d="M24 106L-8 51m98 56 42 42" fill="none" stroke="#c98456" stroke-width="15" stroke-linecap="round"/>
            <path d="M17 205l-23 76m96-76 29 74" fill="none" stroke="#18223b" stroke-width="22" stroke-linecap="round"/>
            <path d="M15 189l-11 47M86 189l12 47" fill="none" stroke="#fff" stroke-width="5"/><path d="M7 184l-16 33m93-33 18 33" stroke="#ff5260" stroke-width="4"/>
          </g>
          <g class="dancer dancer-c" transform="translate(327 52)">
            <circle cx="50" cy="49" r="29" fill="#d99864" stroke="#18223b" stroke-width="6"/>
            <path d="M22 34q28-33 58 0l-5-24q-27-18-49 0z" fill="#f1be27" stroke="#18223b" stroke-width="5"/>
            <text x="51" y="21" text-anchor="middle" font-size="12" font-weight="900" fill="#14213c">נ נח</text>
            <path d="M35 63q15 34 31 0v33H35z" fill="#56321e"/>
            <path d="M21 92h65l12 103H8z" fill="#eef8ff" stroke="#18223b" stroke-width="6"/>
            <path d="M20 101L-9 55m92 47 38-52" fill="none" stroke="#d99864" stroke-width="14" stroke-linecap="round"/>
            <path d="M20 194L3 254m80-60 20 60" fill="none" stroke="#18223b" stroke-width="20" stroke-linecap="round"/>
            <path d="M18 178L8 222m70-44 11 44" fill="none" stroke="#fff" stroke-width="5"/><path d="M10 176l-15 31m80-31 16 31" stroke="#e0ad20" stroke-width="4"/>
          </g>
        </svg>
      </div>
    </section>

    <section class="setup-shell" id="setupScreen">
      <div class="setup-main deluxe-card">
        <div class="section-heading"><span>1</span><div><h2>Choose how to play</h2><p>Stay private, or put a nickname on the worldwide board.</p></div></div>
        <div class="mode-grid" role="radiogroup" aria-label="Play mode">
          <button class="mode-card active" data-mode="practice" role="radio" aria-checked="true">
            <span class="mode-icon">🕯️</span><strong>Anonymous Practice</strong><small>No name, no score upload. Your recent questions stay on this device so repeats are avoided.</small>
          </button>
          <button class="mode-card" data-mode="compete" role="radio" aria-checked="false">
            <span class="mode-icon">🏆</span><strong>Compete</strong><small>Choose a public nickname and climb the Na Nach leaderboard. Official rounds are 20 questions.</small>
          </button>
        </div>
        <label class="nickname-field" id="nicknameField" hidden>Public nickname
          <input id="nicknameInput" maxlength="24" autocomplete="nickname" placeholder="e.g. Breslover613" />
          <small>Letters, numbers, spaces, hyphens and underscores only.</small>
        </label>

        <div class="section-heading"><span>2</span><div><h2>Pick your fire</h2><p>Mix everything or focus your round.</p></div></div>
        <div class="category-grid">
          {Object.entries(catalog.categories).map(([key,label]) => (
            <button class={`category-card ${key === 'teachings' ? 'selected' : ''}`} data-category={key} aria-pressed={key === 'teachings' ? 'true':'false'}>
              <span class="category-icon">{key === 'teachings' ? '📜' : key === 'avodah' ? '🕯️' : key === 'history' ? '🗺️' : key === 'personages' ? '🧔' : key === 'nanach' ? '🔥' : '📚'}</span>
              <strong>{label}</strong><small>{categoryCounts[key].toLocaleString()} questions</small>
            </button>
          ))}
        </div>
        <button class="select-all" id="selectAllCategories">Select all categories</button>

        <div class="section-heading"><span>3</span><div><h2>Choose a level</h2><p>Mixed Fire adapts across all three.</p></div></div>
        <div class="difficulty-grid" role="radiogroup" aria-label="Difficulty">
          <button class="difficulty-card" data-level="beginner" role="radio" aria-checked="false"><b>🌱 Beginner</b><small>Recognize core teachings and names</small></button>
          <button class="difficulty-card active" data-level="mixed" role="radio" aria-checked="true"><b>🔥 Mixed Fire</b><small>Balanced climb through every level</small></button>
          <button class="difficulty-card" data-level="scholar" role="radio" aria-checked="false"><b>📖 Scholar</b><small>Sources, dates and precise connections</small></button>
          <button class="difficulty-card" data-level="fire" role="radio" aria-checked="false"><b>⚡ Fire</b><small>For serious Breslov learners</small></button>
        </div>

        <div class="round-row">
          <label>Round length <select id="roundLength"><option value="10">10 questions</option><option value="20" selected>20 questions</option><option value="30">30 questions</option></select></label>
          <label class="sound-toggle"><input id="soundToggle" type="checkbox" checked /> Sound sparks</label>
        </div>
        <div class="start-actions">
          <button class="daily-button" id="dailyButton">☀️ Daily 10</button>
          <button class="start-button" id="startButton">Light the Fire <span>→</span></button>
        </div>
        <p class="setup-error" id="setupError" role="alert"></p>
      </div>

      <aside class="leaderboard-card deluxe-card" aria-labelledby="leaderboard-title">
        <div class="leader-head"><div><span class="tiny-label">HALL OF FIRE</span><h2 id="leaderboard-title">Highest Scores</h2></div><span class="trophy">🏆</span></div>
        <div class="board-tabs"><button class="active" data-board="all">All</button><button data-board="today">Today</button></div>
        <ol class="score-list" id="scoreList"><li class="board-loading">Loading the board…</li></ol>
        <p class="board-note" id="boardNote">Competitive scores are calculated from verified question sessions.</p>
        <div class="fair-play"><strong>🛡️ Fair-play board</strong><span>The server chooses the questions and calculates the official score.</span></div>
      </aside>
    </section>

    <section class="game-shell" id="gameScreen" hidden>
      <div class="game-topbar">
        <button class="quit-button" id="quitButton" aria-label="Leave round">×</button>
        <div class="round-progress"><span id="questionCounter">Question 1 of 20</span><div class="progress-track"><i id="roundProgress"></i></div></div>
        <div class="hud-stat"><small>SCORE</small><strong id="scoreValue">0</strong></div>
        <div class="hud-stat streak-stat"><small>STREAK</small><strong><span id="streakValue">0</span> 🔥</strong></div>
      </div>
      <div class="question-stage">
        <div class="question-card deluxe-card" id="questionCard">
          <div class="question-meta"><span id="categoryBadge">Teachings</span><span id="levelBadge">Beginner</span></div>
          <div class="timer-wrap"><div class="timer-bar" id="timerBar"></div><span id="timerText">30</span></div>
          <h2 id="questionPrompt" aria-live="polite">Loading your question…</h2>
          <div class="answer-grid" id="answerGrid"></div>
          <div class="lifelines">
            <button id="fiftyButton">✂️ 50 / 50 <small>one use</small></button>
            <button id="studyButton">📖 Study source</button>
          </div>
          <div class="feedback-panel" id="feedbackPanel" role="status" aria-live="polite" hidden>
            <div class="feedback-mark" id="feedbackMark">✓</div>
            <div><strong id="feedbackTitle">Correct!</strong><p id="feedbackText"></p><a id="sourceLink" target="_blank" rel="noopener">Open exact source ↗</a></div>
            <button id="nextButton">Next fire →</button>
          </div>
        </div>
        <aside class="journey-card deluxe-card">
          <div class="van-window"><span class="mini-van">🚐</span><i id="vanRoad"></i></div>
          <h3>Your Journey</h3>
          <div class="journey-stats"><span><b id="correctValue">0</b> correct</span><span><b id="accuracyValue">0%</b> accuracy</span></div>
          <div class="flame-path" id="flamePath"></div>
          <blockquote>“The whole world is a very narrow bridge — and the main thing is not to fear at all.”</blockquote>
        </aside>
      </div>
    </section>

    <section class="result-shell" id="resultScreen" hidden>
      <div class="result-card deluxe-card">
        <div class="result-burst" aria-hidden="true">🔥</div>
        <p class="tiny-label">ROUND COMPLETE</p>
        <h2 id="resultTitle">You kept the fire burning!</h2>
        <p class="result-score"><span id="finalScore">0</span> points</p>
        <div class="result-grid"><span><b id="finalCorrect">0/20</b> correct</span><span><b id="finalAccuracy">0%</b> accuracy</span><span><b id="finalStreak">0</b> best streak</span><span><b id="finalRank">—</b> board rank</span></div>
        <div class="achievement-row" id="achievementRow"></div>
        <p class="submit-status" id="submitStatus"></p>
        <div class="result-actions"><button id="newRoundButton">Fresh questions</button><button id="reviewButton">Review sources</button></div>
        <div class="review-list" id="reviewList" hidden></div>
      </div>
      <div class="celebration-scene" aria-label="Na Nach men celebrating on a Na Nach van">
        <img src="/images/nanach/friends-dancing-on-na-nach-van.jpg" alt="Na Nach men dancing in celebration on a decorated Na Nach van" />
        <div class="celebration-caption"><strong>Na Nach victory dance!</strong><span lang="he" dir="rtl">נ נח נחמ נחמן מאומן</span></div>
      </div>
    </section>

    <div class="confetti" id="confetti" aria-hidden="true"></div>
  </main>

  <script is:inline>
  (() => {
    const API='/api/trivia';
    const $=(id)=>document.getElementById(id);
    const state={catalog:null,mode:'practice',level:'mixed',categories:['teachings'],length:20,questions:[],index:0,score:0,correct:0,streak:0,bestStreak:0,answers:[],sessionToken:null,timer:null,deadline:0,fiftyUsed:false,sound:true,daily:false};
    const categoryLabels={teachings:'Teachings',avodah:'Avodah',history:'Breslov History',personages:'Personages',nanach:'Na Nach & Saba',books:'Books & Sources'};
    const levelPoints={beginner:100,scholar:180,fire:300};

    function safeText(s){return String(s==null?'':s)}
    function sound(kind){
      if(!state.sound)return;
      try{const ctx=new (window.AudioContext||window.webkitAudioContext)();const o=ctx.createOscillator();const g=ctx.createGain();o.connect(g);g.connect(ctx.destination);o.type=kind==='right'?'sine':'sawtooth';o.frequency.setValueAtTime(kind==='right'?520:170,ctx.currentTime);if(kind==='right')o.frequency.exponentialRampToValueAtTime(880,ctx.currentTime+.18);g.gain.setValueAtTime(.06,ctx.currentTime);g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.23);o.start();o.stop(ctx.currentTime+.24)}catch(e){}
    }
    function hashSeed(text){let h=2166136261;for(let i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
    function mulberry32(a){return function(){let t=a+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
    function shuffle(a,r=Math.random){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
    function historyIds(){try{return JSON.parse(localStorage.getItem('nanachTriviaHistory')||'[]')}catch{return[]}}
    function remember(ids){const all=[...historyIds(),...ids];localStorage.setItem('nanachTriviaHistory',JSON.stringify([...new Set(all)].slice(-360)))}
    function localScores(){try{return JSON.parse(localStorage.getItem('nanachTriviaScores')||'[]')}catch{return[]}}
    function addLocalScore(row){const all=[...localScores(),row].sort((a,b)=>b.score-a.score).slice(0,50);localStorage.setItem('nanachTriviaScores',JSON.stringify(all))}

    document.querySelectorAll('.mode-card').forEach(b=>b.addEventListener('click',()=>{
      document.querySelectorAll('.mode-card').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-checked',x===b?'true':'false')});state.mode=b.dataset.mode;$('nicknameField').hidden=state.mode!=='compete';$('roundLength').disabled=state.mode==='compete';if(state.mode==='compete'){$('roundLength').value='20';state.length=20}
    }));
    document.querySelectorAll('.category-card').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('selected');b.setAttribute('aria-pressed',b.classList.contains('selected')?'true':'false');state.categories=[...document.querySelectorAll('.category-card.selected')].map(x=>x.dataset.category)}));
    $('selectAllCategories').addEventListener('click',()=>{document.querySelectorAll('.category-card').forEach(b=>{b.classList.add('selected');b.setAttribute('aria-pressed','true')});state.categories=[...document.querySelectorAll('.category-card')].map(x=>x.dataset.category)});
    document.querySelectorAll('.difficulty-card').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.difficulty-card').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-checked',x===b?'true':'false')});state.level=b.dataset.level}));
    document.querySelectorAll('.board-tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.board-tabs button').forEach(x=>x.classList.toggle('active',x===b));loadBoard(b.dataset.board)}));
    $('roundLength').addEventListener('change',e=>state.length=Number(e.target.value));
    $('soundToggle').addEventListener('change',e=>state.sound=e.target.checked);
    $('startButton').addEventListener('click',()=>startRound(false));
    $('dailyButton').addEventListener('click',()=>{state.mode='practice';$('roundLength').disabled=false;document.querySelectorAll('.mode-card').forEach(x=>{const on=x.dataset.mode==='practice';x.classList.toggle('active',on);x.setAttribute('aria-checked',on?'true':'false')});$('nicknameField').hidden=true;startRound(true)});
    $('quitButton').addEventListener('click',()=>{if(confirm('Leave this round?'))showSetup()});
    $('nextButton').addEventListener('click',nextQuestion);
    $('newRoundButton').addEventListener('click',showSetup);
    $('reviewButton').addEventListener('click',()=>{$('reviewList').hidden=!$('reviewList').hidden});
    $('fiftyButton').addEventListener('click',useFifty);
    $('studyButton').addEventListener('click',()=>{const q=state.questions[state.index];if(q)window.open(q.sourceUrl,'_blank','noopener')});
    document.addEventListener('keydown',e=>{if($('gameScreen').hidden)return;if(['1','2','3','4'].includes(e.key)){const b=document.querySelector(`.answer-button[data-index="${Number(e.key)-1}"]`);if(b&&!b.disabled)b.click()}if(e.key==='Enter'&&!$('feedbackPanel').hidden)$('nextButton').click()});

    async function loadCatalog(){
      if(state.catalog)return state.catalog;
      const r=await fetch('/data/trivia/questions.json?v=1');if(!r.ok)throw new Error('Question library unavailable');state.catalog=await r.json();return state.catalog;
    }
    function validateName(name){return /^[A-Za-z0-9 _-]{2,24}$/.test(name)}
    function eligible(){return state.catalog.questions.filter(q=>state.categories.includes(q.category)&&(state.level==='mixed'||q.level===state.level))}
    function chooseLocal(seed){
      let pool=eligible(),seen=new Set(historyIds()),fresh=pool.filter(q=>!seen.has(q.id));if(fresh.length<state.length)fresh=pool;
      const rand=mulberry32(seed);return shuffle(fresh,rand).slice(0,state.length);
    }
    async function startRound(daily){
      $('setupError').textContent='';state.daily=daily;state.length=daily?10:Number($('roundLength').value);state.sound=$('soundToggle').checked;
      if(daily){state.categories=['teachings','avodah','history','personages','nanach','books'];state.level='mixed';state.mode='practice'}
      if(!state.categories.length){$('setupError').textContent='Choose at least one category.';return}
      const nickname=$('nicknameInput').value.trim();if(state.mode==='compete'&&!validateName(nickname)){$('setupError').textContent='Choose a nickname with 2–24 letters, numbers, spaces, hyphens or underscores.';return}
      $('startButton').disabled=true;$('startButton').firstChild.textContent='Gathering questions… ';
      try{
        await loadCatalog();let qs=null;state.sessionToken=null;
        if(state.mode==='compete'){
          try{const r=await fetch(API+'/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nickname,categories:state.categories,level:state.level,length:state.length})});if(r.ok){const d=await r.json();state.sessionToken=d.token;const map=new Map(state.catalog.questions.map(q=>[q.id,q]));qs=d.questionIds.map(id=>map.get(id)).filter(Boolean)}}catch(e){}
          if(!qs||qs.length!==state.length){$('setupError').textContent='Competition server is temporarily unavailable; starting a local practice round.';state.mode='practice'}
        }
        if(!qs){const seed=daily?hashSeed(new Date().toISOString().slice(0,10)+'daily'):crypto.getRandomValues(new Uint32Array(1))[0];qs=chooseLocal(seed)}
        if(qs.length<state.length)throw new Error('Not enough questions for that combination. Add a category or use Mixed Fire.');
        state.questions=qs;state.index=0;state.score=0;state.correct=0;state.streak=0;state.bestStreak=0;state.answers=[];state.fiftyUsed=false;
        remember(qs.map(q=>q.id));showGame();renderQuestion();
      }catch(e){$('setupError').textContent=e.message||'Could not start the round.'}
      finally{$('startButton').disabled=false;$('startButton').firstChild.textContent='Light the Fire '}
    }
    function showGame(){document.getElementById('yahrzeitCloseBtn')?.click();$('setupScreen').hidden=true;$('resultScreen').hidden=true;$('gameScreen').hidden=false;window.scrollTo({top:$('gameScreen').offsetTop-20,behavior:'smooth'})}
    function showSetup(){clearInterval(state.timer);$('gameScreen').hidden=true;$('resultScreen').hidden=true;$('setupScreen').hidden=false;loadBoard('all');window.scrollTo({top:0,behavior:'smooth'})}
    function renderQuestion(){
      clearInterval(state.timer);const q=state.questions[state.index];$('feedbackPanel').hidden=true;$('answerGrid').innerHTML='';$('questionCard').classList.remove('correct-flash','wrong-flash');
      $('questionCounter').textContent=`Question ${state.index+1} of ${state.questions.length}`;$('roundProgress').style.width=`${state.index/state.questions.length*100}%`;$('scoreValue').textContent=state.score.toLocaleString();$('streakValue').textContent=state.streak;$('categoryBadge').textContent=categoryLabels[q.category]||q.category;$('levelBadge').textContent=q.level.toUpperCase();$('questionPrompt').textContent=q.prompt;
      q.options.forEach((opt,i)=>{const b=document.createElement('button');b.className='answer-button';b.dataset.index=i;b.innerHTML=`<span>${i+1}</span><b></b>`;b.querySelector('b').textContent=opt;b.addEventListener('click',()=>answer(i));$('answerGrid').appendChild(b)});
      $('fiftyButton').disabled=state.fiftyUsed;$('correctValue').textContent=state.correct;$('accuracyValue').textContent=state.index?Math.round(state.correct/state.index*100)+'%':'0%';renderFlames();
      const seconds=q.level==='beginner'?30:q.level==='scholar'?40:50;state.deadline=Date.now()+seconds*1000;updateTimer(seconds);state.timer=setInterval(()=>{const left=Math.max(0,(state.deadline-Date.now())/1000);updateTimer(left);if(left<=0){clearInterval(state.timer);answer(-1)}},100);
    }
    function updateTimer(left){const q=state.questions[state.index];const total=q.level==='beginner'?30:q.level==='scholar'?40:50;$('timerText').textContent=Math.ceil(left);$('timerBar').style.width=`${Math.max(0,left/total*100)}%`;$('timerBar').classList.toggle('danger',left<7)}
    function answer(selected){
      clearInterval(state.timer);const q=state.questions[state.index];const buttons=[...document.querySelectorAll('.answer-button')];buttons.forEach(b=>b.disabled=true);const right=selected===q.answer;
      buttons.forEach((b,i)=>{if(i===q.answer)b.classList.add('correct');else if(i===selected)b.classList.add('wrong')});
      if(right){state.correct++;state.streak++;state.bestStreak=Math.max(state.bestStreak,state.streak);const gained=levelPoints[q.level]+Math.min(200,(state.streak-1)*20);state.score+=gained;$('feedbackTitle').textContent=`Correct! +${gained}`;$('feedbackMark').textContent='✓';$('questionCard').classList.add('correct-flash');sound('right')}
      else{state.streak=0;$('feedbackTitle').textContent=selected<0?'Time! The fire waits for no one.':'Not this time — learn it and own it.';$('feedbackMark').textContent='✦';$('questionCard').classList.add('wrong-flash');sound('wrong')}
      state.answers.push({id:q.id,selected});$('feedbackText').textContent=q.explanation;$('sourceLink').href=q.sourceUrl;$('sourceLink').textContent=`Open ${q.sourceLabel} source ↗`;$('feedbackPanel').hidden=false;$('scoreValue').textContent=state.score.toLocaleString();$('streakValue').textContent=state.streak;$('correctValue').textContent=state.correct;$('accuracyValue').textContent=Math.round(state.correct/(state.index+1)*100)+'%';renderFlames();
    }
    function nextQuestion(){state.index++;if(state.index>=state.questions.length)finishRound();else renderQuestion()}
    function useFifty(){if(state.fiftyUsed)return;const q=state.questions[state.index];const wrong=shuffle([0,1,2,3].filter(i=>i!==q.answer)).slice(0,2);wrong.forEach(i=>{const b=document.querySelector(`.answer-button[data-index="${i}"]`);if(b){b.disabled=true;b.classList.add('removed')}});state.fiftyUsed=true;$('fiftyButton').disabled=true}
    function renderFlames(){const n=state.questions.length;$('flamePath').innerHTML=Array.from({length:n},(_,i)=>`<i class="${i<state.index+(state.answers.length>state.index?1:0)?(state.answers[i]?.selected===state.questions[i]?.answer?'lit':'dim'):''}">◆</i>`).join('');$('vanRoad').style.width=`${Math.min(100,(state.index+1)/n*100)}%`}
    async function finishRound(){
      clearInterval(state.timer);$('gameScreen').hidden=true;$('resultScreen').hidden=false;$('roundProgress').style.width='100%';const total=state.questions.length,accuracy=Math.round(state.correct/total*100);$('finalScore').textContent=state.score.toLocaleString();$('finalCorrect').textContent=`${state.correct}/${total}`;$('finalAccuracy').textContent=accuracy+'%';$('finalStreak').textContent=state.bestStreak;$('finalRank').textContent='—';
      $('resultTitle').textContent=accuracy===100?'Perfect fire! Torah champion!':accuracy>=80?'The van is dancing — tremendous!':accuracy>=60?'Strong fire — keep climbing!':'Every answer learned is a new beginning.';
      const badges=[];if(accuracy===100)badges.push('💎 Perfect Round');if(state.bestStreak>=7)badges.push('🔥 Seven-Fire Streak');if(state.categories.length>=5)badges.push('🗺️ All-Around Breslover');if(state.level==='fire')badges.push('⚡ Fire Level');if(state.daily)badges.push('☀️ Daily Flame');$('achievementRow').innerHTML=badges.map(x=>`<span>${x}</span>`).join('')||'<span>🕯️ New Torah Learned</span>';
      $('reviewList').innerHTML=state.questions.map((q,i)=>`<article class="${state.answers[i]?.selected===q.answer?'review-right':'review-wrong'}"><b>${i+1}. ${escapeHtml(q.prompt)}</b><span>Your answer: ${escapeHtml(state.answers[i]?.selected>=0?q.options[state.answers[i].selected]:'Time expired')}</span><span>Correct: ${escapeHtml(q.options[q.answer])}</span><a href="${q.sourceUrl}" target="_blank" rel="noopener">${escapeHtml(q.sourceLabel)} ↗</a></article>`).join('');$('reviewList').hidden=true;
      burst();const row={nickname:state.mode==='compete'?$('nicknameInput').value.trim():'Anonymous',score:state.score,correct:state.correct,total,level:state.level,created_at:new Date().toISOString()};addLocalScore(row);
      if(state.mode==='compete'&&state.sessionToken){$('submitStatus').textContent='Verifying official score…';try{const r=await fetch(API+'/score',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:state.sessionToken,answers:state.answers})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Score rejected');state.score=d.score;$('finalScore').textContent=Number(d.score).toLocaleString();$('finalCorrect').textContent=`${d.correct}/${d.total}`;$('finalRank').textContent=d.rank?'#'+d.rank:'—';$('submitStatus').textContent='✓ Official score posted to the Hall of Fire.'}catch(e){$('submitStatus').textContent='Could not post officially; your score remains saved on this device.'}}
      else $('submitStatus').textContent='Anonymous round — nothing was uploaded.';
      window.scrollTo({top:$('resultScreen').offsetTop-20,behavior:'smooth'});
    }
    function escapeHtml(s){return safeText(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
    function burst(){const c=$('confetti');c.innerHTML='';for(let i=0;i<70;i++){const s=document.createElement('i');s.style.setProperty('--x',Math.random()*100+'vw');s.style.setProperty('--d',1.5+Math.random()*2.5+'s');s.style.setProperty('--r',Math.random()*720+'deg');s.style.background=['#ffd633','#ff5260','#15b8c8','#fff','#5533cc'][i%5];c.appendChild(s)}setTimeout(()=>c.innerHTML='',4300)}

    async function loadBoard(period='all'){
      $('scoreList').innerHTML='<li class="board-loading">Loading the board…</li>';let rows=null;
      try{const r=await fetch(`${API}/scores?period=${encodeURIComponent(period)}&limit=10`,{headers:{Accept:'application/json'}});if(r.ok)rows=await r.json()}catch(e){}
      if(!Array.isArray(rows)){rows=localScores();if(period==='today'){const day=new Date().toISOString().slice(0,10);rows=rows.filter(x=>(x.created_at||'').startsWith(day))}$('boardNote').textContent=rows.length?'Showing this device’s scores while the public board connects.':'Competitive scores will appear here after the first verified round.'}else $('boardNote').textContent='Worldwide verified scores — nicknames only, no account required.';
      $('scoreList').innerHTML=rows.length?rows.slice(0,10).map((r,i)=>`<li><span class="rank">${i<3?['🥇','🥈','🥉'][i]:'#'+(i+1)}</span><span class="player">${escapeHtml(r.nickname||'Anonymous')}<small>${escapeHtml(r.level||'mixed')} · ${Number(r.correct||0)}/${Number(r.total||0)}</small></span><strong>${Number(r.score||0).toLocaleString()}</strong></li>`).join(''):'<li class="board-loading">No scores yet. Be the first fire!</li>';
    }
    loadCatalog().catch(()=>{});loadBoard('all');
  })();
  </script>

