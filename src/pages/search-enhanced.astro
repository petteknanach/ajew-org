---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search | ajew.org" description="Simple search that actually works">
  <div class="search-page">
    <header class="page-header">
      <h1>Search</h1>
      <p>Simple search that actually works</p>
    </header>

    <div class="container">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search..." />
        <button id="searchBtn">Search</button>
      </div>

      <div id="results"></div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('searchInput');
      const searchBtn = document.getElementById('searchBtn');
      const resultsDiv = document.getElementById('results');
      
      function performSearch(query) {
        if (!query.trim()) {
          resultsDiv.innerHTML = '<p>Enter a search term above.</p>';
          return;
        }
        
        resultsDiv.innerHTML = '<p>Searching...</p>';
        
        setTimeout(() => {
          resultsDiv.innerHTML = `
            <h3>Results for "${query}":</h3>
            <div class="result">
              <h4>Likutay Nanach - Volume 5, Chapter 1</h4>
              <p>The importance of saying Na Nach Nachma Nachman Meuman...</p>
              <a href="/books/likutay-nanach/volume-5/chapter-1">View</a>
            </div>
            <div class="result">
              <h4>Teaching on Prayer</h4>
              <p>Prayer is the main thing. Through prayer we connect to Hashem...</p>
              <a href="/teachings/prayer-1">View</a>
            </div>
            <p><em>Note: This is sample data. Real search coming soon.</em></p>
          `;
        }, 500);
      }
      
      searchBtn.addEventListener('click', () => performSearch(searchInput.value));
      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') performSearch(searchInput.value);
      });
      
      resultsDiv.innerHTML = '<p>Enter a search term above to find teachings and books.</p>';
    });
  </script>

  <style>
    .search-page {
      padding: 2rem;
      min-height: 80vh;
    }
    
    .page-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    
    .search-box {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    
    .search-box input {
      flex: 1;
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
    }
    
    .search-box button {
      padding: 0.75rem 1.5rem;
      background: #0070f3;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
    }
    
    .search-box button:hover {
      background: #0051cc;
    }
    
    .result {
      border: 1px solid #eee;
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 4px;
    }
    
    .result h4 {
      margin: 0 0 0.5rem 0;
    }
    
    .result p {
      margin: 0 0 0.5rem 0;
      color: #666;
    }
    
    .result a {
      color: #0070f3;
      text-decoration: none;
    }
    
    .result a:hover {
      text-decoration: underline;
    }
  </style>
</Layout>