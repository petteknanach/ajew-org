---
/**
 * Homepage — ajew.org Landing Page
 * A calm, warm, and welcoming entry point to the Breslov Torah library.
 */
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load daily quote data
const quotes = [
  { he: 'כל העולם כולו גשר צר מאוד, והעיקר לא לפחד כלל', en: 'The whole world is a very narrow bridge, and the main thing is not to fear at all', src: 'LM II:48' },
  { he: 'אם אתה מאמין שיכולין לקלקל, תאמין שיכולין לתקן', en: 'If you believe you can damage, believe you can fix', src: 'LM II:112' },
  { he: 'מצוה גדולה להיות בשמחה תמיד', en: 'It is a great mitzvah to always be happy', src: 'LM II:24' },
  { he: 'אין שום יאוש בעולם כלל', en: 'There is no despair in the world at all', src: 'LM II:78' },
  { he: 'התבודדות הוא מעלה עליונה ויתירה על הכל', en: 'Hitbodedut is the highest virtue of all', src: 'LM II:25' },
  { he: 'עיקר החיות מהשמחה', en: 'The essence of life is from joy', src: 'LM II:24' },
  { he: 'כשאדם יודע שכל הקורותיו הם לטובתו, זאת הבחינה מעין עולם הבא', en: 'When a person knows all that happens is for his good, this is like the World to Come', src: 'LM I:4' },
  { he: 'תפילה בלא כוונה כגוף בלא נשמה', en: 'Prayer without intent is like a body without a soul', src: 'LM I:2' },
  { he: 'צריך לחפש ולבקש למצוא בעצמו איזה מעט טוב', en: 'One must search to find in oneself some small good', src: 'LM I:282' },
  { he: 'נ נח נחמ נחמן מאומן', en: 'Na Nach Nachma Nachman MeUman', src: 'The Petek' },
];
const dayIndex = Math.floor(Date.now() / 86400000) % quotes.length;
const todayQuote = quotes[dayIndex];
const lmTorahMap = { 0: 48, 1: 112, 2: 24, 3: 78, 4: 25, 5: 24, 6: 4, 7: 2, 8: 282 };
const todayLM = lmTorahMap[dayIndex] || 1;
---

<Layout
  title="Na Nach Breslov — Complete Torah of Rebbe Nachman | A Jew"
  description="The complete Breslov library — Rebbe Nachman, Rabbi Nosson, Saba Yisroel. Likutay Moharan, Likutay Halachos, Sefer HaMidos, Sipurey Maasiyos and all Breslov classics free online."
>

<!-- Fire animation CSS -->
<style>
@keyframes fireFlicker {
  0%   { text-shadow: 0 0 4px #ff0000, 0 0 11px #ff0000, 0 0 19px #ff0000, 0 0 40px #ff7700, 0 0 70px #ff7700, 0 0 100px #ff7700, 0 0 140px #ff7700; }
  15%  { text-shadow: 0 0 6px #ff2200, 0 0 14px #ff3300, 0 0 22px #ff5500, 0 0 45px #ff9900, 0 0 75px #ffaa00, 0 0 110px #ffaa00, 0 0 150px #ffaa00; }
  30%  { text-shadow: 0 0 5px #ff0000, 0 0 13px #ff2200, 0 0 20px #ff4400, 0 0 42px #ff6600, 0 0 72px #ff8800, 0 0 105px #ff8800, 0 0 145px #ff8800; }
  45%  { text-shadow: 0 0 7px #ff1100, 0 0 16px #ff4400, 0 0 25px #ff6600, 0 0 48px #ffaa00, 0 0 80px #ffcc00, 0 0 120px #ffcc00, 0 0 160px #ffcc00; }
  60%  { text-shadow: 0 0 4px #ff3300, 0 0 10px #ff5500, 0 0 17px #ff7700, 0 0 38px #ff9900, 0 0 65px #ffbb00, 0 0 95px #ffbb00, 0 0 130px #ffbb00; }
  75%  { text-shadow: 0 0 8px #ff0000, 0 0 18px #ff3300, 0 0 28px #ff5500, 0 0 52px #ff8800, 0 0 85px #ffaa00, 0 0 125px #ffaa00, 0 0 170px #ffaa00; }
  90%  { text-shadow: 0 0 5px #ff2200, 0 0 12px #ff4400, 0 0 21px #ff6600, 0 0 44px #ff7700, 0 0 74px #ff9900, 0 0 108px #ff9900, 0 0 148px #ff9900; }
  100% { text-shadow: 0 0 4px #ff0000, 0 0 11px #ff0000, 0 0 19px #ff0000, 0 0 40px #ff7700, 0 0 70px #ff7700, 0 0 100px #ff7700, 0 0 140px #ff7700; }
}
@keyframes fireRise {
  0%   { transform: translateY(0) scale(1); }
  25%  { transform: translateY(-2px) scale(1.01); }
  50%  { transform: translateY(-4px) scale(1.02); }
  75%  { transform: translateY(-1px) scale(1.01); }
  100% { transform: translateY(0) scale(1); }
}
@keyframes sparkFloat {
  0%   { opacity: 0; transform: translateY(0) scale(0.5); }
  10%  { opacity: 1; }
  90%  { opacity: 0.6; }
  100% { opacity: 0; transform: translateY(-60px) scale(1.2); }
}
</style>

