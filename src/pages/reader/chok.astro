---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Chok LiYisroel - Daily Study"
  description="The daily Chok LiYisroel: Torah with nikud, taamim and Onkelos, Navi, Kesuvim, Mishna, Gemara, Zohar, halacha and mussar - each day's full spread."
>
  <div class="ck-wrap" dir="rtl">
    <header class="ck-header">
      <h1>חק לישראל <span class="ck-sub">Chok LiYisroel · daily</span></h1>
      <p class="ck-date" id="ck-date" dir="ltr"></p>
      <p class="ck-week" id="ck-week"></p>
      <p class="ck-sibling"><a href="/daily-study">חק ברסלב</a> <span>— finish the Breslov books every year · /daily-study</span></p>
    </header>

    <div class="ck-controls" dir="ltr">
      <div class="ck-row ck-days" id="ck-days"></div>
      <div class="ck-row">
        <label>Week <select id="ck-parsha"></select></label>
        <label>Display
          <select id="ck-mode">
            <option value="full">Nikud + Taamim</option>
            <option value="nikud">Nikud only</option>
            <option value="taamim">Taamim only</option>
            <option value="letters">Letters only</option>
          </select>
        </label>
        <label class="ck-chk"><input type="checkbox" id="ck-medooyuk" checked /> Medooyuk</label>
        <label class="ck-chk"><input type="checkbox" id="ck-targum" /> Targum</label>
        <label class="ck-chk"><input type="checkbox" id="ck-rashi" checked /> Rashi</label>
        <label class="ck-chk"><input type="checkbox" id="ck-commentary" checked /> Commentary</label>
        <label class="ck-chk"><input type="checkbox" id="ck-tanachen" checked /> English</label>
        <label class="ck-size">Size <input type="range" id="ck-size" min="16" max="44" value="26" /></label>
        <span class="ck-themes">
          <button class="ck-btn ck-theme" data-t="day">Day</button>
          <button class="ck-btn ck-theme" data-t="sepia">Sepia</button>
          <button class="ck-btn ck-theme" data-t="night">Night</button>
        </span>
      </div>
      <div class="ck-legend" id="ck-legend" dir="rtl">
        <span><span class="m-demo"><span class="m-na">שְׁ</span></span> = שוא נא (נשמע)</span>
        <span><span class="m-demo"><span class="m-nach">שְׁ</span></span> = שוא נח (שקט)</span>
        <span><span class="m-demo"><span class="m-qb">קָ</span></span> = קמץ — קטן או גדול? טעון בירור</span>
        <span class="ck-legend-note">הסימון על האות עצמה</span>
      </div>
    </div>

    <main id="ck-content" class="ck-content" dir="rtl" lang="he"></main>

    <footer class="ck-foot" dir="ltr">
      <p>Sheva/qamats rulings are v0 output — not an accuracy claim.</p>
    </footer>
  </div>
</Layout>

<script src="/chok.js?v=2" defer></script>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════
     Chok LiYisroel — deluxe sefer presentation
     One warm token system, shared with /daily-study.
     Day theme rides the site; Sepia/Night come from chok.js via
     html[data-theme]; site dark mode is body.dark-mode.
     ═══════════════════════════════════════════════════════════════ */
  .ck-wrap {
    --ck-font-he: 'Noto Serif Hebrew', 'David Libre', 'Frank Ruhl Libre', serif;
    --ck-font-en: 'EB Garamond', Georgia, 'Times New Roman', serif;
    --ck-font-ui: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

    --ck-ink: #2f2519;
    --ck-paper: #fbf7ee;
    --ck-panel: #f4eddc;
    --ck-panel-2: #fffdf6;
    --ck-border: #e3d8bf;
    --ck-border-strong: #cfc09a;
    --ck-gold: #a8842e;
    --ck-gold-bright: #c9a227;
    --ck-gold-soft: #e7d9ae;
    --ck-gold-wash: rgba(168, 132, 46, 0.08);
    --ck-teal: #177f70;
    --ck-teal-deep: #106154;
    --ck-on-teal: #ffffff;
    --ck-muted: #8d7f66;
    --ck-muted-2: #6f6350;
    --ck-ok: #2d6a4f;
    --ck-danger: #a33a2e;
    --ck-m-na: #177f70;
    --ck-m-nach: #b3661f;
    --ck-m-qb: #b04a3a;
    --ck-c-commentary: var(--ck-teal-deep);
    --ck-c-rashi: #9c5224;
    --ck-c-mishna: #27648c;
    --ck-c-gemara: #7d5226;
    --ck-c-bonus: #256b44;
    --ck-c-sup: #6c5496;
    --ck-shadow-1: 0 1px 2px rgba(63, 48, 26, 0.06), 0 6px 18px -6px rgba(63, 48, 26, 0.12);
    --ck-shadow-2: 0 2px 4px rgba(63, 48, 26, 0.08), 0 14px 34px -12px rgba(63, 48, 26, 0.24);
    --ck-radius: 14px;

    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
    color: var(--ck-ink);
    font-family: var(--ck-font-ui);
  }

  /* Site-wide dark mode (body.dark-mode) and the page's Night theme
     share one dignified ink-and-brass palette. */
  body.dark-mode .ck-wrap,
  html[data-theme='night'] .ck-wrap {
    --ck-ink: #ede4cf;
    --ck-paper: #171d26;
    --ck-panel: #1d2530;
    --ck-panel-2: #232c39;
    --ck-border: #35404f;
    --ck-border-strong: #4c5a6c;
    --ck-gold: #d2b264;
    --ck-gold-bright: #e3c877;
    --ck-gold-soft: #4a3f22;
    --ck-gold-wash: rgba(210, 178, 100, 0.09);
    --ck-teal: #3fbfae;
    --ck-teal-deep: #2f9d8f;
    --ck-on-teal: #0d1517;
    --ck-muted: #a4977e;
    --ck-muted-2: #b5aa93;
    --ck-ok: #7fd1a5;
    --ck-danger: #e08a7a;
    --ck-m-na: #45c2b0;
    --ck-m-nach: #e0995a;
    --ck-m-qb: #e08a7a;
    --ck-c-commentary: #45c2b0;
    --ck-c-rashi: #d99a5f;
    --ck-c-mishna: #6fb1dd;
    --ck-c-gemara: #cf9c60;
    --ck-c-bonus: #6cc294;
    --ck-c-sup: #b39ae0;
    --ck-shadow-1: 0 1px 2px rgba(0, 0, 0, 0.35), 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    --ck-shadow-2: 0 2px 6px rgba(0, 0, 0, 0.4), 0 18px 44px -12px rgba(0, 0, 0, 0.62);
  }

  /* Sepia: a dedicated parchment reading theme; wins over site dark mode. */
  html[data-theme='sepia'] .ck-wrap {
    --ck-ink: #3b2e1a;
    --ck-paper: #f6eed9;
    --ck-panel: #efe5c9;
    --ck-panel-2: #fbf5e4;
    --ck-border: #dccfa9;
    --ck-border-strong: #c2b184;
    --ck-teal: #17685c;
    --ck-teal-deep: #115349;
    --ck-muted: #8a7a62;
    --ck-muted-2: #6b5a42;
  }

  .ck-wrap ::selection { background: var(--ck-gold-soft); color: var(--ck-ink); }
  .ck-wrap :focus-visible { outline: 2px solid var(--ck-teal); outline-offset: 2px; border-radius: 4px; }

  /* ── Header: sefer title page ─────────────────────────────────── */
  .ck-header {
    text-align: center;
    padding: 1.4rem 0.5rem 0;
    border-bottom: 1px solid var(--ck-gold-soft);
    position: relative;
    margin-bottom: 1.1rem;
  }
  .ck-header::after {
    content: '✦';
    position: absolute;
    inset-inline-start: 50%;
    bottom: -0.62em;
    transform: translateX(50%);
    color: var(--ck-gold);
    font-size: 0.85rem;
    line-height: 1;
    background: transparent;
    padding: 0 0.5rem;
  }
  .ck-header h1 {
    font-family: var(--ck-font-he);
    font-size: clamp(1.9rem, 5vw, 2.7rem);
    font-weight: 700;
    margin: 0 0 0.2rem;
    color: var(--ck-ink);
    line-height: 1.35;
  }
  .ck-sub {
    font-family: var(--ck-font-en);
    font-size: 1rem;
    color: var(--ck-muted);
    font-weight: 400;
    letter-spacing: 0.08em;
  }
  .ck-date, .ck-week {
    color: var(--ck-muted);
    margin: 0.15rem 0;
    font-size: 0.95rem;
    font-family: var(--ck-font-en);
    letter-spacing: 0.02em;
  }
  .ck-sibling {
    margin: 0.7rem 0 1rem;
    font-size: 0.85rem;
    color: var(--ck-muted);
  }
  .ck-sibling a {
    display: inline-block;
    padding: 0.2rem 0.85rem;
    border: 1px solid var(--ck-gold-soft);
    border-radius: 999px;
    background: var(--ck-gold-wash);
    color: var(--ck-gold);
    font-family: var(--ck-font-he);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .ck-sibling a:hover { border-color: var(--ck-gold); color: var(--ck-gold-bright); background: var(--ck-panel-2); }

  /* ── Controls: reading desk ───────────────────────────────────── */
  .ck-controls {
    border: 1px solid var(--ck-border);
    border-radius: var(--ck-radius);
    padding: 0.7rem 0.9rem;
    margin-bottom: 1.2rem;
    background: var(--ck-panel);
    box-shadow: var(--ck-shadow-1);
  }
  .ck-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin: 0.35rem 0;
  }
  .ck-row label {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--ck-muted-2);
    letter-spacing: 0.03em;
  }
  .ck-row select {
    padding: 0.32rem 0.45rem;
    border-radius: 9px;
    border: 1px solid var(--ck-border-strong);
    background: var(--ck-panel-2);
    color: var(--ck-ink);
    font-family: inherit;
    font-size: 0.85rem;
    max-width: 200px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ck-row select:hover { border-color: var(--ck-gold); }
  .ck-row input[type='checkbox'] { accent-color: var(--ck-teal); width: 15px; height: 15px; }
  .ck-size input[type='range'] { accent-color: var(--ck-gold); width: 90px; }

  .ck-btn {
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--ck-border-strong);
    background: var(--ck-panel-2);
    color: var(--ck-ink);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, color 0.2s, transform 0.15s;
  }
  .ck-btn:hover {
    border-color: var(--ck-gold);
    box-shadow: var(--ck-shadow-1);
  }
  .ck-btn:active { transform: translateY(1px); }

  .ck-days { gap: 0.45rem; }
  .ck-days .ck-btn {
    min-width: 5.2rem;
    font-family: var(--ck-font-he);
    font-size: 0.95rem;
    padding: 0.34rem 0.8rem;
  }
  .ck-days button.ck-day-on {
    background: var(--ck-teal);
    border-color: var(--ck-teal);
    color: var(--ck-on-teal);
    font-weight: 700;
    box-shadow: var(--ck-shadow-1);
  }

  .ck-themes {
    display: inline-flex;
    border: 1px solid var(--ck-border-strong);
    border-radius: 999px;
    overflow: hidden;
    background: var(--ck-panel-2);
  }
  .ck-themes .ck-btn {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.78rem;
    padding: 0.3rem 0.75rem;
  }
  .ck-themes .ck-btn + .ck-btn { border-inline-start: 1px solid var(--ck-border); }
  .ck-themes .ck-btn:hover { background: var(--ck-gold-wash); box-shadow: none; }
  html[data-theme='day'] .ck-theme[data-t='day'],
  html[data-theme='sepia'] .ck-theme[data-t='sepia'],
  html[data-theme='night'] .ck-theme[data-t='night'] {
    background: var(--ck-teal);
    color: var(--ck-on-teal);
    font-weight: 600;
  }

  .ck-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.55rem;
    font-size: 0.78rem;
    color: var(--ck-muted-2);
  }
  .ck-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.14rem 0.6rem;
    border: 1px dashed var(--ck-gold-soft);
    border-radius: 999px;
    background: var(--ck-panel-2);
  }
  .m-demo { display: inline-block; }
  .ck-legend-note { align-self: center; color: var(--ck-muted); font-size: 0.72rem; }

  /* ── The sheet: main reading surface ──────────────────────────── */
  .ck-content {
    font-family: var(--ck-font-he);
    font-size: var(--ck-size, 26px);
    line-height: 2.15;
    background: var(--ck-paper);
    border: 1px solid var(--ck-border);
    border-top: 3px solid var(--ck-gold-soft);
    border-radius: var(--ck-radius);
    box-shadow: var(--ck-shadow-1);
    padding: 1.2rem 1.1rem 1.6rem;
  }

  .ck-section { margin-bottom: 2.4rem; }
  .ck-section:last-child { margin-bottom: 0.5rem; }

  .ck-sec-head {
    font-size: 1.28em;
    font-weight: 700;
    color: var(--ck-ink);
    border-bottom: 1px solid var(--ck-border);
    padding-bottom: 0.35rem;
    margin-bottom: 0.9rem;
    position: relative;
    line-height: 1.6;
  }
  .ck-sec-head::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: -1px;
    width: 3.5rem;
    height: 3px;
    background: var(--ck-gold);
    border-radius: 2px;
  }
  .ck-sec-head .ck-ref {
    font-family: var(--ck-font-en);
    font-size: 0.5em;
    font-weight: 400;
    color: var(--ck-muted);
    letter-spacing: 0.06em;
  }

  /* ── Mikra verses ─────────────────────────────────────────────── */
  .ck-verse { margin-bottom: 0.9rem; }
  .ck-verse .tk-vnum {
    font-family: var(--ck-font-en);
    color: var(--ck-gold);
    font-size: 0.5em;
    font-weight: 600;
    margin-inline-end: 0.4rem;
    letter-spacing: 0.04em;
  }
  .ck-targum-line {
    font-size: 0.68em;
    line-height: 2;
    color: var(--ck-muted-2);
    background: var(--ck-panel);
    border-inline-start: 3px solid var(--ck-gold-soft);
    border-radius: 10px;
    padding: 0.25rem 0.75rem;
    margin: 0.3rem 0;
  }
  .ck-mikra-repeat { display: none; }

  /* Sheva/qamats marks — on the actual letter */
  .m-na {
    color: var(--ck-m-na);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ck-m-na);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .m-nach {
    color: var(--ck-m-nach);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ck-m-nach);
    text-decoration-thickness: 2px;
    text-decoration-style: double;
    text-underline-offset: 4px;
  }
  .m-qb {
    outline: 1.5px dotted var(--ck-m-qb);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ── Cards & layers (Rashi, Mishna, Gemara, halacha, commentary) ── */
  .ck-card {
    border: 1px solid var(--ck-border);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    margin-bottom: 0.9rem;
    background: var(--ck-panel);
    box-shadow: var(--ck-shadow-1);
  }
  .ck-card .ck-card-title { font-weight: 700; }
  .ck-card .ck-card-ref { color: var(--ck-muted); font-size: 0.9em; }
  .ck-soon { color: var(--ck-muted); font-size: 0.85em; font-style: italic; }

  .ck-layer {
    border: 1px solid var(--ck-border);
    border-radius: 12px;
    margin: 0.7rem 0;
    background: var(--ck-panel);
    box-shadow: var(--ck-shadow-1);
    padding: 0.55rem 0.9rem 0.7rem;
    overflow: hidden;
  }
  .ck-layer summary {
    cursor: pointer;
    margin: -0.55rem -0.9rem 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--ck-gold-wash);
    border-bottom: 1px solid var(--ck-border);
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ck-c-commentary);
    list-style-position: inside;
    transition: background 0.2s;
  }
  .ck-layer summary:hover { background: var(--ck-gold-soft); }
  .ck-layer summary::marker { color: var(--ck-gold); }
  .ck-layer[open] summary { border-bottom: 1px solid var(--ck-border); }
  .ck-layer .ck-he { font-size: 0.8em; line-height: 1.95; margin: 0.3rem 0; }
  .ck-layer .ck-en {
    font-family: var(--ck-font-ui);
    font-size: 0.55em;
    line-height: 1.65;
    color: var(--ck-muted-2);
    margin: 0.3rem 0;
  }

  .ck-carry { border-inline-start: 4px solid var(--ck-teal); }

  .ck-sup summary { color: var(--ck-c-sup); }

  .ck-citem { padding: 0.3rem 0; border-top: 1px dotted var(--ck-border); }
  .ck-citem:first-child { border-top: 0; }
  .ck-citem .ck-ref { font-size: 0.6em; color: var(--ck-muted); }

  .ck-rashi summary { color: var(--ck-c-rashi); }
  .ck-rashi { font-size: 0.72em; }
  .ck-rashi .ck-rbody { line-height: 1.95; margin: 0.25rem 0; }
  .ck-rashi .ck-rbody b { font-weight: 700; color: var(--ck-c-rashi); }
  .ck-rashi .ck-ren {
    font-family: var(--ck-font-ui);
    font-size: 0.82em;
    color: var(--ck-muted-2);
    direction: ltr;
    text-align: left;
    line-height: 1.6;
  }
  .ck-ren-div { border-top: 1px dotted var(--ck-border); margin: 0.35rem 0; }

  .ck-mishna summary { color: var(--ck-c-mishna); }
  .ck-mishna { font-size: 0.78em; }
  .ck-mishna .ck-mishna-item { line-height: 2.05; margin: 0.3rem 0; }
  .ck-mishna .ck-mnum { color: var(--ck-gold); font-size: 0.8em; font-weight: 600; }

  .ck-halacha summary { color: var(--ck-c-mishna); }
  .ck-halacha { font-size: 0.78em; }
  .ck-halacha .ck-halacha-item { line-height: 2.05; margin: 0.3rem 0; }
  .ck-halacha .ck-hnum { color: var(--ck-gold); font-size: 0.8em; font-weight: 600; }

  .ck-bonus summary { color: var(--ck-c-bonus); }

  .ck-gemara summary { color: var(--ck-c-gemara); }
  .ck-gemara { font-size: 0.75em; }
  .ck-gemara .ck-gemara-line { line-height: 1.95; margin: 0.25rem 0; }
  .ck-zohar summary { color: var(--ck-c-sup); }
  .ck-zohar { font-size: 0.78em; }
  .ck-zohar .ck-zohar-line { line-height: 1.95; margin: 0.25rem 0; }
  .ck-comm { margin: 0.35rem 0 0 0; font-size: 0.95em; }
  .ck-comm summary { color: var(--ck-c-comm, #7a6a3a); cursor: pointer; }
  .ck-comm-body { line-height: 1.95; margin: 0.25rem 0; padding-right: 0.6rem; border-right: 2px solid var(--ck-gold-soft, #e7d9ae); }
  .ck-mussar summary { color: var(--ck-c-sup); }
  
                .ck-kavana { margin: .35rem 0 .55rem; }
    .ck-kavana > summary { cursor: pointer; color: var(--ck-gold, #8a6d1d); font-size: .9em; }
    .ck-kavana-body { line-height: 1.95; padding: .35rem .2rem; }

    .ck-kav-gate { margin: .4rem 0; }
    .ck-kav-gate > summary, .ck-kav-ch > summary { cursor: pointer; color: var(--ck-gold, #8a6d1d); font-size: .95em; }
    .ck-kav-body { padding: .3rem .6rem; }
    .ck-kav-ch { margin: .4rem 0; }
    .ck-kav-para { margin: .2rem 0; line-height: 1.9; }
    .ck-kav-note { opacity: .7; font-size: .9em; margin: .3rem 0; }

    .ck-super { margin: .4rem 0; }
    .ck-super > summary { cursor: pointer; color: var(--ck-gold, #8a6d1d); font-size: .92em; }
    .ck-sup-name { font-weight: 700; margin-top: .55rem; }
    .ck-sup-body { margin: .15rem 0; line-height: 1.85; }

    .ck-voice { border-inline-start: 3px solid var(--ck-gold, #b8860b); background: rgba(184,134,11,.06); padding: .7rem 1rem; border-radius: .5rem; margin: .5rem 0; }
    .ck-voice-part { margin: .4rem 0; }
    .ck-voice-k { font-weight: 700; font-size: .85em; opacity: .75; margin-bottom: .15rem; }
    .ck-voice-row { border-inline-start: 2px solid rgba(184,134,11,.45); padding-inline-start: .7rem; margin: .45rem 0; }
    .ck-voice-he { font-size: 1.05em; line-height: 1.9; }
    .ck-voice-en { direction: ltr; text-align: left; font-style: italic; opacity: .8; margin-top: .2rem; }
    .ck-voice-top .ck-voice { background: rgba(184,134,11,.09); }

    .ck-mussar-text { line-height: 1.95; margin: 0.3rem 0; padding-right: 0.6rem; border-right: 2px solid var(--ck-gold-soft, #e7d9ae); }
