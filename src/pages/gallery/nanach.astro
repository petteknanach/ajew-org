<Layout title="Na Nach Life Gallery" description="Photos of the Na Nach Breslov movement">
  <section class="page-header">
    <h1>✡ Na Nach Breslov Movement ✡</h1>
    <p>Spreading the light of Rabbi Nachman throughout the world</p>
    <p class="hebrew">נַ נַחְ נַחְמָ נַחְמָן מאוּמָן</p>
    <p class="stats">&lbrace;allImages.length&rbrace; images</p>
    <a href="/gallery" class="back-link">← Back to Gallery</a>
  </section>

  <section class="intro">
    <div class="container">
      <div class="info-box">
        <h2>🌟 The Na Nach Movement</h2>
        <p>The Na Nach Breslov movement was inspired by Rabbi Yisroel Ber Odesser (Saba) who received the miraculous Petek in 1922.</p>
        <p class="hebrew">תנועת נ נח מברסלב התפתחה מהפתק שקיבל הסבא רבי ישראל בר אודסר</p>
      </div>
      
      <div class="quick-index">
        <h3>📂 Quick Index</h3>
        <div class="index-links">
          &lbrace;Object.entries(categories).map(([key, cat]) => (
            cat.images.length > 0 && (
              <a href=&lbrace;`#category-$&lbrace;key&rbrace;`&rbrace; class="index-link">
                <span class="icon">&lbrace;cat.icon&rbrace;</span>
                <span class="name">&lbrace;cat.name&rbrace;</span>
                <span class="count">&lbrace;cat.images.length&rbrace;</span>
              </a>
            )
          ))&rbrace;
        </div>
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="container">
      &lbrace;Object.entries(categories).map(([key, cat]) => (
        cat.images.length > 0 && (
          <div id=&lbrace;`category-$&lbrace;key&rbrace;`&rbrace; class="category-section">
            <h2><span class="icon">&lbrace;cat.icon&rbrace;</span> &lbrace;cat.name&rbrace; <span class="hebrew">(&lbrace;cat.hebrew&rbrace;)</span></h2>
            <div class="gallery-grid">
              &lbrace;cat.images.map((img, index) => (
                <div class="gallery-item">
                  <img src=&lbrace;`/images/nanach/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                  <div class="overlay"><span>&lbrace;cat.name&rbrace; #&lbrace;index + 1&rbrace;</span></div>
                  <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
                </div>
              ))&rbrace;
            </div>
          </div>
        )
      ))&rbrace;
    </div>
  </section>

  <section class="navigation">
    <div class="container">
      <div class="nav-buttons">
        <a href="/gallery/uman" class="nav-btn prev">
          <span class="arrow">←</span><span class="text">Tomb in Uman</span>
        </a>
        <a href="/gallery/events" class="nav-btn next">
          <span class="text">Events Gallery</span><span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

