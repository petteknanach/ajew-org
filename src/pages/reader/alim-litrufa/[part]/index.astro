---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/alim-litrufa/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/alim-litrufa/part-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || "Alim LiTrufa"} — Part ${partNum} Index`} description={`Beautiful directory for Alim LiTrufa, part ${partNum}.`}>
  {partNum === 2 && <aside data-qualified-additive="alim-2-17-62-63"><a href="/reader/alim-litrufa/reviewed/">Additive AI-reviewed / editorially qualified Part 2 letters 17, 62, 63</a><p>Three complete letters only; canonical edition unchanged. Not whole-book, human/source-owner approval or publication permission.</p></aside>}
  <ReaderDirectory
    title="Alim LiTrufa"
    hebrewTitle="עלים לתרופה"
    subtitle={`Letters of Rabbi Nosson · Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/alim-litrufa/${partNum}/`}
  />
</Layout>
