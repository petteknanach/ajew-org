---
import Layout from '../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load the index with full hierarchy
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/chayey-moharan/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  indexData = null;
}

const pageTitle = 'Chayay Moharan — Directory';
const pageDesc = 'The life, journeys, wisdom, and teachings of Rabbi Nachman of Breslov. 615 simanim organized into thematic sections.';
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="directory-container">
    <div class="directory-header">
      <h1 class="dir-title-en">Chayay Moharan</h1>
      <h2 class="dir-title-he">חיי מוהר"ן</h2>
      <p class="dir-subtitle">The Life of Rabbi Nachman of Breslov</p>
      <p class="dir-author">by Rabbi Nosson of Breslov (Moharnat)</p>
      <p class="dir-count">{indexData?.totalSimanim || 615} Simanim in {indexData?.totalSections || 20} Sections</p>
    </div>

    <form class="chayey-search" action="/search-enhanced" method="get" role="search">
      <input type="hidden" name="book" value="chayey-moharan" />
      <label for="chayey-search-input">
        <strong>Search the complete Chayay Moharan</strong>
        <span>חיפוש בכל חיי מוהר״ן · Hebrew and English</span>
      </label>
      <div class="chayey-search-row">
        <input id="chayey-search-input" name="q" type="search" placeholder="Search words, phrases, people, places…" required />
        <button type="submit">Search all 615</button>
      </div>
    </form>

    <!-- Special Pages -->
    <div class="dir-section special-pages">
      <h3 class="dir-section-title">📄 Special Pages</h3>
      <div class="dir-grid">
        {indexData?.specialPages?.map((page: any) => (
          <a href={page.url} class="dir-card special">
            <span class="card-he">{page.hebrewTitle}</span>
            <span class="card-en">{page.title}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Early Sections (Simanim 1-59) -->
    <div class="dir-section">
      <h3 class="dir-section-title">📖 Part I — Torah Conversations & Stories</h3>
      <p class="dir-section-range">Simanim 1–59</p>
      <div class="dir-grid">
        {indexData?.earlySections?.map((sec: any) => (
          <a href={sec[4]} class="dir-card">
            <span class="card-number">Simanim {sec[2]}–{sec[3]}</span>
            <span class="card-he">{sec[1]}</span>
            <span class="card-en">{sec[0]}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Parts with Subsections -->
    {indexData?.parts?.map((part: any, pi: number) => (
      <div class="dir-section">
        <h3 class="dir-section-title">
          {pi === 0 ? '📍' : pi === 1 ? '🏛️' : pi === 2 ? '📜' : '🙏'} {part.part}
        </h3>
        {part.sections?.map((sec: any) => (
          <div class="dir-subsection">
            <div class="sub-header">
              <span class="sub-range">
                {sec.first && sec.last 
                  ? `Simanim ${sec.first}–${sec.last}` 
                  : ''}
                <span class="sub-count">({sec.count} simanim)</span>
              </span>
              <span class="sub-he">{sec.he}</span>
              <span class="sub-en">{sec.en}</span>
            </div>
            <div class="sub-links">
              {sec.articles?.map((art: number) => (
                <a href={`/reader/chayey-moharan/siman/${art}`} class="siman-link">
                  {art}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</Layout>

<style>
  .directory-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .directory-header {
    text-align: center;
    padding: 40px 20px;
    margin-bottom: 40px;
    background: linear-gradient(135deg, #f8f5f0 0%, #f0ead6 100%);
    border-radius: 12px;
    border: 2px solid #c8a84b;
  }

  .dir-title-en {
    font-size: 2em;
    color: #1e3a5f;
    margin: 0 0 8px;
    font-family: Georgia, serif;
  }

  .dir-title-he {
    font-size: 1.8em;
    color: #8B6914;
    margin: 0 0 12px;
    font-family: 'Frank Ruhl Libre', serif;
    direction: rtl;
  }

  .dir-subtitle {
    font-size: 1.1em;
    color: #555;
    margin: 0 0 4px;
    font-style: italic;
  }

  .dir-author {
    font-size: 0.95em;
    color: #777;
    margin: 0 0 8px;
  }

  .dir-count {
    font-size: 1em;
    color: #8B6914;
    font-weight: bold;
  }

  .chayey-search {
    margin: -20px 0 42px;
    padding: 18px;
    border-radius: 12px;
    border: 1px solid #c8a84b;
    background: #fffdf7;
    box-shadow: 0 6px 20px rgba(30, 58, 95, .08);
  }

  .chayey-search label { display: grid; gap: 2px; margin-bottom: 10px; color: #1e3a5f; }
  .chayey-search label span { color: #777; font-size: .88rem; font-weight: normal; }
  .chayey-search-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  .chayey-search input[type="search"] { min-width: 0; padding: 11px 12px; border: 1px solid #cfc3a4; border-radius: 8px; font: inherit; }
  .chayey-search button { border: 0; border-radius: 8px; padding: 11px 18px; background: #1e3a5f; color: #fff; font-weight: 800; cursor: pointer; }

  @media (max-width: 560px) {
    .chayey-search-row { grid-template-columns: 1fr; }
    .chayey-search button { min-height: 44px; }
  }

  .dir-section {
    margin-bottom: 48px;
  }

  .dir-section-title {
    font-size: 1.3em;
    color: #1e3a5f;
    border-bottom: 2px solid #c8a84b;
    padding-bottom: 8px;
    margin: 0 0 8px;
  }

  .dir-section-range {
    color: #888;
    font-size: 0.9em;
    margin: 0 0 16px;
  }

  .dir-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }

  .dir-card {
    display: block;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #e0d5b8;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    border-right: 3px solid #c8a84b;
  }

  .dir-card:hover {
    background: #fdf8ed;
    border-color: #8B6914;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(139, 105, 20, 0.15);
  }

  .dir-card.special {
    border-right-color: #6a9fb5;
  }

  .card-number {
    display: block;
    font-size: 0.75em;
    color: #8B6914;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .card-he {
    display: block;
    font-size: 1em;
    color: #333;
    font-family: 'Frank Ruhl Libre', serif;
    direction: rtl;
    text-align: right;
    margin-bottom: 2px;
  }

  .card-en {
    display: block;
    font-size: 0.85em;
    color: #555;
    margin-top: 2px;
  }

  /* Subsections with siman links */
  .dir-subsection {
    margin: 16px 0 24px;
    padding: 16px 20px;
    background: #fafaf7;
    border-radius: 8px;
    border-left: 4px solid #c8a84b;
  }

  .sub-header {
    margin-bottom: 12px;
  }

  .sub-range {
    display: block;
    font-size: 0.8em;
    color: #8B6914;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .sub-count {
    color: #999;
    font-weight: normal;
    font-size: 0.9em;
  }

  .sub-he {
    display: block;
    font-size: 1.1em;
    color: #333;
    font-family: 'Frank Ruhl Libre', serif;
    direction: rtl;
    text-align: right;
    margin-bottom: 2px;
  }

  .sub-en {
    display: block;
    font-size: 0.95em;
    color: #555;
    font-style: italic;
    margin-bottom: 8px;
  }

  .sub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .siman-link {
    display: inline-block;
    padding: 3px 10px;
    background: #f0ead6;
    color: #5a3e00;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
    transition: all 0.15s;
  }

  .siman-link:hover {
    background: #c8a84b;
    color: #fff;
  }

  .siman-more {
    display: inline-block;
    padding: 3px 10px;
    color: #999;
    font-size: 0.8em;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .dir-title-en { font-size: 1.5em; }
    .dir-title-he { font-size: 1.3em; }
    .dir-grid { grid-template-columns: 1fr; }
    .directory-container { padding: 20px 12px 60px; }
    .siman-link { padding: 4px 8px; font-size: 0.8em; }
  }
</style>
