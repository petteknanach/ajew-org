  "themes": [
    "זכירה"
  ],
  "keywords": [],
  "simanim": [],
  "segments": [
    {
      "index": 1,
      "he": "א.\r\n\r\nמִי שֶׁמְּבַיֵּשׁ פְּנֵי חֲבֵרוֹ, נַעֲשֶׂה שַׁכְחָן.",
      "en": ""
    },
    {
      "index": 2,
      "he": "ב.\r\n\r\nעַל-יְדֵי דְּאָגָה בָּא שִׁכְחָה.",
      "en": ""
    },
    {
      "index": 3,
      "he": "ג.\r\n\r\nעַל-יְדֵי לִמּוּד בְּפֶה מָלֵא בָּא זְכִירָה.",
      "en": ""
    },
    {
      "index": 4,
      "he": "ד.\r\n\r\nעַל-יְדֵי צַעַר בָּא שִׁכְחָה.",
      "en": ""
    },
    {
      "index": 5,
      "he": "ה.\r\n\r\nכְּשֶׁתְּצַיֵּר לְפָנֶיךָ צוּרַת אָבִיךָ וְאִמְּךָ, תָּבוֹא לִזְכִירָה.",
      "en": ""
    },
    {
      "index": 6,
      "he": "ו.\r\n\r\nעַל-יְדֵי מִצְוֹת מַעֲשִׂיּוֹת הָאָדָם נִתָּר מִמִּדַּת שִׁכְחָה וְנִקְשָׁר בְּמִדַּת זְכִירָה.",
      "en": ""
    },
    {
      "index": 7,
      "he": "ז.\r\n\r\nעַל-יְדֵי נִאוּף מְאַבֵּד הַזִּכָּרוֹן.",
      "en": ""
    },
    {
      "index": 8,
      "he": "ח.\r\n\r\nעַל-יְדֵי כְּזָבִים בָּא שִׁכְחָה.",
      "en": ""
    },
    {
      "index": 9,
      "he": "ט.\r\n\r\nמִי שֶׁאֵין לוֹ זִכָּרוֹן, יַחֲזִיר אֶת בְּנֵי-אָדָם בִּתְשׁוּבָה.",
      "en": ""
    },
    {
      "index": 10,
      "he": "י.\r\n\r\n\r\n\r\nמִי שֶׁאֵין לוֹ זִכָּרוֹן, בְּיָדוּעַ שֶׁלֹּא תִּקֵּן חַטְּאוֹת נְעוּרִים.",
      "en": ""
    },
    {
      "index": 11,
      "he": "יא.\r\n\r\nמִי שֶׁהוּא שַׁכְחָן, יִתֵּן צְדָקָה.",
      "en": ""
    },
    {
      "index": 12,
      "he": "יב.\r\n\r\nמִי שֶׁאֵין לוֹ זִכָּרוֹן, יְקַדֵּשׁ אֶת עַצְמוֹ בִּקְדֻשָּׁה גְּדוֹלָה.",
      "en": ""
    },
    {
      "index": 13,
      "he": "יג.\r\n\r\nעַל-יְדֵי שִׁפְלוּת תִּזְכֶּה לְזִכָּרוֹן.",
      "en": ""
    },
    {
      "index": 14,
      "he": "יד.\r\n\r\nעַל-יְדֵי עַצְבוּת בָּא שִׁכְחָה.",
      "en": ""
    },
    {
      "index": 15,
      "he": "טו.\r\n\r\nהַמַּצִּיעַ תַּלְמוּדוֹ בְּצִנְעָה, אֵינוֹ מְשַׁכֵּחַ.",
      "en": ""
    }
  ],
