---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Chok LiYisroel - Daily Study"
  description="The daily Chok LiYisroel: Torah with nikud, taamim and Onkelos, Navi, Kesuvim, Mishna, Gemara, Zohar, halacha and mussar - each day's full spread."
>
  <div class="ck-wrap" dir="rtl">
    <header class="ck-header">
      <h1>חק לישראל <span class="ck-sub">Chok LiYisroel · daily</span></h1>
      <p class="ck-date" id="ck-date" dir="ltr"></p>
      <p class="ck-week" id="ck-week"></p>
      <p class="ck-sibling"><a href="/daily-study">חק ברסלב</a> <span>— finish the Breslov books every year · /daily-study</span></p>
    </header>

    <div class="ck-controls" dir="ltr">
      <div class="ck-quick-rail">
        <label class="ck-option-box">Week · פרשה <select id="ck-parsha"></select></label>
        <label class="ck-option-box">Day · יום <select id="ck-day" aria-label="Study day"></select></label>
        <label class="ck-option-box">Language · שפה <select id="ck-language"><option value="both">HE + EN</option><option value="he">Hebrew</option><option value="en">English + original</option><option value="original">Untouched original</option></select></label>
      </div>
      <div class="ck-option-grid" aria-label="Study offerings">
        <details class="ck-option-box ck-reading-options"><summary>Reading options<br/>אפשרויות קריאה</summary><div class="ck-option-panel ck-row">
        <label>Display · תצוגה
          <select id="ck-mode">
            <option value="full">Nikud + Taamim</option>
            <option value="nikud">Nikud only</option>
            <option value="taamim">Taamim only</option>
            <option value="letters">Letters only</option>
          </select>
        </label>
        <label>Theme · רקע <select id="ck-theme"><option value="day">Day</option><option value="sepia">Sepia</option><option value="night">Night</option></select></label>
        <label class="ck-chk"><input type="checkbox" id="ck-medooyuk" checked /> Medooyuk</label>
        <label class="ck-chk"><input type="checkbox" id="ck-targum" /> Targum</label>
        <label class="ck-chk"><input type="checkbox" id="ck-rashi" checked /> Rashi</label>
        <label class="ck-chk"><input type="checkbox" id="ck-commentary" checked /> Commentary</label>
        <label class="ck-chk" hidden><input type="checkbox" id="ck-tanachen" checked /> English</label>
        <label>Carry
          <select id="ck-carrymode" title="הסבר פשוט — מה משך אתמול ומה היום: פתיחה פעם ביום, תמיד, או אף פעם">
            <option value="daily">Daily</option>
            <option value="always">Always</option>
            <option value="never">Never</option>
          </select>
        </label>
        <label class="ck-size">Size <input type="range" id="ck-size" min="16" max="44" value="26" /></label>
        <label>Kavanos
          <select id="ck-kavanamode" title="כוונות כלליות, סדר השבוע וכוונות לכל חלק — סגור בתחילה או פתוח תמיד">
            <option value="closed">Closed initially</option>
            <option value="always">Always open</option>
          </select>
        </label>
        <details class="ck-mark-key"><summary>Medooyuk marks · סימני הניקוד</summary><div class="ck-legend" id="ck-legend" dir="rtl">
          <span><span class="m-demo marked-hebrew" style="font-feature-settings:'ss01' 1">שְ</span> = שוא נא (נשמע) · שתי נקודות עבות</span>
          <span><span class="m-demo marked-hebrew" style="font-feature-settings:'ss02' 1">קָ</span> = קומוץ קטן · מוגדל</span>
          <span><span class="m-demo marked-hebrew" style="font-feature-settings:'ss03' 1">קָ</span> = קמץ טעון בירור</span>
          <span><span class="m-demo marked-hebrew" style="font-feature-settings:'ss04' 1">אֽ</span> = מטג (געיה)</span>
          <span class="ck-legend-note">הסימון על הניקוד עצמו — האותיות רגילות</span>
        </div></details>
        </div></details>
        <details class="ck-option-box" id="ck-study-overview"><summary>Study overview<br/>סדר הלימוד</summary><div class="ck-option-panel ck-offering-body" id="ck-study-overview-body" dir="rtl"></div></details>
        <a class="ck-option-box ck-offering-link" href="/reader/chok/tefillos/">Prayers<br/>תפלות</a>
        <a class="ck-option-box ck-offering-link" href="/reader/chok/kavanos/">Kavanos<br/>כוונות</a>
        <a class="ck-option-box ck-offering-link" id="ck-full-parsha" href="/parsha/noach/">Full parsha<br/>הפרשה בשלמותה</a>
        <details class="ck-option-box" id="ck-breslov-offering"><summary>Breslov<br/>ברסלב</summary><div class="ck-option-panel ck-offering-body" id="ck-breslov-offering-body" dir="rtl"></div></details>
      </div>
      <div id="ck-breslov-availability" aria-live="polite"></div>
      <div id="ck-days" hidden></div>
    </div>

    <nav id="ck-jumps" class="ck-jumps" aria-label="Jump to study section" dir="rtl"></nav>

    <main id="ck-content" class="ck-content" dir="rtl" lang="he"></main>

    <footer class="ck-foot" dir="ltr">
      <p><a href="/reader/tikkun/">שנים מקרא ואחד תרגום · Shnayim Mikra</a></p>
      <p><a href="/tikkun/qatan-sources.html">MAM qatan supplement — Hebrew Wikisource · CC BY-SA 4.0 · sources and changes</a></p>
    </footer>
  </div>
</Layout>

<script src="/tikkun-boundaries.js?v=visible-nikud-20261004-r2" defer></script>
<script src="/tikkun-qatan.js?v=03678ee00f7b58a15f48e387edfa3060f3257cd297586bdcfba14b24931cddf1" defer></script>
<script src="/medooyuk.js?v=four-surfaces-20261006-r1" defer></script>
<script src="/psalms-data.js?v=psalms-annotations-20261002-r1&amp;integrity=sha256-20261003" defer></script>
<script src="/chok-verse-breslov.js?v=parsha-author-20261020-reader-notes-r1" defer></script>
<script src="/chok-source-reader.js?v=chok-live-corrections-20261020-r1" defer></script>
<script src="/chok-lech-sunday.js?v=chok-live-corrections-20261018-r2" defer></script>
<script src="/chok-lech-monday.js?v=chok-live-corrections-20261019-r1" defer></script>
<script src="/chok-lech-tuesday.js?v=6105a3ee4cb5216795cf74684ffbd59d08f8be3bd2a363b1234394041f3edefd" defer></script>
<script is:inline src="/chok-qualified-daily.js?v=00ce7a4d805eff8d94dded4ea93fc747fe1d5ead1e919b8247d8863cd0505e65" integrity="sha256-AM56TYBe/42U3e1OqT/HR/4dXq0ekZuCR9iGPNBQXmU=" crossorigin="anonymous" defer></script>
<script is:inline src="/chok-qualified-daily-selected.js?v=62646a66b49b013ff357ba3053eebbd3b95553a6d242e7c168cab1fa676fc6a0" integrity="sha256-YmRqZrSbAT/zV7owU+6707lVU6bSQufBaMqx+mdvxqA=" crossorigin="anonymous" defer></script>
<script is:inline src="/chok.js?v=388157acda00b216c7115242542476262961d42d31cb908df33640955549b22d" integrity="sha256-OIFXrNoAshbHEVJCVCR2Jilh1C0xy5CN8zZAlVVJsi0=" crossorigin="anonymous" defer></script>

<style is:global>
  /* Actual study offerings: three columns/two rows, selectors separate. */
  .ck-quick-rail { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.4rem; margin-bottom:.4rem; }
  .ck-option-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); grid-template-rows:repeat(2,auto); gap:.4rem; position:relative; }
  .ck-option-box { min-width:0; padding:.35rem .45rem; border:1px solid var(--ck-border-strong); border-radius:8px; background:var(--ck-panel-2); font-size:.75rem; }
  .ck-option-box select { display:block; width:100%; min-width:0; max-width:100%; padding:.25rem .1rem; min-height:32px; border:0; background:transparent; color:var(--ck-ink); font-size:.82rem; }
  .ck-option-box > summary, .ck-offering-link { cursor:pointer; min-height:44px; display:block; box-sizing:border-box; line-height:1.35; text-decoration:none; color:var(--ck-ink); }
  .ck-option-panel { position:absolute; inset-inline:0; top:100%; z-index:5; margin:.3rem 0 0; padding:1rem; border:1px solid var(--ck-border-strong); border-radius:10px; background:var(--ck-panel-2); box-shadow:var(--ck-shadow-2); }
  .ck-wrap [hidden] { display:none !important; }
  .ck-offering-body { max-height:70vh; overflow:auto; font-size:1rem; }
  .ck-mark-key { margin-top:.5rem; font-size:.75rem; }
  .ck-reading-options .ck-mark-key { flex-basis:100%; }
  .ck-mark-key > summary { min-height:44px; }
  .ck-jumps { display:flex; flex-wrap:wrap; gap:.4rem .8rem; border-block:1px solid var(--ck-border); padding:.6rem 0; margin-bottom:.8rem; font-size:.83rem; }
  .ck-jumps a { color:var(--ck-teal-deep); text-decoration:none; }
  .ck-section { scroll-margin-top:5rem; }
  .ck-source-languages { display:flex; gap:.4rem; margin:.6rem 0; }
  .ck-source-languages button { padding:.4rem .6rem; min-height:44px; border:1px solid var(--ck-border-strong); border-radius:7px; background:var(--ck-panel-2); color:var(--ck-ink); }
  .ck-source-languages button[aria-pressed='true'] { border-color:var(--ck-teal); outline:1px solid var(--ck-teal); }
  .ck-source-pair, .ck-native-pair, .ck-complete-pair { margin:.7rem 0; }
  .ck-source-pair .ck-he, .ck-native-pair .ck-he, .ck-original { white-space:pre-wrap; font-size:var(--ck-size,26px); line-height:1.9; font-family:var(--ck-font-he); font-synthesis:none; }
  .ck-untouched-original { white-space:pre-wrap; font-size:var(--ck-size,26px); line-height:1.9; font-family:var(--ck-font-he); font-synthesis:none; }
  .ck-source-pair .ck-en, .ck-native-pair .ck-en { white-space:pre-wrap; font-family:var(--ck-font-en); font-size:1.12rem; line-height:1.8; }
  .ck-source-qualification { padding:.5rem .75rem; margin:.65rem 0; border-inline-start:2px solid var(--ck-gold); font-size:.9rem; line-height:1.7; font-family:var(--ck-font-en); }
  .ck-targum-reading { border-inline-start:2px solid var(--ck-gold-soft); padding-inline-start:.7rem; margin-top:.5rem; }
  .ck-targum-reading h4, .ck-reading-ref { font-size:.84rem; margin:.35rem 0; font-family:var(--ck-font-ui); font-weight:400; }
  .ck-verse-access { font-size:.8rem; margin:.5rem 0; }
  .ck-verse > .ck-verse-breslov { display:block; width:100%; box-sizing:border-box; font-size:1rem; }
  .ck-breslov-owner { margin:1rem 0; }
  .ck-breslov-owner > .ck-source-qualification { font-size:.9rem; }
  .ck-verse-breslov .ck-source-pair .ck-he, .ck-breslov .ck-source-pair .ck-he { font-size:var(--ck-size,26px); }
  .ck-verse-breslov .ck-source-pair .ck-en, .ck-breslov .ck-source-pair .ck-en { font-size:1.12rem; }
  .ck-verse-breslov [hidden] { display:none !important; }
  .ck-classical-gloss { display:block; border-inline-start:2px solid var(--ck-border); padding-inline-start:.6rem; font-size:.85em; margin:.5rem 0; }
  .ck-content[data-language='original'] .ck-voice-layer, .ck-content[data-language='original'] .ck-explanation, .ck-content[data-language='original'] .ck-voice-row, .ck-content[data-language='original'] .ck-comm, .ck-content[data-language='original'] .ck-mishna-explanation, .ck-content[data-language='original'] .ck-mishna-questions, .ck-content[data-language='original'] .ck-mishna-terms { display:none; }
  .ck-source-island[data-language='he'] .ck-en, .ck-source-island[data-language='en'] .ck-he { display:none; }
  .ck-generated-ref { display:inline-flex; unicode-bidi:isolate; white-space:nowrap; }
  /* Source abbreviations remain in their Onkelos sentence, not a block note. */
  .ck-targum-line .ck-classical-gloss { display:inline; border:0; padding:0; margin:0; }
  .ck-kavana-para { margin-block: 0.65rem; white-space: pre-wrap; }
  .ck-kavana-note { font-size: 0.85rem; line-height: 1.6; color: var(--ck-muted-2); }
  /* ═══════════════════════════════════════════════════════════════
     Chok LiYisroel — deluxe sefer presentation
     One warm token system, shared with /daily-study.
     Day theme rides the site; Sepia/Night come from chok.js via
     html[data-theme]; site dark mode is body.dark-mode.
     ═══════════════════════════════════════════════════════════════ */
  .ck-wrap {
    --ck-font-he: 'Noto Serif Hebrew', 'David Libre', 'Frank Ruhl Libre', serif;
    --ck-font-en: 'EB Garamond', Georgia, 'Times New Roman', serif;
    --ck-font-ui: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

    --ck-ink: #2f2519;
    --ck-paper: #fbf7ee;
    --ck-panel: #f4eddc;
    --ck-panel-2: #fffdf6;
    --ck-border: #e3d8bf;
    --ck-border-strong: #cfc09a;
    --ck-gold: #a8842e;
    --ck-gold-bright: #c9a227;
    --ck-gold-soft: #e7d9ae;
    --ck-gold-wash: rgba(168, 132, 46, 0.08);
    --ck-teal: #177f70;
    --ck-teal-deep: #106154;
    --ck-on-teal: #ffffff;
    --ck-muted: #8d7f66;
    --ck-muted-2: #6f6350;
    --ck-ok: #2d6a4f;
    --ck-danger: #a33a2e;
    --ck-m-na: #177f70;
    --ck-m-qb: #b04a3a;
    --ck-m-qk: #c34a3a;
    --ck-m-meteg: #6f55c9;
    --ck-c-commentary: var(--ck-teal-deep);
    --ck-c-rashi: #9c5224;
    --ck-c-mishna: #27648c;
    --ck-c-gemara: #7d5226;
    --ck-c-bonus: #256b44;
    --ck-c-sup: #6c5496;
    --ck-shadow-1: 0 1px 2px rgba(63, 48, 26, 0.06), 0 6px 18px -6px rgba(63, 48, 26, 0.12);
    --ck-shadow-2: 0 2px 4px rgba(63, 48, 26, 0.08), 0 14px 34px -12px rgba(63, 48, 26, 0.24);
    --ck-radius: 14px;

    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
    color: var(--ck-ink);
    font-family: var(--ck-font-ui);
  }

  /* Site-wide dark mode (body.dark-mode) and the page's Night theme
     share one dignified ink-and-brass palette. */
  body.dark-mode .ck-wrap,
  html[data-theme='night'] .ck-wrap {
    --ck-ink: #ede4cf;
    --ck-paper: #171d26;
    --ck-panel: #1d2530;
    --ck-panel-2: #232c39;
    --ck-border: #35404f;
    --ck-border-strong: #4c5a6c;
    --ck-gold: #d2b264;
    --ck-gold-bright: #e3c877;
    --ck-gold-soft: #4a3f22;
    --ck-gold-wash: rgba(210, 178, 100, 0.09);
    --ck-teal: #3fbfae;
    --ck-teal-deep: #2f9d8f;
    --ck-on-teal: #0d1517;
    --ck-muted: #a4977e;
    --ck-muted-2: #b5aa93;
    --ck-ok: #7fd1a5;
    --ck-danger: #e08a7a;
    --ck-m-na: #45c2b0;
    --ck-m-qb: #e08a7a;
    --ck-m-qk: #ef8f7c;
    --ck-m-meteg: #a98fe6;
    --ck-c-commentary: #45c2b0;
    --ck-c-rashi: #d99a5f;
    --ck-c-mishna: #6fb1dd;
    --ck-c-gemara: #cf9c60;
    --ck-c-bonus: #6cc294;
    --ck-c-sup: #b39ae0;
    --ck-shadow-1: 0 1px 2px rgba(0, 0, 0, 0.35), 0 8px 24px -8px rgba(0, 0, 0, 0.5);
    --ck-shadow-2: 0 2px 6px rgba(0, 0, 0, 0.4), 0 18px 44px -12px rgba(0, 0, 0, 0.62);
  }

  /* Sepia: a dedicated parchment reading theme; wins over site dark mode. */
  html[data-theme='sepia'] .ck-wrap {
    --ck-ink: #3b2e1a;
    --ck-paper: #f6eed9;
    --ck-panel: #efe5c9;
    --ck-panel-2: #fbf5e4;
    --ck-border: #dccfa9;
    --ck-border-strong: #c2b184;
    --ck-teal: #17685c;
    --ck-teal-deep: #115349;
    --ck-muted: #8a7a62;
    --ck-muted-2: #6b5a42;
  }

  .ck-wrap ::selection { background: var(--ck-gold-soft); color: var(--ck-ink); }
  .ck-wrap :focus-visible { outline: 2px solid var(--ck-teal); outline-offset: 2px; border-radius: 4px; }

  /* ── Header: sefer title page ─────────────────────────────────── */
  .ck-header {
    text-align: center;
    padding: .25rem 0.5rem 0;
    border-bottom: 1px solid var(--ck-gold-soft);
    position: relative;
    margin-bottom: .65rem;
  }
  .ck-header::after {
    content: '✦';
    position: absolute;
    inset-inline-start: 50%;
    bottom: -0.62em;
    transform: translateX(50%);
    color: var(--ck-gold);
    font-size: 0.85rem;
    line-height: 1;
    background: transparent;
    padding: 0 0.5rem;
  }
  .ck-header h1 {
    font-family: var(--ck-font-he);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 700;
    margin: 0 0 0.2rem;
    color: var(--ck-ink);
    line-height: 1.35;
  }
  .ck-sub {
    font-family: var(--ck-font-en);
    font-size: 1rem;
    color: var(--ck-muted);
    font-weight: 400;
    letter-spacing: 0.08em;
  }
  .ck-date, .ck-week {
    color: var(--ck-muted);
    margin: 0.15rem 0;
    font-size: 0.95rem;
    font-family: var(--ck-font-en);
    letter-spacing: 0.02em;
  }
  .ck-sibling {
    margin: .25rem 0 .4rem;
    font-size: 0.85rem;
    color: var(--ck-muted);
  }
  .ck-sibling a {
    display: inline-block;
    padding: 0.2rem 0.85rem;
    border: 1px solid var(--ck-gold-soft);
    border-radius: 999px;
    background: var(--ck-gold-wash);
    color: var(--ck-gold);
    font-family: var(--ck-font-he);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .ck-sibling a:hover { border-color: var(--ck-gold); color: var(--ck-gold-bright); background: var(--ck-panel-2); }

  /* ── Controls: reading desk ───────────────────────────────────── */
  .ck-controls {
    border: 1px solid var(--ck-border);
    border-radius: var(--ck-radius);
    padding: 0.7rem 0.9rem;
    margin-bottom: .5rem;
    background: var(--ck-panel);
    box-shadow: var(--ck-shadow-1);
  }
  .ck-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin: 0.35rem 0;
  }
  .ck-row label {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--ck-muted-2);
    letter-spacing: 0.03em;
  }
  .ck-row select {
    padding: 0.32rem 0.45rem;
    border-radius: 9px;
    border: 1px solid var(--ck-border-strong);
    background: var(--ck-panel-2);
    color: var(--ck-ink);
    font-family: inherit;
    font-size: 0.85rem;
    max-width: 200px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ck-row select:hover { border-color: var(--ck-gold); }
  .ck-row input[type='checkbox'] { accent-color: var(--ck-teal); width: 15px; height: 15px; }
  .ck-size input[type='range'] { accent-color: var(--ck-gold); width: 90px; }

  .ck-btn {
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--ck-border-strong);
    background: var(--ck-panel-2);
    color: var(--ck-ink);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, color 0.2s, transform 0.15s;
  }
  .ck-btn:hover {
    border-color: var(--ck-gold);
    box-shadow: var(--ck-shadow-1);
  }
  .ck-btn:active { transform: translateY(1px); }

  .ck-days { gap: 0.45rem; }
  .ck-days .ck-btn {
    min-width: 5.2rem;
    font-family: var(--ck-font-he);
    font-size: 0.95rem;
    padding: 0.34rem 0.8rem;
  }
  .ck-days button.ck-day-on {
    background: var(--ck-teal);
    border-color: var(--ck-teal);
    color: var(--ck-on-teal);
    font-weight: 700;
    box-shadow: var(--ck-shadow-1);
  }

  .ck-themes {
    display: inline-flex;
    border: 1px solid var(--ck-border-strong);
    border-radius: 999px;
    overflow: hidden;
    background: var(--ck-panel-2);
  }
  .ck-themes .ck-btn {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.78rem;
    padding: 0.3rem 0.75rem;
  }
  .ck-themes .ck-btn + .ck-btn { border-inline-start: 1px solid var(--ck-border); }
  .ck-themes .ck-btn:hover { background: var(--ck-gold-wash); box-shadow: none; }
  html[data-theme='day'] .ck-theme[data-t='day'],
  html[data-theme='sepia'] .ck-theme[data-t='sepia'],
  html[data-theme='night'] .ck-theme[data-t='night'] {
    background: var(--ck-teal);
    color: var(--ck-on-teal);
    font-weight: 600;
  }

  .ck-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.55rem;
    font-size: 0.78rem;
    color: var(--ck-muted-2);
