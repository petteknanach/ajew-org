import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const imageDir = './public/images/saba/';

function getAllImages() &lbrace;
  try &lbrace;
    const files = fs.readdirSync(imageDir);
    return files.filter(file => 
      /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(file) &&
      !file.startsWith('.'))
    .sort();
  &rbrace; catch (e) &lbrace; return []; &rbrace;
&rbrace;

const allImages = getAllImages();

function formatFilename(filename) &lbrace;
  let formatted = decodeURIComponent(filename);
  formatted = formatted.replace(/\.(jpg|jpeg|png|gif|webp|svg)$/i, '');
  formatted = formatted.replace(/[-_]/g, ' ');
  formatted = formatted.replace(/\b\w/g, l => l.toUpperCase());
  return formatted;
&rbrace;

const handsUp = allImages.filter(img => 
  img.includes('hands up') || img.includes('hands-up'));
const withPetek = allImages.filter(img => 
  img.includes('petek') || img.includes('Petek'));
const wheelchair = allImages.filter(img => img.includes('wheelchair'));
const grave = allImages.filter(img => 
  img.includes('grave') || img.includes('tomb'));
const portraits = allImages.filter(img =>
  (img.includes('portrait') || img.includes('face') || img.includes('closeup') ||
   img.includes('smile') || img.includes('passport') || img.includes('black-hat-face') ||
   img.includes('white-staring') || img.includes('looking-up') || img.includes('fuzzy')) &&
  !img.includes('hands') && !img.includes('wheelchair'));
const withFriends = allImages.filter(img =>
  img.includes('friends') || img.includes('group') || img.includes('wife') ||
  img.includes('daughter') || img.includes('child') || img.includes('baby') ||
  img.includes('aziz') || img.includes('Moshe'));
const withrebbe = allImages.filter(img =>
  img.includes('rabbainu') || img.includes('rebbe') || img.includes('hasidim'));
const clothing = allImages.filter(img =>
  img.includes('hat') || img.includes('kippa') || img.includes('streimel') ||
  img.includes('bathrobe') || img.includes('sweater') || img.includes('jacket') ||
  img.includes('scarf') || img.includes('watch') || img.includes('keychain') ||
  img.includes('pillow') || img.includes('flannel') || img.includes('zebra') ||
  img.includes('blue-white') || img.includes('black') || img.includes('white'));
const music = allImages.filter(img =>
  img.includes('guitar') || img.includes('karlibach'));
const kotel = allImages.filter(img => img.includes('kotel'));

const categorized = new Set([
  ...handsUp, ...withPetek, ...wheelchair, ...grave, ...portraits,
  ...withFriends, ...withrebbe, ...clothing, ...music, ...kotel
]);
const other = allImages.filter(img => !categorized.has(img));
-

<Layout title="Saba Gallery" description="Photos of Rabbi Yisroel Ber Odesser">
  <section class="page-header">
    <h1>Rabbi Yisroel Ber Odesser (Saba)</h1>
    <p>1904-1994 • Recipient of the Holy Petek</p>
    <p class="hebrew">רבי ישראל בר אודסר ז"ל</p>
    <p class="stats">&lbrace;allImages.length&rbrace; photos</p>
    <a href="/gallery" class="back-link">← Back to Gallery</a>
  </section>

  <section class="intro">
    <div class="container">
      <div class="quote-box">
        <p class="hebrew">נַ נַחְ נַחְמָ נַחְמָן מאוּמָן</p>
        <p class="english">"Na Nach Nachma Nachman Meuman"</p>
        <cite>— From the Holy Petek (1922)</cite>
      </div>
      <div class="quick-index">
        <h3>Quick Index</h3>
        <div class="index-links">
          &lbrace;handsUp.length > 0 && <a href="#handsup" class="index-link"><span class="icon">🙌</span><span class="name">Hands Up</span><span class="count">&lbrace;handsUp.length&rbrace;</span></a>&rbrace;
          &lbrace;withPetek.length > 0 && <a href="#withpetek" class="index-link"><span class="icon">✡️</span><span class="name">With Petek</span><span class="count">&lbrace;withPetek.length&rbrace;</span></a>&rbrace;
          &lbrace;wheelchair.length > 0 && <a href="#wheelchair" class="index-link"><span class="icon">🦽</span><span class="name">Wheelchair</span><span class="count">&lbrace;wheelchair.length&rbrace;</span></a>&rbrace;
          &lbrace;grave.length > 0 && <a href="#grave" class="index-link"><span class="icon">🪦</span><span class="name">Grave</span><span class="count">&lbrace;grave.length&rbrace;</span></a>&rbrace;
          &lbrace;portraits.length > 0 && <a href="#portraits" class="index-link"><span class="icon">📸</span><span class="name">Portraits</span><span class="count">&lbrace;portraits.length&rbrace;</span></a>&rbrace;
          &lbrace;withFriends.length > 0 && <a href="#withfriends" class="index-link"><span class="icon">👥</span><span class="name">With Friends</span><span class="count">&lbrace;withFriends.length&rbrace;</span></a>&rbrace;
          &lbrace;withrebbe.length > 0 && <a href="#withrebbe" class="index-link"><span class="icon">✡️</span><span class="name">With Rebbe</span><span class="count">&lbrace;withrebbe.length&rbrace;</span></a>&rbrace;
          &lbrace;clothing.length > 0 && <a href="#clothing" class="index-link"><span class="icon">👔</span><span class="name">Clothing</span><span class="count">&lbrace;clothing.length&rbrace;</span></a>&rbrace;
          &lbrace;music.length > 0 && <a href="#music" class="index-link"><span class="icon">🎵</span><span class="name">Music</span><span class="count">&lbrace;music.length&rbrace;</span></a>&rbrace;
          &lbrace;kotel.length > 0 && <a href="#kotel" class="index-link"><span class="icon">🧱</span><span class="name">Western Wall</span><span class="count">&lbrace;kotel.length&rbrace;</span></a>&rbrace;
          &lbrace;other.length > 0 && <a href="#other" class="index-link"><span class="icon">📷</span><span class="name">Other</span><span class="count">&lbrace;other.length&rbrace;</span></a>&rbrace;
        </div>
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="container">
      &lbrace;handsUp.length > 0 && (
        <div id="handsup" class="category-section">
          <h2><span class="icon">🙌</span> Hands Up <span class="hebrew">(ידיים למעלה)</span></h2>
          <div class="gallery-grid">
            &lbrace;handsUp.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;withPetek.length > 0 && (
        <div id="withpetek" class="category-section">
          <h2><span class="icon">✡️</span> With Petek <span class="hebrew">(עם הפתק)</span></h2>
          <div class="gallery-grid">
            &lbrace;withPetek.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;wheelchair.length > 0 && (
        <div id="wheelchair" class="category-section">
          <h2><span class="icon">🦽</span> Wheelchair <span class="hebrew">(כיסא גלגלים)</span></h2>
          <div class="gallery-grid">
            &lbrace;wheelchair.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;grave.length > 0 && (
        <div id="grave" class="category-section">
          <h2><span class="icon">🪦</span> Grave & Tomb <span class="hebrew">(קבר וציון)</span></h2>
          <div class="gallery-grid">
            &lbrace;grave.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/saba/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
