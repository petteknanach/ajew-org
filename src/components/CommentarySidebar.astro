---
/**
 * CommentarySidebar.astro
 *
 * Sefaria-style commentary sidebar for Likutey Moharan reader pages.
 * Props:
 *   - part: LM part number (1 or 2)
 *   - torah: LM torah number
 *   - entry: commentaries registry entry for this torah (may be null if none)
 *
 * Behaviour:
 *   - Desktop: fixed right-side panel (~40% width), user-toggleable, state persists in localStorage.
 *   - Mobile (<=900px): collapsible drawer with bottom-right FAB toggle.
 *   - Tabs per source; body fetches section JSON on demand.
 *   - Accessibility: aria-expanded on toggle, role="complementary" on panel, aria-modal on mobile drawer.
 *
 * Running commentary (Pettek Nanach) — original three-layer commentary (Beginner/Intermediate/Scholarly).
 */

export interface Props {
  part: number;
  torah: number;
  entry: any | null;
}

const { part, torah, entry } = Astro.props as Props;
const hasAny = !!(entry && (entry.related_commentaries?.length || entry.running_commentary));
const entryJson = hasAny ? JSON.stringify(entry) : 'null';
---

{hasAny && (
  <div
    class="commentary-sidebar"
    id="commentary-sidebar"
    role="complementary"
    aria-label={`Commentaries on Likutey Moharan ${part}:${torah}`}
    data-part={String(part)}
    data-torah={String(torah)}
  >
    <div class="commentary-sidebar-header">
      <h2 class="commentary-sidebar-title">
        Commentaries on Torah {torah}
      </h2>
      <button
        type="button"
        class="commentary-sidebar-close"
        id="commentary-sidebar-close"
        aria-label="Close commentary sidebar"
      >&times;</button>
    </div>

    <div
      class="commentary-sidebar-tabs"
      role="tablist"
      aria-label="Commentary sources"
      id="commentary-sidebar-tabs"
    ></div>

    <div
      class="commentary-sidebar-body"
      id="commentary-sidebar-body"
      tabindex="0"
    >
      <div class="commentary-sidebar-loading" aria-live="polite">
        Loading commentary&hellip;
      </div>
    </div>
  </div>

  <button
    type="button"
    class="commentary-sidebar-toggle"
    id="commentary-sidebar-toggle"
    aria-controls="commentary-sidebar"
    aria-expanded="false"
    title="Open commentary sidebar"
  >
    <span class="commentary-sidebar-toggle-icon" aria-hidden="true">&#9776;</span>
    <span class="commentary-sidebar-toggle-text">Commentary</span>
  </button>

  <button
    type="button"
    class="commentary-sidebar-handle"
    id="commentary-sidebar-handle"
    aria-controls="commentary-sidebar"
    aria-label="Open commentary sidebar"
    title="Open commentary sidebar"
  >
    <span class="commentary-sidebar-handle-text">COMMENTARY</span>
    <span class="commentary-sidebar-handle-arrow" aria-hidden="true">&#9664;</span>
  </button>

  <script type="application/json" id="commentary-sidebar-data" set:html={entryJson}></script>

  <script is:inline>
    (function () {
      var dataEl = document.getElementById('commentary-sidebar-data');
      if (!dataEl) return;

      var entry;
      try { entry = JSON.parse(dataEl.textContent || 'null'); } catch (_e) { entry = null; }
      if (!entry) return;

      var sidebar = document.getElementById('commentary-sidebar');
      var toggle = document.getElementById('commentary-sidebar-toggle');
      var closeBtn = document.getElementById('commentary-sidebar-close');
      var tabs = document.getElementById('commentary-sidebar-tabs');
      var body = document.getElementById('commentary-sidebar-body');
      if (!sidebar || !toggle || !tabs || !body || !closeBtn) return;

      var STORAGE_KEY = 'commentarySidebarOpen';
      var ACTIVE_TAB_KEY = 'commentarySidebarActiveTab';
      var READER_PREFS_KEY = 'ajew-reader-prefs';
      var cache = {}; // url -> fetched JSON
      var mql = window.matchMedia('(max-width: 900px)');

      // Read the main reader's language mode: 'hebrew' | 'english' | 'both'
      // Priority:
      //   1. DOM: active mode button in the reader header (most reliable — reflects current UI state)
      //   2. localStorage ajew-reader-prefs.mode
      //   3. Default: 'hebrew' (matches reader.js default so first-visit matches what user sees)
      function getReaderMode() {
        // 1. DOM — reader uses data-mode="hebrew|english|both" on active mode button
        try {
          var activeBtn = document.querySelector('.reader-mode-btn.active, [data-mode].active, button[data-mode][aria-pressed="true"]');
          if (activeBtn) {
            var m = activeBtn.getAttribute('data-mode');
            if (m === 'hebrew' || m === 'english' || m === 'both') return m;
          }
        } catch(_e) {}
        // 2. localStorage
        try {
          var raw = localStorage.getItem(READER_PREFS_KEY);
          if (raw) {
            var p = JSON.parse(raw);
            var m2 = p && p.mode;
            if (m2 === 'hebrew' || m2 === 'english' || m2 === 'both') return m2;
          }
        } catch (_e) {}
        // 3. Default matches reader.js state.mode = 'hebrew'
        return 'hebrew';
      }

      // Re-render current tab when the reader's language mode changes.
      // Also clear the "explicit layer" preference so the sidebar's default layer
      // follows the new reader language (hebrew→scholarly, english→beginner, both→intermediate).
      function onReaderModeChanged() {
        try { localStorage.removeItem('commentary-sidebar-layer-explicit'); } catch(_e) {}
        var activeTabEl = document.querySelector('.commentary-sidebar-tab.is-active');
        if (activeTabEl) activateTab(activeTabEl.getAttribute('data-tab-id'));
      }
      window.addEventListener('storage', function(ev) {
        if (ev && ev.key === READER_PREFS_KEY) onReaderModeChanged();
      });
      // Same-tab polling — storage event doesn't fire in the same document.
      var lastMode = getReaderMode();
      setInterval(function() {
        var m = getReaderMode();
        if (m !== lastMode) { lastMode = m; onReaderModeChanged(); }
      }, 800);

      function isMobile() { return mql.matches; }

      function setOpen(open, persist) {
        sidebar.classList.toggle('is-open', open);
        document.body.classList.toggle('has-commentary-sidebar-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (isMobile()) {
          sidebar.setAttribute('aria-modal', open ? 'true' : 'false');
          sidebar.setAttribute('role', open ? 'dialog' : 'complementary');
        } else {
          sidebar.removeAttribute('aria-modal');
          sidebar.setAttribute('role', 'complementary');
        }
        if (persist !== false) {
          try { localStorage.setItem(STORAGE_KEY, open ? '1' : '0'); } catch (_e) {}
        }
      }

      function getStoredOpen() {
        try {
          var v = localStorage.getItem(STORAGE_KEY);
          // Default: open on desktop, closed on mobile
          if (v === null) return !isMobile();
          return v === '1';
        } catch (_e) { return !isMobile(); }
      }

      // --- Build tab list ---
      var tabDefs = [];
      if (entry.running_commentary) {
        var rcLabel = entry.running_commentary.label || 'Running Commentary';
        var rcIsAvailable = (entry.running_commentary.status === 'available') && entry.running_commentary.url;
        // Make it obvious this is the site's own commentary, not an old source text.
        var displayLabel = rcIsAvailable ? ('\u2728 ' + rcLabel) : rcLabel;
        tabDefs.push({
          id: 'running',
          label: displayLabel,
          kind: 'running',
          book: entry.running_commentary.book,
          slug: entry.running_commentary.slug,
          status: entry.running_commentary.status || 'pending',
          url: entry.running_commentary.url || null,
          layers: entry.running_commentary.layers || null,
          author: entry.running_commentary.author || null
        });
      }
      var seen = {};
      (entry.related_commentaries || []).forEach(function (c, idx) {
        var id = 'c-' + idx + '-' + (c.book || 'x');
        tabDefs.push({
          id: id,
          label: c.label + (c.sectionTitle ? ' \u2014 ' + c.sectionTitle : ''),
          shortLabel: c.label,
          kind: 'related',
          book: c.book,
          section: c.section,
          sectionNumber: c.sectionNumber,
          url: c.url,
          sectionTitle: c.sectionTitle || ''
        });
      });

      if (tabDefs.length === 0) return;

      // Collapse duplicate short labels (e.g. multiple Biur HaLikutim sections on same torah)
      var shortCounts = {};
      tabDefs.forEach(function (t) {
        if (t.kind !== 'related') return;
        shortCounts[t.shortLabel] = (shortCounts[t.shortLabel] || 0) + 1;
      });
      var shortIdx = {};
      tabDefs.forEach(function (t) {
        if (t.kind !== 'related') { t.displayLabel = t.label; return; }
        if (shortCounts[t.shortLabel] > 1) {
          shortIdx[t.shortLabel] = (shortIdx[t.shortLabel] || 0) + 1;
          t.displayLabel = t.shortLabel + ' (' + shortIdx[t.shortLabel] + ')';
        } else {
          t.displayLabel = t.shortLabel;
        }
      });

      tabDefs.forEach(function (t) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'commentary-sidebar-tab';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', 'false');
        btn.setAttribute('data-tab-id', t.id);
        btn.title = t.label;
        btn.textContent = t.displayLabel;
        btn.addEventListener('click', function () { activateTab(t.id); });
        tabs.appendChild(btn);
      });

      function renderLoading() {
        body.innerHTML = '<div class="commentary-sidebar-loading" aria-live="polite">Loading commentary\u2026</div>';
      }

      function renderError(message) {
        var div = document.createElement('div');
        div.className = 'commentary-sidebar-error';
        div.setAttribute('role', 'alert');
        div.textContent = message;
        body.innerHTML = '';
        body.appendChild(div);
      }

      function escapeHtml(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Preferred layer persists across pages
      function getPreferredLayer() {
        try {
          return localStorage.getItem('commentary-sidebar-layer') || 'beginner';
        } catch (e) { return 'beginner'; }
      }
      function setPreferredLayer(layer) {
        try { localStorage.setItem('commentary-sidebar-layer', layer); } catch (e) {}
      }

      function renderRunningPlaceholder(def) {
        body.innerHTML = '';
        var wrap = document.createElement('div');
        wrap.className = 'commentary-sidebar-placeholder';
        var h = document.createElement('h3');
        h.textContent = (def && def.label) || 'Pettek Nanach Commentary';
        var p = document.createElement('p');
        p.textContent = 'An original three-layer running commentary on Likutey Moharan \u2014 Beginner / Intermediate / Scholarly \u2014 by Pettek Nanach. Published freely on AJEW.org.';
        var small = document.createElement('p');
        small.className = 'commentary-sidebar-placeholder-note';
        small.textContent = 'Coming soon for this Torah.';
        wrap.appendChild(h);
        wrap.appendChild(p);
        wrap.appendChild(small);
        body.appendChild(wrap);
      }

      var LAYER_LABELS = {
        beginner:     { en: 'Beginner',     icon: '\uD83C\uDF31' },
        intermediate: { en: 'Intermediate', icon: '\uD83C\uDF3F' },
        scholarly:    { en: 'Scholarly',    icon: '\uD83C\uDF33' }
      };

      function renderRunningData(def, data) {
        body.innerHTML = '';
        var head = document.createElement('div');
        head.className = 'commentary-sidebar-section-head';
        var title = document.createElement('h3');
        title.textContent = (data && data.title) || (def && def.label) || 'Pettek Nanach Commentary';
        var sub = document.createElement('div');
        sub.className = 'commentary-sidebar-section-sub';
        sub.textContent = (data && data.author) || 'Pettek Nanach';
        head.appendChild(title);
        head.appendChild(sub);
        body.appendChild(head);

        // Determine available layers — use definition from registry or fall back to detecting from data
        var allLayers = (def && def.layers) || ['beginner','intermediate','scholarly'];

        // Language-mode scopes the VISIBLE layers:
        //   hebrew → only [scholarly]  (Hebrew-native)
        //   english → only [beginner]  (English-native)
        //   both → all three layers
        function layersForMode(m) {
          if (m === 'hebrew')  return allLayers.filter(function(l){ return l === 'scholarly'; });
          if (m === 'english') return allLayers.filter(function(l){ return l === 'beginner'; });
          return allLayers.slice();
        }
        var layers = layersForMode(getReaderMode());
        if (layers.length === 0) layers = allLayers.slice(); // fallback

        function defaultLayerForMode(m) {
          if (m === 'hebrew') return 'scholarly';
          if (m === 'english') return 'beginner';
          return 'intermediate';
        }
        var savedLayer = null;
        try { savedLayer = localStorage.getItem('commentary-sidebar-layer-explicit'); } catch(_e) {}
        var current = savedLayer && layers.indexOf(savedLayer) !== -1
          ? savedLayer
          : defaultLayerForMode(getReaderMode());
        if (layers.indexOf(current) === -1) current = layers[0];

        // Layer sub-tabs — only show visible layers for this language mode
        var layerBar = document.createElement('div');
        layerBar.className = 'commentary-sidebar-layers';
        layerBar.setAttribute('role','tablist');
        layerBar.setAttribute('aria-label','Commentary depth');
        // Hide the row entirely if only one layer is shown (Hebrew or English mode)
        if (layers.length <= 1) layerBar.style.display = 'none';
        layers.forEach(function (layer) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'commentary-sidebar-layer-btn';
          btn.setAttribute('role','tab');
          var meta = LAYER_LABELS[layer] || { en: layer, icon: '' };
          btn.textContent = meta.icon + ' ' + meta.en;
          btn.setAttribute('data-layer', layer);
          if (layer === current) {
            btn.classList.add('active');
            btn.setAttribute('aria-selected','true');
          } else {
            btn.setAttribute('aria-selected','false');
          }
          btn.addEventListener('click', function () {
            current = layer;
            setPreferredLayer(layer);
            try { localStorage.setItem('commentary-sidebar-layer-explicit', layer); } catch(_e) {}
            Array.prototype.forEach.call(layerBar.children, function (b) {
              b.classList.toggle('active', b.getAttribute('data-layer') === layer);
              b.setAttribute('aria-selected', b.getAttribute('data-layer') === layer ? 'true' : 'false');
            });
            renderLayerSegments();
          });
          layerBar.appendChild(btn);
        });
        body.appendChild(layerBar);

        var segsWrap = document.createElement('div');
        segsWrap.className = 'commentary-sidebar-segments';
        body.appendChild(segsWrap);

        function renderLayerSegments() {
          segsWrap.innerHTML = '';
          var segs = Array.isArray(data && data.segments) ? data.segments : [];
          if (segs.length === 0) {
            var empty = document.createElement('p');
            empty.className = 'commentary-sidebar-empty';
            empty.textContent = 'No segments available.';
            segsWrap.appendChild(empty);
            return;
          }
          segs.forEach(function (seg) {
            var pair = document.createElement('div');
            pair.className = 'commentary-sidebar-segment';
            var idxSpan = document.createElement('span');
            idxSpan.className = 'commentary-sidebar-seg-num';
            idxSpan.textContent = String(seg.index || '');
            pair.appendChild(idxSpan);

            // Support both new 3-layer format and legacy single-field format
            var layer = seg.layers && seg.layers[current] ? seg.layers[current] : null;
            var heText = layer ? (layer.he_nikud || layer.he || '') : (seg.he_nikud || seg.he || '');
            var enText = layer ? (layer.en || '') : (seg.en || '');

            // Respect the main reader's language mode
            var mode = getReaderMode();
            var showHe = (mode !== 'english');
            var showEn = (mode !== 'hebrew');

            // English first (for beginner/intermediate which are EN-primary), then Hebrew
            if (enText && showEn) {
              var paragraphsEn = String(enText).split(/\n{2,}/);
              paragraphsEn.forEach(function (para) {
                var trimmed = para.replace(/\s+$/g, '').replace(/^\s+/g, '');
                if (!trimmed) return;
                var pEn = document.createElement('p');
                pEn.className = 'commentary-sidebar-en';
                pEn.lang = 'en';
                pEn.textContent = trimmed;
                pair.appendChild(pEn);
              });
            }
            if (heText && showHe) {
              var paragraphs = String(heText).split(/\n{2,}/);
              paragraphs.forEach(function (para) {
                var trimmed = para.replace(/\s+$/g, '').replace(/^\s+/g, '');
                if (!trimmed) return;
                var pHe = document.createElement('p');
                pHe.className = 'commentary-sidebar-he';
                pHe.lang = 'he';
                pHe.dir = 'rtl';
                pHe.textContent = trimmed;
                pair.appendChild(pHe);
              });
            }
            // If the current layer has no content in the user's chosen language mode,
            // fall back gracefully: show the other language with a small hint.
            var nothingShown = (pair.children.length === 1); // only the idxSpan
            if (nothingShown) {
              if (heText && !showHe && enText) {
                // Mode is hebrew but layer has no Hebrew — fall back to English
                var pE2 = document.createElement('p');
                pE2.className = 'commentary-sidebar-en';
                pE2.lang = 'en';
                pE2.textContent = enText;
                pair.appendChild(pE2);
              } else if (enText && !showEn && heText) {
                var pH2 = document.createElement('p');
                pH2.className = 'commentary-sidebar-he';
                pH2.lang = 'he';
                pH2.dir = 'rtl';
                pH2.textContent = heText;
                pair.appendChild(pH2);
              } else if (heText && !showHe && !enText) {
                var pEmpty1 = document.createElement('p');
                pEmpty1.className = 'commentary-sidebar-empty-layer';
                pEmpty1.textContent = '— This layer is Hebrew-only. Switch reader to Hebrew or Both to view. —';
                pair.appendChild(pEmpty1);
              } else if (enText && !showEn && !heText) {
                var pEmpty2 = document.createElement('p');
                pEmpty2.className = 'commentary-sidebar-empty-layer';
                pEmpty2.textContent = '— This layer is English-only. Switch reader to English or Both to view. —';
                pair.appendChild(pEmpty2);
              } else if (!enText && !heText) {
                var pEmpty3 = document.createElement('p');
                pEmpty3.className = 'commentary-sidebar-empty-layer';
                pEmpty3.textContent = '— This layer is empty for this segment —';
                pair.appendChild(pEmpty3);
              }
            }
            segsWrap.appendChild(pair);
          });
        }
        renderLayerSegments();
      }

      function renderRunning(def) {
        if (def.status !== 'available' || !def.url) {
          renderRunningPlaceholder(def);
          return;
        }
        if (cache[def.url]) {
          renderRunningData(def, cache[def.url]);
          return;
        }
        renderLoading();
        fetch(def.url, { credentials: 'same-origin' }).then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        }).then(function (json) {
          cache[def.url] = json;
          renderRunningData(def, json);
        }).catch(function (err) {
          renderError('Could not load running commentary: ' + (err && err.message ? err.message : 'unknown error'));
        });
      }

      function renderRelated(def, data) {
        body.innerHTML = '';
        var head = document.createElement('div');
        head.className = 'commentary-sidebar-section-head';
        var title = document.createElement('h3');
        title.lang = 'he';
        title.dir = 'rtl';
        title.textContent = def.sectionTitle || data.hebrewTitle || def.displayLabel;
        var sub = document.createElement('div');
        sub.className = 'commentary-sidebar-section-sub';
        sub.textContent = def.shortLabel + (def.sectionNumber ? ' \u00B7 \u00A7' + def.sectionNumber : '');
        var link = document.createElement('a');
        link.className = 'commentary-sidebar-open-full';
        link.href = def.url;
        link.textContent = 'Open full section \u2197';
        link.setAttribute('rel', 'noopener');
        head.appendChild(title);
        head.appendChild(sub);
        head.appendChild(link);
        body.appendChild(head);

        var segs = Array.isArray(data && data.segments) ? data.segments : [];
        if (segs.length === 0) {
          var empty = document.createElement('p');
          empty.className = 'commentary-sidebar-empty';
          empty.textContent = 'No segments available.';
          body.appendChild(empty);
          return;
        }
        var list = document.createElement('div');
        list.className = 'commentary-sidebar-segments';
        var relMode = getReaderMode();
        var relShowHe = (relMode !== 'english');
        var relShowEn = (relMode !== 'hebrew');
        segs.forEach(function (seg) {
          var pair = document.createElement('div');
          pair.className = 'commentary-sidebar-segment';
          var idxSpan = document.createElement('span');
          idxSpan.className = 'commentary-sidebar-seg-num';
          idxSpan.textContent = String(seg.index || '');
          pair.appendChild(idxSpan);

          if (seg.he && relShowHe) {
            var pHe = document.createElement('p');
            pHe.className = 'commentary-sidebar-he';
            pHe.lang = 'he';
            pHe.dir = 'rtl';
            pHe.textContent = seg.he;
            pair.appendChild(pHe);
          }
          if (seg.en && relShowEn) {
            var pEn = document.createElement('p');
            pEn.className = 'commentary-sidebar-en';
            pEn.textContent = seg.en;
            pair.appendChild(pEn);
          }
          // Fallbacks when the user's language mode hides everything
          var nothingShownRel = (pair.children.length === 1);
          if (nothingShownRel) {
            if (seg.he && !relShowHe && seg.en) {
              var pE2r = document.createElement('p');
              pE2r.className = 'commentary-sidebar-en';
              pE2r.textContent = seg.en;
              pair.appendChild(pE2r);
            } else if (seg.en && !relShowEn && seg.he) {
              var pH2r = document.createElement('p');
              pH2r.className = 'commentary-sidebar-he';
              pH2r.lang = 'he';
              pH2r.dir = 'rtl';
              pH2r.textContent = seg.he;
              pair.appendChild(pH2r);
            } else if (!seg.he && !seg.en) {
              var pEmpty = document.createElement('p');
              pEmpty.className = 'commentary-sidebar-en empty';
              pEmpty.textContent = 'Translation not yet available.';
              pair.appendChild(pEmpty);
            } else if (seg.he && !relShowHe && !seg.en) {
              var pEmptyH = document.createElement('p');
              pEmptyH.className = 'commentary-sidebar-empty-layer';
              pEmptyH.textContent = '— Hebrew-only source. Switch reader to Hebrew or Both to view. —';
              pair.appendChild(pEmptyH);
            } else if (seg.en && !relShowEn && !seg.he) {
              var pEmptyE = document.createElement('p');
              pEmptyE.className = 'commentary-sidebar-empty-layer';
              pEmptyE.textContent = '— English-only source. Switch reader to English or Both to view. —';
              pair.appendChild(pEmptyE);
            }
          }
          list.appendChild(pair);
        });
        body.appendChild(list);
      }

      function fetchSection(def) {
        if (!def.book || !def.section) {
          return Promise.reject(new Error('Missing commentary source info.'));
        }
        var url = '/reader/' + def.book + '/' + def.section + '.json';
        if (cache[url]) return Promise.resolve(cache[url]);
        return fetch(url, { credentials: 'same-origin' }).then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        }).then(function (json) {
          cache[url] = json;
          return json;
        });
      }

      function activateTab(tabId) {
        var def = null;
        for (var i = 0; i < tabDefs.length; i++) {
          if (tabDefs[i].id === tabId) { def = tabDefs[i]; break; }
        }
        if (!def) return;

        Array.prototype.forEach.call(
          tabs.querySelectorAll('.commentary-sidebar-tab'),
          function (btn) {
            var sel = btn.getAttribute('data-tab-id') === tabId;
            btn.setAttribute('aria-selected', sel ? 'true' : 'false');
            btn.classList.toggle('is-active', sel);
          }
        );

        try { localStorage.setItem(ACTIVE_TAB_KEY, tabId); } catch (_e) {}

        if (def.kind === 'running') {
          renderRunning(def);
          return;
        }
        renderLoading();
        fetchSection(def).then(function (json) {
          renderRelated(def, json);
        }).catch(function (err) {
          renderError('Could not load commentary: ' + (err && err.message ? err.message : 'unknown error'));
        });
      }

      // --- Event wiring ---
      toggle.addEventListener('click', function () {
        setOpen(!sidebar.classList.contains('is-open'));
      });
      closeBtn.addEventListener('click', function () { setOpen(false); });

      var handleBtn = document.getElementById('commentary-sidebar-handle');
      if (handleBtn) {
        handleBtn.addEventListener('click', function () { setOpen(true); });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && sidebar.classList.contains('is-open') && isMobile()) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Update role when breakpoint changes
      function handleMql() {
        if (sidebar.classList.contains('is-open')) setOpen(true, false);
      }
      if (mql.addEventListener) mql.addEventListener('change', handleMql);
      else if (mql.addListener) mql.addListener(handleMql);

      // Restore state
      var startOpen = getStoredOpen();
      setOpen(startOpen, false);

      var storedTab = null;
      try { storedTab = localStorage.getItem(ACTIVE_TAB_KEY); } catch (_e) {}

      // Detect when an available running commentary exists — always prefer it
      var hasAvailableRunning = false;
      for (var rc = 0; rc < tabDefs.length; rc++) {
        if (tabDefs[rc].kind === 'running' && tabDefs[rc].status === 'available' && tabDefs[rc].url) {
          hasAvailableRunning = true;
          break;
        }
      }

      var initialTab = null;
      // If we have an available running commentary, default to it regardless of storedTab.
      if (hasAvailableRunning) {
        for (var k = 0; k < tabDefs.length; k++) {
          if (tabDefs[k].kind === 'running' && tabDefs[k].status === 'available' && tabDefs[k].url) {
            initialTab = tabDefs[k].id;
            break;
          }
        }
      }
      // Otherwise, honor a valid stored preference
      if (!initialTab && storedTab) {
        for (var j = 0; j < tabDefs.length; j++) {
          if (tabDefs[j].id === storedTab) { initialTab = storedTab; break; }
        }
      }
      if (!initialTab) {
        for (var k2 = 0; k2 < tabDefs.length; k2++) {
          if (tabDefs[k2].kind === 'related') { initialTab = tabDefs[k2].id; break; }
        }
      }
      if (!initialTab && tabDefs.length) initialTab = tabDefs[0].id;
      if (initialTab) activateTab(initialTab);
    })();
