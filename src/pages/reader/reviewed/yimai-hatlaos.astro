---
import Layout from '../../../layouts/Layout.astro';
import {loadEdition,PIN,escape,historyHTML,displayEnglish} from '../../../lib/qualified-yimai-hatlaos.mjs';
const edition=await loadEdition();
const plain='/reader-plain/reviewed/yimai-hatlaos/';
---
<Layout noindex={false} title={edition.title} description={edition.notice}>
<section class="qualified-yimai-hatlaos" data-qualified-yimai-hatlaos data-projection-sha={PIN} data-print-safe="false" data-controls-ready="false" data-mode="both" data-witness="he">
<script is:inline>
(function(){
 const scope=document.querySelector('[data-qualified-yimai-hatlaos]');
 const authenticated=()=>typeof window.QualifiedYimaiHatlaosIntegrityReady==='function'&&window.QualifiedYimaiHatlaosIntegrityReady();
 const notify=()=>scope.querySelector('[data-integrity-status]').textContent='Exports blocked: the complete reading text and source notes could not be verified.';
 const admitPrint=()=>{scope.dataset.printSafe='false';try{const gate=Object.getOwnPropertyDescriptor(window,'QualifiedYimaiHatlaosPrintGate');if(!gate||gate.writable!==false||gate.configurable!==false||typeof gate.value!=='function'||gate.value()!==true){scope.dataset.printSafe='false';notify();}}catch(_){scope.dataset.printSafe='false';notify();}};
 window.addEventListener('beforeprint',admitPrint);
 matchMedia('print').addEventListener('change',e=>{if(e.matches)admitPrint();else scope.dataset.printSafe='false';});
 window.addEventListener('afterprint',()=>{scope.dataset.printSafe='false';});
 document.addEventListener('click',e=>{const b=e.target.closest('button');if(b&&b.matches('#btn-share,#btn-add-sefer,#btn-print,.seg-copy-btn,.seg-add-sefer-btn,.ajew-segment-action-btn,.selection-popup .sel-btn,#highlight-context-menu .hl-action[data-action="share"],#highlight-context-menu .hl-action[data-action="save"],.notes-panel-btn,[data-q-action]')&&!authenticated()){e.preventDefault();e.stopImmediatePropagation();notify();}},true);
 document.addEventListener('copy',e=>{const s=getSelection();if(authenticated()||!s||s.isCollapsed)return;let intersects=false;try{for(let i=0;i<s.rangeCount;i++)if(s.getRangeAt(i).intersectsNode(scope))intersects=true;intersects=intersects||scope.contains(s.anchorNode)||scope.contains(s.focusNode);}catch(_){intersects=true;}if(intersects){e.preventDefault();e.stopImmediatePropagation();notify();}},true);
})();
</script>
<p class="qualified-print-warning" role="alert">Print withheld: the complete reading text and readable source notes could not be verified. Return to the reading page and try again.</p>
<nav aria-label="Reader navigation"><a href="/reader/">Reader</a> › <a href="/reader/reviewed/">Reviewed editions</a></nav>
<h1>{edition.title}</h1><p>{edition.notice}</p>
<p>The complete book appears here in Hebrew and English, with the earlier English kept separately for comparison. Source notes remain visible in every language view. Copy, Save and Share include the complete selected passages, the supplied Hebrew, current English, source notes and labelled earlier English, regardless of the language displayed.</p>
<div data-global-notes aria-label="Source notes for all teachings">{edition.globalQualifications.map((q,i)=><p data-global-qualification={q.id} data-ordinal={String(i)} set:html={escape(q.text)} />)}</div>
<p data-integrity-status role="status" aria-live="polite">Checking the reading text and source notes; exports are not yet available.</p>
<div class="qualified-toolbar" aria-label="Reading and export controls">
<button type="button" data-q-mode="hebrew" aria-pressed="false">Hebrew</button><button type="button" data-q-mode="english" aria-pressed="false">English</button><button type="button" data-q-mode="both" aria-pressed="true">Bilingual</button>
<button type="button" data-q-action="copy">Copy the complete book with source notes</button><button type="button" data-q-action="save">Save to My Sefer</button><button type="button" data-q-action="share">Share the complete book with source notes</button><button type="button" id="btn-print">Print with source notes</button>
<label>Find in this book <input data-reader-query type="search" /></label><span data-search-status role="status"></span>
</div>
<section class="qualified-controls archive" aria-label="Reading preferences and listening">
<div class="qualified-control-row"><label>Text size <input data-q-size type="range" min="12" max="32" step="2" value="18" /></label><output data-q-size-value aria-live="polite">18px</output><label>Text font <select data-q-font aria-describedby="qualified-font-policy qualified-font-status"><option value="frank">Frank Ruhl</option><option value="taamey">Taamey Frank CLM — local-only; serif fallback if absent</option><option value="keter">Keter YG — local-only; serif fallback if absent</option><option value="david">David Libre</option><option value="noto">Noto Serif</option><option value="suez">Suez One</option><option value="drugulin">Drugulin CLM — local-only; serif fallback if absent</option><option value="stam">Shlomo Stam — local-only; serif fallback if absent</option><option value="heebo">Heebo</option><option value="assistant">Assistant</option><option value="rubik">Rubik</option></select></label><button type="button" data-q-favorite aria-pressed="false">Favorite this edition</button><button type="button" data-q-bookmark>Bookmark position</button><button type="button" data-q-continue>Return to bookmark</button></div>
<p id="qualified-font-policy">Taamey Frank CLM, Keter YG, Drugulin CLM and Shlomo Stam are local-only choices: no font files are downloaded for them. If the selected face is absent or a glyph is missing, the browser uses its serif fallback. Local availability is not verified; selecting a name does not prove that face is installed. Font preferences affect the screen only, not print.</p>
<p id="qualified-font-status" data-q-font-status role="status" aria-live="polite">Selected font requested; the browser may use fallback fonts for unavailable faces or glyphs.</p>
<div class="qualified-control-row"><label>Reading progress <progress data-q-progress max="100" value="0"></progress></label><span data-q-progress-label>0% through this edition</span></div>
<div class="qualified-control-row" role="group" aria-label="Listen to complete source text"><button type="button" data-q-voice="play">Listen with source notes</button><button type="button" data-q-voice="pause" disabled>Pause</button><button type="button" data-q-voice="resume" disabled>Resume</button><button type="button" data-q-voice="stop" disabled>Stop</button></div><p data-q-voice-status role="status" aria-live="polite">Listening uses this device’s available Hebrew and English voices; includes the supplied Hebrew, current English, all source notes and labelled earlier English history.</p>
<p data-q-control-status role="status" aria-live="polite"></p><p data-q-paint-status role="status" aria-live="polite"></p><details><summary>Keyboard shortcuts</summary><p>Outside text fields: / finds text; [ and ] move between teachings; + and − change text size; Alt+L listens; Alt+F favorites this edition; Alt+B bookmarks the position; Escape stops listening. Tab reaches every control.</p></details>
</section>
<div class="qualified-selection-actions selection-popup" aria-label="Selected text actions"><button type="button" class="sel-btn" data-action="copy" disabled>Copy selected paragraphs with source notes</button><button type="button" class="sel-btn" data-action="mysefer" disabled>Save selected paragraphs</button><button type="button" class="sel-btn" data-action="share" disabled>Share selected paragraphs</button><p data-qualified-selection-status role="status">Select visible source text. Exports include complete selected paragraphs, the supplied Hebrew and all source notes.</p></div>
<div class="archive qualified-annotation-tools"><button type="button" data-q-capture>Highlight, note, prayer or share selection</button><div data-capture-host></div><h2>My local annotations</h2><p>Annotations here are kept separately. Earlier saved highlights and notes are unchanged. Local annotations identify one exact source occurrence; sharing includes complete selected paragraphs and all source notes.</p><div data-local-annotations></div></div>
<nav aria-label="Book contents">{edition.groups.map(g=><a href={'#group-'+g.id}>{g.title}</a>)}</nav>
{edition.groups.map(g=><section class="qualified-group" data-group={g.id} id={'group-'+g.id}>
<h2 tabindex="-1">{g.title}</h2><p><a href={g.canonical_url}>Earlier text for this section</a></p>
{edition.units.filter(u=>u.group===g.id).map(u=><article class="qualified-unit" data-record-kind={u.record_kind} data-unit={u.owner} data-index={u.owner} data-source-index={String(u.source_index)} data-position={String(u.array_position)} id={u.anchor}>
<h3>{u.record_kind==='book-title'?'Book title':u.record_kind==='source-attribution-note'?'Source attribution':'Paragraph '+(u.array_position+1)}</h3>
<div class="qualified-pair"><div class="qualified-he" lang="he" dir="rtl"><p class="witness-label primary" lang="en" dir="ltr">Supplied Hebrew</p><p data-source-field="he" data-null="false" set:html={escape(u.he)} /></div><div class="qualified-en" lang="en" dir="ltr"><p class="witness-label">English</p><p data-source-field="en" data-null={String(u.en===null)} set:html={escape(displayEnglish(u))} /></div></div>
<div class="required-qualifications" aria-label="Source notes">{u.qualifications.map((q,i)=><p data-qualification={q.id} data-owner={u.owner} data-ordinal={String(i)} set:html={escape(q.text)} />)}</div>
<div class="qualified-unit-actions"><button type="button" data-q-action="copy">Copy paragraph with source notes</button><button type="button" data-q-action="save">Save paragraph</button><button type="button" data-q-action="share">Share paragraph with source notes</button></div>
<Fragment set:html={historyHTML(u)} />
</article>)}
</section>)}
<p>Earlier English is available under each paragraph as historical wording, not a second current translation. The source notes explain the textual uncertainties and the limits of the earlier wording.</p>
<section class="archive"><h2>Text downloads and earlier editions</h2><p>The downloads include the complete book with the supplied Hebrew and current English. Historical archives are comparison only, not replacement English or independent textual authority.</p><p><a href={plain}>HTML</a> · <a href={plain+'index.txt'}>TXT</a> · <a href={plain+'index.md'}>Markdown</a> · <a href={plain+'index.json'}>JSON</a></p>
<details><summary>Original source files and selected text</summary><p>Earlier files remain unchanged for historical comparison. They do not replace the current translation or resolve the source limitations described above.</p><ul>{edition.assets.map(a=><li><a href={a.url}>{a.name==='selected-116.json'?'Complete selected text and source notes':a.name==='index-original.json'?'Original book catalogue':('Original source — '+edition.groups.find(g=>a.name==='section-'+g.section+'-original.json')?.title)}</a></li>)}</ul></details></section>
</section>
<script is:inline type="module" src="/qualified-yimai-hatlaos-reader.js?v=b410077e597b97be8d7ccf1d1b3f470aa1b227cdd2384a326e3a07fb1330699a"></script>
<script is:inline type="module" src="/qualified-yimai-hatlaos-controls.js?v=3382ca81e7f42b46df6cb3668b8ef897fa7629ae483d889ff08ed04273fded43"></script>
<style is:global>
.qualified-yimai-hatlaos .qualified-controls { margin:1rem 0; padding:.75rem; border:1px solid #888; background:#fff; color:#111; font:1rem/1.5 system-ui; }
.qualified-yimai-hatlaos .qualified-control-row { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; margin:.5rem 0; }
.qualified-yimai-hatlaos .qualified-controls label { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; max-width:100%; }
.qualified-yimai-hatlaos .qualified-controls :is(select,input) { min-height:44px; max-width:100%; }
.qualified-yimai-hatlaos :is(button,input,select,a,summary,h2):focus-visible { outline:3px solid #294e6a; outline-offset:3px; }
.qualified-yimai-hatlaos ::highlight(qualified-highlight) { background:#fff09a; color:#000; }
.qualified-yimai-hatlaos ::highlight(qualified-note) { background:#cce5ff; color:#000; text-decoration:underline; }
.qualified-yimai-hatlaos ::highlight(qualified-prayer) { background:#ccefcf; color:#000; text-decoration:underline; }
@media screen { .qualified-yimai-hatlaos :is([data-source-field],[data-qualification],[data-global-qualification],[data-history-field]) { font-size:var(--qualified-size,18px); font-family:var(--qualified-family,'Frank Ruhl Libre',serif); } }
@media print { .qualified-yimai-hatlaos ::highlight(qualified-highlight),.qualified-yimai-hatlaos ::highlight(qualified-note),.qualified-yimai-hatlaos ::highlight(qualified-prayer) { background:transparent; color:#000; text-decoration:none; } }
.qualified-yimai-hatlaos { max-width:1100px; margin:auto; padding:1rem; background:#fff; color:#111; font:18px/1.65 system-ui; }
.qualified-yimai-hatlaos h1 { font-size:1.6rem; }.qualified-yimai-hatlaos nav,.qualified-yimai-hatlaos .qualified-toolbar { display:flex; flex-wrap:wrap; gap:.6rem; margin:1rem 0; }.qualified-yimai-hatlaos button { padding:.65rem; min-height:44px; cursor:pointer; }.qualified-yimai-hatlaos button[aria-pressed=true] { border:2px solid #294e6a; background:#eaf3fa; }.qualified-yimai-hatlaos .qualified-toolbar label { display:block; max-width:100%; }.qualified-yimai-hatlaos input { max-width:100%; }
.qualified-yimai-hatlaos .qualified-unit { margin:2rem 0; padding:1rem; border:1px solid #bbb; scroll-margin-top:5rem; }.qualified-yimai-hatlaos .qualified-pair { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; }.qualified-yimai-hatlaos [data-source-field],.qualified-yimai-hatlaos :is([data-qualification],[data-global-qualification]),.qualified-yimai-hatlaos [data-history-field],.qualified-yimai-hatlaos pre { white-space:pre-wrap; overflow-wrap:anywhere; }.qualified-yimai-hatlaos pre { max-width:100%; font:inherit; }.qualified-yimai-hatlaos .required-qualifications { border-top:1px solid #777; padding-top:1rem; }.qualified-yimai-hatlaos .witness-label { font-size:.85rem; }.qualified-yimai-hatlaos .qualified-print-warning { display:none; }
.qualified-yimai-hatlaos .qualified-selection-actions { position:static; background:#fff; border:1px solid #888; padding:.6rem; display:block; font-size:.85rem; }.qualified-yimai-hatlaos .qualified-selection-actions p { margin:.5rem 0; }
@media screen { .qualified-yimai-hatlaos[data-mode=hebrew] .qualified-en,.qualified-yimai-hatlaos[data-mode=english] .qualified-he { display:none; }.qualified-yimai-hatlaos[data-mode=hebrew] .qualified-pair,.qualified-yimai-hatlaos[data-mode=english] .qualified-pair { grid-template-columns:minmax(0,1fr); } }
@media screen and (max-width:700px) { .qualified-yimai-hatlaos .qualified-pair { grid-template-columns:minmax(0,1fr); }.qualified-yimai-hatlaos .qualified-unit { padding:.6rem; }.qualified-yimai-hatlaos { padding:.6rem; } }
@media print { body:has(.qualified-yimai-hatlaos) { display:block!important; min-height:0!important; } body:has(.qualified-yimai-hatlaos) #main-content { display:block!important; flex:none!important; min-height:0!important; padding-block:0!important; margin-block:0!important; } }
@media print { .qualified-yimai-hatlaos [data-source-field],.qualified-yimai-hatlaos :is([data-qualification],[data-global-qualification]),.qualified-yimai-hatlaos [data-history-field] { white-space:break-spaces!important; } body,.qualified-yimai-hatlaos { background:white!important; color:black!important; }.qualified-yimai-hatlaos nav,.qualified-yimai-hatlaos .qualified-toolbar,.qualified-yimai-hatlaos .qualified-selection-actions,.qualified-yimai-hatlaos .qualified-unit-actions,.qualified-yimai-hatlaos .archive,.qualified-yimai-hatlaos [data-integrity-status] { display:none!important; }.qualified-yimai-hatlaos .qualified-pair { display:block!important; }.qualified-yimai-hatlaos [data-source-field] { display:block!important; }.qualified-yimai-hatlaos :is([data-qualification],[data-global-qualification]) { display:block!important; color:rgb(0,0,0)!important; -webkit-text-fill-color:rgb(0,0,0)!important; font-size:16px!important; text-indent:0; letter-spacing:normal; word-spacing:0; }.qualified-yimai-hatlaos .qualified-history { display:block!important; }.qualified-yimai-hatlaos .qualified-history summary { display:none!important; }.qualified-yimai-hatlaos [data-history-field] { display:block!important; color:rgb(0,0,0)!important; -webkit-text-fill-color:rgb(0,0,0)!important; font-size:16px!important; text-indent:0; letter-spacing:normal; word-spacing:0; }.qualified-yimai-hatlaos .qualified-unit { break-inside:auto; }.qualified-yimai-hatlaos:not([data-print-safe=true]) > * { display:none!important; }.qualified-yimai-hatlaos:not([data-print-safe=true]) > .qualified-print-warning { display:block!important; } body > :not(main):not(script):not(style) { display:none!important; } }
</style>
</Layout>
