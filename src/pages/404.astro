---
import fs from 'node:fs';
// Recovery is deliberately limited to these source-qualified directories. A slug
// alone is not evidence for a teaching, a part, or a different book's ownership.
const catalog = JSON.parse(fs.readFileSync('public/reader/catalog.json', 'utf8'));
const qualifiedIds = ['likutay-moharan', 'likutay-tefilos', 'sipurey-maasiyos'];
const books = qualifiedIds.map(id => {
  const matches = catalog.books.filter(book => book.id === id);
  if (matches.length !== 1) throw new Error(`Missing/ambiguous recovery book: ${id}`);
  const book = matches[0];
  if (!book.title || !book.hebrewTitle || !book.parts?.length) throw new Error(`Incomplete recovery book: ${id}`);
  const parts = book.parts.map(part => {
    if (!Number.isSafeInteger(part.part) || part.part < 1 || !part.title || !part.hebrewTitle) throw new Error(`Invalid recovery part: ${id}`);
    return { ...part, href: `/reader/${id}/${part.part}/` };
  });
  return { id, title: book.title, hebrewTitle: book.hebrewTitle, parts };
});
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Page Not Found — הדף לא נמצא | ajew.org</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/not-found-recovery.css?v=20261112-1" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content · <span lang="he" dir="rtl">דילוג לתוכן</span></a>
    <header>
      <a href="/" class="brand">ajew.org</a>
      <nav aria-label="Site navigation · ניווט באתר">
        <a href="/">Home · <span lang="he" dir="rtl">ראשי</span></a>
        <a href="/reader/">Library · <span lang="he" dir="rtl">ספרייה</span></a>
        <a href="/search-enhanced/">Search · <span lang="he" dir="rtl">חיפוש</span></a>
      </nav>
    </header>
    <main id="main-content">
      <p class="code">404</p>
      <h1>Page Not Found <span lang="he" dir="rtl">הדף לא נמצא</span></h1>
      <p>This address does not lead to an available page. A number in a link is not necessarily a teaching number. Choose a book directory or search for words you remember.</p>
      <p lang="he" dir="rtl">הכתובת הזאת אינה מובילה לדף זמין. מספר בקישור אינו בהכרח מספר של תורה או קטע בספר. אפשר לעבור לתוכן העניינים של ספר או לחפש מילים זכורות.</p>

      <section id="recovery-context" hidden aria-labelledby="recovery-context-title">
        <h2 id="recovery-context-title">Browse this book · <span lang="he" dir="rtl">עיון בספר</span></h2>
        {books.map(book => (
          <div data-recovery-book={book.id} hidden>
            <p class="book-title"><strong>{book.title}</strong> · <span lang="he" dir="rtl">{book.hebrewTitle}</span></p>
            <ul>{book.parts.map(part => <li><a data-recovery-part={String(part.part)} href={part.href}>{part.title} · <span lang="he" dir="rtl">{part.hebrewTitle}</span></a></li>)}</ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="recovery-search-title">
        <h2 id="recovery-search-title">Search for words · <span lang="he" dir="rtl">חיפוש מילים</span></h2>
        <form action="/search-enhanced/" method="get" role="search">
          <label for="recovery-book">Search in · <span lang="he" dir="rtl">חיפוש בתוך</span></label>
          <select name="book" id="recovery-book">
            <option value="">All books · כל הספרים</option>
            {books.map(book => <option value={book.id}>{book.title} · {book.hebrewTitle}</option>)}
          </select>
          <label for="recovery-query">Words to find · <span lang="he" dir="rtl">מילים לחיפוש</span></label>
          <input type="search" name="q" id="recovery-query" dir="auto" required maxlength="500" autocomplete="off" aria-describedby="recovery-search-hint" />
          <p id="recovery-search-hint">Only the words you enter are searched; this address is not copied into the search.<br /><span lang="he" dir="rtl">החיפוש יכלול רק את המילים שתזינו, ולא את הכתובת הזאת.</span></p>
          <button type="submit">Search · <span lang="he" dir="rtl">חיפוש</span></button>
        </form>
        <noscript><p>Book links below work without JavaScript. The form opens the search page; searching its text requires JavaScript.<br /><span lang="he" dir="rtl">הקישורים לספרים פועלים גם ללא JavaScript. הטופס פותח את דף החיפוש; החיפוש עצמו דורש JavaScript.</span></p></noscript>
      </section>

      <details id="recovery-directories">
        <summary>Book directories · <span lang="he" dir="rtl">תוכן עניינים של ספרים</span></summary>
        <ul>{books.map(book => <li><strong>{book.title}</strong> · <span lang="he" dir="rtl">{book.hebrewTitle}</span><ul>{book.parts.map(part => <li><a href={part.href}>{part.title} · <span lang="he" dir="rtl">{part.hebrewTitle}</span></a></li>)}</ul></li>)}</ul>
        <a href="/reader/">All books · <span lang="he" dir="rtl">כל הספרים</span></a>
        <a href="/reader-plain/">Plain-text library · <span lang="he" dir="rtl">ספרייה בטקסט פשוט</span></a>
      </details>

      <aside class="quotation" aria-label="Quotation · ציטוט">
        <p>"The whole world is a very narrow bridge — the main thing is not to fear at all."</p>
        <p lang="he" dir="rtl">כל העולם כולו גשר צר מאוד והעיקר לא לפחד כלל</p>
        <p>— Rebbe Nachman of Breslov</p>
      </aside>
    </main>
    <script is:inline src="/not-found-recovery.js?v=20261112-1" defer></script>
  </body>
</html>
