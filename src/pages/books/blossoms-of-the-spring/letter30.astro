---
<Layout title="{title} - {bookTitle}" description="Blossoms of the Spring - Letter 30 - The holy letters of Rabbi Yisroel Odesser">
  <div class="book-page">
    <header class="book-header">
      <h1>{bookTitle}</h1>
      <h2>Letter 30</h2>
    </header>
    <nav class="chapter-nav">
  <a href="/books/blossoms-of-the-spring/letter29" class="nav-btn prev">← Previous</a>
  <a href="/books/blossoms-of-the-spring" class="nav-btn main">Main</a>
  <a href="/books/blossoms-of-the-spring/letter31" class="nav-btn next">Next →</a>
