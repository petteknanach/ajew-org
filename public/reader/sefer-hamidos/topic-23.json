    {
      "index": 1,
      "he": "א.\r\n\r\nמִי שֶׁמִּתְבּוֹדֵד אֶת עַצְמוֹ וּבוֹדֵל אֶת עַצְמוֹ מִבְּנֵי-אָדָם, מִזְדַּקְּקִין עָלָיו מִלְמַעְלָה.",
      "en": ""
    },
    {
      "index": 2,
      "he": "ב.\r\n\r\nעַל-יְדֵי הִתְבּוֹדְדוּת וּמַפְנֶה לִבּוֹ לְבַטָּלָה בָּא לְכַעַס.",
      "en": ""
    },
    {
      "index": 3,
      "he": "חֵלֶק שֵׁנִי",
      "en": ""
    },
    {
      "index": 4,
      "he": "א.\r\n\r\nהַשִּׂיחָה שֶׁאָדָם מֵשִׂיחַ בֵּינוֹ לְבֵין קוֹנוֹ, הַשִּׂיחָה הַזֹּאת נַעֲשֵׂית אַחַר-כָּךְ גְּאֻלָּה וִישׁוּעָה לְבָנָיו.",
      "en": ""
