---
interface Props { data: any; collection?: string; }
const { data, collection = 'all' } = Astro.props;
const topics = data?.topics || [];
const documents = (data?.documents || []).filter((doc: any) => collection === 'all' || doc.collection === collection);
const collectionLabel = collection === 'sichos-chayay-saba' ? 'Sichos Chayay Saba' : collection === 'saba-tape-transcripts' ? 'Tape Transcripts' : 'All Saba Transcripts';
---

<section class="sti" data-topic-index data-default-collection={collection}>
  <header class="sti-head">
    <div>
      <p class="sti-kicker">Explore the words of Saba by subject</p>
      <h2>Transcript Topic Index</h2>
      <h3 lang="he" dir="rtl">מפתח נושאים לתמלולי הסבא</h3>
    </div>
    <div class="sti-stats">
      <strong>{documents.length}</strong>
      <span>{collectionLabel}</span>
      <small>Hebrew &amp; English passages</small>
    </div>
  </header>

  <div class="sti-controls">
    <label>
      <span>Topic / נושא</span>
      <select data-topic-select aria-label="Select transcript topic">
        <option value="all">All transcripts / כל התמלולים</option>
        {topics.map((topic: any) => (
          <option value={topic.id}>{topic.title} · {topic.hebrewTitle} ({topic.count})</option>
        ))}
      </select>
    </label>
    <label>
      <span>Collection / אוסף</span>
      <select data-collection-select aria-label="Select transcript collection">
        <option value="all" selected={collection === 'all'}>All Saba transcripts</option>
        <option value="sichos-chayay-saba" selected={collection === 'sichos-chayay-saba'}>Sichos Chayay Saba — שיחות חיי סבא</option>
        <option value="saba-tape-transcripts" selected={collection === 'saba-tape-transcripts'}>Tape transcripts — תמלולי קלטות</option>
      </select>
    </label>
    <label class="sti-search-label">
      <span>Filter titles / סינון</span>
      <input data-topic-filter type="search" placeholder="Petek, prayer, משיח…" autocomplete="off" />
    </label>
  </div>

  <div class="sti-summary" aria-live="polite" data-topic-summary></div>
  <div class="sti-results" data-topic-results></div>

  <noscript>
    <div class="sti-noscript">
      {topics.map((topic: any) => (
        <details>
          <summary>{topic.title} · <span lang="he" dir="rtl">{topic.hebrewTitle}</span></summary>
          <ul>{topic.entries.filter((entry: any) => collection === 'all' || entry.collection === collection).map((entry: any) => <li><a href={entry.url}>{entry.title}</a></li>)}</ul>
        </details>
      ))}
    </div>
  </noscript>

  <script type="application/json" data-topic-data set:html={JSON.stringify({ topics, documents })}></script>
</section>

<script>
  function initializeTopicIndex(root) {
    const raw = root.querySelector('[data-topic-data]');
    if (!raw) return;
    const data = JSON.parse(raw.textContent || '{}');
    const topicSelect = root.querySelector('[data-topic-select]');
    const collectionSelect = root.querySelector('[data-collection-select]');
    const filterInput = root.querySelector('[data-topic-filter]');
    const results = root.querySelector('[data-topic-results]');
    const summary = root.querySelector('[data-topic-summary]');
    const esc = (value) => String(value || '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

    function render() {
      const topicId = topicSelect.value;
      const collection = collectionSelect.value;
      const query = (filterInput.value || '').trim().toLocaleLowerCase();
      const selectedTopic = data.topics.find(topic => topic.id === topicId);
      let entries = selectedTopic ? selectedTopic.entries : data.documents;
      entries = entries.filter(entry => collection === 'all' || entry.collection === collection);
      if (query) entries = entries.filter(entry => `${entry.title || ''} ${entry.hebrewTitle || ''} ${entry.excerptEn || ''} ${entry.excerptHe || ''}`.toLocaleLowerCase().includes(query));

      const heading = selectedTopic ? `${selectedTopic.title} · ${selectedTopic.hebrewTitle}` : 'All transcripts · כל התמלולים';
      summary.innerHTML = `<strong>${esc(heading)}</strong><span>${entries.length} ${entries.length === 1 ? 'entry' : 'entries'}</span>`;
      if (!entries.length) {
        results.innerHTML = '<p class="sti-empty">No matching passages / לא נמצאו קטעים מתאימים</p>';
        return;
      }
      results.innerHTML = entries.map(entry => {
        const badge = entry.collection === 'sichos-chayay-saba' ? 'Sichos Chayay Saba' : 'Tape Transcript';
        const language = entry.hasHebrew === false ? 'English' : entry.hasEnglish === false ? 'עברית' : 'עברית · English';
        const excerptEn = entry.excerptEn ? `<p>${esc(entry.excerptEn)}</p>` : '';
        const excerptHe = entry.excerptHe ? `<p class="sti-he" lang="he" dir="rtl">${esc(entry.excerptHe)}</p>` : '';
        const details = selectedTopic ? `${entry.matches || 1} matching ${entry.matches === 1 ? 'passage' : 'passages'} · §${entry.segment || 1}` : `${entry.paragraphs || 0} passages · ${language}`;
        return `<a class="sti-card" href="${esc(entry.url)}">
          <span class="sti-badge">${esc(badge)}</span>
          <strong>${esc(entry.title || `Transcript ${entry.number}`)}</strong>
          ${entry.hebrewTitle ? `<em lang="he" dir="rtl">${esc(entry.hebrewTitle)}</em>` : ''}
          ${excerptEn}${excerptHe}
          <small>${esc(details)} <b>Open passage →</b></small>
        </a>`;
      }).join('');
    }

    topicSelect.addEventListener('change', render);
    collectionSelect.addEventListener('change', render);
    filterInput.addEventListener('input', render);
    render();
  }
  document.querySelectorAll('[data-topic-index]').forEach(initializeTopicIndex);
</script>

<style>
  .sti { max-width: 1180px; margin: 26px auto 80px; padding: 0 18px; color: #18324e; }
  .sti-head { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:26px 28px; border-radius:24px 24px 0 0; color:#fff; background:radial-gradient(circle at 85% 10%,rgba(243,202,119,.32),transparent 28%),linear-gradient(135deg,#102e52,#1e5684 58%,#806126); box-shadow:0 18px 46px rgba(16,46,82,.2); }
  .sti-kicker { margin:0 0 5px; color:#f4d998; text-transform:uppercase; letter-spacing:.12em; font-size:.7rem; font-weight:900; }
  .sti h2 { margin:0; font-family:'Cinzel',Georgia,serif; font-size:clamp(1.7rem,4vw,2.75rem); line-height:1.05; }
  .sti h3 { margin:6px 0 0; color:#f4d998; font-family:'Frank Ruhl Libre',serif; font-size:clamp(1.25rem,3vw,1.85rem); font-weight:600; }
  .sti-stats { min-width:150px; text-align:center; padding:14px 18px; border:1px solid rgba(255,255,255,.22); border-radius:18px; background:rgba(255,255,255,.09); backdrop-filter:blur(8px); }
  .sti-stats strong,.sti-stats span,.sti-stats small { display:block; }
  .sti-stats strong { color:#ffe1a1; font-size:2rem; line-height:1; }
  .sti-stats span { margin-top:5px; font-weight:800; }
  .sti-stats small { margin-top:3px; opacity:.76; }
  .sti-controls { display:grid; grid-template-columns:1.25fr 1fr 1fr; gap:12px; padding:18px; background:#f8eedb; border:1px solid #dcc797; border-top:0; }
  .sti-controls label { min-width:0; }
  .sti-controls span { display:block; margin:0 0 6px 3px; color:#6f572f; font-size:.76rem; font-weight:900; }
  .sti select,.sti input { width:100%; min-height:46px; padding:10px 12px; border:1px solid #cab17d; border-radius:12px; color:#173858; background:#fffdf8; font:inherit; }
  .sti select:focus,.sti input:focus { outline:3px solid rgba(37,100,151,.2); border-color:#256497; }
  .sti-summary { display:flex; justify-content:space-between; gap:12px; padding:14px 18px; border:1px solid #dfd1b3; border-top:0; background:#fffdf8; }
  .sti-summary strong { color:#163a61; }
  .sti-summary span { color:#806c49; font-weight:700; }
  .sti-results { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; padding:18px; border:1px solid #e0d1b3; border-top:0; border-radius:0 0 24px 24px; background:linear-gradient(180deg,#fffdfa,#f7efe1); }
  .sti-card { display:flex; flex-direction:column; gap:7px; min-width:0; padding:17px; border:1px solid #decba6; border-radius:17px; color:inherit; text-decoration:none; background:#fff; box-shadow:0 7px 20px rgba(20,52,93,.07); transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease; }
  .sti-card:hover { transform:translateY(-3px); border-color:#b47a22; box-shadow:0 16px 34px rgba(20,52,93,.14); }
  .sti-badge { align-self:flex-start; padding:4px 8px; border-radius:999px; color:#765311; background:#fff0c8; font-size:.67rem; font-weight:900; text-transform:uppercase; letter-spacing:.04em; }
  .sti-card strong { color:#153d68; font-size:1rem; line-height:1.3; }
  .sti-card em { color:#7b5720; font-family:'Frank Ruhl Libre',serif; font-style:normal; font-size:1.1rem; }
  .sti-card p { margin:2px 0; color:#536273; font-size:.84rem; line-height:1.45; }
  .sti-card .sti-he { color:#614b2b; font-family:'Frank Ruhl Libre',serif; font-size:.94rem; }
  .sti-card small { display:flex; justify-content:space-between; gap:8px; margin-top:auto; padding-top:7px; border-top:1px solid #eee5d5; color:#8c7958; }
  .sti-card small b { color:#1f5d91; white-space:nowrap; }
  .sti-empty { grid-column:1/-1; padding:30px; text-align:center; color:#806c49; }
  .sti-noscript details { margin:8px 0; }
  :global(body.dark-mode) .sti { color:#dce8f5; }
  :global(body.dark-mode) .sti-controls,:global(body.dark-mode) .sti-summary,:global(body.dark-mode) .sti-results { background:#191d2c; border-color:#3d3c36; }
  :global(body.dark-mode) .sti select,:global(body.dark-mode) .sti input,:global(body.dark-mode) .sti-card { color:#e3ebf5; background:#252a3b; border-color:#44495c; }
  :global(body.dark-mode) .sti-summary strong,:global(body.dark-mode) .sti-card strong { color:#a9ceff; }
  :global(body.dark-mode) .sti-card p { color:#b3bdca; }
  @media(max-width:760px){
    .sti { padding:0 10px; margin-top:18px; }
    .sti-head { align-items:flex-start; padding:22px 16px; border-radius:20px 20px 0 0; }
    .sti-stats { min-width:105px; padding:10px; }
    .sti-stats small { display:none; }
    .sti-controls { grid-template-columns:1fr; padding:13px; }
    .sti-results { grid-template-columns:1fr; padding:12px; }
  }
  @media(max-width:420px){ .sti-head { flex-direction:column; } .sti-stats { width:100%; } .sti-summary { flex-direction:column; } }
</style>
