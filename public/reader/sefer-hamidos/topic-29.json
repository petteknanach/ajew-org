    {
      "index": 1,
      "he": "חֵלֶק שֵׁנִי",
      "en": ""
    },
    {
      "index": 2,
      "he": "א.\r\n\r\nעַל-יְדֵי וִדּוּי דְּבָרִים גּוֹרְמִים שֶׁהַקָּדוֹשׁ- בָּרוּךְ-הוּא מַזְמִין מְלַמְּדֵי תִּינוֹקוֹת, שֶׁלּוֹמְדִין בֶּאֱמוּנָה.",
      "en": ""
    },
    {
      "index": 3,
      "he": "ב.\r\n\r\nגַּם גּוֹרְמִים, שֶׁנִּתְקָנִים הַדְּרָכִים מִמִּכְּשֶׁוֹלוֹת.",
      "en": ""
    },
    {
      "index": 4,
      "he": "ג.\r\n\r\nעַל-יְדֵי וִדּוּי דְּבָרִים זוֹכִים לְהִתְנַשְּׂאוּת.",
      "en": ""
    },
    {
      "index": 5,
      "he": "ד.\r\n\r\nמִי שֶׁאֵינוֹ מִתְוַדֶּה עַל עֲוֹנוֹתָיו, מוֹרָא בָּא עָלָיו.",
      "en": ""
    }
  ],
