---
import Layout from '../layouts/Layout.astro';
import EnhancedSearch from '../components/EnhancedSearch.astro';

// Load initial stats - using local API server on port 3001
const searchStats = await fetch('http://localhost:3001/api/search/health').then(r => r.json()).catch(() => null);
const totalDocuments = searchStats?.totalDocuments || 0;
const popularQueries = searchStats?.analytics?.popularQueries || {};
---

<Layout title="Enhanced Search v2" description="Advanced search across all Breslov works with filters, suggestions, and analytics">
  <div class="search-page">
    <header class="page-header">
      <h1>חיפוש מתקדם</h1>
      <p class="subtitle">Advanced Search Across All Works</p>
      <p class="stats">{totalDocuments} documents indexed • Real-time search • Advanced filters</p>
    </header>

    <div class="container">
      <!-- Search Component -->
      <EnhancedSearch showFilters={true} autoFocus={true} />

      <!-- Search Results Area -->
      <div class="results-area">
        <div id="loading" class="loading" style="display: none;">
          <div class="spinner"></div>
          <p>Searching...</p>
        </div>

        <div id="welcome" class="welcome-message">
          <h2>Welcome to Enhanced Search</h2>
          <p>Enter a search term to find relevant teachings, books, and stories.</p>
          
          <div class="features">
            <div class="feature">
              <span class="feature-icon">🔍</span>
              <h3>Advanced Search</h3>
              <p>Boolean operators, phrase matching, fuzzy search, wildcards</p>
            </div>
            <div class="feature">
              <span class="feature-icon">🎯</span>
              <h3>Smart Filters</h3>
              <p>Filter by category, author, language, content type</p>
            </div>
            <div class="feature">
              <span class="feature-icon">⚡</span>
              <h3>Fast Results</h3>
              <p>Real-time search with instant suggestions</p>
            </div>
          </div>

          {Object.keys(popularQueries).length > 0 && (
            <div class="popular-searches">
              <h3>Popular Searches</h3>
              <div class="popular-tags">
                {Object.entries(popularQueries).slice(0, 10).map(([query, count]) => (
                  <button 
                    type="button" 
                    class="popular-tag"
                    onclick={`window.enhancedSearch.setQuery('${query}'); window.enhancedSearch.search();`}
                  >
                    {query} <span class="tag-count">({count})</span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        <div id="results" class="results" style="display: none;">
          <!-- Results will be populated by JavaScript -->
        </div>

        <div id="noResults" class="no-results" style="display: none;">
          <!-- No results message -->
        </div>
      </div>

      <!-- Search Analytics -->
      <div class="analytics-panel">
        <div class="analytics-header">
          <h3>Search Analytics</h3>
          <button type="button" id="refreshAnalytics" class="refresh-btn">
            Refresh
          </button>
        </div>
        <div id="analyticsContent" class="analytics-content">
          <!-- Analytics will be populated by JavaScript -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Search state
  let currentSearch = {
    query: '',
    filters: {},
    results: [],
    total: 0,
    page: 1,
    pageSize: 20
  };

  // DOM elements
  let loadingElement, welcomeElement, resultsElement, noResultsElement;
  let analyticsContent, refreshAnalyticsBtn;

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    // Get DOM elements
    loadingElement = document.getElementById('loading');
    welcomeElement = document.getElementById('welcome');
    resultsElement = document.getElementById('results');
    noResultsElement = document.getElementById('noResults');
    analyticsContent = document.getElementById('analyticsContent');
    refreshAnalyticsBtn = document.getElementById('refreshAnalytics');

    // Load analytics
    loadAnalytics();

    // Event listeners
    document.addEventListener('enhanced-search', handleSearch);
    
    if (refreshAnalyticsBtn) {
      refreshAnalyticsBtn.addEventListener('click', loadAnalytics);
    }

    // Check for URL parameters
    checkUrlParameters();
  });

  // Handle search event
  async function handleSearch(event) {
    const { query, filters } = event.detail;
    
    if (!query.trim()) {
      showWelcome();
      return;
    }

    currentSearch.query = query;
    currentSearch.filters = filters;
    currentSearch.page = 1;

    await performSearch();
  }

  // Perform search
  async function performSearch() {
    showLoading();
    
    try {
      // Build query parameters
      const params = new URLSearchParams({
        q: currentSearch.query,
        page: currentSearch.page,
        pageSize: currentSearch.pageSize
      });

      // Add filters
      Object.entries(currentSearch.filters).forEach(([key, value]) => {
        if (Array.isArray(value) && value.length > 0) {
          params.set(key, value.join(','));
        } else if (value) {
          params.set(key, value);
        }
      });

      // Call search API - using local API server on port 3001
      const response = await fetch(`http://localhost:3001/api/search?${params}`);
      const data = await response.json();

      if (data.error) {
        throw new Error(data.error);
      }

      currentSearch.results = data.results;
      currentSearch.total = data.total;
      currentSearch.totalPages = data.totalPages;

      displayResults(data);
      
      // Track search in analytics
      trackSearch(data);
      
    } catch (error) {
      console.error('Search error:', error);
      showError('Failed to perform search. Please try again.');
    } finally {
      hideLoading();
    }
  }

  // Display results
  function displayResults(data) {
    if (data.total === 0) {
      showNoResults();
      return;
    }

    hideWelcome();
    showResults();

    // Group results by type
    const books = data.results.filter(r => r.type === 'book');
    const teachings = data.results.filter(r => r.type === 'teaching');
    const stories = data.results.filter(r => r.type === 'story');
    const prayers = data.results.filter(r => r.type === 'prayer');

    let html = `
      <div class="results-header">
        <h2>Search Results for "${data.query}"</h2>
        <p class="results-count">${data.total} results found • Page ${data.page} of ${data.totalPages}</p>
        
        <div class="active-filters">
          ${Object.entries(data.filters || {}).map(([key, value]) => {
            if (!value || (Array.isArray(value) && value.length === 0)) return '';
            const displayValue = Array.isArray(value) ? value.join(', ') : value;
            return `<span class="active-filter">${key}: ${displayValue}</span>`;
          }).join('')}
        </div>
      </div>
    `;

    // Books section
    if (books.length > 0) {
      html += `
        <div class="results-section">
          <h3>Books (${books.length})</h3>
          <div class="results-grid">
      `;
      
      books.forEach(result => {
        html += createResultCard(result);
      });
      
      html += `
          </div>
        </div>
      `;
    }

    // Teachings section
    if (teachings.length > 0) {
      html += `
        <div class="results-section">
          <h3>Teachings (${teachings.length})</h3>
          <div class="results-grid">
      `;
      
      teachings.forEach(result => {
        html += createResultCard(result);
      });
      
      html += `
          </div>
        </div>
      `;
    }

    // Stories section
    if (stories.length > 0) {
      html += `
        <div class="results-section">
          <h3>Stories (${stories.length})</h3>
          <div class="results-grid">
      `;
      
      stories.forEach(result => {
        html += createResultCard(result);
      });
      
      html += `
          </div>
        </div>
      `;
    }

    // Prayers section
    if (prayers.length > 0) {
      html += `
        <div class="results-section">
          <h3>Prayers (${prayers.length})</h3>
          <div class="results-grid">
      `;
      
      prayers.forEach(result => {
        html += createResultCard(result);
      });
      
      html += `
          </div>
        </div>
      `;
    }

    // Pagination
    if (data.totalPages > 1) {
      html += createPagination(data.page, data.totalPages);
    }

    resultsElement.innerHTML = html;
    
    // Add click tracking
    document.querySelectorAll('.result-card a').forEach(link => {
      link.addEventListener('click', () => {
        const documentId = link.dataset.documentId;
        trackClick(documentId, data.query);
      });
    });
  }

  // Create result card
  function createResultCard(result) {
    const scorePercent = Math.min(Math.round(result.score * 100), 100);
    
    return `
      <div class="result-card" data-id="${result.id}">
        <a href="${result.path}" class="result-link" data-document-id="${result.id}">
          <div class="result-header">
            <span class="result-type ${result.type}">
              ${getTypeIcon(result.type)} ${result.type}
            </span>
            <span class="result-score" title="Relevance score">
              ${scorePercent}% match
            </span>
          </div>
          
          <h4 class="result-title">${result.title}</h4>
          ${result.englishTitle ? `<p class="result-english-title">${result.englishTitle}</p>` : ''}
          
          <div class="result-meta">
            ${result.author ? `<span class="result-author">${result.author}</span>` : ''}
            ${result.category ? `<span class="result-category">${result.category}</span>` : ''}
            ${result.subcategory ? `<span class="result-subcategory">${result.subcategory}</span>` : ''}
            ${result.language ? `<span class="result-language">${result.language}</span>` : ''}
          </div>
          
          ${result.tags && result.tags.length > 0 ? `
            <div class="result-tags">
              ${result.tags.map(tag => `<span class="result-tag">${tag}</span>`).join('')}
            </div>
          ` : ''}
          
          <div class="result-stats">
            <span class="stat">${result.wordCount} words</span>
            <span class="stat">${result.charCount} chars</span>
            ${result.chapter ? `<span class="stat">Chapter ${result.chapter}</span>` : ''}
            ${result.section ? `<span class="stat">Section ${result.section}</span>` : ''}
          </div>
        </a>
      </div>
    `;
  }

  // Create pagination
  function createPagination(currentPage, totalPages) {
    let html = '<div class="pagination">';
    
    // Previous button
    if (currentPage > 1) {
      html += `<button type="button" class="page-btn prev" data-page="${currentPage - 1}">Previous</button>`;
    }
    
    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);
    
    for (let page = startPage; page <= endPage; page++) {
      html += `
        <button type="button" class="page-btn ${page === currentPage ? 'active' : ''}" data-page="${page}">
          ${page}
        </button>
      `;
    }
    
    // Next button
    if (currentPage < totalPages) {
      html += `<button type="button" class="page-btn next" data-page="${currentPage + 1}">Next</button>`;
    }
    
    html += '</div>';
    
    // Add event listeners after adding to DOM
    setTimeout(() => {
      document.querySelectorAll('.page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const page = parseInt(btn.dataset.page);
          if (page && page !== currentSearch.page) {
            currentSearch.page = page;
            performSearch();
          }
        });
      });
    }, 0);
    
    return html;
  }

  // Get type icon
  function getTypeIcon(type) {
    const icons = {
      book: '📚',
      teaching: '📖',
      story: '📖',
      prayer: '🙏'
    };
    return icons[type] || '📄';
  }

  // Track search
  function trackSearch(data) {
    // This would typically call an analytics API
    console.log('Search tracked:', {
      query: data.query,
      results: data.total,
      filters: data.filters
    });
  }

  // Track click
  function trackClick(documentId, query) {
    // Click tracking disabled for now
    console.log('Click tracked:', { documentId, query });
  }

  // Load analytics
  async function loadAnalytics() {
    if (!analyticsContent) return;
    
    try {
      const response = await fetch('http://localhost:3001/api/search/health');
      const data = await response.json();
      
      let html = `
        <div class="analytics-stats">
          <div class="stat-item">
            <span class="stat-value">${data.totalDocuments}</span>
            <span class="stat-label">Documents</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">${data.analytics.totalSearches}</span>
            <span class="stat-label">Total Searches</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">${data.analytics.searchesToday}</span>
            <span class="stat-label">Searches Today</span>
          </div>
        </div>
      `;
      
      // Categories
      if (data.categories) {
        html += `
          <div class="analytics-section">
            <h4>Categories</h4>
            <div class="categories-list">
        `;
        
        Object.entries(data.categories)
          .sort(([,a], [,b]) => b - a)
          .slice(0, 5)
          .forEach(([category, count]) => {
            html += `
              <div class="category-item">
                <span class="category-name">${category}</span>
                <span class="category-count">${count}</span>
              </div>
            `;
          });
        
        html += `
            </div>
          </div>
        `;
      }
      
      // Popular searches
      if (data.analytics.popularQueries) {
        html += `
          <div class="analytics-section">
            <h4>Popular Searches</h4>
            <div class="popular-searches-list">
        `;
        
        Object.entries(data.analytics.popularQueries)
          .sort(([,a], [,b]) => b - a)
          .slice(0, 5)
          .forEach(([query, count]) => {
            html += `
              <div class="search-item">
                <button type="button" class="search-link" onclick="window.enhancedSearch.setQuery('${query}'); window.enhancedSearch.search();">
                  ${query}
                </button>
                <span class="search-count">${count}</span>
              </div>
            `;
          });
        
        html += `
            </div>
          </div>
        `;
      }
      
      analyticsContent.innerHTML = html;
      
    } catch (error) {
      console.error('Failed to load analytics:', error);
      analyticsContent.innerHTML = '<p class="error">Failed to load analytics</p>';
    }
  }

  // UI state functions
  function showLoading() {
    loadingElement.style.display = 'block';
    welcomeElement.style.display = 'none';
    resultsElement.style.display = 'none';
    noResultsElement.style.display = 'none';
  }

  function hideLoading() {
    loadingElement.style.display = 'none';
  }

  function showWelcome() {
    welcomeElement.style.display = 'block';
    resultsElement.style.display = 'none';
    noResultsElement.style.display = 'none';
  }

  function hideWelcome() {
    welcomeElement.style.display = 'none';
  }

  function showResults() {
    resultsElement.style.display = 'block';
    noResultsElement.style.display = 'none';
  }

  function showNoResults() {
    noResultsElement.style.display = 'block';
    resultsElement.style.display = 'none';
    
    noResultsElement.innerHTML = `
      <div class="no-results-content">
        <h3>No results found for "${currentSearch.query}"</h3>
        <p>Try these suggestions:</p>
        <ul>
          <li>Check your spelling</li>
          <li>Try different keywords</li>
          <li>Use fewer filters</li>
          <li>Try a broader search term</li>
        </ul>
        <button type="button" class="back-btn" onclick="showWelcome()">
          Back to Search
        </button>
      </div>
    `;
  }

  function showError(message) {
    resultsElement.style.display = 'block';
    resultsElement.innerHTML = `
      <div class="error-message">
        <h3>Search Error</h3>
        <p>${message}</p>
