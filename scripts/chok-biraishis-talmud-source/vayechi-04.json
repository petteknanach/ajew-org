        }
      ],
      "sha256": "4ff736256c64270fadbee325911694d0098f1ec5c330c4d65cb704bf8728cab3",
      "body": "מאי דרוש - מתחילה כשדרש שגמרא גדול:"
    },
    {
      "ref": "Rashi on Bava Metzia 33b:2:2",
      "pointer": "/text/65/1/1",
      "included": [
        {
          "cp": [
