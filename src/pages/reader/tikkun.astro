---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Tikun Korim - Tanach with Medooyuk"
  description="A reader's tikkun for the whole Tanach: letters with nikud and taamim, four display modes, the medooyuk layer marking shva na, meteg ga'ya, and qamats needing beur on the nikud itself, and Shnayim Mikra v'Echad Targum in stacked, side-by-side, and tap layouts."
>
  <div class="tk-wrap" dir="rtl">
    <header class="tk-header">
      <h1>תיקון קורים <span class="tk-sub">Tikun Korim · medooyuk</span></h1>
      <p class="tk-tagline">
        כל התנ"ך בכתב סת"ם עם תגין — תצוגת ספר תורה (אותיות) ותצוגת התיקון (ניקוד וטעמים מלאים), שכבת המדויק על הניקוד עצמו (שוא נא, מטג), ושנים מקרא ואחד תרגום
      </p>
    </header>

    <div class="tk-controls" dir="ltr">
      <div class="tk-row">
        <label>Book <select id="tk-book"></select></label>
        <label>Parsha <select id="tk-parsha"><option value="">—</option></select></label>
        <label>Chapter <select id="tk-chapter"></select></label>
        <span class="tk-nav">
          <button id="tk-prev" class="tk-btn" title="Previous chapter">◀</button>
          <button id="tk-next" class="tk-btn" title="Next chapter">▶</button>
        </span>
      </div>
      <div class="tk-row">
        <label>Display
          <select id="tk-mode">
            <option value="full">Tikkun view — nikud + taamim</option>
            <option value="nikud">Nikud only</option>
            <option value="taamim">Taamim only</option>
            <option value="letters">Torah view — bare letters</option>
          </select>
        </label>
        <label class="tk-chk"><input type="checkbox" id="tk-medooyuk" checked /> Medooyuk layer</label>
        <label class="tk-chk"><input type="checkbox" id="tk-shnayim" /> Shnayim Mikra v'Echad Targum</label>
        <label>Targum <select id="tk-targum"><option value="">—</option></select></label>
        <label>Layout
          <select id="tk-layout">
            <option value="stacked">Stacked — scroll line above reading</option>
            <option value="side">Side by side — tikkun columns</option>
            <option value="tap">Tap 3× per verse</option>
          </select>
        </label>
        <label class="tk-size">Size <input type="range" id="tk-size" min="16" max="44" value="26" /></label>
        <span class="tk-themes">
          <button class="tk-btn tk-theme" data-t="day">Day</button>
          <button class="tk-btn tk-theme" data-t="sepia">Sepia</button>
          <button class="tk-btn tk-theme" data-t="night">Night</button>
        </span>
      </div>
      <div class="tk-legend" id="tk-legend" dir="rtl">
        <span class="m-demo">ש<span class="m-na">ְ</span> = שוא נא (נשמע)</span>
        <span class="m-demo">ק<span class="m-qk">ָ</span> = קומוץ קטן</span>
        <span class="m-demo">ק<span class="m-qb">ָ</span> = קמץ טעון בירור</span>
        <span class="m-demo">א<span class="m-meteg">ֽ</span> = מטג (געיה)</span>
        <span class="m-demo-note">הסימון על הניקוד עצמו — האותיות רגילות; שוא נח וקמץ גדול אינם מסומנים</span>
      </div>
    </div>

    <main id="tk-content" class="tk-content" dir="rtl" lang="he"></main>

    <footer class="tk-foot" dir="ltr">
      <p>Sheva/qamats rulings are v0 output — not an accuracy claim.</p>
    </footer>
  </div>
</Layout>

<script src="/tikkun.js?v=8" defer></script>

<style is:global>
  @font-face { font-family: 'Shlomo Stam'; src: url('/fonts/ShlomoStam.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  .tk-wrap { max-width: 1100px; margin: 0 auto; padding: 1rem; }
  .tk-header h1 { font-size: 1.7rem; margin: 0; }
  .tk-sub { font-size: 1rem; color: var(--muted, #888); font-weight: normal; }
  .tk-tagline { color: var(--muted, #888); margin: .2rem 0 .8rem; font-size: .95rem; }
  .tk-controls { border: 1px solid var(--border, #ddd); border-radius: 10px; padding: .6rem .8rem; margin-bottom: 1rem; background: var(--panel, #fafafa); }
  .tk-row { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; margin: .3rem 0; }
  .tk-row label { display: flex; gap: .35rem; align-items: center; font-size: .88rem; }
  .tk-row select { padding: .25rem .35rem; border-radius: 6px; border: 1px solid var(--border, #ccc); background: var(--panel2, #fff); color: inherit; max-width: 180px; }
  .tk-btn { padding: .25rem .6rem; border-radius: 6px; border: 1px solid var(--border, #ccc); background: var(--panel2, #fff); color: inherit; cursor: pointer; }
  .tk-btn:hover { filter: brightness(.96); }
  .tk-content { font-family: 'Shlomo Stam', 'Taamey Frank CLM', 'Frank Ruhl Libre', serif; font-size: var(--tk-size, 26px); line-height: 2.15; }
  .tk-verse { margin-bottom: 1.1rem; }
  /* Sefer-Torah presentation: petucha/setuma breaks, inverted nun, large/small letters */
  .tk-verse.tk-petucha { margin-bottom: 3.2rem; }
  .tk-brk { color: var(--muted, #999); font-size: .62em; opacity: .85; }
  .tk-brk-se { margin-inline-start: 1.6em; margin-inline-end: 1.6em; }
  .tk-brk-pe { margin-inline-start: .9em; }
  .tk-nun8 { display: inline-block; transform: rotate(180deg); color: var(--muted, #999); font-size: .8em; margin-inline-start: .9em; }
  .tk-l-lg { font-size: 1.7em; }
  .tk-l-sm { font-size: .62em; }
  .tk-l-sus { font-size: .62em; vertical-align: super; }
  .tk-verse .tk-vnum { color: var(--muted, #999); font-size: .55em; margin-left: .35rem; }
  /* shnayim mikra layouts */
  .tk-shnayim-note { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-size: .78rem; color: var(--muted, #888); margin-bottom: .8rem; border-bottom: 1px dashed var(--border, #ccc); padding-bottom: .45rem; }
  .tk-colhead-scroll::before { content: '▪ '; color: #6b6b6b; }
  .tk-colhead-read::before { content: '▫ '; color: #177f70; }
  .tk-line-scroll { font-family: 'Shlomo Stam', serif; letter-spacing: .02em; opacity: .92; }
  .tk-line-read { margin-top: .25rem; }
  .tk-side { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  .tk-col-scroll { border-left: 2px solid var(--border, #ddd); padding-left: 1rem; }
  @media (max-width: 720px) { .tk-side { grid-template-columns: 1fr; } .tk-col-scroll { border-left: none; padding-left: 0; border-bottom: 1px dashed var(--border, #ccc); padding-bottom: .4rem; } }
  .tk-tmissing { font-size: .72em; color: var(--muted, #999); }
  .tk-targum-line { font-family: 'Frank Ruhl Libre', 'Noto Serif Hebrew', serif; font-size: .72em; line-height: 1.9; color: var(--muted-2, #667); background: var(--panel, rgba(127,127,127,.07)); border-radius: 8px; padding: .15rem .6rem; margin: .15rem 0; }
  .tk-targum-line .tk-tname { font-size: .75em; opacity: .75; }
  .tk-mikra-repeat { opacity: .82; }
  /* medooyuk marks — on the nikud characters themselves; letters stay regular */
  .m-na { color: #0e9d8a; -webkit-text-stroke: .034em currentColor; text-shadow: .013em 0 0 currentColor, -.013em 0 0 currentColor, 0 .013em 0 currentColor, 0 -.013em 0 currentColor; }
  .m-qb { position: relative; text-decoration: none; }
  .m-qb::before { content: ''; position: absolute; top: -0.3em; inset-inline-start: -0.3em; width: 0.66em; height: 0.15em; background: rgba(200,60,60,.9); border-radius: 1px; }
  .m-qb::after { content: ''; position: absolute; top: -0.15em; inset-inline-start: -0.015em; width: 0.14em; height: 0.44em; background: rgba(200,60,60,.9); border-radius: 1px; }
  .m-qk { color: #c34a3a; font-weight: 900; text-shadow: 0 0 .6px currentColor; }
  .m-meteg { color: #8a6fd8; }
  .m-demo { margin-left: .9rem; font-size: 1.15rem; }
  .m-demo-note { color: var(--muted, #999); font-size: .78rem; }
  .tk-tap-done { opacity: .45; }
  .tk-foot { margin-top: 2rem; font-size: .78rem; color: var(--muted, #999); }
  .tk-loading { color: var(--muted, #999); }
  .tk-error { color: #b33; }
</style>
