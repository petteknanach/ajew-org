  &rbrace;

  .nav-links a:hover &lbrace;
    color: var(--color-accent);
  &rbrace;

  footer &lbrace;
    background: var(--color-primary);
    color: white;
    padding: 2rem;
    text-align: center;
  &rbrace;

  .footer-container &lbrace;
    max-width: 1200px;
    margin: 0 auto;
  &rbrace;

  footer p &lbrace;
    margin: 0.5rem 0;
  &rbrace;

  footer p:first-child &lbrace;
    font-family: var(--font-hebrew);
    font-size: 1.5rem;
  &rbrace;

  .copyright &lbrace;
    opacity: 0.7;
    font-size: 0.9rem;
    margin-top: 1rem;
  &rbrace;

  @media (max-width: 768px) &lbrace;
    .nav-links &lbrace;
      gap: 1rem;
      font-size: 0.9rem;
    &rbrace;
  &rbrace;
