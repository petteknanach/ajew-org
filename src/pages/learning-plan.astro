---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Daily Learning Schedule Builder | ajew.org" description="Create a personalized daily Torah learning plan. Choose your books, set your pace, and track your progress through Breslov and Torah texts.">
  <style>
    .plan-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-family: 'Open Sans', sans-serif;
    }
    .plan-header {
      text-align: center;
      margin-bottom: 40px;
    }
    .plan-header h1 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 2.2em;
      color: #1a365d;
      margin: 0 0 8px;
    }
    .plan-header p { color: #666; font-size: 0.95em; }

    .presets {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .preset-card {
      padding: 20px;
      border: 2px solid #e0d6c2;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s;
      background: #faf8f4;
    }
    .preset-card:hover { border-color: #1a365d; transform: translateY(-2px); }
    .preset-card.active { border-color: #1a365d; background: #eef2f7; }
    .preset-name { font-weight: 700; color: #1a365d; font-size: 1.1em; margin-bottom: 4px; }
    .preset-desc { font-size: 0.85em; color: #666; line-height: 1.5; }
    .preset-duration { font-size: 0.8em; color: #d97706; font-weight: 600; margin-top: 8px; }

    .builder {
      background: #f8f5ef;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 32px;
    }
    .builder h2 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.4em;
      color: #1a365d;
      margin: 0 0 16px;
    }
    .book-selector {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 8px;
      margin-bottom: 16px;
    }
    .book-option {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid #e0d6c2;
      border-radius: 8px;
      background: white;
      cursor: pointer;
      font-size: 0.85em;
      transition: all 0.15s;
    }
    .book-option:hover { border-color: #1a365d; }
    .book-option.selected { border-color: #1a365d; background: #eef2f7; }
    .book-option input { margin: 0; }
    .book-pages { color: #888; font-size: 0.8em; }

    .pace-selector {
      display: flex;
      gap: 12px;
      align-items: center;
      margin: 16px 0;
      flex-wrap: wrap;
    }
    .pace-selector label { font-weight: 600; color: #1a365d; }
    .pace-selector select {
      padding: 8px 16px;
      border: 2px solid #d1d5db;
      border-radius: 8px;
      font-size: 0.95em;
      background: white;
    }
    .generate-btn {
      padding: 12px 32px;
      background: #1a365d;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1em;
      font-weight: 600;
      cursor: pointer;
    }
    .generate-btn:hover { background: #2a5a9e; }

    .schedule { margin-top: 32px; }
    .schedule h2 { font-family: 'Frank Ruhl Libre', serif; font-size: 1.4em; color: #1a365d; margin: 0 0 8px; }
    .schedule-info { color: #666; font-size: 0.9em; margin-bottom: 16px; }
    .schedule-table { width: 100%; border-collapse: collapse; }
    .schedule-table th { background: #1a365d; color: white; padding: 10px 12px; text-align: left; font-size: 0.85em; }
    .schedule-table td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; font-size: 0.85em; }
    .schedule-table tr:nth-child(even) { background: #f9fafb; }
    .schedule-table a { color: #1a365d; text-decoration: none; font-weight: 500; }
    .schedule-table a:hover { text-decoration: underline; }
    .today-row { background: #fef3c7 !important; font-weight: 600; }
    .progress-bar { height: 8px; background: #e5e7eb; border-radius: 4px; overflow: hidden; margin-top: 8px; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #1a365d, #3b82f6); border-radius: 4px; transition: width 0.3s; }
    .save-btn { margin-top: 16px; padding: 10px 24px; background: #059669; color: white; border: none; border-radius: 8px; font-size: 0.9em; font-weight: 600; cursor: pointer; }
    .save-btn:hover { background: #047857; }
    .reset-btn { margin-top: 16px; margin-left: 8px; padding: 10px 24px; background: #dc2626; color: white; border: none; border-radius: 8px; font-size: 0.9em; font-weight: 600; cursor: pointer; }
  </style>

  <div class="plan-page">
    <div class="plan-header">
      <h1>Daily Learning Schedule</h1>
      <p>Choose a preset or build your own custom learning plan</p>
    </div>

    <div class="presets" id="presets">
      <div class="preset-card" onclick="selectPreset('lm-year')">
        <div class="preset-name">Likutay Moharan in 1 Year</div>
        <div class="preset-desc">Complete all 411 torahs of R' Nachman's magnum opus</div>
        <div class="preset-duration">365 days (~2/day)</div>
      </div>
      <div class="preset-card" onclick="selectPreset('daily-breslov')">
        <div class="preset-name">Daily Breslov Essentials</div>
        <div class="preset-desc">LM + Sichos HaRan + Meshivas Nefesh together</div>
        <div class="preset-duration">~450 days</div>
      </div>
      <div class="preset-card" onclick="selectPreset('tefilos-month')">
        <div class="preset-name">Likutay Tefilos in 30 Days</div>
        <div class="preset-desc">All 211 holy prayers of R' Nosson</div>
        <div class="preset-duration">30 days (~7/day)</div>
      </div>
      <div class="preset-card" onclick="selectPreset('lh-year')">
        <div class="preset-name">Likutay Halachos in 1 Year</div>
        <div class="preset-desc">All 593 halachos — the crown of Breslov Torah</div>
        <div class="preset-duration">365 days (~2/day)</div>
      </div>
      <div class="preset-card" onclick="selectPreset('tehillim-month')">
        <div class="preset-name">Tehillim in 1 Month</div>
        <div class="preset-desc">All 150 chapters — 5 per day</div>
        <div class="preset-duration">30 days</div>
      </div>
      <div class="preset-card" onclick="selectPreset('everything')">
        <div class="preset-name">The Complete Journey</div>
        <div class="preset-desc">Every Breslov sefer — LM, Kitzur, Sichos, Eitzos, Tefilos, Meshivas Nefesh, Ebay HaNachal</div>
        <div class="preset-duration">~2 years</div>
      </div>
    </div>

    <div class="builder">
      <h2>Custom Plan Builder</h2>
      <div class="book-selector" id="bookSelector"></div>
      <div class="pace-selector">
        <label>Pace:</label>
        <select id="paceSelect">
          <option value="1">1 per day (relaxed)</option>
          <option value="2" selected>2 per day (moderate)</option>
          <option value="3">3 per day (steady)</option>
          <option value="5">5 per day (intensive)</option>
          <option value="7">7 per day (marathon)</option>
        </select>
        <button class="generate-btn" onclick="generateSchedule()">Generate Schedule</button>
      </div>
    </div>

    <div class="schedule" id="scheduleOutput" style="display:none;">
      <h2>Your Learning Schedule</h2>
      <div class="schedule-info" id="scheduleInfo"></div>
      <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
      <div id="scheduleContent"></div>
      <button class="save-btn" onclick="savePlan()">Save Plan</button>
      <button class="reset-btn" onclick="resetPlan()">Reset Progress</button>
    </div>
  </div>

  <script is:inline>
    const BOOKS = [
      { id: 'likutay-moharan', name: 'Likutay Moharan', parts: [{p:1,n:285,base:'/reader/likutay-moharan/1/'},{p:2,n:125,base:'/reader/likutay-moharan/2/'}], total: 410 },
      { id: 'kitzur-likutay-moharan', name: 'Kitzur Likutay Moharan', parts: [{p:1,n:289,base:'/reader/kitzur-likutay-moharan/1/'},{p:2,n:96,base:'/reader/kitzur-likutay-moharan/2/'}], total: 385 },
      { id: 'sichos-haran', name: 'Sichos HaRan', parts: [{p:0,n:310,base:'/reader/sichos-haran/sicha-',flat:true}], total: 310 },
      { id: 'likutay-halachos', name: 'Likutay Halachos', parts: [1,2,3,4,5,6,7,8].map(p=>({p,n:[55,48,80,56,86,70,103,95][p-1],base:`/reader/likutay-halachos/${p}/`})), total: 593 },
      { id: 'likutay-tefilos', name: 'Likutay Tefilos', parts: [{p:2,n:152,base:'/reader/likutay-tefilos/2/'},{p:3,n:59,base:'/reader/likutay-tefilos/3/'}], total: 211 },
      { id: 'likutay-eitzos', name: 'Likutay Eitzos', parts: [{p:1,n:65,base:'/reader/likutay-eitzos/1/'}], total: 65 },
      { id: 'meshivas-nefesh', name: 'Meshivas Nefesh', parts: [{p:0,n:183,base:'/reader/meshivas-nefesh/section-',flat:true}], total: 183 },
      { id: 'sefer-hamidos', name: 'Sefer HaMidos', parts: [{p:0,n:108,base:'/reader/sefer-hamidos/topic-',flat:true}], total: 108 },
      { id: 'tanach-tehillim', name: 'Tehillim', parts: [{p:1,n:150,base:'/reader/tanach-tehillim/1/'}], total: 150 },
      { id: 'ebay-hanachal', name: 'Ebay HaNachal', parts: [{p:1,n:121,base:'/reader/ebay-hanachal/1/'},{p:2,n:144,base:'/reader/ebay-hanachal/2/'}], total: 265 },
      { id: 'shivchay-haran', name: 'Shivchay HaRan', parts: [{p:0,n:63,base:'/reader/shivchay-haran/section-',flat:true}], total: 63 },
      { id: 'hashtatfchus', name: 'Hashtatfchus HaNefesh', parts: [{p:1,n:130,base:'/reader/hashtatfchus-hanefesh/1/'}], total: 130 },
    ];

    const PRESETS = {
      'lm-year': { books: ['likutay-moharan'], pace: 2 },
      'daily-breslov': { books: ['likutay-moharan', 'sichos-haran', 'meshivas-nefesh'], pace: 2 },
      'tefilos-month': { books: ['likutay-tefilos'], pace: 7 },
      'lh-year': { books: ['likutay-halachos'], pace: 2 },
      'tehillim-month': { books: ['tanach-tehillim'], pace: 5 },
      'everything': { books: ['likutay-moharan','kitzur-likutay-moharan','sichos-haran','likutay-eitzos','likutay-tefilos','meshivas-nefesh','ebay-hanachal'], pace: 2 },
    };

    let selectedBooks = new Set();

    function initBookSelector() {
      document.getElementById('bookSelector').innerHTML = BOOKS.map(b => `
        <label class="book-option" data-id="${b.id}" onclick="toggleBook('${b.id}',this)">
          <input type="checkbox" value="${b.id}">
          <span>${b.name}</span>
          <span class="book-pages">(${b.total})</span>
        </label>
      `).join('');
    }

    function toggleBook(id, el) {
      if (selectedBooks.has(id)) { selectedBooks.delete(id); el.classList.remove('selected'); el.querySelector('input').checked = false; }
      else { selectedBooks.add(id); el.classList.add('selected'); el.querySelector('input').checked = true; }
    }

    function selectPreset(key) {
      const preset = PRESETS[key];
      selectedBooks.clear();
      document.querySelectorAll('.book-option').forEach(el => { el.classList.remove('selected'); el.querySelector('input').checked = false; });
      document.querySelectorAll('.preset-card').forEach(el => el.classList.remove('active'));
      for (const id of preset.books) {
        selectedBooks.add(id);
        const el = document.querySelector(`.book-option[data-id="${id}"]`);
        if (el) { el.classList.add('selected'); el.querySelector('input').checked = true; }
      }
      document.getElementById('paceSelect').value = preset.pace;
      event.currentTarget.classList.add('active');
      generateSchedule();
    }

    function generateSchedule() {
      if (selectedBooks.size === 0) return;
      const pace = parseInt(document.getElementById('paceSelect').value);
      const books = BOOKS.filter(b => selectedBooks.has(b.id));
      const allItems = [];
      for (const book of books) {
        for (const part of book.parts) {
          for (let i = 1; i <= part.n; i++) {
            allItems.push({
              book: book.name,
              label: `${book.name}${part.p ? ' Pt'+part.p : ''} #${i}`,
              url: part.flat ? `${part.base}${i}` : `${part.base}${i}`,
            });
          }
        }
      }
      const totalDays = Math.ceil(allItems.length / pace);
      let completedDays = 0;
      try {
        const saved = JSON.parse(localStorage.getItem('ajew-learning-plan') || '{}');
        if (saved.startDate) {
          completedDays = Math.floor((Date.now() - new Date(saved.startDate).getTime()) / 86400000);
          completedDays = Math.max(0, Math.min(completedDays, totalDays));
        }
      } catch {}
      const pct = totalDays > 0 ? Math.min(100, Math.round((completedDays / totalDays) * 100)) : 0;
      document.getElementById('progressFill').style.width = pct + '%';
      const endDate = new Date(Date.now() + (totalDays - completedDays) * 86400000);
      document.getElementById('scheduleInfo').innerHTML =
        `<strong>${allItems.length} items</strong> over <strong>${totalDays} days</strong> at ${pace}/day. ` +
        `Day ${completedDays + 1} of ${totalDays} (${pct}%). ` +
        `Estimated completion: <strong>${endDate.toLocaleDateString()}</strong>`;
      let html = '<table class="schedule-table"><thead><tr><th>Day</th><th>Date</th><th>Learning</th></tr></thead><tbody>';
      for (let d = Math.max(0, completedDays - 2); d < Math.min(totalDays, completedDays + 14); d++) {
        const date = new Date(Date.now() + (d - completedDays) * 86400000);
        const dateStr = date.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        const isToday = d === completedDays;
        const startIdx = d * pace;
        const dayItems = allItems.slice(startIdx, Math.min(startIdx + pace, allItems.length));
        const links = dayItems.map(item => `<a href="${item.url}">${item.label}</a>`).join(', ');
        html += `<tr class="${isToday ? 'today-row' : ''}"><td>Day ${d + 1}</td><td>${dateStr}${isToday ? ' (TODAY)' : ''}</td><td>${links || 'Complete!'}</td></tr>`;
      }
      html += '</tbody></table>';
      document.getElementById('scheduleContent').innerHTML = html;
      document.getElementById('scheduleOutput').style.display = 'block';
    }

    function savePlan() {
      localStorage.setItem('ajew-learning-plan', JSON.stringify({
        books: [...selectedBooks], pace: parseInt(document.getElementById('paceSelect').value),
        startDate: new Date().toISOString(),
      }));
      alert('Learning plan saved! Come back daily to see your schedule.');
    }

    function resetPlan() {
      if (confirm('Reset your progress? This will start your plan from day 1.')) {
        localStorage.removeItem('ajew-learning-plan');
        generateSchedule();
      }
    }

    function loadSavedPlan() {
      try {
        const saved = JSON.parse(localStorage.getItem('ajew-learning-plan') || 'null');
        if (!saved || !saved.books) return;
        for (const id of saved.books) {
          selectedBooks.add(id);
          const el = document.querySelector(`.book-option[data-id="${id}"]`);
          if (el) { el.classList.add('selected'); el.querySelector('input').checked = true; }
        }
        if (saved.pace) document.getElementById('paceSelect').value = saved.pace;
        generateSchedule();
      } catch {}
    }

    initBookSelector();
    loadSavedPlan();
  </script>
</Layout>
