---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Rabbi Nachman's Factory of Judaism - Nanach. Explore Rabbi Nachman's wisdom and inspiration.",
  image = "/og-image.svg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Rabbi Nachman, Breslov, Na Nach, Nanach, Judaism, Torah, Likutay Moharan, Likutay Halachos, Likutay Tefilos, Hisbodidus" />
    <meta name="author" content="Pettek Nanach" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | A Jew</title>
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="A Jew - Rabbi Nachman's Factory of Judaism" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@ajeworg" />
    
    <!-- Additional Meta Tags -->
    <meta name="theme-color" content="#4a90e2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "A Jew - Rabbi Nachman's Factory of Judaism",
        "url": "https://ajew.org",
        "description": "Explore the teachings of Rabbi Nachman of Breslov, Na Nach movement, Jewish wisdom, Torah insights, and spiritual guidance.",
        "publisher": {
          "@type": "Organization",
          "name": "A Jew",
          "logo": {
            "@type": "ImageObject",
            "url": "https://ajew.org/logo.svg"
          }
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://ajew.org/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    
    <!-- Additional Structured Data -->
    <link rel="alternate" type="application/json+oembed" href="/structured-data.json" title="Structured Data" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "A Jew - Na Nach Breslov",
      "url": "https://ajew.org",
      "description": "Teachings of Rebbe Nachman of Breslov and the Na Nach movement",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://ajew.org/teachings?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-64VMMKHB30"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-64VMMKHB30');
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">
          <span class="logo-text">A Jew</span>
        </a>
        <button class="mobile-menu-toggle" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/teachings">Teachings</a>
          <a href="/chat">Chat</a>
          <a href="/gematria">Gematria</a>
          <a href="/books">Books</a>
          <a href="/search">Search</a>
          <a href="/gallery">Gallery</a>
          <a href="/donate">Donate</a>
          <a href="/subscribe">Subscribe</a>
          <a href="/about">About</a>
        </div>
      </div>
    </nav>
    
    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <p>&#1504; &#1504;&#1495; &#1504;&#1495;&#1502; &#1504;&#1495;&#1502;&#1503; &#1502;&#1488;&#1493;&#1502;&#1503;</p>
          <p>Na Nach Nachma Nachman Me'Uman</p>
        <div class="footer-contact">
          <p>Contact Site Manager / &#1497;&#1510;&#1497;&#1512;&#1514; &#1511;&#1513;&#1512;: <a href="mailto:naanaach@gmail.com">naanaach@gmail.com</a></p>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} ajew.org</p>
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector('.mobile-menu-toggle');
      const navLinks = document.querySelector('.nav-links');
      
      if (menuToggle && navLinks) {
        menuToggle.addEventListener('click', () => {
          menuToggle.classList.toggle('active');
          navLinks.classList.toggle('active');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #1a365d;
    --color-secondary: #2c5282;
    --color-accent: #ed8936;
    --color-bg: #fffdf7;
    --color-text: #2d3748;
    --font-hebrew: 'Frank Ruhl Libre', serif;
    --font-body: 'Open Sans', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  a {
    color: #1a365d;
  }

  a:visited {
    color: #1a365d;
  }

  a:hover {
    color: #c53030;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  main {
    flex: 1;
    width: 100%;
  }

  .navbar {
    background: var(--color-primary);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-hebrew);
    font-size: 1.8rem;
    font-weight: 700;
    color: white;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background-color: white;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .mobile-menu-toggle.active span:nth-child(2) { opacity: 0; }
  .mobile-menu-toggle.active span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  footer {
    background: var(--color-primary);
    color: white;
    padding: 2rem;
    text-align: center;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  footer p {
    margin: 0.5rem 0;
  }

  footer p:first-child {
    font-family: var(--font-hebrew);
    font-size: 1.5rem;
  }

  .copyright {
    opacity: 0.7;
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  .footer-contact {
    margin: 1rem 0;
    padding: 0.5rem 0;
  }

  .footer-contact a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-primary);
      padding: 1rem 2rem;
      gap: 1rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }

    .nav-links.active {
      display: flex;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .navbar {
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .logo-text {
      font-size: 1.4rem;
    }
  }
</style>

