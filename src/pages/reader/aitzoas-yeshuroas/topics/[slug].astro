---
import AitzoasQualifiedPage from '../../../../components/AitzoasQualifiedPage.astro';
import {loadEdition} from '../../../../lib/qualified-aitzoas362.mjs';
import {projectionForPath,topicStructure} from '../../../../../public/qualified-aitzoas-topics.mjs';
import fs from 'node:fs';
import path from 'node:path';
export async function getStaticPaths(){const edition=await loadEdition();return topicStructure(edition).topics.map(x=>({params:{slug:x.slug}}));}
const edition=await loadEdition();
const view=projectionForPath(edition,Astro.url.pathname);
if(view.key!=='topic-'+Astro.params.slug)throw Error('Route/topic parameter mismatch');
const index=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/reader/aitzoas-yeshuroas/index.json'),'utf8'));
---
<AitzoasQualifiedPage edition={edition} view={view} index={index}/>
