---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Torah GPS - Spiritual Navigation" description="Find the right Torah teachings for what you're going through. Search by topic across 226+ sacred Jewish texts. A spiritual GPS for life's challenges.">
<div class="gps-page">
  <header class="gps-header">
    <div class="header-hebrew">תורה GPS</div>
    <h1>Torah GPS</h1>
    <p class="subtitle">Find the teachings you need for what you're going through</p>
    <p class="nanach">Na Nach Nachma Nachman MeUman</p>
  </header>

  <!-- Search Input -->
  <section class="gps-search">
    <div class="search-box">
      <input
        type="text"
        id="gpsInput"
        placeholder="What are you going through? (e.g., anxiety, money problems, anger...)"
        dir="auto"
        autocomplete="off"
        aria-label="Describe what you are going through"
      />
      <button id="gpsSearchBtn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </div>
  </section>

  <!-- Quick Topic Buttons -->
  <section class="gps-topics" id="topicButtons">
    <h2 class="section-label">Quick Topics / נושאים</h2>
    <div class="topic-grid" id="topicGrid">
      <!-- Filled by JS -->
    </div>
  </section>

  <!-- Loading -->
  <div id="gpsLoading" class="gps-loading" style="display:none;">
    <div class="loading-spinner"></div>
    <p>Searching the teachings...</p>
  </div>

  <!-- Results -->
  <section class="gps-results" id="gpsResults" style="display:none;">
    <div class="results-header">
      <h2 id="resultsTitle"></h2>
      <p id="resultsCount" class="results-count"></p>
      <button id="clearResults" class="clear-btn">Clear</button>
    </div>
    <div class="results-grid" id="resultsGrid">
      <!-- Filled by JS -->
    </div>
  </section>

  <!-- Empty State -->
  <div id="emptyState" class="empty-state" style="display:none;">
    <p>No matching teachings found. Try a different topic or browse the quick topics above.</p>
  </div>

  <!-- Info Footer -->
  <section class="gps-info">
    <p>Searching across <strong>226+ books</strong> of Torah, Breslov, Talmud, Mishna, Zohar, and more.</p>
    <p class="info-small">Results are based on English translations available in the library. <a href="/reader">Browse the full library</a></p>
  </section>
</div>

<style>
  /* ─── Page Layout ─── */
  .gps-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
    min-height: 80vh;
  }

  /* ─── Header ─── */
  .gps-header {
    text-align: center;
    padding: 2rem 1rem 1rem;
  }
  .gps-header .header-hebrew {
    font-family: 'Frank Ruhl Libre', 'David', serif;
    font-size: 2.4rem;
    color: #1a365d;
    margin-bottom: 0.2rem;
    direction: rtl;
  }
  .gps-header h1 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 2rem;
    color: #1a365d;
    margin: 0;
  }
  .gps-header .subtitle {
    color: #5a6a7a;
    font-size: 1.1rem;
    margin: 0.5rem 0 0.3rem;
  }
  .gps-header .nanach {
    font-family: 'Frank Ruhl Libre', serif;
    color: #b8860b;
    font-size: 0.95rem;
    margin: 0;
  }

  /* ─── Search Box ─── */
  .gps-search {
    max-width: 640px;
    margin: 1.5rem auto;
  }
  .search-box {
    display: flex;
    border: 2px solid #1a365d;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 12px rgba(26, 54, 93, 0.12);
    transition: box-shadow 0.2s;
  }
  .search-box:focus-within {
    box-shadow: 0 4px 20px rgba(26, 54, 93, 0.2);
    border-color: #2b6cb0;
  }
  .search-box input {
    flex: 1;
    padding: 0.9rem 1.2rem;
    border: none;
    font-size: 1.05rem;
    font-family: 'Open Sans', sans-serif;
    outline: none;
    background: transparent;
  }
  .search-box input::placeholder {
    color: #9aa;
  }
  .search-box button {
    background: #1a365d;
    color: white;
    border: none;
    padding: 0 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background 0.2s;
  }
  .search-box button:hover {
    background: #2b6cb0;
  }

  /* ─── Topic Buttons ─── */
  .gps-topics {
    margin: 1.5rem 0;
  }
  .section-label {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.1rem;
    color: #1a365d;
    text-align: center;
    margin-bottom: 0.8rem;
  }
  .topic-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .topic-btn {
    padding: 0.45rem 0.9rem;
    border: 1.5px solid #d4a574;
    border-radius: 20px;
    background: #fdf8f0;
    color: #5a4030;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .topic-btn:hover {
    background: #d4a574;
    color: #fff;
    border-color: #d4a574;
  }
  .topic-btn.active {
    background: #1a365d;
    color: white;
    border-color: #1a365d;
  }
  .topic-btn .he {
    font-family: 'Frank Ruhl Libre', 'David', serif;
    font-size: 0.85rem;
    margin-left: 0.3rem;
    opacity: 0.8;
  }

  /* ─── Loading ─── */
  .gps-loading {
    text-align: center;
    padding: 2rem;
    color: #5a6a7a;
  }
  .loading-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #e2e8f0;
    border-top-color: #1a365d;
    border-radius: 50%;
    margin: 0 auto 0.8rem;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ─── Results ─── */
  .gps-results {
    margin: 1.5rem 0;
  }
  .results-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .results-header h2 {
    font-family: 'Frank Ruhl Libre', serif;
    color: #1a365d;
    font-size: 1.3rem;
    margin: 0;
    flex: 1;
  }
  .results-count {
    color: #7a8a9a;
    font-size: 0.9rem;
    margin: 0;
  }
  .clear-btn {
    padding: 0.3rem 0.8rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #f8f8f8;
    color: #666;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .clear-btn:hover {
    background: #eee;
    border-color: #aaa;
  }
  .results-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ─── Result Card ─── */
  .result-card {
    border: 1px solid #e2ddd5;
    border-radius: 10px;
    padding: 1rem 1.2rem;
    background: #fefcf9;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .result-card:hover {
    box-shadow: 0 2px 12px rgba(26, 54, 93, 0.1);
    border-color: #d4a574;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    gap: 0.5rem;
  }
  .card-book {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 700;
    color: #1a365d;
    font-size: 0.95rem;
  }
  .card-ref {
    font-size: 0.8rem;
    color: #8a7a6a;
    white-space: nowrap;
  }
  .card-he {
    font-family: 'Frank Ruhl Libre', 'David', serif;
    direction: rtl;
    text-align: right;
    color: #3a3a3a;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #f0ece5;
  }
  .card-en {
    color: #4a4a4a;
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.6rem;
  }
  .card-link {
    display: inline-block;
    color: #2b6cb0;
    font-size: 0.88rem;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .card-link:hover {
    color: #1a365d;
    text-decoration: underline;
  }

  /* ─── Empty State ─── */
  .empty-state {
    text-align: center;
    padding: 2rem;
    color: #7a8a9a;
    font-size: 1rem;
  }

  /* ─── Info Footer ─── */
  .gps-info {
    text-align: center;
    padding: 2rem 1rem;
    margin-top: 2rem;
    border-top: 1px solid #e8e4dd;
    color: #6a7a8a;
    font-size: 0.95rem;
  }
  .gps-info strong {
    color: #1a365d;
  }
  .gps-info .info-small {
    font-size: 0.82rem;
    margin-top: 0.3rem;
  }
  .gps-info a {
    color: #2b6cb0;
  }

  /* ─── Dark Mode ─── */
  :global(body.dark-mode) .gps-page {
    color: #e0e0e0;
  }
  :global(body.dark-mode) .gps-header .header-hebrew,
  :global(body.dark-mode) .gps-header h1 {
    color: #90b8f0;
  }
  :global(body.dark-mode) .gps-header .subtitle {
    color: #aab;
  }
  :global(body.dark-mode) .search-box {
    background: #2a2a3e;
    border-color: #4a5a7a;
  }
  :global(body.dark-mode) .search-box:focus-within {
    border-color: #6a8ac0;
  }
  :global(body.dark-mode) .search-box input {
    color: #e0e0e0;
  }
  :global(body.dark-mode) .search-box input::placeholder {
    color: #6a7a8a;
  }
  :global(body.dark-mode) .topic-btn {
    background: #2a2a3e;
    border-color: #5a4a3a;
    color: #d4a574;
  }
  :global(body.dark-mode) .topic-btn:hover {
    background: #5a4a3a;
    color: #fff;
  }
  :global(body.dark-mode) .topic-btn.active {
    background: #3a5a8a;
    border-color: #3a5a8a;
    color: #fff;
  }
  :global(body.dark-mode) .result-card {
    background: #1e1e2e;
    border-color: #3a3a4e;
  }
  :global(body.dark-mode) .result-card:hover {
    border-color: #6a5a4a;
  }
  :global(body.dark-mode) .card-book {
    color: #90b8f0;
  }
  :global(body.dark-mode) .card-he {
    color: #d0d0d0;
    border-bottom-color: #3a3a4e;
  }
  :global(body.dark-mode) .card-en {
    color: #b8b8c8;
  }
  :global(body.dark-mode) .card-link {
    color: #6aafe0;
  }
  :global(body.dark-mode) .section-label,
  :global(body.dark-mode) .results-header h2 {
    color: #90b8f0;
  }
  :global(body.dark-mode) .gps-info {
    border-top-color: #3a3a4e;
    color: #8a8a9a;
  }
  :global(body.dark-mode) .gps-info strong {
    color: #90b8f0;
  }

  /* ─── Mobile ─── */
  @media (max-width: 640px) {
    .gps-header .header-hebrew { font-size: 1.8rem; }
    .gps-header h1 { font-size: 1.5rem; }
    .gps-header .subtitle { font-size: 0.95rem; }
    .search-box input { font-size: 0.95rem; padding: 0.75rem 1rem; }
    .topic-btn { font-size: 0.82rem; padding: 0.4rem 0.7rem; }
    .result-card { padding: 0.8rem 1rem; }
    .card-he { font-size: 0.95rem; }
    .card-en { font-size: 0.88rem; }
    .results-header { flex-direction: column; align-items: flex-start; }
  }
</style>

<script is:inline>
(function() {
  let gpsData = null;
  let currentTopic = null;

  const input = document.getElementById('gpsInput');
  const searchBtn = document.getElementById('gpsSearchBtn');
  const topicGrid = document.getElementById('topicGrid');
  const loading = document.getElementById('gpsLoading');
  const resultsSection = document.getElementById('gpsResults');
  const resultsTitle = document.getElementById('resultsTitle');
  const resultsCount = document.getElementById('resultsCount');
  const resultsGrid = document.getElementById('resultsGrid');
  const clearBtn = document.getElementById('clearResults');
  const emptyState = document.getElementById('emptyState');

  // Topic synonyms for fuzzy matching from user input
  const SYNONYMS = {
    'joy': ['joy', 'happy', 'happiness', 'simcha', 'cheerful', 'glad', 'uplifted', 'celebration'],
