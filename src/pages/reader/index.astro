  { title: 'Ketuvim / כתובים', ids: ['tanach-tehillim', 'tanach-mishlei', 'tanach-iyov', 'tanach-shir-hashirim', 'tanach-rus', 'tanach-eicha', 'tanach-koheles', 'tanach-esther', 'tanach-daniel', 'tanach-ezra', 'tanach-nechemia', 'tanach-divrei-hayamim-a', 'tanach-divrei-hayamim-b'] },
  { title: 'Talmud Bavli / תלמוד בבלי', ids: ['talmud-bavli-brachot', 'talmud-bavli-shabbat', 'talmud-bavli-eruvin', 'talmud-bavli-psachim', 'talmud-bavli-shkalim', 'talmud-bavli-rosh-hashana', 'talmud-bavli-yoma', 'talmud-bavli-sukkah', 'talmud-bavli-beitza', 'talmud-bavli-taanit', 'talmud-bavli-megillah', 'talmud-bavli-moed-katan', 'talmud-bavli-chagigah', 'talmud-bavli-yevamot', 'talmud-bavli-ketubot', 'talmud-bavli-nedarim', 'talmud-bavli-nazir', 'talmud-bavli-sotah', 'talmud-bavli-gittin', 'talmud-bavli-kiddushin', 'talmud-bavli-bava-kamma', 'talmud-bavli-bava-metzia', 'talmud-bavli-bava-batra', 'talmud-bavli-sanhedrin', 'talmud-bavli-makkot', 'talmud-bavli-shevuot', 'talmud-bavli-avodah-zarah', 'talmud-bavli-horayot', 'talmud-bavli-eduyot', 'talmud-bavli-zevachim', 'talmud-bavli-menachot', 'talmud-bavli-chulin', 'talmud-bavli-bechorot', 'talmud-bavli-arachin', 'talmud-bavli-temurah', 'talmud-bavli-keritot', 'talmud-bavli-meilah', 'talmud-bavli-tamid', 'talmud-bavli-niddah'] },
  { title: 'Mishna / משנה — All Orders in One Folder', ids: ['mishna-brachot', 'mishna-peah', 'mishna-demai', 'mishna-kilayim', 'mishna-sheviit', 'mishna-terumot', 'mishna-maasrot', 'mishna-maaser-sheni', 'mishna-challah', 'mishna-orlah', 'mishna-bikkurim', 'mishna-shabbat', 'mishna-eruvin', 'mishna-pesachim', 'mishna-shekalim', 'mishna-yoma', 'mishna-sukkah', 'mishna-beitzah', 'mishna-rosh-hashana', 'mishna-taanit', 'mishna-megillah', 'mishna-moed-katan', 'mishna-chagigah', 'mishna-yevamot', 'mishna-ketubot', 'mishna-nedarim', 'mishna-nazir', 'mishna-sotah', 'mishna-gittin', 'mishna-kiddushin', 'mishna-bava-kamma', 'mishna-bava-metzia', 'mishna-bava-batra', 'mishna-sanhedrin', 'mishna-makkot', 'mishna-shevuot', 'mishna-eduyot', 'mishna-avodah-zarah', 'mishna-avot', 'mishna-horayot', 'mishna-zevachim', 'mishna-menachot', 'mishna-chulin', 'mishna-bechorot', 'mishna-arachin', 'mishna-temurah', 'mishna-keritot', 'mishna-meilah', 'mishna-tamid', 'mishna-middot', 'mishna-kelim', 'mishna-parah', 'mishna-taharot', 'mishna-mikvaot', 'mishna-niddah', 'mishna-machshirin', 'mishna-zavim'] },
  { title: 'Rambam - Mishneh Torah / רמב"ם - משנה תורה', ids: ['rambam-mada', 'rambam-ahava', 'rambam-zmanim', 'rambam-nashim', 'rambam-kedusha', 'rambam-haflaa', 'rambam-zeraim', 'rambam-avoda', 'rambam-korbanot', 'rambam-tahara', 'rambam-nezikin', 'rambam-kinyan', 'rambam-mishpatim', 'rambam-shoftim'] },
  { title: 'Zohar HaKadosh / זוהר הקדוש', ids: ['zohar-hakdama', 'zohar-bereishit', 'zohar-shemos', 'zohar-vayikra', 'zohar-bamidbar', 'zohar-devarim', 'zohar-tikunim', 'zohar-hadash'] },
  { title: 'Ramchal / רמח"ל', ids: ['ramchal-mesillas-yesharim', 'ramchal-derech-hashem', 'ramchal-daas-tevunos', 'ramchal-klach-pitchei-chochma', 'ramchal-adir-bamuroam', 'ramchal-derech-etz-chaim', 'ramchal-maamar-haikkarim', 'ramchal-asara-perakim', 'ramchal-ruzin-gineezin', 'ramchal-tikunim-chadashim', 'ramchal-yichud-hayeeruh', 'ramchal-otzros-ramchal', 'ramchal-ginzay-ramchal', 'ramchal-shaaray-ramchal'] },
  { title: 'Halacha & More / הלכה ועוד', ids: ['haggadah-shel-pesach'] },
  { title: 'Breslov Pamphlets & Letters / קונטרסים ומכתבים', ids: ['misc-קונטרס-קיום-התורה', 'misc-קונטרס-תורה-אור', 'misc-שיחת-הנפש', 'misc-ספר-שיר-ידידות', 'misc-ספר-ההשתטחות', 'misc-ליקוטי-אבן', 'misc-מכתב-רבי-געציל-לרב-קוק', 'misc-עצות-ישרות', 'azamra'] },
  { title: 'History & Stories / תולדות וסיפורים', ids: ['misc-תולדות-שמואל', 'misc-טובות-זכרונות', 'stories-סיפורי-ר--משה-גלידמא', 'stories-סיפורים-מר--שמואל-הו'] },
];

// Collect remaining books not in categories
const categorizedIds = categories.flatMap(c => c.ids);
const miscBooks = masterCatalog.books.filter(b => !categorizedIds.includes(b.id) && b.parts.some(p => p.totalTorahs > 0));
if (miscBooks.length > 0) {
  categories.push({ title: 'Students & Other Works / תלמידים ועוד', ids: miscBooks.map(b => b.id) });
}

// Pre-load LM catalogs specifically (for backward compatibility with detailed listing)
const catalog1 = loadJSON('public/reader/likutay-moharan/part-1/index.json');
const catalog2 = loadJSON('public/reader/likutay-moharan/part-2/index.json');

// LM Volume 1 section groupings (per naanaach.blogspot.com)
// Each Torah number falls into exactly one section — used to render section
// headers above the first Torah of each group.
// prefaceSlug points to the short poetic preface JSON for that section.
const lmVol1Sections = [
  { start: 1,  end: 15,  english: 'Rabba bar bar Chana',                   hebrew: 'רבה בר בר חנה',    prefaceSlug: 'preface-section-1' },
  { start: 16, end: 18,  english: 'The Mishtu-ai (Those Who Told Over)',   hebrew: 'משתעי',           prefaceSlug: 'preface-section-2' },
  { start: 19, end: 22,  english: 'Safra DiTzniusa (Book of Concealment)', hebrew: 'ספרא דצניעותא',   prefaceSlug: 'preface-section-3' },
  { start: 23, end: 31,  english: 'Suvay Divay Atuna (Elders of Athens)',  hebrew: 'סבי דבי אתונא',   prefaceSlug: 'preface-section-4' },
  { start: 32, end: 286, english: 'Main Teachings',                        hebrew: 'התורות הנותרות', prefaceSlug: 'preface-section-5' },
];

// Build section groups for Vol 1 once, up front (so the JSX below has no
// logic inside .map() — Astro's compiler prefers simple expressions in JSX).
const lmVol1Groups = (() => {
  if (!catalog1 || !Array.isArray(catalog1.torahs)) return [];
  return lmVol1Sections.map((section) => {
    const sectionTorahs = catalog1.torahs.filter(
      (t) => typeof t.number === 'number' && t.number >= section.start && t.number <= section.end
    );
    const rangeLabel = section.end !== section.start
      ? `Torahs ${section.start}–${section.end}`
      : `Torah ${section.start}`;
    return { ...section, sectionTorahs, rangeLabel };
  }).filter((g) => g.sectionTorahs.length > 0);
})();

const storyTitleOverrides = {
  0: 'Introduction',
  1: 'The Lost Princess',
  2: 'The King and the Emperor',
  3: 'The Lame Man',
  4: 'The King Who Decreed Apostasy',
  5: 'The King’s Son Made of Precious Stones',
  6: 'The Humble King',
  7: 'The Fly and the Spider',
  8: 'The Rabbi and His Only Son',
  9: 'The Clever Man and the Simple Man',
  10: 'The Burgher and the Pauper',
  11: 'The King’s Son and the Maid’s Son Who Were Exchanged',
  12: 'The Prayer Leader',
  13: 'The Seven Beggars',
  14: 'Discourses After the Stories',
  15: 'A Story of Trust',
};

const chayeyChapterTitles = {
  1: ['Conversations and Stories for Each Torah', 'שיחות וספורים וענינים שהיה אצל כל תורה ומעשה'],
  2: ['Sichos HaRan', 'שיחות הר״ן'],
  3: ['Conversations Related to the Stories', 'שיחות השיך לספורי מעשיות'],
  4: ['Conversations Related to Sichos HaRan', 'שיחות השיכים לשיחות הר״ן'],
  5: ['Conversations Related to Sefer HaMidos', 'שיחות השיכים לספר המדות'],
  6: ['Related to the Torah Conversations', 'שייך להשיחות שהיה אצל כל תורה'],
  7: ['New Stories', 'ספורים חדשים'],
  8: ['Birthplace, Residence, Journeys and Wanderings', 'מקום לדתו וישיבתו ונסיעותיו וטלטוליו'],
  9: ['Journey to the Land of Israel', 'נסיעתו לארץ ישראל'],
  10: ['His Wit and Holy Expressions', 'דברי צחות שלו'],
  11: ['Do Not Be Stubborn or Force the Hour', 'שלא להתעקש על שום דבר ואין לדחק את השעה'],
  12: ['The Drawing Near of Rabbi Yudel', 'התקרבות הרב יודיל הנ״ל אצל רבנו זכרונו לברכה'],
};

function specialBookItems(bookId) {
  if (bookId === 'shivchay-haran') {
    return [
      { number: 1, displayNumber: 'Foreword', title: 'Translator Foreword', hebrewTitle: 'הקדמת המתרגם', url: '/reader/praises-of-rabbi-nachman/1/1', paragraphs: 10 },
      { number: 2, displayNumber: 'Intro', title: "Rabbi Nosson's Introduction", hebrewTitle: 'הקדמת רבי נתן', url: '/reader/praises-of-rabbi-nachman/1/2', paragraphs: 6 },
      { number: 3, displayNumber: 'Part I', title: 'Part I — The Praises of Rabbi Nachman', hebrewTitle: 'חלק א — שבחי רבינו', url: '/reader/praises-of-rabbi-nachman/1/3', paragraphs: 27 },
      { number: 4, displayNumber: 'Part II', title: 'Part II — The Journey to the Land of Israel', hebrewTitle: 'חלק ב — נסיעתו לארץ ישראל', url: '/reader/shivchay-haran/1/28', paragraphs: 36 },
    ];
  }
  if (bookId === 'chayey-moharan') {
    return Object.entries(chayeyChapterTitles).map(([number, names]) => ({
      number: Number(number),
      displayNumber: number,
      title: names[0],
      hebrewTitle: names[1],
      url: `/reader/chayey-moharan/1/${number}`,
    }));
  }
  return [];
}

function getEntryNumber(t) {
  return t.number ?? t.torah ?? t.displayNumber;
}

function looksHebrewOnly(text) {
  return !!text && /[\u0590-\u05FF]/.test(text) && !/[A-Za-z]/.test(text);
}

function hebrewNumeralValue(text) {
  const values = { 'א':1, 'ב':2, 'ג':3, 'ד':4, 'ה':5, 'ו':6, 'ז':7, 'ח':8, 'ט':9, 'י':10, 'כ':20, 'ך':20, 'ל':30, 'מ':40, 'ם':40, 'נ':50, 'ן':50, 'ס':60, 'ע':70, 'פ':80, 'ף':80, 'צ':90, 'ץ':90, 'ק':100, 'ר':200, 'ש':300, 'ת':400 };
  const clean = String(text || '').replace(/[^\u05D0-\u05EA]/g, '');
  return clean ? [...clean].reduce((sum, ch) => sum + (values[ch] || 0), 0) : null;
}

function mishnaDisplayEntry(t) {
  const number = getEntryNumber(t);
  const rawTitle = String(t.title || '').trim();
  const rawHebrew = String(t.hebrewTitle || rawTitle || '').trim();
  const perekHeb = (rawHebrew.match(/פרק\s+([\u05D0-\u05EA״׳''\"]+)/) || [])[1] || (String(t.perek || '').match(/פרק\s+([\u05D0-\u05EA״׳''\"]+)/) || [])[1];
  const mishnaHeb = (rawHebrew.match(/משנה\s+([\u05D0-\u05EA״׳''\"]+)/) || [])[1];
  const perek = hebrewNumeralValue(perekHeb);
  const mishna = hebrewNumeralValue(mishnaHeb);
  const en = (perek && mishna) ? `Chapter ${perek}, Mishnah ${mishna}` : `Mishnah ${number || ''}`.trim();
  return { number, en, he: rawHebrew, paragraphs: t.paragraphs, url: t.url };
}

function displayEntry(bookId, t) {
  if (bookId.startsWith('mishna-')) return mishnaDisplayEntry(t);
  const number = getEntryNumber(t);
  const rawTitle = String(t.title || '').trim();
  const override = bookId === 'sipurey-maasiyos' ? storyTitleOverrides[number] : null;
  const en = override || (looksHebrewOnly(rawTitle) ? '' : rawTitle) || `Section ${number || ''}`.trim();
  const he = t.hebrewTitle || (looksHebrewOnly(rawTitle) ? rawTitle : '');
  return { number, en, he, paragraphs: t.paragraphs, url: t.url };
}

function shouldUseEntryCards(bookId, totalPages) {
  return totalPages <= 40 || ['sefer-hamidos', 'sipurey-maasiyos', 'praises-of-rabbi-nachman', 'chayey-moharan', 'shivchay-haran'].includes(bookId);
}

function itemClass(bookId, totalPages) {
  if (bookId === 'sefer-hamidos') return 'topic-card-list';
  return shouldUseEntryCards(bookId, totalPages) ? 'entry-card-list' : '';
}

function linkClass(bookId, totalPages) {
  if (bookId === 'sefer-hamidos') return 'topic-card';
  return shouldUseEntryCards(bookId, totalPages) ? 'entry-card' : '';
}
