---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import {loadDirectory} from '../../../../lib/qualified-yimai-hatlaos-directory.mjs';
export function getStaticPaths(){return [{params:{part:'1'}}];}
const directory=await loadDirectory();
---
<Layout title={directory.title+' — Contents'} description={'Read '+directory.title+' in Hebrew and English, with source notes.'}>
  <p><a href={directory.url}>Read the complete bilingual book</a></p>
  <ReaderDirectory title={directory.title} hebrewTitle={directory.hebrewTitle} subtitle="Hebrew and English, with source notes" countLabel={`${directory.items.length} sections`} items={directory.items} hrefBase={directory.url} />
</Layout>
