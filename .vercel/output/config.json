{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin-subs/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/chat/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/signup/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stripe-webhook/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/subscriptions/?$",
			"dest": "_render"
		}
	]
}