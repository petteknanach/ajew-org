<style>
  .book-page { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
  .book-header { text-align: center; margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 3px double #e2e8f0; }
  .book-header h1 { font-size: 2.5rem; color: #1a365d; margin: 0 0 0.5rem; font-family: 'Frank Ruhl Libre', serif; }
  .book-header h2 { font-size: 1.5rem; color: #2c5282; margin: 0 0 1rem; font-weight: 500; font-family: 'Frank Ruhl Libre', serif; }
  .subtitle { color: #718096; font-style: italic; font-size: 1.1rem; }
  .intro-section { background: linear-gradient(135deg, #f7fafc 0%, #e6fffa 100%); padding: 2rem; border-radius: 12px; margin-bottom: 2rem; }
  .intro-section p { margin-bottom: 1rem; line-height: 1.8; }
  .quote { text-align: center; font-size: 1.3rem; color: #1a365d; font-weight: 600; margin-top: 1.5rem; font-family: 'Frank Ruhl Libre', serif; }
  .toc { background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 2rem; }
  .toc h3 { color: #1a365d; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid #e2e8f0; text-align: center; }
  .letter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 0.75rem; }
  .letter-link { display: block; padding: 0.75rem; background: #f7fafc; color: #2d3748; text-decoration: none; text-align: center; border-radius: 8px; font-weight: 500; transition: all 0.2s; border: 1px solid #e2e8f0; }
  .letter-link:hover { background: #1a365d; color: white; transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
  .book-nav { display: flex; justify-content: space-between; gap: 1rem; }
  .back-link, .start-reading { padding: 0.75rem 1.5rem; background: #1a365d; color: white; text-decoration: none; border-radius: 8px; font-weight: 500; transition: all 0.2s; }
  .start-reading { background: #059669; }
  .back-link:hover, .start-reading:hover { transform: translateY(-2px); opacity: 0.9; }
  @media (max-width: 640px) { .book-header h1 { font-size: 1.8rem; } .letter-grid { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); } .letter-link { padding: 0.6rem; font-size: 0.9rem; } }
</style>
