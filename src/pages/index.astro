  .start-card-green { background: linear-gradient(135deg, #d8f3dc, #95d5b2); border-color: #74c69d; }
  .start-card-teal { background: linear-gradient(135deg, #e8f0fe, #c8d8f0); border-color: #a0b8d0; }
  .start-card-icon { font-size: 1.5rem; }
  .start-card-label { font-weight: 700; color: var(--navy); font-size: 0.95rem; }
