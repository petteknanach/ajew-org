---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() { return [{ params: { part: '1' } }]; }
const { part } = Astro.params;
const partNum = parseInt(part || '1');
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/aitzoas-yeshuroas/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) { console.error('Error loading aitzoas-yeshuroas index:', e); }
const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || 'Aitzoas Yeshuroas'} — Directory`} description={`Directory for ${indexData?.title || 'Aitzoas Yeshuroas'}.`}>
  <ReaderDirectory
    title={indexData?.title || 'Aitzoas Yeshuroas'}
    hebrewTitle={indexData?.hebrewTitle || ''}
    subtitle={indexData?.author || ''}
    countLabel={`${totalSections} entries`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/aitzoas-yeshuroas/${partNum}/`}
  />
</Layout>
