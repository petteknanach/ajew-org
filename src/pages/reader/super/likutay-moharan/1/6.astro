---
import Layout from '../../../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const load = (relativePath: string) => JSON.parse(fs.readFileSync(path.join(process.cwd(), relativePath), 'utf8'));
const torah = load('public/reader/super/likutay-moharan/1/6/torah-study.json');
const pettek = load('public/reader/pettek-nanach-commentary/torah-6.json');
const biur = load('public/reader/biur-halikutim/section-11.json');
const parparos = load('public/reader/parparos-lechochma/section-7.json');
const likutayNanachSource = load('public/reader/likutay-nanach/volume-4/chapter-1.json');
const likutayNanach = {
  ...likutayNanachSource,
  segments: likutayNanachSource.segments
    .filter((segment: any) => Number(segment.index) >= 208 && Number(segment.index) <= 211)
    .map((segment: any, index: number) => ({ ...segment, index: index + 1 })),
};
const prayer = load('public/reader/likutay-tefilos/part-1/prayer-6.json');
const peerManifest = load('public/reader/super/likutay-moharan/1/6/peer-halikutim/manifest.json');
// Keep the full structured extraction in the manifest, but send only the
// facsimile navigation fields to the browser; the unreviewed OCR is not rendered.
const peer = { ...peerManifest, pages: peerManifest.pages.map(({ fragments: _fragments, extraction: _extraction, ...page }: any) => page) };
const phraseStudy = load('public/reader/super/likutay-moharan/1/6/phrase-study.json');
const payload = JSON.stringify({ torah, pettek, biur, parparos, likutayNanach, prayer, peer, phraseStudy }).replace(/</g, '\\u003c');
const sectionLabels = torah.segments.map((segment: any) => {
  const he = String(segment.he || '').trim().slice(0, 52);
  const en = String(segment.en || '').replace(/^\s*\d+\.\s*/, '').slice(0, 58);
  return [he, en];
});
---

<Layout
  title="Super Reader — Likutay Moharan Torah 6"
  description="Read Likutay Moharan Torah 6 in Hebrew and English with integrated project study tools and Pe’er HaLikutim facsimiles."
>
  <div class="sr-shell" id="super-reader">
    <div class="sr-progress" id="sr-progress"></div>

    <header class="sr-topbar">
      <div class="sr-brand">
        <a href="/reader/likutay-moharan/1/6" class="sr-back" aria-label="Return to classic reader">←</a>
        <div>
          <span class="sr-eyebrow">AJEW SUPER READER · BETA</span>
          <strong>ליקוטי מוהר״ן · תורה 6</strong>
        </div>
      </div>
      <div class="sr-title">קרא את יהושע <span>·</span> Kra Et Yehoshua</div>
      <div class="sr-actions" aria-label="Reader controls">
        <div class="sr-segmented" aria-label="Language">
          <button data-lang="he">עב</button>
          <button data-lang="both" class="is-active">עב · EN</button>
          <button data-lang="en">EN</button>
        </div>
        <button id="sr-font-down" title="Smaller text" aria-label="Smaller text">A−</button>
        <button id="sr-font-up" title="Larger text" aria-label="Larger text">A+</button>
        <button id="sr-nikud" title="Toggle Hebrew vowels" aria-label="Toggle Hebrew vowels">נִקּוּד</button>
        <button id="sr-colors" title="Toggle phrase colors" aria-label="Toggle phrase colors">Phrases</button>
        <button id="sr-focus" title="Focus mode" aria-label="Focus mode">Focus</button>
        <button id="sr-theme" title="Change theme" aria-label="Change theme">◐</button>
        <button id="sr-command" class="sr-command-button" title="Power menu (Ctrl/⌘ K)">⌘K</button>
      </div>
    </header>

    <nav class="sr-rail" aria-label="Torah sections">
      <div class="sr-rail-head">
        <span>מהלך התורה</span>
        <small>{torah.segments.length} aligned passages</small>
      </div>
      <ol>
        {torah.segments.map((segment: any, index: number) => (
          <li>
            <button class={index === 0 ? 'is-active' : ''} data-jump={segment.index}>
              <span class="sr-step">{segment.index}</span>
              <span class="sr-step-label">
                <b>{sectionLabels[index][0]}</b>
                <small>{sectionLabels[index][1]}</small>
              </span>
            </button>
          </li>
        ))}
      </ol>
      <div class="sr-map">
        <b>Torah map</b>
        <span>Repentance → Silence → Divine honor → Ascent and descent → Elul → Aleph</span>
      </div>
    </nav>

    <main class="sr-reading" id="sr-reading">
      <section class="sr-hero">
        <div class="sr-kicker">תורה 6 · PART I</div>
        <h1 lang="he" dir="rtl">{torah.hebrewTitle}</h1>
        <p>{torah.keyVerseTranslation}</p>
        <div class="sr-themes">
          {torah.themes.map((theme: string) => <span>{theme}</span>)}
        </div>
        <div class="sr-source-counts">
          <span><b>{torah.segments.length}</b> aligned passages</span>
          <span><b>{phraseStudy.phrases.length}</b> key phrases</span>
          <span><b>9</b> study layers</span>
          <span><b>6</b> commentary, prayer, and facsimile sources</span>
        </div>
      </section>

      <nav class="sr-section-pager" aria-label="Section navigation">
        <button id="sr-prev-section" aria-label="Previous section">← <span>Previous</span></button>
        <button id="sr-current-section" aria-label="Open section outline">
          <small>PASSAGE</small><strong>1 of {torah.segments.length}</strong><span>{sectionLabels[0][1]}</span>
        </button>
        <button id="sr-next-section" aria-label="Next section"><span>Next</span> →</button>
      </nav>

      <nav class="sr-phrase-pager" aria-label="Key phrase navigation">
        <button id="sr-prev-phrase" aria-label="Previous key phrase">←</button>
        <button id="sr-current-phrase" aria-label="Open phrase explanation">
          <small>PHRASE STUDY</small><strong dir="rtl">{phraseStudy.phrases[0]?.he}</strong><span>1 of {phraseStudy.phrases.length}</span>
        </button>
        <button id="sr-next-phrase" aria-label="Next key phrase">→</button>
      </nav>

      <div class="sr-text" id="sr-text">
        {torah.segments.map((segment: any, index: number) => (
          <article class={`sr-passage ${index === 0 ? 'is-current' : ''}`} id={`sr-seg-${segment.index}`} data-segment={segment.index} tabindex="0">
            <button class="sr-anchor" data-anchor={segment.index} aria-label={`Copy link to section ${segment.index}`}>{segment.index}</button>
            <div class="sr-passage-tools">
              <button data-bookmark={segment.index} title="Bookmark this section" aria-label="Bookmark this section">♡</button>
              <button data-comment={segment.index} title="Open commentary" aria-label="Open commentary">☰</button>
            </div>
            <div class="sr-phrase-strip" aria-label={`Key phrases in section ${segment.index}`}>
              <span>KEY PHRASES</span>
              <button class="sr-color-toggle" data-color-toggle type="button" aria-label="Toggle phrase colors">Colors on</button>
              {phraseStudy.phrases.filter((phrase: any) => phrase.segment === segment.index).map((phrase: any) => (
                <button id={`sr-phrase-${phrase.id}`} data-phrase={phrase.id} dir="rtl" title={phrase.en}>{phrase.he}</button>
              ))}
            </div>
            <div class="sr-columns">
              <div class="sr-hebrew" lang="he" dir="rtl">
                <p data-plain={segment.he} data-nikud={segment.he_nikud || segment.he}>{segment.he}</p>
              </div>
              <div class="sr-english" lang="en">
                <p data-english={String(segment.en || '').replace(/\s+/g, ' ').trim()}>{String(segment.en || '').replace(/\s+/g, ' ').trim()}</p>
              </div>
            </div>
            <div class="sr-source-ribbon" aria-label={`Study section ${segment.index}`}>
              <span>STUDY</span>
              <button data-open-source="phrase" data-open-segment={segment.index}>Phrase</button>
              <button data-open-source="guide" data-open-segment={segment.index}>Guide</button>
              <button data-open-source="pettek" data-open-segment={segment.index}>Pettek</button>
              <button data-open-source="biur" data-open-segment={segment.index}>Biur</button>
              <button data-open-source="parparos" data-open-segment={segment.index}>Parparos</button>
              <button data-open-source="nanach" data-open-segment={segment.index}>L. Nanach</button>
              <button data-open-source="prayer" data-open-segment={segment.index}>Prayer</button>
              <button data-open-source="peer" data-open-segment={segment.index}>Pe’er</button>
              <button data-open-source="notes" data-open-segment={segment.index}>Notes</button>
            </div>
          </article>
        ))}
      </div>
      <footer class="sr-reader-footer">
        <a href="/reader/likutay-moharan/1/6">Continue to classic Torah 6 →</a>
        <span>Classic reader remains available</span>
      </footer>
    </main>

    <aside class="sr-dock" id="sr-dock" aria-label="Study sources">
      <div class="sr-dock-head">
        <div>
          <span class="sr-eyebrow">LIVE STUDY DESK</span>
          <strong id="sr-dock-title">Section 1</strong>
        </div>
        <button id="sr-dock-close" aria-label="Close study desk">×</button>
      </div>
      <div class="sr-tabs" role="tablist" aria-label="Sources">
        <button class="is-active" data-source="phrase">Phrase</button>
        <button data-source="guide">Guide</button>
        <button data-source="pettek">Pettek</button>
        <button data-source="biur">Biur</button>
        <button data-source="parparos">Parparos</button>
        <button data-source="nanach">L. Nanach</button>
        <button data-source="prayer">Prayer</button>
        <button data-source="peer">Pe’er</button>
        <button data-source="notes">Notes</button>
        <button data-source="saved">Saved</button>
      </div>
      <div class="sr-dock-toolbar">
        <label class="sr-search-wrap">
          <span>⌕</span>
          <input id="sr-source-search" type="search" placeholder="Search this source…" autocomplete="off" />
        </label>
        <select id="sr-layer" aria-label="Commentary depth">
          <option value="beginner">Beginner</option>
          <option value="intermediate" selected>Intermediate</option>
          <option value="scholarly">Scholarly</option>
        </select>
      </div>
      <div class="sr-dock-body" id="sr-dock-body" tabindex="0"></div>
    </aside>

    <button class="sr-mobile-desk" id="sr-mobile-desk" aria-controls="sr-dock">Sources <span>9</span></button>

    <div class="sr-command" id="sr-command-panel" hidden>
      <button class="sr-command-scrim" data-command-close aria-label="Close power menu"></button>
      <div class="sr-command-card" role="dialog" aria-modal="true" aria-label="Power menu">
        <div class="sr-command-input">
          <span>⌕</span><input id="sr-command-input" placeholder="Jump, search, or act…" autocomplete="off" /><kbd>ESC</kbd>
        </div>
        <div id="sr-command-results"></div>
        <small class="sr-command-hint">↑↓ navigate · Enter run · Ctrl/⌘ K open anywhere</small>
      </div>
    </div>
  </div>

  <script type="application/json" id="sr-data" set:html={payload}></script>
  <script is:inline>
    (() => {
      const data = JSON.parse(document.getElementById('sr-data').textContent);
      const root = document.getElementById('super-reader');
      const dock = document.getElementById('sr-dock');
      const dockBody = document.getElementById('sr-dock-body');
      const dockTitle = document.getElementById('sr-dock-title');
      const sourceSearch = document.getElementById('sr-source-search');
      const layerSelect = document.getElementById('sr-layer');
      const state = { segment: 1, phraseId: data.phraseStudy.phrases[0]?.id || '', source: 'phrase', lang: 'both', theme: localStorage.getItem('ajew-super-theme') || 'paper', font: Number(localStorage.getItem('ajew-super-font') || 20), nikud: localStorage.getItem('ajew-super-nikud') === '1', phraseColors: localStorage.getItem('ajew-super-phrase-colors') !== '0', focus: localStorage.getItem('ajew-super-focus') === '1', query: '' };
      const sourceNames = { phrase: 'Phrase study', guide: 'Quick guide', pettek: 'Pettek Nanach Commentary', biur: 'Biur HaLikutim', parparos: 'Parparos LeChochma', nanach: 'Likutay Nanach', prayer: 'Likutay Tefilos', peer: 'Pe’er HaLikutim', notes: 'My notes', saved: 'Saved study' };
      const passages = [...document.querySelectorAll('.sr-passage')];
      const phrases = data.phraseStudy.phrases || [];

      function clean(value) { return String(value || '').replace(/\n{3,}/g, '\n\n').trim(); }
      function addParagraphs(container, value, lang) {
        clean(value).split(/\n\s*\n/).filter(Boolean).forEach(text => {
          const p = document.createElement('p'); p.textContent = text.replace(/\*\*/g, '');
          if (lang === 'he') { p.lang = 'he'; p.dir = 'rtl'; p.className = 'sr-source-he'; }
          else { p.lang = 'en'; p.className = 'sr-source-en'; }
          container.appendChild(p);
        });
      }
      function sourceHeader(title, subtitle) {
        const h = document.createElement('div'); h.className = 'sr-source-header';
        const strong = document.createElement('strong'); strong.textContent = title; h.appendChild(strong);
        if (subtitle) { const small = document.createElement('small'); small.textContent = subtitle; h.appendChild(small); }
        dockBody.appendChild(h);
      }
      function fullSource(source, title, subtitle) {
        sourceHeader(title, subtitle);
        (source.segments || []).forEach(seg => {
          const card = document.createElement('section'); card.className = 'sr-source-card';
          const badge = document.createElement('span'); badge.className = 'sr-source-index'; badge.textContent = seg.index; card.appendChild(badge);
          if (seg.he) addParagraphs(card, seg.he, 'he');
          if (seg.en) addParagraphs(card, seg.en, 'en');
          dockBody.appendChild(card);
        });
      }
      function renderNotes() {
        sourceHeader('My notes', `Private to this browser · Section ${state.segment}`);
        const area = document.createElement('textarea'); area.className = 'sr-notes'; area.placeholder = 'Capture a question, insight, or practical application…';
        const key = `ajew-super-note-lm-1-6-${state.segment}`; area.value = localStorage.getItem(key) || '';
        const status = document.createElement('small'); status.className = 'sr-note-status'; status.textContent = area.value ? 'Saved locally' : 'Autosaves locally';
        area.addEventListener('input', () => { localStorage.setItem(key, area.value); status.textContent = 'Saved'; });
        dockBody.append(area, status);
      }
      function renderSaved() {
        sourceHeader('Saved study', 'Bookmarks and notes private to this browser');
        let count = 0;
        data.torah.segments.forEach(seg => {
          const bookmark = localStorage.getItem(`ajew-super-bookmark-lm-1-6-${seg.index}`) === '1';
          const note = localStorage.getItem(`ajew-super-note-lm-1-6-${seg.index}`) || '';
          if (!bookmark && !note.trim()) return;
          count += 1;
          const button = document.createElement('button'); button.className = 'sr-saved-item';
          const title = document.createElement('strong'); title.textContent = `Section ${seg.index} · ${bookmark ? '♥ Bookmarked' : 'Note'}`;
          const excerpt = document.createElement('span'); excerpt.textContent = note.trim() || clean(seg.en).slice(0, 120);
          button.append(title, excerpt); button.addEventListener('click', () => selectSegment(seg.index, { scroll: true })); dockBody.appendChild(button);
        });
        if (!count) { const empty = document.createElement('p'); empty.className = 'sr-empty-state'; empty.textContent = 'Bookmark a section with ♡ or write a note; it will appear here.'; dockBody.appendChild(empty); }
      }
      function renderPhrase() {
        const phrase = phrases.find(item => item.id === state.phraseId) || phrases.find(item => Number(item.segment) === state.segment) || phrases[0];
        if (!phrase) return;
        sourceHeader('Phrase study', `${phrase.id} · Section ${phrase.segment} · editorial navigation aid`);
        const card = document.createElement('section'); card.className = 'sr-source-card sr-phrase-card';
        const he = document.createElement('blockquote'); he.className = 'sr-phrase-he'; he.lang = 'he'; he.dir = 'rtl'; he.textContent = phrase.he;
        const en = document.createElement('blockquote'); en.className = 'sr-phrase-en'; en.textContent = phrase.en;
        const infoLabel = document.createElement('small'); infoLabel.className = 'sr-phrase-label'; infoLabel.textContent = 'DIRECT EXPLANATION';
        const info = document.createElement('p'); info.className = 'sr-phrase-info'; info.textContent = phrase.info;
        const citation = document.createElement('p'); citation.className = 'sr-phrase-source'; citation.textContent = phrase.source;
        const notice = document.createElement('p'); notice.className = 'sr-scan-note'; notice.textContent = data.phraseStudy.status;
        const actions = document.createElement('div'); actions.className = 'sr-phrase-actions';
        [['guide','Section guide'],['pettek','Full commentary'],['prayer','Full prayer'],['peer','Pe’er facsimile']].forEach(([source,label]) => { const button = document.createElement('button'); button.textContent = label; button.addEventListener('click', () => setSource(source)); actions.appendChild(button); });
        card.append(he, en, infoLabel, info, citation, actions); dockBody.append(card, notice);
      }
      function renderPeer() {
        const related = data.peer.pages.filter(page => (page.relatedPassages || []).map(Number).includes(state.segment));
        const pages = related.length ? related : data.peer.pages.slice(0, 1);
        sourceHeader('פאר הליקוטים', `Authoritative facsimile · ${pages.length} related page${pages.length === 1 ? '' : 's'}`);
        const peerCredit = document.createElement('p'); peerCredit.className = 'sr-scan-note'; peerCredit.dir = 'rtl'; peerCredit.innerHTML = 'בביאורים המובאים נעזרנו בספר &quot;פאר הליקוטים&quot;, וכל הרוצה להכיר ספר זה יכול להיעזר בקישור המצורף: <a href="https://www.peer-halikutim.com/" target="_blank" rel="noopener">peer-halikutim.com</a>. התודה והברכה למכון &quot;פאר הליקוטים&quot;.'; dockBody.appendChild(peerCredit);
        const notice = document.createElement('p'); notice.className = 'sr-scan-note'; notice.textContent = data.peer.textNotice;
        const pdf = document.createElement('a'); pdf.className = 'sr-peer-pdf'; pdf.href = data.peer.pdf; pdf.target = '_blank'; pdf.rel = 'noopener'; pdf.textContent = 'Open Torah 6 facsimile PDF ↗';
        dockBody.append(notice, pdf);
        pages.forEach(page => {
          const figure = document.createElement('figure'); figure.className = 'sr-peer-page';
          const image = document.createElement('img'); image.src = page.image; image.loading = 'lazy'; image.alt = `Pe’er HaLikutim Torah 6, source page ${page.sourcePage}`;
          const caption = document.createElement('figcaption');
          const label = document.createElement('strong'); label.textContent = `Source page ${page.sourcePage}`;
          const detail = document.createElement('small'); detail.textContent = `Passages ${(page.relatedPassages || []).join(', ')} · scan is authoritative`;
          caption.append(label, detail); figure.append(image, caption); dockBody.appendChild(figure);
        });
      }
      function renderDock() {
        dockBody.replaceChildren(); sourceSearch.value = state.query;
        dockTitle.textContent = `Section ${state.segment} · ${sourceNames[state.source]}`;
        layerSelect.hidden = state.source !== 'pettek';
        sourceSearch.hidden = ['phrase','guide','pettek','peer','notes','saved'].includes(state.source);
        if (state.source === 'phrase') {
          renderPhrase();
        } else if (state.source === 'guide') {
          const studySeg = data.torah.segments.find(s => Number(s.index) === state.segment);
          const classicSegment = Number(studySeg?.classicSegment || state.segment);
          const guideSeg = data.pettek.segments.find(s => Number(s.relatedSegment || s.index) === classicSegment) || data.pettek.segments[0];
          const guide = guideSeg?.layers?.beginner || guideSeg?.layers?.intermediate || {};
          sourceHeader('Instant guide', `Pettek Nanach commentary · aligned to passage ${state.segment}`);
          const card = document.createElement('section'); card.className = 'sr-source-card sr-guide-card';
          addParagraphs(card, guide.he || guideSeg?.layers?.intermediate?.he, 'he'); addParagraphs(card, guide.en, 'en'); dockBody.appendChild(card);
        } else if (state.source === 'pettek') {
          const studySeg = data.torah.segments.find(s => Number(s.index) === state.segment);
          const classicSegment = Number(studySeg?.classicSegment || state.segment);
          const seg = data.pettek.segments.find(s => Number(s.relatedSegment || s.index) === classicSegment) || data.pettek.segments[0];
          const layer = seg?.layers?.[layerSelect.value] || {};
          sourceHeader('Pettek Nanach Commentary', `${layerSelect.options[layerSelect.selectedIndex].text} · synchronized`);
          const card = document.createElement('section'); card.className = 'sr-source-card';
          addParagraphs(card, layer.he, 'he'); addParagraphs(card, layer.en, 'en'); dockBody.appendChild(card);
        } else if (state.source === 'biur') fullSource(data.biur, 'ביאור הליקוטים', 'Hebrew · complete related section');
        else if (state.source === 'parparos') fullSource(data.parparos, 'פרפראות לחכמה', 'Complete authoritative bilingual Torah 6 section');
        else if (state.source === 'nanach') fullSource(data.likutayNanach, 'ליקוטי ננח', 'Torah 6 material · source indices 208–211, renumbered 1–4');
        else if (state.source === 'prayer') fullSource(data.prayer, 'ליקוטי תפילות · תורה ו', 'Full bilingual prayer source');
        else if (state.source === 'peer') renderPeer();
        else if (state.source === 'notes') renderNotes();
        else if (state.source === 'saved') renderSaved();
        decorateDockPhrases();
      }
      function selectPhrase(id, options = {}) {
        const phrase = phrases.find(item => item.id === id); if (!phrase) return;
        state.phraseId = phrase.id;
        if (state.segment !== Number(phrase.segment)) selectSegment(phrase.segment, { scroll: false, preservePhrase: true });
        document.querySelectorAll('[data-phrase]').forEach(button => button.classList.toggle('is-active', button.dataset.phrase === phrase.id));
        const index = phrases.findIndex(item => item.id === phrase.id);
        const pager = document.getElementById('sr-current-phrase');
        pager.querySelector('strong').textContent = phrase.he;
        pager.querySelector('span').textContent = `${index + 1} of ${phrases.length}`;
        document.getElementById('sr-prev-phrase').disabled = index <= 0;
        document.getElementById('sr-next-phrase').disabled = index >= phrases.length - 1;
        if (options.scroll) { state.ignoreObserverUntil = Date.now() + 1200; (document.querySelector(`[data-inline-phrase="${phrase.id}"]`) || document.getElementById(`sr-phrase-${phrase.id}`))?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        if (options.openDock) { setSource('phrase'); dock.classList.add('is-open'); } else if (state.source === 'phrase') renderDock();
        if (options.updateHash) history.replaceState(null, '', `#sr-phrase-${phrase.id}`);
      }
      function stepPhrase(delta) {
        const index = Math.max(0, phrases.findIndex(item => item.id === state.phraseId));
        const next = phrases[Math.min(phrases.length - 1, Math.max(0, index + delta))];
        if (next) selectPhrase(next.id, { scroll: true, openDock: state.source === 'phrase', updateHash: true });
      }
      function selectSegment(number, options = {}) {
        state.segment = Number(number);
        if (!options.preservePhrase) {
          const currentPhrase = phrases.find(item => item.id === state.phraseId);
          if (!currentPhrase || Number(currentPhrase.segment) !== state.segment) state.phraseId = phrases.find(item => Number(item.segment) === state.segment)?.id || state.phraseId;
        }
        if (options.scroll) state.ignoreObserverUntil = Date.now() + 1200;
        localStorage.setItem('ajew-super-last-segment-lm-1-6', state.segment);
        passages.forEach(p => p.classList.toggle('is-current', Number(p.dataset.segment) === state.segment));
        document.querySelectorAll('[data-jump]').forEach(b => b.classList.toggle('is-active', Number(b.dataset.jump) === state.segment));
        const pager = document.getElementById('sr-current-section');
        pager.querySelector('strong').textContent = `${state.segment} of ${data.torah.segments.length}`;
        pager.querySelector('span').textContent = document.querySelector(`[data-jump="${state.segment}"] .sr-step-label small`)?.textContent || '';
        document.getElementById('sr-prev-section').disabled = state.segment <= 1;
        document.getElementById('sr-next-section').disabled = state.segment >= data.torah.segments.length;
        const phrase = phrases.find(item => item.id === state.phraseId);
        if (phrase) {
          const phraseIndex = phrases.findIndex(item => item.id === phrase.id);
