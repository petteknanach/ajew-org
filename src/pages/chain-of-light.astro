import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

function loadJSON(filePath) {
  try {
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), filePath), 'utf8'));
  } catch (e) { return null; }
}

const chainData = loadJSON('public/chain-of-light.json') || { lmMetadata: { 'part-1': {}, 'part-2': {} }, connections: { 'part-1': {}, 'part-2': {} } };
const lmMeta = chainData.lmMetadata || { 'part-1': {}, 'part-2': {} };
const connections = chainData.connections || { 'part-1': {}, 'part-2': {} };

// Compute stats
let totalTorahsWithConnections = 0;
let totalConnections = 0;
let maxConnections = 0;
let maxConnectionsTorah = '';

for (const partKey of ['part-1', 'part-2']) {
  for (const [torahNum, data] of Object.entries(connections[partKey] || {})) {
    if (data.connections && data.connections.length > 0) {
      totalTorahsWithConnections++;
      totalConnections += data.connections.length;
      if (data.connections.length > maxConnections) {
        maxConnections = data.connections.length;
        const meta = lmMeta[partKey]?.[torahNum];
        maxConnectionsTorah = meta ? `${meta.hebrewTitle} (${partKey === 'part-1' ? 'Part 1' : 'Part 2'}, Torah ${torahNum})` : `Torah ${torahNum}`;
      }
    }
  }
}

// Prepare torah lists with connection counts for quick browse
const part1Torahs = [];
const part1Index = loadJSON('public/reader/likutay-moharan/part-1/index.json');
if (part1Index && part1Index.torahs) {
  for (const t of part1Index.torahs) {
    const conns = connections['part-1']?.[t.number]?.connections || [];
    part1Torahs.push({ number: t.number, title: t.hebrewTitle || t.title, connectionCount: conns.length });
  }
}

const part2Torahs = [];
const part2Index = loadJSON('public/reader/likutay-moharan/part-2/index.json');
if (part2Index && part2Index.torahs) {
  for (const t of part2Index.torahs) {
    const conns = connections['part-2']?.[t.number]?.connections || [];
    part2Torahs.push({ number: t.number, title: t.hebrewTitle || t.title, connectionCount: conns.length });
  }
}
---

<Layout title="Chain of Light - Trace Teachings Across All Breslov Books" description="Trace any Likutay Moharan teaching through all the Breslov sefarim. See how each torah flows into Likutay Halachos, Kitzur, Tefilos, Parparos LeChochma, Biur HaLikutim, and more." breadcrumbs={[{name: "Home", url: "https://ajew.org"}, {name: "Chain of Light", url: "https://ajew.org/chain-of-light"}]}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Chain of Light - שרשרת האור",
    "description": "Trace any Likutay Moharan teaching through all the Breslov sefarim.",
    "url": "https://ajew.org/chain-of-light",
    "isPartOf": { "@type": "WebSite", "name": "ajew.org", "url": "https://ajew.org" }
  })} slot="head" />

  <style>
    .col-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-family: 'Open Sans', sans-serif;
      color: #222;
    }

    /* Header */
    .col-header {
      text-align: center;
      margin-bottom: 36px;
      padding-bottom: 24px;
      border-bottom: 3px solid #1a365d;
    }
    .col-header .hebrew-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 2.8em;
      color: #1a365d;
      direction: rtl;
      margin: 0 0 4px;
      font-weight: 700;
    }
    .col-header h1 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.8em;
      color: #1a365d;
      margin: 0 0 8px;
    }
    .col-header .subtitle {
      color: #666;
      font-size: 0.95em;
      margin: 0;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Stats bar */
    .col-stats {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 20px 0 32px;
    }
    .col-stat {
      background: #f8f5ef;
      border: 1px solid #e8e2d6;
      border-radius: 12px;
      padding: 12px 20px;
      text-align: center;
      min-width: 120px;
    }
    .col-stat-num {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.8em;
      color: #1a365d;
      font-weight: 700;
      line-height: 1;
    }
    .col-stat-label {
      font-size: 0.78em;
      color: #888;
      margin-top: 4px;
    }

    /* Selector */
    .col-selector {
      background: #f8f5ef;
      border: 1px solid #e8e2d6;
      border-radius: 12px;
      padding: 20px 24px;
      margin-bottom: 28px;
    }
    .col-selector-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.2em;
      color: #1a365d;
      margin: 0 0 12px;
      font-weight: 700;
    }
    .col-selector-row {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }
    .col-selector select, .col-selector input {
      font-family: 'Open Sans', sans-serif;
      font-size: 0.95em;
      padding: 8px 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      background: white;
      color: #222;
    }
    .col-selector select {
      min-width: 140px;
    }
    .col-selector input[type="number"] {
      width: 100px;
    }
    .col-selector .col-go-btn {
      background: #1a365d;
      color: #e8d5a3;
      border: none;
      padding: 8px 24px;
      border-radius: 8px;
      font-size: 0.95em;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }
    .col-selector .col-go-btn:hover {
      background: #2a4a7d;
    }

    /* Quick browse */
    .col-browse {
      margin-bottom: 32px;
    }
    .col-browse-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.15em;
      color: #1a365d;
      margin: 0 0 6px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .col-browse-title .toggle-arrow {
      transition: transform 0.2s;
      font-size: 0.8em;
    }
    .col-browse-title.open .toggle-arrow {
      transform: rotate(90deg);
    }
    .col-browse-grid {
      display: none;
      flex-wrap: wrap;
      gap: 4px;
      list-style: none;
      padding: 8px 0 0;
      margin: 0;
    }
    .col-browse-grid.visible {
      display: flex;
    }
    .col-browse-grid a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #1a365d;
      text-decoration: none;
      font-size: 0.82em;
      padding: 4px 8px;
      border-radius: 4px;
      background: #f8f5ef;
      border: 1px solid #e8e2d6;
      min-width: 32px;
      text-align: center;
      transition: all 0.12s;
      position: relative;
    }
    .col-browse-grid a:hover {
      background: #1a365d;
      color: #e8d5a3;
      border-color: #1a365d;
    }
    .col-browse-grid a.has-connections {
      background: #eef2f7;
      border-color: #1a365d;
      font-weight: 600;
    }
    .col-browse-grid a.many-connections {
      background: #1a365d;
      color: #e8d5a3;
      font-weight: 700;
    }
    .col-browse-grid a .conn-dot {
      position: absolute;
      top: -3px;
      right: -3px;
      background: #c53030;
      color: white;
      border-radius: 50%;
      width: 14px;
      height: 14px;
      font-size: 0.6em;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
    }

    /* Part divider in quick browse */
    .col-part-label {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1em;
      color: #555;
      margin: 16px 0 4px;
      font-weight: 600;
      direction: rtl;
    }

    /* Chain display area */
    .col-chain-area {
      display: none;
    }
    .col-chain-area.visible {
      display: block;
    }

    /* Source card */
    .col-source {
      background: linear-gradient(135deg, #1a365d 0%, #2a4a7d 100%);
      border-radius: 14px;
      padding: 24px;
      color: white;
      margin-bottom: 16px;
    }
    .col-source-label {
      font-size: 0.75em;
      text-transform: uppercase;
      letter-spacing: 1.5px;
