-
interface Props &lbrace;
  title: string;
  description?: string;
  image?: string;
&rbrace;

const &lbrace; 
  title, 
  description = "Rabbi Nachman's Factory of Judaism - Nanach. Explore Rabbi Nachman's wisdom and inspiration.",
  image = "/og-image.svg"
&rbrace; = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
-

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content=&lbrace;description&rbrace; />
    <link rel="canonical" href=&lbrace;canonicalURL&rbrace; />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>&lbrace;title&rbrace; | A Jew</title>
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content=&lbrace;canonicalURL&rbrace; />
    <meta property="og:title" content=&lbrace;title&rbrace; />
    <meta property="og:description" content=&lbrace;description&rbrace; />
    <meta property="og:image" content=&lbrace;ogImage&rbrace; />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content=&lbrace;title&rbrace; />
    <meta name="twitter:description" content=&lbrace;description&rbrace; />
    <meta name="twitter:image" content=&lbrace;ogImage&rbrace; />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html=&lbrace;JSON.stringify(&lbrace;
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "A Jew - Na Nach Breslov",
      "url": "https://ajew.org",
      "description": "Teachings of Rebbe Nachman of Breslov and the Na Nach movement",
      "potentialAction": &lbrace;
        "@type": "SearchAction",
        "target": "https://ajew.org/teachings?q=&lbrace;search_term_string&rbrace;",
        "query-input": "required name=search_term_string"
      &rbrace;
    &rbrace;)&rbrace; />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-64VMMKHB30"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag()&lbrace;dataLayer.push(arguments);&rbrace;
      gtag('js', new Date());
      gtag('config', 'G-64VMMKHB30');
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">
          <span class="logo-text">A Jew</span>
        </a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/teachings">Teachings</a>
          <a href="/gallery">Gallery</a>
          <a href="/donate">Donate</a>
          <a href="/subscribe">Subscribe</a>
          <a href="/about">About</a>
        </div>
      </div>
    </nav>
    
    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <p>נ נח נחמ נחמן מאומן</p>
        <p>Na Nach Nachma Nachman Me'Uman</p>
        <p class="copyright">© &lbrace;new Date().getFullYear()&rbrace; ajew.org</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root &lbrace;
    --color-primary: #1a365d;
    --color-secondary: #2c5282;
    --color-accent: #ed8936;
    --color-bg: #fffdf7;
