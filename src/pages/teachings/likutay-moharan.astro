});
vol2ExternalHTML += '</div>';

// Quick jump anchors
const quickAnchors = [1, 15, 18, 22, 31, 50, 75, 100, 125, 150, 175, 200, 225, 250, 275, 286];
let quickJumpHTML = quickAnchors.map(n => `<a href="/teachings/likutay-moharan-volume-1-torah-${n}" style="padding: 0.25rem 0.5rem; background: white; border-radius: 4px; font-size: 0.75rem; color: #666; text-decoration: none; border: 1px solid #e2e8f0;">${n}</a>`).join('');

document.getElementById('vol1-sections').innerHTML = vol1HTML;
document.getElementById('vol2-internal-grid').innerHTML = vol2InternalHTML;
document.getElementById('quick-jump').innerHTML = quickJumpHTML;
document.getElementById('vol2-external-grid').innerHTML = vol2ExternalHTML;
</script>

