      const last = history[0];
      if (!last.url || !last.url.startsWith('/reader/')) return;
      document.getElementById('continueReading').style.display = 'block';
      document.getElementById('continueLink').href = last.url;
      document.getElementById('continueTitle').textContent = last.title;
      const pct = last.progress ? last.progress + '% read' : '';
      document.getElementById('continueProgress').textContent = pct;
    } catch(e) {}
  })();
