---
// LNCommentary.astro - Shows Likutay Nanach commentary links for a book
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  bookSlug: string;
  torahNum: number;
  partNum?: number;
}

const { bookSlug, torahNum, partNum } = Astro.props;

let commentaries: any[] = [];
try {
  const idxPath = path.join(process.cwd(), 'public/data/ln-commentaries.json');
  const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
  const bookData = idx[bookSlug];
  if (bookData) {
    const torahKey = partNum && partNum > 1 
      ? `tinyana-${torahNum}` 
      : String(torahNum);
    const direct = bookData[torahKey] || [];
    // Also check plain torahNum
    const plain = bookData[String(torahNum)] || [];
    commentaries = [...direct, ...plain];
  }
} catch (e) {
  // No commentaries available
}

if (commentaries.length === 0) return null;
---

<div class="ln-commentary-section" style="margin: 2rem 0; padding: 1.25rem; background: var(--reader-sidebar-bg, #f8f5ef); border-radius: 12px; border: 1px solid var(--reader-border, #e0d6c2); max-width: 800px;">
  <h3 style="margin: 0 0 0.75rem 0; color: var(--reader-accent, #1a365d); font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
    <span>📖</span>
    <span>ליקוטי נ נח — Commentary</span>
    <span style="font-size: 0.7em; color: #888; font-weight: normal;">({commentaries.length} chapter{commentaries.length > 1 ? 's' : ''})</span>
  </h3>
  <div style="display: flex; flex-direction: column; gap: 6px;">
    {commentaries.map(c => (
      <a href={c.url} 
         style="display: block; padding: 8px 12px; background: #fff; border-radius: 6px; text-decoration: none; border-right: 3px solid #a07830; color: #1a365d; font-size: 0.9em;">
        <span style="font-weight: 600;">{c.hebrewTitle || c.title}</span>
        {c.title !== c.hebrewTitle && (
          <span style="color: #888; font-size: 0.85em; margin-right: 8px;"> — {c.title}</span>
        )}
        <span style="float: left; color: #a07830; font-size: 0.8em;">נכ{String(c.ln_vol)}.{c.ln_ch}</span>
      </a>
    ))}
  </div>
  <p style="margin: 0.5rem 0 0 0; font-size: 0.75em; color: #999; text-align: left;">
    Likutay Nanach commentary — Hebrew only. 
    <a href="/reader/likutay-nanach" style="color: #a07830;">Full index →</a>
  </p>
</div>
