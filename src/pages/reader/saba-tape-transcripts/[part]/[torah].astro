    padding: .65rem .85rem;
    color: #173b67;
    font-size: .8rem;
    font-weight: 900;
    cursor: pointer;
  }
  .saba-segment-media[open] summary { border-bottom: 1px solid #e2d2ad; background: #fff2cf; }
  .saba-segment-media figure { max-width: 520px; margin: 1rem auto; padding: 0 .8rem; text-align: center; }
  .saba-segment-media img { display: block; width: 100%; height: auto; border-radius: 10px; box-shadow: 0 8px 25px rgba(20,42,68,.18); }
  .saba-segment-media figcaption { margin-top: .7rem; color: #6d604b; font-size: .76rem; line-height: 1.45; }

  /* Dark mode */
  [data-theme="night"] .saba-audio-player {
    background: linear-gradient(135deg, #1a1510 0%, #2a2015 100%);
    border-color: #4a3a25;
  }
