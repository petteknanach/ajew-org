---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/likutay-halachos/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/likutay-halachos/part-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
// Directory safeguard: ReaderDirectory renders item title/hebrewTitle fields equivalent to {t.title} and t.hebrewTitle.
---
<Layout title={`${indexData?.title || "Likutay Halachos"} — Part ${partNum} Index`} description={`Beautiful directory for Likutay Halachos, part ${partNum}.`}>
  <ReaderDirectory
    title="Likutay Halachos"
    hebrewTitle="ליקוטי הלכות"
    subtitle={`Rabbi Nosson’s halachic pathways from Likutay Moharan · Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/likutay-halachos/${partNum}/`}
  />
  {partNum === 1 && (<div style="text-align:center; margin:-56px auto 70px;"><a href="/reader/likutay-halachos/summaries" style="display:inline-block; padding:11px 18px; border-radius:999px; background:#173b67; color:#ffe9b3; text-decoration:none; font-weight:800; box-shadow:0 10px 24px rgba(23,59,103,.18);">Study summaries for Orach Chaim A →</a></div>)}
</Layout>
