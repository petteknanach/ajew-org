---
import AitzoasReadingArrival from '../../../../components/AitzoasReadingArrival.astro';
import {loadEdition} from '../../../../lib/qualified-aitzoas362.mjs';
import {projectionForPath} from '../../../../../public/qualified-aitzoas-topics.mjs';
import fs from 'node:fs';
import path from 'node:path';
export function getStaticPaths(){return Array.from({length:6},(_,i)=>({params:{part:'1',torah:String(i+1)}}));}
const {part,torah}=Astro.params;
if(part!=='1'||!/^[1-6]$/.test(torah??''))throw Error('Source route not found');
const edition=await loadEdition();
const view=projectionForPath(edition,Astro.url.pathname);
if(String(view.section)!==torah)throw Error('Source route parameter mismatch');
const index=JSON.parse(fs.readFileSync(path.join(process.cwd(),'public/reader/aitzoas-yeshuroas/index.json'),'utf8'));
---
<AitzoasReadingArrival edition={edition} ids={view.rows.map(r=>r.stableIndex)} index={index}/>
