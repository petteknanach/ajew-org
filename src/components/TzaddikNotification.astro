---
interface Props {
  tzaddik: {
    name: string;
    hebrew_name: string;
    yahrzeit_hebrew: string;
    year_passed?: string;
    notes: string;
    category: string;
  };
  isToday: boolean;
  isYesterday?: boolean;
}

const { tzaddik, isToday, isYesterday = false } = Astro.props;

// Generate a URL-friendly ID for the tzaddik
const tzaddikId = tzaddik.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const profileUrl = `/tzaddikim/${tzaddikId}`;

// Get category color
function getCategoryColor(category: string) {
  const colors: Record<string, string> = {
    'biblical': 'bg-yellow-100 text-yellow-800',
    'talmudic': 'bg-green-100 text-green-800',
    'rishonim': 'bg-blue-100 text-blue-800',
    'chassidic': 'bg-purple-100 text-purple-800',
    'breslov': 'bg-red-100 text-red-800',
    'chabad': 'bg-indigo-100 text-indigo-800',
    'sephardic': 'bg-orange-100 text-orange-800',
    'lithuanian': 'bg-gray-100 text-gray-800',
    'other': 'bg-gray-100 text-gray-800'
  };
  return colors[category] || colors.other;
}

// Get category label
function getCategoryLabel(category: string) {
  const labels: Record<string, string> = {
    'biblical': 'Biblical',
    'talmudic': 'Talmudic',
    'rishonim': 'Medieval',
    'chassidic': 'Chassidic',
    'breslov': 'Breslov',
    'chabad': 'Chabad',
    'sephardic': 'Sephardic',
    'lithuanian': 'Lithuanian',
    'other': 'Other'
  };
  return labels[category] || 'Tzaddik';
}
---

<div class="tzaddik-card bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-300">
  <div class="flex flex-col md:flex-row md:items-center justify-between">
    <!-- Tzaddik Info -->
    <div class="flex-1">
      <div class="flex items-start">
        <div class="flex-shrink-0 mr-4">
          <div class={`w-12 h-12 rounded-full flex items-center justify-center ${isToday ? 'bg-blue-50 border-2 border-blue-200' : 'bg-gray-50 border border-gray-200'}`}>
            <span class="text-lg font-semibold text-gray-700">
              {tzaddik.name.charAt(0)}
            </span>
          </div>
        </div>
        
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <a 
              href={profileUrl}
              class="text-xl font-semibold text-gray-900 hover:text-blue-600 transition-colors"
            >
              {tzaddik.name}
            </a>
            
            {tzaddik.hebrew_name && (
              <span class="text-lg font-medium text-gray-700" dir="rtl">
                {tzaddik.hebrew_name}
              </span>
            )}
            
            <span class={`px-2 py-1 text-xs font-medium rounded-full ${getCategoryColor(tzaddik.category)}`}>
              {getCategoryLabel(tzaddik.category)}
            </span>
          </div>
          
          <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
            {tzaddik.yahrzeit_hebrew && (
              <div class="flex items-center">
                <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="font-medium">{tzaddik.yahrzeit_hebrew}</span>
                {tzaddik.year_passed && (
                  <span class="ml-1">({tzaddik.year_passed})</span>
                )}
              </div>
            )}
            
            {isToday && (
              <div class="flex items-center px-2 py-1 bg-red-50 text-red-700 rounded text-xs font-medium">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                Today
              </div>
            )}
            
            {isYesterday && (
              <div class="flex items-center px-2 py-1 bg-amber-50 text-amber-700 rounded text-xs font-medium">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                Yesterday
              </div>
            )}
          </div>
          
          {tzaddik.notes && (
            <p class="mt-2 text-gray-600 text-sm">
              {tzaddik.notes}
            </p>
          )}
        </div>
      </div>
    </div>
    
    <!-- Action Button -->
    <div class="mt-4 md:mt-0 md:ml-4">
      <a 
        href={profileUrl}
        class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition-colors"
      >
        Learn More
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>