      column-count: 2;
      column-gap: 2rem;
    &rbrace;
  &rbrace;

  @media (min-width: 1200px) &lbrace;
    .book-content &lbrace;
      column-count: 3;
    &rbrace;
  &rbrace;

  .book-content::-webkit-scrollbar &lbrace;
    width: 8px;
  &rbrace;

  .book-content::-webkit-scrollbar-track &lbrace;
    background: #e2e8f0;
  &rbrace;

  .book-content::-webkit-scrollbar-thumb &lbrace;
    background: #cbd5e0;
    border-radius: 4px;
  &rbrace;

  .book-content::-webkit-scrollbar-thumb:hover &lbrace;
