---
import Layout from '../../../../layouts/Layout.astro';
import CommentarySidebar from '../../../../components/CommentarySidebar.astro';
import Comments from '../../../../components/Comments.astro';
import TeachingVideo from '../../../../components/TeachingVideo.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import commentaryRegistry from '../../../../data/lm-commentaries.json';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  // Generate paths for all torahs in both parts
  const paths = [];
  // Part 1 intro pages
  paths.push({ params: { part: '1', torah: 'haskamos' } });
  paths.push({ params: { part: '1', torah: 'intro' } });
  paths.push({ params: { part: '1', torah: 'intro-shimon' } });
  // Part 1 new intro pages (hakdama, intro-lm, intro-manuscripts)
  paths.push({ params: { part: '1', torah: 'hakdama' } });
  paths.push({ params: { part: '1', torah: 'intro-lm' } });
  paths.push({ params: { part: '1', torah: 'intro-manuscripts' } });
  // Part 1 preface sections (one per LM Vol 1 section group)
  for (let i = 1; i <= 297; i++) {
    paths.push({ params: { part: '1', torah: `preface-section-${i}` } });
  }
  // Part 1: 286 torahs (1-286, all present including 272)
  for (let torah = 1; torah <= 297; torah++) {
    paths.push({ params: { part: '1', torah: String(torah) } });
  }
  // Part 2 intro pages
  paths.push({ params: { part: '2', torah: 'intro' } });
  paths.push({ params: { part: '2', torah: 'omission' } });
  paths.push({ params: { part: '2', torah: 'intro-volume-2' } });
  // Part 2 (Tinyana): 125 torahs (1-125, all present including 51)
  for (let torah = 1; torah <= 297; torah++) {
    paths.push({ params: { part: '2', torah: String(torah) } });
  }
  // Part 2 manuscripts (Ksav Yad)
  for (let i = 1; i <= 297; i++) {
    paths.push({ params: { part: '2', torah: `manuscript-${i}` } });
  }
  return paths;
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahNum = parseInt(torah);
const isIntroPage = isNaN(torahNum);
const partRoman = partNum === 2 ? 'II' : 'I';
const torahReference = isIntroPage ? `Likutay Moharan Part ${partRoman}` : `Likutay Moharan ${partRoman}:${torahNum}`;

// Load the torah data
let torahData = null;
let error = null;

try {
  const fileName = isIntroPage ? `${torah}.json` : `torah-${torahNum}.json`;
  const filePath = path.join(process.cwd(), `public/reader/likutay-moharan/part-${partNum}/${fileName}`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);
} catch (e) {
  error = `Torah ${torah} not found`;
}

if (!torahData && !error) {
  error = 'Content not available';
}

// Defensive defaults for intro/preface JSONs that may lack these fields
if (torahData) {
  if (!torahData.navigation) {
    torahData.navigation = { prev: null, next: null, prevUrl: null, nextUrl: null };
  }
  if (!Array.isArray(torahData.segments)) {
    torahData.segments = [];
  }
  // Torahs with a Super Reader have a licensed sentence-level bilingual
  // witness. Use it for Both/Align mode instead of the shifted legacy pairs.
  if (partNum === 1 && [1, 2, 3, 4].includes(torahNum)) {
    const alignedPath = path.join(process.cwd(), `public/reader/super/likutay-moharan/1/${torahNum}/torah-study.json`);
    const alignedData = JSON.parse(fs.readFileSync(alignedPath, 'utf8'));
    torahData.aligned_segments = alignedData.segments;
  }
}

const hebrewNumerals: Record<string, number> = {
  'א':1,'ב':2,'ג':3,'ד':4,'ה':5,'ו':6,'ז':7,'ח':8,'ט':9,'י':10,
  'כ':20,'ך':20,'ל':30,'מ':40,'ם':40,'נ':50,'ן':50,'ס':60,'ע':70,
  'פ':80,'ף':80,'צ':90,'ץ':90,'ק':100,'ר':200,'ש':300,'ת':400
};
const sectionBySegment = new Map<any, number>();
let currentSection = 0;
for (const [position, seg] of (torahData?.segments || []).entries()) {
  const enMatch = String(seg.en || '').match(/^\s*(\d{1,3})\s*[.\-:)]/);
  const token = String(seg.he || '').trim().split(/\s+/, 1)[0]?.replace(/[״׳"']/g, '') || '';
  const heNumber = token.length <= 4 && [...token].every(ch => hebrewNumerals[ch])
    ? [...token].reduce((sum, ch) => sum + hebrewNumerals[ch], 0)
    : 0;
  const candidate = enMatch ? Number(enMatch[1]) : heNumber;
  if (candidate && ((currentSection === 0 && candidate === 1) || candidate === currentSection || candidate === currentSection + 1)) {
    currentSection = candidate;
  }
  sectionBySegment.set(seg.index ?? position + 1, currentSection || seg.index || position + 1);
}
const segmentCitation = (seg: any) => seg.sourceRef
  ? String(seg.sourceRef).replace(/^Likutei Moharan\s+/, '')
  : `${partRoman}:${torahNum}:${sectionBySegment.get(seg.index) || seg.index}`;

// SEO structured data
const structuredData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${torahReference} — ${torahData.title}`,
  "alternativeHeadline": torahData.hebrewTitle || '',
  "author": { "@type": "Person", "name": "Rabbi Nachman of Breslov" },
  "publisher": { "@type": "Organization", "name": "ajew.org" },
  "inLanguage": ["he", "en"],
  "genre": "Religious text",
  "isPartOf": {
    "@type": "Book",
    "name": "Likutay Moharan",
    "author": { "@type": "Person", "name": "Rabbi Nachman of Breslov" }
  },
  "keywords": torahData.themes?.join(', ') || 'Torah, Breslov, Rabbi Nachman',
  "url": `https://ajew.org/reader/likutay-moharan/${partNum}/${torahNum}`,
  "mainEntityOfPage": `https://ajew.org/reader/likutay-moharan/${partNum}/${torahNum}`
}) : '';
const breadcrumbData = torahData ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Library", "item": "https://ajew.org/reader" },
    { "@type": "ListItem", "position": 2, "name": "Likutay Moharan", "item": `https://ajew.org/reader#likutay-moharan` },
    { "@type": "ListItem", "position": 3, "name": torahData.hebrewTitle || torahData.title }
  ]
}) : '';

// Look up commentary registry entry for this torah (numeric + intro pages)
let commentaryEntry: any = null;
const partKey = String(partNum);
const torahKey = isIntroPage ? torah : String(torahNum);
const registry: any = commentaryRegistry as any;
if (registry && registry[partKey] && registry[partKey][torahKey]) {
  commentaryEntry = registry[partKey][torahKey];
}

const pageTitle = torahData
  ? `${torahReference} — ${torahData.hebrewTitle || torahData.title}`
  : 'Torah Not Found';
const pageDesc = torahData
  ? (() => {
    const snippet = (torahData.segments?.find(s => s.en)?.en || '').replace(/<[^>]+>/g, '').slice(0, 120);
    return `Read ${torahData.title} from Likutay Moharan online free. ${snippet ? snippet + '...' : 'Hebrew text with English translation on ajew.org.'}`;
  })()
  : '';
---

<Layout title={pageTitle} description={pageDesc}>
  {torahData && structuredData && (
    <script type="application/ld+json" set:html={structuredData} slot="head" />
  )}
  {torahData && breadcrumbData && (
    <script type="application/ld+json" set:html={breadcrumbData} slot="head" />
  )}
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div
      class="reader-container"
      data-torah-id={torahData.id}
      data-torah-title={`${torahReference} — ${torahData.title}`}
    >
      <!-- Progress Bar -->
      <div class="reader-progress"></div>

      <!-- Breadcrumb -->
      <div class="reader-breadcrumb">
        <a href="/reader">Reader</a>
        <span>&rsaquo;</span>
        <a href={`/reader/likutay-moharan/${partNum}`}>Likutay Moharan</a>
        <span>&rsaquo;</span>
        <a href={`/reader/likutay-moharan/${partNum}`}>Part {partNum}</a>
        <span>&rsaquo;</span>
        Torah {torahNum}
      </div>

      

      <!-- Toolbar -->
      {partNum === 1 && [1, 2, 3, 4].includes(torahNum) && (
        <a class="super-reader-launch" href={`/reader/super/likutay-moharan/1/${torahNum}`}>
          <span class="super-reader-launch-badge">NEW</span>
          <span><strong>Open Super Reader</strong><small>Aligned Hebrew–English · phrase study · commentaries · Pe’er HaLikutim</small></span>
          <b aria-hidden="true">→</b>
        </a>
      )}

<!-- Unified Audio Player -->
<div id="audio-controls" style="margin:0 auto 12px auto; max-width:700px; font-family:'Open Sans',sans-serif;">
  <div style="display:flex; gap:0; border-radius:8px; overflow:hidden; border:1px solid var(--reader-border,#ddd);">
    <button id="audio-btn-he" onclick="toggleAudio('he')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333);">
      🎧 Hebrew
    </button>
    <button id="audio-btn-en" onclick="toggleAudio('en')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333); border-left:1px solid var(--reader-border,#ddd);">
      🔊 English
    </button>
  </div>
  
  <!-- Hidden data element for book/part/torah -->
  <div id="en-tts-player" data-book="likutay-moharan" data-part={partNum} data-torah={torahNum} style="display:none;"></div>
  
  <div id="audio-panel-he" style="display:none; background:var(--reader-bg-secondary,#f8f5f0); 
    border:1px solid var(--reader-border,#ddd); border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <audio id="kol-hatzadik-audio" controls preload="none" style="width:100%; border-radius:4px;"></audio>
    <div id="kol-hatzadik-note" style="font-size:0.8em; color:var(--reader-text-secondary,#888); margin-top:4px;"></div>
  </div>
  
  <div id="audio-panel-en" style="display:none; background:#1a3a1a; 
    border:1px solid #2d5a2d; border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
      <span style="font-size:1em;">🔊</span>
      <strong style="color:#7fff7f; font-size:0.85em;">English Audio</strong>
      <div style="margin-left:auto; display:flex; gap:4px;">
        <button id="en-btn-ryan" onclick="enSetVoice('ryan')" 
          style="background:#7fff7f20; border:2px solid #7fff7f; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇬🇧</button>
        <button id="en-btn-guy" onclick="enSetVoice('guy')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇺🇸</button>
        <button id="en-btn-connor" onclick="enSetVoice('connor')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇮🇪</button>
      </div>
    </div>
    <button id="en-btn-play" onclick="enTogglePlay()" 
      style="background:#2d8a2d; color:#fff; border:none; border-radius:4px; padding:6px 16px; 
      cursor:pointer; font-size:0.9em; font-weight:bold; width:100%;">▶ Play English</button>
    <div id="en-progress" style="margin-top:4px; height:3px; background:#2d5a2d; border-radius:2px; 
      overflow:hidden; display:none;">
      <div id="en-progress-bar" style="height:100%; width:0%; background:#7fff7f;"></div>
    </div>
  </div>
</div>
<script src="/unified-audio.js" defer></script>

      <div class="reader-toolbar">
        <div class="reader-toolbar-group">
          <button class="reader-btn active" data-mode="both">Both</button>
          <button class="reader-btn" data-mode="hebrew">Hebrew</button>
          <button class="reader-btn" data-mode="english">English</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn" id="btn-nikud">Nikud</button>
        </div>
        <div class="reader-toolbar-group">
          <span style="font-size:0.7em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
          <input type="range" id="font-size-slider" class="font-size-slider" min="12" max="32" value="18" />
          <span style="font-size:0.9em; font-family: 'Open Sans', sans-serif; color: var(--reader-text-secondary);">A</span>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" data-theme-btn="day" title="Day mode">Day</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="sepia" title="Sepia mode">Sepia</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="night" title="Night mode">Night</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" id="btn-align" title="Sentence-by-sentence aligned view">Align</button>
          <button class="reader-btn reader-btn-icon" id="btn-listen">Listen</button>
          <button class="reader-btn reader-btn-icon" id="btn-search" title="Search (Ctrl+F)">Search</button>
          <button class="reader-btn reader-btn-icon" id="btn-bookmark" title="Bookmark (S)">Bookmark</button>
          <button class="reader-btn reader-btn-icon" id="btn-notes">Notes</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen" title="Fullscreen (F)">Fullscreen</button>
        </div>
      </div>

      <!-- In-text Search Bar -->
      <div class="reader-search-bar">
        <input type="text" placeholder="Search in this teaching..." dir="auto" />
        <span class="search-info"></span>
        <button class="reader-btn search-close">Close</button>
      </div>

      <!-- TOC Toggle Button -->
      <button class="reader-toc-toggle" title="Table of Contents (T)">&#9776;</button>

      <!-- Floating TOC Sidebar -->
      <div class="reader-toc">
        <button class="reader-toc-close">&times;</button>
        <h3>Paragraphs</h3>
        <ul class="reader-toc-list">
          {torahData.segments.map((seg, i) => (
            <li>
              <a href={`#seg-${seg.index}`} data-index={String(seg.index)}>
                {isIntroPage ? `Paragraph ${seg.index}` : segmentCitation(seg)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Header -->
      <div class="reader-header">
        {torahData.hebrewTitle && (
          <div class="hebrew-title" lang="he" dir="rtl">{torahData.hebrewTitle}</div>
        )}
        <h1>{torahReference} — {torahData.title}</h1>
        {torahData.keyVerse && (
          <div class="key-verse">{torahData.keyVerse}</div>
        )}
        {torahData.keyVerseTranslation && (
          <div class="key-verse-translation">{torahData.keyVerseTranslation}</div>
        )}
        {torahData.themes && torahData.themes.length > 0 && (
          <div class="themes">
            {torahData.themes.map(theme => (
              <span class="theme-tag">{theme}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Top Navigation -->
      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous</a>
        ) : (
          <span class="disabled">&larr; Previous</span>
        )}
        <a href={`/reader/likutay-moharan/${partNum}`}>Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next &rarr;</a>
        ) : (
          <span class="disabled">Next &rarr;</span>
        )}
      </div>

      <!-- Content -->
      <div class="reader-content mode-hebrew">
        <div class="reader-content-original">
{torahData.segments.map((seg) => (
          <div class="reader-segment-pair" id={`seg-${seg.index}`}>
            <div class="reader-segment segment-he" lang="he" dir="rtl" data-index={String(seg.index)}>
              <span class="segment-number" title="Source location">{isIntroPage ? seg.index : segmentCitation(seg)}</span>
              <p data-nikud={seg.he_nikud || seg.he}>{seg.he}</p>
            </div>
            <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
              <span class="segment-number" title="Source location">{isIntroPage ? seg.index : segmentCitation(seg)}</span>
              <p>{seg.en || 'Translation not yet available'}</p>
            </div>
          </div>
        ))}
        </div>
        {torahData.aligned_segments && (
          <div class="reader-content-aligned" style="display:none;">
            <div id="aligned-segments-data" hidden></div>
            {torahData.aligned_segments.map((seg) => (
              <div class={`reader-segment-pair ${seg.type === 'note' ? 'segment-note' : ''}`} id={`aligned-${seg.index}`}>
                <div class="reader-segment segment-he" lang="he" dir="rtl" data-index={String(seg.index)}>
                  <span class="segment-number" title="Source location">{isIntroPage ? seg.index : segmentCitation(seg)}</span>
                  <p data-nikud={seg.he_nikud || seg.he}>{seg.he || '\u00A0'}</p>
                </div>
                <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
                  <span class="segment-number" title="Source location">{isIntroPage ? seg.index : segmentCitation(seg)}</span>
                  <p>{seg.en || '\u00A0'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {partNum === 2 && torahNum === 46 && (
        <TeachingVideo
          title="The Walls Are Only an Illusion"
          hebrewTitle="אין שום חומה"
          src="/videos/likutay-moharan-tinyana-46-walls-are-an-illusion-english-subtitles.mp4"
          poster="/images/videos/likutay-moharan-tinyana-46-walls-are-an-illusion-poster.jpg"
          description="An animated Hebrew adaptation of the Baal Shem Tov's parable cited by Rabbi Nachman: the walls surrounding the king's treasure are only an illusion, and the essential thing is a strong and courageous heart. Burned-in English subtitles."
          citation="Likutay Moharan II, Torah 46 (Baal Shem Tov parable; adapted presentation)"
          sourceName="רבי נחמן מברסלב"
          sourceHandle="@rabbi_nachman30"
          sourceUrl="https://www.instagram.com/reel/DbDWPzBNMEF/?igsh=MWoyZXcxeGhydW5idg=="
        />
      )}

      <!-- Bottom Navigation -->
      <div class="reader-nav">
        {torahData.navigation.prevUrl ? (
          <a href={torahData.navigation.prevUrl} data-dir="prev">&larr; Previous</a>
        ) : (
          <span class="disabled">&larr; Previous</span>
        )}
        <a href={`/reader/likutay-moharan/${partNum}`}>Book Index</a>
        <a href="/reader">All Books</a>
        {torahData.navigation.nextUrl ? (
          <a href={torahData.navigation.nextUrl} data-dir="next">Next &rarr;</a>
        ) : (
          <span class="disabled">Next &rarr;</span>
        )}
      </div>

      <!-- Keyboard Shortcuts Overlay -->
      <div class="reader-shortcuts-overlay">
        <div class="reader-shortcuts-panel">
          <h2>Keyboard Shortcuts</h2>
          <div class="shortcut-row"><span>Hebrew mode</span><span class="shortcut-key">H</span></div>
          <div class="shortcut-row"><span>English mode</span><span class="shortcut-key">E</span></div>
          <div class="shortcut-row"><span>Both columns</span><span class="shortcut-key">B</span></div>
          <div class="shortcut-row"><span>Sentence-aligned view</span><span class="shortcut-key">A</span></div>
          <div class="shortcut-row"><span>Toggle nikud</span><span class="shortcut-key">N</span></div>
          <div class="shortcut-row"><span>Fullscreen</span><span class="shortcut-key">F</span></div>
          <div class="shortcut-row"><span>Table of contents</span><span class="shortcut-key">T</span></div>
          <div class="shortcut-row"><span>Search in text</span><span class="shortcut-key">Ctrl+F</span></div>
          <div class="shortcut-row"><span>Save bookmark</span><span class="shortcut-key">S</span></div>
          <div class="shortcut-row"><span>Listen / Pause</span><span class="shortcut-key">L</span></div>
          <div class="shortcut-row"><span>Print</span><span class="shortcut-key">P</span></div>
          <div class="shortcut-row"><span>Next segment</span><span class="shortcut-key">J / ↓</span></div>
          <div class="shortcut-row"><span>Prev segment</span><span class="shortcut-key">K / ↑</span></div>
          <div class="shortcut-row"><span>Toggle favorite</span><span class="shortcut-key">G</span></div>
          <div class="shortcut-row"><span>Increase font</span><span class="shortcut-key">+</span></div>
          <div class="shortcut-row"><span>Decrease font</span><span class="shortcut-key">-</span></div>
          <div class="shortcut-row"><span>Previous torah</span><span class="shortcut-key">&larr;</span></div>
          <div class="shortcut-row"><span>Next torah</span><span class="shortcut-key">&rarr;</span></div>
          <div class="shortcut-row"><span>Show shortcuts</span><span class="shortcut-key">?</span></div>
          <div class="shortcut-row"><span>Close / Exit</span><span class="shortcut-key">Esc</span></div>
          <br />
          <button class="reader-btn" onclick="this.closest('.reader-shortcuts-overlay').classList.remove('open')">Close</button>
        </div>
      </div>

      <!-- Reader Script -->
      <script src="/reader-script.js?v=6-search-deeplink" defer></script>
      <script src="/reader-v2.js?v=5" defer></script>
      <script src="/tts-fix.js" defer></script>
      <script src="/pwa-register.js" defer></script>
      <script src="/reader-notes.js" is:inline></script>

      {!isIntroPage && (
        <Comments
          teachingId={`lm-${partNum}-${torahNum}`}
          teachingTitle={`Likutey Moharan ${partNum}:${torahData.displayNumber || torahNum} — ${torahData.title || ''}`}
        />
      )}
    </div>
  )}
  {torahData && commentaryEntry && (
    <CommentarySidebar part={partNum} torah={torahNum} entry={commentaryEntry} />
  )}
</Layout>

<style>
  .super-reader-launch {
    max-width: 700px;
    margin: 0 auto 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    color: #fff;
    text-decoration: none;
    border-radius: 11px;
    background: linear-gradient(115deg, #6f2f24, #a55c3e);
    box-shadow: 0 8px 22px rgba(80, 35, 25, .2);
    font-family: 'Open Sans', sans-serif;
