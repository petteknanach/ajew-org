---
import Layout from '../layouts/Layout.astro';
import SimpleSearch from '../components/SimpleSearch.astro';
---

<Layout 
  title="Search | ajew.org" 
  description="Search across Breslov books with book selection checklists. Simple, working search."
>
  <div class="search-page">
    <header class="page-header">
      <h1>חיפוש מתקדם</h1>
      <p class="subtitle">Advanced Search Across All Works</p>
      <p class="stats">9 books • 411 teachings • 420 total documents</p>
    </header>

    <div class="container">
      <!-- Simple Search Component -->
      <SimpleSearch />
      
      <div class="search-info">
        <div class="info-item">
          <span class="info-icon">✅</span>
          <span>Simple & working</span>
        </div>
        <div class="info-item">
          <span class="info-icon">📚</span>
          <span>Select specific books</span>
        </div>
        <div class="info-item">
          <span class="info-icon">🔍</span>
          <span>Fast client-side search</span>
        </div>
      </div>
      
      <div class="coming-soon">
        <h3>Coming Soon: Torat Emet-Style Advanced Search</h3>
        <p>We're rebuilding the advanced search system with all the features you requested:</p>
        <ul>
          <li>✅ Book selection checkboxes</li>
          <li>✅ Search type options (Exact/Contains/Starts with/Ends with)</li>
          <li>✅ Hebrew-specific options (missing letters/כתיב חסר)</li>
          <li>✅ Word count minimum (at least 1/2/3 words)</li>
          <li>✅ Boolean operators (AND/OR/NOT)</li>
          <li>✅ Proximity search (words within X words)</li>
        </ul>
        <p>This simple search provides basic functionality while we complete the advanced system.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .search-page {
    min-height: 80vh;
    padding: 2rem 1rem;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .page-header h1 {
    font-size: 2.5rem;
    margin: 0;
    color: #333;
  }
  
  .subtitle {
    font-size: 1.2rem;
    color: #666;
    margin: 0.5rem 0;
  }
  
  .stats {
    font-size: 1rem;
    color: #888;
    margin: 0.5rem 0;
  }
  
  .container {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .search-info {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin: 2rem 0;
    flex-wrap: wrap;
  }
  
  .info-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #555;
  }
  
  .info-icon {
    font-size: 1.2rem;
  }
  
  .coming-soon {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #f0f9ff;
    border-radius: 12px;
    border-left: 4px solid #3b82f6;
  }
  
  .coming-soon h3 {
    margin-top: 0;
    color: #1e40af;
  }
  
  .coming-soon ul {
    padding-left: 1.5rem;
  }
  
  .coming-soon li {
    margin-bottom: 0.5rem;
  }
</style>