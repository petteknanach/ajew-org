<style>
  .videos-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    font-family: 'Open Sans', sans-serif;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 3px solid #1a365d;
  }

  .header-hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 2.4em;
    color: #1a365d;
    direction: rtl;
  }

  .page-header h1 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.6em;
    color: #1a365d;
    margin: 4px 0;
  }

  .subtitle { color: #666; font-size: 0.95em; }

  .featured-teaching-videos {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e0d6c2;
  }

  .featured-teaching-videos > h2 {
    text-align: center;
    color: #1a365d;
    font-family: 'Frank Ruhl Libre', serif;
  }

  .featured-teaching-videos > h2 span {
    display: inline-block;
    margin-inline-start: 8px;
  }

  .teaching-link { text-align: center; margin: 10px 0 0; }
  .teaching-link a { color: #1a365d; font-weight: 700; }

  .video-section {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e0d6c2;
  }

  .video-section:last-child { border-bottom: none; }

  .video-section h2 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.4em;
    color: #1a365d;
    margin: 0 0 8px;
  }

  .section-desc { color: #666; font-size: 0.9em; margin: 0 0 16px; }

  .video-embed {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    margin-bottom: 12px;
  }

  .video-embed iframe {
    display: block;
    min-height: 300px;
  }

  .channel-link {
    display: inline-block;
    color: #1a365d;
    font-weight: 600;
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid #1a365d;
    border-radius: 6px;
    transition: all 0.2s;
    margin-top: 8px;
  }

  .channel-link:hover {
    background: #1a365d;
    color: white;
  }

  .channel-link.large {
    font-size: 1.2em;
    padding: 12px 24px;
  }

  @media (max-width: 768px) {
    .video-embed iframe { min-height: 200px; height: 300px !important; }
  }
</style>
</Layout>
