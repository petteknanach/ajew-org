---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read parsha connections data at build time
const dataPath = path.join(process.cwd(), 'public', 'data', 'parsha-connections.json');
let parshaData = { parshas: {} };
try {
  parshaData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
} catch (e) {
  console.warn('parsha-connections.json not found, run build-parsha-connections.cjs first');
}

const parshas = parshaData.parshas;

// Group by chumash
const chumashim = [
  { id: 'bereishit', he: 'בראשית', en: 'Beraishis / Genesis' },
  { id: 'shemos', he: 'שמות', en: 'Shemos / Exodus' },
  { id: 'vayikra', he: 'ויקרא', en: 'Vayikra / Leviticus' },
  { id: 'bamidbar', he: 'במדבר', en: 'Bamidbar / Numbers' },
  { id: 'devarim', he: 'דברים', en: 'Devarim / Deuteronomy' },
];

const parshasByChumash = {};
for (const c of chumashim) {
  parshasByChumash[c.id] = [];
}
for (const [slug, data] of Object.entries(parshas)) {
  if (parshasByChumash[data.chumash]) {
    parshasByChumash[data.chumash].push({ slug, ...data });
  }
}

// Slug-to-English map for Hebcal matching
const slugMap = {};
for (const [slug, data] of Object.entries(parshas)) {
  slugMap[data.en] = slug;
}

const totalConnections = Object.values(parshas).reduce((s, p) => s + (p.totalConnections || 0), 0);
---

<Layout title="Breslov Teachings on the Parsha" description={`Discover Breslov teachings connected to each weekly Torah portion. ${totalConnections} connections across all 54 parshas.`}>
  <section class="parsha-page">
    <div class="container">
      <div class="page-header">
        <h1 class="hebrew-title">פרשת השבוע</h1>
        <h1>Breslov Teachings on the Parsha</h1>
        <p class="subtitle">Discover what the Breslov masters teach about each weekly Torah portion</p>
        <p class="stats">{totalConnections.toLocaleString()} teaching connections across all 54 parshas</p>
      </div>

      <!-- This week's parsha (loaded client-side) -->
      <div id="thisWeek" class="this-week-section" style="display:none;">
        <div class="this-week-card">
          <span class="this-week-badge">This Week</span>
          <div class="this-week-name">
            <span class="tw-he" id="twHe"></span>
            <span class="tw-en" id="twEn"></span>
          </div>
          <div class="this-week-meta">
            <span id="twRef"></span>
            <span id="twCount"></span>
          </div>
          <div class="this-week-actions">
            <a id="twLink" href="#" class="tw-btn">View Teachings</a>
            <a id="twRead" href="#" class="tw-btn tw-btn-alt">Read the Parsha</a>
          </div>
        </div>
      </div>

      <!-- All parshas by chumash -->
      {chumashim.map(chumash => (
        <div class="chumash-section">
          <div class="chumash-header">
            <span class="chumash-he">{chumash.he}</span>
            <span class="chumash-en">{chumash.en}</span>
          </div>
          <div class="parsha-grid">
            {parshasByChumash[chumash.id].map(p => (
              <a href={`/parsha/${p.slug}`} class="parsha-item" data-slug={p.slug}>
                <span class="pi-he">{p.he}</span>
                <span class="pi-en">{p.en}</span>
                <span class="pi-count">{p.totalConnections} teachings</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
  // Hebcal name -> slug mapping
  const SLUG_MAP = JSON.parse(document.querySelector('[data-slugmap]')?.textContent || '{}');

  // Name normalization for Hebcal -> our slugs
  const NAME_TO_SLUG = {
    'Bereishit': 'bereishit', 'Noach': 'noach', 'Lech-Lecha': 'lech-lecha',
    'Vayera': 'vayeira', 'Vayeira': 'vayeira', 'Chayei Sara': 'chayei-sarah',
    'Chayei Sarah': 'chayei-sarah', 'Toldot': 'toldot', 'Vayetzei': 'vayeitzei',
    'Vayeitzei': 'vayeitzei', 'Vayishlach': 'vayishlach', 'Vayeshev': 'vayeishev',
    'Vayeishev': 'vayeishev', 'Miketz': 'mikeitz', 'Mikeitz': 'mikeitz',
    'Vayigash': 'vayigash', 'Vayechi': 'vayechi',
    'Shemot': 'shemot', "Va'eira": 'vaeira', 'Vaera': 'vaeira', 'Bo': 'bo',
    'Beshalach': 'beshalach', 'Yitro': 'yitro', 'Mishpatim': 'mishpatim',
    'Terumah': 'terumah', 'Tetzaveh': 'tetzaveh', 'Ki Tisa': 'ki-tisa',
    'Ki Tissa': 'ki-tisa', 'Vayakhel': 'vayakhel', 'Pekudei': 'pekudei',
    'Vayikra': 'vayikra', 'Tzav': 'tzav', 'Shmini': 'shemini', 'Shemini': 'shemini',
    'Tazria': 'tazria', 'Metzora': 'metzora', 'Achrei Mot': 'acharei-mot',
    'Acharei Mot': 'acharei-mot', 'Kedoshim': 'kedoshim', 'Emor': 'emor',
    'Behar': 'behar', 'Bechukotai': 'bechukotai',
    'Bamidbar': 'bamidbar', 'Nasso': 'naso', 'Naso': 'naso',
    "Beha'alotcha": 'behaalotcha', "Sh'lach": 'shelach', 'Shelach': 'shelach',
    'Korach': 'korach', 'Chukat': 'chukat', 'Balak': 'balak',
    'Pinchas': 'pinchas', 'Matot': 'matot', 'Masei': 'masei',
    'Devarim': 'devarim', "Va'etchanan": 'vaetchanan', 'Vaetchanan': 'vaetchanan',
    'Eikev': 'eikev', "Re'eh": 'reeh', 'Shoftim': 'shoftim',
    'Ki Teitzei': 'ki-teitzei', 'Ki Tetze': 'ki-teitzei',
    'Ki Tavo': 'ki-tavo', 'Nitzavim': 'nitzavim', 'Vayeilech': 'vayeilech',
    "Ha'azinu": 'haazinu', 'Haazinu': 'haazinu',
    "V'Zot HaBerachah": 'vezot-haberacha', "Vezot Haberacha": 'vezot-haberacha',
  };

  async function loadThisWeek() {
    try {
      const today = new Date();
      const dateStr = today.toISOString().split('T')[0];
      const res = await fetch(`https://www.hebcal.com/shabbat?cfg=json&geo=none&M=on&date=${dateStr}`);
      const data = await res.json();
      const parshaItem = data.items?.find(i => i.category === 'parashat');
      if (!parshaItem) return;

      const rawName = parshaItem.title.replace('Parashat ', '');
      // Handle double parshas: "Matot-Masei" -> take first
      const names = rawName.split('-').map(n => n.trim());
      const slug = NAME_TO_SLUG[rawName] || NAME_TO_SLUG[names[0]] || rawName.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '');

      const el = document.querySelector(`[data-slug="${slug}"]`);
      if (el) el.classList.add('this-week');

      // Also handle double parshas - highlight both
      if (names.length > 1) {
        const slug2 = NAME_TO_SLUG[names[1]];
        if (slug2) {
          const el2 = document.querySelector(`[data-slug="${slug2}"]`);
          if (el2) el2.classList.add('this-week');
        }
      }

      // Show this week card
      const section = document.getElementById('thisWeek');
      const item = el || document.querySelector('.parsha-item');
      if (!item) return;

      document.getElementById('twHe').textContent = item.querySelector('.pi-he').textContent;
      document.getElementById('twEn').textContent = 'Parashat ' + rawName;
      document.getElementById('twRef').textContent = '';
      document.getElementById('twCount').textContent = item.querySelector('.pi-count').textContent;
      document.getElementById('twLink').href = '/parsha/' + slug;
      // Read link
      const readSlug = slug === 'bereishit' ? 'tanach-bereishit' : 'tanach-' + (slug.split('-')[0] === 'ki' || slug.split('-')[0] === 'chayei' || slug.split('-')[0] === 'lech' || slug.split('-')[0] === 'acharei' || slug.split('-')[0] === 'vezot' ? '' : '');
      document.getElementById('twRead').href = '/parsha/' + slug;
      section.style.display = 'block';
    } catch (e) { /* silently fail */ }
  }
  loadThisWeek();
  </script>

  <style>
    .parsha-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-family: 'Open Sans', sans-serif;
    }
    .page-header { text-align: center; margin-bottom: 32px; }
    .hebrew-title { font-family: 'Frank Ruhl Libre', serif; font-size: 2.5em; color: #1a365d; direction: rtl; margin: 0; }
    .page-header h1 { font-family: 'Frank Ruhl Libre', serif; color: #1a365d; font-size: 1.5em; margin: 0 0 8px; }
    .subtitle { color: #666; margin: 0 0 4px; }
    .stats { color: #999; font-size: 0.85em; margin: 0; }

    /* This week card */
    .this-week-section { margin-bottom: 32px; }
    .this-week-card {
      background: linear-gradient(135deg, #1a365d, #2c5282);
      color: white;
      padding: 28px;
      border-radius: 16px;
      text-align: center;
      position: relative;
    }
    .this-week-badge {
      position: absolute;
      top: 12px;
      right: 16px;
      background: #d69e2e;
      color: #1a365d;
      padding: 3px 12px;
      border-radius: 12px;
      font-size: 0.75em;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .tw-he { font-family: 'Frank Ruhl Libre', serif; font-size: 2.5em; display: block; margin-bottom: 4px; }
    .tw-en { font-size: 1.1em; display: block; opacity: 0.9; margin-bottom: 8px; }
    .this-week-meta { font-size: 0.85em; opacity: 0.7; margin-bottom: 16px; }
    .this-week-meta span + span::before { content: ' \2022 '; }
    .this-week-actions { display: flex; gap: 12px; justify-content: center; }
    .tw-btn {
      padding: 10px 24px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95em;
      background: white;
      color: #1a365d;
    }
    .tw-btn-alt { background: rgba(255,255,255,0.15); color: white; }

    /* Chumash sections */
    .chumash-section { margin-bottom: 28px; }
    .chumash-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 2px solid #e0d6c2;
    }
    .chumash-he {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.5em;
      color: #1a365d;
      font-weight: 700;
      direction: rtl;
    }
    .chumash-en { color: #666; font-size: 0.95em; }

    /* Parsha grid */
    .parsha-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
    }
    .parsha-item {
      display: flex;
      flex-direction: column;
      padding: 14px 16px;
      background: #f8f5ef;
      border: 1px solid #e0d6c2;
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .parsha-item:hover {
      background: #f0ebe0;
      border-color: #1a365d;
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(26,54,93,0.1);
    }
    .parsha-item.this-week {
      border-color: #d69e2e;
      background: #fffbeb;
      box-shadow: 0 0 0 2px rgba(214,158,46,0.3);
    }
    .pi-he {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.4em;
      color: #1a365d;
      font-weight: 700;
      direction: rtl;
      text-align: right;
    }
    .pi-en {
      color: #4a5568;
      font-size: 0.85em;
      margin-top: 2px;
    }
    .pi-count {
      color: #999;
      font-size: 0.75em;
      margin-top: 6px;
    }

    @media (max-width: 600px) {
      .parsha-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .parsha-item { padding: 10px 12px; }
      .pi-he { font-size: 1.2em; }
      .hebrew-title { font-size: 2em; }
      .this-week-actions { flex-direction: column; }
      .tw-he { font-size: 2em; }
    }
  </style>
</Layout>
