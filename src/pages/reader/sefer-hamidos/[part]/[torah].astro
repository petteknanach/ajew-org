          .sh-overview-open{aspect-ratio:1/1;}
          .sh-gallery-panel{inset:0;min-height:100dvh;padding:env(safe-area-inset-top) .45rem env(safe-area-inset-bottom);box-sizing:border-box;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) auto auto auto;gap:8px;}
