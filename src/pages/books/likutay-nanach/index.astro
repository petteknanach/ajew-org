---
import Layout from '../../../layouts/Layout.astro';
import { getVolumes } from './data.js';

const volumes = getVolumes();
---

<Layout title="Likutay Nanach" description="לקוטי ננח - אוסף תורות, שיחות והנהגות מגדולי חסידי ברסלב">
  <div class="book-page">
    <header class="book-header">
      <h1>Likutay Nanach</h1>
      <h2>לקוטי ננח</h2>
      <p class="subtitle">אוסף תורות, שיחות והנהגות מגדולי חסידי ברסלב</p>
    </header>

    <div class="intro-section">
      <p><strong>לקוטי ננח</strong> הוא אוסף של תורות, שיחות והנהגות מגדולי חסידי ברסלב, בעיקר סביב עניין ה"ננח" - נא נח נחמ נחמן מאומן.</p>
      <p>הספר כולל דברי תורה, סיפורים, והנהגות הקשורות לדרך המיוחדת של נא נח נחמ נחמן מאומן.</p>
      <p class="quote">"נא נח נחמ נחמן מאומן"</p>
    </div>

    <div class="volumes-grid">
      {volumes.map(volume => (
        <div class="volume-card">
          <h3>כרך {volume.number} - {volume.name}</h3>
          <p>{volume.chapters} פרקים</p>
          <a href={`/books/likutay-nanach/volume-${volume.number}`} class="btn">
            פתח את הכרך
          </a>
          <div class="volume-stats">
            <span>📖 {volume.chapters} פרקים</span>
            <span>📄 {Math.round(volume.size / 1024)}KB</span>
          </div>
        </div>
      ))}
    </div>

    <div class="search-note">
      <p><strong>חיפוש:</strong> כל התוכן של לקוטי ננח זמין לחיפוש דרך פונקציית החיפוש הראשית של האתר.</p>
    </div>
  </div>

  <style>
    .book-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    .book-header {
      text-align: center;
      margin-bottom: 3rem;
      border-bottom: 3px solid #4a90e2;
      padding-bottom: 2rem;
    }

    .book-header h1 {
      font-size: 3rem;
      color: #2c3e50;
      margin-bottom: 0.5rem;
    }

    .book-header h2 {
      font-size: 2.5rem;
      color: #34495e;
      margin-bottom: 1rem;
      font-family: 'David', 'Arial Hebrew', serif;
    }

    .subtitle {
      font-size: 1.2rem;
      color: #7f8c8d;
      font-style: italic;
    }

    .intro-section {
      background: #f8f9fa;
      padding: 2rem;
      border-radius: 10px;
      margin-bottom: 3rem;
      border-right: 5px solid #4a90e2;
    }

    .intro-section p {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 1rem;
      text-align: justify;
    }

    .quote {
      font-size: 1.5rem;
      color: #e74c3c;
      text-align: center;
      font-weight: bold;
      margin-top: 1.5rem;
      padding: 1rem;
      background: #fff;
      border-radius: 5px;
      border: 2px dashed #e74c3c;
    }

    .volumes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .volume-card {
      background: white;
      border-radius: 10px;
      padding: 1.5rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      border: 2px solid #4a90e2;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .volume-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

    .volume-card h3 {
      color: #2c3e50;
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .volume-card p {
      color: #7f8c8d;
      margin-bottom: 1.5rem;
    }

    .btn {
      display: inline-block;
      background: #4a90e2;
      color: white;
      padding: 0.8rem 1.5rem;
      border-radius: 5px;
      text-decoration: none;
      font-weight: bold;
      transition: background 0.3s;
    }

    .btn:hover {
      background: #357ae8;
    }

    .volume-stats {
      display: flex;
      justify-content: space-between;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid #eee;
      font-size: 0.9rem;
      color: #95a5a6;
    }

    .search-note {
      background: #e8f4fc;
      padding: 1.5rem;
      border-radius: 10px;
      border-left: 5px solid #3498db;
      margin-top: 2rem;
    }

    .search-note p {
      margin: 0;
      color: #2c3e50;
    }

    @media (max-width: 768px) {
      .book-page {
        padding: 1rem;
      }

      .book-header h1 {
        font-size: 2rem;
      }

      .book-header h2 {
        font-size: 1.8rem;
      }

      .volumes-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>