  .page-header &lbrace; background: linear-gradient(135deg, #553c9a 0%, #44337a 100%); color: white; padding: 4rem 2rem; text-align: center; &rbrace;
  .page-header h1 &lbrace; font-family: var(--font-hebrew); font-size: 2.5rem; margin-bottom: 0.5rem; &rbrace;
