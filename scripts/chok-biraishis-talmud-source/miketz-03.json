        }
      ],
      "sha256": "95dacb473818c54bac50f4ceab94be29d4d6bf7bcd8fe1fa07e8fdc7f7875dad",
      "body": "ובמקום שנדה טובלת - בארבעים סאה:"
    },
    {
      "ref": "Rashi on Yevamot 47b:4:3",
      "pointer": "/text/93/3/2",
      "included": [
        {
          "cp": [
            0,
            74
          ],
          "utf8SHA256": "4728f85c2ab79c1a06ae420ff456f70b3b4a16b65cbb36248c70b483cdf5fe35"
        }
      ],
      "sha256": "4728f85c2ab79c1a06ae420ff456f70b3b4a16b65cbb36248c70b483cdf5fe35",
      "body": "שם גר ועבד משוחרר טובלין - ואע\"פ שאין טבילתו משום טומאה וטהרה כשאר טבילות:"
    },
    {
      "ref": "Rashi on Yevamot 47b:4:4",
      "pointer": "/text/93/3/3",
      "included": [
        {
          "cp": [
            0,
