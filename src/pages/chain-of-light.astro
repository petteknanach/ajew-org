      margin: 0 0 8px;
      font-weight: 600;
    }
    .col-source-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.6em;
      margin: 0 0 6px;
      direction: rtl;
    }
    .col-source-english {
      font-size: 0.95em;
      opacity: 0.9;
      margin: 0 0 8px;
    }
    .col-source-verse {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.05em;
      direction: rtl;
      background: rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 10px 14px;
      margin: 12px 0 0;
      border-right: 3px solid #e8d5a3;
    }
    .col-source-verse-ref {
      font-family: 'Open Sans', sans-serif;
      font-size: 0.75em;
      color: #e8d5a3;
      margin-top: 4px;
      direction: ltr;
      display: block;
    }
    .col-source-themes {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
    .col-source-themes span {
      background: rgba(255,255,255,0.15);
      padding: 3px 10px;
      border-radius: 10px;
      font-size: 0.72em;
      color: #e8d5a3;
    }
    .col-source-link {
      display: inline-block;
      margin-top: 14px;
      color: #e8d5a3;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9em;
      border: 1px solid rgba(232,213,163,0.4);
      padding: 6px 16px;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .col-source-link:hover {
      background: rgba(232,213,163,0.15);
    }

    /* Connection count badge */
    .col-count-badge {
      text-align: center;
      padding: 10px;
      font-size: 0.9em;
      color: #666;
      margin-bottom: 8px;
    }
    .col-count-badge strong {
      color: #1a365d;
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.3em;
    }

    /* Chain timeline */
    .col-chain {
      position: relative;
      padding-left: 40px;
    }
    .col-chain::before {
      content: '';
      position: absolute;
      left: 15px;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(to bottom, #1a365d, #e8d5a3, #c53030);
      border-radius: 2px;
    }

    /* Chain category section */
    .col-chain-category {
      margin-bottom: 24px;
    }
    .col-chain-cat-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.1em;
      color: #1a365d;
      margin: 0 0 10px;
      font-weight: 700;
      position: relative;
    }
    .col-chain-cat-title::before {
      content: '';
      position: absolute;
      left: -33px;
      top: 50%;
      transform: translateY(-50%);
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: #1a365d;
      border: 3px solid white;
      box-shadow: 0 0 0 2px #1a365d;
    }
    .col-chain-cat-icon {
      margin-right: 6px;
    }

    /* Connection card */
    .col-conn-card {
      background: white;
      border: 1px solid #e8e2d6;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 10px;
      position: relative;
