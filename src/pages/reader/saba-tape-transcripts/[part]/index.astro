---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return [{ params: { part: '1' } }];
}

const { part } = Astro.params;
const partNum = parseInt(part || '1');
let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/saba-tape-transcripts/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading Saba Tape Transcripts index:', e);
}
const totalSections = indexData?.torahs?.length || 0;
---

<Layout title="Saba Tape Transcripts — Directory" description="Individual directory for the Saba Tape Transcripts.">
  <ReaderDirectory
    title="Saba Tape Transcripts"
    hebrewTitle="תמלולי קלטות סבא"
    subtitle="Recordings and English transcripts of Saba Yisroel Dov Odesser"
    countLabel={`${totalSections} tapes`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/saba-tape-transcripts/${partNum}/`}
    itemKind="tapes"
  />
</Layout>
