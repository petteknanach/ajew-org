---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Daily Learning Plan" description="Structured daily Torah learning schedule based on Breslov tradition. Likutay Moharan, Tehillim, Halacha, and more.">
  <section class="plan-page">
    <div class="container">
      <h1 class="hebrew-title">סדר לימוד יומי</h1>
      <h1>Daily Learning Plan</h1>
      <p class="subtitle">A suggested daily schedule based on Breslov tradition</p>

      <div class="plans-grid">
        <div class="plan-card plan-essential">
          <h2>Essential / עיקרי</h2>
          <p class="plan-time">~15 minutes</p>
          <div class="plan-items">
            <a href="/reader" class="plan-item" id="planLM">
              <span class="plan-icon">📖</span>
              <div>
                <span class="plan-name">Likutay Moharan</span>
                <span class="plan-desc">One torah per day</span>
              </div>
            </a>
            <a href="/reader/tanach-tehillim/part-1/1" class="plan-item" id="planTehillim">
              <span class="plan-icon">🙏</span>
              <div>
                <span class="plan-name">Tehillim</span>
                <span class="plan-desc">Daily chapters</span>
              </div>
            </a>
            <div class="plan-item">
              <span class="plan-icon">🌿</span>
              <div>
                <span class="plan-name">Hitbodedut</span>
                <span class="plan-desc">Personal prayer in your own words</span>
              </div>
            </div>
          </div>
        </div>

        <div class="plan-card">
          <h2>Intermediate / בינוני</h2>
          <p class="plan-time">~30 minutes</p>
          <div class="plan-items">
            <a href="/reader" class="plan-item">
              <span class="plan-icon">📚</span>
              <div>
                <span class="plan-name">Likutay Halachos</span>
                <span class="plan-desc">One halacha per day</span>
              </div>
            </a>
            <a href="/reader" class="plan-item">
              <span class="plan-icon">💬</span>
              <div>
                <span class="plan-name">Sichos HaRan</span>
                <span class="plan-desc">One sicha per day</span>
              </div>
            </a>
            <a href="/reader" class="plan-item">
              <span class="plan-icon">⭐</span>
              <div>
                <span class="plan-name">Sefer HaMidos</span>
                <span class="plan-desc">Character traits study</span>
              </div>
            </a>
          </div>
        </div>

        <div class="plan-card">
          <h2>Advanced / מתקדם</h2>
          <p class="plan-time">~1 hour</p>
          <div class="plan-items">
            <a href="/reader" class="plan-item">
              <span class="plan-icon">🔥</span>
              <div>
                <span class="plan-name">Likutay Tefilos</span>
                <span class="plan-desc">Reb Noson's prayers</span>
              </div>
            </a>
            <a href="/parsha" class="plan-item">
              <span class="plan-icon">📜</span>
              <div>
                <span class="plan-name">Weekly Parsha</span>
                <span class="plan-desc">Torah portion with Breslov lens</span>
              </div>
            </a>
            <a href="/reader" class="plan-item">
              <span class="plan-icon">🌟</span>
              <div>
                <span class="plan-name">Zohar HaKadosh</span>
                <span class="plan-desc">Daily Zohar study</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <div class="tips-section">
        <h2>Tips from Rebbe Nachman</h2>
        <ul>
          <li>Start with whatever you can — even one line of Torah has infinite value</li>
          <li>Consistency matters more than quantity — better 5 minutes daily than hours once a week</li>
          <li>Combine learning with prayer — ask Hashem to help you understand what you learn</li>
          <li>Don't be discouraged if you don't understand — the words themselves have power</li>
          <li>The main thing is joy — learn with happiness, not pressure</li>
        </ul>
      </div>

      <div class="start-section">
        <a href="/reader" class="start-btn">Start Learning Now →</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
// Set today's LM and Tehillim links
(function() {
  const day = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
  const lmDay = (day % 408) + 1;
  let lmPart = 1, lmTorah = lmDay;
  if (lmDay > 285) { lmPart = 2; lmTorah = lmDay - 285; }
  const tehDay = (day % 150) + 1;

  const lmLink = document.getElementById('planLM');
  if (lmLink) lmLink.href = '/reader/likutay-moharan/part-' + lmPart + '/' + lmTorah;
  const tehLink = document.getElementById('planTehillim');
  if (tehLink) tehLink.href = '/reader/tanach-tehillim/part-1/' + tehDay;
})();
</script>

<style>
  .plan-page { max-width: 900px; margin: 0 auto; padding: 40px 24px 80px; font-family: 'Open Sans', sans-serif; }
  .hebrew-title { font-family: 'Frank Ruhl Libre', serif; font-size: 2.2em; color: #1a365d; direction: rtl; margin: 0; text-align: center; }
  h1 { font-family: 'Frank Ruhl Libre', serif; color: #1a365d; font-size: 1.5em; margin: 0 0 8px; text-align: center; }
  .subtitle { color: #666; text-align: center; margin-bottom: 32px; }

  .plans-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .plan-card { background: #f8f5ef; border: 1px solid #e0d6c2; border-radius: 16px; padding: 20px; }
  .plan-essential { background: linear-gradient(135deg, #1a365d, #2c5282); color: white; border: none; }
  .plan-essential h2 { color: white; }
  .plan-essential .plan-item { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.2); color: white; }
  .plan-essential .plan-name { color: white; }
  .plan-essential .plan-desc { color: rgba(255,255,255,0.7); }
  .plan-card h2 { font-family: 'Frank Ruhl Libre', serif; color: #1a365d; font-size: 1.2em; margin: 0 0 4px; }
  .plan-time { color: #888; font-size: 0.85em; margin: 0 0 16px; }
  .plan-essential .plan-time { color: rgba(255,255,255,0.6); }

  .plan-items { display: flex; flex-direction: column; gap: 8px; }
  .plan-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: white; border: 1px solid #e0d6c2; border-radius: 10px; text-decoration: none; transition: border-color 0.2s; }
  .plan-item:hover { border-color: #1a365d; }
  .plan-icon { font-size: 1.5em; }
  .plan-name { display: block; color: #1a365d; font-weight: 600; font-size: 0.95em; }
  .plan-desc { display: block; color: #666; font-size: 0.8em; }

  .tips-section { background: #f0ebe0; border-radius: 16px; padding: 24px; margin-bottom: 32px; }
  .tips-section h2 { font-family: 'Frank Ruhl Libre', serif; color: #1a365d; font-size: 1.2em; margin: 0 0 12px; }
  .tips-section ul { margin: 0; padding: 0 0 0 20px; line-height: 1.8; color: #444; }

  .start-section { text-align: center; }
  .start-btn { display: inline-block; padding: 14px 32px; background: #1a365d; color: white; border-radius: 12px; text-decoration: none; font-weight: 600; font-size: 1.1em; }
  .start-btn:hover { background: #2a5a9e; }
</style>
