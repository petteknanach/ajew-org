---
import Layout from '../layouts/Layout.astro';
import EnhancedSearch from '../components/EnhancedSearch.astro';
---

<Layout
  title="Search 25,000+ Pages of Torah - Advanced Search"
  description="Search across 226+ sacred Jewish texts with 10 search modes. Hebrew, English, acronym, gematria, proximity search and more. Likutay Moharan, Zohar, Talmud, Tanach."
  breadcrumbs={[{name: "Home", url: "https://ajew.org"}, {name: "Search", url: "https://ajew.org/search-enhanced"}]}
>
  <div class="search-page">
    <header class="page-header">
      <h1><span lang="he">חיפוש מתקדם</span> <span class="sr-only">-</span> Advanced Search Across All Works</h1>
    </header>

    <div class="container">
      <!-- Search Section -->
      <div class="search-section">
        <EnhancedSearch 
          compact={false}
          showFilters={true}
          autoFocus={true}
          showAdvancedOptions={true}
        />
      </div>

      <!-- Results Section - RIGHT BELOW SEARCH -->
      <div class="results-section" id="resultsSection">
        <div id="welcomeMessage" class="welcome-message">
          <div class="welcome-icon">📖</div>
          <p class="welcome-text">התחילו לחיפוש למעלה / Start searching above</p>
          <p class="welcome-hint">בחרו ספרים והגדרות מתקדמות / Select books and advanced options</p>
        </div>

        <div id="loading" class="loading hidden">
          <div class="spinner"></div>
          <p>מחפש... Searching...</p>
        </div>

        <div id="resultsContainer" class="results-container hidden">
          <div class="results-header">
            <h3 id="resultsCount"></h3>
            <div class="results-actions">
              <button id="copySearchLink" class="action-btn">🔗 Copy Link</button>
              <button id="clearResults" class="action-btn clear-btn">✕ Clear</button>
            </div>
          </div>
          <div id="resultsList" class="results-list"></div>
        </div>

        <div id="noResults" class="no-results hidden">
          <div class="no-results-icon">🔍</div>
          <h3>לא נמצאו תוצאות / No results found</h3>
          <p id="noResultsMessage"></p>
        </div>
      </div>

      <!-- Explore More -->
      <div class="maps-section">
        <h2>🔍 חיפוש מתקדם — Advanced Search</h2>
        <div class="maps-notice">
          <p><strong>חפשו ב-22,000+ עמודים בעברית ואנגלית</strong> / Search 22,000+ pages in Hebrew and English</p>
          <p style="margin-top:0.5em;opacity:0.8;">10 search modes: Google-style, exact phrase, boolean, proximity, acronym (ראשי תיבות), end-letters (סופי תיבות), and more</p>
        </div>
        <div style="display:flex;gap:1em;flex-wrap:wrap;margin-top:1em;">
          <a href="/chain-of-light" style="padding:0.8em 1.5em;background:var(--accent-color,#d4a574);color:#fff;border-radius:8px;text-decoration:none;font-weight:bold;">🔗 Chain of Light — Torah Connections Map</a>
          <a href="/topics" style="padding:0.8em 1.5em;background:var(--accent-color,#d4a574);color:#fff;border-radius:8px;text-decoration:none;font-weight:bold;">📚 Torah GPS — 51 Spiritual Topics</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const welcomeMessage = document.getElementById('welcomeMessage');
      const loading = document.getElementById('loading');
      const resultsContainer = document.getElementById('resultsContainer');
      const resultsList = document.getElementById('resultsList');
      const resultsCount = document.getElementById('resultsCount');
      const noResults = document.getElementById('noResults');
      const noResultsMessage = document.getElementById('noResultsMessage');
      const clearResults = document.getElementById('clearResults');
      const copySearchLink = document.getElementById('copySearchLink');
      const resultsSection = document.getElementById('resultsSection');

      // Listen for search events
      // Split language indexes: Hebrew (~38MB) + English (~19MB)
      // Load preferred language first; lazy-load the other if needed
      let heIndex = null;
      let enIndex = null;
      let hePromise = null;
      let enPromise = null;
      let preferredLang = 'he'; // 'he' or 'en'
      
      function detectLang() {
        // 1. Check stored preference
        try {
          const stored = localStorage.getItem('ajew-search-lang');
          if (stored === 'he' || stored === 'en') return stored;
        } catch(e) {}
        // 2. Check navigator.language
        const nav = (navigator.language || '').toLowerCase();
        if (nav.startsWith('he') || nav.startsWith('iw')) return 'he';
        // 3. Default to English for non-Hebrew browsers
        return 'en';
      }
      
      function loadIndex(lang) {
        if (lang === 'he' && heIndex) return Promise.resolve(heIndex);
        if (lang === 'en' && enIndex) return Promise.resolve(enIndex);
        if (lang === 'he' && hePromise) return hePromise;
        if (lang === 'en' && enPromise) return enPromise;
        
        const file = lang === 'he' ? '/data/light-search-index-he.json.gz' : '/data/light-search-index-en.json.gz';
        const label = lang === 'he' ? 'Hebrew' : 'English';
        
        // Show loading indicator (only on first load)
        if (!document.getElementById('indexLoading')) {
          const el = document.createElement('div');
          el.className = 'index-loading';
          el.id = 'indexLoading';
          el.innerHTML = '<span class="idx-spinner"></span> טוען אינדקס חיפוש... Loading search index...';
          resultsSection.insertBefore(el, resultsSection.firstChild);
        }
        
        const promise = fetch(file)
          .then(res => {
            if (!res.ok) throw new Error('Failed to load ' + label + ' index');
            const ds = new DecompressionStream('gzip');
            const stream = res.body.pipeThrough(ds);
            return new Response(stream).json();
          })
          .then(data => {
            if (lang === 'he') heIndex = data;
            else enIndex = data;
            console.log(label + ' search index loaded:', data.length, 'documents');
            // Remove loading indicator if both loaded or this was the preferred one
            if (lang === preferredLang || (heIndex && enIndex)) {
              const el = document.getElementById('indexLoading');
              if (el) el.remove();
            }
            return data;
          })
          .catch(err => {
            console.error(label + ' index load failed:', err);
            const el = document.getElementById('indexLoading');
            if (el) el.innerHTML = '⚠️ Failed to load index. Check your connection and refresh.';
            throw err;
          });
        
        if (lang === 'he') hePromise = promise;
        else enPromise = promise;
        return promise;
      }
      
      function getActiveIndex() {
        // Returns the preferred index if loaded, otherwise whichever is loaded
        if (preferredLang === 'he' && heIndex) return heIndex;
        if (preferredLang === 'en' && enIndex) return enIndex;
        return heIndex || enIndex;
      }
      
      function isHebrewQuery(query) {
        return /[\u0590-\u05FF]/.test(query);
      }
      
      function needsLanguageSwitch(query) {
        const qHebrew = isHebrewQuery(query);
        if (qHebrew && !heIndex && preferredLang === 'en') return 'he';
        if (!qHebrew && !enIndex && preferredLang === 'he') return 'en';
        return null;
      }
      
      // Pre-load lightweight reader-search metadata only. Do not load the huge browser indexes.
      preferredLang = detectLang();
      setTimeout(() => loadReaderMeta().catch(() => {}), 0);
      
      function normalizeForSearch(text) {
        return (text || '').toString().toLowerCase().normalize('NFD')
          .replace(/[\u0591-\u05C7]/g, '')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[״"׳']/g, '')
          .replace(/[^\p{L}\p{N}\s]+/gu, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      const EN_STOP_WORDS = new Set([
        'a','an','and','are','as','at','be','but','by','for','from','has','have','he','his','if','in','is','it','its','not','of','on','or','our','she','that','the','their','then','there','this','to','was','were','when','with','you','your','source','sources','details','comments','comment','bad','good'
      ]);
      const HEBREW_STOP_WORDS = new Set(['את','על','של','עם','כל','בית']);
      const COMMON_TYPOS = new Map([
        ['isgn', 'sign'],
        ['sing', 'sign'],
        ['childhod', 'childhood'],
        ['chilhood', 'childhood']
      ]);
      const SYNONYM_GROUPS = new Map([
        ['home', ['home', 'house', 'dwelling', 'residence', 'birthplace']],
        ['house', ['house', 'home', 'dwelling', 'residence', 'birthplace']],
        ['childhood', ['childhood', 'youth', 'young', 'boyhood']],
        ['youth', ['youth', 'childhood', 'young', 'boyhood']],
        ['sold', ['sold', 'sell', 'sale', 'selling']],
        ['sell', ['sell', 'sold', 'sale', 'selling']],
        ['sign', ['sign', 'omen', 'indication']],
        ['ילדותו', ['ילדותו', 'נעוריו', 'נערותו']],
        ['נעוריו', ['נעוריו', 'ילדותו', 'נערותו']],
        ['נערותו', ['נערותו', 'ילדותו', 'נעוריו']]
      ]);

      function correctedWord(word) {
        return COMMON_TYPOS.get(word) || word;
      }

      function searchWords(text, options = {}) {
        const keepStopWords = options.keepStopWords === true;
        return normalizeForSearch(text)
          .split(' ')
          .filter(Boolean)
          .map(correctedWord)
          .filter(w => keepStopWords || (/[\u0590-\u05FF]/.test(w) ? !HEBREW_STOP_WORDS.has(w) : (w.length > 2 && !EN_STOP_WORDS.has(w))));
      }

      function queryTermGroups(query, options = {}) {
        const expand = options.expand !== false;
        return searchWords(query, options).map(w => {
          const variants = expand ? (SYNONYM_GROUPS.get(w) || [w]) : [w];
          return Array.from(new Set(variants.map(v => correctedWord(normalizeForSearch(v))).filter(Boolean)));
        });
      }

      const readerShardCache = new Map();
      let readerMetaPromise = null;
      let readerMeta = null;

      async function loadReaderMeta() {
        if (readerMeta) return readerMeta;
        if (!readerMetaPromise) {
          readerMetaPromise = fetch('/reader-search/meta.json', { headers: { Accept: 'application/json' } })
            .then(r => { if (!r.ok) throw new Error('reader meta ' + r.status); return r.json(); })
            .then(d => (readerMeta = d));
        }
        return readerMetaPromise;
      }

      async function loadShard(key) {
        if (readerShardCache.has(key)) return readerShardCache.get(key);
        const shard = await fetch('/reader-search/shards/' + encodeURIComponent(key) + '.json', { headers: { Accept: 'application/json' } })
          .then(r => r.ok ? r.json() : {});
        readerShardCache.set(key, shard);
        return shard;
      }

      function bookIdFromPath(path) {
        return (path || '').replace(/^\/reader\//, '').split('/')[0] || '';
      }

      function postingsForGroup(shards, group) {
        const merged = new Set();
        for (const term of group) {
          const shard = shards.find(sh => sh[term]);
          if (shard && shard[term]) shard[term].forEach(id => merged.add(id));
        }
        return Array.from(merged);
      }

      function idsForMode(shards, query, mode) {
        const groups = queryTermGroups(query, { expand: mode !== 'exact' });
        const q = normalizeForSearch(query);
        if (!groups.length) return [];
        if (mode === 'startsWith') {
          const ids = new Set();
          for (const shard of shards) for (const [term, list] of Object.entries(shard)) if (!term.startsWith('e:') && term.startsWith(q)) list.forEach(id => ids.add(id));
          return Array.from(ids);
        }
        if (mode === 'endsWith') {
          const ids = new Set();
          const rev = Array.from(q).reverse().join('');
          for (const [term, list] of Object.entries(shards[0] || {})) if (term.startsWith('e:' + rev)) list.forEach(id => ids.add(id));
          return Array.from(ids);
        }
        const lists = groups.map(group => postingsForGroup(shards, group)).filter(list => list.length);
        if (!lists.length) return [];
        if (mode === 'any' || mode === 'google' || mode === 'boolean') {
          const score = new Map();
          lists.forEach(list => {
            const rarityWeight = Math.max(1, 120000 / Math.max(1, list.length));
            list.forEach(id => score.set(id, (score.get(id) || 0) + rarityWeight));
          });
          return Array.from(score.keys()).sort((a, b) => (score.get(b) || 0) - (score.get(a) || 0));
        }
        const [smallest, ...rest] = lists.sort((a,b)=>a.length-b.length);
        const restSets = rest.map(l => new Set(l));
        return (smallest || []).filter(id => restSets.every(set => set.has(id)));
      }

      async function loadDoc(id) {
        const r = await fetch('/reader-search/docs/' + id + '.json', { headers: { Accept: 'application/json' } });
        if (!r.ok) return null;
        return r.json();
      }

      function groupMatchesText(group, n) {
        return group.some(w => n.includes(w));
      }

      function docMatchScore(doc, query, mode) {
        const q = normalizeForSearch(query);
        const groups = queryTermGroups(query, { expand: mode !== 'exact' });
        const n = doc.n || normalizeForSearch([doc.t, doc.h, doc.c, doc.he, doc.en].join(' '));
        const toks = n.split(' ').filter(Boolean);
        if (!groups.length) return 0;
        if (mode === 'exact') return n.includes(q) ? 1000 : 0;
        if (mode === 'startsWith') return toks.some(w => w.startsWith(q)) ? 700 : 0;
        if (mode === 'endsWith') return toks.some(w => w.endsWith(q)) ? 700 : 0;
        const matched = groups.filter(group => groupMatchesText(group, n)).length;
        if (mode === 'all' || mode === 'proximity') return matched === groups.length ? 800 + matched : 0;
        if (mode === 'any') return matched ? (matched * 100 + (n.includes(q) ? 250 : 0)) : 0;
        if (mode === 'google' || mode === 'boolean') {
          const minimum = groups.length >= 2 ? Math.max(2, Math.ceil(groups.length * 0.4)) : 1;
          return matched >= minimum ? (matched * 100 + (n.includes(q) ? 250 : 0)) : 0;
        }
        return matched ? matched * 100 : 0;
      }

      function docMatches(doc, query, mode) {
        return docMatchScore(doc, query, mode) > 0;
      }

      function makeSnippet(doc, query) {
        const raw = /[\u0590-\u05FF]/.test(query) ? (doc.he || doc.en || '') : (doc.en || doc.he || '');
        const normRaw = normalizeForSearch(raw);
        const q = normalizeForSearch(query);
        const words = searchWords(query);
        let ni = q ? normRaw.indexOf(q) : -1;
        if (ni < 0) for (const w of words) { ni = normRaw.indexOf(w); if (ni >= 0) break; }
        const approx = ni < 0 ? 0 : Math.min(raw.length, ni);
        const start = Math.max(0, approx - 160);
        const end = Math.min(raw.length, approx + 420);
        return (start > 0 ? '…' : '') + raw.slice(start, end).replace(/\s+/g, ' ').trim() + (end < raw.length ? '…' : '');
      }

      async function clientSearch(query, advanced) {
        const meta = await loadReaderMeta();
        const searchType = advanced?.searchType || 'google';
        const books = advanced?.books || [];
        const allowed = new Set(books || []);
        let keys;
        if (searchType === 'endsWith') keys = ['e'];
        else if (searchType === 'startsWith') keys = [normalizeForSearch(query).slice(0,1) || '_'];
        else {
          const groups = queryTermGroups(query, { expand: searchType !== 'exact' });
          keys = Array.from(new Set(groups.flat().map(w => w.slice(0,1) || '_')));
        }
        const shards = await Promise.all(keys.map(loadShard));
        let ids = idsForMode(shards, query, searchType);
        if (allowed.size) ids = ids.filter(id => allowed.has(bookIdFromPath(meta.items[id]?.p || '')));
        const verified = [];
        const batchSize = 60;
        const maxCandidates = (searchType === 'google' || searchType === 'any' || searchType === 'boolean') ? 1600 : 900;
        for (let i = 0; i < ids.length && i < maxCandidates && verified.length < 50; i += batchSize) {
          const docs = await Promise.all(ids.slice(i, i + batchSize).map(loadDoc));
          for (const doc of docs) {
            if (!doc) continue;
            const score = docMatchScore(doc, query, searchType);
            if (!score) continue;
            verified.push({
              title: doc.t || doc.h || 'Untitled',
              hebrewTitle: doc.h || doc.t || '',
              snippet: makeSnippet(doc, query),
              link: doc.p || '#',
              book: doc.c || '',
              subcategory: doc.c || '',
              relevance: Math.min(100, Math.max(10, Math.round(score / 10))),
              extraInfo: doc.c || '',
              _score: score
            });
          }
        }
        verified.sort((a, b) => (b._score || 0) - (a._score || 0));
        const total = verified.length;
        return { results: verified.slice(0, 50), total };
      }

      document.addEventListener('enhanced-search', (e: any) => {
        performSearch(e.detail.query, e.detail.filters, e.detail.advancedOptions);
      });

      function performSearch(query: string, filters: any = {}, advanced: any = {}) {
        if (!query?.trim()) {
          showWelcome();
          return;
        }

        showLoading();
        saveSearchHistory(query);
        
        const loadPromise = Promise.resolve();

        loadPromise.then(async () => {
          const { results, total } = await clientSearch(query, advanced);
          loading.classList.add('hidden');
          
          if (results.length > 0) {
            displayResults(results, query, total);
          } else {
            showNoResults(query);
          }
        }).catch(err => {
          console.error('Search error:', err);
          loading.classList.add('hidden');
          showNoResults(query, 'Search unavailable. Please try again.');
        });
      }

      function displayResults(results: any[], query: string, total?: number) {
        const count = total || results.length;
        resultsCount.textContent = `${count} תוצאות ל "${query}" / results for "${query}"`;

        const html = results.map(result => {
          const extraInfo = result.extraInfo || '';
          const rawSnippet = result.snippet || '';
          const snippet = highlightQuery(rawSnippet, query, extraInfo);
          const link = result.link || '#';
          const linkWithQuery = link + (link.includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(query);
          const rawTitle = result.title || 'Unknown';
          const title = highlightQuery(rawTitle, query);
          const hebrewTitle = result.hebrewTitle ? highlightQuery(result.hebrewTitle, query) : '';
          const subcategory = result.subcategory || '';
          const wordCount = result.wordCount || 0;
          const relevance = result.relevance || 0;

          return `
            <div class="result-item">
              <div class="result-top">
                <h4 class="result-title">
                  <a href="${linkWithQuery}">${title}${hebrewTitle ? ` <span class="result-he-title">${hebrewTitle}</span>` : ''}</a>
                </h4>
                <div class="result-tags">
                  ${extraInfo ? `<span class="result-match-info">${extraInfo}</span>` : ''}
                  ${subcategory ? `<span class="result-subcategory">${subcategory}</span>` : ''}
                  ${wordCount ? `<span class="result-stat">${wordCount} words</span>` : ''}
                  ${relevance ? `<span class="result-relevance">${relevance}%</span>` : ''}
                </div>
              </div>
              <p class="result-snippet">${snippet}</p>
              <div class="result-footer">
                <a href="${linkWithQuery}" class="view-link">קרא טקסט מלא / Read Full →</a>
                <button class="share-btn" data-share-link="${escapeAttr(linkWithQuery)}" data-share-title="${escapeAttr(rawTitle)}" data-share-snippet="${escapeAttr(rawSnippet)}">📤 Share</button>
              </div>
            </div>
          `;
        }).join('');

        resultsList.innerHTML = html;
        bindShareButtons();

        // Add "Load More" if there are more results
        if (count > results.length) {
          const loadMore = document.createElement('button');
          loadMore.className = 'load-more-btn';
          loadMore.textContent = `Load more (showing ${results.length} of ${count})`;
          loadMore.addEventListener('click', () => {
            const currentPage = Math.floor(results.length / 50) + 1;
            const advanced = searchState?.advancedOptions || {};
            const url = new URL('/api/search', window.location.origin);
            url.searchParams.set('q', query);
            url.searchParams.set('page', String(currentPage + 1));
            if (advanced.searchType) url.searchParams.set('searchType', advanced.searchType);
            if (advanced.books?.length > 0) url.searchParams.set('books', advanced.books.join(','));
            loadMore.textContent = 'Loading...';
            fetch(url.toString())
              .then(r => r.json())
              .then(data => {
                if (data.results?.length > 0) {
                  const moreHtml = data.results.map((r: any) => {
                    const s = highlightQuery(r.snippet || '', query, r.extraInfo || '');
                    const t = highlightQuery(r.title || '', query);
                    const ht = r.hebrewTitle ? highlightQuery(r.hebrewTitle, query) : '';
                    const linkWithQ = (r.link||'#') + ((r.link||'').includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(query);
                    return '<div class="result-item"><div class="result-top"><h4 class="result-title"><a href="' + linkWithQ + '">' + t + (ht ? ' <span class="result-he-title">'+ht+'</span>' : '') + '</a></h4></div><p class="result-snippet">' + s + '</p><div class="result-footer"><a href="' + linkWithQ + '" class="view-link">Read Full →</a></div></div>';
                  }).join('');
                  loadMore.insertAdjacentHTML('beforebegin', moreHtml);
                  const totalShown = resultsList.querySelectorAll('.result-item').length;
                  if (totalShown >= count) loadMore.remove();
                  else loadMore.textContent = `Load more (showing ${totalShown} of ${count})`;
                } else {
                  loadMore.remove();
                }
              })
              .catch(() => { loadMore.textContent = 'Failed to load. Try again.'; });
          });
          resultsList.appendChild(loadMore);
        }

        resultsContainer.classList.remove('hidden');
        noResults.classList.add('hidden');
        welcomeMessage.classList.add('hidden');

        // Scroll to results smoothly
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Nikud (vowel marks) regex - these appear in Hebrew text but not in search queries
      const NIKUD_RANGE = '[\u0591-\u05BD\u05BF-\u05C7]';

      function escapeAttr(value: string): string {
        return (value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function bindShareButtons() {
        resultsList.querySelectorAll('.share-btn').forEach((btn: any) => {
          btn.addEventListener('click', () => shareResult(btn.dataset.shareLink || '#', btn.dataset.shareTitle || 'ajew.org', btn.dataset.shareSnippet || '', btn));
        });
      }

      function highlightQuery(text: string, query: string, extraInfo?: string): string {
        if (!query || !text) return text || '';

        let result = text;

        // For acronym/endletters: highlight the matched words from extraInfo
        if (extraInfo && extraInfo.startsWith('Found:')) {
          const matchedWords = extraInfo.replace('Found:', '').trim();
          if (matchedWords) {
            // Highlight each matched word (may contain nikud in text)
            const mWords = matchedWords.split(/\s*\.\.\.\s*|\s+/).filter(Boolean);
            for (const mw of mWords) {
              const escaped = mw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
              // Insert optional nikud between each character for Hebrew matching
              const nikudAware = [...escaped].join(NIKUD_RANGE + '*');
              try {
                const regex = new RegExp(`(${nikudAware})`, 'g');
                result = result.replace(regex, '<mark>$1</mark>');
              } catch(e) { /* skip bad regex */ }
            }
            return result;
          }
        }

        // Standard word highlighting - nikud-aware
        const words = query.split(/\s+/).filter(w =>
          w.length > 0 && !['and', 'or', 'not'].includes(w.toLowerCase())
        );

        for (const word of words) {
          const escaped = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          // Insert optional nikud marks between each Hebrew character
          // This lets "תשובה" match "תְּשׁוּבָה" in the text
          const chars = [...escaped];
          const nikudAware = chars.join(NIKUD_RANGE + '*');
          try {
            const regex = new RegExp(`(${nikudAware})`, 'gi');
            result = result.replace(regex, '<mark>$1</mark>');
          } catch(e) {
            // Fallback: plain match without nikud awareness
            const simpleRegex = new RegExp(`(${escaped})`, 'gi');
            result = result.replace(simpleRegex, '<mark>$1</mark>');
          }
        }
        return result;
      }

      function showLoading() {
        welcomeMessage.classList.add('hidden');
        loading.classList.remove('hidden');
        resultsContainer.classList.add('hidden');
        noResults.classList.add('hidden');
        // Scroll to results section
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function showNoResults(query: string, msg?: string) {
        noResultsMessage.textContent = msg || `No results for "${query}". Try different terms or fewer filters.`;
        noResults.classList.remove('hidden');
        resultsContainer.classList.add('hidden');
        welcomeMessage.classList.add('hidden');
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function shareResult(link: string, title: string, snippet: string = '', btn?: HTMLElement) {
        const fullUrl = new URL(link, window.location.origin).toString();
        const text = [title + ' — ajew.org', snippet ? snippet.replace(/<[^>]*>/g, '').slice(0, 220) : '', fullUrl].filter(Boolean).join('\n\n');
        if (navigator.share) {
          navigator.share({ title: title + ' — ajew.org', text, url: fullUrl }).catch(() => {});
        } else {
          navigator.clipboard.writeText(text).then(() => {
            if (btn) { const orig = btn.textContent; btn.textContent = '✓ Copied!'; setTimeout(() => btn.textContent = orig, 2000); }
          });
        }
      }

      (window as any).shareResult = shareResult;

      function showWelcome() {
        welcomeMessage.classList.remove('hidden');
        loading.classList.add('hidden');
        resultsContainer.classList.add('hidden');
        noResults.classList.add('hidden');
        renderSearchHistory();
      }

      // Search history
      function saveSearchHistory(query: string) {
        const KEY = 'ajew-search-history';
        try {
          let history: string[] = JSON.parse(localStorage.getItem(KEY) || '[]');
          history = history.filter(h => h !== query);
          history.unshift(query);
          localStorage.setItem(KEY, JSON.stringify(history.slice(0, 20)));
        } catch(e) {}
      }

      function renderSearchHistory() {
        const KEY = 'ajew-search-history';
        let container = document.getElementById('searchHistoryBox');
        if (!container) {
          container = document.createElement('div');
          container.id = 'searchHistoryBox';
          container.className = 'search-history-box';
          welcomeMessage.appendChild(container);
        }
        try {
          const history: string[] = JSON.parse(localStorage.getItem(KEY) || '[]');
          if (history.length === 0) { container.style.display = 'none'; return; }
          container.style.display = 'block';
          container.innerHTML = '<h4>Recent Searches</h4><div class="sh-tags">' +
            history.slice(0, 10).map(h =>
              '<button class="sh-tag" data-q="' + h.replace(/"/g, '&quot;') + '">' + h + '</button>'
            ).join('') +
            '</div>';
          container.querySelectorAll('.sh-tag').forEach((btn: any) => {
            btn.addEventListener('click', () => {
              const input = document.getElementById('searchInput') as HTMLInputElement;
              input.value = btn.dataset.q;
              performSearch(btn.dataset.q, {}, searchState?.advancedOptions || {});
            });
          });
        } catch(e) {}
      }

      if (copySearchLink) {
        copySearchLink.addEventListener('click', () => {
          const url = window.location.href;
          navigator.clipboard.writeText(url).then(() => {
            const orig = copySearchLink.textContent;
            copySearchLink.textContent = '✓ Copied';
            setTimeout(() => copySearchLink.textContent = orig, 1800);
          });
        });
      }

      clearResults.addEventListener('click', () => {
        showWelcome();
        (document.getElementById('searchInput') as HTMLInputElement).value = '';
        const url = new URL(window.location.href);
        url.searchParams.delete('q');
        window.history.replaceState({}, '', url);
      });

      // Render history on load
      renderSearchHistory();
    });
  </script>

