  const current = el.getAttribute('data-nikud');
  if (current === 'false') {
    btn.textContent = '🔤 ללא ניקוד';
    el.setAttribute('data-nikud', 'true');
  } else {
    btn.textContent = '🇮🇱 ניקוד';
    el.setAttribute('data-nikud', 'false');
  }
}
</script>

