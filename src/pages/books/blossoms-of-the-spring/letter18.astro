export const title = "Letter 18";
export const bookTitle = "Blossoms of the Spring";
---
<Layout title="{title} - {bookTitle}" description="Blossoms of the Spring - Letter 18 - The holy letters of Rabbi Yisroel Odesser">
  <div class="book-page">
    <header class="book-header">
      <h1>{bookTitle}</h1>
      <h2>Letter 18</h2>
    </header>
    <nav class="chapter-nav">
  <a href="/books/blossoms-of-the-spring/letter17" class="nav-btn prev">← Previous</a>
  <a href="/books/blossoms-of-the-spring" class="nav-btn main">Main</a>
