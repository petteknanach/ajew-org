      <script is:inline>
      (function() {
        // Dynamic Omer calculation using Gauss's Pesach algorithm
        // Pesach falls on 15 Nisan; Omer starts 16 Nisan through 6 Sivan (50 days)
        var now = new Date();
        var year = now.getFullYear();

        // Gauss's algorithm for Pesach date (approximate, works for most years)
        var a = (12 * year + 17) % 19;
        var b = year % 4;
        var m = 32.044093161144 + 1.5542417966212 * a + b / 4.0 - 0.0031777940220923 * year;
        var c = Math.floor((m + 3 * (year + 5) / 4.0 + 8.5) % 7);
        var pesachDay = Math.floor(m);
        // April adjustment
        var pesachMonth = 2; // March (0-indexed)
        if (pesachDay > 31) { pesachDay -= 31; pesachMonth = 3; } // April

        var pesachDate = new Date(year, pesachMonth, pesachDay);
        var omerStart = new Date(pesachDate.getTime() + 86400000); // day after Pesach
        var shavuosEnd = new Date(pesachDate.getTime() + 51 * 86400000); // 50 days later + 1

        if (now >= omerStart && now <= shavuosEnd) {
          var banner = document.getElementById('omerBanner');
          if (banner) banner.style.display = 'flex';
        }
      })();
      </script>

