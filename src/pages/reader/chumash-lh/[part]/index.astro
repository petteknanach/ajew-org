---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/chumash-lh/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/chumash-lh/part-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || "Chumash with Likutay Halachos"} — Part ${partNum} Index`} description={`Beautiful directory for Chumash with Likutay Halachos, part ${partNum}.`}>
  <ReaderDirectory
    title="Chumash with Likutay Halachos"
    hebrewTitle="חומש עם ליקוטי הלכות"
    subtitle={`Torah portions illuminated by Likutay Halachos · Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/chumash-lh/${partNum}/`}
  />
</Layout>
