        }
      ],
      "sha256": "77dc0582f49beb8f298eb4b032d5d972e482d4d9e2c6f4c000e86255c950c033",
      "body": "ואזלו בתר תלמודא - לחשוב בסברא:"
    },
    {
      "ref": "Rashi on Bava Metzia 33b:1:4",
      "pointer": "/text/65/0/3",
      "included": [
        {
          "cp": [
            0,
