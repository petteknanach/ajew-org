---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    id: 'featured', title: 'Featured Breslov collections', icon: '🔥', intro: 'Start with the largest and most distinctive collections on ajew.org.',
    links: [
      { title: 'One Library, Many Doorways', he: 'ספרייה אחת, דרכים רבות', href: '/one-library-many-doorways', icon: '✨', desc: 'A guided entrance to books, bilingual texts, prayer, search, media, publishing, and open Torah tools.' },
      { title: 'Complete Breslov Library', he: 'הספרייה המלאה', href: '/reader', icon: '📚', desc: 'Rabbi Nachman, Rabbi Nosson, Saba Yisroel, Breslov classics, and Jewish reference works.' },
      { title: 'Likutay Moharan', he: 'ליקוטי מוהר״ן', href: '/reader/likutay-moharan/1/1', icon: '🕯️', desc: 'Rabbi Nachman’s central teachings in Hebrew and English.' },
      { title: 'Likutay Halachos', he: 'ליקוטי הלכות', href: '/reader/likutay-halachos/1/1', icon: '📜', desc: 'Rabbi Nosson’s vast application of Rabbi Nachman’s Torah to Jewish law and life.' },
      { title: 'Likutay Halachos Summaries', he: 'סיכומי ליקוטי הלכות', href: '/reader/likutay-halachos/summaries', icon: '🧾', desc: 'Fast, searchable summaries with direct links into the complete halachos.' },
      { title: 'When to Borrow: Sichos HaRan §122', he: 'מתי ללוות', href: '/reader/sichos-haran/1/122', icon: '⚖️', desc: 'Cross-source study connecting Sichos HaRan §122 with Chullin 84b and Sefer HaMidos on debt, livelihood, and trust.' },
      { title: 'Ebay HaNachal', he: 'אִבֵּי הנחל', href: '/reader/ebay-hanachal/1/1', icon: '✉️', desc: 'Saba Yisroel’s letters to President Zalman Shazar.' },
      { title: 'Geedoolay HaNachal', he: 'גידולי הנחל', href: '/reader/geedoolay-hanachal/1/1', icon: '🌿', desc: 'Breslov history with embedded diagrams, relationship maps, and timelines.' },
      { title: 'Sefer HaMidos Multimedia', he: 'ספר המידות', href: '/reader/sefer-hamidos/1/1', icon: '🌟', desc: 'Exact bilingual teachings with Hebrew and English pictures, genuine videos, and teaching songs.' },
      { title: 'Saba Tape Transcripts', he: 'שיחות סבא', href: '/reader/saba-tape-transcripts/1/1', icon: '🎙️', desc: 'Transcribed teachings and conversations of Saba Yisroel.' },
    ]
  },
  {
    id: 'notebooklm', title: 'NotebookLM study productions', icon: '🧠', intro: 'Source-controlled study material kept in separate Beginner and Deep Study tracks.',
    links: [
      { title: 'Begin Here Audio: Spiritual Distance', he: 'התחל כאן — משיבת נפש', href: '/reader/meshivas-nefesh/1/58', icon: '🎧', desc: 'For Meshivas Nefesh §§58, 66, and 88. AI-assisted interpretation; analogies and explanations are illustrative and are not verified Torah text. Consult the cited primary sources.' },
      { title: 'Beginner: Truth 1–6', he: 'מסלול מתחילים', href: '/notebooklm/truth-1-6-exact-source-sheet.md', icon: '🌱', desc: 'Approved exact bilingual source sheet — no unsupported additions.' },
      { title: 'Deep Study: Truth 7–12', he: 'לימוד מעמיק', href: '/notebooklm/truth-7-12-exact-source-sheet.md', icon: '🔬', desc: 'Approved exact bilingual source sheet — separately sourced and verified.' },
      { title: 'Open Beginner Notebook', he: 'מחברת מתחילים', href: 'https://notebooklm.google.com/notebook/7c33fce6-f5b0-46e1-b716-428424c2c49c', icon: '↗️', desc: 'Open the source-controlled Beginner notebook in NotebookLM. Google sign-in may be required.', external: true },
      { title: 'Open Deep Study Notebook', he: 'מחברת עיון', href: 'https://notebooklm.google.com/notebook/75fd74bf-1489-484b-9511-bf2a4dd2ce05', icon: '↗️', desc: 'Open the separate Deep Study notebook in NotebookLM. Google sign-in may be required.', external: true },
    ]
  },
  {
    id: 'study', title: 'Study, discovery, and reference', icon: '🧭', intro: 'Find a teaching by text, topic, question, source, or spiritual need.',
    links: [
      { title: 'Advanced Search', he: 'חיפוש מתקדם', href: '/search-enhanced', icon: '🔍', desc: 'Search thousands of Hebrew and English Torah pages with multiple modes.' },
      { title: 'Torah GPS', he: 'תורה GPS', href: '/torah-gps', icon: '🧭', desc: 'Describe what you are facing and find connected teachings.' },
      { title: 'Torah Map', he: 'מפת התורה', href: '/mapjs', icon: '🗺️', desc: 'Explore relationships among concepts, books, and teachings.' },
      { title: 'Torah Lens', he: 'עדשת תורה', href: '/torah-lens', icon: '🔭', desc: 'See a subject through multiple Torah sources.' },
      { title: 'Topics', he: 'נושאים', href: '/topics', icon: '☰', desc: 'Browse teachings by subject.' },
      { title: 'Reference Library', he: 'ספרי יסוד', href: '/reference', icon: '📖', desc: 'Tanach, Talmud, Mishna, Zohar, Rambam, Ramchal, and more.' },
      { title: 'Parsha', he: 'פרשת השבוע', href: '/parsha', icon: '📜', desc: 'Weekly Torah portions with selected Breslov teachings.' },
      { title: 'Daily Study', he: 'לימוד יומי', href: '/daily-study', icon: '📅', desc: 'A direct daily learning path.' },
    ]
  },
  {
    id: 'practice', title: 'Prayer and practical help', icon: '🙏', intro: 'Immediate resources for prayer, strengthening, and daily avodah.',
    links: [
      { title: 'Prayers for Every Need', he: 'תפילות לכל צורך', href: '/prayers', icon: '🙏', desc: 'Find Likutay Tefilos by situation and subject.' },
      { title: 'Tikkun HaKlali', he: 'תיקון הכללי', href: '/tikkun-klali', icon: '🕊️', desc: 'The ten Psalms with Hebrew, transliteration, and English.' },
      { title: 'Help Me', he: 'עזרו לי', href: '/help-me', icon: '💚', desc: 'Torah guidance for fear, sadness, livelihood, faith, and other needs.' },
      { title: 'Healing Words', he: 'דברי מרפא', href: '/healing-words', icon: '🩹', desc: 'Short strengthening teachings for difficult moments.' },
      { title: 'Ask', he: 'שאל', href: '/ask', icon: '💬', desc: 'Ask a question and discover relevant site resources.' },
      { title: 'My Notes', he: 'ההערות שלי', href: '/my-notes', icon: '📝', desc: 'Keep and revisit personal study notes on this device.' },
    ]
  },
  {
    id: 'media', title: 'Pictures, video, audio, and stories', icon: '🎬', intro: 'Visual and audio doors into Breslov and Na Nach.',
    links: [
      { title: 'Gallery', he: 'גלריה', href: '/gallery', icon: '🖼️', desc: 'Rabbi Nachman, Saba Yisroel, Uman, Na Nach, events, and Hebrew image collections.' },
      { title: 'Videos', he: 'וידאו', href: '/videos', icon: '🎬', desc: 'Breslov and Na Nach video library.' },
      { title: 'Kokhvei Or — The Last Journey', he: 'הנסיעה האחרונה', href: '/reader/kokhvei-or/1/11#seg-25', icon: '🎞️', desc: 'Rabbi Avraham bar Nachman’s parable about preparing provisions for life’s final journey, with English subtitles, direct attribution, and full rights acknowledgment.' },
      { title: 'The Life of Our Leader Rabbi Nachman §447 — The Great Wealthy Man', he: 'הגביר הגדול', href: '/reader/chayey-moharan/siman/447', icon: '🎞️', desc: 'Rabbi Nachman’s parable about speaking with others concerning fear of Heaven, with English subtitles, direct attribution, and full rights acknowledgment.' },
      { title: 'Likutay Moharan II:46 — The Walls Are Only an Illusion', he: 'אין שום חומה', href: '/reader/likutay-moharan/2/46#seg-17', icon: '🎞️', desc: 'The Baal Shem Tov’s parable as cited by Rabbi Nachman, in an adapted Hebrew video with English subtitles and full attribution.' },
      { title: 'Likutay Halachos — Hope Through the True Tzaddikim', he: 'יש לנו תקוה בכל דור על ידי הצדיקי אמת', href: '/reader/likutay-halachos/2/37#seg-9', icon: '🎞️', desc: 'Specific Blessings 5:3 in a Hebrew teaching video with English subtitles, direct source attribution, and full rights acknowledgment.' },
      { title: 'Words of Rabbi Nachman §78 — Teaching Video', he: 'שיחות הר״ן ע״ח — סרטון', href: '/reader/sichos-haran/1/78', icon: '🎞️', desc: 'A cinematic Hebrew presentation with English subtitles, exact source text, and visible attribution.' },
      { title: 'Shivchay HaRan §63 — The King’s Secret Message', he: 'שבחי הר״ן ס״ג — דבר סתר', href: '/reader/shivchay-haran/1/63', icon: '🎞️', desc: 'Rabbi Nachman’s concluding parable in Shivchay HaRan, with its teaching video and Archive.org source.' },
      { title: 'Saba Says', he: 'סבא אומר', href: '/saba-says', icon: '🎙️', desc: 'Direct words and audio-centered teachings from Saba Yisroel.' },
      { title: 'Sefer HaMidos Media', he: 'תמונות, סרטונים ושירים', href: '/reader/sefer-hamidos/1/1', icon: '🎵', desc: 'Pictures, genuine teaching videos, and songs attached directly to Sefer HaMidos teachings.' },
      { title: 'Na Nach Blog', he: 'בלוג נ נח', href: '/blog', icon: '✍️', desc: 'Teachings, updates, and new productions.' },
      { title: 'Tzaddikim and Yahrzeits', he: 'צדיקים וימי הילולא', href: '/tzaddikim', icon: '🕯️', desc: 'Biographies, dates, and historical connections.' },
    ]
  },
  {
    id: 'extras', title: 'More ways in', icon: '✨', intro: 'Interactive, technical, and portable access to the collection.',
    links: [
      { title: 'Published Books', he: 'ספרים שיצאו לאור', href: '/books', icon: '📕', desc: 'Read ajew.org books and publishing projects in dedicated book editions.' },
      { title: 'ajew ananach App', he: 'אפליקציית נ נח', href: 'https://github.com/petteknanach/ajew-ananach/releases', icon: '📱', desc: 'Install the free bilingual, offline-capable mobile library.', external: true },
      { title: 'Gematria Calculator', he: 'גימטריה', href: '/gematria', icon: '🔢', desc: 'Calculate and compare Hebrew values with several methods.' },
      { title: 'Breslov Trivia', he: 'חידון ברסלב', href: '/trivia', icon: '❓', desc: 'Test and grow your knowledge.' },
      { title: 'My Fire', he: 'האש שלי', href: '/my-flame', icon: '🔥', desc: 'Explore the Petek, Na Nach, and Saba Yisroel.' },
      { title: 'Plain-Text Library', he: 'ספרייה בטקסט פשוט', href: '/reader-plain/', icon: '📄', desc: 'Complete crawlable books in HTML, TXT, Markdown, and JSON.' },
      { title: 'AI Access Guide', he: 'גישה לבינה מלאכותית', href: '/ai.txt', icon: '🤖', desc: 'Exact instructions for machines and research tools to use the complete text.' },
      { title: 'What’s New', he: 'מה חדש', href: '/whats-new', icon: '🆕', desc: 'Recent additions and improvements.' },
    ]
  }
];

const allLinks = sections.flatMap(section => section.links);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Rabbi Nachman of Breslov Resources',
  description: 'Complete guide to ajew.org’s Rabbi Nachman and Breslov books, summaries, multimedia, NotebookLM study material, diagrams, timelines, search tools, prayer, and reference resources.',
  url: 'https://ajew.org/resources',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allLinks.length,
    itemListElement: allLinks.map((item, index) => ({
      '@type': 'ListItem', position: index + 1, name: item.title,
      url: item.href.startsWith('http') ? item.href : `https://ajew.org${item.href}`
    }))
  }
};
---

<Layout
  title="Rabbi Nachman of Breslov Resources — Books, Media & Study Tools"
  description="One-page access to ajew.org’s complete Rabbi Nachman and Breslov resources: books, Likutay Halachos summaries, Ebay HaNachal, NotebookLM studies, Geedoolay HaNachal diagrams and timelines, Sefer HaMidos media, search, prayer, gallery, and more."
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Resources', url: '/resources' }]}
>
  <div class="resource-page">
    <a class="campaign-banner" href="/one-library-many-doorways" aria-label="Open the One Library, Many Doorways campaign">
      <picture>
        <source media="(max-width: 620px)" srcset="/images/campaigns/one-library-many-doorways/03_vertical_story_1080x1920.png" />
        <img src="/images/campaigns/one-library-many-doorways/01_banner_16x9_1920x1080.png" alt="One Library, Many Doorways — explore books, bilingual texts, prayer, search, media, and open Torah tools" />
      </picture>
    </a>
    <header class="resource-hero">
      <p class="eyebrow">ajew.org · One-page directory</p>
      <h1>Rabbi Nachman &amp; Breslov Resources</h1>
      <p class="hero-he" lang="he" dir="rtl">כל האוצרות במקום אחד</p>
      <p class="lead">Books, exact bilingual texts, summaries, diagrams, timelines, NotebookLM study material, pictures, videos, songs, search tools, and practical help.</p>
      <nav class="jump-nav" aria-label="Jump to a resource section">
        {sections.map(section => <a href={`#${section.id}`}>{section.icon} {section.title}</a>)}
      </nav>
    </header>

    {sections.map(section => (
      <section id={section.id} class="resource-section" aria-labelledby={`${section.id}-title`}>
        <div class="section-heading">
          <span aria-hidden="true">{section.icon}</span>
          <div><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.intro}</p></div>
        </div>
        <div class="resource-grid">
          {section.links.map(item => (
            <a class="resource-card" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
              <span class="card-icon" aria-hidden="true">{item.icon}</span>
              <span class="card-copy">
                <strong>{item.title}</strong>
                <span class="card-he" lang="he" dir="rtl">{item.he}</span>
                <span class="card-desc">{item.desc}</span>
              </span>
              <span class="arrow" aria-hidden="true">{item.external ? '↗' : '→'}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .resource-page { max-width: 1120px; margin: 0 auto; padding: 1.25rem 1rem 4rem; color: var(--text-primary, #1f2937); }
  .campaign-banner { display: block; overflow: hidden; margin-bottom: 1.25rem; border-radius: 18px; box-shadow: 0 10px 30px rgba(16,44,80,.18); }
  .campaign-banner:focus-visible { outline: 4px solid #d4a017; outline-offset: 4px; }
  .campaign-banner img { display: block; width: 100%; height: auto; }
  .resource-hero { border-radius: 22px; padding: clamp(1.5rem, 5vw, 3.5rem); text-align: center; color: white; background: linear-gradient(145deg, #102c50, #1d4f75 70%, #8b6514); box-shadow: 0 12px 35px rgba(16,44,80,.24); }
  .eyebrow { margin: 0 0 .65rem; color: #f4d77a; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .78rem; }
  h1 { margin: 0; font-family: Georgia, serif; font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.05; }
  .hero-he { margin: .6rem 0 0; color: #f4d77a; font-family: var(--font-hebrew, serif); font-size: clamp(1.35rem, 4vw, 2rem); }
  .lead { max-width: 760px; margin: 1rem auto 1.4rem; color: rgba(255,255,255,.9); font-size: clamp(1rem, 2.5vw, 1.18rem); line-height: 1.65; }
  .jump-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; }
  .jump-nav a { color: white; text-decoration: none; border: 1px solid rgba(255,255,255,.28); background: rgba(255,255,255,.1); border-radius: 999px; padding: .55rem .8rem; font-size: .82rem; }
  .jump-nav a:hover, .jump-nav a:focus-visible { background: #f4d77a; color: #102c50; }
  .resource-section { scroll-margin-top: 1rem; padding-top: 2.7rem; }
  .section-heading { display: flex; gap: .8rem; align-items: flex-start; margin-bottom: 1rem; }
  .section-heading > span { font-size: 1.8rem; line-height: 1.2; }
  .section-heading h2 { margin: 0; color: #173a61; font-family: Georgia, serif; font-size: clamp(1.45rem, 4vw, 2rem); }
  .section-heading p { margin: .3rem 0 0; color: #667085; line-height: 1.5; }
  .resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .resource-card { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: .75rem; align-items: start; min-width: 0; padding: 1rem; color: inherit; text-decoration: none; border: 1px solid #e1d8c7; border-radius: 14px; background: #fffdfa; box-shadow: 0 2px 10px rgba(25,42,62,.05); transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease; }
  .resource-card:hover, .resource-card:focus-visible { transform: translateY(-2px); border-color: #d4a017; box-shadow: 0 7px 20px rgba(25,42,62,.12); outline: none; }
  .card-icon { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: 10px; background: #f5ead0; font-size: 1.25rem; }
  .card-copy { display: flex; flex-direction: column; min-width: 0; }
  .card-copy strong { color: #173a61; font-size: 1.05rem; line-height: 1.3; }
  .card-he { color: #8b6514; font-family: var(--font-hebrew, serif); font-size: .94rem; margin-top: .1rem; }
  .card-desc { color: #5f6875; font-size: .9rem; line-height: 1.5; margin-top: .45rem; }
  .arrow { color: #ad7e0a; font-weight: 800; font-size: 1.15rem; }
  :global(body.dark-mode) .resource-page { color: #e7e8eb; }
  :global(body.dark-mode) .section-heading h2, :global(body.dark-mode) .card-copy strong { color: #f4d77a; }
  :global(body.dark-mode) .section-heading p, :global(body.dark-mode) .card-desc { color: #bcc2cc; }
  :global(body.dark-mode) .resource-card { background: #202434; border-color: #3b4052; }
  :global(body.dark-mode) .card-icon { background: #30364b; }
  @media (max-width: 720px) {
    .resource-page { padding: .75rem .75rem 5.5rem; }
    .campaign-banner { max-width: 390px; margin: 0 auto 1rem; border-radius: 14px; }
    .resource-hero { border-radius: 16px; padding: 1.6rem .9rem; }
    .jump-nav { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; padding-bottom: .35rem; scroll-snap-type: x proximity; }
    .jump-nav a { flex: 0 0 auto; scroll-snap-align: start; }
    .resource-grid { grid-template-columns: 1fr; }
    .resource-card { padding: .9rem; grid-template-columns: 2.2rem 1fr auto; }
  }
  @media (prefers-reduced-motion: reduce) { .resource-card { transition: none; } }
</style>
