<script is:inline>
(function() {
  try {
    var hist = JSON.parse(localStorage.getItem('ajew-reading-history') || '[]');
    if (hist.length > 0) {
      var last = hist[0];
      if (last.url && last.url.startsWith('/reader/')) {
        var sec = document.getElementById('continue-section');
        sec.style.display = 'block';
        document.getElementById('continue-card').href = last.url;
        document.getElementById('continue-title').textContent = last.title || 'Unknown';
        document.getElementById('continue-book').textContent = last.book || '';
        if (last.progress > 0) document.getElementById('continue-fill').style.width = Math.min(last.progress, 100) + '%';
        if (last.timestamp) {
          var diff = Date.now() - parseInt(last.timestamp);
          var hrs = Math.floor(diff / 3600000);
          document.getElementById('continue-ago').textContent = hrs < 1 ? 'Just now' : hrs < 24 ? hrs + 'h ago' : Math.floor(hrs / 24) + 'd ago';
        }
      }
    }
  } catch(e) {}
})();
</script>

<style>
  /* ============================================
     HERO — Uman tzion background, full viewport
     ============================================ */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    overflow: hidden;
    background: url('/images/tomb-uman/uman-wide-tzion.jpg') center center / cover no-repeat;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15,39,68,0.82) 0%, rgba(26,54,93,0.70) 50%, rgba(15,39,68,0.88) 100%);
    z-index: 0;
    pointer-events: none;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }
  .hero-content {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .hero-nanach {
    font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif);
    font-size: 1.6rem;
    direction: rtl;
    margin-bottom: 1rem;
    animation: fireFlicker 1.5s ease-in-out infinite, fireRise 2s ease-in-out infinite;
    background: linear-gradient(180deg, #ffee88 0%, #ff8800 40%, #ff4400 70%, #cc0000 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 8px rgba(255, 100, 0, 0.7));
  }
  .hero-huaish-sheli {
    margin: 0.6rem auto 1.15in;
    max-width: 140px;
    animation: huaishFire 2s ease-in-out infinite;
    filter: drop-shadow(0 0 15px rgba(255, 80, 0, 0.9)) drop-shadow(0 0 30px rgba(255, 40, 0, 0.6)) drop-shadow(0 -5px 20px rgba(255, 200, 0, 0.8));
    transition: transform 0.3s ease;
  }
  .hero-huaish-sheli:hover {
    transform: scale(1.08);
  }
  .huaish-sheli-img {
    width: 100%;
    height: auto;
    display: block;
    animation: fireFlicker 1.8s ease-in-out infinite;
  }
  @keyframes huaishFire {
    0%   { filter: drop-shadow(0 0 15px rgba(255, 80, 0, 0.9)) drop-shadow(0 0 30px rgba(255, 40, 0, 0.6)) drop-shadow(0 -5px 20px rgba(255, 200, 0, 0.8)); transform: translateY(0) scale(1); }
    15%  { filter: drop-shadow(0 0 20px rgba(255, 100, 0, 1)) drop-shadow(0 0 35px rgba(255, 60, 0, 0.7)) drop-shadow(0 -8px 25px rgba(255, 220, 0, 0.9)); transform: translateY(-2px) scale(1.01); }
    30%  { filter: drop-shadow(0 0 12px rgba(255, 60, 0, 0.8)) drop-shadow(0 0 25px rgba(255, 20, 0, 0.5)) drop-shadow(0 -3px 15px rgba(255, 180, 0, 0.7)); transform: translateY(-1px) scale(1.005); }
    45%  { filter: drop-shadow(0 0 22px rgba(255, 120, 0, 1)) drop-shadow(0 0 40px rgba(255, 70, 0, 0.8)) drop-shadow(0 -10px 30px rgba(255, 240, 0, 1)); transform: translateY(-3px) scale(1.02); }
    60%  { filter: drop-shadow(0 0 10px rgba(255, 50, 0, 0.7)) drop-shadow(0 0 20px rgba(255, 10, 0, 0.4)) drop-shadow(0 -2px 12px rgba(255, 160, 0, 0.6)); transform: translateY(-1px) scale(1); }
    75%  { filter: drop-shadow(0 0 18px rgba(255, 90, 0, 0.95)) drop-shadow(0 0 32px rgba(255, 50, 0, 0.65)) drop-shadow(0 -6px 22px rgba(255, 210, 0, 0.85)); transform: translateY(-2px) scale(1.015); }
    100% { filter: drop-shadow(0 0 15px rgba(255, 80, 0, 0.9)) drop-shadow(0 0 30px rgba(255, 40, 0, 0.6)) drop-shadow(0 -5px 20px rgba(255, 200, 0, 0.8)); transform: translateY(0) scale(1); }
  }
  .hero-title { margin: 0 0 0.75rem; }
  .hero-he {
    font-family: var(--font-hebrew, 'Frank Ruhl Libre', serif);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--gold-light, #f0cc5c);
    direction: rtl;
    display: block;
    margin-bottom: 4px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }
  .hero-en {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: white;
    display: block;
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }
  .hero-subtitle {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.9);
