      books: [
        { name: "דרשות מטשערין", filename: "דרשות מטשערין.txt" },
        { name: "דרשות מטשערין ב", filename: "דרשות מטשערין ב.txt" },
        { name: "מכתבים מטשערין", filename: "מכתבים מטשערין.txt" },
        { name: "מכתבים מטשערין ב", filename: "מכתבים מטשערין ב.txt" },
        { name: "שיחות מטשערין", filename: "שיחות מטשערין.txt" },
        { name: "שיחות מטשערין ב", filename: "שיחות מטשערין ב.txt" }
      ]
    },
