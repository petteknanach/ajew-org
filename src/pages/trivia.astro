---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Torah Trivia" description="Test your Torah knowledge! Multiple levels, timed questions, and high scores. Play for fun or register to compete!">
  <div class="trivia-page">
    <!-- ========== SPLASH / MENU SCREEN ========== -->
    <div id="menuScreen" class="screen active">
      <header class="page-header">
        <div class="lang-toggle">
          <button id="langToggle" class="lang-btn" title="Switch language">
            <span class="lang-en active">EN</span>
            <span class="lang-divider">|</span>
            <span class="lang-he">עב</span>
          </button>
        </div>
        <h1>🔥 <span data-en="Torah Trivia" data-he="טריוויה תורנית">Torah Trivia</span> 🔥</h1>
        <p class="subtitle" data-en="Test your knowledge of Breslov teachings" data-he="בחנו את הידע שלכם בתורות ברסלב">Test your knowledge of Breslov teachings</p>
        <p class="tagline" data-en="How well do you know Rebbe Nachman and his teachings?" data-he="כמה אתה מכיר את רבי נחמן ותורותיו?">How well do you know Rebbe Nachman and his teachings?</p>
      </header>

      <div class="menu-container">
        <div class="level-select">
          <h2 data-en="Choose Your Level" data-he="בחר את הרמה שלך">Choose Your Level</h2>
          <div class="level-cards">
            <button class="level-card" data-level="1">
              <span class="level-icon">🌱</span>
              <span class="level-name">Beginners</span>
              <span class="level-desc">Rebbe Nachman basics & life story</span>
              <span class="level-timer">30 sec per question</span>
            </button>
            <button class="level-card" data-level="2">
              <span class="level-icon">📖</span>
              <span class="level-name">Intermediate</span>
              <span class="level-desc">The Stories, Talmidim & Breslov History</span>
              <span class="level-timer">25 sec per question</span>
            </button>
            <button class="level-card" data-level="3">
              <span class="level-icon">🧠</span>
              <span class="level-name">Advanced</span>
              <span class="level-desc">Likutay Moharan, Teachings & Concepts</span>
              <span class="level-timer">20 sec per question</span>
            </button>
            <button class="level-card" data-level="4">
              <span class="level-icon">👑</span>
              <span class="level-name">Na Nach Master</span>
              <span class="level-desc">The Petek, Saba, Deep Torahs & Gematrios</span>
              <span class="level-timer">15 sec per question</span>
            </button>
          </div>
        </div>

        <div class="topic-select">
          <h2 data-en="Choose Topics" data-he="בחר נושאים">Choose Topics</h2>
          <div class="topic-chips">
            <button class="topic-chip active" data-topic="all">🔥 Everything</button>
            <button class="topic-chip" data-topic="life">📜 Life of Rabbeinu</button>
            <button class="topic-chip" data-topic="lm">📖 Likutay Moharan</button>
            <button class="topic-chip" data-topic="stories">🏰 Sipurey Maasiyos</button>
            <button class="topic-chip" data-topic="nanach">🎵 Na Nach & The Petek</button>
            <button class="topic-chip" data-topic="talmidim">👥 Talmidim & History</button>
            <button class="topic-chip" data-topic="chm">📝 Chayay Moharan</button>
            <button class="topic-chip" data-topic="sichos">💬 Sichos HaRan</button>
            <button class="topic-chip" data-topic="shivchay">🌟 Shivchay HaRan</button>
            <button class="topic-chip" data-topic="midos">📕 Sefer HaMiddos</button>
            <button class="topic-chip" data-topic="sefarim">📚 Breslov Sefarim</button>
            <button class="topic-chip" data-topic="gematria">🔢 Gematrios</button>
          </div>
        </div>

        <div class="play-mode-select">
          <button id="playForFun" class="play-btn fun-btn start-btn">
            <span class="start-icon">🎮</span>
            <span class="start-text">START — Play for Fun</span>
          </button>
          <button id="playCompetitive" class="play-btn compete-btn start-btn">
            <span class="start-icon">🏆</span>
            <span class="start-text">START — Play to Compete</span>
            <small>Register to appear on the leaderboard</small>
          </button>
        </div>
      </div>

      <div class="leaderboard-preview" id="leaderboardPreview">
        <h2>🏆 Top Scores</h2>
        <div class="leaderboard-tabs">
          <button class="lb-tab active" data-lb-level="all">All</button>
          <button class="lb-tab" data-lb-level="1">🌱</button>
          <button class="lb-tab" data-lb-level="2">📖</button>
          <button class="lb-tab" data-lb-level="3">🧠</button>
          <button class="lb-tab" data-lb-level="4">👑</button>
        </div>
        <div id="leaderboardList" class="leaderboard-list">
          <p class="empty-lb">No scores yet — be the first!</p>
        </div>
      </div>
    </div>

    <!-- ========== REGISTRATION MODAL ========== -->
    <div id="registerModal" class="modal hidden">
      <div class="modal-content">
        <button class="modal-close" id="closeRegister">✕</button>
        <h2>Register to Compete</h2>
        <p>Your scores will appear on the leaderboard!</p>
        <form id="registerForm">
          <div class="form-group">
            <label for="playerName">Display Name</label>
            <input type="text" id="playerName" placeholder="Your name..." maxlength="20" required />
          </div>
          <div class="form-group">
            <label for="playerEmail">Email (optional, for score recovery)</label>
            <input type="email" id="playerEmail" placeholder="email@example.com" />
          </div>
          <button type="submit" class="play-btn compete-btn">Start Game! 🚀</button>
        </form>
      </div>
    </div>

    <!-- ========== GAME SCREEN ========== -->
    <div id="gameScreen" class="screen hidden">
      <div class="game-hud">
        <div class="hud-item">
          <span class="hud-label" data-en="Score" data-he="ניקוד">Score</span>
          <span class="hud-value" id="scoreDisplay">0</span>
        </div>
        <div class="hud-item timer-hud">
          <div class="timer-ring" id="timerRing">
            <svg viewBox="0 0 100 100">
              <circle class="timer-bg" cx="50" cy="50" r="45"/>
              <circle class="timer-progress" cx="50" cy="50" r="45" id="timerCircle"/>
            </svg>
            <span class="timer-text" id="timerText">30</span>
          </div>
        </div>
        <div class="hud-item">
          <span class="hud-label" data-en="Question" data-he="שאלה">Question</span>
          <span class="hud-value"><span id="questionNum">1</span>/<span id="totalQuestions">10</span></span>
        </div>
      </div>

      <div class="streak-bar" id="streakBar">
        <span id="streakText">🔥 Streak: 0</span>
      </div>

      <div class="question-area">
        <div class="question-category" id="questionCategory"></div>
        <h2 class="question-text" id="questionText"></h2>
        <div class="answers-grid" id="answersGrid"></div>
      </div>

      <div class="question-feedback hidden" id="feedback">
        <div class="feedback-icon" id="feedbackIcon"></div>
        <div class="feedback-text" id="feedbackText"></div>
        <div class="feedback-source" id="feedbackSource"></div>
      </div>
    </div>

    <!-- ========== RESULTS SCREEN ========== -->
    <div id="resultsScreen" class="screen hidden">
      <div class="results-container">
        <div class="results-header">
          <h1 id="resultsTitle">Great Job!</h1>
          <div class="final-score-display">
            <span class="final-score-label" data-en="Final Score" data-he="ניקוד סופי">Final Score</span>
            <span class="final-score-value" id="finalScore">0</span>
          </div>
        </div>

        <div class="results-stats">
          <div class="stat-card">
            <span class="stat-value" id="correctCount">0</span>
            <span class="stat-label" data-en="Correct" data-he="נכון">Correct</span>
          </div>
          <div class="stat-card">
            <span class="stat-value" id="wrongCount">0</span>
            <span class="stat-label" data-en="Wrong" data-he="שגוי">Wrong</span>
          </div>
          <div class="stat-card">
            <span class="stat-value" id="bestStreak">0</span>
            <span class="stat-label" data-en="Best Streak" data-he="רצף הכי טוב">Best Streak</span>
          </div>
          <div class="stat-card">
            <span class="stat-value" id="avgTime">0s</span>
            <span class="stat-label" data-en="Avg. Time" data-he="זמן ממוצע">Avg. Time</span>
          </div>
        </div>

        <div class="results-rank" id="resultsRank"></div>

        <div class="results-actions">
          <button id="playAgain" class="play-btn fun-btn" data-en="Play Again 🔄" data-he="🔄 שחק שוב">Play Again 🔄</button>
          <button id="backToMenu" class="play-btn" data-en="Back to Menu" data-he="חזרה לתפריט">Back to Menu</button>
          <button id="shareScore" class="play-btn compete-btn" data-en="Share Score 📤" data-he="📤 שתף ניקוד">Share Score 📤</button>
        </div>

        <div class="results-review" id="resultsReview">
          <h3 data-en="Review Your Answers" data-he="סקירת התשובות שלך">Review Your Answers</h3>
          <div id="reviewList"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
  (function() {
    // ==================== QUESTION DATABASE ====================
    // Each question has: q, a, correct, cat, source, topics[]
    // Topics: life, lm, stories, nanach, talmidim, chm, sichos, shivchay, midos, sefarim, gematria
    const questions = {
      1: [
        { q: "Where was Rabbi Nachman of Breslov born?", a: ["Medzhibozh, Ukraine","Breslov, Ukraine","Jerusalem","Uman, Ukraine"], correct: 0, cat: "Life of Rabbeinu", source: "Born 1 Nissan 5532 (1772) in Medzhibozh, birthplace of the Baal Shem Tov", topics: ["life","chm"], qHe: "היכן נולד רבי נחמן מברסלב?", aHe: ["מעז׳יבוז׳, אוקראינה","ברסלב, אוקראינה","ירושלים","אומן, אוקראינה"] },
        { q: "Who was Rabbi Nachman's famous great-grandfather?", a: ["The Baal Shem Tov","The Vilna Gaon","The Rambam","The Arizal"], correct: 0, cat: "Life of Rabbeinu", source: "Rabbi Nachman was the great-grandson of the Baal Shem Tov through his mother", topics: ["life","shivchay"], qHe: "מי היה סב-רבו המפורסם של רבי נחמן?", aHe: ["הבעל שם טוב","הגאון מוילנא","הרמב״ם","האריז״ל"] },
        { q: "What is Rabbi Nachman's main teaching work called?", a: ["Likutay Moharan","Likutay Halachos","Sipurey Maasiyos","Sefer HaMiddos"], correct: 0, cat: "Sefarim", source: "The collected teachings of Rebbe Nachman of Breslov", topics: ["sefarim","lm"], qHe: "מהו ספר התורות העיקרי של רבי נחמן?", aHe: ["ליקוטי מוהר״ן","ליקוטי הלכות","סיפורי מעשיות","ספר המידות"] },
        { q: "What city is Rabbi Nachman buried in?", a: ["Uman, Ukraine","Breslov, Ukraine","Jerusalem","Medzhibozh, Ukraine"], correct: 0, cat: "Life of Rabbeinu", source: "Passed away in Uman, 18 Tishrei 5571 (1810)", topics: ["life","chm"], qHe: "באיזו עיר קבור רבי נחמן?", aHe: ["אומן, אוקראינה","ברסלב, אוקראינה","ירושלים","מעז׳יבוז׳, אוקראינה"] },
        { q: "What is 'Hisbodidus'?", a: ["Personal prayer and conversation with Hashem in seclusion","Group meditation","Silent Torah study","A type of fast"], correct: 0, cat: "Teachings", source: "Likutay Moharan II:25", topics: ["lm","sichos"], qHe: "מהי 'התבודדות'?", aHe: ["תפילה אישית ושיחה עם ה' בהתבודדות","מדיטציה קבוצתית","לימוד תורה בשקט","סוג של תענית"] },
        { q: "How many stories did Rabbi Nachman tell?", a: ["13","7","10","18"], correct: 0, cat: "Stories", source: "The 13 stories of ancient times (Sipurey Maasiyos)", topics: ["stories"], qHe: "כמה סיפורים סיפר רבי נחמן?", aHe: ["13","7","10","18"] },
        { q: "Who was Reb Noson?", a: ["Rabbi Nachman's primary student who recorded his teachings","Rabbi Nachman's father","A rival of Rabbi Nachman","The rabbi of Breslov"], correct: 0, cat: "Talmidim", source: "Reb Noson of Nemirov (1780-1844), chief disciple", topics: ["talmidim","sefarim"], qHe: "מי היה רבי נתן?", aHe: ["תלמידו העיקרי של רבי נחמן שרשם את תורותיו","אביו של רבי נחמן","מתנגד של רבי נחמן","רב העיר ברסלב"] },
        { q: "What holiday did Rabbi Nachman say is most important to be with him?", a: ["Rosh Hashanah","Pesach","Shavuos","Yom Kippur"], correct: 0, cat: "Teachings", source: "The Rosh Hashanah kibbutz in Uman", topics: ["life","chm","sichos"], qHe: "באיזה חג אמר רבי נחמן שהכי חשוב להיות איתו?", aHe: ["ראש השנה","פסח","שבועות","יום כיפור"] },
        { q: "What did Rabbi Nachman say is a great mitzvah?", a: ["To always be happy (b'simcha)","To learn Torah all day","To fast frequently","To live in Eretz Yisrael"], correct: 0, cat: "Teachings", source: "LM II:24 — mitzvah gedolah lihiyos b'simcha tamid", topics: ["lm","sichos"], qHe: "מה אמר רבי נחמן שזו מצווה גדולה?", aHe: ["להיות בשמחה תמיד","ללמוד תורה כל היום","להתענות הרבה","לגור בארץ ישראל"] },
        { q: "What is the Tikkun HaKlali?", a: ["10 specific Psalms for general spiritual repair","A prayer said at midnight","A special fast","A mikveh immersion"], correct: 0, cat: "Teachings", source: "Psalms: 16, 32, 41, 42, 59, 77, 90, 105, 137, 150", topics: ["lm","sefarim"], qHe: "מהו התיקון הכללי?", aHe: ["10 פרקי תהילים לתיקון כללי","תפילה שאומרים בחצות","תענית מיוחדת","טבילה במקווה"] },
        { q: "What does 'Breslov' refer to?", a: ["The city where Rabbi Nachman established his community","Rabbi Nachman's family name","A type of prayer","A book of teachings"], correct: 0, cat: "Life of Rabbeinu", source: "Settled in Breslov, Ukraine in 1802", topics: ["life"], qHe: "למה מתייחס השם 'ברסלב'?", aHe: ["העיר בה רבי נחמן ייסד את קהילתו","שם משפחתו של רבי נחמן","סוג של תפילה","ספר תורות"] },
        { q: "What is Sefer HaMiddos?", a: ["Rabbi Nachman's book of character traits arranged alphabetically","A Talmudic tractate","A prayer book","A book of stories"], correct: 0, cat: "Sefarim", source: "The Book of Attributes — practical advice by topic", topics: ["midos","sefarim"], qHe: "מהו ספר המידות?", aHe: ["ספר מידות של רבי נחמן מסודר לפי א״ב","מסכת בתלמוד","סידור תפילה","ספר סיפורים"] },
        { q: "At what age did Rabbi Nachman pass away?", a: ["38","45","52","70"], correct: 0, cat: "Life of Rabbeinu", source: "Born 1772, passed away 1810", topics: ["life","chm"], qHe: "בן כמה היה רבי נחמן כשנפטר?", aHe: ["38","45","52","70"] },
        { q: "What is Likutay Tefilos?", a: ["Prayers by Reb Noson based on Likutay Moharan","Rabbi Nachman's diary","A collection of Psalms","A Talmud commentary"], correct: 0, cat: "Sefarim", source: "Reb Noson transformed each Torah teaching into a prayer", topics: ["sefarim","talmidim"], qHe: "מהו ליקוטי תפילות?", aHe: ["תפילות שחיבר רבי נתן על פי ליקוטי מוהר״ן","יומנו האישי של רבי נחמן","אוסף תהילים","פירוש על התלמוד"] },
        { q: "What famous saying begins with 'The whole world...'?", a: ["The whole world is a very narrow bridge","The whole world is full of Torah","The whole world needs joy","The whole world is watching"], correct: 0, cat: "Teachings", source: "LM II:48 — and the main thing is not to fear at all", topics: ["lm"], qHe: "איזה פתגם מפורסם מתחיל ב'כל העולם כולו...'?", aHe: ["כל העולם כולו גשר צר מאוד","כל העולם כולו מלא תורה","כל העולם כולו צריך שמחה","כל העולם כולו צופה"] },
        { q: "What is 'Azamra'?", a: ["Finding good points in every Jew","A Breslov niggun","A type of prayer","A city in Ukraine"], correct: 0, cat: "Teachings", source: "LM I:282 — 'I will sing to my G-d with what I have left'", topics: ["lm"], qHe: "מהי תורת 'אזמרה'?", aHe: ["למצוא נקודות טובות בכל יהודי","סוג של ניגון ברסלבי","שם של תפילה","עיר באוקראינה"] },
        { q: "Where do thousands travel every Rosh Hashanah?", a: ["Uman, Ukraine","Meron, Israel","Breslov, Ukraine","Medzhibozh"], correct: 0, cat: "Breslov Today", source: "The annual kibbutz at Rabbi Nachman's tziyun", topics: ["life","nanach"], qHe: "לאן נוסעים אלפים כל ראש השנה?", aHe: ["אומן, אוקראינה","מירון, ישראל","ברסלב, אוקראינה","מעז׳יבוז׳"] },
        { q: "Who wrote Likutay Halachos?", a: ["Reb Noson","Rabbi Nachman","Rabbi Naftali","Reb Shmuel Isaac"], correct: 0, cat: "Sefarim", source: "Connecting Shulchan Aruch to Likutay Moharan", topics: ["sefarim","talmidim"], qHe: "מי כתב את ליקוטי הלכות?", aHe: ["רבי נתן","רבי נחמן","רבי נפתלי","רבי שמואל יצחק"] },
        { q: "In Sefer HaMiddos, under which letter is 'Emunah' (faith)?", a: ["Aleph (א)","Bet (ב)","Mem (מ)","Shin (ש)"], correct: 0, cat: "Sefer HaMiddos", source: "Arranged alphabetically — Emunah under Aleph", topics: ["midos"], qHe: "בספר המידות, תחת איזו אות נמצא 'אמונה'?", aHe: ["אל״ף (א)","בי״ת (ב)","מ״ם (מ)","שי״ן (ש)"] },
        { q: "In Sichos HaRan, what does Rabbi Nachman say about simplicity?", a: ["Simplicity is the highest wisdom","It is only for beginners","It should be outgrown","It is less important than learning"], correct: 0, cat: "Sichos HaRan", source: "Sichos HaRan — temimus (simplicity) is extremely precious", topics: ["sichos"], qHe: "בשיחות הר״ן, מה אמר רבי נחמן על תמימות?", aHe: ["תמימות היא החכמה הגבוהה ביותר","זה רק למתחילים","צריך להתגבר על זה","זה פחות חשוב מלימוד"] },
      ],
      2: [
        { q: "What is the first of Rabbi Nachman's 13 stories?", a: ["The Lost Princess","The Seven Beggars","The Master of Prayer","The Sophisticate and the Simpleton"], correct: 0, cat: "Stories", source: "Sipurey Maasiyos — the search for the lost princess", topics: ["stories"], qHe: "מהו הסיפור הראשון מ-13 הסיפורים של רבי נחמן?", aHe: ["מעשה מאבידת בת מלך","שבעת הקבצנים","בעל תפילה","החכם והתם"] },
        { q: "In 'The Seven Beggars,' what does the first beggar claim?", a: ["He is blind","He is deaf","He cannot walk","He has no hands"], correct: 0, cat: "Stories", source: "Each beggar's 'defect' is actually a hidden perfection", topics: ["stories"], qHe: "ב'שבעת הקבצנים', מה טוען הקבצן הראשון?", aHe: ["שהוא עיוור","שהוא חירש","שהוא לא יכול ללכת","שאין לו ידיים"] },
        { q: "Who was Rabbi Naftali of Nemirov?", a: ["Rabbi Nachman's shamash who recorded stories","Rabbi Nachman's son","A misnaged","The rabbi of Uman"], correct: 0, cat: "Talmidim", source: "He wrote down the Sipurey Maasiyos", topics: ["talmidim","stories"], qHe: "מי היה רבי נפתלי מנמירוב?", aHe: ["משמשו של רבי נחמן שרשם את הסיפורים","בנו של רבי נחמן","מתנגד","רב אומן"] },
        { q: "What did Rabbi Nachman burn before passing away?", a: ["A manuscript of secret teachings","His tefillin","Letters from rebbes","His will"], correct: 0, cat: "Chayay Moharan", source: "The 'Sefer HaNisraf' — the burned book", topics: ["chm","life"], qHe: "מה שרף רבי נחמן לפני פטירתו?", aHe: ["כתב יד של תורות סודיות","את התפילין שלו","מכתבים מרבנים","את הצוואה שלו"] },
