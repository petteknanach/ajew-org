---
import Layout from '../../layouts/Layout.astro';

// Load master catalog and all book indexes
import fs from 'node:fs';
import path from 'node:path';

function loadJSON(filePath) {
  try {
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), filePath), 'utf8'));
  } catch (e) { return null; }
}

const masterCatalog = loadJSON('public/reader/catalog.json') || { books: [] };

// Load index for each book's parts
function loadBookIndexes(book) {
  const indexes = [];
  for (const part of book.parts) {
    const idx = loadJSON(part.indexUrl.replace(/^\//, 'public/'));
    if (idx) indexes.push({ ...part, index: idx });
  }
  return indexes;
}

// Group books by category
const categories = [
  { title: 'Rabbi Nachman of Breslov / רבי נחמן מברסלב', ids: ['likutay-moharan', 'kitzur-likutay-moharan', 'sefer-hamidos', 'sipurey-maasiyos', 'sipurey-maasiyos-english', 'sichos-haran', 'shivchay-haran', 'chayey-moharan', 'praises-of-rabbi-nachman', 'otzar-hayirah'] },
  { title: 'Rabbi Nosson of Breslov / רבי נתן מברסלב', ids: ['likutay-halachos', 'likutay-tefilos', 'likutay-eitzos', 'alim-litrufa', 'yemei-moharnat', 'shemos-hatzadikim', 'yemei-hatlaos', 'nosson-by-מכתבי-ר--נתן-ב--ר-יה', 'nosson-by-קונטרס-הצירופים-עם-ה', 'nosson-by-קונטרס-הצרופים'] },
  { title: 'Chumash with Likutey Halachos / חומש עם ליקוטי הלכות', ids: ['chumash-lh'] },
  { title: 'Rabbi Alter of Teplik / רבי אלתר טפליקער', ids: ['hashtatfchus-hanefesh', 'meshivas-nefesh'] },
  { title: 'Rabbi Nachman of Tcheryn / הרב מטשערין', ids: ['parparos-lechochma', 'rimzei-hamaasiyos', 'zimras-haaretz', 'yikra-dshabbata', 'yereach-haeitanim', 'nachas-hashulchan', 'likutay-eitzos-basra'] },
  { title: "Rabbi Avraham bar Nachman / רבי אברהם בר' נחמן", ids: ['biur-halikutim', 'chochma-utvuna', 'kokhvei-or'] },
  { title: "R' Shimshon Barsky / ר' שמשון בארסקי", ids: ['shimshon-גבורות-שמשון', 'shimshon-עצות-המבוארות', 'gevuros-shimshon', 'aitzoas-hamivooaroas', 'aitzoas-yeshuroas'] },
  { title: 'Siach Sarfei Kodesh / שיח שרפי קודש', ids: ['siach-sarfei-kodesh'] },
  { title: 'Rabbi Yisroel Dov Odesser (Saba) / רבי ישראל דב אודסר זצ"ל', ids: ['ebay-hanachal', 'yisroel-saba', 'fires-of-israel', 'sichos-chayay-saba', 'saba-tape-transcripts', 'likutay-nanach', 'misc-אגרת-הפורים'] },
  { title: 'Likutay Nanach / ליקוטי נ נח', ids: ['likutay-nanach'] },
  { title: "R' Yitzchak Breiter / ר' יצחק ברייטער", ids: ['breiter-seder-hayom', 'seven-pillars', 'hisbodidus-alone-time', 'misc-שיר-ידידות-מר-יחיאל-מענדל'] },
  { title: "R' Yisroel Karduner / ר' ישראל קרדונר", ids: ['kuntrass-hiskashrus'] },
  { title: 'Michtevay Shmuel / מכתבי שמואל', ids: ['michtevay-shmuel'] },
  { title: 'Torah / תורה', ids: ['tanach-bereishit', 'tanach-shemos', 'tanach-vayikra', 'tanach-bamidbar', 'tanach-devarim'] },
  { title: "Nevi'im / נביאים", ids: ['tanach-yehoshua', 'tanach-shoftim', 'tanach-shmuel-a', 'tanach-shmuel-b', 'tanach-melachim-a', 'tanach-melachim-b', 'tanach-yeshayahu', 'tanach-yirmiyahu', 'tanach-yechezkel', 'tanach-hoshea', 'tanach-yoel', 'tanach-amos', 'tanach-ovadya', 'tanach-yonah', 'tanach-michah', 'tanach-nachum', 'tanach-havakkuk', 'tanach-tzefanya', 'tanach-chaggai', 'tanach-zecharya', 'tanach-malachi'] },
  { title: 'Ketuvim / כתובים', ids: ['tanach-tehillim', 'tanach-mishlei', 'tanach-iyov', 'tanach-shir-hashirim', 'tanach-rus', 'tanach-eicha', 'tanach-koheles', 'tanach-esther', 'tanach-daniel', 'tanach-ezra', 'tanach-nechemia', 'tanach-divrei-hayamim-a', 'tanach-divrei-hayamim-b'] },
  { title: 'Talmud Bavli / תלמוד בבלי', ids: ['talmud-bavli-brachot', 'talmud-bavli-shabbat', 'talmud-bavli-eruvin', 'talmud-bavli-psachim', 'talmud-bavli-shkalim', 'talmud-bavli-rosh-hashana', 'talmud-bavli-yoma', 'talmud-bavli-sukkah', 'talmud-bavli-beitza', 'talmud-bavli-taanit', 'talmud-bavli-megillah', 'talmud-bavli-moed-katan', 'talmud-bavli-chagigah', 'talmud-bavli-yevamot', 'talmud-bavli-ketubot', 'talmud-bavli-nedarim', 'talmud-bavli-nazir', 'talmud-bavli-sotah', 'talmud-bavli-gittin', 'talmud-bavli-kiddushin', 'talmud-bavli-bava-kamma', 'talmud-bavli-bava-metzia', 'talmud-bavli-bava-batra', 'talmud-bavli-sanhedrin', 'talmud-bavli-makkot', 'talmud-bavli-shevuot', 'talmud-bavli-avodah-zarah', 'talmud-bavli-horayot', 'talmud-bavli-eduyot', 'talmud-bavli-zevachim', 'talmud-bavli-menachot', 'talmud-bavli-chulin', 'talmud-bavli-bechorot', 'talmud-bavli-arachin', 'talmud-bavli-temurah', 'talmud-bavli-keritot', 'talmud-bavli-meilah', 'talmud-bavli-tamid', 'talmud-bavli-niddah'] },
  { title: 'Mishna Zeraim / משנה זרעים', ids: ['mishna-brachot', 'mishna-peah', 'mishna-demai', 'mishna-kilayim', 'mishna-sheviit', 'mishna-terumot', 'mishna-maasrot', 'mishna-maaser-sheni', 'mishna-challah', 'mishna-orlah', 'mishna-bikkurim'] },
  { title: 'Mishna Moed / משנה מועד', ids: ['mishna-shabbat', 'mishna-eruvin', 'mishna-pesachim', 'mishna-shekalim', 'mishna-yoma', 'mishna-sukkah', 'mishna-beitzah', 'mishna-rosh-hashana', 'mishna-taanit', 'mishna-megillah', 'mishna-moed-katan', 'mishna-chagigah'] },
  { title: 'Mishna Nashim / משנה נשים', ids: ['mishna-yevamot', 'mishna-ketubot', 'mishna-nedarim', 'mishna-nazir', 'mishna-sotah', 'mishna-gittin', 'mishna-kiddushin'] },
  { title: 'Mishna Nezikin / משנה נזיקין', ids: ['mishna-bava-kamma', 'mishna-bava-metzia', 'mishna-bava-batra', 'mishna-sanhedrin', 'mishna-makkot', 'mishna-shevuot', 'mishna-eduyot', 'mishna-avodah-zarah', 'mishna-avot', 'mishna-horayot'] },
  { title: 'Mishna Kodashim / משנה קדשים', ids: ['mishna-zevachim', 'mishna-menachot', 'mishna-chulin', 'mishna-bechorot', 'mishna-arachin', 'mishna-temurah', 'mishna-keritot', 'mishna-meilah', 'mishna-tamid', 'mishna-middot'] },
  { title: 'Mishna Taharot / משנה טהרות', ids: ['mishna-kelim', 'mishna-parah', 'mishna-taharot', 'mishna-mikvaot', 'mishna-niddah', 'mishna-machshirin', 'mishna-zavim'] },
  { title: 'Rambam - Mishneh Torah / רמב"ם - משנה תורה', ids: ['rambam-mada', 'rambam-ahava', 'rambam-zmanim', 'rambam-nashim', 'rambam-kedusha', 'rambam-haflaa', 'rambam-zeraim', 'rambam-avoda', 'rambam-korbanot', 'rambam-tahara', 'rambam-nezikin', 'rambam-kinyan', 'rambam-mishpatim', 'rambam-shoftim'] },
  { title: 'Zohar HaKadosh / זוהר הקדוש', ids: ['zohar-hakdama', 'zohar-bereishit', 'zohar-shemos', 'zohar-vayikra', 'zohar-bamidbar', 'zohar-devarim', 'zohar-tikunim', 'zohar-hadash'] },
  { title: 'Musar / מוסר', ids: ['shmirat-halashon', 'nefesh-hachaim', 'eved-hashem', 'anava', 'binyamin'] },
  { title: 'Halacha & More / הלכה ועוד', ids: ['halacha-misc', 'anshei-kodesh', 'saviv'] },
  { title: 'Breslov Pamphlets & Letters / קונטרסים ומכתבים', ids: ['misc-קונטרס-קיום-התורה', 'misc-קונטרס-תורה-אור', 'misc-שיחת-הנפש', 'misc-ספר-שיר-ידידות', 'misc-ספר-ההשתטחות', 'misc-ליקוטי-אבן', 'misc-מכתב-רבי-געציל-לרב-קוק', 'misc-עצות-ישרות', 'azamra'] },
  { title: 'History & Stories / תולדות וסיפורים', ids: ['misc-תולדות-שמואל', 'misc-טובות-זכרונות', 'stories-סיפורי-ר--משה-גלידמא', 'stories-סיפורים-מר--שמואל-הו'] },
  { title: 'Ramchal / רמח"ל', ids: ['ramchal-mesillas-yesharim', 'ramchal-derech-hashem', 'ramchal-daas-tevunos', 'ramchal-klach-pitchei-chochma', 'ramchal-adir-bamuroam', 'ramchal-derech-etz-chaim', 'ramchal-maamar-haikkarim', 'ramchal-asara-perakim', 'ramchal-ruzin-gineezin'] },
];

// Collect remaining books not in categories
const categorizedIds = categories.flatMap(c => c.ids);
const miscBooks = masterCatalog.books.filter(b => !categorizedIds.includes(b.id) && b.parts.some(p => p.totalTorahs > 0));
if (miscBooks.length > 0) {
  categories.push({ title: 'Students & Other Works / תלמידים ועוד', ids: miscBooks.map(b => b.id) });
}

// Pre-load LM catalogs specifically (for backward compatibility with detailed listing)
const catalog1 = loadJSON('public/reader/likutay-moharan/part-1/index.json');
const catalog2 = loadJSON('public/reader/likutay-moharan/part-2/index.json');
---

<Layout title="Jewish Torah Library - 226+ Books in Hebrew & English" description="Read 226+ sacred Jewish texts free online. Likutay Moharan, Likutay Halachos, Zohar, Talmud Bavli, Mishna, Rambam, full Tanach, and 47 Breslov classics. 25,000+ pages in Hebrew with English translations." breadcrumbs={[{name: "Home", url: "https://ajew.org"}, {name: "Library", url: "https://ajew.org/reader"}]}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Jewish Torah Library - 213 Sacred Texts Online",
    "description": "The largest free online Breslov Torah library. Read Likutay Moharan, Zohar, Talmud Bavli, Mishna, Rambam, Tanach and more in Hebrew with English translations.",
    "url": "https://ajew.org/reader",
    "isPartOf": { "@type": "WebSite", "name": "ajew.org", "url": "https://ajew.org" },
    "about": [
      { "@type": "Thing", "name": "Torah study" },
      { "@type": "Thing", "name": "Breslov Hasidism" },
      { "@type": "Thing", "name": "Jewish texts" }
    ],
    "numberOfItems": masterCatalog.books.length,
    "publisher": { "@type": "Organization", "name": "ajew.org", "url": "https://ajew.org" }
  })} slot="head" />
  <style>
    .lm-index {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-family: 'Open Sans', sans-serif;
      color: #222;
    }

    /* Header */
    .lm-header {
      text-align: center;
      margin-bottom: 40px;
      padding-bottom: 24px;
      border-bottom: 3px solid #1a365d;
    }
    .lm-header .hebrew-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 2.8em;
      color: #1a365d;
      direction: rtl;
      margin: 0 0 4px;
      font-weight: 700;
    }
    .lm-header h1 {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.8em;
      color: #1a365d;
      margin: 0 0 8px;
    }
    .lm-header .subtitle {
      color: #666;
      font-size: 0.95em;
      margin: 0;
    }
    .lm-header .author {
      color: #888;
      font-size: 0.85em;
      margin: 8px 0 0;
      font-style: italic;
    }
    .lm-features {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .lm-features span {
      background: #f0ebe0;
      padding: 4px 12px;
      border-radius: 14px;
      font-size: 0.75em;
      color: #555;
    }

    /* Volume sections */
    .volume-section {
      margin-bottom: 40px;
    }
    .book-dropdown {
      margin-bottom: 12px;
    }
    .book-dropdown summary {
      list-style: none;
      padding: 8px 0;
    }
    .book-dropdown summary::-webkit-details-marker { display: none; }
    .book-dropdown summary::before {
      content: '▶ ';
      font-size: 0.7em;
      margin-right: 4px;
      transition: transform 0.2s;
      display: inline-block;
    }
    .book-dropdown[open] summary::before {
      content: '▼ ';
    }
    .volume-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.4em;
      color: #1a365d;
      margin: 0 0 4px;
      font-weight: 700;
    }
    .volume-hebrew {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.3em;
      color: #333;
      direction: rtl;
      margin: 0 0 8px;
    }
    .volume-count {
      color: #888;
      font-size: 0.85em;
      margin: 0 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e0d6c2;
    }

    /* Torah links - compact grid */
    .torah-list {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .torah-list a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #1a365d;
      text-decoration: none;
      font-size: 0.85em;
      padding: 4px 8px;
      border-radius: 4px;
      background: #f8f5ef;
      border: 1px solid #e8e2d6;
      min-width: 32px;
      text-align: center;
      transition: all 0.12s;
    }
    .torah-list a:hover {
      background: #1a365d;
      color: #e8d5a3;
      border-color: #1a365d;
    }
    .torah-list .torah-num {
      font-weight: 600;
    }

    /* Section dividers within a volume */
    .section-divider {
      margin: 16px 0;
      padding: 8px 12px;
      background: #f8f5ef;
      border-left: 3px solid #c4a265;
      font-size: 0.85em;
      color: #6b5a42;
      font-style: italic;
      column-span: all;
    }

    /* Category sections */
    /* Recently Read */
    .recently-read {
      margin-bottom: 32px;
      padding: 16px 20px;
      background: #f0ebe0;
      border-radius: 12px;
    }
    .recent-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .recent-item {
      display: flex;
      flex-direction: column;
      padding: 8px 14px;
      background: white;
      border-radius: 8px;
      text-decoration: none;
      border: 1px solid #e0d6c2;
      transition: border-color 0.2s;
      max-width: 220px;
    }
    .recent-item:hover { border-color: #1a365d; }
    .recent-title {
      color: #1a365d;
      font-weight: 600;
      font-size: 0.85em;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .recent-ago { color: #888; font-size: 0.75em; }

    /* Daily Learning */
    .daily-learning {
      margin-bottom: 24px;
      padding: 16px 20px;
      background: #faf6ee;
      border: 1px solid #e0d6c2;
      border-radius: 12px;
      color: #2c3e50;
    }
    .daily-learning .volume-title { color: #1a365d; border: none; margin-bottom: 12px; }
    .daily-cards { display: flex; gap: 10px; flex-wrap: wrap; }
    .daily-card {
      flex: 1;
      min-width: 140px;
      padding: 12px 16px;
      background: white;
      border: 1px solid #d0c8b0;
      border-radius: 8px;
      text-decoration: none;
      color: #1a365d;
      transition: all 0.2s;
    }
    .daily-card:hover { background: #1a365d; color: white; border-color: #1a365d; }
    .daily-label { display: block; font-weight: 700; font-size: 0.95em; color: #1a365d; }
    .daily-num { display: block; font-size: 0.85em; color: #555; margin-top: 4px; font-weight: 500; }
    .daily-card:hover .daily-num { color: #ddd; }
    .daily-card:hover .daily-label { color: white; }
    .daily-random { background: #fff8ee; border-color: #e8c77b; }
    .daily-random:hover { background: #d97706; border-color: #d97706; color: white; }
    /* Dark mode - daily learning */
    :global(body.dark-mode) .daily-learning { background: #2a2a3e; border-color: #3a3a5e; color: #d0d0e0; }
    :global(body.dark-mode) .daily-learning .volume-title { color: #8ab4f8; }
    :global(body.dark-mode) .daily-card { background: #1e1e2e; border-color: #3a3a5e; color: #c0c8e0; }
    :global(body.dark-mode) .daily-card:hover { background: #3a5a8a; border-color: #3a5a8a; color: white; }
    :global(body.dark-mode) .daily-label { color: #8ab4f8; }
    :global(body.dark-mode) .daily-num { color: #aab; }
    :global(body.dark-mode) .daily-card:hover .daily-label { color: white; }
    :global(body.dark-mode) .daily-card:hover .daily-num { color: #ddd; }
    :global(body.dark-mode) .daily-random { background: #2a2418; border-color: #5a4a2a; }
    :global(body.dark-mode) .daily-random:hover { background: #b45309; border-color: #b45309; }

    /* Random Torah Button */
    .random-torah-btn {
      margin-top: 16px;
      padding: 10px 24px;
      background: #1a365d;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1em;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .random-torah-btn:hover {
      background: #2a5a9e;
      transform: scale(1.05);
    }

    /* Reading Streak */
    .streak-badge {
      margin: 8px 0;
      padding: 6px 16px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: white;
      border-radius: 20px;
      font-size: 0.85em;
      font-weight: 600;
      display: inline-block;
    }

    /* Library Filter */
    .library-search {
      margin-top: 12px;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
    .library-search input {
      width: 100%;
      padding: 10px 16px;
      font-size: 0.95em;
      border: 2px solid #d1d5db;
      border-radius: 24px;
      font-family: 'Frank Ruhl Libre', serif;
      direction: auto;
      background: white;
    }
    .library-search input:focus {
      outline: none;
      border-color: #1a365d;
      box-shadow: 0 0 0 3px rgba(26, 54, 93, 0.1);
    }

    .category-section {
      margin-top: 24px;
      border: 1px solid #e0d6c2;
      border-radius: 12px;
      overflow: hidden;
    }
    .category-title {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1.3em;
      color: #1a365d;
      margin: 0;
      padding: 16px 20px;
      font-weight: 700;
      cursor: pointer;
      background: #f8f5ef;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .category-title::-webkit-details-marker { display: none; }
    .category-title::after {
      content: '▸';
      font-size: 0.8em;
      color: #888;
      transition: transform 0.2s;
    }
    details[open] > .category-title::after { transform: rotate(90deg); }
    .category-title:hover { background: #f0ebe0; }
    .cat-count { font-size: 0.65em; color: #888; font-weight: 400; }
    details[open] > .category-title { border-bottom: 1px solid #e0d6c2; }
    .category-section .volume-section { padding: 0 20px; }

    /* Dark mode - general reader index */
    :global(body.dark-mode) .lm-index { color: #d0d0e0; }
    :global(body.dark-mode) .lm-header { border-bottom-color: #4a7ab5; }
    :global(body.dark-mode) .lm-header .hebrew-title,
    :global(body.dark-mode) .lm-header h1 { color: #8ab4f8; }
    :global(body.dark-mode) .lm-header .subtitle,
    :global(body.dark-mode) .lm-header .author { color: #aaa; }
    :global(body.dark-mode) .lm-features span { background: #2a2a3e; color: #aaa; }
    :global(body.dark-mode) .recently-read { background: #2a2a3e; }
    :global(body.dark-mode) .recent-item { background: #1e1e2e; border-color: #3a3a5e; }
    :global(body.dark-mode) .recent-item:hover { border-color: #4a7ab5; }
    :global(body.dark-mode) .recent-title { color: #8ab4f8; }
    :global(body.dark-mode) .recent-ago { color: #888; }
    :global(body.dark-mode) .category-section { border-color: #3a3a5e; }
    :global(body.dark-mode) .category-title { background: #2a2a3e; color: #8ab4f8; }
    :global(body.dark-mode) .category-title:hover { background: #333350; }
    :global(body.dark-mode) details[open] > .category-title { border-bottom-color: #3a3a5e; }
    :global(body.dark-mode) .volume-title { color: #8ab4f8; }
    :global(body.dark-mode) .volume-count { color: #888; border-bottom-color: #3a3a5e; }
    :global(body.dark-mode) .torah-list a { background: #2a2a3e; border-color: #3a3a5e; color: #8ab4f8; }
    :global(body.dark-mode) .torah-list a:hover { background: #4a7ab5; color: white; border-color: #4a7ab5; }
    :global(body.dark-mode) .section-divider { background: #2a2a3e; border-left-color: #5a4a2a; color: #aaa; }
    :global(body.dark-mode) .library-search input { background: #2a2a3e; border-color: #3a3a5e; color: #e0e0e0; }
    :global(body.dark-mode) .library-search input:focus { border-color: #4a7ab5; box-shadow: 0 0 0 3px rgba(74, 122, 181, 0.15); }

    @media (max-width: 768px) {
      .lm-header .hebrew-title { font-size: 2.2em; }
      .lm-header h1 { font-size: 1.4em; }
    }
  </style>

  <div class="lm-index">
    <div class="lm-header">
      <div class="hebrew-title">ספריית התורה</div>
      <h1>Jewish Torah Library</h1>
      <p class="subtitle">213 sacred texts online free — Breslov, Tanach, Talmud, Mishna, Rambam, Zohar & more</p>
      <p class="author">Na Nach Nachma Nachman MeUman</p>
      <div class="lm-features">
        <span>Hebrew / English / Both</span>
        <span>Day / Sepia / Night themes</span>
        <span>Bookmarks & Search</span>
        <span>30,000+ pages</span>
        <span>Fullscreen reading</span>
      </div>
      <div id="streakBadge" class="streak-badge" style="display:none;"></div>
      <button class="random-torah-btn" id="randomTorahBtn" onclick="goToRandomTorah()">Open Random Torah</button>
      <div class="library-search">
        <input type="text" id="libraryFilter" placeholder="Filter books... / סנן ספרים..." dir="auto" autocomplete="off" />
      </div>
    </div>

    <!-- Daily Learning -->
    <div class="daily-learning" id="dailyLearning">
      <h2 class="volume-title">Today's Learning</h2>
      <div class="daily-cards" id="dailyCards"></div>
      <a href="/daily-study" style="display:block; text-align:center; margin-top:12px; color:#1a365d; font-size:0.9em; text-decoration:none; font-weight:600;">See full Chok Breslov daily schedule →</a>
    </div>

    <script is:inline>
    (function() {
      const today = new Date();
      const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 86400000);

      // Daily LM: cycle through 408 torahs (285 part1 + 123 part2)
      const lmDay = (dayOfYear % 408) + 1;
      let lmPart, lmTorah;
      if (lmDay <= 285) { lmPart = 1; lmTorah = lmDay; }
      else { lmPart = 2; lmTorah = lmDay - 285; }

      // Daily Tehillim: cycle through 150 chapters
      const tehillimDay = (dayOfYear % 150) + 1;

      // Daily Likutay Tefilos: cycle through 211 prayers (152 part1 + 59 part2)
      const ltDay = (dayOfYear % 211) + 1;
      let ltPart, ltPrayer;
      if (ltDay <= 152) { ltPart = 1; ltPrayer = ltDay; }
      else { ltPart = 2; ltPrayer = ltDay - 152; }

      const cards = document.getElementById('dailyCards');
      cards.innerHTML = `
        <a href="/reader/likutay-moharan/${lmPart}/${lmTorah}" class="daily-card">
          <span class="daily-label">Likutay Moharan</span>
          <span class="daily-num">Part ${lmPart}, Torah ${lmTorah}</span>
        </a>
        <a href="/reader/likutay-tefilos/${ltPart}/${ltPrayer}" class="daily-card">
          <span class="daily-label">Likutay Tefilos</span>
          <span class="daily-num">Part ${ltPart}, Prayer ${ltPrayer}</span>
        </a>
        <a href="/reader/tanach-tehillim/part-1/${tehillimDay}" class="daily-card">
          <span class="daily-label">Tehillim</span>
          <span class="daily-num">Chapter ${tehillimDay}</span>
        </a>
        <a href="#" onclick="goToRandomTorah();return false;" class="daily-card daily-random">
          <span class="daily-label">Random Torah</span>
          <span class="daily-num">Discover something new</span>
        </a>
      `;
    })();
    </script>

    <!-- Favorites -->
    <div id="favoritesSection" class="recently-read" style="display:none;">
      <h2 class="volume-title">★ Favorites</h2>
      <div id="favoritesList" class="recent-list"></div>
    </div>

    <script is:inline>
    (function() {
      try {
        const favs = JSON.parse(localStorage.getItem('ajew-favorites') || '[]');
        if (favs.length === 0) return;
        const container = document.getElementById('favoritesSection');
        const list = document.getElementById('favoritesList');
        container.style.display = 'block';
        list.innerHTML = favs.slice(0, 12).map(f =>
          '<a href="' + f.url + '" class="recent-item"><span class="recent-title">' + f.title + '</span><span class="recent-ago">★</span></a>'
        ).join('');
      } catch(e) {}
    })();
    </script>

    <!-- Bookmarks -->
    <div id="bookmarksSection" class="recently-read" style="display:none;">
      <h2 class="volume-title">Bookmarks</h2>
      <div id="bookmarksList" class="recent-list"></div>
    </div>

    <script is:inline>
    (function() {
      try {
        const prefs = JSON.parse(localStorage.getItem('ajew-reader-prefs') || '{}');
        const bookmarks = prefs.bookmarks || {};
        const entries = Object.entries(bookmarks).filter(([k, v]) => v.url && v.title);
        if (entries.length === 0) return;
        entries.sort((a, b) => (b[1].timestamp || 0) - (a[1].timestamp || 0));
        const container = document.getElementById('bookmarksSection');
        const list = document.getElementById('bookmarksList');
        container.style.display = 'block';
        list.innerHTML = entries.slice(0, 10).map(([id, bm]) => {
          return '<a href="' + bm.url + '" class="recent-item"><span class="recent-title">' + bm.title + '</span><span class="recent-ago">bookmarked</span></a>';
        }).join('');
      } catch(e) {}
    })();
    </script>

    <!-- Recently Read -->
    <div id="recentlyRead" class="recently-read" style="display:none;">
      <h2 class="volume-title">Recently Read</h2>
      <div id="recentList" class="recent-list"></div>
    </div>

    <script is:inline>
    (function() {
      try {
        const history = JSON.parse(localStorage.getItem('ajew-reading-history') || '[]');
        if (history.length === 0) return;
        const container = document.getElementById('recentlyRead');
        const list = document.getElementById('recentList');
        container.style.display = 'block';
        list.innerHTML = history.slice(0, 8).map(h => {
          const ago = getTimeAgo(h.timestamp);
          const pct = h.progress ? ' · ' + h.progress + '%' : '';
          return '<a href="' + h.url + '" class="recent-item"><span class="recent-title">' + h.title + '</span><span class="recent-ago">' + ago + pct + '</span></a>';
        }).join('');
      } catch(e) {}

      function getTimeAgo(ts) {
        const diff = Date.now() - ts;
        const mins = Math.floor(diff / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        const hours = Math.floor(mins / 60);
        if (hours < 24) return hours + 'h ago';
        const days = Math.floor(hours / 24);
        return days + 'd ago';
      }
    })();
    </script>

    <script is:inline>
    function goToRandomTorah() {
      const books = [
        { base: '/reader/likutay-moharan/1/', max: 286 },
        { base: '/reader/likutay-moharan/2/', max: 125 },
        { base: '/reader/sefer-hamidos/1/', max: 108 },
        { base: '/reader/sichos-haran/1/', max: 309 },
        { base: '/reader/shivchay-haran/1/', max: 64 },
        { base: '/reader/likutay-halachos/1/', max: 60 },
        { base: '/reader/likutay-halachos/2/', max: 55 },
        { base: '/reader/likutay-halachos/3/', max: 85 },
        { base: '/reader/kitzur-likutay-moharan/1/', max: 289 },
        { base: '/reader/likutay-tefilos/1/', max: 151 },
        { base: '/reader/likutay-eitzos/1/', max: 65 },
        { base: '/reader/hashtatfchus-hanefesh/1/', max: 130 },
        { base: '/reader/meshivas-nefesh/1/', max: 183 },
        { base: '/reader/alim-litrufa/2/', max: 477 },
        { base: '/reader/sipurey-maasiyos/1/', max: 13 },
        { base: '/reader/chayey-moharan/1/', max: 12 },
        { base: '/reader/parparos-lechochma/1/', max: 135 },
        { base: '/reader/yemei-moharnat/1/', max: 303 },
      ];
      const book = books[Math.floor(Math.random() * books.length)];
      const num = Math.floor(Math.random() * book.max) + 1;
      window.location.href = book.base + num;
    }
    </script>

    <script is:inline>
    // Show reading streak
    (function() {
      try {
        const data = JSON.parse(localStorage.getItem('ajew-reading-streak') || '{}');
        if (!data.streak || data.streak < 1) return;
        const badge = document.getElementById('streakBadge');
        if (!badge) return;
        const flame = data.streak >= 7 ? '🔥' : data.streak >= 3 ? '✨' : '📖';
        badge.textContent = flame + ' ' + data.streak + ' day streak' + (data.totalDays > data.streak ? ' · ' + data.totalDays + ' total days' : '');
        badge.style.display = 'inline-block';
      } catch(e) {}
    })();
    </script>

    <!-- All Books by Category -->

    <!-- Likutay Moharan - in its own collapsible section -->
    <details class="category-section" id="likutay-moharan">
      <summary class="category-title">Likutay Moharan / ליקוטי מוהר"ן <span class="cat-count">({(catalog1?.totalTorahs || 0) + (catalog2?.totalTorahs || 0)} torahs)</span></summary>

      <div class="volume-section" style="margin-bottom: 20px;">
        <h3 class="volume-title" style="font-size: 1.2em;">Volume 1 (Kama) — מהדורא קמא</h3>
        {catalog1 && <p class="volume-count">{catalog1.totalTorahs} Torahs</p>}
        <div style="margin-bottom: 8px;">
          <ul class="torah-list">
            <li><a href="/reader/likutay-moharan/1/haskamos" style="background: #e8d5a3; font-size: 0.8em;">הסכמות</a></li>
            <li><a href="/reader/likutay-moharan/1/intro" style="background: #e8d5a3; font-size: 0.8em;">שיר נעים</a></li>
            <li><a href="/reader/likutay-moharan/1/intro-shimon" style="background: #e8d5a3; font-size: 0.8em;">ר׳ שמעון</a></li>
          </ul>
        </div>
        {catalog1 ? (
          <ul class="torah-list">
            {catalog1.torahs.filter(t => typeof t.number === 'number').map(t => (
              <li>
                <a href={t.url}>
                  <span class="torah-num">{t.displayNumber || t.number}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Loading...</p>
        )}
      </div>

      <div class="volume-section">
        <h3 class="volume-title" style="font-size: 1.2em;">Volume 2 (Tinyana) — מהדורא בתרא (תנינא)</h3>
        {catalog2 && <p class="volume-count">{catalog2.totalTorahs} Torahs</p>}
        {catalog2 ? (
          <ul class="torah-list">
            <li><a href="/reader/likutay-moharan/2/intro" style="background: #e8d5a3; font-size: 0.8em;">הקדמה</a></li>
            <li><a href="/reader/likutay-moharan/2/omission" style="background: #e8d5a3; font-size: 0.8em;">השמטה — אחד היה אברהם</a></li>
            {catalog2.torahs.map(t => (
              <li>
                <a href={t.url}>
                  <span class="torah-num">{t.displayNumber || t.number}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Loading...</p>
        )}
      </div>
    </details>

    <!-- All Other Books by Category -->
    {categories.map(cat => {
      const catBooks = cat.ids
        .filter(id => id !== 'likutay-moharan') // LM has its own section above
        .map(id => masterCatalog.books.find(b => b.id === id)).filter(Boolean).filter(b => b.parts.some(p => p.totalTorahs > 0));
      if (catBooks.length === 0) return null;
      const totalCatPages = catBooks.reduce((s, b) => s + b.parts.reduce((s2, p) => s2 + p.totalTorahs, 0), 0);
      return (
        <details class="category-section">
          <summary class="category-title">{cat.title} <span class="cat-count">({catBooks.length} books, {totalCatPages} pages)</span></summary>
          {catBooks.map(book => {
            const indexes = loadBookIndexes(book);
            const totalPages = book.parts.reduce((s, p) => s + p.totalTorahs, 0);
            return (
              <div class="volume-section" id={book.id} style="margin-bottom: 30px;">
                {totalPages > 40 ? (
                  <details class="book-dropdown">
                    <summary class="volume-title" style="font-size: 1.2em; cursor: pointer;">
                      {book.title} <span class="volume-hebrew" style="display: inline; margin-left: 8px;">{book.hebrewTitle}</span>
                      <span class="volume-count" style="display: inline; margin-left: 8px; font-size: 0.8em;">({totalPages})</span>
                    </summary>
                    {indexes.map(partData => (
                      <div style={book.parts.length > 1 ? "margin-bottom: 12px;" : ""}>
                        {book.parts.length > 1 && (
                          <h4 style="font-size: 0.9em; color: #6b5a42; margin: 8px 0 4px; font-style: italic;">
                            {partData.hebrewTitle || partData.title} ({partData.totalTorahs})
                          </h4>
                        )}
                        <ul class="torah-list">
                          {(partData.index.torahs || partData.index.items || []).map(t => (
                            <li>
                              <a href={t.url || `/reader/${book.id}/${partData.part}/${t.number}`}>
                                <span class="torah-num">{t.hebrewTitle || t.title || `[${t.number}]`}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </details>
                ) : (
                  <Fragment>
                    <h3 class="volume-title" style="font-size: 1.2em;">{book.title}</h3>
                    <div class="volume-hebrew">{book.hebrewTitle}</div>
                    <p class="volume-count">{totalPages} sections{book.parts.length > 1 ? ` (${book.parts.length} parts)` : ''}</p>
                    {indexes.map(partData => (
                      <div style={book.parts.length > 1 ? "margin-bottom: 12px;" : ""}>
                        {book.parts.length > 1 && (
                          <h4 style="font-size: 0.9em; color: #6b5a42; margin: 8px 0 4px; font-style: italic;">
                            {partData.hebrewTitle || partData.title} ({partData.totalTorahs})
                          </h4>
                        )}
                        <ul class="torah-list">
                          {(partData.index.torahs || partData.index.items || []).map(t => (
                            <li>
                              <a href={t.url || `/reader/${book.id}/${partData.part}/${t.number}`}>
                                <span class="torah-num">{t.hebrewTitle || t.title || `[${t.number}]`}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </Fragment>
                )}
              </div>
            );
          })}
        </details>
      );
    })}
  </div>

  <script is:inline>
  // Library filter - search/filter books by name
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('libraryFilter');
    if (!input) return;

    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      if (!q) {
        // Show all
        document.querySelectorAll('.category-section, .volume-section, #likutay-moharan').forEach(el => {
          el.style.display = '';
        });
        return;
      }

      // Filter volume sections (individual books)
      document.querySelectorAll('.volume-section').forEach(section => {
        const title = (section.querySelector('.volume-title')?.textContent || '').toLowerCase();
        const hebrew = (section.querySelector('.volume-hebrew')?.textContent || '').toLowerCase();
        const match = title.includes(q) || hebrew.includes(q);
        section.style.display = match ? '' : 'none';
      });

      // Show/hide categories based on whether they have visible books
      document.querySelectorAll('.category-section').forEach(cat => {
        const visibleBooks = cat.querySelectorAll('.volume-section:not([style*="display: none"])');
        if (visibleBooks.length > 0) {
          cat.style.display = '';
          cat.open = true; // Expand matching categories
        } else {
          cat.style.display = 'none';
        }
      });

      // Also check LM section
      const lmSection = document.getElementById('likutay-moharan');
      if (lmSection) {
        const lmMatch = 'likutay moharan'.includes(q) || 'ליקוטי מוהר'.includes(q) || 'lm'.includes(q);
        lmSection.style.display = lmMatch ? '' : 'none';
      }
    });
  });
  </script>
</Layout>
