---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Torah Map - Trace Concepts Through the Teachings" description="Type any word or concept and see how it maps across the holy teachings of Rabbi Nachman. Discover connections between torahs, sources, and ideas.">
<div class="map-page">
  <header class="map-header">
    <div class="header-hebrew">מפת התורה</div>
    <h1>Torah Map</h1>
    <p class="subtitle">Type any word and discover where it leads in the holy teachings</p>
    <p class="nanach">Na Nach Nachma Nachman MeUman</p>
  </header>

  <div class="search-area">
    <div class="map-search-box">
      <input type="text" id="map-query" placeholder="Type a word or concept... הקלד מילה או מושג" dir="auto" />
      <button id="map-search-btn">Map It</button>
    </div>
    <div class="suggestions">
      <span class="suggestion" data-q="תשובה">תשובה</span>
      <span class="suggestion" data-q="שמחה">שמחה</span>
      <span class="suggestion" data-q="אמונה">אמונה</span>
      <span class="suggestion" data-q="תפילה">תפילה</span>
      <span class="suggestion" data-q="צדיק">צדיק</span>
      <span class="suggestion" data-q="ארץ ישראל">ארץ ישראל</span>
      <span class="suggestion" data-q="חן">חן</span>
      <span class="suggestion" data-q="Psalms">Psalms</span>
    </div>
  </div>

  <div id="map-loading" class="map-loading" style="display:none;">
    <div class="spinner"></div>
    <p>Mapping connections...</p>
  </div>

  <div id="map-results" style="display:none;">
    <div class="results-header">
      <h2 id="results-title"></h2>
      <div id="results-stats" class="results-stats"></div>
    </div>

    <!-- Visual Map -->
    <div id="concept-map" class="concept-map"></div>

    <!-- Connected Torahs -->
    <div id="torah-results" class="torah-results"></div>

    <!-- Related Concepts -->
    <div id="related-concepts" class="related-section"></div>
  </div>

  <div id="map-empty" style="display:none;" class="map-empty">
    <p>No results found. Try a different word.</p>
    <p class="hebrew">נ נח נחמ נחמן מאומן</p>
  </div>
</div>

<script is:inline>
(async function() {
  let searchIndex = null;
  let citationsIndex = null;

  // Load data
  async function loadData() {
    try {
      const [searchRes, citRes] = await Promise.all([
        fetch('/data/search-index-v2.json'),
        fetch('/data/citations-index.json')
      ]);
      searchIndex = await searchRes.json();
      citationsIndex = await citRes.json();
    } catch(e) {
      console.log('Data loading error:', e);
    }
  }

  function stripNikud(text) {
    return text.replace(/[\u0591-\u05BD\u05BF-\u05C7]/g, '');
  }

  function doSearch(query) {
    if (!searchIndex) return [];
    const q = stripNikud(query.toLowerCase().trim());
    if (!q) return [];

    const results = [];
    for (const doc of searchIndex.documents) {
      const content = (doc.content || '').toLowerCase();
      const title = (doc.title || '').toLowerCase();
      const hebTitle = stripNikud(doc.hebrewTitle || '').toLowerCase();

      // Count occurrences
      let count = 0;
      let idx = content.indexOf(q);
      let firstIdx = idx;
      while (idx !== -1) {
        count++;
        idx = content.indexOf(q, idx + 1);
      }

      // Also check title
      if (title.includes(q) || hebTitle.includes(q)) count += 5;

      if (count > 0) {
        // Extract snippet around first match
        let snippet = '';
        if (firstIdx >= 0) {
          const start = Math.max(0, firstIdx - 60);
          const end = Math.min(content.length, firstIdx + q.length + 60);
          snippet = (start > 0 ? '...' : '') + content.substring(start, end) + (end < content.length ? '...' : '');
        }

        results.push({
          ...doc,
          matchCount: count,
          snippet
        });
      }
    }

    return results.sort((a, b) => b.matchCount - a.matchCount);
  }

  function getCitationsForTorah(torahId) {
    if (!citationsIndex || !citationsIndex.torahs) return null;
    return citationsIndex.torahs[torahId] || null;
  }

  function renderResults(query, results) {
    const resultsDiv = document.getElementById('map-results');
    const emptyDiv = document.getElementById('map-empty');
    const loadingDiv = document.getElementById('map-loading');
    loadingDiv.style.display = 'none';

    if (results.length === 0) {
      resultsDiv.style.display = 'none';
      emptyDiv.style.display = 'block';
      return;
    }

    emptyDiv.style.display = 'none';
    resultsDiv.style.display = 'block';

    // Header stats
    document.getElementById('results-title').textContent = '"' + query + '"';

    // Count by book
    const bookCounts = {};
    for (const r of results) {
      const book = r.bookName || r.id?.split('-')[0] || 'LM';
      bookCounts[book] = (bookCounts[book] || 0) + 1;
    }

    const totalMatches = results.reduce((s, r) => s + r.matchCount, 0);
    document.getElementById('results-stats').innerHTML =
      '<span class="stat-pill">' + results.length + ' texts</span>' +
      '<span class="stat-pill">' + totalMatches + ' occurrences</span>';

    // Visual concept bubbles
    const mapDiv = document.getElementById('concept-map');
    const topResults = results.slice(0, 30);

    // Find related cited sources across matching torahs
    const sourceCounts = {};
    for (const r of topResults) {
      const cit = getCitationsForTorah(r.id);
      if (cit) {
        for (const book of cit.citedBooks) {
          sourceCounts[book] = (sourceCounts[book] || 0) + 1;
        }
      }
    }

    const sortedSources = Object.entries(sourceCounts)
      .sort(([,a], [,b]) => b - a)
      .slice(0, 15);

    if (sortedSources.length > 0) {
      mapDiv.innerHTML = '<h3>Sources connected to "' + query + '"</h3><div class="bubble-map">' +
        sortedSources.map(([source, count]) => {
          const size = Math.max(40, Math.min(100, 30 + count * 8));
          return '<div class="bubble" style="width:' + size + 'px;height:' + size + 'px;line-height:' + size + 'px;" title="' + source + ': cited in ' + count + ' matching torahs">' +
            '<span class="bubble-name">' + source + '</span>' +
            '<span class="bubble-count">' + count + '</span></div>';
        }).join('') + '</div>';
    } else {
      mapDiv.innerHTML = '';
    }

    // Torah list
    const torahDiv = document.getElementById('torah-results');
    torahDiv.innerHTML = '<h3>Found in ' + results.length + ' texts:</h3>' +
      results.slice(0, 50).map(r => {
        const cit = getCitationsForTorah(r.id);
        const citTags = cit ? cit.citedBooks.slice(0, 6).map(b =>
          '<span class="cite-tag">' + b + '</span>'
        ).join('') : '';

        return '<div class="result-card">' +
          '<div class="result-header">' +
            '<a href="' + r.url + '">' +
              '<strong>' + (r.hebrewTitle || r.title) + '</strong>' +
              (r.bookName ? ' <span class="result-book">' + r.bookName + '</span>' : '') +
            '</a>' +
            '<span class="match-badge">' + r.matchCount + 'x</span>' +
          '</div>' +
          (r.snippet ? '<p class="result-snippet">' + r.snippet + '</p>' : '') +
          (citTags ? '<div class="result-citations">' + citTags + '</div>' : '') +
        '</div>';
      }).join('') +
      (results.length > 50 ? '<p class="more-results">+ ' + (results.length - 50) + ' more results</p>' : '');

    // Related concepts (other words that appear frequently in matching torahs)
    const relatedDiv = document.getElementById('related-concepts');
    if (sortedSources.length > 0) {
      relatedDiv.innerHTML = '<h3>Explore related:</h3><div class="related-tags">' +
        sortedSources.map(([source]) =>
          '<button class="related-btn" data-q="' + source + '">' + source + '</button>'
        ).join('') + '</div>';

      relatedDiv.querySelectorAll('.related-btn').forEach(btn => {
        btn.onclick = () => {
          document.getElementById('map-query').value = btn.dataset.q;
          performMap();
        };
      });
    } else {
      relatedDiv.innerHTML = '';
    }
  }

  function performMap() {
    const query = document.getElementById('map-query').value.trim();
    if (!query) return;

    document.getElementById('map-loading').style.display = 'flex';
    document.getElementById('map-results').style.display = 'none';
    document.getElementById('map-empty').style.display = 'none';

    // Small delay for UX
    setTimeout(() => {
      const results = doSearch(query);
      renderResults(query, results);
    }, 100);
  }

  // Init
  await loadData();

  document.getElementById('map-search-btn').onclick = performMap;
  document.getElementById('map-query').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') performMap();
  });

  document.querySelectorAll('.suggestion').forEach(s => {
    s.onclick = () => {
      document.getElementById('map-query').value = s.dataset.q;
      performMap();
    };
  });
})();
</script>

<style is:global>
  .map-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px 80px;
    font-family: 'Open Sans', sans-serif;
  }

  .map-header {
    text-align: center;
    padding: 48px 20px 24px;
  }
  .header-hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 2.8em;
    color: #1a365d;
    direction: rtl;
    font-weight: 700;
  }
  .map-header h1 {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.8em;
    color: #1a365d;
    margin: 0 0 8px;
  }
  .map-header .subtitle { color: #666; margin: 0 0 4px; }
  .map-header .nanach {
    color: #c4a265;
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 0.9em;
  }

  .search-area {
    margin: 24px 0 32px;
  }
  .map-search-box {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }
  .map-search-box input {
    flex: 1;
    padding: 14px 20px;
    border: 3px solid #1a365d;
    border-radius: 12px;
    font-size: 1.2em;
    font-family: 'Frank Ruhl Libre', serif;
  }
  .map-search-box input:focus { outline: none; border-color: #c4a265; }
  .map-search-box button {
    padding: 14px 28px;
    background: #1a365d;
    color: #e8d5a3;
    border: none;
    border-radius: 12px;
    font-size: 1.1em;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }
  .map-search-box button:hover { background: #0f2440; }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .suggestion {
    padding: 6px 14px;
    background: #f0ebe0;
    border-radius: 20px;
    font-size: 0.85em;
    color: #1a365d;
    cursor: pointer;
    font-family: 'Frank Ruhl Libre', serif;
    transition: all 0.15s;
  }
  .suggestion:hover { background: #1a365d; color: #e8d5a3; }

  .map-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px;
    color: #999;
  }
  .spinner {
    width: 40px; height: 40px;
    border: 4px solid #e0d6c2;
    border-top: 4px solid #1a365d;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .results-header { margin-bottom: 24px; }
  .results-header h2 {
    font-family: 'Frank Ruhl Libre', serif;
    color: #1a365d;
    font-size: 1.6em;
    margin: 0 0 8px;
    direction: auto;
  }
  .results-stats { display: flex; gap: 8px; }
  .stat-pill {
    background: #1a365d;
    color: #e8d5a3;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 600;
  }

  /* Bubble map */
  .concept-map { margin-bottom: 32px; }
  .concept-map h3 {
    font-family: 'Frank Ruhl Libre', serif;
    color: #1a365d;
    font-size: 1.1em;
    margin: 0 0 12px;
  }
  .bubble-map {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    align-items: center;
  }
  .bubble {
    background: linear-gradient(135deg, #1a365d, #2d4a8a);
    color: white;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: center;
    line-height: 1.2 !important;
    padding: 4px;
  }
  .bubble:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 16px rgba(26,54,93,0.4);
  }
  .bubble-name { font-size: 0.55em; font-weight: 600; }
  .bubble-count { font-size: 0.5em; color: #e8d5a3; }

  /* Torah results */
  .torah-results h3 {
    font-family: 'Frank Ruhl Libre', serif;
    color: #1a365d;
    margin: 0 0 12px;
  }
  .result-card {
    border: 1px solid #e0d6c2;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
    background: white;
    transition: border-color 0.2s;
  }
  .result-card:hover { border-color: #c4a265; }
  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .result-header a { text-decoration: none; color: #1a365d; }
  .result-header a:hover { text-decoration: underline; }
  .result-book { font-size: 0.8em; color: #999; font-weight: 400; }
  .match-badge {
    background: #c4a265;
    color: white;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.75em;
    font-weight: 700;
    flex-shrink: 0;
  }
  .result-snippet {
    font-size: 0.85em;
    color: #555;
    margin: 0 0 6px;
    line-height: 1.5;
    direction: rtl;
  }
  .result-citations { display: flex; flex-wrap: wrap; gap: 4px; }
  .cite-tag {
    padding: 2px 8px;
    background: #dbeafe;
    color: #1e40af;
    border-radius: 10px;
    font-size: 0.7em;
  }

  .more-results { text-align: center; color: #999; font-style: italic; }

  /* Related */
  .related-section { margin-top: 24px; }
  .related-section h3 {
    font-family: 'Frank Ruhl Libre', serif;
    color: #1a365d;
    margin: 0 0 12px;
  }
  .related-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .related-btn {
    padding: 6px 14px;
    background: #f0ebe0;
    border: 1px solid #e0d6c2;
    border-radius: 20px;
    font-size: 0.85em;
    color: #1a365d;
    cursor: pointer;
    transition: all 0.15s;
  }
  .related-btn:hover { background: #1a365d; color: #e8d5a3; border-color: #1a365d; }

  .map-empty {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }
  .map-empty .hebrew {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: 1.3em;
    color: #c4a265;
  }

  @media (max-width: 768px) {
    .map-search-box { flex-direction: column; }
    .map-search-box button { width: 100%; }
    .header-hebrew { font-size: 2.2em; }
    .bubble { min-width: 50px; min-height: 50px; }
  }
</style>
</Layout>
