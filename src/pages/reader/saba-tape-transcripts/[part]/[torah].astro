---
import Layout from '../../../../layouts/Layout.astro';
import Comments from '../../../../components/Comments.astro';
import '../../../../styles/reader.css';
import '../../../../styles/reader-v2.css';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const readerDir = path.join(process.cwd(), 'public/reader/saba-tape-transcripts');
  const index = JSON.parse(fs.readFileSync(path.join(readerDir, 'index.json'), 'utf8'));
  const canonical = (index.torahs || []).map((entry) => ({
    params: { part: '1', torah: String(entry.number) },
  }));
  // Preserve the 28 historical numeric URLs while the complete tape/side
  // collection uses stable slugs such as 37-b.
  const legacy = Array.from({ length: 28 }, (_, i) => ({
    params: { part: '1', torah: String(i + 1) },
  }));
  return [...canonical, ...legacy];
}

const { part, torah } = Astro.params;
const partNum = parseInt(part);
const torahSlug = String(torah || '');
const torahNum = parseInt(torahSlug);
const canonicalMatch = torahSlug.match(/^(\d+)-([ab])$/);
const isCanonical = Boolean(canonicalMatch);
const bookSlug = 'saba-tape-transcripts';
const bookName = 'Saba Tape Transcripts';

let torahData = null;
let indexData = null;
let audioMapping = null;
let wordTiming = null;
let error = null;

try {
  const readerDir = path.join(process.cwd(), `public/reader/${bookSlug}`);
  indexData = JSON.parse(fs.readFileSync(path.join(readerDir, 'index.json'), 'utf8'));
  const filePath = canonicalMatch
    ? path.join(readerDir, 'tapes', `tape-${String(canonicalMatch[1]).padStart(3, '0')}-${canonicalMatch[2]}.json`)
    : path.join(readerDir, `chapter-${torahNum}.json`);
  const raw = fs.readFileSync(filePath, 'utf8');
  torahData = JSON.parse(raw);

  const audioMap = JSON.parse(fs.readFileSync(path.join(readerDir, 'audio-map.json'), 'utf8'));
  const candidate = canonicalMatch
    ? audioMap.entries?.find((entry) => entry.tape === Number(canonicalMatch[1]) && entry.side === canonicalMatch[2])
    : audioMap.entries?.find((entry) => entry.chapter === torahNum);
  if (candidate?.verified === true && /^https:\/\//.test(candidate.url || '')) {
    audioMapping = candidate;
  }
  if (canonicalMatch) {
    const timingPath = path.join(readerDir, 'timings', `${String(canonicalMatch[1]).padStart(3, '0')}_${canonicalMatch[2]}.json`);
    if (fs.existsSync(timingPath)) wordTiming = JSON.parse(fs.readFileSync(timingPath, 'utf8'));
  }
} catch (e) {
  error = `Tape ${torahNum} not found`;
}

if (!torahData && !error) error = 'Content not available';

const prevUrl = isCanonical
  ? torahData?.navigation?.prevUrl
  : (torahNum > 1 ? `/reader/${bookSlug}/1/${torahNum - 1}` : null);
const nextUrl = isCanonical
  ? torahData?.navigation?.nextUrl
  : (torahNum < 28 ? `/reader/${bookSlug}/1/${torahNum + 1}` : null);
const hasMatchedAudio = Boolean(audioMapping);
const isRecoveredDerivative = /derivative/i.test(audioMapping?.sourceClassification || '');
const resources = isCanonical ? torahData?.sourceResources : null;
const timedSegments = new Map((wordTiming?.publishable === true ? wordTiming.segments.filter((segment) => segment.publishable === true) : []).map((segment) => [segment.id, segment.words]));
const hasWordTiming = hasMatchedAudio && wordTiming?.publishable === true && timedSegments.size > 0;

const pageTitle = torahData
  ? `${torahData.title} - ${bookName} | AJEW.org`
  : 'Tape Not Found';
const pageDesc = torahData
  ? `Read ${torahData.title} from Saba Yisroel (Rabbi Yisroel Dov Odesser), with the complete Hebrew transcript and verified English translation where available.`
  : '';
---

<Layout title={pageTitle} description={pageDesc}>
  {error ? (
    <div style="text-align: center; padding: 80px 20px;">
      <h1>{error}</h1>
      <p><a href={`/reader/saba-tape-transcripts/${partNum}`}>Book Index</a>
        <a href="/reader">Back to Reader</a></p>
    </div>
  ) : (
    <div class="reader-container" data-book={bookSlug}>
      <div class="reader-header">
        <a href="/reader" class="reader-back">&larr; Library</a>
        <span>&rsaquo;</span>
        <span>{bookName}</span>
        <span>&rsaquo;</span>
        {torahData.title}
      </div>

      {isCanonical && (
        <aside class={`source-status source-${torahData.sourceStatus || 'available'}`}>
          <strong>{torahData.hebrewTitle}</strong>
          {torahData.sourceStatus === 'missing' ? (
            <span>This tape side is explicitly marked missing in the supplied Hebrew source; no wording has been invented.</span>
          ) : torahData.sourceStatus === 'partial' ? (
            <span>The source states that much of this side is missing or inaudible. The available wording is reproduced without expansion.</span>
          ) : torahData.translationStatus === 'existing_verified' && torahData.existingEnglish?.url ? (
            <span>Complete available Hebrew and verified English. <a href={torahData.existingEnglish.url}>Open the reviewed legacy tape-side page</a>.</span>
          ) : torahData.translationStatus === 'existing_review_pending' && torahData.existingEnglish?.url ? (
            <span>Complete available Hebrew source. <a href={torahData.existingEnglish.url}>Open the existing English tape-side translation</a>; alignment and completeness review is pending.</span>
          ) : torahData.language === 'yi' ? (
            <span>This side is primarily Yiddish. English translation will be verified against the Yiddish source.</span>
          ) : (
            <span>Complete available Hebrew source. English translation status: {torahData.translationStatus || 'not started'}.</span>
          )}
        </aside>
      )}



<!-- English TTS controls remain available on the 28 historical translated pages. -->
{!isCanonical && (<div id="audio-controls" style="margin:0 auto 12px auto; max-width:700px; font-family:'Open Sans',sans-serif;">
  <div style="display:flex; gap:0; border-radius:8px; overflow:hidden; border:1px solid var(--reader-border,#ddd);">
    <button id="audio-btn-he" onclick="toggleAudio('he')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333);">
      🎧 Hebrew
    </button>
    <button id="audio-btn-en" onclick="toggleAudio('en')" 
      style="flex:1; padding:8px 12px; border:none; cursor:pointer; font-size:0.85em; font-weight:600;
      background:var(--reader-bg-secondary,#f8f5f0); color:var(--reader-text,#333); border-left:1px solid var(--reader-border,#ddd);">
      🔊 English
    </button>
  </div>
  
  <!-- Hidden data element for book/part/torah -->
  <div id="en-tts-player" data-book="saba-tape-transcripts" data-part={partNum} data-torah={torahNum} style="display:none;"></div>
  
  <div id="audio-panel-he" style="display:none; background:var(--reader-bg-secondary,#f8f5f0); 
    border:1px solid var(--reader-border,#ddd); border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <audio id="kol-hatzadik-audio" controls preload="none" style="width:100%; border-radius:4px;"></audio>
    <div id="kol-hatzadik-note" style="font-size:0.8em; color:var(--reader-text-secondary,#888); margin-top:4px;"></div>
  </div>
  
  <div id="audio-panel-en" style="display:none; background:#1a3a1a; 
    border:1px solid #2d5a2d; border-top:none; border-radius:0 0 8px 8px; padding:12px 16px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
      <span style="font-size:1em;">🔊</span>
      <strong style="color:#7fff7f; font-size:0.85em;">English Audio</strong>
      <div style="margin-left:auto; display:flex; gap:4px;">
        <button id="en-btn-ryan" onclick="enSetVoice('ryan')" 
          style="background:#7fff7f20; border:2px solid #7fff7f; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇬🇧</button>
        <button id="en-btn-guy" onclick="enSetVoice('guy')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇺🇸</button>
        <button id="en-btn-connor" onclick="enSetVoice('connor')" 
          style="background:#7fff7f10; border:1px solid #7fff7f40; color:#fff; border-radius:4px; 
          padding:2px 8px; cursor:pointer; font-size:0.8em;">🇮🇪</button>
      </div>
    </div>
    <button id="en-btn-play" onclick="enTogglePlay()" 
      style="background:#2d8a2d; color:#fff; border:none; border-radius:4px; padding:6px 16px; 
      cursor:pointer; font-size:0.9em; font-weight:bold; width:100%;">▶ Play English</button>
    <div id="en-progress" style="margin-top:4px; height:3px; background:#2d5a2d; border-radius:2px; 
      overflow:hidden; display:none;">
      <div id="en-progress-bar" style="height:100%; width:0%; background:#7fff7f;"></div>
    </div>
  </div>
</div>)}
<script src="/unified-audio.js" defer></script>

      <div class="reader-toolbar">
        <div class="reader-toolbar-group">
          <button class="reader-btn" data-mode="hebrew">Hebrew</button>
          <button class="reader-btn" data-mode="english">English</button>
          <button class="reader-btn" data-mode="both">Both</button>
        </div>
        <div class="reader-toolbar-group">
          <span style="font-size:0.7em; color: var(--reader-text-secondary);">A</span>
          <input type="range" id="font-size-slider" class="font-size-slider" min="12" max="32" value="18" />
          <span style="font-size:0.9em; color: var(--reader-text-secondary);">A</span>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" data-theme-btn="day">Day</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="sepia">Sepia</button>
          <button class="reader-btn reader-btn-icon" data-theme-btn="night">Night</button>
        </div>
        <div class="reader-toolbar-group">
          <button class="reader-btn reader-btn-icon" id="btn-search">Search</button>
          <button class="reader-btn reader-btn-icon" id="btn-bookmark">Bookmark</button>
          <button class="reader-btn reader-btn-icon" id="btn-align" title="Sentence-by-sentence aligned view">Align</button>
          <button class="reader-btn reader-btn-icon" id="btn-fullscreen">Fullscreen</button>
        </div>
      </div>

      {isCanonical && resources && (
        <section class="source-resources" aria-label="Source PDF and OCR downloads">
          <div>
            <span class="resource-kicker">Original source · pages {resources.pageStart}–{resources.pageEnd}</span>
            <strong>{torahData.hebrewTitle}</strong>
            <small>{resources.pageCount} PDF pages · exact ABBYY OCR section</small>
          </div>
          <nav>
            <a class="resource-primary" href={resources.pdfUrl} target="_blank" rel="noopener">Open this section PDF</a>
            <a href="#transcript">Read section OCR below</a>
            <a href={resources.completePdfUrl} target="_blank" rel="noopener">Complete 2,072-page PDF</a>
          </nav>
        </section>
      )}

      <!-- Original audio appears only after exact tape-side identity is verified. -->
      {hasMatchedAudio && (<div class="saba-audio-player">
        <div class="audio-header">
          <span class="audio-icon">🎙️</span>
          <span class="audio-title">Listen to Saba — {isRecoveredDerivative ? 'Recovered Recording' : 'Original Recording'}</span>
        </div>
        <audio id="saba-audio" controls preload="none" class="audio-element">
          <source src={audioMapping.url} type="audio/mpeg" />
          Your browser does not support audio playback.
        </audio>
        <p class="audio-note">{hasWordTiming ? 'Click any highlighted Hebrew word below to hear the recording from that point.' : `Verified original recording for ${torahData.hebrewTitle || torahData.title}`}</p>
        {isRecoveredDerivative && <p class="audio-note">Closest recovered web copy presently available; preserved separately from the unavailable archival original.</p>}
        <a class="audio-source-link" href={audioMapping.url} target="_blank" rel="noopener">Open or download the archived MP3</a>
        <a class="audio-source-link" href="https://archive.org/details/sichos-saba-117-tape-audio" target="_blank" rel="noopener">Internet Archive collection</a>
      </div>)}

      <div class="reader-nav">
        {prevUrl ? (
          <a href={prevUrl} data-dir="prev">&larr; Previous</a>
        ) : <span class="disabled">&larr; Previous</span>}
        <a href="/reader">Library</a>
        <a href={`/reader/${bookSlug}/${partNum}`}>Book Index</a>
        {nextUrl ? (
          <a href={nextUrl} data-dir="next">Next &rarr;</a>
        ) : <span class="disabled">Next &rarr;</span>}
      </div>

      <div id="transcript" class={`reader-content ${isCanonical ? 'mode-hebrew' : 'mode-english'}`}>
        <div class="reader-content-original">
        {torahData.segments.map((seg, i) => (
          <div class="reader-segment-pair" id={`seg-${i + 1}`}>
            <div class="reader-segment segment-he" data-index={String(i + 1)}>
              <span class="segment-number">{i + 1}</span>
              {timedSegments.has(seg.id) && (
                <button
                  type="button"
                  class="segment-play"
                  data-audio-start={String(timedSegments.get(seg.id).find((word) => word.alignment === 'exact').start)}
                  title="Play this transcript section from the original recording"
                >▶ Listen from here</button>
              )}
              <p>{timedSegments.has(seg.id)
                ? timedSegments.get(seg.id).map((word) => (
                    <span
                      class={`timed-word ${word.alignment === 'exact' ? 'timed-exact timed-seekable' : 'timed-interpolated'}`}
                      data-audio-start={word.alignment === 'exact' ? String(word.start) : undefined}
                      data-audio-end={String(word.end)}
                      role={word.alignment === 'exact' ? 'button' : undefined}
                      tabindex={word.alignment === 'exact' ? '0' : undefined}
                      title={word.alignment === 'exact' ? 'Play from this verified word position' : undefined}
                    >{word.text}</span>
                  ))
                : (seg.media?.anchorHe && seg.he?.includes(seg.media.anchorHe) ? (
                    <>
                      {seg.he.slice(0, seg.he.indexOf(seg.media.anchorHe))}
                      <mark class="segment-media-anchor">{seg.media.anchorHe}</mark>
                      {seg.he.slice(seg.he.indexOf(seg.media.anchorHe) + seg.media.anchorHe.length)}
                    </>
                  ) : (seg.he || '\u00A0'))}</p>
            </div>
            <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(i + 1)}>
              <span class="segment-number">{i + 1}</span>
              <p>{seg.en || 'Translation not yet available'}</p>
            </div>
            {seg.media?.type === 'image' && seg.media?.path && (
              <details class="reader-media-dropdown saba-segment-media" data-segment={seg.id}>
                <summary>📷 {seg.media.label || 'Picture for this excerpt'}</summary>
                <figure>
                  <a href={seg.media.path} target="_blank" rel="noopener">
                    <img src={seg.media.path} alt={seg.media.alt || `Picture related to ${seg.id}`} loading="lazy" />
                  </a>
                  <figcaption>{seg.media.caption}</figcaption>
                </figure>
              </details>
            )}
          </div>
        ))}
        </div>
        {torahData.aligned_segments && (
          <div class="reader-content-aligned" style="display:none;">
            {torahData.aligned_segments.map((seg) => (
              <div class={`reader-segment-pair ${seg.type === 'note' ? 'segment-note' : ''}`} id={`aligned-${seg.index}`}>
                <div class="reader-segment segment-he" data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.he || '\u00A0'}</p>
                </div>
                <div class={`reader-segment segment-en ${!seg.en ? 'empty-translation' : ''}`} data-index={String(seg.index)}>
                  <span class="segment-number">{seg.index}</span>
                  <p>{seg.en || '\u00A0'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="reader-nav">
        {prevUrl ? (
          <a href={prevUrl} data-dir="prev">&larr; Previous</a>
        ) : <span class="disabled">&larr; Previous</span>}
        <a href="/reader">Library</a>
        <a href={`/reader/${bookSlug}/${partNum}`}>Book Index</a>
        {nextUrl ? (
          <a href={nextUrl} data-dir="next">Next &rarr;</a>
        ) : <span class="disabled">Next &rarr;</span>}
      </div>
    </div>
  )}

      {torahData && (
        <Comments teachingId={`saba-tape-transcripts-${part}-${torah}`} teachingTitle={`saba-tape-transcripts ${part}:${torah}${torahData?.title ? ' — ' + torahData.title : ''}`} />
      )}
</Layout>

<script defer src="/reader-script.js?v=20260820-notes-fix"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const audio = document.getElementById('saba-audio');
    const words = Array.from(document.querySelectorAll('.timed-word'));
    const seekers = Array.from(document.querySelectorAll('.timed-seekable, .segment-play'));
    if (!audio || !seekers.length) return;
    let active = null;
    seekers.forEach((target) => target.addEventListener('click', () => {
      audio.currentTime = Number(target.dataset.audioStart || 0);
      audio.play().catch(() => {});
    }));
    seekers.forEach((target) => target.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      target.click();
    }));
    audio.addEventListener('timeupdate', () => {
      const now = audio.currentTime;
      let lo = 0, hi = words.length - 1, found = -1;
      while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (Number(words[mid].dataset.audioStart) <= now) { found = mid; lo = mid + 1; }
        else hi = mid - 1;
      }
      const next = found >= 0 ? words[found] : null;
      if (next === active) return;
      active?.classList.remove('is-playing');
      next?.classList.add('is-playing');
      active = next;
    });
  });
</script>

<style>
  .source-status {
    max-width: 760px;
    margin: 0 auto 1rem;
    padding: .85rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .8rem;
    align-items: baseline;
    border: 1px solid #d8c08f;
    border-radius: 10px;
    background: #fff9e9;
    color: #59451f;
    line-height: 1.45;
  }
  .source-status strong { color: #173b67; font-family: 'Frank Ruhl Libre', serif; }
  .source-missing { border-color: #b75b52; background: #fff1ef; }
  .source-partial { border-color: #c68a33; background: #fff6e3; }
  .source-resources {
    max-width: 760px;
    margin: 0 auto 1rem;
    padding: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid #d5bc83;
    border-radius: 14px;
    background: linear-gradient(135deg, #fffdf7, #f7ead0);
    box-shadow: 0 8px 24px rgba(30, 52, 80, .08);
  }
  .source-resources > div { display: grid; gap: .2rem; min-width: 0; }
  .resource-kicker { color: #81602c; font-size: .72rem; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; }
  .source-resources strong { color: #173b67; font: 700 1.35rem 'Frank Ruhl Libre', serif; }
  .source-resources small { color: #6d604b; }
  .source-resources nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .45rem; }
  .source-resources a { padding: .6rem .8rem; border: 1px solid #b89555; border-radius: 9px; color: #173b67; background: rgba(255,255,255,.72); font-size: .82rem; font-weight: 800; text-decoration: none; }
  .source-resources a:hover { background: #fff; transform: translateY(-1px); }
  .source-resources .resource-primary { color: #fff; background: #1c4b7c; border-color: #1c4b7c; }
  .saba-audio-player {
    max-width: 700px;
    margin: 1rem auto;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #fef9ef 0%, #fdf5e6 100%);
    border: 1px solid #e8d5b0;
    border-radius: 12px;
    text-align: center;
  }
  .audio-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .audio-icon { font-size: 1.4rem; }
  .audio-title {
    font-weight: 600;
    color: #5a3e1b;
    font-size: 1rem;
  }
  .audio-element {
    width: 100%;
    max-width: 500px;
    margin: 0.5rem auto;
    display: block;
  }
  .audio-note {
    font-size: 0.8rem;
    color: #8a7050;
    font-style: italic;
    margin: 0.5rem 0;
  }
  .audio-source-link {
    display: inline-block;
    margin: .2rem .3rem;
    color: #173b67;
    font-size: .78rem;
    font-weight: 700;
  }
  .segment-play {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    margin: 0 0 .55rem .6rem;
    padding: .35rem .65rem;
    border: 1px solid #b89555;
    border-radius: 999px;
    background: #fff7df;
    color: #173b67;
    font-size: .72rem;
    font-weight: 800;
    cursor: pointer;
  }
  .segment-play:hover, .segment-play:focus-visible { background:#ffe6a6; outline:2px solid #b57a16; outline-offset:1px; }
  .timed-word {
    display: inline;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-align: inherit;
    white-space: pre-wrap;
    cursor: default;
  }
  .timed-seekable { cursor: pointer; text-decoration: underline dotted rgba(125,91,38,.5); text-underline-offset: .18em; }
  .timed-seekable:hover, .timed-seekable:focus-visible { background: #ffe6a6; outline: 2px solid #b57a16; outline-offset: 1px; }
  .timed-word.is-playing { background: #ffd15c; box-shadow: 0 0 0 2px rgba(181,122,22,.25); }
  .timed-interpolated { }
