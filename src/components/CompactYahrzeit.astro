---
// Compact Yahrzeit Display for Top Left Corner
// Shows only today's yahrzeits in compact format
// Click names to open profiles

// Static data for today (26 Adar)
const todayTzaddikim = [
  {
    name: "Obadiah the Prophet",
    hebrew_name: "עובדיה הנביא",
    yahrzeit_hebrew: "26 Adar",
    profile_path: "/tzaddikim/obadiah"
  },
  {
    name: "Rabbi Nussun son of Yehuda of Tiveria",
    hebrew_name: "רבי נוסן בן יהודה מטבריה",
    yahrzeit_hebrew: "26 Adar",
    profile_path: "/tzaddikim/nussun-tiveria"
  }
];

// Static data for tomorrow (27 Adar)
const tomorrowTzaddikim = [
  {
    name: "Aaron Patz",
    hebrew_name: "רבי אהרן פץ",
    yahrzeit_hebrew: "27 Adar",
    profile_path: "/tzaddikim/aaron-patz"
  }
];

// Upcoming important dates (next 7 days)
const upcomingDates = [
  {
    date_hebrew: "א׳ בְּנִיסָן",
    date_english: "1 Nissan",
    events: [
      {
        name: "Birth of Rabbainu - Rebbe Nachman of Breslov",
        hebrew_name: "הולדת רבינו - רבי נחמן מברסלב",
        description: "Na NaCh NaChMa NaChMaN MAyUMaN!",
        profile_path: "/tzaddikim/rebbe-nachman",
        type: "birth" // 'birth' instead of 'yahrzeit'
      }
    ]
  }
];

// Additional yahrzeits to add to database (not in next 7 days)
const additionalYahrzeits = [
  {
    date_hebrew: "י״ג בְּחֶשְׁוָן",
    date_english: "13 Cheshvan",
    name: "Meir Yimeeney",
    hebrew_name: "מאיר ימיני",
    description: "Breslov Hasid, close to Saba Yisroel, big mayfitz (spreader), buried close to Saba",
    profile_path: "/tzaddikim/meir-yimeeney",
    type: "yahrzeit"
  },
  {
    date_hebrew: "ט״ז בְּחֶשְׁוָן",
    date_english: "16 Cheshvan",
    name: "Shlomo Carlebach",
    hebrew_name: "שלמה קרליבך",
    description: "Renowned rabbi, composer, singer, spread Jewish music worldwide",
    profile_path: "/tzaddikim/shlomo-carlebach",
    type: "yahrzeit"
  }
];

const hasToday = todayTzaddikim.length > 0;
const hasTomorrow = tomorrowTzaddikim.length > 0;
const hasUpcoming = upcomingDates.length > 0;
const showCompact = hasToday || hasTomorrow || hasUpcoming;

// Hebrew date for display
const todayHebrew = "כ״ו בַּאֲדָר";
const tomorrowHebrew = "כ״ז בַּאֲדָר";
---

{showCompact && (
  <div class="compact-yahrzeit">
    <!-- Today's Yahrzeits -->
    {hasToday && (
      <div class="yahrzeit-section today-section">
        <div class="section-header">
          <span class="yahrzeit-icon">🕯️</span>
          <h4 class="section-title">Today's Yahrzeit: {todayHebrew}</h4>
        </div>
        <div class="tzaddikim-list">
          {todayTzaddikim.map(tzaddik => (
            <a href={tzaddik.profile_path} class="tzaddik-link">
              <span class="tzaddik-name">{tzaddik.name}</span>
              {tzaddik.hebrew_name && (
                <span class="tzaddik-hebrew" dir="rtl">{tzaddik.hebrew_name}</span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}
    
    <!-- Tomorrow's Yahrzeits -->
    {hasTomorrow && (
      <div class="yahrzeit-section tomorrow-section">
        <div class="section-header">
          <span class="yahrzeit-icon">📅</span>
          <h4 class="section-title">Tomorrow: {tomorrowHebrew}</h4>
        </div>
        <div class="tzaddikim-list">
          {tomorrowTzaddikim.map(tzaddik => (
            <a href={tzaddik.profile_path} class="tzaddik-link">
              <span class="tzaddik-name">{tzaddik.name}</span>
              {tzaddik.hebrew_name && (
                <span class="tzaddik-hebrew" dir="rtl">{tzaddik.hebrew_name}</span>
              )}
            </a>
          ))}
        </div>
      </div>
    )}
    
    <!-- Upcoming Important Dates -->
    {hasUpcoming && upcomingDates.map(upcoming => (
      <div class="yahrzeit-section upcoming-section">
        <div class="section-header">
          <span class="yahrzeit-icon">⭐</span>
          <h4 class="section-title">Upcoming: {upcoming.date_hebrew}</h4>
        </div>
        <div class="tzaddikim-list">
          {upcoming.events.map(event => (
            <a href={event.profile_path} class="tzaddik-link upcoming-event">
              <span class="tzaddik-name">{event.name}</span>
              {event.hebrew_name && (
                <span class="tzaddik-hebrew" dir="rtl">{event.hebrew_name}</span>
              )}
              {event.description && (
                <span class="event-description">{event.description}</span>
              )}
              {event.type === 'birth' && (
                <span class="event-type birth-badge">Birth</span>
              )}
            </a>
          ))}
        </div>
      </div>
    ))}
    
    <!-- View All Link - Hidden on mobile -->
    <div class="view-all desktop-only">
      <a href="/yahrzeits" class="view-all-link">View all yahrzeits →</a>
    </div>
  </div>
)}

<style>
  .compact-yahrzeit {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 8px;
    padding: 0.5rem;
    max-width: 240px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    z-index: 20;
    font-size: 0.9em;
  }
  
  .yahrzeit-section {
    margin-bottom: 0.5rem;
  }
  
  .yahrzeit-section:last-child {
    margin-bottom: 0;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.375rem;
    padding-bottom: 0.125rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .yahrzeit-icon {
    font-size: 0.875rem;
  }
  
  .section-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #92400e;
    margin: 0;
  }
  
  .tzaddikim-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .tzaddik-link {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.375rem;
    background: #fff;
    border-radius: 4px;
    border-left: 2px solid #f59e0b;
    text-decoration: none;
    transition: all 0.2s;
  }
  
  .tzaddik-link:hover {
    background: #fef3c7;
    transform: translateX(2px);
  }
  
  .tzaddik-name {
    font-size: 0.75rem;
    font-weight: 500;
    color: #1f2937;
  }
  
  .tzaddik-hebrew {
    font-size: 0.7rem;
    color: #4b5563;
    margin-top: 0.125rem;
  }
  
  /* Upcoming events styling */
  .upcoming-event {
    border-left-color: #10b981;
  }
  
  .upcoming-event:hover {
    background: #f0fdf4;
  }
  
  .event-description {
    font-size: 0.65rem;
    color: #059669;
    font-style: italic;
    margin-top: 0.125rem;
  }
  
  .event-type {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.125rem;
  }
  
  .birth-badge {
    color: #10b981;
    background: #f0fdf4;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    display: inline-block;
    align-self: flex-start;
  }
  
  .view-all {
    margin-top: 0.375rem;
    padding-top: 0.375rem;
    border-top: 1px dashed #d1d5db;
    text-align: center;
  }
  
  .view-all-link {
    font-size: 0.7rem;
    color: #d97706;
    text-decoration: none;
    font-weight: 500;
  }
  
  .view-all-link:hover {
    color: #92400e;
    text-decoration: underline;
  }
  
  /* Hide desktop-only elements on mobile */
  .desktop-only {
    display: block;
  }
  
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .compact-yahrzeit {
      top: 0.5rem;
      left: 0.5rem;
      right: 0.5rem;
      max-width: none;
      padding: 0.5rem;
    }
    
    .section-title {
      font-size: 0.8rem;
    }
    
    .tzaddik-name {
      font-size: 0.75rem;
    }
    
    .tzaddik-hebrew {
      font-size: 0.7rem;
    }
    
    /* Hide "View all yahrzeits" on mobile */
    .desktop-only {
      display: none;
    }
  }
</style>