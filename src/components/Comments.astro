---
interface Props {
  teachingId: string;
  teachingTitle: string;
}
const { teachingId, teachingTitle } = Astro.props;
---

<div class="comments-section" data-teaching-id={teachingId} data-teaching-title={teachingTitle}>
  <div class="comments-header">
    <h3>💬 Comments</h3>
    <span class="comment-count" data-role="count">…</span>
  </div>

  <div class="comment-gate" data-role="gate" hidden>
    <p>
      💬 <a href="/login">Log in</a> to post comments.
      Not a subscriber yet? <a href="/subscribe">Join</a>.
    </p>
  </div>

  <div class="comment-form" data-role="form" hidden>
    <textarea
      data-role="input"
      placeholder="Share your thoughts on this teaching (Na Nach!)…"
      maxlength="1000"
    ></textarea>
    <div class="comment-form-row">
      <label class="share-toggle">
        <input type="checkbox" data-role="share-toggle" />
        Also share to <a href="/chat" target="_blank" rel="noopener">chat</a>
      </label>
      <button type="button" data-role="submit">Post Comment</button>
    </div>
    <div class="comment-status" data-role="status"></div>
  </div>

  <div class="comment-list" data-role="list">
    <p class="comments-loading">Loading comments…</p>
  </div>
</div>

<script define:vars={{ teachingId, teachingTitle }}>
  (async function () {
    const root = document.querySelector(`.comments-section[data-teaching-id="${teachingId}"]`);
    if (!root) return;

    const countEl = root.querySelector('[data-role="count"]');
    const gateEl = root.querySelector('[data-role="gate"]');
    const formEl = root.querySelector('[data-role="form"]');
    const inputEl = root.querySelector('[data-role="input"]');
    const shareEl = root.querySelector('[data-role="share-toggle"]');
    const submitEl = root.querySelector('[data-role="submit"]');
    const statusEl = root.querySelector('[data-role="status"]');
    const listEl = root.querySelector('[data-role="list"]');

    let supabase = null;
    try {
      const mod = await import('/src/lib/supabaseClient.ts').catch(() => null);
      if (mod?.supabase) {
        supabase = mod.supabase;
      } else if (window.supabase) {
        supabase = window.supabase;
      }
    } catch {}

    if (!supabase) {
      // Load supabase-js from CDN and create client
      try {
        const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
        const url = 'https://ekggvujbuusvgmrertgp.supabase.co';
        const key = 'sb_publishable_q6XD_TD8KOQuphI30Gmi5Q_3PBAXQHo';
        supabase = createClient(url, key);
      } catch {}
    }

    function fmtTime(iso) {
      try {
        const t = new Date(iso);
        const now = new Date();
        const diffMs = now.getTime() - t.getTime();
        const mins = Math.floor(diffMs / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return `${mins}m ago`;
        const hours = Math.floor(mins / 60);
        if (hours < 24) return `${hours}h ago`;
        const days = Math.floor(hours / 24);
        if (days < 7) return `${days}d ago`;
        return t.toLocaleDateString();
      } catch {
        return '';
      }
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    async function loadComments() {
      try {
        const res = await fetch(`/api/comments?teaching=${encodeURIComponent(teachingId)}`);
        const data = await res.json();
        const comments = Array.isArray(data) ? data : [];
        if (countEl) {
          countEl.textContent = `${comments.length} comment${comments.length !== 1 ? 's' : ''}`;
        }
        if (!comments.length) {
          listEl.innerHTML = `<p class="comments-empty">No comments yet — be the first!</p>`;
          return;
        }
        listEl.innerHTML = comments.map((c) => {
          const name = escapeHtml(c.username || (c.email ? c.email.split('@')[0] : 'User'));
          const initial = name.charAt(0).toUpperCase();
          const body = escapeHtml(c.message).replace(/\n/g, '<br>');
          const time = escapeHtml(fmtTime(c.created_at));
          return `
            <div class="comment-item">
              <div class="comment-head">
                <span class="comment-avatar">${initial}</span>
                <span class="comment-name">${name}</span>
                <span class="comment-time">${time}</span>
              </div>
              <div class="comment-body">${body}</div>
            </div>
          `;
        }).join('');
      } catch (e) {
        listEl.innerHTML = `<p class="comments-error">Could not load comments.</p>`;
      }
    }

    async function getSession() {
      if (!supabase) return null;
      try {
        const { data } = await supabase.auth.getSession();
        return data?.session || null;
      } catch {
        return null;
      }
    }

    async function refreshAuthState() {
      const session = await getSession();
      if (session) {
        gateEl.hidden = true;
        formEl.hidden = false;
      } else {
        gateEl.hidden = false;
        formEl.hidden = true;
      }
    }

    async function submitComment() {
      if (!inputEl || !statusEl) return;
      const text = (inputEl.value || '').trim();
      if (!text) {
        statusEl.textContent = 'Please write something first.';
        return;
      }
      statusEl.textContent = 'Posting…';
      submitEl.disabled = true;

      const session = await getSession();
      if (!session) {
        statusEl.innerHTML = '<a href="/login">Log in</a> to post.';
        submitEl.disabled = false;
        return;
      }

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${session.access_token}`
          },
          body: JSON.stringify({
            teachingId,
            teachingTitle,
            message: text,
            shareToChat: !!(shareEl && shareEl.checked)
          })
        });
        const result = await res.json();
        if (!res.ok) {
          statusEl.textContent = result?.error || 'Could not post.';
          submitEl.disabled = false;
          return;
        }
        inputEl.value = '';
        if (shareEl) shareEl.checked = false;
        statusEl.textContent = (shareEl && shareEl.checked === false)
          ? 'Posted!'
          : 'Posted and shared to chat!';
        submitEl.disabled = false;
        setTimeout(() => { statusEl.textContent = ''; }, 3000);
        loadComments();
      } catch (e) {
        statusEl.textContent = 'Network error. Try again.';
        submitEl.disabled = false;
      }
    }

    if (submitEl) {
      submitEl.addEventListener('click', submitComment);
    }

    // React to auth changes (login/logout in another tab or this tab)
    if (supabase?.auth?.onAuthStateChange) {
      supabase.auth.onAuthStateChange(() => refreshAuthState());
    }

    refreshAuthState();
    loadComments();
  })();
</script>

<style>
  .comments-section {
    background: var(--reader-sidebar-bg, #f8f5ef);
    padding: 1.5rem;
    border-radius: 12px;
    margin: 2rem auto;
    max-width: 800px;
    border: 1px solid var(--reader-border, #e0d6c2);
  }
  .comments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .comments-header h3 {
    margin: 0;
    color: var(--reader-accent, #1a365d);
    font-size: 1.15rem;
  }
  .comment-count {
    background: var(--reader-accent, #1a365d);
    color: #fff;
    padding: 0.2rem 0.7rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }
  .comment-gate {
    text-align: center;
    padding: 1.25rem;
    background: #fff;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .comment-gate a {
    color: #744210;
    font-weight: 600;
  }
  .comment-form textarea {
    width: 100%;
    min-height: 100px;
    padding: 0.75rem;
    border: 1px solid var(--reader-border, #e0d6c2);
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    resize: vertical;
    box-sizing: border-box;
  }
  .comment-form textarea:focus {
    outline: 2px solid var(--reader-accent-light, #2a5a9e);
    border-color: var(--reader-accent-light, #2a5a9e);
  }
  .comment-form-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .share-toggle {
    font-size: 0.9rem;
    color: var(--reader-text-secondary, #555);
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    cursor: pointer;
  }
  .share-toggle a {
    color: #744210;
  }
  .comment-form button {
    padding: 0.6rem 1.25rem;
    background: linear-gradient(135deg, #744210, #975a16);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }
  .comment-form button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .comment-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--reader-accent, #1a365d);
    min-height: 1.2em;
  }
  .comment-list {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 500px;
    overflow-y: auto;
  }
  .comments-loading,
  .comments-empty,
  .comments-error {
    text-align: center;
    color: var(--reader-text-secondary, #555);
    font-style: italic;
    padding: 1rem;
  }
  .comments-error {
    color: #b23;
  }
  .comment-item {
    background: #fff;
    border: 1px solid var(--reader-border, #e0d6c2);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .comment-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .comment-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--reader-accent, #1a365d);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .comment-name {
    font-weight: 600;
    color: var(--reader-accent, #1a365d);
  }
  .comment-time {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--reader-text-secondary, #888);
  }
  .comment-body {
    color: var(--reader-text, #1a1a1a);
    line-height: 1.55;
    word-break: break-word;
  }
</style>
