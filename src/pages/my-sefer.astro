---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Build Your Sefer - Create a Personal Torah Anthology" description="Collect your favorite teachings from 226+ sacred Jewish texts into a personal holy book. Bookmark passages, add notes, arrange in custom order, and export as PDF." breadcrumbs={[{name: "Home", url: "https://ajew.org"}, {name: "My Sefer", url: "https://ajew.org/my-sefer"}]} jsonLd={{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Build Your Sefer - Personal Torah Anthology",
  "description": "Collect your favorite teachings into a personal holy book.",
  "url": "https://ajew.org/my-sefer",
  "isPartOf": { "@type": "WebSite", "name": "A Jew", "url": "https://ajew.org" }
}}>
  <div class="sefer-page">
    <!-- Header -->
    <div class="sefer-header">
      <h1 class="sefer-title-he">&#1489;&#1504;&#1492; &#1488;&#1514; &#1492;&#1505;&#1508;&#1512; &#1513;&#1500;&#1498;</h1>
      <h2 class="sefer-title-en">Build Your Sefer</h2>
      <p class="sefer-subtitle">Collect your favorite teachings into a personal holy book<br><span style="font-family: var(--font-hebrew); font-size: 0.85em; opacity: 0.8;" dir="rtl">אסוף את התורות האהובות עליך לספר קודש אישי</span></p>
      <div class="sefer-name-row">
        <label for="sefer-name-input">Name your Sefer:</label>
        <input type="text" id="sefer-name-input" placeholder="My Torah Journey" dir="auto" />
      </div>
    </div>

    <!-- Controls -->
    <div class="sefer-controls">
      <div class="sefer-stats">
        <span id="passage-count">0 passages</span>
      </div>
      <div class="sefer-actions">
        <button class="sefer-btn sefer-btn-primary" id="btn-export-pdf" title="Export as PDF">Export PDF</button>
        <button class="sefer-btn" id="btn-share-sefer" title="Share your sefer">Share</button>
        <button class="sefer-btn" id="btn-add-manual" title="Add a passage by reference">+ Add Passage</button>
        <button class="sefer-btn sefer-btn-danger" id="btn-clear-all" title="Remove all passages">Clear All</button>
      </div>
    </div>

    <!-- Filter bar -->
    <div class="sefer-filter-bar" id="filter-bar" style="display:none;">
      <label>Filter by tag:</label>
      <select id="tag-filter">
        <option value="">All</option>
      </select>
    </div>

    <!-- Passages list -->
    <div class="sefer-passages" id="passages-container">
      <!-- Populated by JS -->
    </div>

    <!-- Empty state -->
    <div class="sefer-empty" id="empty-state">
      <div class="sefer-empty-icon">&#128214;</div>
      <h3>Your Sefer is Empty</h3>
      <p>Start collecting teachings from across the library.<br>
      When reading any text, click the <strong>"Add to Sefer"</strong> button in the reader toolbar to save a passage here.</p>
      <a href="/reader" class="sefer-btn sefer-btn-primary">Browse the Library</a>
    </div>

    <!-- Add by reference modal -->
    <div class="sefer-modal" id="add-modal" style="display:none;">
      <div class="sefer-modal-content">
        <button class="sefer-modal-close" id="close-add-modal">&times;</button>
        <h3>Add Passage by Reference</h3>
        <p>Enter a reference to add to your Sefer:</p>
        <div class="add-form">
          <input type="text" id="add-ref-input" placeholder="e.g. Likutay Moharan 1:1" dir="auto" />
          <textarea id="add-he-input" placeholder="Hebrew text (optional)" dir="rtl" rows="3"></textarea>
          <textarea id="add-en-input" placeholder="English text (optional)" dir="ltr" rows="3"></textarea>
          <input type="text" id="add-tag-input" placeholder="Tag (optional)" />
          <button class="sefer-btn sefer-btn-primary" id="btn-add-confirm">Add to Sefer</button>
        </div>
      </div>
    </div>

    <!-- Print layout (hidden, shown only when printing) -->
    <div class="sefer-print-layout" id="print-layout"></div>
  </div>

  <style>
    /* ===== Sefer Page Styles ===== */
    .sefer-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px 60px;
      font-family: 'Open Sans', sans-serif;
    }

    /* Header */
    .sefer-header {
      text-align: center;
      padding: 40px 20px 24px;
      margin-bottom: 24px;
      background: linear-gradient(135deg, #fffdf7 0%, #f5efe0 100%);
      border-radius: 12px;
      border: 1px solid #e8dcc8;
    }
    .sefer-title-he {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 2.4rem;
      color: #1a365d;
      margin-bottom: 4px;
      direction: rtl;
    }
    .sefer-title-en {
      font-size: 1.4rem;
      color: #1a365d;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .sefer-subtitle {
      color: #666;
      font-size: 1rem;
      margin-bottom: 20px;
    }
    .sefer-name-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .sefer-name-row label {
      font-weight: 600;
      color: #1a365d;
    }
    .sefer-name-row input {
      padding: 8px 14px;
      border: 1px solid #d1c8b0;
      border-radius: 8px;
      font-size: 1rem;
      font-family: 'Frank Ruhl Libre', serif;
      background: white;
      width: 260px;
      text-align: center;
    }
    .sefer-name-row input:focus {
      outline: none;
      border-color: #1a365d;
      box-shadow: 0 0 0 2px rgba(26,54,93,0.15);
    }

    /* Controls */
    .sefer-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      margin-bottom: 16px;
      border-bottom: 1px solid #e8dcc8;
      flex-wrap: wrap;
      gap: 10px;
    }
    .sefer-stats {
      font-weight: 600;
      color: #1a365d;
      font-size: 1.05rem;
    }
    .sefer-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Buttons */
    .sefer-btn {
      padding: 8px 16px;
      border: 1px solid #d1c8b0;
      border-radius: 8px;
      background: white;
      color: #1a365d;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'Open Sans', sans-serif;
    }
    .sefer-btn:hover {
      background: #f5efe0;
      border-color: #1a365d;
    }
    .sefer-btn-primary {
      background: #1a365d;
      color: white;
      border-color: #1a365d;
    }
    .sefer-btn-primary:hover {
      background: #2c5282;
    }
    .sefer-btn-danger {
      color: #c53030;
      border-color: #e8dcc8;
    }
    .sefer-btn-danger:hover {
      background: #fff5f5;
      border-color: #c53030;
    }

    /* Filter bar */
    .sefer-filter-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      margin-bottom: 12px;
    }
    .sefer-filter-bar label {
      font-size: 0.9rem;
      color: #666;
    }
    .sefer-filter-bar select {
      padding: 6px 10px;
      border: 1px solid #d1c8b0;
      border-radius: 6px;
      font-size: 0.9rem;
      background: white;
    }

    /* Passage cards */
    .sefer-passages {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .passage-card {
      background: white;
      border: 1px solid #e8dcc8;
      border-radius: 10px;
      padding: 16px 18px;
      position: relative;
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .passage-card:hover {
      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
      border-color: #c9b99a;
    }
    .passage-card.dragging {
      opacity: 0.5;
      border: 2px dashed #1a365d;
    }
    .passage-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }
    .passage-ref {
      font-weight: 700;
      color: #1a365d;
      font-size: 1rem;
    }
    .passage-ref-he {
      font-family: 'Frank Ruhl Libre', serif;
      direction: rtl;
      display: block;
      font-size: 1.1rem;
    }
    .passage-ref-en {
      font-size: 0.85rem;
      color: #666;
    }
    .passage-card-actions {
      display: flex;
      gap: 4px;
      align-items: center;
      flex-shrink: 0;
    }
    .passage-action-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px 6px;
      border-radius: 4px;
      font-size: 1rem;
      color: #888;
      transition: all 0.15s;
    }
    .passage-action-btn:hover {
      background: #f0ebe0;
      color: #1a365d;
    }
    .passage-action-btn.danger:hover {
      background: #fff5f5;
      color: #c53030;
    }
    .passage-text-he {
      font-family: 'Frank Ruhl Libre', serif;
      direction: rtl;
      text-align: right;
      line-height: 1.8;
      font-size: 1.05rem;
      color: #333;
      margin-bottom: 6px;
    }
    .passage-text-en {
      line-height: 1.6;
      font-size: 0.95rem;
      color: #555;
      margin-bottom: 10px;
    }
    .passage-note {
      margin-top: 8px;
    }
    .passage-note textarea {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #e8dcc8;
      border-radius: 6px;
      font-size: 0.9rem;
      font-family: 'Open Sans', sans-serif;
      resize: vertical;
      min-height: 36px;
      color: #333;
      background: #fdfcf8;
    }
    .passage-note textarea:focus {
      outline: none;
      border-color: #1a365d;
      background: white;
    }
    .passage-note textarea::placeholder {
      color: #aaa;
    }
    .passage-tag {
      display: inline-block;
      background: #edf2f7;
      color: #1a365d;
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 10px;
      margin-top: 6px;
    }
    .passage-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 8px;
      font-size: 0.8rem;
      color: #999;
    }
    .passage-read-link {
      font-size: 0.85rem;
      color: #1a365d;
      text-decoration: none;
      font-weight: 600;
    }
    .passage-read-link:hover {
      text-decoration: underline;
    }
    .passage-number {
      position: absolute;
      top: 14px;
      left: 14px;
      background: #edf2f7;
      color: #1a365d;
      font-weight: 700;
      font-size: 0.75rem;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }
    .passage-drag-handle {
      cursor: grab;
      font-size: 1.2rem;
      user-select: none;
      color: #ccc;
      padding: 2px 4px;
    }
    .passage-drag-handle:active {
      cursor: grabbing;
    }

    /* Empty state */
    .sefer-empty {
      text-align: center;
      padding: 60px 20px;
      color: #888;
    }
    .sefer-empty-icon {
      font-size: 3rem;
      margin-bottom: 16px;
    }
    .sefer-empty h3 {
      font-size: 1.3rem;
      color: #1a365d;
      margin-bottom: 12px;
    }
    .sefer-empty p {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 20px;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Modal */
    .sefer-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .sefer-modal-content {
      background: white;
      border-radius: 12px;
      padding: 28px;
      max-width: 500px;
      width: 100%;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
    }
    .sefer-modal-close {
      position: absolute;
      top: 12px;
      right: 14px;
      background: none;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      color: #888;
    }
    .sefer-modal-close:hover {
      color: #333;
    }
    .sefer-modal-content h3 {
      margin-bottom: 8px;
      color: #1a365d;
    }
    .sefer-modal-content p {
      margin-bottom: 16px;
      color: #666;
      font-size: 0.9rem;
    }
    .add-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .add-form input, .add-form textarea {
      padding: 8px 12px;
      border: 1px solid #d1c8b0;
      border-radius: 6px;
      font-size: 0.95rem;
      font-family: 'Open Sans', sans-serif;
    }
    .add-form textarea {
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 1rem;
    }
    .add-form input:focus, .add-form textarea:focus {
      outline: none;
      border-color: #1a365d;
    }

    /* Print layout */
    .sefer-print-layout {
      display: none;
    }

    /* ===== Dark mode ===== */
    body.dark-mode .sefer-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #222244 100%);
      border-color: #333;
    }
    body.dark-mode .sefer-title-he,
    body.dark-mode .sefer-title-en {
      color: #c8d6e5;
    }
    body.dark-mode .sefer-subtitle {
      color: #999;
    }
    body.dark-mode .sefer-name-row label {
      color: #c8d6e5;
    }
    body.dark-mode .sefer-name-row input {
      background: #2a2a4e;
      color: #e0e0e0;
      border-color: #444;
    }
    body.dark-mode .sefer-controls {
      border-color: #444;
    }
    body.dark-mode .sefer-stats {
      color: #c8d6e5;
    }
    body.dark-mode .sefer-btn {
      background: #2a2a4e;
      color: #c8d6e5;
      border-color: #444;
    }
    body.dark-mode .sefer-btn:hover {
      background: #333366;
      border-color: #666;
    }
    body.dark-mode .sefer-btn-primary {
      background: #2c5282;
      color: white;
      border-color: #2c5282;
    }
    body.dark-mode .sefer-btn-primary:hover {
      background: #3a6aaa;
    }
    body.dark-mode .sefer-btn-danger {
      color: #fc8181;
    }
    body.dark-mode .passage-card {
      background: #222244;
      border-color: #444;
    }
    body.dark-mode .passage-card:hover {
      border-color: #666;
      box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }
    body.dark-mode .passage-ref {
      color: #c8d6e5;
    }
    body.dark-mode .passage-ref-en {
      color: #999;
    }
    body.dark-mode .passage-text-he {
      color: #e0e0e0;
    }
    body.dark-mode .passage-text-en {
      color: #bbb;
    }
    body.dark-mode .passage-note textarea {
      background: #2a2a4e;
      color: #e0e0e0;
      border-color: #444;
    }
    body.dark-mode .passage-note textarea:focus {
      background: #333366;
      border-color: #7db0ed;
    }
    body.dark-mode .passage-tag {
      background: #333366;
      color: #c8d6e5;
    }
    body.dark-mode .passage-number {
      background: #333366;
      color: #c8d6e5;
    }
    body.dark-mode .passage-action-btn {
      color: #888;
    }
    body.dark-mode .passage-action-btn:hover {
      background: #333366;
      color: #c8d6e5;
    }
    body.dark-mode .sefer-empty {
      color: #999;
    }
    body.dark-mode .sefer-empty h3 {
      color: #c8d6e5;
    }
    body.dark-mode .sefer-modal-content {
      background: #1a1a2e;
      color: #e0e0e0;
    }
    body.dark-mode .sefer-modal-content h3 {
      color: #c8d6e5;
    }
    body.dark-mode .sefer-modal-content p {
      color: #999;
    }
    body.dark-mode .add-form input,
    body.dark-mode .add-form textarea {
      background: #2a2a4e;
      color: #e0e0e0;
      border-color: #444;
    }
    body.dark-mode .passage-read-link {
      color: #7db0ed;
    }

    /* ===== Responsive ===== */
    @media (max-width: 600px) {
      .sefer-header {
        padding: 28px 14px 20px;
      }
      .sefer-title-he {
        font-size: 1.8rem;
      }
      .sefer-title-en {
        font-size: 1.1rem;
      }
      .sefer-controls {
        flex-direction: column;
        align-items: stretch;
      }
      .sefer-actions {
        justify-content: center;
      }
      .sefer-name-row input {
        width: 200px;
      }
      .passage-card {
        padding: 14px;
      }
    }

    /* ===== Print styles ===== */
    @media print {
      .navbar, footer, .sefer-controls, .sefer-filter-bar,
      .sefer-empty, .sefer-modal, .back-to-top, .passage-card-actions,
      .passage-note, .passage-drag-handle, .passage-number,
      #voice-input-btn, #voice-overlay, .skip-link {
        display: none !important;
      }
      .sefer-page {
        max-width: 100%;
        padding: 0;
      }
      .sefer-header {
        background: none !important;
        border: none;
        page-break-after: always;
        padding: 120px 40px 60px;
      }
      .sefer-title-he {
        font-size: 3rem;
        margin-bottom: 12px;
      }
      .sefer-title-en {
        font-size: 1.6rem;
        margin-bottom: 16px;
      }
      .sefer-subtitle {
        display: none;
      }
      .sefer-name-row {
        display: none;
      }
      .sefer-header::after {
        content: '';
        display: block;
        width: 80px;
        height: 2px;
        background: #1a365d;
        margin: 24px auto 0;
      }
      .passage-card {
        border: none;
        border-bottom: 1px solid #ddd;
        border-radius: 0;
        padding: 20px 10px;
        page-break-inside: avoid;
        box-shadow: none !important;
      }
      .passage-card:last-child {
        border-bottom: none;
      }
      .passage-text-he {
        font-size: 1.15rem;
        line-height: 2;
      }
      .passage-text-en {
        font-size: 0.95rem;
        line-height: 1.7;
      }
      .passage-ref {
        font-size: 1.05rem;
        margin-bottom: 8px;
      }
      .passage-meta {
        display: none;
      }
      .passage-tag {
        display: none;
      }
      .passage-read-link {
        display: none;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>

  <script is:inline>
  (function() {
    'use strict';

    const SEFER_KEY = 'mySefer';

    // --- Data ---
    function loadSefer() {
      try {
        const raw = localStorage.getItem(SEFER_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return { name: '', passages: [], createdAt: Date.now(), updatedAt: Date.now() };
    }

    function saveSefer(sefer) {
      sefer.updatedAt = Date.now();
      try {
        localStorage.setItem(SEFER_KEY, JSON.stringify(sefer));
      } catch (e) {
        alert('Could not save. LocalStorage may be full.');
      }
    }

    let sefer = loadSefer();

    // --- Render ---
    const nameInput = document.getElementById('sefer-name-input');
    const passagesContainer = document.getElementById('passages-container');
    const emptyState = document.getElementById('empty-state');
    const countEl = document.getElementById('passage-count');
    const filterBar = document.getElementById('filter-bar');
    const tagFilter = document.getElementById('tag-filter');

    if (nameInput) {
      nameInput.value = sefer.name || '';
      nameInput.addEventListener('input', () => {
        sefer.name = nameInput.value;
        saveSefer(sefer);
      });
    }

    function getAllTags() {
      const tags = new Set();
      sefer.passages.forEach(p => {
        if (p.tag) tags.add(p.tag);
      });
      return [...tags].sort();
    }

    function updateTagFilter() {
      const tags = getAllTags();
      if (tags.length === 0) {
        filterBar.style.display = 'none';
        return;
      }
      filterBar.style.display = 'flex';
      const current = tagFilter.value;
      tagFilter.innerHTML = '<option value="">All</option>';
      tags.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t;
        opt.textContent = t;
        if (t === current) opt.selected = true;
        tagFilter.appendChild(opt);
      });
    }

    function render() {
      const filter = tagFilter ? tagFilter.value : '';
      const passages = filter ? sefer.passages.filter(p => p.tag === filter) : sefer.passages;

      if (sefer.passages.length === 0) {
        passagesContainer.style.display = 'none';
        emptyState.style.display = 'block';
        countEl.textContent = '0 passages';
        filterBar.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      passagesContainer.style.display = 'flex';
      countEl.textContent = sefer.passages.length + ' passage' + (sefer.passages.length === 1 ? '' : 's');
      updateTagFilter();

      passagesContainer.innerHTML = '';
      passages.forEach((p, displayIdx) => {
        const realIdx = sefer.passages.indexOf(p);
        const card = document.createElement('div');
        card.className = 'passage-card';
        card.draggable = true;
        card.dataset.idx = realIdx;

        const heSnippet = (p.he || '').replace(/<[^>]+>/g, '').slice(0, 150);
        const enSnippet = (p.en || '').replace(/<[^>]+>/g, '').slice(0, 200);
        const refHe = p.refHe || '';
        const refEn = p.ref || p.readerUrl || '';
        const dateStr = p.addedAt ? new Date(p.addedAt).toLocaleDateString() : '';

        card.innerHTML = `
          <span class="passage-number">${realIdx + 1}</span>
          <div class="passage-card-header">
            <div class="passage-ref">
              ${refHe ? '<span class="passage-ref-he">' + escHtml(refHe) + '</span>' : ''}
              <span class="passage-ref-en">${escHtml(refEn)}</span>
            </div>
            <div class="passage-card-actions">
              <span class="passage-drag-handle" title="Drag to reorder">&#9776;</span>
              <button class="passage-action-btn" data-action="up" title="Move up">&#9650;</button>
              <button class="passage-action-btn" data-action="down" title="Move down">&#9660;</button>
              <button class="passage-action-btn danger" data-action="remove" title="Remove">&#10005;</button>
            </div>
          </div>
          ${heSnippet ? '<div class="passage-text-he">' + escHtml(heSnippet) + (p.he && p.he.length > 150 ? '...' : '') + '</div>' : ''}
          ${enSnippet ? '<div class="passage-text-en">' + escHtml(enSnippet) + (p.en && p.en.length > 200 ? '...' : '') + '</div>' : ''}
          <div class="passage-note">
            <textarea placeholder="Add a personal note..." rows="1">${escHtml(p.note || '')}</textarea>
          </div>
          ${p.tag ? '<span class="passage-tag">' + escHtml(p.tag) + '</span>' : ''}
          <div class="passage-meta">
            <span>${dateStr}</span>
            ${p.readerUrl ? '<a href="' + escHtml(p.readerUrl) + '" class="passage-read-link">Read Full &rarr;</a>' : ''}
          </div>
        `;

        // Event handlers
        card.querySelector('[data-action="up"]').addEventListener('click', () => move(realIdx, -1));
        card.querySelector('[data-action="down"]').addEventListener('click', () => move(realIdx, 1));
        card.querySelector('[data-action="remove"]').addEventListener('click', () => {
          if (confirm('Remove this passage from your Sefer?')) {
            sefer.passages.splice(realIdx, 1);
            saveSefer(sefer);
            render();
          }
        });
        card.querySelector('textarea').addEventListener('input', (e) => {
          sefer.passages[realIdx].note = e.target.value;
          saveSefer(sefer);
        });

        // Drag and drop
        card.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', String(realIdx));
          card.classList.add('dragging');
        });
        card.addEventListener('dragend', () => card.classList.remove('dragging'));
        card.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
        });
        card.addEventListener('drop', (e) => {
          e.preventDefault();
          const fromIdx = parseInt(e.dataTransfer.getData('text/plain'));
          const toIdx = realIdx;
          if (fromIdx === toIdx) return;
          const item = sefer.passages.splice(fromIdx, 1)[0];
          sefer.passages.splice(toIdx, 0, item);
          saveSefer(sefer);
          render();
        });

        passagesContainer.appendChild(card);
      });
    }

    function move(idx, dir) {
      const newIdx = idx + dir;
      if (newIdx < 0 || newIdx >= sefer.passages.length) return;
      const item = sefer.passages.splice(idx, 1)[0];
      sefer.passages.splice(newIdx, 0, item);
      saveSefer(sefer);
      render();
    }

    function escHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // --- Tag filter ---
    if (tagFilter) {
      tagFilter.addEventListener('change', render);
    }

    // --- Export PDF ---
    document.getElementById('btn-export-pdf').addEventListener('click', () => {
      if (sefer.passages.length === 0) {
        alert('Your Sefer is empty. Add some passages first!');
        return;
      }
      window.print();
    });

    // --- Share ---
    document.getElementById('btn-share-sefer').addEventListener('click', () => {
      if (sefer.passages.length === 0) {
        alert('Your Sefer is empty. Add some passages first!');
        return;
      }
      // Build shareable data: compact references
      const refs = sefer.passages.map(p => p.ref || p.readerUrl || '').filter(Boolean);
      const data = {
        name: sefer.name || 'My Sefer',
        refs: refs
      };
      const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(data))));
      const url = window.location.origin + '/my-sefer?s=' + encoded;

      if (navigator.share) {
        navigator.share({
          title: sefer.name || 'My Sefer',
          text: 'Check out my personal Torah anthology on ajew.org',
          url: url
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(url).then(() => {
          const btn = document.getElementById('btn-share-sefer');
          btn.textContent = 'Link Copied!';
          setTimeout(() => { btn.textContent = 'Share'; }, 2000);
        }).catch(() => {
          prompt('Copy this link:', url);
        });
      }
    });

    // --- Add manually ---
    const addModal = document.getElementById('add-modal');
    document.getElementById('btn-add-manual').addEventListener('click', () => {
      addModal.style.display = 'flex';
    });
    document.getElementById('close-add-modal').addEventListener('click', () => {
      addModal.style.display = 'none';
    });
    addModal.addEventListener('click', (e) => {
      if (e.target === addModal) addModal.style.display = 'none';
    });

    document.getElementById('btn-add-confirm').addEventListener('click', () => {
      const ref = document.getElementById('add-ref-input').value.trim();
      const he = document.getElementById('add-he-input').value.trim();
      const en = document.getElementById('add-en-input').value.trim();
      const tag = document.getElementById('add-tag-input').value.trim();
      if (!ref && !he && !en) {
        alert('Please enter at least a reference or some text.');
        return;
      }
      sefer.passages.push({
        ref: ref,
        refHe: '',
        he: he,
        en: en,
        readerUrl: '',
        addedAt: Date.now(),
        note: '',
        tag: tag || ''
      });
      saveSefer(sefer);
      render();
      addModal.style.display = 'none';
      // Clear inputs
      document.getElementById('add-ref-input').value = '';
      document.getElementById('add-he-input').value = '';
      document.getElementById('add-en-input').value = '';
      document.getElementById('add-tag-input').value = '';
    });

    // --- Clear all ---
    document.getElementById('btn-clear-all').addEventListener('click', () => {
      if (sefer.passages.length === 0) return;
      if (confirm('Are you sure you want to remove ALL passages from your Sefer? This cannot be undone.')) {
        sefer.passages = [];
        saveSefer(sefer);
        render();
      }
    });

    // --- Load shared sefer from URL ---
    function loadFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const encoded = params.get('s');
      if (!encoded) return;
      try {
        const json = decodeURIComponent(escape(atob(encoded)));
        const data = JSON.parse(json);
        if (data.refs && data.refs.length > 0) {
          const proceed = confirm('Load shared Sefer "' + (data.name || 'Untitled') + '" with ' + data.refs.length + ' references? This will add to your current collection.');
          if (proceed) {
            data.refs.forEach(ref => {
              if (!sefer.passages.some(p => p.ref === ref || p.readerUrl === ref)) {
                sefer.passages.push({
                  ref: ref,
                  refHe: '',
                  he: '',
                  en: '',
                  readerUrl: ref.startsWith('/') ? ref : '',
                  addedAt: Date.now(),
                  note: '',
                  tag: ''
                });
              }
            });
            if (data.name && !sefer.name) {
              sefer.name = data.name;
              nameInput.value = data.name;
            }
            saveSefer(sefer);
            render();
          }
          // Clean URL
          history.replaceState(null, '', window.location.pathname);
        }
      } catch(e) {
        console.error('Could not parse shared sefer:', e);
      }
    }

    // --- Init ---
    render();
    loadFromUrl();
  })();
  </script>
</Layout>
