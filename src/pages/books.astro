---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ספרי ברסלב" description="All Breslov books in Hebrew">
  <div class="books-page">
    <header class="page-header">
      <h1>ספרי ברסלב בלשון הקודש</h1>
      <p class="subtitle">All Breslov Books in Hebrew</p>
    </header>

    <div class="search-section">
      <div class="search-box">
        <input 
          type="text" 
          id="bookSearch" 
          placeholder="חפש ספר... Search for a book..."
          dir="rtl"
        />
        <span class="search-icon">🔍</span>
      </div>
    </div>

    <div class="categories-grid" id="categoriesGrid"></div>

    <div class="search-results" id="searchResults" style="display: none;">
      <h3>תוצאות חיפוש / Search Results</h3>
      <ul class="results-list" id="resultsList"></ul>
      <button class="back-btn" id="backToCategories">חזור לרשימה / Back to List</button>
    </div>
  </div>
</Layout>

<script>
  // Book data - loaded client-side from the folder structure
  const booksData = [
    {
      name: "ספרי רבי נחמן",
      originalName: "1_ספרי רבי נחמן",
      books: [
        { name: "01_ליקוטי מוהר''ן", filename: "01_ליקוטי מוהר''ן.txt" },
        { name: "02_ ליקוטי מוהר''ן מנוקד", filename: "02_ ליקוטי מוהר''ן מנוקד.txt" },
        { name: "02_קיצור ליקוטי מוהרן השלם", filename: "02_קיצור ליקוטי מוהרן השלם.txt" },
        { name: "03_ספר המידות", filename: "03_ספר המידות.txt" },
        { name: "04_ספורי מעשיות", filename: "04_ספורי מעשיות.txt" },
        { name: "05_ספורי מעשיות מנוקד", filename: "05_ספורי מעשיות מנוקד.txt" },
        { name: "06_שיחות הר''ן", filename: "06_שיחות הר''ן.txt" },
        { name: "06א_שיחות הר''ן מנוקד", filename: "06א_שיחות הר''ן מנוקד.txt" },
        { name: "07_חיי מוהר''ן", filename: "07_חיי מוהר''ן.txt" },
        { name: "08_חיי מוהרן מנוקד", filename: "08_חיי מוהרן מנוקד.txt" },
        { name: "09_שבחי הר''ן", filename: "09_שבחי הר''ן.txt" },
        { name: "09א_שבחי הר''ן מנוקד", filename: "09א_שבחי הר''ן מנוקד.txt" }
      ]
    },
    {
      name: "ספרי רבי נתן",
      originalName: "2_ספרי רבי נתן",
      books: [
        { name: "ליקוטי הלכות", filename: "ליקוטי הלכות.txt" },
        { name: "שיחות הר''ן ליקוטי דפוס", filename: "שיחות הר''ן ליקוטי דפוס.txt" },
        { name: "שיחות הר''ן ליקוטי ישן", filename: "שיחות הר''ן ליקוטי ישן.txt" },
        { name: "שיחות הר''ן מכתב יד", filename: "שיחות הר''ן מכתב יד.txt" },
        { name: "שבחי הר''ן", filename: "שבחי הר''ן.txt" },
