---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/likutay-nanach/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.parts || [];
  } catch (e) {}
  return parts.map((p, index) => ({ params: { part: String(index + 1) }, props: { partMeta: p } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/likutay-nanach/volume-' + partNum + '/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || "Likutay NaNach"} — Part ${partNum} Index`} description={`Beautiful directory for Likutay NaNach, part ${partNum}.`}>
  <ReaderDirectory
    title="Likutay NaNach"
    hebrewTitle="ליקוטי נ נח"
    subtitle={`Na Nach teachings and commentary · Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={indexData?.torahs || []}
    hrefBase={`/reader/likutay-nanach/${partNum}/`}
  />
</Layout>
