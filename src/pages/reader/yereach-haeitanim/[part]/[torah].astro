---
import {loadEdition} from '../../../../lib/qualified-yereach-haeitanim.mjs';
export async function getStaticPaths(){
 const edition=await loadEdition();
 return edition.groups.map(g=>({params:{part:'1',torah:String(g.section)},props:{section:g.section,indices:edition.units.filter(u=>u.section===g.section).map(u=>u.source_index),target:edition.route+'/'}}));
}
const {section,indices,target}=Astro.props;
const fallback=target+'#group-yereach'+section;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><link rel="canonical" href={'https://ajew.org'+fallback}/><meta http-equiv="refresh" content={'0;url='+fallback}/><title>Yerach Hu'Aisuneem — Hebrew and English</title></head><body><p><a href={fallback}>Continue to the Hebrew and English edition with source notes.</a></p><script define:vars={{section,indices,target}}>
const match=location.hash.match(/^#(?:seg|aligned)-(\d+)$/);
const index=match?Number(match[1]):null;
const anchor=index!==null&&indices.includes(index)?'#ye-'+section+':'+index:'#group-yereach'+section;
location.replace(target+location.search+anchor);
</script></body></html>
