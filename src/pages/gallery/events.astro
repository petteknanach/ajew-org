import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const imageDir = './public/images/events/';

function getAllImages() &lbrace;
  try &lbrace;
    const files = fs.readdirSync(imageDir);
    return files.filter(file => 
      /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(file) &&
      !file.startsWith('.'))
    .sort();
  &rbrace; catch (e) &lbrace; return []; &rbrace;
&rbrace;

const allImages = getAllImages();

function formatFilename(filename) &lbrace;
  let formatted = decodeURIComponent(filename);
  formatted = formatted.replace(/\.(jpg|jpeg|png|gif|webp|svg)$/i, '');
  formatted = formatted.replace(/[-_]/g, ' ');
  formatted = formatted.replace(/\b\w/g, l => l.toUpperCase());
  return formatted;
&rbrace;

const beanies = allImages.filter(img => img.includes('beanie') || img.includes('beanies'));
const music = allImages.filter(img => 
  img.includes('guitar') || img.includes('tzinor') || img.includes('singing') ||
  img.includes('hochman') || img.includes('dagan') || img.includes('playing'));
const friends = allImages.filter(img =>
  img.includes('friends') || img.includes('aron') || img.includes('heuberger') ||
  img.includes('shilo') || img.includes('gavriel') || img.includes('levi') ||
  img.includes('chaim') || img.includes('walden') || img.includes('meir') ||
  img.includes('weiner') || img.includes('tzvi') || img.includes('levin') ||
  img.includes('simcha') || img.includes('kids') || img.includes('snowman') ||
  img.includes('uman'));
const portraits = allImages.filter(img =>
  img.includes('portrait') || img.includes('face') || img.includes('self') ||
  img.includes('hair') || img.includes('yosef') || img.includes('eliyahu') ||
  img.includes('gordetzky'));

const categorized = new Set([...beanies, ...music, ...friends, ...portraits]);
const other = allImages.filter(img => !categorized.has(img));
-

<Layout title="Events Gallery" description="Photos from Na Nach events, simchas, and gatherings">
  <section class="page-header">
    <h1>✡ Events & Gatherings ✡</h1>
    <p>Na Nach celebrations and gatherings</p>
    <p class="hebrew">אירועים והתכנסויות</p>
    <p class="stats">&lbrace;allImages.length&rbrace; photos</p>
    <a href="/gallery" class="back-link">← Back to Gallery</a>
  </section>

  <section class="intro">
    <div class="container">
      <div class="info-box">
        <h2>🎉 Celebrating Together</h2>
        <p>Photos from Na Nach events, simchas, and gatherings from around the world.</p>
        <p class="hebrew">תמונות מאירועי נ נח, שמחות, והתכנסויות מכל העולם</p>
      </div>
      
      <div class="quick-index">
        <h3>📂 Quick Index</h3>
        <div class="index-links">
          &lbrace;friends.length > 0 && <a href="#friends" class="index-link"><span class="icon">👥</span><span class="name">Friends & People</span><span class="count">&lbrace;friends.length&rbrace;</span></a>&rbrace;
          &lbrace;music.length > 0 && <a href="#music" class="index-link"><span class="icon">🎵</span><span class="name">Music & Singing</span><span class="count">&lbrace;music.length&rbrace;</span></a>&rbrace;
          &lbrace;portraits.length > 0 && <a href="#portraits" class="index-link"><span class="icon">😊</span><span class="name">Portraits</span><span class="count">&lbrace;portraits.length&rbrace;</span></a>&rbrace;
          &lbrace;beanies.length > 0 && <a href="#beanies" class="index-link"><span class="icon">🧢</span><span class="name">Na Nach Beanies</span><span class="count">&lbrace;beanies.length&rbrace;</span></a>&rbrace;
          &lbrace;other.length > 0 && <a href="#other" class="index-link"><span class="icon">📷</span><span class="name">Other</span><span class="count">&lbrace;other.length&rbrace;</span></a>&rbrace;
        </div>
      </div>
    </div>
  </section>

  <section class="gallery">
    <div class="container">
      &lbrace;friends.length > 0 && (
        <div id="friends" class="category-section">
          <h2><span class="icon">👥</span> Friends & People <span class="hebrew">(חברים ואנשים)</span></h2>
          <div class="gallery-grid">
            &lbrace;friends.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/events/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;music.length > 0 && (
        <div id="music" class="category-section">
          <h2><span class="icon">🎵</span> Music & Singing <span class="hebrew">(מוזיקה ושירה)</span></h2>
          <div class="gallery-grid">
            &lbrace;music.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/events/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;portraits.length > 0 && (
        <div id="portraits" class="category-section">
          <h2><span class="icon">😊</span> Portraits <span class="hebrew">(דיוקנאות)</span></h2>
          <div class="gallery-grid">
            &lbrace;portraits.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/events/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;beanies.length > 0 && (
        <div id="beanies" class="category-section">
          <h2><span class="icon">🧢</span> Na Nach Beanies <span class="hebrew">(סניקיות נ נח)</span></h2>
          <div class="gallery-grid">
            &lbrace;beanies.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/events/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
      &lbrace;other.length > 0 && (
        <div id="other" class="category-section">
          <h2><span class="icon">📷</span> Other Photos <span class="hebrew">(תמונות אחרות)</span></h2>
          <div class="gallery-grid">
            &lbrace;other.map((img, i) => (
              <div class="gallery-item">
                <img src=&lbrace;`/images/events/$&lbrace;img&rbrace;`&rbrace; alt=&lbrace;formatFilename(img)&rbrace; loading="lazy" />
                <div class="caption">&lbrace;formatFilename(img)&rbrace;</div>
              </div>
            ))&rbrace;
          </div>
        </div>
      )&rbrace;
    </div>
  </section>

  <section class="navigation">
    <div class="container">
      <div class="nav-buttons">
        <a href="/gallery/nanach" class="nav-btn">← Na Nach Life</a>
        <a href="/teachings" class="nav-btn">Teachings →</a>
      </div>
    </div>
  </section>
</Layout>

