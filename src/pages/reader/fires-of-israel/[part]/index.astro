---
import Layout from '../../../../layouts/Layout.astro';
import ReaderDirectory from '../../../../components/ReaderDirectory.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const idxPath = path.join(process.cwd(), 'public/reader/fires-of-israel/index.json');
  let parts = [];
  try {
    const idx = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
    parts = idx.torahs?.length ? [{ part: 1 }] : [];
  } catch (e) {}
  return parts.map(p => ({ params: { part: String(p.part) } }));
}

const { part } = Astro.params;
const partNum = parseInt(part);

let indexData = null;
try {
  const idxPath = path.join(process.cwd(), 'public/reader/fires-of-israel/index.json');
  indexData = JSON.parse(fs.readFileSync(idxPath, 'utf8'));
} catch (e) {
  console.error('Error loading index:', e);
}

const totalSections = indexData?.torahs?.length || 0;
---
<Layout title={`${indexData?.title || "Fires of Israel"} — Part ${partNum} Index`} description={`Beautiful directory for Fires of Israel, part ${partNum}.`}>
  <ReaderDirectory
    title="Fires of Israel"
    hebrewTitle="אשי ישראל"
    subtitle={`Part ${partNum}`}
    countLabel={`${totalSections} sections`}
    items={(indexData?.torahs || []).map(item => ({ ...item, number: item.torah, url: `/reader/fires-of-israel/${partNum}/${item.torah}/` }))}
    hrefBase={`/reader/fires-of-israel/${partNum}/`}
  />
</Layout>
