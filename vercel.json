{
  "version": 2,
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=8192 astro build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": null,
  "devCommand": null,
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-0.xml"
    }
  ],
  "redirects": [
    {
      "source": "/teachings",
      "destination": "/reader",
      "permanent": true
    },
    {
      "source": "/connections",
      "destination": "/mapjs",
      "permanent": true
    },
    {
      "source": "/torah-map",
      "destination": "/mapjs",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/search-enhanced",
      "permanent": true
    },
    {
      "source": "/lm18",
      "destination": "/reader/likutay-moharan/part-1/18",
      "permanent": true
    },
    {
      "source": "/lm19",
      "destination": "/reader/likutay-moharan/part-1/19",
      "permanent": true
    },
    {
      "source": "/lm63",
      "destination": "/reader/likutay-moharan/part-1/63",
      "permanent": true
    },
    {
      "source": "/lm77",
      "destination": "/reader/likutay-moharan/part-1/77",
      "permanent": true
    },
    {
      "source": "/lm99",
      "destination": "/reader/likutay-moharan/part-1/99",
      "permanent": true
    },
    {
      "source": "/lm100",
      "destination": "/reader/likutay-moharan/part-1/100",
      "permanent": true
    },
    {
      "source": "/lm103",
      "destination": "/reader/likutay-moharan/part-1/103",
      "permanent": true
    },
    {
      "source": "/lm108",
      "destination": "/reader/likutay-moharan/part-1/108",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/reader/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=31536000, immutable"
        }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}