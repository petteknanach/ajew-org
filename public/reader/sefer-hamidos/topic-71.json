    },
    {
      "index": 2,
      "he": "ב.\n\nעַל יְדֵי סְפִירַת הָעֹמֶר נִצּוֹלִין מִגֵּרוּשׁ.",
      "en": "",
      "id": "sh-ספירתהעמר-ב"
    },
    {
      "index": 3,
      "he": "ג.\n\nבְּיוֹתֵר צָרִיךְ לְהִזָּהֵר לִטְבֹּל לְקִרְיוֹ בִּימֵי עֹמֶר.",
      "en": "",
      "id": "sh-ספירתהעמר-ג"
    },
    {
      "index": 4,
      "he": "ד.\n\nבִּסְפִירַת הָעֹמֶר יְכוֹלִין לְהַכְנִיעַ אֶת הַמָּסוּר. וְסִימָן: לָעֹמֶר – רָאשֵׁי תֵבוֹת : מֵ 'אִיגְּרָא  רָ 'מָא  לְ 'בִירָא  עֲ ' מִיקְתָּא.",
      "en": "",
      "id": "sh-ספירתהעמר-ד"
    }
  ],
