import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const imageDir = './public/images/nanach/';

function getAllImages() &lbrace;
  try &lbrace;
    const files = fs.readdirSync(imageDir);
    return files.filter(file => 
      /\.(jpg|jpeg|png|gif|webp|svg)$/i.test(file) &&
      !file.startsWith('.')
    ).sort();
  &rbrace; catch (e) &lbrace;
    return [];
  &rbrace;
&rbrace;

const allImages = getAllImages();

function formatFilename(filename) &lbrace;
  let formatted = decodeURIComponent(filename);
  formatted = formatted.replace(/\.(jpg|jpeg|png|gif|webp|svg)$/i, '');
  formatted = formatted.replace(/[-_]/g, ' ');
  formatted = formatted.replace(/\b\w/g, l => l.toUpperCase());
  return formatted;
&rbrace;

const categories = &lbrace;
  'graffiti': &lbrace;
    name: 'Graffiti & Street Art',
    hebrew: 'גרפיטי ואמנות רחוב',
    icon: '🎨',
    images: allImages.filter(img => 
      (img.includes('graffiti') || img.includes('spray') || img.includes('stencil') ||
       img.includes('stickerbomb') || img.includes('wall') && img.includes('nanach') ||
       img.includes('brick') || img.includes('painting') || img.includes('paint') ||
       img.includes('roof') && img.includes('nanach') || img.includes('fence') && img.includes('nanach') ||
       img.includes('yellow building') || img.includes('syria')) &&
      !img.includes('van') && !img.includes('bais-rabbainu')
    )
  &rbrace;,
  'vans': &lbrace;
    name: 'Na Nach Vans',
    hebrew: 'ואנים נ נח',
    icon: '🚐',
    images: allImages.filter(img =>
