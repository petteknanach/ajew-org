---
import AdvancedSearchOptions from './AdvancedSearchOptions.astro';

interface Props {
  compact?: boolean;
  showFilters?: boolean;
  autoFocus?: boolean;
  showAdvancedOptions?: boolean;
}

const { compact = false, showFilters = true, autoFocus = true, showAdvancedOptions = true } = Astro.props;
---

<div class={`enhanced-search ${compact ? 'compact' : ''}`}>
  <div class="search-container">
    <form id="searchForm" class="search-form">
      <div class="search-input-wrapper">
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder="חפש בכל הספרים... Search across all works..."
          dir="auto"
          autocomplete="off"
          autofocus={autoFocus}
          aria-label="Search"
        />
        <button type="submit" class="search-button" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>
      
      {showFilters && (
        <div class="quick-filters">
          <div class="search-tips">
            <span class="tip"><code>"..."</code> exact</span>
            <span class="tip"><code>AND / OR</code></span>
            <span class="tip"><code>word*</code> wildcard</span>
          </div>
        </div>
      )}
    </form>
  </div>
  
  <!-- Advanced Search Options -->
  {showAdvancedOptions && <AdvancedSearchOptions />}
</div>

<script>
  // Search state
  const searchState = {
    query: '',
    filters: { type: [], category: [], language: '', author: '' },
    advancedOptions: {
      books: [],
      searchType: 'contains',
      proximity: 0
    },
    isLoading: false
  };

  const allBookValues = [
    'likutay-moharan', 'sefer-hamidos', 'stories',
    'likutay-nanach-3', 'likutay-nanach-4', 'likutay-nanach-5', 'likutay-nanach-unknown',
    '1_ספרי-רבי-נחמן', '2_ספרי-רבי-נתן', '3_ספרי-רבי-נתן-בר-יהודה',
    '3_ספרי-הרב-מטשערין', '4_ספרי-רבי-אלתר-טפליקער', '5_ספרי-רבי-אברהם-בר-נחמן',
    '6_ספרי-רבי-שמשון-בארסקי', '6_ספרים-של-תלמידים-ועוד',
    'ביבליוגרפית-ברסלב', '91_סיפורים', '92_ספרים-מתורגמים'
  ];

  searchState.advancedOptions.books = [...allBookValues];

  let searchInput: HTMLInputElement;
  let searchForm: HTMLFormElement;

  document.addEventListener('DOMContentLoaded', () => {
    searchInput = document.getElementById('searchInput') as HTMLInputElement;
    searchForm = document.getElementById('searchForm') as HTMLFormElement;

    // Form submission
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      performSearch();
    });

    // Enter key
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        performSearch();
      }
    });

    // Listen for advanced search options
    document.addEventListener('advanced-search-options', (e: any) => {
      searchState.advancedOptions = { ...searchState.advancedOptions, ...e.detail };
      if (searchState.query) performSearch();
    });

    // Check URL parameters on load
    checkUrlParameters();
  });

  function performSearch() {
    const query = searchInput.value.trim();
    if (!query) return;
    
    searchState.query = query;
    updateUrl(query);
    
    // Dispatch search event
    document.dispatchEvent(new CustomEvent('enhanced-search', {
      detail: {
        query: query,
        filters: searchState.filters,
        advancedOptions: searchState.advancedOptions
      }
    }));
  }

  function updateUrl(query: string) {
    const url = new URL(window.location.href);
    url.searchParams.set('q', query);
    if (searchState.advancedOptions.searchType !== 'contains') {
      url.searchParams.set('searchType', searchState.advancedOptions.searchType);
    } else {
      url.searchParams.delete('searchType');
    }
    if (searchState.advancedOptions.proximity > 0) {
      url.searchParams.set('proximity', String(searchState.advancedOptions.proximity));
    } else {
      url.searchParams.delete('proximity');
    }
    window.history.replaceState({}, '', url);
  }

  function checkUrlParameters() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q');
    if (query) {
      searchInput.value = query;
      searchState.query = query;
      
      const searchType = params.get('searchType');
      if (searchType) searchState.advancedOptions.searchType = searchType;
      
      const proximity = params.get('proximity');
      if (proximity) searchState.advancedOptions.proximity = parseInt(proximity);
      
      setTimeout(() => performSearch(), 200);
    }
  }

  // Public API
  (window as any).enhancedSearch = {
    search: performSearch,
    setQuery: (q: string) => { searchInput.value = q; searchState.query = q; },
    getState: () => ({ ...searchState }),
    reset: () => { searchInput.value = ''; searchState.query = ''; }
  };
</script>

<style>
  .enhanced-search {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .enhanced-search.compact {
    max-width: 500px;
  }

  .search-container {
    position: relative;
  }

  .search-form {
    width: 100%;
  }

  .search-input-wrapper {
    display: flex;
    gap: 0.5rem;
  }

  .search-input {
    flex: 1;
    padding: 0.85rem 1.2rem;
    font-size: 1.05rem;
    border: 2px solid #d1d5db;
    border-radius: 50px;
    transition: all 0.2s;
    background: white;
    direction: ltr;
  }

  .search-input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .search-input::placeholder {
    color: #9ca3af;
  }

  .search-button {
    padding: 0.85rem 1.2rem;
    background: #6366f1;
    color: white;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .search-button:hover {
    background: #4f46e5;
    transform: scale(1.02);
  }

  .quick-filters {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    gap: 0.75rem;
  }

  .search-tips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tip {
    font-size: 0.72rem;
    color: #9ca3af;
    background: #f9fafb;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .tip code {
    font-family: monospace;
    color: #6b7280;
    font-size: 0.7rem;
  }

  @media (max-width: 640px) {
    .search-input {
      font-size: 0.95rem;
      padding: 0.75rem 1rem;
    }

    .search-button {
      padding: 0.75rem 1rem;
    }
  }
</style>
